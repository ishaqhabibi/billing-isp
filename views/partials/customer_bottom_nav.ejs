<!-- views/partials/customer_bottom_nav.ejs -->
<% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
<style>
  .customer-bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 70px;
    background: var(--isp-navbar, rgba(15, 22, 36, 0.98));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid var(--isp-border, rgba(255, 255, 255, 0.08));
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 1040;
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -4px 25px rgba(0, 0, 0, 0.18);
  }

  .nav-item-android {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--isp-text-muted, #94a3b8);
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    flex: 1;
    height: 100%;
    cursor: pointer;
    position: relative;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-item-android .nav-icon-pill {
    width: 48px;
    height: 28px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 3px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .nav-item-android .nav-icon-pill i {
    font-size: 18px;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .nav-item-android:hover {
    color: var(--isp-text-heading, #ffffff);
  }

  .nav-item-android.active {
    color: var(--isp-primary-text, #3b82f6);
  }

  .nav-item-android.active .nav-icon-pill {
    background: var(--isp-primary-subtle, rgba(37, 99, 235, 0.16));
    color: var(--isp-primary-text, #3b82f6);
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
  }

  .nav-item-android.active .nav-icon-pill i {
    transform: scale(1.1);
    color: var(--isp-primary, #2563eb);
  }

  /* Badge indicator on nav item */
  .nav-item-android .nav-badge {
    position: absolute;
    top: 2px;
    right: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--isp-warning, #f59e0b);
    border: 2px solid var(--isp-navbar);
  }

  /* Hide on large desktop screens, prioritize mobile app layout */
  @media (min-width: 992px) {
    .customer-bottom-nav {
      max-width: 620px;
      left: 50%;
      transform: translateX(-50%);
      border-radius: 20px 20px 0 0;
      border-left: 1px solid var(--isp-border, rgba(255, 255, 255, 0.08));
      border-right: 1px solid var(--isp-border, rgba(255, 255, 255, 0.08));
    }
  }
</style>

<nav class="customer-bottom-nav" id="customerBottomNav">
  <!-- 1. BERANDA -->
  <a href="#home-section" class="nav-item-android active" id="navHome" onclick="switchAndroidTab('home-section', this)">
    <div class="nav-icon-pill">
      <i class="bi bi-house-door-fill"></i>
    </div>
    <span>Beranda</span>
  </a>

  <!-- 2. WI-FI & JARINGAN -->
  <a href="#wifi-section" class="nav-item-android" id="navWifi" onclick="switchAndroidTab('wifi-section', this)">
    <div class="nav-icon-pill">
      <i class="bi bi-wifi"></i>
    </div>
    <span>Wi-Fi & ONU</span>
  </a>

  <!-- 3. TAGIHAN & BAYAR -->
  <a href="#billing-section" class="nav-item-android" id="navBilling" onclick="switchAndroidTab('billing-section', this)">
    <div class="nav-icon-pill">
      <i class="bi bi-receipt-cutoff"></i>
      <% if (typeof unpaidInvoices !== 'undefined' && unpaidInvoices && unpaidInvoices.length > 0) { %>
        <span class="nav-badge"></span>
      <% } %>
    </div>
    <span>Tagihan</span>
  </a>

  <!-- 4. PUSAT BANTUAN -->
  <a href="#help-section" class="nav-item-android" id="navHelp" onclick="switchAndroidTab('help-section', this)">
    <div class="nav-icon-pill">
      <i class="bi bi-headset"></i>
    </div>
    <span>Bantuan</span>
  </a>
</nav>

<script>
  function switchAndroidTab(sectionId, el) {
    document.querySelectorAll('.customer-bottom-nav .nav-item-android').forEach(item => {
      item.classList.remove('active');
    });
    if (el) el.classList.add('active');

    const targetEl = document.getElementById(sectionId);
    if (targetEl) {
      targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function syncActiveBottomNav() {
    const hash = window.location.hash || '#home-section';
    const navItems = document.querySelectorAll('.customer-bottom-nav .nav-item-android');
    
    navItems.forEach(item => {
      item.classList.remove('active');
      const href = item.getAttribute('href');
      if (href === hash) {
        item.classList.add('active');
      }
    });

    if (hash === '' || hash === '#home-section') {
      const home = document.getElementById('navHome');
      if (home) home.classList.add('active');
    }
  }

  window.addEventListener('hashchange', syncActiveBottomNav);
  window.addEventListener('load', syncActiveBottomNav);
</script>
<% } %>
