          topLabel.textContent = 'Semua Wilayah';
        } else {
          topLabel.textContent = displayName || areaKey;
        }
      }

      // 4. Client-side Filter Customer Cards
      const cards = document.querySelectorAll('.customer-cards-list .flutter-customer-card');
      let visibleCount = 0;
      cards.forEach(card => {
        if (card.id === 'areaEmptyNotice') return;

        const cardArea = (card.getAttribute('data-area') || '').trim().toLowerCase();
        if (window.currentActiveArea === 'all' || cardArea === window.currentActiveArea) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // 5. Toggle Empty Notice
      const emptyNotice = document.getElementById('areaEmptyNotice');
      if (emptyNotice) {
        emptyNotice.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
      }

      // 6. Sync Leaflet Map markers if initialized
      if (typeof recalculateNearestRoutes === 'function' && collectorMap) {
        recalculateNearestRoutes();
      }

      if (closeSheet) {
        closeAreaPickerModal();
      }
