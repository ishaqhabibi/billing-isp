  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Bottom Screen Tab Switcher (4 Tabs: Tagihan, Peta, Setoran, Riwayat)
    function switchMainScreenTab(tabName) {
      const sPenagihan = document.getElementById('screenTabPenagihan');
      const sSetoran = document.getElementById('screenTabSetoran');
      const sRiwayat = document.getElementById('screenTabRiwayat');

      const listView = document.getElementById('collectorListView');
      const mapView = document.getElementById('collectorMapView');

      const bPenagihan = document.getElementById('bnavTabPenagihan');
      const bPeta = document.getElementById('bnavTabPeta');
      const bSetoran = document.getElementById('bnavTabSetoran');
      const bRiwayat = document.getElementById('bnavTabRiwayat');

      if (sPenagihan) sPenagihan.style.display = 'none';
      if (sSetoran) sSetoran.style.display = 'none';
      if (sRiwayat) sRiwayat.style.display = 'none';

      if (bPenagihan) bPenagihan.classList.remove('active');
      if (bPeta) bPeta.classList.remove('active');
      if (bSetoran) bSetoran.classList.remove('active');
      if (bRiwayat) bRiwayat.classList.remove('active');

      if (tabName === 'peta') {
        if (sPenagihan) sPenagihan.style.display = 'block';
        if (listView) listView.style.display = 'none';
        if (mapView) mapView.style.display = 'block';
        if (bPeta) bPeta.classList.add('active');
        initCollectorMap();
        setTimeout(() => { if (collectorMap) collectorMap.invalidateSize(); }, 200);
      } else if (tabName === 'setoran') {
        if (sSetoran) sSetoran.style.display = 'block';
        if (bSetoran) bSetoran.classList.add('active');
      } else if (tabName === 'riwayat') {
        if (sRiwayat) sRiwayat.style.display = 'block';
        if (bRiwayat) bRiwayat.classList.add('active');
      } else {
        // Default: Penagihan List View
        if (sPenagihan) sPenagihan.style.display = 'block';
        if (listView) listView.style.display = 'block';
        if (mapView) mapView.style.display = 'none';
        if (bPenagihan) bPenagihan.classList.add('active');
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function switchCollectorView(viewMode) {
      switchMainScreenTab(viewMode === 'map' ? 'peta' : 'penagihan');
    }

    // Set Full Settle Amount
    function setFullSettleAmount(val) {
      const field = document.getElementById('settleAmountField');
      if (field) field.value = val;
    }

    // ══════════════════════════════════════════════════════════════
    // THEME SWITCHER WITH FLUID TRANSITION & ANIMATION
    // ══════════════════════════════════════════════════════════════
    function updateThemeToggleIcon(theme) {
      const isLight = (theme === 'light');
      const icon = document.getElementById('themeToggleIcon');
      const btn = document.getElementById('themeToggleBtn');
      if (icon) {
        icon.className = isLight ? 'theme-toggle-icon bi bi-moon-stars-fill' : 'theme-toggle-icon bi bi-sun-fill';
        icon.style.color = isLight ? '#ffffff' : '#fbbf24';
      }
      if (btn) {
        btn.setAttribute('title', isLight ? 'Ganti ke Mode Gelap (Malam)' : 'Ganti ke Mode Terang (Siang)');
        btn.setAttribute('aria-label', isLight ? 'Ganti ke Mode Gelap' : 'Ganti ke Mode Terang');
      }
    }

    function applyAppThemeInstant(next) {
      document.documentElement.setAttribute('data-theme', next);
      if (next === 'light') {
        document.documentElement.classList.add('light-theme');
        document.body.classList.add('light-theme');
      } else {
        document.documentElement.classList.remove('light-theme');
        document.body.classList.remove('light-theme');
      }
      updateThemeToggleIcon(next);
      try {
        localStorage.setItem('theme', next);
        localStorage.setItem('app-theme', next);
      } catch (e) { }
    }

    function toggleAppThemeWithAnimation(event) {
      const cur = document.documentElement.getAttribute('data-theme') || 
                  (document.documentElement.classList.contains('light-theme') ? 'light' : 'dark');
      const next = (cur === 'dark') ? 'light' : 'dark';

      const btn = document.getElementById('themeToggleBtn');
      if (btn) {
        btn.classList.add('animating');
        setTimeout(() => btn.classList.remove('animating'), 550);
      }

      // Check if View Transition API is supported (Chrome/Android)
      if (document.startViewTransition && event && typeof event.clientX === 'number') {
        const x = event.clientX;
        const y = event.clientY;
        const endRadius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        );

        const transition = document.startViewTransition(() => {
          applyAppThemeInstant(next);
        });

        transition.ready.then(() => {
          document.documentElement.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`
              ]
            },
            {
              duration: 480,
              easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
              pseudoElement: '::view-transition-new(root)'
            }
          );
        });
      } else {
        // Fallback: Silky Smooth CSS Universal Crossfade
        document.documentElement.classList.add('theme-transitioning');
        applyAppThemeInstant(next);
        setTimeout(() => {
          document.documentElement.classList.remove('theme-transitioning');
        }, 500);
      }
    }

    // Alias for global compatibility
    function toggleAppTheme(event) {
      toggleAppThemeWithAnimation(event || window.event);
    }

    // Auto-init theme on page load
    (function initDashboardTheme() {
      try {
        const saved = localStorage.getItem('theme') || localStorage.getItem('app-theme') || 'dark';
        applyAppThemeInstant(saved);
      } catch (e) {
        applyAppThemeInstant('dark');
      }
    })();

    // ══════════════════════════════════════════════════════════════
    // GANTI NAMA & PASSWORD INTERACTIONS (SMOOTH INLINE ANIMATION)
    // ══════════════════════════════════════════════════════════════
    function togglePasswordVisibility(inputId, btnEl) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const isPwd = input.type === 'password';
      input.type = isPwd ? 'text' : 'password';
      const icon = btnEl ? btnEl.querySelector('i') : null;
      if (icon) {
        icon.className = isPwd ? 'bi bi-eye-slash' : 'bi bi-eye';
      }
    }

    function showNameAlert(type, message) {
      const alertBox = document.getElementById('nameAlertBox');
      const alertIcon = document.getElementById('nameAlertIcon');
      const alertMsg = document.getElementById('nameAlertMsg');
      if (!alertBox || !alertMsg) return;

      alertBox.className = 'settings-alert-box ' + type;
      if (alertIcon) {
        alertIcon.className = type === 'success' ? 'bi bi-check-circle-fill' : 'bi bi-exclamation-triangle-fill';
      }
      alertMsg.textContent = message;
      alertBox.style.display = 'flex';
    }

    function showPwdAlert(type, message) {
      const alertBox = document.getElementById('pwdAlertBox');
      const alertIcon = document.getElementById('pwdAlertIcon');
      const alertMsg = document.getElementById('pwdAlertMsg');
      if (!alertBox || !alertMsg) return;

      alertBox.className = 'settings-alert-box ' + type;
      if (alertIcon) {
        alertIcon.className = type === 'success' ? 'bi bi-check-circle-fill' : 'bi bi-exclamation-triangle-fill';
      }
      alertMsg.textContent = message;
      alertBox.style.display = 'flex';
    }

    // Submit Update Profile Name (Inline Animation without closing modal)
    async function submitUpdateProfile() {
      const nameInput = document.getElementById('collectorNameInput');
      const submitBtn = document.getElementById('btnSubmitProfile');
      const submitTxt = document.getElementById('btnProfileText');
      const submitIco = document.getElementById('btnProfileIcon');
      const formCard = document.getElementById('profileNameCard');

      const newName = (nameInput?.value || '').trim();
      if (!newName || newName.length < 2) {
        showNameAlert('error', 'Nama lengkap minimal 2 karakter.');
        if (formCard) {
          formCard.classList.remove('shake-animation');
          void formCard.offsetWidth;
          formCard.classList.add('shake-animation');
        }
        if (nameInput) nameInput.focus();
        return;
      }

      // Enter Loading State with Spinning Icon
      if (submitBtn) submitBtn.disabled = true;
      if (submitTxt) submitTxt.textContent = 'Menyimpan Nama...';
      if (submitIco) submitIco.className = 'bi bi-arrow-repeat spin-icon-fast';

      try {
        const res = await fetch('/collector/update-profile', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ name: newName })
        });

        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          showNameAlert('success', data.message || 'Nama profil berhasil diperbarui.');

          // Button Morphs to Emerald Green with Checkmark and Pulse Animation
          if (submitBtn) submitBtn.classList.add('btn-success-state');
          if (submitTxt) submitTxt.textContent = '✓ Nama Tersimpan!';
          if (submitIco) submitIco.className = 'bi bi-check-lg';

          // Update Top Appbar Greeting and Monogram Avatars Instantly without page reload
          const initial = newName.charAt(0).toUpperCase();
          const topGreeting = document.getElementById('topAppbarGreeting');
          if (topGreeting) {
            topGreeting.textContent = 'Halo, ' + newName;
            topGreeting.title = 'Halo, ' + newName;
          }

          const topAvatar = document.getElementById('topAppbarAvatar');
          if (topAvatar) {
            topAvatar.childNodes[0].textContent = initial;
            topAvatar.classList.add('avatar-pop-anim');
            setTimeout(() => topAvatar.classList.remove('avatar-pop-anim'), 500);
          }

          const modalAvatar = document.getElementById('settingsAvatarDisplay');
          if (modalAvatar) {
            modalAvatar.textContent = initial;
            modalAvatar.classList.add('avatar-pop-anim');
            setTimeout(() => modalAvatar.classList.remove('avatar-pop-anim'), 500);
          }

          // Reset button to normal ready state after 2.5 seconds
          setTimeout(() => {
            if (submitBtn) {
              submitBtn.classList.remove('btn-success-state');
              submitBtn.disabled = false;
            }
            if (submitTxt) submitTxt.textContent = 'Simpan Nama';
            if (submitIco) submitIco.className = 'bi bi-check2-circle';
          }, 2500);

        } else {
          showNameAlert('error', data.message || 'Gagal memperbarui profil.');
          if (formCard) {
            formCard.classList.remove('shake-animation');
            void formCard.offsetWidth;
            formCard.classList.add('shake-animation');
          }
          if (submitBtn) submitBtn.disabled = false;
          if (submitTxt) submitTxt.textContent = 'Simpan Nama';
          if (submitIco) submitIco.className = 'bi bi-check2-circle';
        }
      } catch (err) {
        showNameAlert('error', 'Terjadi kesalahan jaringan. Coba lagi.');
        if (submitBtn) submitBtn.disabled = false;
        if (submitTxt) submitTxt.textContent = 'Simpan Nama';
        if (submitIco) submitIco.className = 'bi bi-check2-circle';
      }
    }

    // Submit Change Password (Inline Animation without closing modal)
    async function submitChangePassword() {
      const oldInput = document.getElementById('oldPasswordInput');
      const newInput = document.getElementById('newPasswordInput');
      const confirmInput = document.getElementById('confirmPasswordInput');
      const submitBtn = document.getElementById('btnSubmitChangePassword');
      const submitTxt = document.getElementById('btnSubmitPwdText');
      const submitIco = document.getElementById('btnPwdIcon');
      const formCard = document.getElementById('changePwdCard');

      const oldPass = (oldInput?.value || '').trim();
      const newPass = (newInput?.value || '').trim();
      const confirmPass = (confirmInput?.value || '').trim();

      if (!oldPass) {
        showPwdAlert('error', 'Masukkan password saat ini.');
        if (formCard) {
          formCard.classList.remove('shake-animation');
          void formCard.offsetWidth;
          formCard.classList.add('shake-animation');
        }
        if (oldInput) oldInput.focus();
        return;
      }
      if (!newPass || newPass.length < 4) {
        showPwdAlert('error', 'Password baru minimal 4 karakter.');
        if (formCard) {
          formCard.classList.remove('shake-animation');
          void formCard.offsetWidth;
          formCard.classList.add('shake-animation');
        }
        if (newInput) newInput.focus();
        return;
      }
      if (newPass !== confirmPass) {
        showPwdAlert('error', 'Konfirmasi password baru tidak cocok.');
        if (formCard) {
          formCard.classList.remove('shake-animation');
          void formCard.offsetWidth;
          formCard.classList.add('shake-animation');
        }
        if (confirmInput) confirmInput.focus();
        return;
      }

      // Enter Loading State with Spinning Icon
      if (submitBtn) submitBtn.disabled = true;
      if (submitTxt) submitTxt.textContent = 'Menyimpan Password...';
      if (submitIco) submitIco.className = 'bi bi-arrow-repeat spin-icon-fast';

      try {
        const res = await fetch('/collector/change-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            old_password: oldPass,
            new_password: newPass,
            confirm_password: confirmPass
          })
        });

        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          showPwdAlert('success', data.message || 'Password berhasil diperbarui.');

          // Button Morphs to Emerald Green with Checkmark and Pulse Animation
          if (submitBtn) submitBtn.classList.add('btn-success-state');
          if (submitTxt) submitTxt.textContent = '✓ Password Tersimpan!';
          if (submitIco) submitIco.className = 'bi bi-check-lg';

          // Reset password input fields
          if (oldInput) oldInput.value = '';
          if (newInput) newInput.value = '';
          if (confirmInput) confirmInput.value = '';

          // Reset button to normal ready state after 2.5 seconds
          setTimeout(() => {
            if (submitBtn) {
              submitBtn.classList.remove('btn-success-state');
              submitBtn.disabled = false;
            }
            if (submitTxt) submitTxt.textContent = 'Simpan Password Baru';
            if (submitIco) submitIco.className = 'bi bi-check2-circle';
          }, 2500);

        } else {
          showPwdAlert('error', data.message || 'Gagal mengubah password. Pastikan password lama benar.');
          if (formCard) {
            formCard.classList.remove('shake-animation');
            void formCard.offsetWidth;
            formCard.classList.add('shake-animation');
          }
          if (submitBtn) submitBtn.disabled = false;
          if (submitTxt) submitTxt.textContent = 'Simpan Password Baru';
          if (submitIco) submitIco.className = 'bi bi-check2-circle';
        }
      } catch (err) {
        showPwdAlert('error', 'Terjadi kesalahan jaringan. Coba lagi.');
        if (submitBtn) submitBtn.disabled = false;
        if (submitTxt) submitTxt.textContent = 'Simpan Password Baru';
        if (submitIco) submitIco.className = 'bi bi-check2-circle';
      }
    }

