        } else {
          btn.classList.remove('active');
        }
      });

      // 2. Sync Modal Area Cards
      document.querySelectorAll('.area-picker-card').forEach(card => {
        if (card.getAttribute('data-area-key') === window.currentActiveArea) {
          card.classList.add('active');
