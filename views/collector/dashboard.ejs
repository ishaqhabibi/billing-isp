    /* Prevent browser from drawing black outline rectangle on fragment jump / :target */
    :target,
    #daftar-tagihan,
    #daftar-tagihan:target,
    #daftar-tagihan:focus,
    #daftar-tagihan:focus-visible,
    .flutter-chip-bar:focus,
    .flutter-chip-bar:focus-visible,
    .flutter-chip-bar:target,
    .flutter-chip-bar:active {
      outline: none !important;
      outline-width: 0 !important;
      box-shadow: none !important;
      -webkit-tap-highlight-color: transparent !important;
    }

