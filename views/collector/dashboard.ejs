    .cust-subtitle-meta {
      font-size: 11.5px;
      color: var(--m3-on-surface-variant);
      margin-top: 3px;
      font-weight: 600;
    }

    .cust-address-line {
      font-size: 12px;
      color: var(--m3-on-surface-variant);
      margin-top: 6px;
      line-height: 1.35;
      display: flex;
      align-items: flex-start;
      gap: 4px;
    }

    /* ─── 5B. TWO-TIER CUSTOMER CARD ACTIONS (CLEAN MOBILE DESIGN) ─── */
    .card-price-contact-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px dashed var(--m3-outline-variant);
    }

    .price-headline-box {
      display: flex;
      align-items: baseline;
      gap: 4px;
    }

    .price-currency {
      font-size: 13px;
      font-weight: 700;
      color: var(--m3-on-surface-variant);
    }

    .price-nominal {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: #ef4444;
    }

    .card-paid .price-nominal {
      color: #10b981;
    }

    /* Quick Contact Circle Buttons */
    .contact-quick-group {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .contact-circle-btn {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--m3-surface-container-high);
      border: 1px solid var(--m3-outline-variant);
      color: var(--m3-on-surface-variant);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      text-decoration: none;
      transition: background 0.15s, transform 0.1s, border-color 0.15s;
    }

    .contact-circle-btn:active {
      background: var(--m3-surface-container-highest);
      transform: scale(0.92);
    }

    .btn-wa-color {
      color: #16a34a;
    }

    .btn-maps-color {
      color: #0284c7;
    }

    /* Primary Action Buttons Grid - Full Mobile Touch Targets */
    .card-action-grid {
      display: grid;
      grid-template-columns: 1fr 1.35fr;
      gap: 10px;
      margin-top: 12px;
    }

    .btn-card-reschedule {
      height: 42px;
      border-radius: 12px;
      background: var(--m3-surface-container-high);
      border: 1px solid var(--m3-outline-variant);
      color: var(--m3-on-surface);
      font-size: 13px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.15s, border-color 0.15s, transform 0.1s;
    }

    .btn-card-reschedule:active {
      background: var(--m3-surface-container-highest);
      transform: scale(0.97);
    }

    .btn-card-pay {
      height: 42px;
      border-radius: 12px;
      background: #059669;
      color: #ffffff;
      border: none;
      font-size: 13.5px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: 0 2px 6px rgba(5, 150, 105, 0.25);
      transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
    }

    .btn-card-pay:active {
      background: #047857;
      transform: scale(0.97);
      box-shadow: none;
    }

    .btn-card-print {
      grid-column: 1 / -1;
      height: 42px;
      border-radius: 12px;
      background: var(--m3-surface-container-high);
      border: 1px solid var(--m3-outline-variant);
      color: var(--m3-on-surface);
      font-size: 13px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s, transform 0.1s;
    }

    .btn-card-print:active {
      background: var(--m3-surface-container-highest);
      transform: scale(0.97);
    }

    /* ─── 6. FLUTTER MATERIAL 3 BOTTOM NAVIGATION BAR (3 TABS) ─── */
    .flutter-navigation-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 76px;
      background: var(--m3-surface-container);
      border-top: 1px solid var(--m3-outline-variant);
      z-index: 1000;
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 0 16px env(safe-area-inset-bottom, 0);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.12);
    }

    .m3-nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex: 1;
      height: 100%;
      user-select: none;
      text-decoration: none;
      color: var(--m3-on-surface-variant);
      transition: color 0.15s ease;
    }

    .m3-nav-pill-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .m3-nav-pill-indicator {
      width: 52px;
      height: 30px;
      border-radius: 99px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      margin-bottom: 2px;
      transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .m3-nav-item.active .m3-nav-pill-indicator {
      background: var(--m3-pill-active-bg);
      color: var(--m3-pill-active);
    }

    .m3-nav-label {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.2px;
    }

    .m3-nav-item.active .m3-nav-label {
      color: var(--m3-on-surface);
      font-weight: 800;
    }

    /* ─── 7. LEAFLET MAP & NEAREST TARGET DRAWER ─── */
    #collectorMap {
      width: 100%;
      height: calc(100vh - 210px);
      min-height: 520px;
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid var(--m3-outline-variant);
      z-index: 1;
    }

    .nearest-target-drawer {
      position: fixed;
      bottom: 84px;
      left: 12px;
      right: 12px;
      max-width: 456px;
      margin: 0 auto;
      background: var(--m3-surface-container);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--m3-outline-variant);
      border-radius: 22px;
      padding: 8px 16px 14px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
      z-index: 990;
      display: none;
      animation: slideUpDrawer 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      transition: padding 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-radius 0.22s, box-shadow 0.22s;
    }

    @keyframes slideUpDrawer {
      from {
        transform: translateY(40px);
        opacity: 0;
      }

      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    .nearest-target-drawer.active {
      display: block;
    }

    /* Drag Handle Bar */
    .drawer-drag-wrap {
      width: 100%;
      display: flex;
      justify-content: center;
      padding: 2px 0 6px;
      cursor: pointer;
    }

    .drawer-drag-pill {
      width: 36px;
      height: 4px;
      border-radius: 99px;
      background: var(--m3-outline);
      opacity: 0.6;
      transition: background 0.15s, opacity 0.15s;
    }

    .drawer-drag-wrap:hover .drawer-drag-pill,
    .drawer-drag-wrap:active .drawer-drag-pill {
      opacity: 1;
      background: var(--m3-primary);
    }

    .btn-drawer-toggle,
    .btn-drawer-mini-toggle {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: var(--m3-surface-container-high);
      border: 1px solid var(--m3-outline-variant);
      color: var(--m3-on-surface-variant);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      cursor: pointer;
      transition: transform 0.15s, background 0.15s;
    }

    .btn-drawer-toggle:active,
    .btn-drawer-mini-toggle:active {
      transform: scale(0.9);
    }

    /* Minimized Peek Mode */
    .nearest-target-drawer.is-minimized {
      padding: 6px 14px 8px;
      bottom: 80px;
      border-radius: 18px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
      cursor: pointer;
    }

    .nearest-target-drawer.is-minimized .drawer-expanded-body {
      display: none !important;
    }

    .nearest-target-drawer.is-minimized .drawer-peek-bar {
      display: flex !important;
    }

    .drawer-peek-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      min-width: 0;
    }

    .target-order-badge-mini {
      font-size: 11px;
      font-weight: 800;
      background: #ef4444;
      color: #ffffff;
      padding: 2px 7px;
      border-radius: 99px;
      flex-shrink: 0;
    }

    .peek-cust-info {
      display: flex;
      align-items: baseline;
      gap: 5px;
      min-width: 0;
      overflow: hidden;
    }

    .peek-cust-name {
      font-size: 13.5px;
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--m3-on-surface);
    }

    .peek-cust-dist {
      font-size: 11.5px;
      font-weight: 700;
      color: #059669;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .peek-cust-amount {
      font-size: 13px;
      font-weight: 900;
      color: #ef4444;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .target-drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .target-order-badge {
      font-size: 11px;
      font-weight: 800;
      background: var(--m3-primary-container);
      color: var(--m3-primary);
      padding: 2px 10px;
      border-radius: 99px;
    }

    .target-dist-val {
      font-size: 12px;
      font-weight: 800;
      color: #059669;
    }

    .btn-map-recenter {
      position: absolute;
      top: 62px;
      right: 12px;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: var(--m3-surface-container);
      border: 1px solid var(--m3-outline);
      color: var(--m3-on-surface);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
      cursor: pointer;
      z-index: 500;
      transition: transform 0.15s, background 0.15s;
    }

    .btn-map-recenter:active {
      transform: scale(0.92);
    }

    /* ─── 8. SLIDE-UP BOTTOM SHEET MODALS (SMOOTH SPRING ANIMATION) ─── */
    .modal-custom-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.62);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 2000;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                  visibility 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, visibility;
    }

    .modal-custom-backdrop.show {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .modal-custom-box {
      width: 100%;
      max-width: 540px;
      background: var(--m3-surface-container);
      border-top: 1px solid var(--m3-outline-variant);
      border-radius: 26px 26px 0 0;
      box-shadow: 0 -12px 48px rgba(0, 0, 0, 0.35);
      overflow: hidden;
      max-height: 90vh;
      overflow-y: auto;
      transform: translateY(100%);
      transition: transform 0.34s cubic-bezier(0.32, 0.72, 0, 1);
      will-change: transform;
    }

    .modal-custom-backdrop.show .modal-custom-box {
      transform: translateY(0);
    }

    /* Snappy exit: when closing, animate slide down faster (240ms) */
    .modal-custom-backdrop:not(.show) .modal-custom-box {
      transform: translateY(100%);
      transition: transform 0.24s cubic-bezier(0.4, 0, 0.6, 1);
    }

    .sheet-drag-handle-wrapper {
      padding: 10px 0 6px;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      width: 100%;
    }

    .sheet-drag-handle {
      width: 44px;
      height: 4.5px;
      border-radius: 99px;
      background: var(--m3-on-surface-variant);
      opacity: 0.35;
      margin: 0 auto;
      transition: all 0.2s ease;
    }

    .sheet-drag-handle-wrapper:hover .sheet-drag-handle,
    .sheet-drag-handle-wrapper:active .sheet-drag-handle {
      opacity: 0.85;
      width: 54px;
      background: var(--m3-primary);
    }

    /* ─── HUMAN-CRAFTED DATE PICKER COMPONENT (ANTI-SLOP) ─── */
    .date-preset-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 12px;
    }

    .date-preset-btn {
      background: var(--m3-surface-container-high);
      border: 1px solid var(--m3-outline-variant);
      color: var(--m3-on-surface-variant);
      border-radius: 10px;
      padding: 7px 4px;
      font-size: 11px;
      font-weight: 600;
      text-align: center;
      cursor: pointer;
      transition: all 0.15s ease;
      user-select: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1px;
    }

    .date-preset-btn .preset-main {
      font-weight: 700;
      font-size: 12px;
      color: var(--m3-on-surface);
    }

    .date-preset-btn .preset-sub {
      font-size: 10px;
      color: var(--m3-on-surface-variant);
    }

    .date-preset-btn:hover {
      border-color: rgba(2, 132, 199, 0.4);
    }

    .date-preset-btn.active {
      background: rgba(2, 132, 199, 0.1);
      border-color: #0284c7;
    }

    .date-preset-btn.active .preset-main {
      color: #0284c7;
    }

    .date-preset-btn.active .preset-sub {
      color: #0284c7;
      opacity: 0.85;
    }

    /* Custom Date Dropdown Trigger */
    .custom-date-trigger {
      background: var(--m3-surface-container-high);
      border: 1.5px solid var(--m3-outline-variant);
      border-radius: 14px;
      padding: 11px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      transition: all 0.2s ease;
      user-select: none;
    }

    .custom-date-trigger:hover,
    .custom-date-trigger.open {
      border-color: #0284c7;
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);
    }

    .custom-date-trigger .trigger-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .custom-date-trigger .trigger-calendar-icon {
      width: 36px;
      height: 36px;
      border-radius: 9px;
      background: rgba(2, 132, 199, 0.1);
      color: #0284c7;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
    }

    .custom-date-trigger .trigger-date-title {
      font-weight: 700;
      font-size: 14px;
      color: var(--m3-on-surface);
      line-height: 1.25;
    }

    .custom-date-trigger .trigger-date-sub {
      font-size: 11.5px;
      color: var(--m3-on-surface-variant);
      margin-top: 2px;
    }

    .custom-date-trigger .trigger-chevron {
      color: var(--m3-on-surface-variant);
      font-size: 13px;
      transition: transform 0.2s ease;
    }

    .custom-date-trigger.open .trigger-chevron {
      transform: rotate(180deg);
      color: #0284c7;
    }

    /* Dropdown Options Container */
    .custom-date-options {
      display: none;
      margin-top: 8px;
      background: var(--m3-surface-container);
      border: 1px solid var(--m3-outline-variant);
      border-radius: 14px;
      max-height: 220px;
      overflow-y: auto;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    .custom-date-options.show {
      display: block;
      animation: fadeInDown 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .custom-date-option-item {
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      border-bottom: 1px solid var(--m3-outline-variant);
      transition: background 0.15s ease;
      font-size: 13px;
    }

    .custom-date-option-item:last-child {
      border-bottom: none;
    }

    .custom-date-option-item:hover {
      background: var(--m3-surface-container-high);
    }

    .custom-date-option-item.selected {
      background: rgba(2, 132, 199, 0.08);
      font-weight: 700;
    }

    .custom-date-option-item .opt-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .custom-date-option-item .opt-badge-num {
      width: 26px;
      height: 26px;
      border-radius: 7px;
      background: var(--m3-surface-container-high);
      color: var(--m3-on-surface);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 800;
    }

    .custom-date-option-item.selected .opt-badge-num {
      background: #0284c7;
      color: #ffffff;
    }

    .custom-date-option-item .opt-label {
      color: var(--m3-on-surface);
      font-size: 13px;
      white-space: nowrap;
    }

    .custom-date-option-item .opt-tag {
      font-size: 10px;
      padding: 2px 7px;
      border-radius: 6px;
      background: var(--m3-surface-container-high);
      color: var(--m3-on-surface-variant);
      font-weight: 600;
    }

    .custom-date-option-item.selected .opt-tag {
      background: rgba(2, 132, 199, 0.15);
      color: #0284c7;
    }

    .custom-date-option-item .opt-check {
      color: #0284c7;
      font-size: 15px;
      display: none;
    }

    .custom-date-option-item.selected .opt-check {
      display: block;
    }
  </style>
</head>

<body>

  <div class="flutter-app-shell">
    <!-- 1. FLUTTER NATIVE HERO APPBAR & WALLET -->
    <div class="flutter-hero-scaffold">
      <!-- Modern Fintech Atmosphere Decoration -->
      <div class="hero-decorative-backdrop" aria-hidden="true">
        <div class="hero-glow-orb hero-glow-cyan"></div>
        <div class="hero-glow-orb hero-glow-indigo"></div>
        <div class="hero-dot-matrix"></div>
        <svg class="hero-waves-svg" viewBox="0 0 400 240" fill="none" preserveAspectRatio="none">
          <defs>
            <linearGradient id="heroCurveGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.35" />
              <stop offset="50%" stop-color="#ffffff" stop-opacity="0.85" />
              <stop offset="100%" stop-color="#818cf8" stop-opacity="0.2" />
            </linearGradient>
            <linearGradient id="heroCurveGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#67e8f9" stop-opacity="0.6" />
              <stop offset="60%" stop-color="#3b82f6" stop-opacity="0.25" />
              <stop offset="100%" stop-color="#a855f7" stop-opacity="0.45" />
            </linearGradient>
            <linearGradient id="heroWaveFill" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.2" />
              <stop offset="100%" stop-color="#1e3a8a" stop-opacity="0.02" />
            </linearGradient>
          </defs>
          <path d="M-20,120 C70,60 170,170 310,95 C370,60 410,80 440,75 L440,240 L-20,240 Z"
            fill="url(#heroWaveFill)" />
          <path d="M-20,80 C80,15 180,150 310,70 C360,40 400,60 440,45" stroke="url(#heroCurveGrad1)"
            stroke-width="1.8" />
          <path d="M-30,110 C70,45 190,180 320,100 C370,70 410,85 450,75" stroke="url(#heroCurveGrad2)"
            stroke-width="1.3" stroke-dasharray="5 4" opacity="0.6" />
          <path d="M-10,145 C100,75 200,200 330,130 C380,100 410,115 440,105" stroke="url(#heroCurveGrad1)"
            stroke-width="1.2" opacity="0.4" />
        </svg>
      </div>

      <%
        const _areaRaw = String(session.collectorArea || '');
        let _areaList = (typeof collectorAreaList !== 'undefined' && Array.isArray(collectorAreaList) && collectorAreaList.length > 0)
          ? collectorAreaList : [];
        if (!_areaList.length && _areaRaw) {
          try { if (_areaRaw.startsWith('[')) _areaList = JSON.parse(_areaRaw); } catch(e){}
          if (!_areaList.length) _areaList = _areaRaw.split(/[,;|]/).map(s => s.trim()).filter(Boolean);
        }
      %>

      <div class="flutter-top-appbar">
        <div class="flutter-user-profile" onclick="openSettingsModal()" style="cursor: pointer;"
          title="Buka Profil & Pengaturan">
          <div class="flutter-avatar" id="topAppbarAvatar">
            <%= (session.collectorName || 'K' )[0].toUpperCase() %>
              <div class="flutter-online-dot"></div>
          </div>
          <div class="profile-text-wrap">
            <div class="flutter-greeting" id="topAppbarGreeting" title="Halo, <%= session.collectorName || 'Kolektor' %>">Halo, <%= session.collectorName || 'Kolektor' %></div>
            <div class="flutter-sub-badge">
              <span class="flutter-company-name" title="<%= company %>" style="display: inline-flex; align-items: center; gap: 4px; font-weight: 600; font-size: 11.5px; color: rgba(255, 255, 255, 0.9);">
                <i class="bi bi-patch-check-fill" style="color: #38bdf8; font-size: 11px;"></i>
                <span><%= company %></span>
              </span>
            </div>
          </div>
        </div>

        <div class="flutter-appbar-actions">
          <button type="button" class="flutter-icon-button theme-toggle-btn" id="themeToggleBtn" onclick="toggleAppThemeWithAnimation(event)"
            title="Ganti Tema Siang / Malam" aria-label="Ganti Tema">
            <i class="theme-toggle-icon bi bi-sun-fill" id="themeToggleIcon" style="color: #fbbf24;"></i>
          </button>
          <button type="button" class="flutter-icon-button" onclick="openSettingsModal()" title="Profil & Pengaturan" aria-label="Pengaturan">
            <i class="bi bi-gear-fill"></i>
          </button>
        </div>
      </div>

      <!-- Embedded Glass Wallet Card (Fintech Grade) -->
      <% const totalCust=Number(summary?.total_customer_count || 0); const paidCust=Number(summary?.paid_count || 0);
        const todayDue=Number(summary?.today_count || 0); const todayDone=Number(todayCollected?.count || 0); const
        todayTarget=todayDue + todayDone; const todayProgressPct=todayTarget> 0 ? Math.min(100, Math.round((todayDone /
        todayTarget) * 100)) : (todayDone > 0 ? 100 : 0);
        const curScope = String(scope || '');
        const curStatus = String(status || 'all');
        const baseQs = { month: String(month), year: String(year), search: String(search||'') };
        %>
        <div class="flutter-wallet-glass">
          <!-- Card Decorative Shimmer & Chip Watermark -->
          <div class="wallet-glass-decor" aria-hidden="true">
            <div class="wallet-shimmer-top"></div>
            <div class="wallet-mesh-orb"></div>
            <svg class="wallet-nfc-watermark" viewBox="0 0 48 48" fill="none">
              <path d="M12 24 C12 17.37 17.37 12 24 12 C30.63 12 36 17.37 36 24" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" opacity="0.35" />
              <path d="M16 24 C16 19.58 19.58 16 24 16 C28.42 16 32 19.58 32 24" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" opacity="0.5" />
              <path d="M20 24 C20 21.79 21.79 20 24 20 C26.21 20 28 21.79 28 24" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" opacity="0.8" />
              <circle cx="24" cy="24" r="2" fill="currentColor" opacity="0.9" />
            </svg>
          </div>

          <div class="wallet-top-header">
            <div class="wallet-tag-pill">Uang Kas di Tangan</div>
            <button type="button" class="btn-wallet-settle" onclick="switchMainScreenTab('setoran')">
              <span>Setor Kas</span>
              <i class="bi bi-arrow-right"></i>
            </button>
          </div>

          <div class="wallet-balance-row">
            <span class="wallet-cur-sign">Rp</span>
            <span class="wallet-nominal-num">
              <%= Number(todayCollected?.total || 0).toLocaleString('id-ID') %>
            </span>
          </div>

          <div class="wallet-sub-counter">
            <i class="bi bi-check2-circle me-1" style="color: #34d399;"></i>
            <span><strong>
                <%= todayDone %> Tagihan
              </strong> ditarik hari ini</span>
          </div>

          <!-- Integrated Daily Target Progress -->
          <div class="wallet-progress-wrap">
            <div class="flutter-progress-track">
              <div class="flutter-progress-fill" style="width: <%= todayProgressPct %>%;"></div>
            </div>
            <div class="flutter-progress-text">
              <span>Target Hari Ini (<%= todayDone %>/<%= todayTarget %> Selesai)</span>
              <span class="progress-pct-badge">
                <%= todayProgressPct %>%
              </span>
            </div>
          </div>
        </div>
    </div>

    <!-- 2. CURVED NATIVE CONTENT SURFACE -->
    <div class="flutter-content-surface">

      <!-- Alert Flash Message -->
      <% if (msg) { %>
        <div
          class="alert alert-<%= msg.type==='error'?'danger':'success' %> alert-dismissible fade show d-flex align-items-center gap-2 mb-3"
          style="border-radius:16px;padding:12px 16px;font-size:13px;font-weight:700;">
          <i class="bi <%= msg.type==='error'?'bi-exclamation-triangle-fill':'bi-check-circle-fill' %>"></i>
          <div style="flex:1"><%- msg.text %></div>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"
            style="padding:12px;"></button>
        </div>
        <% } %>

          <!-- ══════════════════════════════════════════════════════════════
         SCREEN TAB 1: PENAGIHAN & PETA RUTE TERDEKAT
         ══════════════════════════════════════════════════════════════ -->
          <div id="screenTabPenagihan">

            <!-- Mode 1A: List View Container -->
            <div id="collectorListView">
              <!-- Bento Tonal Tiles (4 Quick Stats) -->
              <div class="flutter-bento-grid">
                <a class="flutter-bento-tile tile-today <%= curScope === 'today' ? 'active' : '' %>"
                  href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'today' }).toString() %>#daftar-tagihan">
                  <div class="bento-num-val" style="color:#d97706;">
                    <%= Number(summary?.today_count || 0) %>
                  </div>
                  <div class="bento-label-text">Hari Ini</div>
                </a>
                <a class="flutter-bento-tile tile-unpaid <%= (curScope === 'unpaid' || curStatus === 'unpaid') && curScope !== 'today' && curScope !== 'isolir' && curScope !== 'multi' ? 'active' : '' %>"
                  href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'unpaid' }).toString() %>#daftar-tagihan">
                  <div class="bento-num-val" style="color:#dc2626;">
                    <%= Number(summary?.unpaid_count || 0) %>
                  </div>
                  <div class="bento-label-text">Belum Bayar</div>
                </a>
                <a class="flutter-bento-tile tile-isolir <%= curScope === 'isolir' ? 'active' : '' %>"
                  href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'isolir' }).toString() %>#daftar-tagihan">
                  <div class="bento-num-val" style="color:#7c3aed;">
                    <%= Number(summary?.isolir_count || 0) %>
                  </div>
                  <div class="bento-label-text">Isolir</div>
                </a>
                <a class="flutter-bento-tile tile-multi <%= curScope === 'multi' ? 'active' : '' %>"
                  href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'multi' }).toString() %>#daftar-tagihan">
                  <div class="bento-num-val" style="color:#0284c7;">
                    <%= Number(summary?.multi_customer_count || 0) %>
                  </div>
                  <div class="bento-label-text">&gt; 1 Bln</div>
                </a>
              </div>

              <!-- Material 3 Search Bar -->
              <form method="GET" action="/collector" class="m3-search-bar-wrap">
                <input type="hidden" name="scope" value="<%= curScope %>">
                <input type="hidden" name="month" value="<%= month %>">
                <input type="hidden" name="year" value="<%= year %>">
                <i class="bi bi-search text-muted" style="font-size:16px;"></i>
                <input type="text" name="search" class="m3-search-input" placeholder="Cari nama, no HP, atau area..."
                  value="<%= search %>">
                <% if (search) { %>
                  <a href="/collector" class="text-muted me-1" title="Hapus Pencarian"><i
                      class="bi bi-x-circle-fill"></i></a>
                  <% } %>
                    <button type="submit" class="m3-search-btn" title="Cari"><i class="bi bi-arrow-right"></i></button>
              </form>

              <% if (_areaList.length > 1) { %>
                <!-- Horizontal Quick Territory Chips Bar -->
                <div class="territory-chip-bar" id="territoryChipBar">
                  <button type="button" class="territory-chip active" data-area="all" onclick="selectActiveArea('all', 'Semua Wilayah')">
                    <i class="bi bi-grid-fill" style="font-size: 10px;"></i>
                    <span>Semua Wilayah</span>
                    <span class="chip-count"><%= invoices ? invoices.length : 0 %></span>
                  </button>
                  <% _areaList.forEach(a => { 
                       const aTrim = a.trim();
                       const aCnt = (invoices || []).filter(inv => String(inv.customer_area || '').trim().toLowerCase() === aTrim.toLowerCase()).length;
                  %>
                    <button type="button" class="territory-chip" data-area="<%= aTrim.toLowerCase() %>" onclick="selectActiveArea('<%= aTrim.toLowerCase() %>', '<%= aTrim %>')">
                      <i class="bi bi-geo-alt-fill" style="font-size: 10px;"></i>
                      <span><%= aTrim %></span>
                      <span class="chip-count"><%= aCnt %></span>
                    </button>
                  <% }); %>
                </div>
              <% } %>

              <!-- Invisible Scroll Anchor (Clean, Zero-Height, No Outline) -->
              <div id="daftar-tagihan" style="height:0; margin:0; padding:0; outline:none; border:none; visibility:hidden; pointer-events:none;" aria-hidden="true"></div>

              <!-- Filter Chips Bar -->
              <div class="flutter-chip-bar">
                <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'all', scope: '' }).toString() %>#daftar-tagihan"
                  class="m3-filter-chip <%= (!curScope && curStatus==='all') ? 'active' : '' %>">
                  Semua (<%= summary?.total_customer_count || 0 %>)
                </a>
                <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'today' }).toString() %>#daftar-tagihan"
                  class="m3-filter-chip <%= curScope==='today' ? 'active' : '' %>">
                  Hari Ini (<%= summary?.today_count || 0 %>)
                </a>
                <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'unpaid' }).toString() %>#daftar-tagihan"
                  class="m3-filter-chip <%= (curScope==='unpaid' || curStatus==='unpaid') && curScope!=='today' && curScope!=='isolir' && curScope!=='multi' ? 'active' : '' %>">
                  Belum Bayar (<%= summary?.unpaid_count || 0 %>)
                </a>
                <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'isolir' }).toString() %>#daftar-tagihan"
                  class="m3-filter-chip <%= curScope==='isolir' ? 'active' : '' %>">
                  Terisolir (<%= summary?.isolir_count || 0 %>)
                </a>
                <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'multi' }).toString() %>#daftar-tagihan"
                  class="m3-filter-chip <%= curScope==='multi' ? 'active' : '' %>">
                  &gt; 1 Bln (<%= summary?.multi_customer_count || 0 %>)
                </a>
                <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'paid', scope: '' }).toString() %>#daftar-tagihan"
                  class="m3-filter-chip <%= curStatus==='paid' ? 'active' : '' %>">
                  Lunas (<%= summary?.paid_count || 0 %>)
                </a>
              </div>

              <!-- Customer Cards List -->
              <div class="customer-cards-list">
                <div id="areaEmptyNotice" class="flutter-customer-card text-center p-4" style="display: none;">
                  <i class="bi bi-geo-alt text-muted" style="font-size: 36px;"></i>
                  <div class="fw-bold mt-2" style="font-size: 14.5px;">Tidak Ada Tagihan di Wilayah Ini</div>
                  <div style="font-size: 12px; color: var(--m3-on-surface-variant); margin-top: 4px;">
                    Tidak ditemukan pelanggan yang cocok dengan filter wilayah yang dipilih.
                  </div>
                </div>

                <% if (!invoices || invoices.length===0) { %>
                  <div class="flutter-customer-card text-center p-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 42px;"></i>
                    <div class="fw-bold mt-2" style="font-size: 15px;">Tidak Ada Data Tagihan</div>
                    <div style="font-size: 12.5px; color: var(--m3-on-surface-variant); margin-top: 4px;">
                      Coba sesuaikan kata kunci pencarian atau filter status tagihan.
                    </div>
                  </div>
                  <% } else { %>
                    <% const
                      monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
                      %>
                      <% invoices.forEach(function(inv) { 
                        const pendingReq = (typeof pendingMap !== 'undefined' && pendingMap) ? 
                          (inv.invoice_id ? pendingMap.get('inv_' + inv.invoice_id) : pendingMap.get('cust_' + inv.customer_id)) : null;
                        const isPending = !!(pendingReq && pendingReq.status === 'pending');
                        const isPaid = (inv.invoice_status === 'paid' || inv.status === 'paid'); 
                        const amount = Number(inv.invoice_amount || inv.amount || inv.package_price || 0);
                        const noInvoice = !inv.invoice_id;
                        const cardModifier = isPaid ? 'card-paid' : (isPending ? 'card-pending' : '');
                        const monoClass = isPaid ? 'mono-paid' : (isPending ? 'mono-pending' : 'mono-unpaid');
                        const names = String(inv.customer_name || 'U').trim().split(/\s+/);
                        let initials = names[0][0].toUpperCase();
                        if (names.length > 1) initials += names[names.length - 1][0].toUpperCase();

                        // Clean WA phone number
                        let rawPhone = String(inv.customer_phone || '').replace(/[^0-9]/g, '');
                        if (rawPhone.startsWith('62')) rawPhone = '0' + rawPhone.slice(2);
                        const cleanWaPhone = rawPhone.startsWith('0') ? ('62' + rawPhone.slice(1)) : rawPhone;
                        const monthNameStr = monthNames[Number(month)-1] || month;
                        const waMessageText = encodeURIComponent(`Halo Bpk/Ibu *${inv.customer_name ||
                        'Pelanggan'}*,\n\nKami dari *${company}* ingin mengonfirmasi terkait tagihan internet periode
                        *${monthNameStr} ${year}* sebesar *Rp ${amount.toLocaleString('id-ID')}*.\n\nPetugas kolektor
                        kami saat ini sedang berada di area Anda. Apakah bisa kami bantu proses pembayaran di
                        tempat?\n\nTerima kasih.`);
                        %>
                        <!-- Native Android Flutter Style Customer Card -->
                        <div class="flutter-customer-card <%= cardModifier %>" data-area="<%= String(inv.customer_area || '').trim().toLowerCase() %>">
                          <div class="card-list-tile">
                            <!-- Monogram Circle -->
                            <div class="cust-monogram-circle <%= monoClass %>">
                              <%= initials %>
                            </div>

                            <!-- Tile Details -->
                            <div class="tile-body">
                              <div class="tile-header-row">
                                <div class="cust-title-name">
                                  <%= inv.customer_name || '-' %>
                                </div>
                                <div>
                                  <% if (isPaid) { %>
                                    <span class="cust-status-badge st-paid">Lunas</span>
                                    <% } else if (isPending) { %>
                                      <span class="cust-status-badge st-pending">Verifikasi</span>
                                      <% } else if (inv.customer_status==='suspended' ) { %>
                                        <span class="cust-status-badge st-isolir">Isolir</span>
                                        <% } else { %>
                                          <span class="cust-status-badge st-unpaid">Belum Bayar</span>
                                          <% } %>
                                </div>
                              </div>

                              <div class="cust-subtitle-meta">
                                <strong style="color:var(--m3-primary);">
                                  <%= inv.package_name || 'Internet' %>
                                </strong>
                                &bull; ID: #<%= inv.customer_id %>
                                  <% if (inv.billing_day || inv.isolate_day) { %>
                                    &bull; <span class="text-warning fw-bold">Tgl <%= inv.billing_day || inv.isolate_day
                                        %></span>
                                    <% } %>
                              </div>

                              <div class="cust-address-line">
                                <i class="bi bi-geo-alt me-1 text-muted"></i>
                                <span>
                                  <%= inv.customer_address || '-' %>
                                </span>
                                <% if (inv.customer_area) { %>
                                  <span class="cust-area-pill-mini"><%= inv.customer_area %></span>
                                <% } %>
                              </div>
                              <% const activePromise=typeof latestPromises !=='undefined' ?
                                latestPromises.get(inv.customer_id) : null; %>
                                <% if (activePromise && !isPaid) { %>
                                  <div
                                    style="font-size: 11px; color: #d97706; margin-top: 4px; font-weight: 700; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 6px; padding: 2px 8px; display: inline-flex; align-items: center; gap: 4px;">
                                    <span>Janji Bayar: Tgl <%= activePromise.promised_day %>
                                        <%= activePromise.note ? '(' + activePromise.note + ')' : '' %></span>
                                  </div>
                                  <% } %>
                            </div>
                          </div>

                          <!-- Card Price & Quick Contact Row -->
                          <div class="card-price-contact-row">
                            <div class="price-headline-box">
                              <span class="price-currency">Rp</span>
                              <span class="price-nominal">
                                <%= amount.toLocaleString('id-ID') %>
                              </span>
                            </div>

                            <div class="contact-quick-group">
                              <% if (inv.customer_phone) { %>
                                <a href="tel:<%= inv.customer_phone %>" class="contact-circle-btn" title="Telepon">
                                  <i class="bi bi-telephone-fill"></i>
                                </a>
                                <a href="https://wa.me/<%= cleanWaPhone %>?text=<%= waMessageText %>" target="_blank"
                                  class="contact-circle-btn btn-wa-color" title="Chat WhatsApp">
                                  <i class="bi bi-whatsapp"></i>
                                </a>
                                <% } %>
                                  <% if (inv.lat && inv.lng) { %>
                                    <a href="https://www.google.com/maps?q=<%= encodeURIComponent(inv.lat + ',' + inv.lng) %>"
                                      target="_blank" class="contact-circle-btn btn-maps-color"
                                      title="Buka Google Maps">
                                      <i class="bi bi-cursor-fill"></i>
                                    </a>
                                    <% } %>
                            </div>
                          </div>

                          <!-- Primary Action Buttons Row -->
                          <% if (!isPaid && !isPending) { %>
                            <div class="card-action-grid">
                              <button type="button" class="btn-card-reschedule"
                                onclick="openPromiseModal('<%= inv.customer_id %>', '<%= inv.customer_name ? inv.customer_name.replace(/'/g, '\\\'') : '' %>', <%= inv.billing_day || inv.isolate_day || 1 %>)">
                                Janji Bayar
                              </button>
                              <button type="button" class="btn-card-pay"
                                onclick="openPayConfirmModal('<%= inv.customer_id %>', '<%= inv.invoice_id || '' %>', '<%= inv.customer_name ? inv.customer_name.replace(/'/g, '\\\'') : '' %>', <%= amount %>, <%= noInvoice ? 'true' : 'false' %>)">
                                Terima Bayar
                              </button>
                            </div>
                            <% } else if (isPaid) { %>
                              <div class="card-action-grid">
                                <% if (inv.invoice_id) { %>
                                  <a href="/collector/invoice/<%= inv.invoice_id %>/print-thermal" target="_blank"
                                    class="btn-card-print">
                                    <i class="bi bi-printer me-1"></i> Cetak Struk Pembayaran
                                  </a>
                                <% } else { %>
                                  <div style="grid-column: 1 / -1; text-align: center; font-size: 12px; font-weight: 700; color: #10b981; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 10px; padding: 10px 12px;">
                                    <i class="bi bi-check-circle-fill me-1"></i> Pembayaran Lunas
                                  </div>
                                <% } %>
                              </div>
                            <% } else if (isPending) { %>
                              <div class="card-action-grid">
                                <div style="grid-column: 1 / -1; text-align: center; font-size: 12px; font-weight: 700; color: #d97706; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 10px; padding: 10px 12px;">
                                  <i class="bi bi-clock-history me-1"></i> Menunggu Verifikasi Admin
                                </div>
                              </div>
                            <% } %>
                        </div>
                        <% }) %>
                          <% } %>
              </div>
            </div>

            <!-- Mode 1B: Map View Container -->
            <div id="collectorMapView" style="display: none; position: relative;">
              <div class="flutter-chip-bar">
                <button type="button" class="m3-filter-chip active" id="chipMapUnpaid"
                  onclick="filterMapMarkers('unpaid')">
                  Belum Bayar (<span id="countMapUnpaid">0</span>)
                </button>
                <button type="button" class="m3-filter-chip" id="chipMapToday" onclick="filterMapMarkers('today')">
                  Hari Ini (<span id="countMapToday">0</span>)
                </button>
                <button type="button" class="m3-filter-chip" id="chipMapIsolir" onclick="filterMapMarkers('isolir')">
                  Terisolir (<span id="countMapIsolir">0</span>)
                </button>
                <button type="button" class="m3-filter-chip" id="chipMapNear1k" onclick="filterMapMarkers('near1k')">
                  &lt; 1 KM
                </button>
              </div>

              <!-- Notice when customers have no GPS coordinates in DB -->
              <div id="mapNoGpsAlert" class="map-no-gps-banner" style="display: none;">
                <div style="display: flex; align-items: flex-start; gap: 11px;">
                  <i class="bi bi-geo-alt-fill" style="color: #f59e0b; font-size: 20px; flex-shrink: 0; margin-top: 1px;"></i>
                  <div style="flex: 1; min-width: 0;">
                    <div style="font-weight: 800; font-size: 13.5px; color: var(--m3-on-surface); line-height: 1.3;">
                      Pelanggan Belum Memiliki Titik GPS
                    </div>
                    <div style="font-size: 11.5px; color: var(--m3-on-surface-variant); margin-top: 4px; line-height: 1.45;">
                      Terdapat <strong style="color: var(--m3-on-surface);"><%= invoices ? invoices.length : 0 %> tagihan pelanggan</strong> di wilayah Anda, namun belum memiliki titik koordinat Latitude & Longitude lokasi rumah atau ODP di database server.
                    </div>
                    <div style="font-size: 11px; color: #0284c7; font-weight: 700; margin-top: 6px; display: inline-flex; align-items: center; gap: 4px;">
                      <i class="bi bi-info-circle-fill"></i>
                      <span>Lengkapi koordinat pelanggan/ODP di menu Admin atau Teknisi agar titik peta rute otomatis muncul.</span>
                    </div>
                  </div>
                </div>
              </div>

              <div id="collectorMap"></div>

              <!-- Floating Recenter Button -->
              <button type="button" class="btn-map-recenter" onclick="recenterCollectorLocation()"
                title="Pusatkan ke Posisi Saya">
                <i class="bi bi-crosshair2"></i>
              </button>

              <!-- Floating Nearest Customer Drawer with Road Routing & Minimized Peek -->
              <div class="nearest-target-drawer" id="nearestTargetDrawer">
                <!-- Top Center Drag Handle -->
                <div class="drawer-drag-wrap" onclick="toggleDrawerMinimize()" title="Klik untuk perkecil / perluas">
                  <div class="drawer-drag-pill"></div>
                </div>

                <!-- 1. MINIMIZED PEEK BAR (Shown when .is-minimized) -->
                <div class="drawer-peek-bar" onclick="toggleDrawerMinimize()" style="display: none;">
                  <div class="d-flex align-items-center gap-2" style="flex: 1; min-width: 0;">
                    <span class="target-order-badge-mini" id="peekTargetBadge">#1</span>
                    <div class="peek-cust-info">
                      <span class="peek-cust-name" id="peekCustName">-</span>
                      <span class="peek-cust-dist" id="peekCustDist">• 0 m</span>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-2" style="flex-shrink: 0;">
                    <span class="peek-cust-amount" id="peekCustAmount">Rp 0</span>
                    <button type="button" class="btn-drawer-mini-toggle" title="Perluas Detail">
                      <i class="bi bi-chevron-up"></i>
                    </button>
                  </div>
                </div>

                <!-- 2. EXPANDED FULL BODY (Hidden when .is-minimized) -->
                <div class="drawer-expanded-body">
                  <div class="target-drawer-header">
                    <div class="d-flex align-items-center gap-1" style="flex:1; min-width:0;">
                      <span class="target-order-badge" id="drawerTargetOrderBadge">#1</span>
                      <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25"
                        style="font-size:10px; font-weight:700; white-space:nowrap;" id="drawerRoutePill">
                        <i class="bi bi-sign-turn-right-fill me-1"></i>Rute Jalan
                      </span>
                    </div>
                    <div class="d-flex align-items-center gap-2" style="flex-shrink:0;">
                      <span class="target-dist-val" id="drawerTargetDist" style="white-space:nowrap;">0 m</span>
                      <button type="button" class="btn-drawer-toggle" onclick="toggleDrawerMinimize()"
                        title="Kecilkan Kartu">
                        <i class="bi bi-chevron-down"></i>
                      </button>
                    </div>
                  </div>

                  <div class="d-flex justify-content-between align-items-start mt-1">
                    <div style="flex:1; min-width:0; padding-right:8px;">
                      <div
                        style="font-weight: 800; font-size: 15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                        id="drawerCustName">-</div>
                      <div
                        style="font-size: 12px; color: var(--m3-on-surface-variant); margin-top: 2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                        id="drawerCustAddress">-</div>
                    </div>
                    <div style="font-size: 16px; font-weight: 900; color: #ef4444; flex-shrink:0;"
                      id="drawerCustAmount">Rp 0</div>
                  </div>

                  <div
                    class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary border-opacity-10 gap-2">
                    <!-- Prev / Next Target Buttons -->
                    <div class="btn-group btn-group-sm" role="group">
                      <button type="button" class="btn btn-outline-secondary" onclick="stepTargetDrawer(-1)"
                        title="Target Sebelumnya"
                        style="border-radius:10px 0 0 10px; font-weight:700; padding:6px 12px;">
                        <i class="bi bi-chevron-left"></i>
                      </button>
                      <button type="button" class="btn btn-outline-secondary" onclick="stepTargetDrawer(1)"
                        title="Target Berikutnya"
                        style="border-radius:0 10px 10px 0; font-weight:700; padding:6px 12px;">
                        <i class="bi bi-chevron-right"></i>
                      </button>
                    </div>

                    <div class="d-flex gap-2">
                      <a href="#" target="_blank" class="btn btn-sm btn-primary" id="drawerMapsRouteBtn"
                        style="border-radius:10px; font-weight:800; font-size:12px; display:inline-flex; align-items:center; gap:5px; box-shadow:0 3px 10px rgba(2,132,199,0.35);">
                        <i class="bi bi-google"></i>
                        <span>Google Maps</span>
                      </a>
                      <button type="button" class="btn btn-sm btn-success" id="drawerPayBtn"
                        style="border-radius:10px; font-weight:800; font-size:12px; padding:6px 14px;">
                        Bayar
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div> <!-- End Screen Tab 1 -->

          <!-- ══════════════════════════════════════════════════════════════
         SCREEN TAB 2: KAS & PENGAJUAN SETORAN KE KANTOR
         ══════════════════════════════════════════════════════════════ -->
          <div id="screenTabSetoran" style="display: none;">
            <div class="flutter-customer-card"
              style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(2, 132, 199, 0.08) 100%);">
              <div class="d-flex align-items-center gap-2 mb-2">
                <span
                  style="font-weight: 800; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.8px; color: #059669;">
                  TOTAL KAS DI TANGAN (FISIK)
                </span>
              </div>
              <div style="font-size: 32px; font-weight: 900; color: var(--m3-on-surface); letter-spacing: -1px;">
                Rp <%= Number(todayCollected?.total || 0).toLocaleString('id-ID') %>
              </div>
              <div style="font-size: 12.5px; color: var(--m3-on-surface-variant); margin-top: 4px;">
                Tercatat dari <strong>
                  <%= Number(todayCollected?.count || 0) %> transaksi pembayaran
                </strong> yang telah Anda proses hari ini.
              </div>
            </div>

            <div class="flutter-customer-card mt-3">
              <div style="font-weight: 800; font-size: 15px; margin-bottom: 4px;">
                Form Serah Terima / Setor Kas
              </div>
              <div style="font-size: 12px; color: var(--m3-on-surface-variant); margin-bottom: 16px;">
                Setelah Anda menyetorkan uang fisik ke kasir/admin kantor atau via transfer, buat pengajuan di bawah
                agar saldo kas di tangan Anda kembali nol.
              </div>

              <form action="/collector/settlement-request" method="POST">
                <div class="mb-3">
                  <label class="form-label"
                    style="font-size: 12px; font-weight: 700; color: var(--m3-on-surface-variant);">Nominal Uang yang
                    Disetor:</label>
                  <div class="m3-input-integrated-box">
                    <span class="m3-input-integrated-prefix">Rp</span>
                    <input type="number" name="amount" id="settleAmountField" class="m3-input-integrated-field"
                      placeholder="0" min="1" max="<%= Number(todayCollected?.total || 0) %>"
                      value="<%= Number(todayCollected?.total || 0) %>" required>
                    <button type="button" class="m3-input-integrated-action"
                      onclick="setFullSettleAmount(<%= Number(todayCollected?.total || 0) %>)">
                      Setor Semua
                    </button>
                  </div>
                  <div style="font-size: 11px; color: var(--m3-on-surface-variant); margin-top: 4px;">
                    Maksimal nominal: Rp <%= Number(todayCollected?.total || 0).toLocaleString('id-ID') %>
                  </div>
                </div>

                <div class="mb-3">
                  <label class="form-label"
                    style="font-size: 12px; font-weight: 700; color: var(--m3-on-surface-variant);">Metode
                    Penyerahan:</label>
                  <select name="method" class="form-select"
                    style="background:var(--m3-surface-container-high); border-color:var(--m3-outline-variant); color:var(--m3-on-surface); font-size:13.5px; font-weight:700; border-radius:12px; padding:10px 14px;">
                    <option value="cash">Tunai ke Kasir / Kantor</option>
                    <option value="transfer">Transfer Bank ke Rekening Kantor</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label"
                    style="font-size: 12px; font-weight: 700; color: var(--m3-on-surface-variant);">Catatan Tambahan
                    (Opsional):</label>
                  <input type="text" name="notes" class="form-control"
                    placeholder="Contoh: Titip lewat mas kasir / no ref transfer"
                    style="background:var(--m3-surface-container-high); border-color:var(--m3-outline-variant); color:var(--m3-on-surface); font-size:13px; border-radius:12px; padding:10px 14px;">
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold"
                  style="border-radius: 14px; min-height: 46px; font-size: 14px;" <%=Number(todayCollected?.total || 0)
                  <=0 ? 'disabled' : '' %>>
                  Ajukan Serah Terima Kas
                </button>
              </form>
            </div>

            <!-- History Pengajuan Setoran Saya -->
            <div class="flutter-customer-card mt-3">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div style="font-weight: 800; font-size: 15px;">
                  Status Pengajuan Setoran Saya
                </div>
                <span class="badge bg-secondary" style="font-size:11px; border-radius:10px;">
                  <%= (typeof mySettlements !=='undefined' ? mySettlements : []).length %> Data
                </span>
              </div>

              <% const sList=typeof mySettlements !=='undefined' ? mySettlements : []; %>
                <% if (sList.length===0) { %>
                  <div class="text-center py-4 text-muted" style="font-size: 13px;">
                    Belum ada pengajuan setoran yang dibuat.
                  </div>
                  <% } else { %>
                    <div class="d-flex flex-column gap-2">
                      <% sList.forEach(function(st) { %>
                        <div
                          style="background: var(--m3-surface-container-high); border: 1px solid var(--m3-outline-variant); border-radius: 14px; padding: 12px 14px; display: flex; justify-content: space-between; align-items: center;">
                          <div>
                            <div style="font-weight: 800; font-size: 15px;">
                              Rp <%= Number(st.amount || 0).toLocaleString('id-ID') %>
                            </div>
                            <div style="font-size: 11.5px; color: var(--m3-on-surface-variant); margin-top: 2px;">
                              <%= st.created_at || '-' %> &bull; <%= st.method==='transfer' ? 'Transfer' : 'Tunai' %>
                            </div>
                            <% if (st.notes) { %>
                              <div
                                style="font-size: 11px; color: var(--m3-on-surface-variant); font-style: italic; margin-top: 2px;">
                                "<%= st.notes %>"
                              </div>
                              <% } %>
                          </div>
                          <div>
                            <% if (st.status==='approved' ) { %>
                              <span class="badge bg-success" style="font-size: 11px; border-radius: 8px;">Diterima
                                Kasir</span>
                              <% } else if (st.status==='rejected' ) { %>
                                <span class="badge bg-danger"
                                  style="font-size: 11px; border-radius: 8px;">Ditolak</span>
                                <% } else { %>
                                  <span class="badge bg-warning text-dark"
                                    style="font-size: 11px; border-radius: 8px;">Menunggu Verifikasi</span>
                                  <% } %>
                          </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
            </div>
          </div> <!-- End Screen Tab 2 -->

          <!-- ══════════════════════════════════════════════════════════════
         SCREEN TAB 3: RIWAYAT TRANSAKSI & CETAK STRUK
         ══════════════════════════════════════════════════════════════ -->
          <div id="screenTabRiwayat" style="display: none;">
            <div class="flutter-customer-card">
              <div style="font-weight: 800; font-size: 16px; margin-bottom: 6px;">
                Riwayat Pembayaran Berhasil
              </div>
              <div style="font-size: 12.5px; color: var(--m3-on-surface-variant); margin-bottom: 14px;">
                Daftar seluruh pembayaran pelanggan yang telah lunas ditarik. Anda dapat mencetak ulang struk thermal
                Bluetooth kapan saja jika pelanggan meminta bukti pembayaran.
              </div>

              <% const paidList = (invoices || []).filter(i => (i.invoice_status === 'paid' || i.status === 'paid')); %>
                <% if (paidList.length===0) { %>
                  <div class="text-center py-5 text-muted" style="font-size: 13px;">
                    Belum ada riwayat pembayaran yang lunas pada periode ini.
                  </div>
                  <% } else { %>
                    <div class="d-flex flex-column gap-2">
                      <% paidList.forEach(function(p) { %>
                        <div
                          style="background: var(--m3-surface-container-high); border: 1px solid var(--m3-outline-variant); border-radius: 16px; padding: 12px 14px; display: flex; justify-content: space-between; align-items: center;">
                          <div>
                            <div style="font-weight: 800; font-size: 14.5px;">
                              <%= p.customer_name %>
                            </div>
                            <div style="font-size: 11.5px; color: var(--m3-on-surface-variant); margin-top: 2px;">
                              ID: #<%= p.customer_id %> &bull; <strong style="color: #059669;">Rp <%= Number(p.amount ||
                                    p.package_price || 0).toLocaleString('id-ID') %></strong>
                            </div>
                            <div style="font-size: 11px; color: var(--m3-on-surface-variant); margin-top: 2px;">
                              <%= p.customer_address || '-' %>
                            </div>
                          </div>
                          <div>
                            <% if (p.invoice_id) { %>
                              <a href="/collector/invoice/<%= p.invoice_id %>/print-thermal" target="_blank"
                                class="btn btn-sm btn-outline-secondary"
                                style="border-radius: 10px; font-weight: 700; font-size: 12px; padding: 6px 12px;">
                                <i class="bi bi-printer me-1"></i> Struk
                              </a>
                              <% } %>
                          </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
            </div>
          </div> <!-- End Screen Tab 3 -->

    </div> <!-- End .flutter-content-surface -->

    <!-- 6. SLIDE-UP BOTTOM SHEET (MODAL PEMBAYARAN TUNAI) -->
    <div class="modal-custom-backdrop" id="payConfirmModal" onclick="if(event.target === this) closePayModal()">
      <div class="modal-custom-box">
        <div class="sheet-drag-handle-wrapper" onclick="closePayModal()" title="Tutup lembar">
          <div class="sheet-drag-handle"></div>
        </div>

        <div
          style="padding: 14px 20px 10px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--m3-outline-variant);">
          <span style="font-weight: 800; font-size: 16px;">
            Konfirmasi Penerimaan Tunai
          </span>
          <button type="button" class="btn-close" onclick="closePayModal()" aria-label="Close"></button>
        </div>

        <form action="/collector/payment-request" method="POST">
          <input type="hidden" name="customer_id" id="modalCustomerId">
          <input type="hidden" name="invoice_id" id="modalInvoiceId">
          <input type="hidden" name="month" value="<%= month %>">
          <input type="hidden" name="year" value="<%= year %>">
          <input type="hidden" name="status" value="<%= status %>">
          <input type="hidden" name="search" value="<%= search %>">
          <input type="hidden" name="scope" value="<%= scope %>">

          <div style="padding: 16px 20px;">
            <div
              style="background: var(--m3-surface-container-high); border: 1px solid var(--m3-outline-variant); border-radius: 18px; padding: 14px 16px; margin-bottom: 14px;">
              <div style="font-size: 12px; color: var(--m3-on-surface-variant); font-weight: 600;">Pelanggan:</div>
              <div id="modalCustName" style="font-size: 16px; font-weight: 800; margin-top: 2px;">-</div>
              <div style="font-size: 12px; color: var(--m3-on-surface-variant); margin-top: 6px; font-weight: 600;">
                Total Nominal Diterima:</div>
              <div id="modalAmountDisplay" style="font-size: 24px; font-weight: 900; color: #059669; margin-top: 2px;">
                Rp 0</div>
            </div>

            <div class="mb-3">
              <label class="form-label mb-1"
                style="font-size: 12px; font-weight: 700; color: var(--m3-on-surface-variant);">Metode
                Penagihan:</label>
              <input type="text" class="form-control" value="Tunai di Lokasi (Cash on Delivery)" readonly
                style="background:var(--m3-surface-container-highest); border-color:var(--m3-outline-variant); color:var(--m3-on-surface); font-size:13px; font-weight:700; border-radius:12px; padding:10px 14px;">
            </div>

            <div style="font-size: 12px; color: var(--m3-on-surface-variant); line-height: 1.4;">
              Pastikan uang fisik telah Anda terima secara penuh dari pelanggan. Saldo kas di tangan Anda akan bertambah
              secara otomatis setelah menekan tombol konfirmasi.
            </div>
          </div>

          <div
            style="padding: 14px 20px; background: var(--m3-surface-container-high); border-top: 1px solid var(--m3-outline-variant); display: flex; gap: 10px;">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3"
              style="border-radius:14px; font-weight:700; min-height:46px;" onclick="closePayModal()">Batal</button>
            <button type="submit" class="btn btn-success fw-bold flex-fill"
              style="border-radius:14px; min-height:46px; font-size:14.5px;">
              Konfirmasi Lunas
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 6B. SLIDE-UP BOTTOM SHEET (MODAL JANJI BAYAR) -->
    <div class="modal-custom-backdrop" id="promiseModal" onclick="if(event.target === this) closePromiseModal()">
      <div class="modal-custom-box">
        <!-- Top Drag Handle (Tap to dismiss) -->
        <div class="sheet-drag-handle-wrapper" onclick="closePromiseModal()" title="Ketuk untuk menutup lembar">
          <div class="sheet-drag-handle"></div>
        </div>

        <!-- Human Header: Focused, Calm, Dignified -->
        <div style="padding: 14px 22px 14px; border-bottom: 1px solid var(--m3-outline-variant);">
          <div style="font-weight: 800; font-size: 16.5px; color: var(--m3-on-surface); letter-spacing: -0.01em;">
            Janji Bayar Pelanggan
          </div>
          <div style="font-size: 13px; color: var(--m3-on-surface-variant); margin-top: 3px;">
            <span id="modalPromiseCustName" style="font-weight: 700; color: var(--m3-on-surface);">-</span>
            <span style="opacity: 0.4; margin: 0 4px;">&bull;</span>
            <span>Jadwal rutin: <strong id="modalPromiseCurrentDay" style="color: var(--m3-on-surface);">Tgl -</strong></span>
          </div>
        </div>

        <form action="/collector/promise" method="POST">
          <input type="hidden" name="customer_id" id="modalPromiseCustomerId">
          <input type="hidden" name="promised_day" id="modalPromiseDayInput" value="22">

          <div style="padding: 18px 22px 16px;">
            <% 
              const _todayDay = Number(typeof todayDay !== 'undefined' ? todayDay : new Date().getDate());
              const _totalDaysInMonth = new Date(year, month, 0).getDate();
              const _fullDays = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
              const _monthNamesList = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
              const _curMonthName = _monthNamesList[Number(month)-1] || 'Bulan Ini';
            %>

            <!-- Section: Date Selection -->
            <div class="mb-3.5">
              <label style="font-size: 12.5px; font-weight: 700; color: var(--m3-on-surface); margin-bottom: 8px; display: block;">
                Tanggal Janji Bayar Baru
              </label>

              <!-- 4 Clean Preset Buttons (Sleek Apple/Linear style - NO EMOJIS) -->
              <div class="date-preset-grid">
                <% if (_todayDay < _totalDaysInMonth) { 
                     const nextD = _todayDay + 1;
                     const nextDate = new Date(year, month - 1, nextD);
                     const nextDayName = _fullDays[nextDate.getDay()];
                %>
                  <button type="button" class="date-preset-btn active" id="presetBtn_<%= nextD %>" onclick="setPresetDate(<%= nextD %>, 'Besok', '<%= nextDayName %>, <%= nextD %> <%= _curMonthName %> <%= year %>', this)">
                    <span class="preset-main">Besok</span>
                    <span class="preset-sub">Tgl <%= nextD %></span>
                  </button>
                <% } %>

                <% if (_todayDay + 1 < _totalDaysInMonth) { 
                     const lusaD = _todayDay + 2;
                     const lusaDate = new Date(year, month - 1, lusaD);
                     const lusaDayName = _fullDays[lusaDate.getDay()];
                %>
                  <button type="button" class="date-preset-btn" id="presetBtn_<%= lusaD %>" onclick="setPresetDate(<%= lusaD %>, 'Lusa', '<%= lusaDayName %>, <%= lusaD %> <%= _curMonthName %> <%= year %>', this)">
                    <span class="preset-main">Lusa</span>
                    <span class="preset-sub">Tgl <%= lusaD %></span>
                  </button>
                <% } %>

                <% if (_todayDay <= 25 && _totalDaysInMonth >= 25) { 
                     const payDate = new Date(year, month - 1, 25);
                     const payDayName = _fullDays[payDate.getDay()];
                %>
                  <button type="button" class="date-preset-btn" id="presetBtn_25" onclick="setPresetDate(25, 'Gajian', '<%= payDayName %>, 25 <%= _curMonthName %> <%= year %>', this)">
                    <span class="preset-main">Gajian</span>
                    <span class="preset-sub">Tgl 25</span>
                  </button>
                <% } %>

                <% if (_todayDay < _totalDaysInMonth) { 
                     const endD = _totalDaysInMonth;
                     const endDate = new Date(year, month - 1, endD);
                     const endDayName = _fullDays[endDate.getDay()];
                %>
                  <button type="button" class="date-preset-btn" id="presetBtn_<%= endD %>" onclick="setPresetDate(<%= endD %>, 'Akhir Bulan', '<%= endDayName %>, <%= endD %> <%= _curMonthName %> <%= year %>', this)">
                    <span class="preset-main">Akhir Bln</span>
                    <span class="preset-sub">Tgl <%= endD %></span>
                  </button>
                <% } %>
              </div>

              <!-- Human-Crafted Custom Date Dropdown Trigger -->
              <div class="custom-date-trigger" id="customDateTrigger" onclick="toggleCustomDateMenu()">
                <div class="trigger-left">
                  <div class="trigger-calendar-icon">
                    <i class="bi bi-calendar3"></i>
                  </div>
                  <div>
                    <div class="trigger-date-title" id="displaySelectedDate">Pilih Tanggal</div>
                    <div class="trigger-date-sub" id="displaySelectedSub">Ketuk untuk membuka pilihan tanggal</div>
                  </div>
                </div>
                <i class="bi bi-chevron-down trigger-chevron" id="triggerChevron"></i>
              </div>

              <!-- Custom Dropdown Options List -->
              <div class="custom-date-options" id="customDateOptions">
                <% for (let d = _todayDay; d <= _totalDaysInMonth; d++) { 
                     const dObj = new Date(year, month - 1, d);
                     const dName = _fullDays[dObj.getDay()];
                     const dFullStr = `${dName}, ${d} ${_curMonthName} ${year}`;
                     let dTag = '';
                     if (d === _todayDay) dTag = 'Hari Ini';
                     else if (d === _todayDay + 1) dTag = 'Besok';
                     else if (d === _todayDay + 2) dTag = 'Lusa';
                     else if (d === 25) dTag = 'Gajian';
                     else if (d === _totalDaysInMonth) dTag = 'Akhir Bulan';
                %>
                  <div class="custom-date-option-item <%= d === (_todayDay + 1) ? 'selected' : '' %>"
                    id="dateOpt_<%= d %>"
                    onclick="selectCustomDateOption(<%= d %>, '<%= dTag %>', '<%= dFullStr %>')">
                    <div class="opt-left">
                      <div class="opt-badge-num"><%= d %></div>
                      <div class="opt-label"><%= dName %>, <%= d %> <%= _curMonthName.slice(0, 3) %></div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                      <% if (dTag) { %>
                        <span class="opt-tag"><%= dTag %></span>
                      <% } %>
                      <i class="bi bi-check2 opt-check"></i>
                    </div>
                  </div>
                <% } %>
              </div>

              <div style="font-size: 11.5px; color: var(--m3-on-surface-variant); margin-top: 7px; display: flex; align-items: center; gap: 5px;">
                <i class="bi bi-info-circle" style="font-size: 12px; opacity: 0.7;"></i>
                <span>Pelanggan otomatis masuk daftar prioritas <b>'Hari Ini'</b> pada tanggal tersebut.</span>
              </div>
            </div>

            <!-- Section: Catatan (Clean, calm) -->
            <div class="mb-2">
              <label style="font-size: 12.5px; font-weight: 700; color: var(--m3-on-surface); margin-bottom: 6px; display: block;">
                Catatan Penundaan <span style="font-weight: 400; color: var(--m3-on-surface-variant); font-size: 11.5px;">(opsional)</span>
              </label>
              <input type="text" name="note" id="modalPromiseNoteInput" class="form-control"
                placeholder="Contoh: Gajian tgl 25, tunggu transfer..."
                style="background: var(--m3-surface-container-high); border: 1px solid var(--m3-outline-variant); color: var(--m3-on-surface); font-size: 13.5px; border-radius: 12px; padding: 11px 14px;">
            </div>
          </div>

          <!-- Human Footer Actions -->
          <div
            style="padding: 14px 22px; background: var(--m3-surface-container); border-top: 1px solid var(--m3-outline-variant); display: flex; gap: 10px; align-items: center;">
            <button type="button" class="btn btn-outline-secondary"
              style="border-radius: 12px; font-weight: 700; min-height: 46px; font-size: 13.5px; padding: 0 18px; border-color: var(--m3-outline-variant);"
              onclick="closePromiseModal()">
              Batal
            </button>
            <button type="submit" class="btn btn-primary fw-bold flex-fill"
