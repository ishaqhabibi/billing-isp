    // ══════════════════════════════════════════════════════════════
    // PETA RUTE TERDEKAT & SMART ROAD ROUTING ENGINE (OSRM + LEAFLET)
    // ══════════════════════════════════════════════════════════════
    const RAW_MAP_CUSTOMERS = <%- JSON.stringify(typeof mapTargets !== 'undefined' ? mapTargets : []) %>;
    const TODAY_DAY = <%= Number(typeof todayDay !== 'undefined' ? todayDay : new Date().getDate()) %>;
    const DEFAULT_OFFICE_COORDS = [-8.127889, 113.262861];

    let collectorMap = null;
    let collectorUserLocation = null;
    let currentActiveFilter = 'unpaid';
    let filteredTargets = [];
    let mapMarkerLayer = null;
    let userMarker = null;
    let currentActiveTargetIndex = 0;

    // Road Routing & Auto-Reroute Engine State
    let currentRoadPolyline = null;
    let currentRoadPolylineCasing = null;
    let activeRouteTarget = null;
    let activeRoutePoints = [];
    let lastRouteOrigin = null;
    let lastRerouteTimestamp = 0;
    let isFetchingRoute = false;

    function initCollectorMap() {
      if (collectorMap) return;
      collectorMap = L.map('collectorMap', { zoomControl: false }).setView(DEFAULT_OFFICE_COORDS, 15);
      L.control.zoom({ position: 'topright' }).addTo(collectorMap);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap'
      }).addTo(collectorMap);

      mapMarkerLayer = L.layerGroup().addTo(collectorMap);
      trackCollectorLocation();
      filterMapMarkers('unpaid');
    }

    function trackCollectorLocation() {
      if (!navigator.geolocation) return;
      navigator.geolocation.watchPosition(
        (pos) => {
          const newLoc = [pos.coords.latitude, pos.coords.longitude];
          const hasMovedSignificantly = !collectorUserLocation ||
            getDistanceMeters(collectorUserLocation[0], collectorUserLocation[1], newLoc[0], newLoc[1]) > 5;

          collectorUserLocation = newLoc;
          updateUserMarker();

          if (hasMovedSignificantly) {
            checkAndAutoReroute();
          }
        },
        (err) => {
          console.warn('Geolocation info:', err.message);
        },
        { enableHighAccuracy: true, timeout: 12000, maximumAge: 4000 }
      );
    }

    function updateUserMarker() {
      if (!collectorMap || !collectorUserLocation) return;
      if (userMarker) {
        userMarker.setLatLng(collectorUserLocation);
      } else {
        const userIcon = L.divIcon({
          className: 'user-loc-pulsing-icon',
          html: '<div style="width:18px;height:18px;border-radius:50%;background:#0284c7;border:3px solid #fff;box-shadow:0 0 14px rgba(2,132,199,0.95);"></div>',
          iconSize: [18, 18],
          iconAnchor: [9, 9]
        });
        userMarker = L.marker(collectorUserLocation, { icon: userIcon, zIndexOffset: 1000 }).addTo(collectorMap);
      }
    }

    function recenterCollectorLocation() {
      if (!collectorMap) return;
      if (collectorUserLocation) {
        collectorMap.setView(collectorUserLocation, 17, { animate: true });
        if (userMarker && userMarker.openPopup) userMarker.openPopup();
      } else {
        alert('Menunggu koordinat GPS perangkat Anda...');
        trackCollectorLocation();
      }
    }

    function switchCollectorView(viewMode) {
      const listView = document.getElementById('collectorListView');
      const mapView = document.getElementById('collectorMapView');
      const btnList = document.getElementById('btnSwitchList');
      const btnMap = document.getElementById('btnSwitchMap');

      if (viewMode === 'map') {
        if (listView) listView.style.display = 'none';
        if (mapView) mapView.style.display = 'block';
        if (btnList) btnList.classList.remove('active');
        if (btnMap) btnMap.classList.add('active');
        initCollectorMap();
        setTimeout(() => { if (collectorMap) collectorMap.invalidateSize(); }, 200);
      } else {
        if (mapView) mapView.style.display = 'none';
        if (listView) listView.style.display = 'block';
        if (btnMap) btnMap.classList.remove('active');
        if (btnList) btnList.classList.add('active');
      }
    }

    function filterMapMarkers(filterType) {
      currentActiveFilter = filterType;
      ['chipMapUnpaid', 'chipMapToday', 'chipMapIsolir', 'chipMapNear1k'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.remove('active');
      });
      const activeEl = document.getElementById('chipMap' + filterType.charAt(0).toUpperCase() + filterType.slice(1));
      if (activeEl) activeEl.classList.add('active');

      recalculateNearestRoutes();
    }

    function getDistanceMeters(lat1, lon1, lat2, lon2) {
      const R = 6371e3;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
        Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    // OSRM Road Routing Request
    async function fetchRoadRoute(originLat, originLon, destLat, destLon) {
      const url = `https://router.project-osrm.org/route/v1/driving/${originLon},${originLat};${destLon},${destLat}?overview=full&geometries=geojson`;
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 6000);
        const res = await fetch(url, { signal: controller.signal });
        clearTimeout(timeoutId);

        if (!res.ok) throw new Error(`OSRM status ${res.status}`);
        const data = await res.json();
        if (data.code === 'Ok' && data.routes && data.routes.length > 0) {
          const r = data.routes[0];
          const latlngs = r.geometry.coordinates.map(pt => [pt[1], pt[0]]);
          return {
            latlngs,
            distanceMeters: r.distance,
            durationSeconds: r.duration,
            isRoadRoute: true
          };
        }
      } catch (err) {
        console.warn('Gagal ambil rute jalan OSRM, fallback garis lurus:', err.message);
      }

      // Fallback: Haversine Straight Line
      const dist = getDistanceMeters(originLat, originLon, destLat, destLon);
      return {
        latlngs: [[originLat, originLon], [destLat, destLon]],
        distanceMeters: dist,
        durationSeconds: Math.round(dist / 6.94), // Asumsi ~25 km/jam motor
        isRoadRoute: false
      };
    }

    function drawRoadRoute(latlngs, isRoad) {
      if (!collectorMap) return;
      if (currentRoadPolyline) {
        collectorMap.removeLayer(currentRoadPolyline);
        currentRoadPolyline = null;
      }
      if (currentRoadPolylineCasing) {
        collectorMap.removeLayer(currentRoadPolylineCasing);
        currentRoadPolylineCasing = null;
      }

      if (!latlngs || latlngs.length < 2) return;
      activeRoutePoints = latlngs;

      if (isRoad) {
        // Dual-layer polyline ala Google Maps
        currentRoadPolylineCasing = L.polyline(latlngs, {
          color: '#1d4ed8',
          weight: 8,
          opacity: 0.35,
          lineCap: 'round',
          lineJoin: 'round'
        }).addTo(collectorMap);

        currentRoadPolyline = L.polyline(latlngs, {
          color: '#0284c7',
          weight: 5,
          opacity: 0.95,
          lineCap: 'round',
          lineJoin: 'round'
        }).addTo(collectorMap);
      } else {
        // Fallback: Dashed line
        currentRoadPolyline = L.polyline(latlngs, {
          color: '#0284c7',
          weight: 4,
          dashArray: '8, 8',
          opacity: 0.8
        }).addTo(collectorMap);
      }
    }

    // Auto-Rerouting saat kolektor belok/menyimpang dari jalur
    function checkAndAutoReroute() {
      if (!activeRouteTarget || activeRoutePoints.length === 0 || !collectorUserLocation || isFetchingRoute) return;

      const now = Date.now();
      // Debounce: minimal 3.5 detik antar request reroute
      if (now - lastRerouteTimestamp < 3500) return;

      const userLat = collectorUserLocation[0];
      const userLon = collectorUserLocation[1];

      // Hitung jarak terdekat dari kolektor ke garis rute aktif
      let minDevDist = Infinity;
      for (let i = 0; i < activeRoutePoints.length; i++) {
        const pt = activeRoutePoints[i];
        const d = getDistanceMeters(userLat, userLon, pt[0], pt[1]);
        if (d < minDevDist) minDevDist = d;
      }

      const distFromLastOrigin = lastRouteOrigin ?
        getDistanceMeters(userLat, userLon, lastRouteOrigin[0], lastRouteOrigin[1]) : 999;

      // Jika kolektor belok ke jalan lain (deviasi > 35m) atau bergerak > 45m: Auto-Reroute!
      if (minDevDist > 35 || distFromLastOrigin > 45) {
        lastRerouteTimestamp = now;
        loadRoadRouteToTarget(activeRouteTarget, false);
      }
    }

    async function loadRoadRouteToTarget(target, shouldFitBounds = true) {
      if (!target || !collectorMap) return;
      activeRouteTarget = target;
      isFetchingRoute = true;

      const origin = collectorUserLocation || DEFAULT_OFFICE_COORDS;
      lastRouteOrigin = [origin[0], origin[1]];

      const drawerDistEl = document.getElementById('drawerTargetDist');
      const drawerRoutePill = document.getElementById('drawerRoutePill');
      if (drawerDistEl) {
        drawerDistEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1" style="width:11px;height:11px;"></span> Rute jalan...';
      }

      const result = await fetchRoadRoute(origin[0], origin[1], target.lat, target.lng);
      isFetchingRoute = false;

      drawRoadRoute(result.latlngs, result.isRoadRoute);

      const km = (result.distanceMeters / 1000).toFixed(1);
      const minutes = Math.max(1, Math.round(result.durationSeconds / 60));
      const distText = result.isRoadRoute ?
        `${km} km (${minutes} mnt)` :
        `${Math.round(result.distanceMeters)} m`;

      if (drawerDistEl) {
        drawerDistEl.innerHTML = `<i class="bi bi-compass me-1"></i>${distText}`;
      }
      const peekDist = document.getElementById('peekCustDist');
      if (peekDist) {
        peekDist.textContent = result.isRoadRoute ? `• ${km} km (${minutes} mnt)` : `• ${Math.round(result.distanceMeters)} m`;
      }
      if (drawerRoutePill) {
        drawerRoutePill.className = result.isRoadRoute ?
          'badge bg-primary-subtle text-primary border border-primary border-opacity-25' :
          'badge bg-secondary-subtle text-secondary';
        drawerRoutePill.innerHTML = result.isRoadRoute ?
          '<i class="bi bi-sign-turn-right-fill me-1"></i>Rute Jalan' :
          '<i class="bi bi-dash me-1"></i>Garis Lurus';
      }

      if (shouldFitBounds && result.latlngs.length > 0) {
        const bounds = L.latLngBounds([origin, [target.lat, target.lng], ...result.latlngs]);
        collectorMap.fitBounds(bounds, { padding: [50, 50], maxZoom: 16 });
      }
    }

    function recalculateNearestRoutes() {
      if (!mapMarkerLayer) return;
      mapMarkerLayer.clearLayers();

      const origin = collectorUserLocation || DEFAULT_OFFICE_COORDS;

      // Robust coordinate parsing (handles comma in lat, string trims, etc.)
      RAW_MAP_CUSTOMERS.forEach(c => {
        if (c.lat && !c.lng && String(c.lat).includes(',')) {
          const parts = String(c.lat).split(',');
          c.lat = parts[0].trim();
          c.lng = parts[1].trim();
        }
      });

      let list = RAW_MAP_CUSTOMERS.filter(c => {
        const latNum = parseFloat(c.lat);
        const lngNum = parseFloat(c.lng);
        return !isNaN(latNum) && !isNaN(lngNum) && latNum !== 0 && lngNum !== 0;
      });

      if (window.currentActiveArea && window.currentActiveArea !== 'all') {
        list = list.filter(c => String(c.customer_area || '').trim().toLowerCase() === window.currentActiveArea);
      }

      // Toggle friendly notice if customers in this territory have no GPS coordinates
      const noGpsAlert = document.getElementById('mapNoGpsAlert');
      if (noGpsAlert) {
        noGpsAlert.style.display = (list.length === 0) ? 'block' : 'none';
      }

      document.getElementById('countMapUnpaid').textContent = list.filter(c => (c.invoice_status || c.status) !== 'paid').length;
      document.getElementById('countMapToday').textContent = list.filter(c => (c.billing_day || c.isolate_day) === TODAY_DAY).length;
      document.getElementById('countMapIsolir').textContent = list.filter(c => c.customer_status === 'suspended').length;
      const topBadge = document.getElementById('mapTargetCountBadge');
      if (topBadge) topBadge.textContent = list.length;

      if (currentActiveFilter === 'today') {
        list = list.filter(c => (c.billing_day || c.isolate_day) === TODAY_DAY);
      } else if (currentActiveFilter === 'isolir') {
        list = list.filter(c => c.customer_status === 'suspended');
      } else if (currentActiveFilter === 'near1k') {
        list = list.filter(c => getDistanceMeters(origin[0], origin[1], c.lat, c.lng) <= 1000);
      } else {
        list = list.filter(c => (c.invoice_status || c.status) !== 'paid');
      }

      list.forEach(c => {
        c.distance = getDistanceMeters(origin[0], origin[1], c.lat, c.lng);
      });
      list.sort((a, b) => a.distance - b.distance);
      filteredTargets = list;

      const bounds = [];
      list.forEach((t, idx) => {
        bounds.push([t.lat, t.lng]);
        const pinHtml = `<div style="width:28px;height:28px;border-radius:50%;background:#ef4444;color:#fff;font-weight:900;font-size:12px;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(0,0,0,0.3);border:2px solid #fff;">${idx + 1}</div>`;
        const markerIcon = L.divIcon({
          className: 'target-pin-custom',
          html: pinHtml,
          iconSize: [28, 28],
          iconAnchor: [14, 14]
        });
        const m = L.marker([t.lat, t.lng], { icon: markerIcon }).addTo(mapMarkerLayer);
        m.on('click', () => { showNearestTargetDrawer(idx); });
      });

      if (collectorUserLocation) bounds.push(collectorUserLocation);
      if (bounds.length > 0 && collectorMap) {
        collectorMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 17 });
      }

      if (filteredTargets.length > 0) {
        showNearestTargetDrawer(0);
      } else {
        const d = document.getElementById('nearestTargetDrawer');
        if (d) d.classList.remove('active');
        if (currentRoadPolyline && collectorMap) {
          collectorMap.removeLayer(currentRoadPolyline);
          currentRoadPolyline = null;
        }
        if (currentRoadPolylineCasing && collectorMap) {
          collectorMap.removeLayer(currentRoadPolylineCasing);
          currentRoadPolylineCasing = null;
        }
      }
    }

    let isDrawerMinimized = false;
    function toggleDrawerMinimize() {
      setDrawerMinimized(!isDrawerMinimized);
    }
    function setDrawerMinimized(minimized) {
      isDrawerMinimized = minimized;
      const drawer = document.getElementById('nearestTargetDrawer');
      if (!drawer) return;
      if (isDrawerMinimized) {
        drawer.classList.add('is-minimized');
      } else {
        drawer.classList.remove('is-minimized');
      }
    }

    function showNearestTargetDrawer(index) {
      if (!filteredTargets || filteredTargets.length === 0 || !filteredTargets[index]) return;
      currentActiveTargetIndex = index;
      const target = filteredTargets[index];

      const drawer = document.getElementById('nearestTargetDrawer');
      if (!drawer) return;

      const custName = target.customer_name || target.name || '-';
      const custAddress = target.customer_address || target.address || '-';
      const custAmount = target.invoice_amount || target.package_price || target.amount || 0;

      document.getElementById('drawerTargetOrderBadge').textContent = `#${index + 1} dari ${filteredTargets.length}`;
      document.getElementById('drawerCustName').textContent = custName;
      document.getElementById('drawerCustAddress').textContent = custAddress;
      document.getElementById('drawerCustAmount').textContent = 'Rp ' + Number(custAmount).toLocaleString('id-ID');

      // Update Minimized Peek Bar
      const peekBadge = document.getElementById('peekTargetBadge');
      const peekName = document.getElementById('peekCustName');
      const peekAmount = document.getElementById('peekCustAmount');
      if (peekBadge) peekBadge.textContent = `#${index + 1}`;
      if (peekName) peekName.textContent = custName;
      if (peekAmount) peekAmount.textContent = 'Rp ' + Number(custAmount).toLocaleString('id-ID');

      const routeBtn = document.getElementById('drawerMapsRouteBtn');
      if (routeBtn) {
        routeBtn.href = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(target.lat + ',' + target.lng)}&travelmode=driving`;
      }

      const payBtn = document.getElementById('drawerPayBtn');
      if (payBtn) {
        payBtn.onclick = () => {
          openPayConfirmModal(target.customer_id, target.invoice_id, custName, custAmount, !target.invoice_id);
        };
      }

      drawer.classList.add('active');
      loadRoadRouteToTarget(target, true);
    }

    function stepTargetDrawer(direction) {
      if (!filteredTargets || filteredTargets.length === 0) return;
      let newIdx = currentActiveTargetIndex + direction;
      if (newIdx < 0) newIdx = filteredTargets.length - 1;
      if (newIdx >= filteredTargets.length) newIdx = 0;
      showNearestTargetDrawer(newIdx);
    }

    // Touch Swipe Gesture on Drawer (Swipe Down -> Minimize, Swipe Up -> Expand)
    (function initDrawerSwipeGesture() {
      let touchStartY = 0;
      const drawer = document.getElementById('nearestTargetDrawer');
      if (!drawer) return;
      drawer.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
      }, { passive: true });
      drawer.addEventListener('touchend', (e) => {
        const touchEndY = e.changedTouches[0].clientY;
        const diff = touchEndY - touchStartY;
        if (diff > 35) {
          setDrawerMinimized(true);
        } else if (diff < -35) {
          setDrawerMinimized(false);
        }
      }, { passive: true });
    })();

    // Global ESC key to close any open bottom sheet modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closePromiseModal();
        closePayModal();
        closeSettingsModal();
      }
    });
  </script>
</body>

</html>