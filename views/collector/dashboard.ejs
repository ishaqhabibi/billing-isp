<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title><%= title %> | <%= company %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <script src="/js/theme.js"></script>
  <style>
    :root {
      --bg: #071228;
      --bg-surface: #0b1c3d;
      --panel: rgba(15, 30, 60, 0.94);
      --panel2: rgba(7, 18, 40, 0.75);
      --muted: #8ca3ba;
      --text: #f1f5f9;
      --border: rgba(148, 163, 184, 0.16);
      --border-active: rgba(56, 189, 248, 0.5);
      --primary: #0ea5e9;
      --primary-dark: #0052cc;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --purple: #8b5cf6;
      --card-shadow: 0 8px 24px rgba(0,0,0,0.35);
    }

    /* ─── LIGHT MODE HIGH-CONTRAST (SENIOR & OUTDOOR SUNLIGHT FRIENDLY) ─── */
    html[data-theme="light"], body.light-theme {
      --bg: #f1f5f9;
      --bg-surface: #ffffff;
      --panel: #ffffff;
      --panel2: #f8fafc;
      --muted: #475569;
      --text: #0f172a;
      --border: #cbd5e1;
      --border-active: #0284c7;
      --primary: #0284c7;
      --primary-dark: #0052cc;
      --success: #059669;
      --warning: #d97706;
      --danger: #dc2626;
      --purple: #7c3aed;
      --card-shadow: 0 4px 16px rgba(0, 52, 120, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: radial-gradient(circle at 50% 0%, #102652 0%, #071228 65%);
      color: var(--text);
      font-family: 'Inter', -apple-system, sans-serif;
      min-height: 100vh;
      padding-bottom: 105px;
      transition: background 0.2s ease, color 0.2s ease;
    }
    html[data-theme="light"] body, body.light-theme {
      background: #f1f5f9 !important;
      color: #0f172a !important;
    }

    /* ─── SENIOR ACCESSIBILITY MODE (LARGE TEXT & GENEROUS TOUCH TARGETS) ─── */
    body.senior-mode {
      font-size: 16px;
    }
    body.senior-mode .cust-name {
      font-size: 19px !important;
    }
    body.senior-mode .cust-price {
      font-size: 20px !important;
    }
    body.senior-mode .btn-field-action {
      padding: 12px 16px !important;
      font-size: 14px !important;
      min-height: 48px !important;
    }
    body.senior-mode .metric-card .metric-val {
      font-size: 26px !important;
    }
    body.senior-mode .hero-amount {
      font-size: 32px !important;
    }
    body.senior-mode .filter-chip {
      padding: 10px 18px !important;
      font-size: 14px !important;
    }

    /* Container */
    .app-container {
      max-width: 960px;
      margin: 0 auto;
      padding: 16px 14px;
    }

    /* Top App Bar */
    .app-header {
      background: var(--panel);
      border: 1.5px solid var(--border);
      border-radius: 18px;
      padding: 14px 18px;
      margin-bottom: 16px;
      backdrop-filter: blur(12px);
      box-shadow: var(--card-shadow);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .collector-avatar {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: linear-gradient(135deg, #0ea5e9, #0052cc);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 19px;
      color: #fff;
      flex-shrink: 0;
      box-shadow: 0 4px 14px rgba(14, 165, 233, 0.4);
    }

    /* Hero Card: Cash in Hand */
    .hero-cash-card {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.16) 0%, rgba(6, 78, 59, 0.3) 100%), var(--panel);
      border: 1.5px solid rgba(16, 185, 129, 0.35);
      border-radius: 18px;
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: var(--card-shadow);
      position: relative;
      overflow: hidden;
    }
    html[data-theme="light"] .hero-cash-card, body.light-theme .hero-cash-card {
      background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%) !important;
      border: 1.5px solid #6ee7b7 !important;
      box-shadow: 0 4px 18px rgba(16, 185, 129, 0.12) !important;
    }
    .hero-amount {
      font-size: 26px;
      font-weight: 900;
      color: #ffffff;
      margin-top: 4px;
      letter-spacing: -0.5px;
    }
    html[data-theme="light"] .hero-amount, body.light-theme .hero-amount {
      color: #064e3b !important;
    }
    html[data-theme="light"] .hero-label, body.light-theme .hero-label {
      color: #047857 !important;
    }
    html[data-theme="light"] .hero-sub, body.light-theme .hero-sub {
      color: #065f46 !important;
    }

    /* Metric Grid (4 Cards) */
    .metric-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 16px;
    }
    @media (min-width: 768px) {
      .metric-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    .metric-card {
      background: var(--panel);
      border: 1.5px solid var(--border);
      border-radius: 16px;
      padding: 14px;
      text-decoration: none;
      color: var(--text);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s ease;
      position: relative;
      box-shadow: var(--card-shadow);
    }
    .metric-card:hover, .metric-card.active {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }
    .metric-card.c-today:hover, .metric-card.c-today.active { border-color: var(--warning); background: rgba(245, 158, 11, 0.12); }
    .metric-card.c-unpaid:hover, .metric-card.c-unpaid.active { border-color: var(--danger); background: rgba(239, 68, 68, 0.12); }
    .metric-card.c-isolir:hover, .metric-card.c-isolir.active { border-color: #f43f5e; background: rgba(244, 63, 94, 0.12); }
    .metric-card.c-multi:hover, .metric-card.c-multi.active { border-color: var(--purple); background: rgba(139, 92, 246, 0.12); }

    .metric-val {
      font-size: 22px;
      font-weight: 900;
      color: #ffffff;
      margin-top: 4px;
    }
    html[data-theme="light"] .metric-val, body.light-theme .metric-val {
      color: #0f172a !important;
    }

    /* Quick Filter Chips (Pills) */
    .filter-chips-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 8px;
      margin-bottom: 14px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .filter-chips-wrap::-webkit-scrollbar { display: none; }
    .filter-chip {
      padding: 8px 16px;
      border-radius: 24px;
      font-size: 13px;
      font-weight: 700;
      border: 1.5px solid var(--border);
      background: var(--panel);
      color: var(--muted);
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    html[data-theme="light"] .filter-chip, body.light-theme .filter-chip {
      background: #ffffff !important;
      border: 1.5px solid #cbd5e1 !important;
      color: #334155 !important;
    }
    .filter-chip:hover {
      color: #fff;
      border-color: rgba(255,255,255,0.3);
    }
    html[data-theme="light"] .filter-chip:hover, body.light-theme .filter-chip:hover {
      color: #0052cc !important;
      border-color: #0052cc !important;
    }
    .filter-chip.active {
      background: var(--primary-dark) !important;
      border-color: var(--primary) !important;
      color: #ffffff !important;
      box-shadow: 0 2px 10px rgba(14, 165, 233, 0.4);
    }

    /* Search & Period Box */
    .filter-box {
      background: var(--panel);
      border: 1.5px solid var(--border);
      border-radius: 16px;
      padding: 14px;
      margin-bottom: 16px;
      box-shadow: var(--card-shadow);
    }
    html[data-theme="light"] .filter-box, body.light-theme .filter-box {
      background: #ffffff !important;
      border: 1.5px solid #cbd5e1 !important;
    }

    /* Customer Card */
    .cust-card {
      background: var(--panel);
      border: 1.5px solid var(--border);
      border-radius: 18px;
      padding: 18px;
      margin-bottom: 12px;
      transition: all 0.15s ease;
      position: relative;
      box-shadow: var(--card-shadow);
    }
    html[data-theme="light"] .cust-card, body.light-theme .cust-card {
      background: #ffffff !important;
      border: 1.5px solid #cbd5e1 !important;
      box-shadow: 0 3px 12px rgba(0, 52, 120, 0.05) !important;
    }
    .cust-card.is-paid {
      border-left: 5px solid var(--success) !important;
    }
    .cust-card.is-unpaid {
      border-left: 5px solid var(--danger) !important;
    }
    .cust-card.is-isolir {
      border-left: 5px solid #f43f5e !important;
      background: linear-gradient(90deg, rgba(239, 68, 68, 0.06) 0%, var(--panel) 100%);
    }

    .cust-name {
      font-size: 16px;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.3;
    }
    html[data-theme="light"] .cust-name, body.light-theme .cust-name {
      color: #0f172a !important;
    }

    .cust-price {
      font-size: 17px;
      font-weight: 900;
      color: #ffffff;
    }
    html[data-theme="light"] .cust-price, body.light-theme .cust-price {
      color: #047857 !important;
    }

    /* Badges */
    .badge-pill-custom {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.3px;
    }
    .badge-s { background: rgba(16, 185, 129, 0.18); color: #34d399; border: 1.5px solid rgba(16, 185, 129, 0.35); }
    .badge-d { background: rgba(239, 68, 68, 0.18); color: #f87171; border: 1.5px solid rgba(239, 68, 68, 0.35); }
    .badge-w { background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1.5px solid rgba(245, 158, 11, 0.35); }
    .badge-p { background: rgba(99, 102, 241, 0.18); color: #a5b4fc; border: 1.5px solid rgba(99, 102, 241, 0.35); }

    html[data-theme="light"] .badge-s, body.light-theme .badge-s {
      background: #ecfdf5 !important; color: #047857 !important; border: 1.5px solid #a7f3d0 !important;
    }
    html[data-theme="light"] .badge-d, body.light-theme .badge-d {
      background: #fef2f2 !important; color: #b91c1c !important; border: 1.5px solid #fecaca !important;
    }
    html[data-theme="light"] .badge-w, body.light-theme .badge-w {
      background: #fffbeb !important; color: #b45309 !important; border: 1.5px solid #fde68a !important;
    }
    html[data-theme="light"] .badge-p, body.light-theme .badge-p {
      background: #eef2ff !important; color: #4338ca !important; border: 1.5px solid #c7d2fe !important;
    }

    /* Action Buttons in Card */
    .btn-field-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      border: 1.5px solid transparent;
      transition: all 0.15s ease;
      cursor: pointer;
      min-height: 42px;
    }
    .btn-field-phone {
      background: rgba(59, 130, 246, 0.15);
      color: #60a5fa;
      border-color: rgba(59, 130, 246, 0.35);
    }
    .btn-field-phone:hover { background: rgba(59, 130, 246, 0.25); color: #93c5fd; }
    html[data-theme="light"] .btn-field-phone, body.light-theme .btn-field-phone {
      background: #eff6ff !important; color: #1d4ed8 !important; border-color: #bfdbfe !important;
    }

    .btn-field-wa {
      background: rgba(34, 197, 94, 0.15);
      color: #4ade80;
      border-color: rgba(34, 197, 94, 0.35);
    }
    .btn-field-wa:hover { background: rgba(34, 197, 94, 0.25); color: #86efac; }
    html[data-theme="light"] .btn-field-wa, body.light-theme .btn-field-wa {
      background: #f0fdf4 !important; color: #15803d !important; border-color: #bbf7d0 !important;
    }

    .btn-field-map {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
      border-color: rgba(245, 158, 11, 0.35);
    }
    .btn-field-map:hover { background: rgba(245, 158, 11, 0.25); color: #fde68a; }
    html[data-theme="light"] .btn-field-map, body.light-theme .btn-field-map {
      background: #fffbeb !important; color: #b45309 !important; border-color: #fde68a !important;
    }

    .btn-field-pay {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      border: none;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
    }
    .btn-field-pay:hover {
      background: linear-gradient(135deg, #34d399 0%, #047857 100%);
      color: #ffffff;
      transform: translateY(-1px);
    }

    .btn-field-print {
      background: #1e293b;
      color: #f8fafc;
      border: 1.5px solid rgba(148, 163, 184, 0.3);
    }
    html[data-theme="light"] .btn-field-print, body.light-theme .btn-field-print {
      background: #f8fafc !important;
      color: #0f172a !important;
      border: 1.5px solid #cbd5e1 !important;
    }
    html[data-theme="light"] .btn-field-print:hover, body.light-theme .btn-field-print:hover {
      background: #e2e8f0 !important;
    }

    /* Bottom Navigation Bar (PWA Style) */
    .bottom-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1000;
      background: rgba(7, 18, 40, 0.96);
      border-top: 1.5px solid rgba(148, 163, 184, 0.18);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 8px 12px;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.25);
    }
    html[data-theme="light"] .bottom-nav, body.light-theme .bottom-nav {
      background: rgba(255, 255, 255, 0.96) !important;
      border-top: 1.5px solid #cbd5e1 !important;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08) !important;
    }
    .bottom-nav-inner {
      max-width: 600px;
      margin: 0 auto;
      display: flex;
      justify-content: space-around;
      align-items: center;
      gap: 6px;
    }
    .bnav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      text-decoration: none;
      color: var(--muted);
      padding: 6px 12px;
      border-radius: 12px;
      transition: all 0.15s ease;
      min-width: 62px;
    }
    .bnav-item i {
      font-size: 20px;
      line-height: 1;
    }
    .bnav-item span {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2px;
    }
    .bnav-item.active {
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.12);
    }
    html[data-theme="light"] .bnav-item, body.light-theme .bnav-item {
      color: #64748b !important;
    }
    html[data-theme="light"] .bnav-item.active, body.light-theme .bnav-item.active {
      color: #0284c7 !important;
      background: rgba(2, 132, 199, 0.12) !important;
    }

    /* Modal Form Custom */
    .modal-custom-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-custom-backdrop.show {
      display: flex;
    }
    .modal-custom-box {
      background: #0f1c3d;
      border: 1.5px solid rgba(148, 163, 184, 0.25);
      border-radius: 20px;
      width: 100%;
      max-width: 480px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
      overflow: hidden;
      animation: modalFadeIn 0.2s ease-out;
    }
    html[data-theme="light"] .modal-custom-box, body.light-theme .modal-custom-box {
      background: #ffffff !important;
      border: 1.5px solid #cbd5e1 !important;
      color: #0f172a !important;
      box-shadow: 0 20px 40px rgba(0,0,0,0.15) !important;
    }
    @keyframes modalFadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
  </style>
</head>
<body>

  <div class="app-container">

    <!-- Top Header Profile -->
    <div class="app-header">
      <div class="d-flex align-items-center gap-3">
        <div class="collector-avatar">
          <%= (session.collectorName || 'K')[0].toUpperCase() %>
        </div>
        <div>
          <div style="font-size: 16px; font-weight: 800; line-height: 1.2;">
            <%= session.collectorName || 'Kolektor' %>
          </div>
          <div class="d-flex align-items-center gap-2 mt-1" style="font-size: 12px; color: var(--muted);">
            <span><%= company %></span>
            <span>&bull;</span>
            <% if (session.collectorArea) { %>
              <span class="badge" style="background:rgba(14,165,233,0.15);color:#0284c7;border:1px solid rgba(14,165,233,0.3);padding:3px 8px;font-weight:700;">
                <i class="bi bi-geo-alt"></i> <%= session.collectorArea %>
              </span>
            <% } else { %>
              <span class="badge" style="background:rgba(148,163,184,0.15);color:var(--text);padding:3px 8px;font-weight:600;">
                <i class="bi bi-globe"></i> Semua Area
              </span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Header Controls: Theme, Font Scale, Attendance & Logout -->
      <div class="d-flex align-items-center gap-2">
        <!-- Senior Mode Toggle (Large Text) -->
        <button type="button" class="btn btn-sm" id="btnSeniorMode" onclick="toggleSeniorMode()" 
                style="background:rgba(255,255,255,0.08);border:1.5px solid var(--border);border-radius:12px;padding:6px 10px;font-weight:700;display:inline-flex;align-items:center;gap:4px;" 
                title="Mode Teks Besar (Senior / Outdoor Mode)">
          <i class="bi bi-fonts" style="font-size:16px;"></i>
          <span class="d-none d-md-inline" style="font-size:11px;">Teks Besar</span>
        </button>

        <!-- Theme Switcher (Dark / Light) -->
        <button type="button" class="btn btn-sm theme-toggle-btn" onclick="toggleAppTheme()" 
                style="background:rgba(255,255,255,0.08);border:1.5px solid var(--border);border-radius:12px;padding:6px 10px;display:inline-flex;align-items:center;gap:5px;" 
                title="Ganti Tema Terang (Siang) / Gelap (Malam)">
          <i class="theme-toggle-icon bi bi-sun-fill" style="font-size:16px;"></i>
          <span class="d-none d-sm-inline" style="font-size:11px;font-weight:700;">Tema</span>
        </button>

        <!-- Attendance Badge -->
        <% if (typeof todayAttendance !== 'undefined' && todayAttendance) { %>
          <% if (todayAttendance.status === 'checked_out') { %>
            <a href="/collector/attendance" class="btn btn-sm d-none d-sm-inline-flex align-items-center gap-1" style="background:rgba(59,130,246,0.15);color:#2563eb;border:1.5px solid rgba(59,130,246,0.3);border-radius:12px;font-size:12px;font-weight:700;padding:6px 12px;">
              <i class="bi bi-check2-all"></i> Pulang
            </a>
          <% } else { %>
            <a href="/collector/attendance" class="btn btn-sm d-none d-sm-inline-flex align-items-center gap-1" style="background:rgba(16,185,129,0.15);color:#059669;border:1.5px solid rgba(16,185,129,0.3);border-radius:12px;font-size:12px;font-weight:700;padding:6px 12px;">
              <i class="bi bi-person-check-fill"></i> Hadir
            </a>
          <% } %>
        <% } else { %>
          <a href="/collector/attendance" class="btn btn-sm d-none d-sm-inline-flex align-items-center gap-1" style="background:rgba(245,158,11,0.15);color:#d97706;border:1.5px solid rgba(245,158,11,0.3);border-radius:12px;font-size:12px;font-weight:700;padding:6px 12px;">
            <i class="bi bi-clock-history"></i> Belum Absen
          </a>
        <% } %>

        <!-- Logout -->
        <a href="/collector/logout" class="btn btn-outline-danger btn-sm" style="border-radius:12px;padding:6px 10px;" title="Keluar Akun" onclick="return confirm('Apakah Anda yakin ingin keluar?')">
          <i class="bi bi-box-arrow-right"></i>
        </a>
      </div>
    </div>

    <!-- Alert Flash Message -->
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'danger':'success' %> alert-dismissible fade show d-flex align-items-center gap-2 mb-3" style="border-radius:14px;padding:12px 16px;font-size:13px;font-weight:600;">
        <i class="bi <%= msg.type==='error'?'bi-exclamation-triangle-fill':'bi-check-circle-fill' %>"></i>
        <div style="flex:1"><%- msg.text %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="padding:14px;"></button>
      </div>
    <% } %>

    <!-- Hero Card: Cash In Hand Tracker -->
    <div class="hero-cash-card">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <div class="hero-label" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 800; color: #34d399;">
            <i class="bi bi-wallet2 me-1"></i> Uang Kas di Tangan (Hari Ini)
          </div>
          <div class="hero-amount">
            Rp <%= Number(todayCollected?.total || 0).toLocaleString('id-ID') %>
          </div>
          <div class="hero-sub" style="font-size: 13px; color: #cbd5e1; margin-top: 3px; font-weight: 500;">
            <i class="bi bi-receipt text-success me-1"></i> <strong><%= Number(todayCollected?.count || 0) %> Tagihan</strong> berhasil ditarik hari ini
          </div>
        </div>
        <div class="text-end">
          <a href="#riwayat-pengajuan" class="btn btn-sm" style="background:rgba(0,0,0,0.12);color:inherit;border:1.5px solid currentColor;border-radius:12px;font-size:12px;font-weight:700;padding:6px 12px;">
            <i class="bi bi-list-check me-1"></i> Rincian Kas
          </a>
        </div>
      </div>

      <!-- Month Target Progress -->
      <% 
        const totalCust = Number(summary?.total_customer_count || 0);
        const paidCust = Number(summary?.paid_count || 0);
        const progressPct = totalCust > 0 ? Math.min(100, Math.round((paidCust / totalCust) * 100)) : 0;
      %>
      <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(148,163,184,0.18);">
        <div class="d-flex justify-content-between align-items-center" style="font-size: 12px; margin-bottom: 6px;">
          <span class="hero-sub" style="color: inherit; font-weight: 600;">Target Penagihan Bulan Ini (<%= String(month).padStart(2,'0') %>/<%= year %>)</span>
          <span style="font-weight: 800; color: #059669;"><%= progressPct %>% Tertagih (<%= paidCust %>/<%= totalCust %>)</span>
        </div>
        <div style="width: 100%; height: 9px; background: rgba(0,0,0,0.15); border-radius: 99px; overflow: hidden;">
          <div style="width: <%= progressPct %>%; height: 100%; background: linear-gradient(90deg, #10b981, #0ea5e9); border-radius: 99px; transition: width 0.4s ease;"></div>
        </div>
      </div>
    </div>

    <!-- Metric Grid (4 Cards) -->
    <div class="metric-grid">
      <!-- Tagihan Hari Ini -->
      <a class="metric-card c-today <%= scope === 'today' ? 'active' : '' %>" href="/collector?<%= new URLSearchParams({ month: String(month), year: String(year), status: 'unpaid', scope: 'today', search: String(search||'') }).toString() %>#daftar-tagihan">
        <div>
          <div class="d-flex justify-content-between align-items-center">
            <span style="font-size: 12px; font-weight: 800; color: #d97706;">Tagihan Hari Ini</span>
            <i class="bi bi-calendar-event text-warning" style="font-size:16px;"></i>
          </div>
          <div class="metric-val">
            <%= Number(summary?.today_count || 0) %>
          </div>
        </div>
        <div class="metric-sub" style="font-size: 12px; color: var(--muted); margin-top: 6px; font-weight: 600;">
          Rp <%= Number(summary?.today_total || 0).toLocaleString('id-ID') %>
        </div>
      </a>

      <!-- Belum Bayar -->
      <a class="metric-card c-unpaid <%= (scope === 'unpaid' || status === 'unpaid') && scope !== 'today' && scope !== 'isolir' && scope !== 'multi' ? 'active' : '' %>" href="/collector?<%= new URLSearchParams({ month: String(month), year: String(year), status: 'unpaid', scope: 'unpaid', search: String(search||'') }).toString() %>#daftar-tagihan">
        <div>
          <div class="d-flex justify-content-between align-items-center">
            <span style="font-size: 12px; font-weight: 800; color: #dc2626;">Belum Bayar</span>
            <i class="bi bi-exclamation-circle text-danger" style="font-size:16px;"></i>
          </div>
          <div class="metric-val">
            <%= Number(summary?.unpaid_count || 0) %>
          </div>
        </div>
        <div class="metric-sub" style="font-size: 12px; color: var(--muted); margin-top: 6px; font-weight: 600;">
          Rp <%= Number(summary?.unpaid_total || 0).toLocaleString('id-ID') %>
        </div>
      </a>

      <!-- Isolir -->
      <a class="metric-card c-isolir <%= scope === 'isolir' ? 'active' : '' %>" href="/collector?<%= new URLSearchParams({ month: String(month), year: String(year), status: 'unpaid', scope: 'isolir', search: String(search||'') }).toString() %>#daftar-tagihan">
        <div>
          <div class="d-flex justify-content-between align-items-center">
            <span style="font-size: 12px; font-weight: 800; color: #e11d48;">Layanan Isolir</span>
            <i class="bi bi-pause-circle text-danger" style="font-size:16px;"></i>
          </div>
          <div class="metric-val">
            <%= Number(summary?.isolir_count || 0) %>
          </div>
        </div>
        <div class="metric-sub" style="font-size: 12px; color: var(--muted); margin-top: 6px; font-weight: 600;">
          Rp <%= Number(summary?.isolir_total || 0).toLocaleString('id-ID') %>
        </div>
      </a>

      <!-- Menunggak > 1 Bulan -->
      <a class="metric-card c-multi <%= scope === 'multi' ? 'active' : '' %>" href="/collector?<%= new URLSearchParams({ month: String(month), year: String(year), status: 'unpaid', scope: 'multi', search: String(search||'') }).toString() %>#daftar-tagihan">
        <div>
          <div class="d-flex justify-content-between align-items-center">
            <span style="font-size: 12px; font-weight: 800; color: #7c3aed;">Menunggak &gt;1 Bln</span>
            <i class="bi bi-layers text-purple" style="font-size:16px;"></i>
          </div>
          <div class="metric-val">
            <%= Number(summary?.multi_customer_count || 0) %>
          </div>
        </div>
        <div class="metric-sub" style="font-size: 12px; color: var(--muted); margin-top: 6px; font-weight: 600;">
          Rp <%= Number(summary?.multi_total || 0).toLocaleString('id-ID') %>
        </div>
      </a>
    </div>

    <!-- Quick Filter Chips (Pills) -->
    <%
      const baseQs = { month: String(month), year: String(year), search: String(search||'') };
      const curScope = String(scope || '');
      const curStatus = String(status || 'all');
    %>
    <div class="filter-chips-wrap">
      <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'all', scope: '' }).toString() %>#daftar-tagihan" 
         class="filter-chip <%= (!curScope && curStatus==='all') ? 'active' : '' %>">
        <i class="bi bi-grid-fill"></i> Semua (<%= summary?.total_customer_count || 0 %>)
      </a>
      <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'today' }).toString() %>#daftar-tagihan" 
         class="filter-chip <%= curScope==='today' ? 'active' : '' %>">
        <i class="bi bi-calendar-check-fill text-warning"></i> Hari Ini (<%= summary?.today_count || 0 %>)
      </a>
      <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'unpaid' }).toString() %>#daftar-tagihan" 
         class="filter-chip <%= (curScope==='unpaid' || curStatus==='unpaid') && curScope!=='today' && curScope!=='isolir' && curScope!=='multi' ? 'active' : '' %>">
        <i class="bi bi-exclamation-circle-fill text-danger"></i> Belum Bayar (<%= summary?.unpaid_count || 0 %>)
      </a>
      <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'isolir' }).toString() %>#daftar-tagihan" 
         class="filter-chip <%= curScope==='isolir' ? 'active' : '' %>">
        <i class="bi bi-pause-circle-fill text-danger"></i> Isolir (<%= summary?.isolir_count || 0 %>)
      </a>
      <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'multi' }).toString() %>#daftar-tagihan" 
         class="filter-chip <%= curScope==='multi' ? 'active' : '' %>">
        <i class="bi bi-layers-fill" style="color:#a855f7;"></i> &gt;1 Bln (<%= summary?.multi_customer_count || 0 %>)
      </a>
      <a href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'paid', scope: '' }).toString() %>#daftar-tagihan" 
         class="filter-chip <%= curStatus==='paid' ? 'active' : '' %>">
        <i class="bi bi-check-circle-fill text-success"></i> Sudah Lunas (<%= summary?.paid_count || 0 %>)
      </a>
    </div>

    <!-- Search & Filter Options Bar -->
    <div class="filter-box" id="daftar-tagihan">
      <form method="GET" action="/collector" class="row g-2 align-items-center">
        <input type="hidden" name="scope" value="<%= scope || '' %>">
        <input type="hidden" name="status" value="<%= status || 'all' %>">
        <div class="col-6 col-md-3">
          <label style="font-size:12px;font-weight:700;color:var(--muted);margin-bottom:4px;display:block;">Bulan Tagihan</label>
          <select class="form-select" name="month" style="border-radius:10px;font-weight:600;" onchange="this.form.submit()">
            <% const monthNames = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
            <% for (let m=1; m<=12; m++) { %>
              <option value="<%= m %>" <%= Number(month)===m ? 'selected' : '' %>><%= monthNames[m-1] %></option>
            <% } %>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <label style="font-size:12px;font-weight:700;color:var(--muted);margin-bottom:4px;display:block;">Tahun</label>
          <select class="form-select" name="year" style="border-radius:10px;font-weight:600;" onchange="this.form.submit()">
            <% const baseY = Number(year) || new Date().getFullYear(); %>
            <% for (let y=baseY-2; y<=baseY+1; y++) { %>
              <option value="<%= y %>" <%= Number(year)===y ? 'selected' : '' %>><%= y %></option>
            <% } %>
          </select>
        </div>
        <div class="col-12 col-md-7">
          <label style="font-size:12px;font-weight:700;color:var(--muted);margin-bottom:4px;display:block;">Cari Data Pelanggan</label>
          <div class="input-group">
            <input class="form-control" name="search" value="<%= search || '' %>" placeholder="Ketik nama, no HP, alamat, atau PPPoE..." style="border-radius:10px 0 0 10px;font-weight:500;">
            <button class="btn btn-primary px-3 fw-bold" type="submit" style="border-radius:0 10px 10px 0;"><i class="bi bi-search"></i> Cari</button>
            <% if (search || scope) { %>
              <a href="/collector" class="btn btn-outline-secondary ms-1" style="border-radius:10px;" title="Reset Pencarian"><i class="bi bi-x-lg"></i></a>
            <% } %>
          </div>
        </div>
      </form>
    </div>

    <!-- Customer Card List -->
    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
      <div style="font-weight: 800; font-size: 15px;">
        <i class="bi bi-people-fill text-primary me-1"></i> Data Tagihan Pelanggan (<%= (invoices || []).length %>)
      </div>
      <div style="font-size: 12px; color: var(--muted); font-weight: 600;">
        Periode: <strong><%= String(month).padStart(2,'0') %>/<%= year %></strong>
      </div>
    </div>

    <% if (!invoices || invoices.length === 0) { %>
      <div class="cust-card text-center p-5">
        <i class="bi bi-folder2-open" style="font-size: 46px; color: var(--muted); opacity: 0.6;"></i>
        <div style="font-weight: 800; font-size: 16px; margin-top: 10px;">Tidak ada data tagihan ditemukan</div>
        <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">Coba ubah filter atau kata kunci pencarian Anda.</div>
      </div>
    <% } else { %>
      <div class="d-flex flex-column gap-2">
        <% invoices.forEach((inv, idx) => { 
             const invId = inv.invoice_id;
             const isPaid = String(inv.invoice_status||'').toLowerCase()==='paid';
             const reqRow = pendingMap && pendingMap.get ? (pendingMap.get('inv_' + invId) || pendingMap.get('cust_' + inv.customer_id)) : null;
             const reqStatus = reqRow ? String(reqRow.status||'') : '';
             const isPending = reqStatus === 'pending';
             const noInvoice = !invId;
             const amount = Number(inv.invoice_amount || inv.package_price || 0);

             let cardClass = 'is-unpaid';
             if (isPaid) cardClass = 'is-paid';
             else if (inv.customer_status === 'suspended') cardClass = 'is-isolir';

             // Phone formatting for WhatsApp
             const rawPhone = String(inv.customer_phone || '').replace(/\D/g, '');
             const cleanWaPhone = rawPhone.startsWith('0') ? ('62' + rawPhone.slice(1)) : rawPhone;
             const monthNameStr = monthNames[Number(month)-1] || month;
             const waMessageText = encodeURIComponent(`Halo Bpk/Ibu *${inv.customer_name || 'Pelanggan'}*,\nSaya *${session.collectorName || 'Kolektor'}* dari *${company}*.\n\nIngin mengkonfirmasi tagihan internet periode *${monthNameStr} ${year}* sebesar *Rp ${amount.toLocaleString('id-ID')}*.\nApakah Bpk/Ibu sedang berada di rumah untuk kunjungan pembayaran hari ini?\n\nTerima kasih.`);
        %>
          <div class="cust-card <%= cardClass %>">
            <!-- Header Row -->
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div style="min-width: 0; flex: 1;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <span class="cust-name">
                    <%= inv.customer_name || '-' %>
                  </span>
                  <% if (inv.customer_status === 'suspended') { %>
                    <span class="badge bg-danger" style="font-size: 11px; font-weight: 800;"><i class="bi bi-pause-circle"></i> ISOLIR</span>
                  <% } else if (inv.customer_status === 'active') { %>
                    <span class="badge bg-success" style="font-size: 11px; font-weight: 700;"><i class="bi bi-check-circle"></i> Aktif</span>
                  <% } else { %>
                    <span class="badge bg-secondary" style="font-size: 11px;"><%= inv.customer_status %></span>
                  <% } %>
                </div>
                <div style="font-size: 13px; color: var(--muted); margin-top: 3px; font-weight: 500;">
                  <strong style="color:var(--primary);"><%= inv.package_name || 'Internet' %></strong>
                  &bull; <%= invId ? ('Inv #' + invId) : 'Belum Ada Invoice' %>
                  <% if (inv.isolate_day) { %>
                    &bull; <span class="text-warning fw-bold">Jatuh Tempo: Tgl <%= inv.isolate_day %></span>
                  <% } %>
                </div>
              </div>

              <!-- Price & Status Badge -->
              <div class="text-end" style="flex-shrink: 0;">
                <div class="cust-price">
                  Rp <%= amount.toLocaleString('id-ID') %>
                </div>
                <div style="margin-top: 4px;">
                  <% if (isPaid) { %>
                    <span class="badge-pill-custom badge-s"><i class="bi bi-check-circle-fill"></i> LUNAS</span>
                  <% } else if (isPending) { %>
                    <span class="badge-pill-custom badge-w"><i class="bi bi-hourglass-split"></i> MENUNGGU APPROVAL</span>
                  <% } else if (noInvoice) { %>
                    <span class="badge-pill-custom badge-p"><i class="bi bi-file-earmark-plus"></i> BELUM TAGIHAN</span>
                  <% } else { %>
                    <span class="badge-pill-custom badge-d"><i class="bi bi-exclamation-circle-fill"></i> BELUM BAYAR</span>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Meta details row -->
            <div class="mt-3 pt-2" style="border-top: 1px solid var(--border); font-size: 13px; display: grid; grid-template-columns: 1fr; gap: 4px;">
              <div class="cust-addr" style="line-height: 1.4;">
                <i class="bi bi-geo-alt text-danger me-1"></i> <%= inv.customer_address || '-' %>
                <% if (inv.customer_area) { %>
                  <span class="badge" style="background:rgba(56,189,248,0.15);color:#0284c7;border:1px solid rgba(56,189,248,0.3);padding:2px 8px;margin-left:4px;font-weight:700;"><%= inv.customer_area %></span>
                <% } %>
              </div>
              <div class="d-flex align-items-center gap-3 flex-wrap cust-meta" style="font-size: 12px; margin-top: 2px;">
                <span><i class="bi bi-person-badge"></i> ID: #<%= inv.customer_id %></span>
                <% if (inv.pppoe_username) { %>
                  <span><i class="bi bi-router"></i> PPPoE: <code><%= inv.pppoe_username %></code></span>
                <% } %>
                <% if (inv.customer_phone) { %>
                  <span><i class="bi bi-telephone"></i> <strong><%= inv.customer_phone %></strong></span>
                <% } %>
              </div>
            </div>

            <!-- Field Action Buttons (Touch Friendly) -->
            <div class="d-flex align-items-center gap-2 flex-wrap mt-3 pt-2" style="border-top: 1px dashed var(--border);">
              <!-- Call Direct -->
              <% if (inv.customer_phone) { %>
                <a href="tel:<%= inv.customer_phone %>" class="btn-field-action btn-field-phone" title="Telepon Pelanggan">
                  <i class="bi bi-telephone-fill"></i> Hubungi
                </a>
                <a href="https://wa.me/<%= cleanWaPhone %>?text=<%= waMessageText %>" target="_blank" class="btn-field-action btn-field-wa" title="Chat WhatsApp">
                  <i class="bi bi-whatsapp"></i> Chat WA
                </a>
              <% } %>

              <!-- Google Maps Route Navigation -->
              <% if (inv.lat && inv.lng) { %>
                <a href="https://www.google.com/maps?q=<%= encodeURIComponent(inv.lat + ',' + inv.lng) %>" target="_blank" class="btn-field-action btn-field-map" title="Buka Rute Google Maps">
                  <i class="bi bi-cursor-fill"></i> Navigasi Peta
                </a>
              <% } else if (inv.customer_address) { %>
                <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(inv.customer_address + (inv.customer_area ? (', ' + inv.customer_area) : '')) %>" target="_blank" class="btn-field-action btn-field-map" title="Cari Alamat di Maps">
                  <i class="bi bi-geo-alt-fill"></i> Peta Alamat
                </a>
              <% } %>

              <!-- Payment Action OR Print Thermal Action -->
              <% if (isPaid && inv.invoice_id) { %>
                <a href="/collector/invoice/<%= inv.invoice_id %>/print-thermal" target="_blank" class="btn-field-action btn-field-print">
                  <i class="bi bi-printer-fill"></i> Cetak Struk
                </a>
                <a href="/customer/invoice/<%= inv.invoice_id %>/pdf" target="_blank" class="btn-field-action btn-field-print">
                  <i class="bi bi-file-earmark-pdf"></i> PDF
                </a>
                <button type="button" class="btn-field-action btn-field-wa" onclick="sendWaPdf('<%= inv.invoice_id %>')">
                  <i class="bi bi-send-fill"></i> Kirim WA PDF
                </button>
              <% } else if (!isPaid && !isPending) { %>
                <button type="button" class="btn-field-action btn-field-pay ms-auto" 
                        onclick="openPayConfirmModal('<%= inv.customer_id %>', '<%= inv.invoice_id || '' %>', '<%= inv.customer_name %>', '<%= amount %>', '<%= noInvoice ? '1' : '0' %>')">
                  <i class="bi bi-cash-stack"></i> <%= noInvoice ? 'Buat & Bayar Tagihan' : 'Terima Pembayaran' %>
                </button>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- Riwayat Pengajuan Saya (My Submissions) -->
    <div class="cust-card mt-4" id="riwayat-pengajuan">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div style="font-weight: 800; font-size: 15px;">
          <i class="bi bi-clock-history text-info me-1"></i> Riwayat Pengajuan Setoran Saya
        </div>
        <span class="badge-pill-custom badge-p"><%= (myReqs || []).length %> Data</span>
      </div>

      <% if (!myReqs || myReqs.length === 0) { %>
        <div style="font-size: 13px; color: var(--muted); text-align: center; padding: 24px;">Belum ada pengajuan pembayaran.</div>
      <% } else { %>
        <div class="d-flex flex-column gap-2">
          <% myReqs.slice(0, 15).forEach(r => { 
               const st = String(r.status||'');
          %>
            <div style="background: var(--panel2); border: 1.5px solid var(--border); border-radius: 14px; padding: 12px 16px;" class="d-flex justify-content-between align-items-center gap-2">
              <div>
                <div style="font-size: 14px; font-weight: 800;"><%= r.customer_name || '-' %></div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">
                  Periode <%= r.period_month %>/<%= r.period_year %> &bull; <%= r.created_at ? new Date(r.created_at).toLocaleString('id-ID') : '-' %>
                </div>
              </div>
              <div class="text-end">
                <div style="font-size: 15px; font-weight: 900; color: #059669;">Rp <%= Number(r.amount||0).toLocaleString('id-ID') %></div>
                <div style="margin-top: 3px;">
                  <% if (st === 'approved') { %>
                    <span class="badge-pill-custom badge-s" style="font-size: 11px; padding: 2px 10px;">APPROVED</span>
                    <a href="/collector/invoice/<%= r.invoice_id %>/print-thermal" target="_blank" class="btn btn-sm btn-outline-secondary ms-1" style="font-size: 11px; padding: 2px 8px; border-radius:8px;" title="Cetak Struk Thermal">
                      <i class="bi bi-printer"></i>
                    </a>
                  <% } else if (st === 'rejected') { %>
                    <span class="badge-pill-custom badge-d" style="font-size: 11px; padding: 2px 10px;">REJECTED</span>
                  <% } else { %>
                    <span class="badge-pill-custom badge-w" style="font-size: 11px; padding: 2px 10px;">PENDING</span>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div> <!-- End App Container -->

  <!-- Modal Konfirmasi Terima Pembayaran -->
  <div class="modal-custom-backdrop" id="payConfirmModal">
    <div class="modal-custom-box">
      <div style="padding: 16px 20px; border-bottom: 1.5px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
        <span class="modal-title" style="font-weight: 800; font-size: 16px;">
          <i class="bi bi-cash-coin text-success me-1"></i> Konfirmasi Pembayaran Tagihan
        </span>
        <button type="button" class="btn-close" onclick="closePayModal()"></button>
      </div>
      <form method="POST" action="/collector/payment-request">
        <input type="hidden" name="customer_id" id="modalCustomerId">
        <input type="hidden" name="invoice_id" id="modalInvoiceId">
        <input type="hidden" name="month" value="<%= month %>">
        <input type="hidden" name="year" value="<%= year %>">
        <input type="hidden" name="status" value="<%= status %>">
        <input type="hidden" name="search" value="<%= search || '' %>">

        <div style="padding: 20px;">
          <!-- Customer Info Box -->
          <div style="background: rgba(14, 165, 233, 0.08); border: 1.5px solid rgba(14, 165, 233, 0.3); border-radius: 14px; padding: 14px 16px; margin-bottom: 16px;">
            <div style="font-size: 11px; text-transform: uppercase; color: var(--muted); font-weight: 800;">Pelanggan</div>
            <div id="modalCustName" style="font-size: 17px; font-weight: 900; margin-top: 3px;">-</div>
            <div class="d-flex justify-content-between align-items-center mt-2 pt-2" style="border-top: 1px solid var(--border);">
              <span style="font-size: 13px; font-weight: 600;">Total Uang Diterima:</span>
              <span id="modalAmountDisplay" style="font-size: 19px; font-weight: 900; color: #059669;">Rp 0</span>
            </div>
          </div>

          <!-- Note Input -->
          <div class="mb-3">
            <label style="font-size: 13px; font-weight: 700; margin-bottom: 6px; display: block;">Catatan Penagihan (Opsional)</label>
            <input class="form-control" name="note" placeholder="Contoh: Uang pas, titip tetangga, lunas cash..." style="border-radius: 10px; font-size: 13px;">
          </div>

          <div style="font-size: 12px; color: var(--muted); line-height: 1.4;">
            <i class="bi bi-shield-check text-success me-1"></i> Pembayaran akan tercatat atas nama Anda dan sistem otomatis menandai tagihan lunas.
          </div>
        </div>

        <div style="padding: 14px 20px; background: var(--panel2); border-top: 1.5px solid var(--border); display: flex; justify-content: flex-end; gap: 10px;">
          <button type="button" class="btn btn-outline-secondary btn-sm px-3" style="border-radius:10px; font-weight:700;" onclick="closePayModal()">Batal</button>
          <button type="submit" class="btn btn-success btn-sm fw-bold px-4" style="border-radius:10px; min-height:40px;">
            <i class="bi bi-check-circle-fill me-1"></i> Proses Pembayaran
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Bottom Navigation Bar (PWA Style) -->
  <div class="bottom-nav">
    <div class="bottom-nav-inner">
      <a class="bnav-item <%= (!curScope && curStatus==='all') ? 'active' : '' %>" href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'all', scope: '' }).toString() %>#daftar-tagihan">
        <i class="bi bi-grid-fill"></i>
        <span>Semua</span>
      </a>
      <a class="bnav-item <%= curScope==='today' ? 'active' : '' %>" href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'today' }).toString() %>#daftar-tagihan">
        <i class="bi bi-calendar-check-fill"></i>
        <span>Hari Ini</span>
      </a>
      <a class="bnav-item <%= (curScope==='unpaid' || curStatus==='unpaid') && curScope!=='today' && curScope!=='isolir' && curScope!=='multi' ? 'active' : '' %>" href="/collector?<%= new URLSearchParams({ ...baseQs, status: 'unpaid', scope: 'unpaid' }).toString() %>#daftar-tagihan">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>Belum</span>
      </a>
      <a class="bnav-item" href="#riwayat-pengajuan">
        <i class="bi bi-clock-history"></i>
        <span>Riwayat</span>
      </a>
      <a class="bnav-item" href="/collector/attendance">
        <i class="bi bi-fingerprint"></i>
        <span>Absensi</span>
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Senior Accessibility Mode Toggle
    function toggleSeniorMode() {
      const isSenior = document.body.classList.toggle('senior-mode');
      try {
        localStorage.setItem('collector-senior-mode', isSenior ? 'true' : 'false');
      } catch (e) {}
      updateSeniorBtnUI(isSenior);
    }

    function updateSeniorBtnUI(isSenior) {
      const btn = document.getElementById('btnSeniorMode');
      if (btn) {
        if (isSenior) {
          btn.style.borderColor = '#0284c7';
          btn.style.color = '#0284c7';
          btn.style.background = 'rgba(2, 132, 199, 0.15)';
        } else {
          btn.style.borderColor = 'var(--border)';
          btn.style.color = 'inherit';
          btn.style.background = 'rgba(255,255,255,0.08)';
        }
      }
    }

    // Auto load saved senior mode
    (function() {
      try {
        const saved = localStorage.getItem('collector-senior-mode') === 'true';
        if (saved) {
          document.body.classList.add('senior-mode');
          updateSeniorBtnUI(true);
        }
      } catch (e) {}
    })();

    function openPayConfirmModal(customerId, invoiceId, customerName, amount, isNoInvoice) {
      document.getElementById('modalCustomerId').value = customerId;
      document.getElementById('modalInvoiceId').value = invoiceId || '';
      document.getElementById('modalCustName').textContent = customerName;
      document.getElementById('modalAmountDisplay').textContent = 'Rp ' + Number(amount || 0).toLocaleString('id-ID');
      const modal = document.getElementById('payConfirmModal');
      if (modal) modal.classList.add('show');
    }

    function closePayModal() {
      const modal = document.getElementById('payConfirmModal');
      if (modal) modal.classList.remove('show');
    }

    async function sendWaPdf(invId) {
      if (!confirm('Kirimkan dokumen Invoice PDF ke WhatsApp pelanggan sekarang?')) return;
      try {
        const res = await fetch('/collector/invoice/' + invId + '/send-pdf-wa', { method: 'POST' });
        const data = await res.json();
        alert(data.message || (data.success ? 'Berhasil dikirim!' : 'Gagal mengirim'));
      } catch (e) {
        alert('Error: ' + e.message);
      }
    }
  </script>
</body>
</html>
