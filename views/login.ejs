<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  
  <!-- ══════════════════════════════════════════════════════════════
       SEO & MARKETING META TAGS (ON-PAGE INDONESIAN ISP OPTIMIZATION)
       ══════════════════════════════════════════════════════════════ -->
  <title><%= settings.company_header || 'BionFiber' %> | Internet Broadband Fiber Optic Unlimited Rumah &amp; Usaha</title>
  <meta name="description" content="Layanan internet broadband 100% kabel Fiber Optic (FTTH) dari <%= settings.company_header || 'BionFiber' %>. Bebas FUP tanpa batas kuota, streaming lancar 4K, game ping stabil, dan promo gratis biaya pasang baru. Cek paket dan daftar pasang sekarang!">
  <meta name="keywords" content="pasang wifi murah, internet broadband rumah, wifi fiber optic ftth, isp unlimited murah, pasang wifi tanpa fup, internet rumah cepat, cek tagihan wifi, <%= settings.company_header || 'BionFiber' %>">
  <meta name="author" content="<%= settings.company_header || 'BionFiber' %>">
  <meta name="robots" content="index, follow">
  
  <!-- Open Graph / WhatsApp / Facebook Share -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= settings.company_header || 'BionFiber' %>">
  <meta property="og:title" content="<%= settings.company_header || 'BionFiber' %> - Internet Broadband Fiber Optic Unlimited">
  <meta property="og:description" content="Koneksi internet broadband Fiber Optic murni (FTTH) tanpa batas kuota (No FUP). Streaming lancar &amp; main game tanpa lag. Promo bebas biaya registrasi pasang baru!">
  <meta property="og:image" content="/img/logo.png">
  <meta property="og:locale" content="id_ID">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= settings.company_header || 'BionFiber' %> | Internet Fiber Optic Unlimited">
  <meta name="twitter:description" content="Internet broadband rumah super cepat, stabil &amp; bebas FUP. Cek paket dan daftar pasang baru online!">
  <meta name="twitter:image" content="/img/logo.png">

  <!-- Structured Data JSON-LD (Search Engine Rich Snippets & FAQ Page) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "InternetServiceProvider",
        "name": "<%= settings.company_header || 'BionFiber' %>",
        "description": "Penyedia layanan internet broadband 100% kabel Fiber Optic (FTTH) unlimited untuk rumah tangga dan tempat usaha.",
        "url": "/",
        "logo": "/img/logo.png",
        "telephone": "<%= settings.company_phone || '' %>",
        "email": "<%= settings.company_email || '' %>",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "<%= settings.company_address || 'Indonesia' %>",
          "addressCountry": "ID"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "840",
          "bestRating": "5",
          "worstRating": "1"
        },
        "priceRange": "Rp 100.000 - Rp 350.000"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Apakah ada batasan kuota (FUP) yang bikin internet lemot di akhir bulan?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tidak ada. Layanan kami 100% True Unlimited tanpa FUP. Kecepatan tetap stabil sepanjang bulan tanpa penurunan kuota."
            }
          },
          {
            "@type": "Question",
            "name": "Berapa lama proses pemasangan internet baru?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Setelah pendaftaran online dikonfirmasi, teknisi kami biasanya datang memasang dalam 1x24 jam kerja."
            }
          },
          {
            "@type": "Question",
            "name": "Apakah saya harus beli modem Wi-Fi sendiri?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tidak perlu. Perangkat modem Wi-Fi Fiber Optic (ONT) sudah kami pinjamkan secara gratis selama Anda berlangganan."
            }
          }
        ]
      }
    ]
  }
  </script>

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Unified Theme Switcher -->
  <script src="/js/theme.js"></script>
  
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#071228">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/logo.png">
  <link rel="icon" href="/img/logo.png">

  <style>
    /* ══════════════════════════════════════════════════════════════
       DESIGN SYSTEM CSS TOKENS (LIGHT & DARK DUAL THEMES)
       ══════════════════════════════════════════════════════════════ */
    :root, html[data-theme="dark"], body.dark-theme {
      --primary: #0ea5e9;
      --primary-hover: #0284c7;
      --primary-gradient: linear-gradient(135deg, #0ea5e9 0%, #0052cc 100%);
      --accent: #f59e0b;
      --success: #10b981;
      --bg-dark: #071228;
      --bg-surface: #0b1c3d;
      --bg-section-alt: rgba(14, 165, 233, 0.035);
      --card-bg: rgba(15, 28, 54, 0.94);
      --card-border: rgba(148, 163, 184, 0.18);
      --card-shadow: 0 16px 45px rgba(0, 0, 0, 0.45);
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
      --text-muted-custom: #64748b;
      --input-bg: rgba(7, 18, 40, 0.85);
      --input-border: rgba(148, 163, 184, 0.25);
      --input-text: #ffffff;
      --navbar-bg: rgba(7, 18, 40, 0.94);
      --navbar-border: rgba(148, 163, 184, 0.16);
      --nav-link-color: #cbd5e1;
      --hero-badge-bg: rgba(14, 165, 233, 0.15);
      --hero-badge-border: rgba(148, 163, 184, 0.3);
      --hero-badge-text: #38bdf8;
      --btn-sec-bg: rgba(255, 255, 255, 0.08);
      --btn-sec-border: rgba(148, 163, 184, 0.3);
      --btn-sec-text: #ffffff;
      --stat-bg: rgba(15, 28, 54, 0.7);
      --table-border: rgba(148, 163, 184, 0.15);
      --footer-bg: #040a17;
      --footer-border: rgba(148, 163, 184, 0.14);
    }

    /* LIGHT THEME (SENIOR & OUTDOOR FRIENDLY HIGH CONTRAST) */
    html[data-theme="light"], body.light-theme {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --primary-gradient: linear-gradient(135deg, #0284c7 0%, #0052cc 100%);
      --accent: #d97706;
      --success: #059669;
      --bg-dark: #f8fafc;
      --bg-surface: #ffffff;
      --bg-section-alt: #f1f5f9;
      --card-bg: #ffffff;
      --card-border: #cbd5e1;
      --card-shadow: 0 10px 30px rgba(0, 52, 120, 0.07);
      --text-main: #0f172a;
      --text-sub: #334155;
      --text-muted-custom: #475569;
      --input-bg: #ffffff;
      --input-border: #cbd5e1;
      --input-text: #0f172a;
      --navbar-bg: rgba(255, 255, 255, 0.98);
      --navbar-border: #e2e8f0;
      --nav-link-color: #1e293b;
      --hero-badge-bg: #eff6ff;
      --hero-badge-border: #bfdbfe;
      --hero-badge-text: #0369a1;
      --btn-sec-bg: #ffffff;
      --btn-sec-border: #cbd5e1;
      --btn-sec-text: #0f172a;
      --stat-bg: #ffffff;
      --table-border: #e2e8f0;
      --footer-bg: #f1f5f9;
      --footer-border: #cbd5e1;
    }

    /* GLOBAL RESET & BASE */
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    
    body {
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(1200px 600px at 15% 10%, rgba(14, 165, 233, 0.14) 0%, rgba(7, 18, 40, 0) 60%),
        radial-gradient(900px 500px at 85% 40%, rgba(0, 82, 204, 0.1) 0%, rgba(7, 18, 40, 0) 55%);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    html[data-theme="light"] body, body.light-theme {
      background-color: #f8fafc !important;
      background-image: 
        radial-gradient(1200px 600px at 15% 10%, rgba(2, 132, 199, 0.08) 0%, rgba(248, 250, 252, 0) 60%),
        radial-gradient(900px 500px at 85% 40%, rgba(0, 82, 204, 0.05) 0%, rgba(248, 250, 252, 0) 55%) !important;
      color: #0f172a !important;
    }

    /* Top Marketing Promo Ribbon */
    .top-promo-ribbon {
      background: linear-gradient(90deg, #0284c7 0%, #0052cc 50%, #4f46e5 100%);
      color: #ffffff;
      padding: 8px 14px;
      font-size: 13.5px;
      font-weight: 700;
      text-align: center;
      letter-spacing: 0.2px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .top-promo-ribbon .badge-tag {
      background: #fef08a;
      color: #854d0e;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
    }
    .top-promo-ribbon a {
      color: #ffffff;
      text-decoration: underline;
      font-weight: 800;
      transition: opacity 0.2s ease;
    }
    .top-promo-ribbon a:hover {
      opacity: 0.85;
    }

    /* Navbar */
    .custom-navbar {
      background: var(--navbar-bg);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1.5px solid var(--navbar-border);
      padding: 10px 0;
      transition: all 0.2s ease;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    }
    .navbar-brand img {
      height: 52px;
      max-height: 56px;
      width: auto;
      object-fit: contain;
      transition: transform 0.2s ease;
    }
    .navbar-brand:hover img {
      transform: scale(1.02);
    }
    .nav-link {
      color: var(--nav-link-color) !important;
      font-weight: 600;
      font-size: 0.94rem;
      padding: 8px 16px !important;
      border-radius: 10px;
      transition: all 0.2s ease;
    }
    .nav-link:hover, .nav-link.active {
      color: var(--primary) !important;
      background: rgba(14, 165, 233, 0.1);
    }
    html[data-theme="light"] .nav-link:hover, body.light-theme .nav-link:hover {
      background: #eff6ff !important;
    }

    /* Theme Switcher Button */
    .theme-toggle-btn {
      background: var(--btn-sec-bg);
      border: 1.5px solid var(--btn-sec-border);
      color: var(--text-main);
      border-radius: 12px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .theme-toggle-btn:hover {
      transform: translateY(-1px);
    }

    /* Glass Cards */
    .glass-card {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1.5px solid var(--card-border);
      border-radius: 20px;
      box-shadow: var(--card-shadow);
      transition: all 0.25s ease;
    }

    /* Hero Section */
    .hero-section {
      padding: 40px 0 65px;
      position: relative;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--hero-badge-bg);
      border: 1.5px solid var(--hero-badge-border);
      color: var(--hero-badge-text);
      padding: 7px 18px;
      border-radius: 30px;
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: 0.2px;
      margin-bottom: 20px;
    }
    .hero-title {
      font-size: 2.9rem;
      font-weight: 900;
      line-height: 1.18;
      letter-spacing: -0.03em;
      margin-bottom: 20px;
      color: var(--text-main);
    }
    .hero-title-highlight {
      background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 50%, #0052cc 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    html[data-theme="light"] .hero-title-highlight, body.light-theme .hero-title-highlight {
      background: linear-gradient(135deg, #0284c7 0%, #0052cc 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-subtitle {
      font-size: 1.12rem;
      color: var(--text-sub);
      line-height: 1.7;
      margin-bottom: 24px;
      font-weight: 500;
    }

    /* Social Proof Bar */
    .social-proof-bar {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }
    .stars-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: #f59e0b;
      font-weight: 800;
      font-size: 0.95rem;
    }
    .social-proof-text {
      font-size: 0.92rem;
      color: var(--text-sub);
      font-weight: 600;
    }

    /* Action Buttons in Hero */
    .btn-hero-primary {
      background: var(--primary-gradient);
      border: none;
      color: #ffffff !important;
      font-weight: 800;
      padding: 14px 26px;
      border-radius: 14px;
      font-size: 1rem;
      box-shadow: 0 8px 24px rgba(14, 165, 233, 0.35);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.25s ease;
      text-decoration: none;
    }
    .btn-hero-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(14, 165, 233, 0.5);
    }

    .btn-hero-secondary {
      background: var(--btn-sec-bg);
      border: 1.5px solid var(--btn-sec-border);
      color: var(--btn-sec-text) !important;
      font-weight: 700;
      padding: 14px 22px;
      border-radius: 14px;
      font-size: 0.98rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .btn-hero-secondary:hover {
      transform: translateY(-2px);
      border-color: var(--primary);
    }

    /* Hero Stats Grid */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 32px;
    }
    .stat-item {
      background: var(--stat-bg);
      border: 1.5px solid var(--card-border);
      padding: 14px 10px;
      border-radius: 16px;
      text-align: center;
      transition: all 0.2s ease;
    }
    .stat-number {
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--primary);
      line-height: 1.2;
    }
    .stat-label {
      font-size: 0.78rem;
      color: var(--text-sub);
      font-weight: 700;
      margin-top: 4px;
    }

    /* Login Card Box */
    .login-card-container {
      position: relative;
    }
    .login-card-body {
      padding: 24px 24px 30px;
    }
    .card-header-title {
      color: var(--text-main);
      font-weight: 900;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
    }
    .login-brand-logo {
      height: 52px;
      max-height: 56px;
      width: auto;
      max-width: 220px;
      object-fit: contain;
      display: inline-block;
    }

    /* Live Server Status Pill */
    .live-dot-pulse {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: dotPulse 2s infinite;
    }
    @keyframes dotPulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* Form Controls */
    .form-floating {
      margin-bottom: 16px;
    }
    .form-control {
      background: var(--input-bg);
      border: 1.5px solid var(--input-border);
      color: var(--input-text);
      border-radius: 12px;
      padding: 14px 16px;
      font-size: 0.98rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .form-control:focus {
      background: var(--input-bg);
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.18);
      color: var(--input-text);
    }
    .form-floating > label {
      color: var(--text-muted-custom);
      font-size: 0.92rem;
      font-weight: 600;
    }
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
      color: var(--primary);
    }

    .btn-submit-login {
      background: var(--primary-gradient);
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-size: 1rem;
      font-weight: 800;
      color: #ffffff;
      width: 100%;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(14, 165, 233, 0.35);
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 48px;
    }
    .btn-submit-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(14, 165, 233, 0.5);
      color: #ffffff;
    }

    /* Fast Tool Shortcuts inside Login Card */
    .quick-tools-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 16px;
    }
    .btn-quick-tool {
      background: var(--btn-sec-bg);
      border: 1.5px solid var(--btn-sec-border);
      color: var(--text-main);
      padding: 11px 12px;
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 700;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      transition: all 0.2s ease;
    }
    .btn-quick-tool:hover {
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-2px);
    }

    /* Section Headers */
    .section-padding {
      padding: 70px 0;
    }
    .section-title-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--hero-badge-bg);
      border: 1.5px solid var(--hero-badge-border);
      color: var(--hero-badge-text);
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 0.84rem;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .section-title {
      font-size: 2.3rem;
      font-weight: 900;
      color: var(--text-main);
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }
    .section-subtitle {
      color: var(--text-sub);
      font-size: 1.06rem;
      max-width: 660px;
      margin: 0 auto 38px;
      font-weight: 500;
      line-height: 1.6;
    }



    /* Package Cards */
    .pkg-card {
      padding: 28px 24px;
      height: 100%;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .pkg-card:hover {
      transform: translateY(-5px);
      border-color: var(--primary);
      box-shadow: 0 16px 36px rgba(14, 165, 233, 0.18);
    }
    .pkg-card.highlighted-pkg {
      border-color: var(--primary) !important;
      box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.4), 0 20px 45px rgba(14, 165, 233, 0.22) !important;
    }
    .pkg-badge-popular {
      position: absolute;
      top: -14px;
      right: 20px;
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #ffffff;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 5px 14px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 14px rgba(245, 158, 11, 0.45);
    }
    .pkg-speed-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--hero-badge-bg);
      color: var(--primary);
      padding: 5px 14px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 800;
      margin-bottom: 15px;
      width: fit-content;
      border: 1px solid var(--hero-badge-border);
    }
    .pkg-name {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 6px;
    }
    .pkg-price {
      font-size: 2.15rem;
      font-weight: 900;
      color: var(--text-main);
      margin-bottom: 2px;
      letter-spacing: -0.5px;
    }
    .pkg-period {
      font-size: 0.88rem;
      color: var(--text-sub);
      margin-bottom: 20px;
      font-weight: 600;
    }
    .pkg-features {
      list-style: none;
      padding: 0;
      margin: 0 0 25px 0;
      flex-grow: 1;
    }
    .pkg-features li {
      padding: 9px 0;
      border-bottom: 1px solid var(--card-border);
      font-size: 0.93rem;
      color: var(--text-sub);
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 500;
    }
    .pkg-features li i {
      color: var(--success);
      font-size: 1.15rem;
      flex-shrink: 0;
    }
    .btn-pkg-action {
      background: var(--btn-sec-bg);
      border: 1.5px solid var(--btn-sec-border);
      color: var(--text-main);
      border-radius: 12px;
      padding: 13px;
      font-weight: 700;
      text-decoration: none;
      text-align: center;
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .btn-pkg-action:hover {
      background: var(--primary-gradient);
      border-color: transparent;
      color: #ffffff !important;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(14, 165, 233, 0.35);
    }

    /* ══════════════════════════════════════════════════════════════
       COMPARISON TABLE (KENAPA HARUS WI-FI FIBER OPTIC RUMAH)
       ══════════════════════════════════════════════════════════════ */
    .comparison-table-wrapper {
      overflow-x: auto;
      border-radius: 18px;
      border: 1.5px solid var(--card-border);
      background: var(--card-bg);
      box-shadow: var(--card-shadow);
    }
    .comparison-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    .comparison-table th, .comparison-table td {
      padding: 16px 20px;
      border-bottom: 1px solid var(--table-border);
      font-size: 0.95rem;
    }
    .comparison-table th {
      font-weight: 800;
      color: var(--text-main);
      background: var(--hero-badge-bg);
    }
    .comparison-table tr:last-child td {
      border-bottom: none;
    }

    /* ══════════════════════════════════════════════════════════════
       3-STEP ONBOARDING PROCESS (FRICTION REDUCER)
       ══════════════════════════════════════════════════════════════ */
    .step-box {
      background: var(--card-bg);
      border: 1.5px solid var(--card-border);
      border-radius: 18px;
      padding: 26px 20px;
      text-align: center;
      position: relative;
      height: 100%;
      transition: all 0.25s ease;
    }
    .step-box:hover {
      transform: translateY(-4px);
      border-color: var(--primary);
    }
    .step-number-circle {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: var(--primary-gradient);
      color: #ffffff;
      font-weight: 900;
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      box-shadow: 0 6px 18px rgba(14, 165, 233, 0.4);
    }
    .step-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 8px;
    }
    .step-desc {
      font-size: 0.92rem;
      color: var(--text-sub);
      line-height: 1.55;
      margin: 0;
    }

    /* Feature Box */
    .feature-box {
      padding: 28px 22px;
      height: 100%;
      border-radius: 18px;
      transition: all 0.25s ease;
    }
    .feature-box:hover {
      transform: translateY(-4px);
      border-color: var(--primary);
    }
    .feature-icon-wrapper {
      width: 54px;
      height: 54px;
      border-radius: 15px;
      background: var(--hero-badge-bg);
      border: 1.5px solid var(--hero-badge-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.55rem;
      color: var(--primary);
      margin-bottom: 18px;
    }
    .feature-title {
      font-size: 1.18rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 8px;
    }
    .feature-desc {
      color: var(--text-sub);
      font-size: 0.94rem;
      line-height: 1.6;
      margin: 0;
    }

    /* ══════════════════════════════════════════════════════════════
       TESTIMONIALS (REAL SOCIAL PROOF)
       ══════════════════════════════════════════════════════════════ */
    .testimonial-card {
      background: var(--card-bg);
      border: 1.5px solid var(--card-border);
      border-radius: 18px;
      padding: 24px;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
    }
    .testimonial-card:hover {
      transform: translateY(-4px);
      border-color: var(--primary);
    }
    .testimonial-quote {
      font-size: 0.95rem;
      color: var(--text-sub);
      line-height: 1.65;
      font-style: italic;
      margin-bottom: 18px;
    }
    .testimonial-user {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .testimonial-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--hero-badge-bg);
      border: 1.5px solid var(--hero-badge-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      color: var(--primary);
      font-size: 1.1rem;
    }
    .testimonial-name {
      font-weight: 800;
      font-size: 0.95rem;
      color: var(--text-main);
      margin: 0;
    }
    .testimonial-role {
      font-size: 0.82rem;
      color: var(--text-muted-custom);
      margin: 0;
    }

    /* ══════════════════════════════════════════════════════════════
       FAQ ACCORDION (SEO RICH CONTENT & REAL ANSWERS)
       ══════════════════════════════════════════════════════════════ */
    .faq-accordion .accordion-item {
      background: var(--card-bg);
      border: 1.5px solid var(--card-border);
      border-radius: 16px !important;
      margin-bottom: 14px;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
      transition: all 0.2s ease;
    }
    .faq-accordion .accordion-button {
      background: transparent;
      color: var(--text-main);
      font-weight: 800;
      font-size: 1.03rem;
      padding: 18px 22px;
      box-shadow: none;
    }
    .faq-accordion .accordion-button:not(.collapsed) {
      color: var(--primary);
      background: var(--hero-badge-bg);
    }
    .faq-accordion .accordion-button::after {
      filter: invert(var(--text-main) === '#0f172a' ? 0 : 1);
    }
    .faq-accordion .accordion-body {
      color: var(--text-sub);
      font-size: 0.95rem;
      line-height: 1.65;
      padding: 18px 22px;
      background: transparent;
    }

    /* Bottom Pre-Footer CTA Banner */
    .cta-banner {
      background: linear-gradient(135deg, #0284c7 0%, #0052cc 60%, #4f46e5 100%);
      border-radius: 24px;
      padding: 45px 30px;
      color: #ffffff;
      text-align: center;
      box-shadow: 0 16px 40px rgba(2, 132, 199, 0.35);
      position: relative;
      overflow: hidden;
    }
    .cta-banner-title {
      font-size: 2.15rem;
      font-weight: 900;
      margin-bottom: 12px;
      letter-spacing: -0.02em;
    }
    .cta-banner-desc {
      font-size: 1.08rem;
      max-width: 620px;
      margin: 0 auto 26px;
      opacity: 0.95;
      line-height: 1.6;
    }

    /* Footer */
    .site-footer {
      background: var(--footer-bg);
      border-top: 1.5px solid var(--footer-border);
      padding: 55px 0 30px;
      color: var(--text-sub);
      transition: all 0.2s ease;
    }
    .footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .footer-links li {
      margin-bottom: 10px;
    }
    .footer-links a {
      color: var(--text-sub);
      text-decoration: none;
      font-size: 0.93rem;
      transition: color 0.2s ease;
      font-weight: 500;
    }
    .footer-links a:hover {
      color: var(--primary);
    }
    .footer-bottom {
      border-top: 1px solid var(--footer-border);
      margin-top: 36px;
      padding-top: 24px;
      font-size: 0.9rem;
    }

    /* Floating WhatsApp Button */
    .btn-floating-wa {
      position: fixed;
      bottom: 24px;
      right: 24px;
      padding: 12px 18px;
      border-radius: 40px;
      background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
      color: #ffffff !important;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 14.5px;
      box-shadow: 0 10px 28px rgba(37, 211, 102, 0.45);
      z-index: 1050;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .btn-floating-wa:hover {
      transform: scale(1.05) translateY(-3px);
      box-shadow: 0 14px 34px rgba(37, 211, 102, 0.6);
      color: #ffffff;
    }
    .btn-floating-wa .wa-pulse-dot {
      width: 10px;
      height: 10px;
      background: #ffffff;
      border-radius: 50%;
      display: inline-block;
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
      animation: dotPulse 2s infinite;
    }

    /* Responsive Queries */
    @media (max-width: 991.98px) {
      .hero-title { font-size: 2.3rem; }
      .hero-section { padding: 30px 0 50px; }
      .login-card-container { margin-top: 36px; }
      .hero-stats { grid-template-columns: repeat(2, 1fr); }
      .calc-tabs { grid-template-columns: 1fr; }
    }
    @media (max-width: 575.98px) {
      .hero-title { font-size: 1.85rem; }
      .navbar-brand img { height: 44px; }
      .login-card-body { padding: 20px 16px; }
      .quick-tools-grid { grid-template-columns: 1fr; }
      .hero-stats { grid-template-columns: 1fr 1fr; }
      .btn-floating-wa span { display: none; }
      .btn-floating-wa { padding: 14px; border-radius: 50%; }
    }
  </style>
</head>

<body>

  <!-- ══════════════════════════════════════════════════════════════
       TOP PROMO RIBBON (URGENCY & PROMO VALUE)
       ══════════════════════════════════════════════════════════════ -->
  <div class="top-promo-ribbon">
    <span class="badge-tag">Promo Bulan Ini</span>
    <span>🔥 <strong>Pasang Baru Wi-Fi:</strong> Bebas Biaya Registrasi &amp; Gratis Peminjaman Modem Wi-Fi Fiber Optic!</span>
    <a href="/customer/register">Daftar Pasang Sekarang &rarr;</a>
  </div>

  <!-- ══════════════════════════════════════════════════════════════
       STICKY NAVBAR (LOGO ONLY, CLEAN NAV, THEME SWITCHER)
       ══════════════════════════════════════════════════════════════ -->
  <nav class="navbar navbar-expand-lg sticky-top custom-navbar">
    <div class="container">
      <!-- Logo only without text duplicate -->
      <a class="navbar-brand py-0 me-3" href="#">
        <img src="/img/logo.png" alt="<%= settings.company_header || 'Logo' %>" onerror="this.src='/favicon.ico'; this.onerror=null;">
      </a>

      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
        <i class="bi bi-list fs-2" style="color: var(--text-main);"></i>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
          <li class="nav-item">
            <a class="nav-link active" href="#hero"><i class="bi bi-house-door me-1"></i> Beranda</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#packages"><i class="bi bi-wifi me-1"></i> Paket Internet</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#comparison"><i class="bi bi-check2-circle me-1"></i> Keunggulan</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#faq"><i class="bi bi-question-circle me-1"></i> FAQ</a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
          <!-- Theme Switcher (Dark / Light) -->
          <button type="button" class="theme-toggle-btn" onclick="toggleAppTheme()" title="Ganti Tema Terang (Siang) / Gelap (Malam)">
            <i class="theme-toggle-icon bi bi-sun-fill" style="font-size: 15px;"></i>
            <span class="d-none d-sm-inline">Tema</span>
          </button>
          
          <button type="button" id="btn-install-pwa-nav" class="btn btn-warning btn-sm rounded-3 px-3 py-2 fw-bold d-inline-flex align-items-center shadow-sm text-dark" onclick="triggerPwaInstall()">
            <i class="bi bi-download me-1"></i> Aplikasi
          </button>
          
          <a href="#login-section" class="btn btn-hero-primary btn-sm py-2 px-3">
            <i class="bi bi-box-arrow-in-right me-1"></i> Masuk Portal
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- ══════════════════════════════════════════════════════════════
       HERO & PORTAL SECTION (AIDA CONVERSION & CLEAN PORTAL)
       ══════════════════════════════════════════════════════════════ -->
  <section class="hero-section" id="hero">
    <div class="container">
      <div class="row align-items-center">

        <!-- Left Column: Value Proposition & Onboarding CTAs -->
        <div class="col-lg-7 mb-5 mb-lg-0">
          <div class="hero-badge">
            <i class="bi bi-lightning-charge-fill text-warning"></i>
            <span>Internet Broadband Fiber Optic (FTTH) Rumah &amp; Usaha</span>
          </div>

          <h1 class="hero-title">
            Internet Rumah &amp; Usaha: <br>
            <span class="hero-title-highlight">Cepat, Stabil &amp; Bebas Kuota!</span>
          </h1>

          <p class="hero-subtitle">
            Layanan internet broadband 100% kabel Fiber Optic (FTTH) langsung ke rumah Anda. Nonton streaming film 4K lancar tanpa buffering, main game online dengan ping stabil, dan bebas kuota sepuasnya tanpa batas FUP. Pemasangan cepat dan rapi oleh teknisi lokal berpengalaman.
          </p>

          <!-- Social Proof Rating -->
          <div class="social-proof-bar">
            <div class="stars-badge">
              <i class="bi bi-star-fill"></i>
              <i class="bi bi-star-fill"></i>
              <i class="bi bi-star-fill"></i>
              <i class="bi bi-star-fill"></i>
              <i class="bi bi-star-fill"></i>
              <span class="ms-1">4.9/5</span>
            </div>
            <div class="social-proof-text">
              Dipercaya oleh ratusan keluarga &amp; tempat usaha lokal
            </div>
          </div>

          <!-- CTAs for Prospective Visitors (No repeated Cek Tagihan here) -->
          <div class="d-flex flex-wrap gap-3 mb-4" style="max-width: 620px;">
            <a href="/customer/register" class="btn-hero-primary flex-fill" style="min-width: 230px;">
              <i class="bi bi-rocket-takeoff-fill fs-5"></i>
              <span>Daftar Pasang Baru (Promo)</span>
            </a>
            
            <a href="#packages" class="btn-hero-secondary flex-fill" style="min-width: 180px;">
              <i class="bi bi-wifi fs-5 text-primary"></i>
              <span>Lihat Pilihan Paket</span>
            </a>

            <a href="/customer/voucher" class="btn-hero-secondary flex-fill" style="min-width: 150px;">
              <i class="bi bi-ticket-perforated-fill fs-5 text-warning"></i>
              <span>Beli Voucher</span>
            </a>
          </div>

          <!-- 4 Core Grounded Trust Metrics -->
          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-number"><i class="bi bi-speedometer2 me-1"></i> FTTH</div>
              <div class="stat-label">100% Kabel Fiber</div>
            </div>
            <div class="stat-item">
              <div class="stat-number text-success"><i class="bi bi-infinity me-1"></i> No FUP</div>
              <div class="stat-label">Bebas Kuota Puas</div>
            </div>
            <div class="stat-item">
              <div class="stat-number text-warning"><i class="bi bi-shield-check me-1"></i> Stabil</div>
              <div class="stat-label">Koneksi Andal 24 Jam</div>
            </div>
            <div class="stat-item">
              <div class="stat-number text-info"><i class="bi bi-whatsapp me-1"></i> Teknisi</div>
              <div class="stat-label">Respon Cepat Siaga</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Clean Customer Portal Card (Direct Logo, No small box) -->
        <div class="col-lg-5 login-card-container" id="login-section">
          <div class="glass-card shadow-2xl">
            <!-- Card Header with direct clean logo -->
            <div class="text-center pt-4 px-4 pb-2">
              <img src="/img/logo.png" alt="Logo" class="login-brand-logo mb-3" onerror="this.style.display='none'">
              <h4 class="fw-bold mb-1 card-header-title"><%= t('customer.portal_title', 'Portal Pelanggan') %></h4>
              
              <!-- Live Server Status Indicator -->
              <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);font-size:11.5px;font-weight:700;color:#10b981;">
                <span class="live-dot-pulse"></span>
                <span>Server Online &bull; Siap Melayani</span>
              </div>
            </div>

            <div class="login-card-body">
              <form method="POST" action="/customer/login" id="customerLoginForm">
                <!-- Input 1: ID Pelanggan / Nomor WhatsApp / Username PPPoE -->
                <div class="form-floating mb-3">
                  <input type="text" class="form-control" id="phone" name="phone" placeholder="<%= t('customer.id_tag_placeholder', 'Masukkan ID Pelanggan / No. WA') %>" required autocomplete="username" autofocus>
                  <label for="phone">
                    <i class="bi bi-person-badge me-2 text-primary"></i><%= t('customer.id_tag', 'No. WhatsApp / ID Pelanggan / Username') %>
                  </label>
                </div>

                <!-- Input 2: PIN Keamanan (5 Angka Terakhir No. HP Terdaftar) -->
                <div class="form-floating position-relative mb-1">
                  <input type="password" class="form-control" id="pin" name="pin" placeholder="5 Angka Terakhir No. HP" maxlength="20" required autocomplete="current-password">
                  <label for="pin">
                    <i class="bi bi-key-fill me-2 text-primary"></i>PIN (5 Angka Terakhir No. HP)
                  </label>
                  <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-decoration-none pe-3" id="btnTogglePin" onclick="togglePinVisibility()" title="Lihat PIN" style="z-index: 5; color: var(--text-muted-custom);">
                    <i class="bi bi-eye fs-5" id="pinEyeIcon"></i>
                  </button>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                  <small class="d-inline-flex align-items-center gap-1" style="font-size: 11.5px; color: var(--text-muted-custom);">
                    <i class="bi bi-info-circle text-info"></i> PIN: 5 digit angka terakhir nomor WhatsApp terdaftar
                  </small>
                </div>

                <!-- Remember Me & Forgot Help -->
                <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe" checked>
                    <label class="form-check-label small" for="rememberMe" style="cursor: pointer; font-size:12px; color: var(--text-sub);">
                      Ingat akun di browser ini
                    </label>
                  </div>
                  <% if (settings.company_phone) { %>
                    <a href="https://wa.me/<%= String(settings.company_phone).replace(/\D/g,'') %>?text=Halo%20Admin,%20saya%20lupa%20nomor%20HP%20terdaftar%20atau%20ID%20pelanggan%20saya" target="_blank" rel="noopener" class="small text-decoration-none" style="font-size:12px; color:var(--primary); font-weight:700;">
                      Lupa Akun?
                    </a>
                  <% } %>
                </div>

                <% if (settings.login_otp_enabled) { %>
                  <div class="alert alert-info py-2 px-3 mb-3 small border-0 bg-info bg-opacity-15 text-info rounded-3 text-center fw-semibold">
                    <i class="bi bi-whatsapp me-1"></i> <%= t('customer.otp_sent_via_wa', 'Setelah ini kode OTP akan dikirim via WhatsApp') %>
                  </div>
                <% } %>

                <button type="submit" class="btn-submit-login">
                  <i class="bi bi-box-arrow-in-right me-2"></i><%= t('customer.sign_in', 'Masuk Ke Portal Pelanggan') %>
                </button>
              </form>

              <% if (error) { %>
                <div class="alert alert-danger mt-3 py-2 px-3 text-center small rounded-3 border-danger border-opacity-25 fw-semibold">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  <%= error %>
                </div>
              <% } %>

              <!-- Fast Tool Shortcuts (The single logical place for Cek Tagihan without login) -->
              <div class="quick-tools-grid">
                <a href="/customer/check-billing" class="btn-quick-tool">
                  <i class="bi bi-receipt text-info fs-5"></i> Cek Tagihan
                </a>
                <a href="/customer/voucher" class="btn-quick-tool">
                  <i class="bi bi-ticket-perforated text-warning fs-5"></i> Beli Voucher
                </a>
              </div>

              <div class="text-center mt-4 pt-2 border-top border-secondary border-opacity-20">
                <p class="mb-0 small" style="color: var(--text-muted-custom);">
                  <%= t('customer.not_subscribed', 'Belum berlangganan?') %>
                  <a href="/customer/register" class="fw-bold text-decoration-none ms-1" style="color: var(--primary);">
                    <%= t('customer.register_new', 'Daftar Pemasangan Baru') %> <i class="bi bi-arrow-right"></i>
                  </a>
                </p>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════
       PACKAGES SECTION (OPTIMAL UNTUK KELUARGA & WARGA DESA)
       ══════════════════════════════════════════════════════════════ -->
  <section class="section-padding" id="packages">
    <div class="container">
      <div class="text-center mb-5">
        <span class="section-title-badge"><i class="bi bi-wifi me-1"></i> Pilihan Paket Internet</span>
        <h2 class="section-title">Pilihan Paket &amp; Tarif Berlangganan</h2>
        <p class="section-subtitle">
          Koneksi internet broadband tanpa batas kuota (True Unlimited). Bebas digunakan sepuasnya untuk semua smartphone, Smart TV, laptop, dan komputer di rumah Anda!
        </p>
      </div>

      <!-- Packages Grid (Dikelola Dinamis dari Panel Admin) -->
      <% const pkgs = (typeof packages !== 'undefined' && Array.isArray(packages)) ? packages : []; %>
      <% if (pkgs.length === 0) { %>
        <div class="glass-card text-center p-5 max-w-lg mx-auto">
          <i class="bi bi-info-circle fs-1 text-info mb-3 d-block"></i>
          <h5 class="fw-bold" style="color: var(--text-main);">Belum Ada Paket Dipublikasikan</h5>
          <p class="mb-0" style="color: var(--text-sub);">Silakan hubungi customer service kami via WhatsApp untuk informasi ketersediaan paket terkini.</p>
        </div>
      <% } else { %>
        <% const list = pkgs.slice().sort((a,b) => Number(a.price||0) - Number(b.price||0)); %>
        <div class="row g-4 justify-content-center" id="packageCardsGrid">
          <% list.forEach((p, index) => { 
               const speedDownMbps = Math.round(Number(p.speed_down||0)/1000);
          %>
            <div class="col-md-6 col-lg-4" id="pkg-card-<%= index %>">
              <div class="glass-card pkg-card">
                <% if (index === Math.floor(list.length / 2)) { %>
                  <div class="pkg-badge-popular"><i class="bi bi-star-fill me-1"></i> Paling Laris</div>
                <% } %>

                <div class="pkg-speed-tag">
                  <i class="bi bi-speedometer2 me-1"></i>
                  <% if (Number(p.speed_down||0) > 0) { %>
                    <%= (speedDownMbps >= 1) ? speedDownMbps + ' Mbps' : Number(p.speed_down||0) + ' Kbps' %>
                  <% } else { %>
                    Broadband Fiber
                  <% } %>
                </div>

                <h3 class="pkg-name"><%= p.name %></h3>

                <div class="pkg-price">
                  Rp <%= Number(p.price||0).toLocaleString('id-ID') %>
                </div>
                <div class="pkg-period">per bulan (sudah termasuk PPN)</div>

                <ul class="pkg-features">
                  <li><i class="bi bi-check-circle-fill"></i> <strong>100% True Unlimited</strong> (Tanpa Batas FUP)</li>
                  <li><i class="bi bi-check-circle-fill"></i> Jaringan <strong>Broadband Fiber Optic</strong> (FTTH)</li>
                  <li><i class="bi bi-check-circle-fill"></i> Bebas Konek <strong>Banyak Perangkat HP &amp; TV</strong></li>
                  <li><i class="bi bi-check-circle-fill"></i> Ping Stabil untuk Game &amp; Video Call</li>
                  <li><i class="bi bi-check-circle-fill"></i> <strong>Gratis Sewa</strong> Modem Wi-Fi Fiber</li>
                  <li><i class="bi bi-check-circle-fill"></i> Bantuan Teknisi Standby Siaga</li>
                  <% if (p.description) { %>
                    <li style="border:none;"><i class="bi bi-info-circle-fill text-info"></i> <%= p.description %></li>
                  <% } %>
                </ul>

                <a href="/customer/register?package=<%= encodeURIComponent(p.name) %>" class="btn-pkg-action">
                  <span>Pilih Paket Ini</span>
                  <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

