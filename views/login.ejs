  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Toggle PIN visibility
    function togglePinVisibility() {
      const pin = document.getElementById('pin');
      const icon = document.getElementById('pinEyeIcon');
      if (!pin || !icon) return;
      if (pin.type === 'password') {
        pin.type = 'text';
        icon.className = 'bi bi-eye-slash fs-5';
      } else {
        pin.type = 'password';
        icon.className = 'bi bi-eye fs-5';
      }
    }



    // Remember Me Logic via localStorage
    (function() {
      const loginForm = document.getElementById('customerLoginForm');
      const phoneInput = document.getElementById('phone');
      const rememberCheckbox = document.getElementById('rememberMe');

      try {
        const savedId = localStorage.getItem('customer_remember_id');
        if (savedId && phoneInput) {
          phoneInput.value = savedId;
          const pinInput = document.getElementById('pin');
          if (pinInput && !('ontouchstart' in window)) {
            setTimeout(() => pinInput.focus(), 300);
          }
        }
      } catch (e) {}

      if (loginForm && phoneInput && rememberCheckbox) {
        loginForm.addEventListener('submit', () => {
          try {
            if (rememberCheckbox.checked) {
              localStorage.setItem('customer_remember_id', phoneInput.value.trim());
            } else {
              localStorage.removeItem('customer_remember_id');
            }
          } catch (e) {}
        });
      }
    })();

    // PWA Prompt Handler
    let deferredPwaPrompt = null;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPwaPrompt = e;
      const navBtn = document.getElementById('btn-install-pwa-nav');
      if (navBtn) navBtn.classList.add('shadow-lg');
    });

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          deferredPwaPrompt = null;
        });
      } else {
        const modalEl = document.getElementById('pwaInstallModal');
        if (modalEl) {
          const bsModal = new bootstrap.Modal(modalEl);
          bsModal.show();
        }
      }
    }

    function triggerPwaInstallDirect() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          const modalEl = document.getElementById('pwaInstallModal');
          if (modalEl) {
            const instance = bootstrap.Modal.getInstance(modalEl);
            if (instance) instance.hide();
          }
          deferredPwaPrompt = null;
        });
      }
    }

    // Defer service worker registration
    if ('serviceWorker' in navigator) {
      setTimeout(() => {
        navigator.serviceWorker.register('/sw.js?v=2', { scope: '/customer/' }).then(reg => reg.update()).catch(() => {});
      }, 1500);
    }

    // Highlight active nav item on scroll
    const sections = document.querySelectorAll('section[id], header[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop - 120;
        if (pageYOffset >= sectionTop) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });
  </script>
</body>

