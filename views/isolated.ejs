<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Layanan Pelanggan | <%= company %></title>
  
  <!-- Early Theme Init to avoid FOUC -->
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('customer-theme') || localStorage.getItem('app-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', saved);
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="/img/logo.png">

  <style>
    :root, [data-theme="dark"] {
      --bg-page: #090d16;
      --card-bg: #111827;
      --card-surface: #172133;
      --card-border: rgba(255, 255, 255, 0.08);
      --card-border-strong: rgba(255, 255, 255, 0.16);
      --text-heading: #ffffff;
      --text-body: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --primary-light: #60a5fa;
      --primary-subtle: rgba(37, 99, 235, 0.16);

      --warning: #f59e0b;
      --warning-subtle: rgba(245, 158, 11, 0.12);
      --warning-border: rgba(245, 158, 11, 0.35);

      --danger: #ef4444;
      --danger-subtle: rgba(239, 68, 68, 0.12);
      --danger-border: rgba(239, 68, 68, 0.3);

      --success: #10b981;
      --success-subtle: rgba(16, 185, 129, 0.12);
      --success-border: rgba(16, 185, 129, 0.35);

      --input-bg: #162032;
      --shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
      --shadow-modal: 0 25px 60px -10px rgba(0, 0, 0, 0.85);
      --modal-bg: #111827;
    }

    [data-theme="light"] {
      --bg-page: #f1f5f9;
      --card-bg: #ffffff;
      --card-surface: #f8fafc;
      --card-border: #e2e8f0;
      --card-border-strong: #cbd5e1;
      --text-heading: #0f172a;
      --text-body: #1e293b;
      --text-muted: #64748b;
      --text-dim: #94a3b8;

      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --primary-light: #1d4ed8;
      --primary-subtle: #eff6ff;

      --warning: #d97706;
      --warning-subtle: #fffbeb;
      --warning-border: #fde68a;

      --danger: #dc2626;
      --danger-subtle: #fef2f2;
      --danger-border: #fecaca;

      --success: #059669;
      --success-subtle: #ecfdf5;
      --success-border: #a7f3d0;

      --input-bg: #f8fafc;
      --shadow: 0 20px 35px -10px rgba(15, 23, 42, 0.08);
      --shadow-modal: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
      --modal-bg: #ffffff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-page);
      color: var(--text-body);
      min-height: 100vh;
      padding: 20px 16px 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      transition: background .2s ease, color .2s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .wrapper {
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
    }

    /* Top Brand & Theme Bar */
    .top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding: 0 4px;
    }
    .brand-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .brand-logo {
      height: 34px;
      max-width: 110px;
      object-fit: contain;
    }
    .brand-title {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-heading);
      letter-spacing: -0.3px;
    }
    .theme-toggle-btn {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 16px;
      transition: all .2s ease;
    }
    .theme-toggle-btn:hover {
      color: var(--primary-light);
      border-color: var(--card-border-strong);
    }

    /* Main Container Card */
    .card-portal {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 24px 22px;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
      transition: background .2s ease, border-color .2s ease;
    }

    /* Badges */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .3px;
      margin-bottom: 14px;
    }
    .status-badge.warning {
      background: var(--warning-subtle);
      color: var(--warning);
      border: 1px solid var(--warning-border);
    }
    .status-badge.success {
      background: var(--success-subtle);
      color: var(--success);
      border: 1px solid var(--success-border);
    }

    h1 {
      font-size: 21px;
      font-weight: 800;
      margin-bottom: 8px;
      color: var(--text-heading);
      letter-spacing: -0.4px;
      line-height: 1.3;
    }
    .sub-desc {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 20px;
    }

    /* Customer Info Box */
    .cust-info-box {
      background: var(--card-surface);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 12px 14px;
      margin-bottom: 20px;
    }
    .cust-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      font-size: 13px;
      border-bottom: 1px solid var(--card-border);
    }
    .cust-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    .cust-row .label {
      color: var(--text-muted);
      font-weight: 500;
    }
    .cust-row .val {
      font-weight: 700;
      color: var(--text-heading);
      text-align: right;
    }

    /* Invoice Main Card */
    .invoice-card {
      background: var(--card-surface);
      border: 1px solid var(--card-border-strong);
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 16px;
      position: relative;
    }
    .inv-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .inv-period {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-heading);
    }
    .inv-id {
      font-size: 12px;
      color: var(--text-muted);
      font-weight: 600;
    }
    .inv-amount-label {
      font-size: 11.5px;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--text-dim);
      letter-spacing: .5px;
      margin-bottom: 2px;
    }
    .inv-amount {
      font-size: 28px;
      font-weight: 900;
      color: var(--primary-light);
      letter-spacing: -0.5px;
      margin-bottom: 16px;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 13px 18px;
      border-radius: 12px;
      font-size: 14.5px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      border: none;
      transition: all .2s ease;
      box-sizing: border-box;
      font-family: inherit;
    }
    .btn-primary-action {
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: #ffffff;
      box-shadow: 0 8px 20px -4px rgba(37, 99, 235, 0.45);
    }
    .btn-primary-action:hover {
      background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
      transform: translateY(-1px);
      box-shadow: 0 12px 24px -4px rgba(37, 99, 235, 0.6);
    }
    .btn-secondary {
      background: var(--card-surface);
      color: var(--text-body);
      border: 1px solid var(--card-border);
      font-size: 13.5px;
      margin-top: 10px;
    }
    .btn-secondary:hover {
      border-color: var(--card-border-strong);
      background: var(--input-bg);
      color: var(--text-heading);
    }
    .btn-wa-outline {
      background: transparent;
      color: #10b981;
      border: 1px solid var(--success-border);
      font-size: 13.5px;
      margin-top: 12px;
    }
    .btn-wa-outline:hover {
      background: var(--success-subtle);
      border-color: var(--success);
      color: var(--success);
    }

    /* Auto Reconnect Notice Box */
    .reconnect-notice {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: var(--primary-subtle);
      border: 1px solid rgba(37, 99, 235, 0.2);
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 12.5px;
      line-height: 1.45;
      color: var(--text-body);
      margin-bottom: 14px;
    }
    .reconnect-notice i {
      font-size: 18px;
      color: var(--primary-light);
      flex-shrink: 0;
      margin-top: 1px;
    }

    /* Search Fallback Form */
    .search-box {
      background: var(--card-surface);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 16px;
      margin-top: 12px;
    }
    .search-form {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }
    .search-input {
      flex: 1;
      background: var(--input-bg);
      border: 1px solid var(--card-border-strong);
      color: var(--text-heading);
      padding: 11px 14px;
      border-radius: 10px;
      font-size: 14px;
      outline: none;
      font-family: inherit;
    }
    .search-input:focus {
      border-color: var(--primary);
    }
    .search-btn {
      width: auto;
      padding: 11px 18px;
      background: var(--primary);
      color: #ffffff;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 700;
    }

    /* Modal QRIS Quick */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 9999;
      opacity: 0;
      visibility: hidden;
      transition: all .25s ease;
    }
    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .modal-card {
      background: var(--modal-bg);
      border: 1px solid var(--card-border-strong);
      border-radius: 24px;
      width: 100%;
      max-width: 420px;
      max-height: 92vh;
      overflow-y: auto;
      padding: 24px 20px;
      box-shadow: var(--shadow-modal);
      position: relative;
      transform: scale(0.95);
      transition: all .25s ease;
      text-align: center;
    }
    .modal-overlay.active .modal-card {
      transform: scale(1);
    }
    .modal-close {
      position: absolute;
      top: 16px; right: 16px;
      background: var(--card-surface);
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      font-size: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all .15s ease;
    }
    .modal-close:hover {
      color: var(--text-heading);
      border-color: var(--card-border-strong);
    }

    .qr-container {
      background: #ffffff;
      border-radius: 16px;
      padding: 12px;
      margin: 16px auto;
      width: 240px;
      height: 240px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }
    .qr-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .qr-amount-box {
      background: var(--card-surface);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 12px 14px;
      margin-bottom: 14px;
    }
    .qr-amount-label {
      font-size: 11px;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: .5px;
    }
    .qr-amount-val {
      font-size: 24px;
      font-weight: 900;
      color: var(--primary-light);
      letter-spacing: -0.5px;
    }
    .qr-unique-badge {
      display: inline-block;
      font-size: 11px;
      background: var(--warning-subtle);
      color: var(--warning);
      border: 1px solid var(--warning-border);
      border-radius: 6px;
      padding: 2px 8px;
      margin-top: 4px;
      font-weight: 600;
    }

    .polling-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 12px;
      color: var(--primary-light);
      margin: 12px 0 16px;
      font-weight: 600;
    }
    .spinner-pulse {
      width: 8px;
      height: 8px;
      background-color: var(--primary-light);
      border-radius: 50%;
      animation: pulse 1.2s infinite ease-in-out;
    }
    @keyframes pulse {
      0%, 100% { transform: scale(0.6); opacity: 0.4; }
      50% { transform: scale(1.3); opacity: 1; }
    }

    .modal-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .footer-note {
      text-align: center;
      font-size: 12px;
      color: var(--text-dim);
      margin-top: 24px;
      line-height: 1.5;
    }
  </style>
</head>
<body>

  <div class="wrapper">

    <!-- TOP BRAND & THEME BAR -->
    <div class="top-bar">
      <div class="brand-group">
        <% if (settings.company_logo) { %>
          <img src="<%= settings.company_logo %>" class="brand-logo" alt="Logo">
        <% } else { %>
          <i class="bi bi-router-fill" style="font-size: 24px; color: var(--primary);"></i>
        <% } %>
        <div class="brand-title"><%= company %></div>
      </div>
      <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" title="Ubah Tema">
        <i class="bi bi-sun-fill" id="themeIcon"></i>
      </button>
    </div>

    <!-- KONDISI 1: PELANGGAN SUDAH LUNAS / TIDAK ADA TUNGGAKAN -->
    <% if (customer && !hasUnpaidInvoices) { %>
      <div class="card-portal" style="text-align: center;">
        <div class="status-badge success"><i class="bi bi-check-circle-fill"></i> Status Aktif</div>
        <h1>Semua Tagihan Sudah Lunas</h1>
        <p class="sub-desc">Tidak ada tagihan tertunggak pada akun Anda. Jika koneksi Anda masih terkendala, klik tombol refresh koneksi berikut:</p>
        
        <div class="cust-info-box" style="text-align: left;">
          <div class="cust-row">
            <span class="label">Nama Akun</span>
            <span class="val"><%= customer.name %></span>
          </div>
          <div class="cust-row">
            <span class="label">No. Telepon / WA</span>
            <span class="val"><%= customer.phone %></span>
          </div>
          <% if (customer.package_name) { %>
            <div class="cust-row">
              <span class="label">Paket Langganan</span>
              <span class="val"><%= customer.package_name %></span>
            </div>
          <% } %>
        </div>

        <form action="/customer/reconnect" method="POST">
          <button type="submit" class="btn btn-primary-action" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
            <i class="bi bi-arrow-repeat"></i> Refresh & Pulihkan Koneksi
          </button>
        </form>

        <a href="/customer/dashboard" class="btn btn-secondary">
          <i class="bi bi-house-door"></i> Masuk ke Portal Pelanggan
        </a>
      </div>

    <!-- KONDISI 2: PELANGGAN MEMILIKI TAGIHAN TERTUNGGAK -->
    <% } else if (customer && hasUnpaidInvoices) { %>
      <div class="card-portal">
        <div class="status-badge warning"><i class="bi bi-pause-circle-fill"></i> Layanan Ditangguhkan</div>
        <h1>Selesaikan Tagihan Internet</h1>
        <p class="sub-desc">Akses internet dialihkan sementara karena masa jatuh tempo terlewati. Selesaikan pembayaran via QRIS agar layanan langsung aktif kembali otomatis.</p>

        <!-- Box Identitas Pelanggan -->
        <div class="cust-info-box">
          <div class="cust-row">
            <span class="label">Nama Pelanggan</span>
            <span class="val"><%= customer.name %></span>
          </div>
          <div class="cust-row">
            <span class="label">ID / PPPoE</span>
            <span class="val"><%= customer.pppoe_username || ('ID:' + customer.id) %></span>
          </div>
          <% if (customer.package_name) { %>
            <div class="cust-row">
              <span class="label">Paket Internet</span>
              <span class="val"><%= customer.package_name %></span>
            </div>
          <% } %>
        </div>

        <!-- Tagihan Card -->
        <% invoices.forEach(inv => { %>
          <div class="invoice-card">
            <div class="inv-header">
              <div class="inv-period">Periode: <%= inv.period_month %> / <%= inv.period_year %></div>
              <div class="inv-id">INV-<%= inv.id %></div>
            </div>
            
            <div class="inv-amount-label">Total Tagihan</div>
            <div class="inv-amount">Rp <%= Number(inv.amount || 0).toLocaleString('id-ID') %></div>

            <!-- Single Primary Call-to-Action -->
            <button type="button" class="btn btn-primary-action" onclick="openQuickQris(<%= inv.id %>, '<%= inv.publicToken %>')">
              <i class="bi bi-qr-code-scan"></i> Bayar Sekarang via QRIS
            </button>
          </div>
        <% }) %>

        <!-- Kepastian Pemulihan Otomatis -->
        <div class="reconnect-notice">
          <i class="bi bi-lightning-charge-fill"></i>
          <div>
            <strong>Aktivasi Otomatis:</strong> Layanan internet Anda akan pulih dalam 1–3 menit setelah pembayaran terverifikasi, tanpa perlu restart modem.
          </div>
        </div>

        <!-- WhatsApp CS Assistance -->
        <% if (adminPhone) { %>
          <a href="https://wa.me/<%= adminPhone.replace(/\D/g, '') %>?text=Halo%20Admin%20<%= encodeURIComponent(company) %>,%20layanan%20saya%20terisolir%20(Nama:%20<%= encodeURIComponent(customer.name) %>).%20Mohon%20bantuannya." class="btn btn-wa-outline" target="_blank" rel="noopener">
            <i class="bi bi-whatsapp"></i> Butuh Bantuan? Hubungi Customer Service
          </a>
        <% } %>

      </div>

    <!-- KONDISI 3: IP TIDAK TERDETEKSI OTOMATIS (FALLBACK SEARCH) -->
    <% } else { %>
      <div class="card-portal">
        <div class="status-badge warning"><i class="bi bi-info-circle-fill"></i> Cek Status Layanan</div>
        <h1>Pemeriksaan Tagihan</h1>
        <p class="sub-desc">Perangkat Anda berada pada jaringan <%= company %>. Masukkan No. WhatsApp atau ID Pelanggan Anda untuk memeriksa rincian tagihan:</p>

        <!-- Form Pencarian Cepat -->
        <div class="search-box">
          <form method="GET" action="/isolated" class="search-form">
            <input type="text" name="q" class="search-input" value="<%= searchQuery || '' %>" placeholder="No. WA atau ID Pelanggan..." required autofocus />
            <button type="submit" class="btn search-btn">
              <i class="bi bi-search"></i> Cek
            </button>
          </form>
          <% if (searchQuery && !customer) { %>
            <div style="font-size: 12.5px; color: var(--danger); margin-top: 10px; font-weight: 500;">
              <i class="bi bi-x-circle me-1"></i> Data untuk "<strong><%= searchQuery %></strong>" tidak ditemukan. Pastikan data sudah benar.
            </div>
          <% } %>
        </div>

        <div style="margin-top: 14px;">
          <a href="/customer/login" class="btn btn-secondary">
            <i class="bi bi-box-arrow-in-right"></i> Masuk ke Portal Pelanggan
          </a>
        </div>

        <% if (adminPhone) { %>
          <a href="https://wa.me/<%= adminPhone.replace(/\D/g, '') %>?text=Halo%20Admin%20<%= encodeURIComponent(company) %>,%20internet%20saya%20terisolir%20tapi%20tagihan%20tidak%20muncul.%20Mohon%20bantuan." class="btn btn-wa-outline" target="_blank" rel="noopener">
            <i class="bi bi-whatsapp"></i> Hubungi Customer Service
          </a>
        <% } %>
      </div>
    <% } %>

    <div class="footer-note">
      Sistem Billing & Jaringan <%= company %><br>
      Akses internet pulih otomatis seketika setelah pembayaran terkonfirmasi.
    </div>

  </div>

  <!-- ============================================================== -->
  <!-- MODAL QUICK QRIS (PREMIUM & CLEAN)                             -->
  <!-- ============================================================== -->
  <div class="modal-overlay" id="qrisModalOverlay">
    <div class="modal-card" id="qrisModalCard">
      <button type="button" class="modal-close" onclick="closeQuickQris()" title="Tutup">&times;</button>

      <!-- Step 1: Loading -->
      <div id="qrisLoadingState" style="padding: 35px 0;">
        <div class="spinner-pulse" style="width: 20px; height: 20px; margin: 0 auto 16px auto;"></div>
        <h3 style="font-size: 16px; color: var(--text-heading); font-weight: 700;">Menyiapkan Pembayaran QRIS...</h3>
        <p style="font-size: 12.5px; color: var(--text-muted); margin-top: 4px;">Menghubungkan ke gateway pembayaran</p>
      </div>

      <!-- Step 2: Content QRIS -->
      <div id="qrisContentState" style="display: none;">
        <div style="display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--primary-light); font-size: 13px; font-weight: 800; text-transform: uppercase;">
          <i class="bi bi-qr-code-scan"></i> <span id="qrisGatewayTitle">PEMBAYARAN QRIS</span>
        </div>
        <div id="qrisInvoicePeriod" style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Tagihan Internet</div>

        <!-- Wadah QR Image -->
        <div class="qr-container">
          <img id="qrisImage" class="qr-image" src="" alt="QRIS Code" />
        </div>

        <!-- Box Nominal -->
        <div class="qr-amount-box">
          <div class="qr-amount-label">Total yang Harus Dibayar</div>
          <div class="qr-amount-val" id="qrisAmountDisplay">Rp 0</div>
          <div id="qrisUniqueBadge" class="qr-unique-badge" style="display:none;">Termasuk Kode Unik Verifikasi</div>
        </div>

        <!-- Indikator Polling Realtime -->
        <div class="polling-indicator">
          <div class="spinner-pulse"></div>
          <span>Menunggu Pembayaran... (Auto-Check)</span>
        </div>

        <!-- Action Buttons -->
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" style="margin-top:0;" onclick="copyAmount()" id="copyAmountBtn">
            <i class="bi bi-clipboard-check"></i> Salin Nominal
          </button>
          <button type="button" class="btn btn-secondary" style="margin-top:0;" onclick="downloadQrImage()">
            <i class="bi bi-download"></i> Simpan Gambar
          </button>
        </div>

        <!-- Checkout Url Button (Jika ada) -->
        <div id="qrisExternalCheckout" style="margin-top: 10px; display: none;">
          <a id="qrisCheckoutLink" href="#" target="_blank" class="btn btn-secondary">
            <i class="bi bi-box-arrow-up-right"></i> Buka Halaman Gateway
          </a>
        </div>

        <div id="qrisHelpText" style="font-size: 11.5px; color: var(--text-dim); margin-top: 14px; line-height: 1.45;">
          Buka aplikasi m-Banking atau E-Wallet (BCA, Mandiri, BRI, DANA, GoPay, OVO, ShopeePay), pilih Scan QRIS, lalu bayar sesuai nominal di atas.
        </div>
      </div>

      <!-- Step 3: Success State -->
      <div id="qrisSuccessState" style="display: none; padding: 25px 0;">
        <i class="bi bi-check-circle-fill" style="font-size: 56px; color: var(--success); margin-bottom: 12px; display: inline-block;"></i>
        <h2 style="font-size: 20px; color: var(--text-heading); font-weight: 800; margin-bottom: 6px;">Pembayaran Berhasil!</h2>
        <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.5; margin-bottom: 20px;">
          Terima kasih! Pembayaran Anda telah kami terima.<br>
          <strong style="color: var(--primary-light);">Layanan internet Anda sedang diaktifkan kembali...</strong>
        </p>
        <div class="spinner-pulse" style="margin: 0 auto;"></div>
      </div>

    </div>
  </div>

  <script>
    let currentInvoiceId = null;
    let currentPublicToken = null;
    let pollInterval = null;
    let currentAmountNumber = 0;

    // Theme Switcher Logic
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('customer-theme', next);
        localStorage.setItem('app-theme', next);
      } catch (e) {}
      updateThemeIcon(next);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      if (icon) {
        icon.className = theme === 'light' ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';
        icon.style.color = theme === 'light' ? '#6366f1' : '#f59e0b';
      }
    }

    // Init theme icon on load
    document.addEventListener('DOMContentLoaded', () => {
      const cur = document.documentElement.getAttribute('data-theme') || 'dark';
      updateThemeIcon(cur);
    });

    // Buka Modal QRIS Cepat
    function openQuickQris(invoiceId, token) {
      currentInvoiceId = invoiceId;
      currentPublicToken = token;

      const overlay = document.getElementById('qrisModalOverlay');
      const loadingState = document.getElementById('qrisLoadingState');
      const contentState = document.getElementById('qrisContentState');
      const successState = document.getElementById('qrisSuccessState');

      overlay.classList.add('active');
      loadingState.style.display = 'block';
      contentState.style.display = 'none';
      successState.style.display = 'none';

      fetch(`/isolated/quick-qris/${invoiceId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      })
      .then(res => res.json())
      .then(data => {
        if (!data.success) {
          alert(data.message || 'Gagal menyiapkan pembayaran QRIS.');
          closeQuickQris();
          return;
        }

        if (data.paid) {
          showSuccessState();
          return;
        }

        loadingState.style.display = 'none';
        contentState.style.display = 'block';

        document.getElementById('qrisGatewayTitle').innerText = data.gatewayName || 'PEMBAYARAN QRIS';
        document.getElementById('qrisInvoicePeriod').innerText = `INV-${data.invoiceId} • Periode: ${data.periodText || ''}`;
        
        const qrImg = document.getElementById('qrisImage');
        qrImg.src = data.qrDataUrl || '';

        currentAmountNumber = data.amount;
        document.getElementById('qrisAmountDisplay').innerText = `Rp ${Number(data.amount).toLocaleString('id-ID')}`;

        const uniqueBadge = document.getElementById('qrisUniqueBadge');
        if (data.uniqueCode && data.uniqueCode > 0) {
          uniqueBadge.style.display = 'inline-block';
          uniqueBadge.innerText = `Termasuk Kode Unik: +${data.uniqueCode}`;
        } else {
          uniqueBadge.style.display = 'none';
        }

        if (data.helpText) {
          document.getElementById('qrisHelpText').innerText = data.helpText;
        }

        const checkoutBox = document.getElementById('qrisExternalCheckout');
        const checkoutLink = document.getElementById('qrisCheckoutLink');
        if (data.checkoutUrl) {
          checkoutBox.style.display = 'block';
          checkoutLink.href = data.checkoutUrl;
        } else {
          checkoutBox.style.display = 'none';
        }

        startPollingPayment(invoiceId, token);
      })
      .catch(err => {
        alert('Terjadi kesalahan saat memuat QRIS: ' + err.message);
        closeQuickQris();
      });
    }

    function closeQuickQris() {
      document.getElementById('qrisModalOverlay').classList.remove('active');
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
    }

    function startPollingPayment(invoiceId, token) {
      if (pollInterval) clearInterval(pollInterval);

      pollInterval = setInterval(() => {
        fetch(`/customer/payment/status/${invoiceId}?t=${encodeURIComponent(token)}`)
          .then(res => res.json())
          .then(data => {
            if (data.success && (data.status === 'paid' || data.paid_at)) {
              clearInterval(pollInterval);
              pollInterval = null;
              showSuccessState();
            }
          })
          .catch(() => {});
      }, 3000);
    }

    function showSuccessState() {
      document.getElementById('qrisLoadingState').style.display = 'none';
      document.getElementById('qrisContentState').style.display = 'none';
      document.getElementById('qrisSuccessState').style.display = 'block';

      setTimeout(() => {
        window.location.reload();
      }, 2500);
    }

    function downloadQrImage() {
      const img = document.getElementById('qrisImage');
      if (!img || !img.src) return;

      const link = document.createElement('a');
      link.href = img.src;
      link.download = `QRIS-Tagihan-${currentInvoiceId}.png`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function copyAmount() {
      if (!currentAmountNumber) return;
      const btn = document.getElementById('copyAmountBtn');
      const origHtml = btn ? btn.innerHTML : '';
      
      const copyFn = () => {
        if (btn) {
          btn.innerHTML = '<i class="bi bi-check2"></i> Tersalin!';
          setTimeout(() => { btn.innerHTML = origHtml; }, 2000);
        }
      };

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(String(currentAmountNumber)).then(copyFn).catch(() => {});
      } else {
        const ta = document.createElement('textarea');
        ta.value = String(currentAmountNumber);
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        copyFn();
      }
    }
  </script>

</body>
</html>

