  function getRouterId() {
    const v = document.getElementById('global-router-id')?.value;
    return v ? encodeURIComponent(v) : '';
  }

  function changeRouter() {
    const rId = document.getElementById('global-router-id')?.value;
    window.location.href = '/admin/set-active-router?router_id=' + (rId || 'all');
  }

  function parseMikhmonOnLogin(script) {
    if (!script) return null;
    const s = String(script).trim();
    
    // Cari pattern :put (",rem, ... , ... , ...
    const putMatch = s.match(/:\s*put\s*\(\s*[",]rem[",]?\s*,\s*([^,]+)\s*,\s*([^,]+)\s*,\s*([^,]+)/i);
    if (putMatch) {
      const cost = String(putMatch[1] || '').trim();
      const validity = String(putMatch[2] || '').trim();
      const priceStr = String(putMatch[3] || '').trim();
      const price = Number(priceStr.replace(/[^\d]/g, '')) || 0;
      
      if (validity && price > 0) {
        return { validity, price, cost: Number(cost.replace(/[^\d]/g, '')) || 0 };
      }
    }
    
    // Fallback: split by comma
    const parts = s.split(',').map(p => String(p).trim());
    let remIdx = -1;
    for (let i = 0; i < parts.length; i++) {
      if (parts[i].includes('rem')) {
        remIdx = i;
        break;
      }
    }
    
    if (remIdx >= 0 && remIdx + 3 < parts.length) {
      const cost = String(parts[remIdx + 1] || '').trim();
      const validity = String(parts[remIdx + 2] || '').trim();
      const priceStr = String(parts[remIdx + 3] || '').trim();
      const price = Number(priceStr.replace(/[^\d]/g, '')) || 0;
      
      if (validity && price > 0) {
        return { validity, price, cost: Number(cost.replace(/[^\d]/g, '')) || 0 };
      }
    }
    
    return null;
  }

  let profilesCache = [];
  let currentBatchVouchers = [];
  let currentWaTarget = { phone: '', text: '' };

  function escapeHtml(str) {
    return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function copyText(text) {
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      alert('Teks disalin ke clipboard!');
    }).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      alert('Teks disalin ke clipboard!');
    });
  }

  async function loadProfiles() {
    const routerId = getRouterId();
    const url = routerId ? `/admin/api/mikrotik/hotspot-user-profiles?routerId=${routerId}` : `/admin/api/mikrotik/hotspot-user-profiles`;
    try {
      const res = await fetch(url);
      const data = await res.json();
      profilesCache = Array.isArray(data) ? data : [];

      const sel = document.getElementById('profileName');
      const singleSel = document.getElementById('singleProfileName');
      sel.innerHTML = '';
      if (singleSel) singleSel.innerHTML = '';

      if (profilesCache.length === 0) {
        sel.innerHTML = '<option value="">Tidak ada profile di router ini</option>';
        if (singleSel) singleSel.innerHTML = '<option value="">Tidak ada profile</option>';
        document.getElementById('profileHint').innerText = '';
        return;
      }

      sel.insertAdjacentHTML('beforeend', '<option value="">-- Pilih Profile --</option>');
      if (singleSel) singleSel.insertAdjacentHTML('beforeend', '<option value="">-- Pilih Profile --</option>');

      for (const p of profilesCache) {
        const meta = parseMikhmonOnLogin(p.onLogin || p['on-login']);
        let label = p.name;
        if (meta && meta.validity) {
          label += ` (Rp ${Number(meta.price || 0).toLocaleString('id-ID')} • ${meta.validity})`;
        } else {
          label += ` (Manual / Tanpa Format Mikhmon)`;
        }
        sel.insertAdjacentHTML('beforeend', `<option value="${p.name}">${label}</option>`);
        if (singleSel) singleSel.insertAdjacentHTML('beforeend', `<option value="${p.name}">${label}</option>`);
      }
      document.getElementById('profileHint').innerText = '';
    } catch (e) {
      console.error('Failed to load profiles:', e);
    }
  }

  (function initPrintStyle() {
    const ps = document.getElementById('print_style');
    if (!ps) return;
    const current = String(ps.value || 'cards');
    ps.value = current || 'cards';
  })();

  function onProfileChanged() {
    const name = document.getElementById('profileName')?.value;
    const raw = profilesCache.find(p => p.name === name);
    const hintEl = document.getElementById('profileHint');
    const priceEl = document.getElementById('price');
    const valEl = document.getElementById('validityCustom');
    if (!raw) {
      hintEl.innerHTML = '';
      return;
    }
    const meta = parseMikhmonOnLogin(raw.onLogin || raw['on-login']);
    if (meta) {
      hintEl.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i> ${I18N.profilePricePrefix} Rp ${Number(meta.price||0).toLocaleString('id-ID')} • ${I18N.profileDurationPrefix} ${meta.validity}</span>`;
      if (priceEl && (priceEl.value === '' || Number(priceEl.value) === 0)) {
        priceEl.value = Number(meta.price || 0) ? String(Number(meta.price || 0)) : '';
      }
      if (valEl && !valEl.value) valEl.value = meta.validity;
    } else {
      hintEl.innerHTML = `
        <span class="text-warning small"><i class="bi bi-exclamation-circle me-1"></i> Belum ada format Mikhmon di profile ini.</span>
        <button type="button" class="btn btn-g btn-sm py-0 px-2 ms-2" style="font-size:11px;" onclick="injectMikhmon('${name}')"><i class="bi bi-magic"></i> Pasang Format Mikhmon</button>
      `;
    }
  }

  function onSingleProfileChanged() {
    const name = document.getElementById('singleProfileName')?.value;
    const raw = profilesCache.find(p => p.name === name);
    const hintEl = document.getElementById('singleProfileHint');
    const priceEl = document.getElementById('singlePrice');
    const valEl = document.getElementById('singleValidity');
    if (!raw) {
      hintEl.innerHTML = '';
      return;
    }
    const meta = parseMikhmonOnLogin(raw.onLogin || raw['on-login']);
    if (meta) {
      hintEl.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i> Rp ${Number(meta.price||0).toLocaleString('id-ID')} • ${meta.validity}</span>`;
      if (priceEl) priceEl.value = meta.price || '';
      if (valEl) valEl.value = meta.validity || '';
    } else {
      hintEl.innerHTML = `<span class="text-warning small">Masukkan harga dan masa aktif manual</span>`;
    }
  }

  async function injectMikhmon(profileName) {
    const price = prompt('Masukkan harga voucher untuk profile ini (contoh: 3000):', '3000');
    if (price === null) return;
    const validity = prompt('Masukkan masa aktif (contoh: 3h, 1d, 7d):', '1d');
    if (!validity) return;

    const routerId = getRouterId();
    try {
      const res = await fetch('/admin/api/mikrotik/hotspot-user-profiles/inject-mikhmon?routerId=' + routerId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ profile: profileName, price, validity })
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Gagal inject');
      alert('✅ ' + data.message);
      await loadProfiles();
      document.getElementById('profileName').value = profileName;
      onProfileChanged();
    } catch (e) {
      alert('❌ ' + e.message);
    }
  }

  function onModeChanged() {
    const mode = document.getElementById('mode')?.value;
    const hint = document.getElementById('modeHint');
    if (mode === 'voucher') {
      hint.innerText = I18N.modeVoucherHint;
    } else {
      hint.innerText = I18N.modeMemberHint;
    }
  }

  async function createBatch() {
    const profile = document.getElementById('profileName')?.value;
    const qty = Number(document.getElementById('qty')?.value || 0);
    const codeLength = Number(document.getElementById('codeLength')?.value || 6);
    const prefix = String(document.getElementById('prefix')?.value || '').trim();
    const mode = document.getElementById('mode')?.value || 'voucher';
    const charset = document.getElementById('charset')?.value || 'numbers';
    const price = document.getElementById('price')?.value;
    const validity = document.getElementById('validityCustom')?.value;

    if (!profile) return alert(I18N.chooseProfileFirst);
    if (!qty || qty < 1) return alert(I18N.invalidQty);

    const routerId = getRouterId();
    const url = routerId ? `/admin/api/vouchers/batches?routerId=${routerId}` : `/admin/api/vouchers/batches`;
    const btn = document.getElementById('btnCreate');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> ' + I18N.processing;
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ profile, qty, codeLength, prefix, mode, charset, price, validity })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || I18N.createFailed);
      await reloadBatches();
      alert(`${I18N.batchCreatedPrefix} #${data.batchId} ${I18N.batchCreatedSuffix}`);
    } catch (e) {
      alert(e.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-magic"></i> ' + I18N.createBtn;
    }
  }

  async function createSingleVoucher() {
    const profile = document.getElementById('singleProfileName')?.value;
    const price = document.getElementById('singlePrice')?.value;
    const validity = document.getElementById('singleValidity')?.value;
    const mode = document.getElementById('singleMode')?.value || 'voucher';
    const buyerPhone = document.getElementById('singleBuyerPhone')?.value;
    const routerId = getRouterId();

    if (!profile) return alert('Pilih profile hotspot terlebih dahulu.');

    const btn = document.getElementById('btnSubmitSingle');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Membuat...';

    try {
      const res = await fetch('/admin/api/vouchers/single', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ routerId, profile, price, validity, mode, buyerPhone })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Gagal membuat voucher');

      closeModal('singleVoucherModal');
      await reloadBatches();

      // Setup result modal
      document.getElementById('resProfileName').innerText = data.voucher.profile;
      document.getElementById('resVoucherCode').innerText = data.voucher.code;
      document.getElementById('resVoucherPass').innerText = (data.voucher.code !== data.voucher.password) 
        ? ('Password: ' + data.voucher.password) 
        : 'Password sama dengan kode voucher';
      document.getElementById('resVoucherPrice').innerText = 'Rp ' + Number(data.voucher.price || 0).toLocaleString('id-ID');
      document.getElementById('resVoucherValidity').innerText = 'Durasi: ' + (data.voucher.validity || '-');
      document.getElementById('resWaText').value = data.waText || '';

      currentWaTarget = {
        phone: data.buyerPhone || '',
        text: data.waText || ''
      };

      openModal('singleVoucherResultModal');
    } catch (e) {
      alert(e.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Buat Sekarang';
    }
  }

  function copyResultWaText() {
    const t = document.getElementById('resWaText')?.value;
    copyText(t);
  }

  function sendResultToWa() {
    if (currentWaTarget.phone) {
      openSendWaModalWithValues(currentWaTarget.phone, currentWaTarget.text);
    } else {
      const p = prompt('Masukkan nomor WhatsApp pembeli (contoh: 08123456789):');
      if (!p) return;
      openSendWaModalWithValues(p, currentWaTarget.text);
    }
  }

  function openSendWaModalWithValues(phone, text) {
    document.getElementById('sendWaPhone').value = phone || '';
    document.getElementById('sendWaText').value = text || '';
    openModal('sendWaModal');
  }

  function openSendWaModal(code, pass, profile, price, validity) {
    const phone = prompt('Masukkan nomor WhatsApp tujuan (contoh: 08123456789):');
    if (!phone) return;
    const text = `*VOUCHER HOTSPOT*\n` +
      `━━━━━━━━━━━━━━━━━━━━\n` +
      `🎫 *Kode Voucher :* ${code}\n` +
      (code !== pass ? `🔑 *Password :* ${pass}\n` : '') +
      `📦 *Paket :* ${profile}\n` +
      (validity ? `⏳ *Durasi :* ${validity}\n` : '') +
      (price ? `💰 *Harga :* Rp ${Number(price).toLocaleString('id-ID')}\n` : '') +
      `━━━━━━━━━━━━━━━━━━━━\n` +
      `*Cara Menggunakan:*\n` +
      `1. Hubungkan Wi-Fi ke hotspot\n` +
      `2. Buka browser atau klik pop-up login\n` +
      `3. Masukkan Kode Voucher di atas\n` +
      `4. Selamat menikmati akses internet!`;

    openSendWaModalWithValues(phone, text);
  }

  async function submitSendWa() {
    const phone = document.getElementById('sendWaPhone')?.value.trim();
    const text = document.getElementById('sendWaText')?.value.trim();
    if (!phone) return alert('Nomor WhatsApp wajib diisi');
    if (!text) return alert('Pesan tidak boleh kosong');

    const btn = document.getElementById('btnSendWaSubmit');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Mengirim...';

    try {
      const res = await fetch('/admin/api/vouchers/send-wa', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, text })
      });
      const data = await res.json();
      if (data.sent) {
        alert('✅ Pesan WhatsApp berhasil dikirim via bot!');
        closeModal('sendWaModal');
      } else {
        const direct = confirm('⚠️ Bot WhatsApp tidak aktif / pesan gagal terkirim (' + (data.error || 'Offline') + ').\n\nApakah Anda ingin membuka link wa.me langsung di browser/aplikasi WA?');
        if (direct && data.waDirectUrl) {
          window.open(data.waDirectUrl, '_blank');
          closeModal('sendWaModal');
        }
      }
    } catch (e) {
      alert('Error: ' + e.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Kirim via Bot WA';
    }
  }

  function openWaDirectWeb() {
    const phone = document.getElementById('sendWaPhone')?.value.trim();
    const text = document.getElementById('sendWaText')?.value.trim();
    if (!phone) return alert('Nomor WhatsApp wajib diisi');
    const clean = phone.replace(/^\+/, '').replace(/^0/, '62');
    window.open(`https://wa.me/${clean}?text=${encodeURIComponent(text)}`, '_blank');
  }

  async function searchGlobalVoucher() {
    const q = document.getElementById('voucherGlobalSearch')?.value.trim();
    if (!q) return;
    const box = document.getElementById('searchResultsBox');
    const list = document.getElementById('searchResultsList');
    box.style.display = 'block';
    list.innerHTML = '<tr><td colspan="8" class="text-center text-muted"><i class="bi bi-arrow-repeat spin"></i> Mencari voucher...</td></tr>';
    try {
      const res = await fetch('/admin/api/vouchers/search?q=' + encodeURIComponent(q));
      const data = await res.json();
      const items = data.vouchers || [];
      if (items.length === 0) {
        list.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Tidak ditemukan voucher dengan kata kunci: <b>' + escapeHtml(q) + '</b></td></tr>';
        return;
      }
      document.getElementById('searchResultsTitle').innerHTML = `<i class="bi bi-check-circle me-1 text-success"></i> Ditemukan ${items.length} Voucher untuk kata kunci: <b>${escapeHtml(q)}</b>`;
      list.innerHTML = items.map(v => {
        const st = String(v.status || '-');
        const stClass = st === 'used' ? 's' : (st === 'created' ? 'w' : (st === 'missing' ? 'd' : 'w'));
        const usedAt = v.used_at ? new Date(v.used_at).toLocaleString('id-ID') : '-';
        const routerName = v.router_name || 'Default';
        const price = v.price ? 'Rp ' + Number(v.price).toLocaleString('id-ID') : '-';
        return `
          <tr>
            <td class="mono fw-bold text-white">${v.code}</td>
            <td class="mono">${v.password}</td>
            <td>${routerName}</td>
            <td>${v.profile_name}</td>
            <td>${price}</td>
            <td><span class="badge ${stClass}">${st}</span></td>
            <td>${usedAt}</td>
            <td>
              <button class="btn btn-g btn-sm py-0 px-2" style="font-size:11px;" onclick="copyText('Kode: ${v.code} Pass: ${v.password}')" title="Copy"><i class="bi bi-copy"></i></button>
              <button class="btn btn-s btn-sm py-0 px-2" style="font-size:11px;" onclick="openSendWaModal('${v.code}', '${v.password}', '${v.profile_name}', '${v.price}', '${v.validity}')" title="Kirim WA"><i class="bi bi-whatsapp"></i></button>
            </td>
          </tr>
        `;
      }).join('');
    } catch (e) {
      list.innerHTML = `<tr><td colspan="8" class="text-danger text-center py-4">Gagal mencari: ${e.message}</td></tr>`;
    }
  }

  async function reloadBatches() {
    const routerId = getRouterId();
    const url = routerId ? `/admin/api/vouchers/batches?routerId=${routerId}` : `/admin/api/vouchers/batches`;
    const res = await fetch(url);
    const batches = await res.json();
    const list = document.getElementById('batches-list');
    if (!Array.isArray(batches) || batches.length === 0) {
      list.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">' + I18N.noBatches + '</td></tr>';
      updateStats([]);
      return;
    }
    list.innerHTML = batches.map(b => {
      const status = String(b.status || '-');
      const stClass = status === 'ready' ? 's' : (status === 'failed' ? 'd' : (status === 'partial' ? 'w' : 'w'));
      const created = b.created_at ? new Date(b.created_at).toLocaleString('id-ID') : '-';
      const qty = `${b.qty_created || 0}/${b.qty_total || 0}`;
      const used = `${b.used_count || 0}/${b.vouchers_count || 0}`;
      const routerName = b.router_name || I18N.defaultRouterName;
      const selectedStyle = String(document.getElementById('print_style')?.value || 'cards');
      const printHref = selectedStyle === 'cards'
        ? `/admin/vouchers/batches/${b.id}/print`
        : `/admin/vouchers/batches/${b.id}/print?style=${encodeURIComponent(selectedStyle)}`;
      return `
        <tr>
          <td class="mono fw-bold">#${b.id}</td>
          <td><span class="badge" style="background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.3);">${routerName}</span></td>
          <td class="fw-bold">${b.profile_name || '-'}</td>
          <td>${qty}</td>
          <td><span class="text-success fw-bold">${used}</span></td>
          <td><span class="badge ${stClass}">${status}</span></td>
          <td class="small text-muted">${created}</td>
          <td>
            <div style="display:flex;gap:4px;align-items:center;flex-wrap:wrap">
              <button class="btn btn-g btn-sm py-1 px-2" onclick="openDetail(${b.id})" title="Lihat Detail & Daftar Kode"><i class="bi bi-eye"></i> Detail</button>
              <a class="btn btn-p btn-sm py-1 px-2" target="_blank" href="${printHref}" title="Cetak Voucher"><i class="bi bi-printer"></i> Print</a>
              <button class="btn btn-g btn-sm py-1 px-2" onclick="syncBatch(${b.id})" title="Sinkron Status MikroTik"><i class="bi bi-arrow-repeat"></i></button>
              <a class="btn btn-g btn-sm py-1 px-2" href="/admin/vouchers/batches/${b.id}/export.csv" title="Download File CSV"><i class="bi bi-filetype-csv"></i></a>
              <button class="btn btn-d btn-sm py-1 px-2" onclick="deleteBatch(${b.id}, '${status}')" title="Hapus Batch"><i class="bi bi-trash"></i></button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
    updateStats(batches);
  }

  async function saveVoucherTemplate() {
    const use_template = document.getElementById('tpl_use')?.value === '1';
    const default_style = document.getElementById('tpl_default_style')?.value || '';
    const header = document.getElementById('tpl_header')?.value || '';
    const row = document.getElementById('tpl_row')?.value || '';
    const footer = document.getElementById('tpl_footer')?.value || '';
    try {
      const res = await fetch('/admin/api/vouchers/template', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ use_template, default_style, header, row, footer })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || I18N.templateSaveFailed);
      alert(I18N.templateSaved);
      closeModal('voucherTemplateModal');
      const ps = document.getElementById('print_style');
      if (ps) ps.value = default_style || 'cards';
      await reloadBatches();
    } catch (e) {
      alert(e.message);
    }
  }

  function onPrintStyleChanged() {
    reloadBatches();
  }

  function updateStats(batches) {
    const totalBatches = batches.length;
    const totalV = batches.reduce((a, b) => a + (Number(b.vouchers_count || 0)), 0);
    const used = batches.reduce((a, b) => a + (Number(b.used_count || 0)), 0);
    const unused = Math.max(0, totalV - used);

    const revenue = batches.reduce((sum, b) => sum + ((Number(b.used_count || 0)) * (Number(b.price || 0))), 0);
    const stockVal = batches.reduce((sum, b) => {
      const unusedCount = Math.max(0, (Number(b.vouchers_count || 0)) - (Number(b.used_count || 0)));
      return sum + (unusedCount * (Number(b.price || 0)));
    }, 0);

    document.getElementById('stat-batches').innerText = totalBatches;
    document.getElementById('stat-vouchers').innerText = totalV;
    document.getElementById('stat-used').innerText = used;
    const usedSub = document.getElementById('stat-used-sub');
    if (usedSub) usedSub.innerText = 'Omset: Rp ' + revenue.toLocaleString('id-ID');

    document.getElementById('stat-unused').innerText = unused;
    const unusedSub = document.getElementById('stat-unused-sub');
    if (unusedSub) unusedSub.innerText = 'Stok: Rp ' + stockVal.toLocaleString('id-ID');
  }

  async function openDetail(id) {
    const routerId = getRouterId();
    const url = routerId ? `/admin/api/vouchers/batches/${id}?routerId=${routerId}` : `/admin/api/vouchers/batches/${id}`;
    const res = await fetch(url);
    const data = await res.json();
    if (!res.ok) return alert(data.error || I18N.detailLoadFailed);
    document.getElementById('batchDetailTitle').innerText = `${I18N.detailTitlePrefix} #${data.batch.id}`;
    const meta = document.getElementById('batchDetailMeta');
    meta.innerHTML = '';
    meta.insertAdjacentHTML('beforeend', `<span class="pill"><i class="bi bi-hdd-network"></i> <b>${data.batch.router_name || I18N.defaultRouterName}</b></span>`);
    meta.insertAdjacentHTML('beforeend', `<span class="pill"><i class="bi bi-ticket"></i> <b>${data.batch.profile_name}</b></span>`);
    meta.insertAdjacentHTML('beforeend', `<span class="pill"><i class="bi bi-clock"></i> <b>${data.batch.validity || '-'}</b></span>`);
    meta.insertAdjacentHTML('beforeend', `<span class="pill"><i class="bi bi-cash-coin"></i> <b>Rp ${Number(data.batch.price||0).toLocaleString('id-ID')}</b></span>`);
    meta.insertAdjacentHTML('beforeend', `<span class="pill"><i class="bi bi-collection"></i> <b>${data.batch.qty_created || 0}/${data.batch.qty_total || 0}</b></span>`);

    currentBatchVouchers = Array.isArray(data.vouchers) ? data.vouchers.map(v => ({
      ...v,
      profile_name: data.batch.profile_name,
      price: data.batch.price,
      validity: data.batch.validity
    })) : [];

    const filterInput = document.getElementById('batchFilterInput');
    if (filterInput) filterInput.value = '';

    renderBatchVouchersList(currentBatchVouchers);
    openModal('batchDetailModal');
  }

  function filterBatchDetail(q) {
    const term = String(q || '').toLowerCase().trim();
    const filtered = term 
      ? currentBatchVouchers.filter(v => String(v.code).toLowerCase().includes(term) || String(v.password).toLowerCase().includes(term) || String(v.status).toLowerCase().includes(term))
      : currentBatchVouchers;
    renderBatchVouchersList(filtered);
  }

  function renderBatchVouchersList(items) {
    const list = document.getElementById('batchDetailList');
    if (!items || items.length === 0) {
      list.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">' + I18N.noVouchers + '</td></tr>';
      return;
    }
    list.innerHTML = items.map(v => {
      const st = String(v.status || '-');
      const usedAt = v.used_at ? new Date(v.used_at).toLocaleString('id-ID') : '-';
      const seenAt = v.last_seen_at ? new Date(v.last_seen_at).toLocaleString('id-ID') : '-';
      const seen = (v.last_seen_uptime || v.last_seen_comment) ? `${(v.last_seen_uptime || '-')}${v.last_seen_comment ? ' • ' + v.last_seen_comment : ''}` : '-';
      const stClass = st === 'used' ? 's' : (st === 'created' ? 'w' : (st === 'missing' ? 'd' : 'w'));
      return `
        <tr>
          <td class="mono fw-bold text-white">${v.code}</td>
          <td class="mono">${v.password}</td>
          <td><span class="badge ${stClass}">${st}</span></td>
          <td>${usedAt}</td>
          <td><div class="hint">${seenAt}</div><div class="hint">${seen}</div></td>
          <td>
            <div style="display:flex;gap:4px">
              <button class="btn btn-g btn-sm py-0 px-2" style="font-size:11px;" onclick="copyText('Kode: ${v.code} Pass: ${v.password}')" title="Copy"><i class="bi bi-copy"></i></button>
              <button class="btn btn-s btn-sm py-0 px-2" style="font-size:11px;" onclick="openSendWaModal('${v.code}', '${v.password}', '${v.profile_name}', '${v.price}', '${v.validity}')" title="Kirim WA"><i class="bi bi-whatsapp"></i></button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  async function syncBatch(id) {
    const routerId = getRouterId();
    const url = routerId ? `/admin/api/vouchers/batches/${id}/sync?routerId=${routerId}` : `/admin/api/vouchers/batches/${id}/sync`;
    try {
      const res = await fetch(url, { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || I18N.syncFailed);
      await reloadBatches();
      alert(`${I18N.syncDonePrefix} ${data.usedNew || 0}, ${I18N.syncDoneMiddle} ${data.missing || 0}`);
    } catch (e) {
      alert(e.message);
    }
  }

  async function deleteBatch(id, status) {
    if (String(status) === 'creating') {
      return alert(I18N.deleteCreatingWarn);
    }
    const ok = confirm(
      `${I18N.deleteConfirmPrefix} #${id}?\n\n` +
      `${I18N.deleteConfirmLine1}\n` +
      `${I18N.deleteConfirmLine2}\n\n` +
      `${I18N.deleteConfirmContinue}`
    );
    if (!ok) return;
    const routerId = getRouterId();
    const url = routerId ? `/admin/api/vouchers/batches/${id}/delete?routerId=${routerId}` : `/admin/api/vouchers/batches/${id}/delete`;
    try {
      const res = await fetch(url, { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || I18N.deleteFailed);
      await reloadBatches();
      alert(`${I18N.deleteSuccessPrefix} #${id} ${I18N.deleteSuccessSuffix} ${I18N.deletedVouchersPrefix} ${data.deletedVouchers || 0}. ${I18N.usedPrefix} ${data.usedCount || 0}.`);
    } catch (e) {
      alert(e.message);
    }
  }

  async function reloadAll() {
    await loadProfiles();
    await reloadBatches();
  }

  reloadAll();
  setInterval(() => reloadBatches(), 12000);
</script>
</body>
</html>
