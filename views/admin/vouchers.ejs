<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.voucher_hotspot', 'Voucher Hotspot') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.6">
  <style>
    .kv { display:flex; gap:14px; flex-wrap:wrap; align-items:flex-end; }
    .kv .fg { margin:0; min-width: 180px; flex: 1; }
    .kv .fg.w120 { min-width: 120px; flex: 0 0 120px; }
    .kv .fg.w160 { min-width: 160px; flex: 0 0 160px; }
    .hint { font-size: 12px; color: var(--muted); }
    .pill { display:inline-flex; align-items:center; gap:6px; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border); font-size: 12px; color: var(--muted); }
    .pill b { color: var(--text); font-weight: 700; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace; }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'mikrotik', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-ticket-perforated"></i> <%= t('admin.nav.voucher_hotspot', 'Voucher Hotspot') %></div>
    <div class="tb-right" style="display:flex;align-items:center;gap:15px">
      <div class="router-selector" style="display:flex;align-items:center;gap:8px;padding:4px 10px;border-radius:10px;">
        <i class="bi bi-hdd-network small" style="color:#60a5fa;"></i>
        <select id="global-router-id" class="fs" style="padding:4px 8px;font-size:13px;border-radius:6px;cursor:pointer;" onchange="changeRouter()">
          <option value="" <%= (!selectedRouterId) ? 'selected' : '' %>><%= t('admin.vouchers.default_router', '-- Default / Semua Router --') %></option>
          <% routers.forEach(r => { %>
            <option value="<%= r.id %>" <%= (String(selectedRouterId || '') === String(r.id)) ? 'selected' : '' %>><%= r.name %></option>
          <% }) %>
        </select>
      </div>
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">
    <% const mTab = 'vouchers'; %>
    <% if (msg) { %>
      <div class="alert <%= msg.type === 'success' ? 's' : (msg.type === 'error' ? 'd' : 'w') %>"><%= msg.text %></div>
    <% } %>

    <div class="mtabs" style="margin-bottom:20px;">
      <a href="/admin/mikrotik" class="mtab"><i class="bi bi-router"></i> Monitoring &amp; Sesi</a>
      <a href="/admin/routers" class="mtab"><i class="bi bi-hdd-network"></i> Manajemen Router</a>
      <a href="/admin/vouchers" class="mtab active"><i class="bi bi-ticket-perforated"></i> Voucher Hotspot</a>
      <a href="/admin/vouchers/packages" class="mtab"><i class="bi bi-wifi"></i> Paket Hotspot</a>
    </div>

    <!-- Quick Search & Actions Toolbar -->
    <div class="card mb-3" style="background:var(--bg2); border:1px solid var(--border); padding:16px 20px; border-radius:14px; box-shadow:0 4px 16px rgba(0,0,0,0.04);">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;align-items:center;gap:10px;flex:1;min-width:280px;max-width:550px;">
          <div style="position:relative;width:100%;">
            <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);"></i>
            <input type="text" id="voucherGlobalSearch" class="fc" style="padding-left:36px;border-radius:8px;" placeholder="Cari Kode Voucher, User, atau Profil..." onkeydown="if(event.key==='Enter') searchGlobalVoucher()">
          </div>
          <button class="btn btn-p btn-sm" onclick="searchGlobalVoucher()"><i class="bi bi-search me-1"></i> Cari</button>
        </div>
        <div style="display:flex;gap:10px;align-items:center;">
          <button class="btn btn-s btn-sm" onclick="openModal('singleVoucherModal')"><i class="bi bi-ticket-fill me-1"></i> Buat 1 Voucher Satuan</button>
        </div>
      </div>
      <div id="searchResultsBox" style="display:none;margin-top:14px;border-top:1px solid var(--border);padding-top:14px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <span class="small fw-bold text-primary" id="searchResultsTitle"><i class="bi bi-list-check me-1"></i> Hasil Pencarian</span>
          <button class="btn btn-g btn-sm py-0 px-2" style="font-size:11px" onclick="document.getElementById('searchResultsBox').style.display='none'">Tutup Hasil</button>
        </div>
        <div class="tbl-wrap" style="max-height:280px;overflow-y:auto;">
          <table class="dtbl">
            <thead>
              <tr><th>Kode</th><th>Password</th><th>Router</th><th>Profile</th><th>Harga</th><th>Status</th><th>Terpakai</th><th style="width:110px">Aksi</th></tr>
            </thead>
            <tbody id="searchResultsList"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="stat-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:20px">
      <div class="sc p">
        <i class="bi bi-collection sc-icon"></i>
        <div class="sc-label"><%= t('admin.vouchers.stats.batches', 'Batch') %></div>
        <div class="sc-val" id="stat-batches">0</div>
        <div class="hint" style="font-size:11px;margin-top:2px;">Total Batch Dibuat</div>
      </div>
      <div class="sc s">
        <i class="bi bi-ticket sc-icon"></i>
        <div class="sc-label"><%= t('admin.vouchers.stats.vouchers', 'Voucher') %></div>
        <div class="sc-val" id="stat-vouchers">0</div>
        <div class="hint" style="font-size:11px;margin-top:2px;">Total Unit Voucher</div>
      </div>
      <div class="sc w">
        <i class="bi bi-check2-circle sc-icon"></i>
        <div class="sc-label"><%= t('admin.vouchers.stats.used', 'Terpakai') %></div>
        <div class="sc-val" id="stat-used">0</div>
        <div class="hint text-success fw-bold" style="font-size:11px;margin-top:2px;" id="stat-used-sub">Omset: Rp 0</div>
      </div>
      <div class="sc d">
        <i class="bi bi-circle sc-icon"></i>
        <div class="sc-label"><%= t('admin.vouchers.stats.unused', 'Belum') %></div>
        <div class="sc-val" id="stat-unused">0</div>
        <div class="hint text-info fw-bold" style="font-size:11px;margin-top:2px;" id="stat-unused-sub">Stok: Rp 0</div>
      </div>
    </div>

    <div class="card" style="margin-bottom:20px">
      <div class="card-hd">
        <h6><i class="bi bi-plus-circle"></i> <%= t('admin.vouchers.create.title', 'Buat Voucher Batch') %></h6>
        <div class="pill"><i class="bi bi-building"></i> <b><%= settings.company_header || company %></b></div>
      </div>
      <div class="card-bd">
        <div class="kv">
          <div class="fg">
            <label class="fl"><%= t('admin.vouchers.create.profile', 'Hotspot User Profile') %></label>
            <select class="fc" id="profileName" onchange="onProfileChanged()">
              <option value=""><%= t('common.loading_short', 'Memuat...') %></option>
            </select>
            <div class="hint" id="profileHint" style="margin-top:4px;"></div>
          </div>
          <div class="fg w160">
            <label class="fl"><%= t('admin.vouchers.create.qty', 'Jumlah') %></label>
            <input class="fc" id="qty" type="number" min="1" max="5000" value="50">
          </div>
          <div class="fg w160">
            <label class="fl"><%= t('admin.vouchers.create.price', 'Harga (Rp)') %></label>
            <input class="fc" id="price" type="number" min="0" step="1000" placeholder="Opsional">
          </div>
          <div class="fg w120">
            <label class="fl">Durasi</label>
            <input class="fc" id="validityCustom" placeholder="misal: 2h, 1d">
          </div>
          <div class="fg w160">
            <label class="fl"><%= t('admin.vouchers.create.mode', 'Mode') %></label>
            <select class="fc" id="mode" onchange="onModeChanged()">
              <option value="voucher"><%= t('admin.vouchers.create.mode_voucher', 'Voucher (User=Pass)') %></option>
              <option value="member"><%= t('admin.vouchers.create.mode_member', 'Member (User & Pass Beda)') %></option>
            </select>
          </div>
          <div class="fg w160">
            <label class="fl"><%= t('admin.vouchers.create.charset', 'Karakter') %></label>
            <select class="fc" id="charset">
              <option value="numbers"><%= t('admin.vouchers.create.charset_numbers', 'Hanya Angka') %></option>
              <option value="letters"><%= t('admin.vouchers.create.charset_letters', 'Hanya Huruf (Kecil)') %></option>
              <option value="mixed"><%= t('admin.vouchers.create.charset_mixed', 'Huruf & Angka') %></option>
            </select>
          </div>
          <div class="fg w120">
            <label class="fl"><%= t('admin.vouchers.create.length', 'Panjang') %></label>
            <input class="fc" id="codeLength" type="number" min="4" max="16" value="6">
          </div>
          <div class="fg w120">
            <label class="fl"><%= t('admin.vouchers.create.prefix', 'Prefix') %></label>
            <input class="fc" id="prefix" placeholder="Opsional">
          </div>
          <div class="fg w120" style="flex:0 0 auto;min-width:0">
            <button class="btn btn-p" onclick="createBatch()" id="btnCreate"><i class="bi bi-magic"></i> <%= t('admin.vouchers.create.create_btn', 'Buat') %></button>
          </div>
        </div>
        <div class="hint" style="margin-top:10px" id="modeHint">
          <%= t('admin.vouchers.create.hint_default', 'Durasi diambil dari metadata profile. Harga bisa diisi manual (kalau kosong akan pakai dari profile).') %>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-list-check"></i> <%= t('admin.vouchers.batches.title', 'Batch Voucher') %></h6>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <div style="display:flex;gap:6px;align-items:center">
            <span class="muted" style="font-size:12px"><%= t('admin.vouchers.print_style', 'Style Print') %></span>
            <select class="fc" id="print_style" style="min-width:220px" onchange="onPrintStyleChanged()">
              <option value="cards" <%= (settings.voucher_print_default_style || '') === 'cards' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_cards', 'Kartu (Default)') %></option>
              <option value="mks" <%= (settings.voucher_print_default_style || '') === 'mks' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_mks', 'Template Jadi: MKS') %></option>
              <option value="simple" <%= (settings.voucher_print_default_style || '') === 'simple' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_simple', 'Template Jadi: Simple') %></option>
              <option value="minimal" <%= (settings.voucher_print_default_style || '') === 'minimal' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_minimal', 'Template Jadi: Minimal') %></option>
              <option value="template" <%= (settings.voucher_print_default_style || '') === 'template' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_custom', 'Template Custom (Editor)') %></option>
            </select>
          </div>
          <button class="btn btn-g btn-sm" onclick="openModal('voucherTemplateModal')"><i class="bi bi-layout-text-sidebar-reverse"></i> <%= t('admin.vouchers.template.btn', 'Template Print') %></button>
          <button class="btn btn-g btn-sm" onclick="reloadBatches()"><i class="bi bi-arrow-clockwise"></i> <%= t('common.refresh', 'Refresh') %></button>
        </div>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>ID</th>
              <th><%= t('admin.vouchers.table.router', 'Router') %></th>
              <th>Profile</th>
              <th>Qty</th>
              <th><%= t('admin.vouchers.table.used', 'Terpakai') %></th>
              <th>Status</th>
              <th><%= t('admin.vouchers.table.created', 'Dibuat') %></th>
              <th><%= t('common.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody id="batches-list">
            <tr><td colspan="8" class="text-center text-muted"><%= t('common.loading', 'Memuat data...') %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="mo" id="batchDetailModal">
  <div class="mb" style="max-width:1100px">
    <div class="mh">
      <span class="mt" id="batchDetailTitle"><%= t('admin.vouchers.detail.title', 'Detail Batch') %></span>
      <button class="mc" onclick="closeModal('batchDetailModal')">&times;</button>
    </div>
    <div class="mbody">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:12px">
        <div id="batchDetailMeta" style="display:flex;gap:8px;flex-wrap:wrap;flex:1"></div>
        <div style="width:220px">
          <input type="text" class="fc" id="batchFilterInput" placeholder="Filter kode / status..." onkeyup="filterBatchDetail(this.value)">
        </div>
      </div>
      <div class="tbl-wrap" style="max-height:450px;overflow-y:auto;">
        <table class="dtbl">
          <thead>
            <tr><th><%= t('admin.vouchers.detail.code', 'Kode') %></th><th><%= t('admin.vouchers.detail.password', 'Password') %></th><th>Status</th><th><%= t('admin.vouchers.detail.used_at', 'Terpakai') %></th><th><%= t('admin.vouchers.detail.last_seen', 'Last Seen') %></th><th style="width:110px">Aksi</th></tr>
          </thead>
          <tbody id="batchDetailList">
            <tr><td colspan="6" class="text-center text-muted"><%= t('common.loading_short', 'Memuat...') %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('batchDetailModal')"><%= t('common.close', 'Tutup') %></button>
    </div>
  </div>
</div>

<!-- Modal Buat 1 Voucher Satuan (Quick Kasir) -->
<div class="mo" id="singleVoucherModal">
  <div class="mb" style="max-width:560px">
    <div class="mh">
      <span class="mt"><i class="bi bi-ticket-fill text-success me-2"></i> Buat 1 Voucher Satuan</span>
      <button class="mc" onclick="closeModal('singleVoucherModal')">&times;</button>
    </div>
    <div class="mbody">
      <div class="alert alert-info small mb-3" style="background:rgba(14,165,233,0.12);border:1px solid rgba(14,165,233,0.3);color:#e0f2fe;">
        <i class="bi bi-info-circle me-1"></i> Cocok untuk melayani pelanggan/pembeli langsung di loket kasir atau via chat WA tanpa harus membuat 50 voucher sekaligus.
      </div>
      <div class="fg mb-3">
        <label class="fl">Hotspot User Profile *</label>
        <select class="fc" id="singleProfileName" onchange="onSingleProfileChanged()">
          <option value="">Memuat profile...</option>
        </select>
        <div class="hint" id="singleProfileHint" style="margin-top:4px;"></div>
      </div>
      <div class="form-row mb-3" style="display:flex;gap:12px;">
        <div class="fg" style="flex:1">
          <label class="fl">Harga (Rp)</label>
          <input class="fc" id="singlePrice" type="number" placeholder="Contoh: 3000">
        </div>
        <div class="fg" style="flex:1">
          <label class="fl">Masa Aktif / Durasi</label>
          <input class="fc" id="singleValidity" placeholder="Contoh: 3h, 1d, 7d">
        </div>
      </div>
      <div class="form-row mb-3" style="display:flex;gap:12px;">
        <div class="fg" style="flex:1">
          <label class="fl">Mode Voucher</label>
          <select class="fc" id="singleMode">
            <option value="voucher">Voucher (User = Password)</option>
            <option value="member">Member (Password Beda)</option>
          </select>
        </div>
        <div class="fg" style="flex:1">
          <label class="fl">No. WhatsApp Pembeli (Opsional)</label>
          <input class="fc" id="singleBuyerPhone" placeholder="08123456789">
        </div>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('singleVoucherModal')">Batal</button>
      <button type="button" class="btn btn-p" id="btnSubmitSingle" onclick="createSingleVoucher()"><i class="bi bi-check-circle me-1"></i> Buat Sekarang</button>
    </div>
  </div>
</div>

<!-- Modal Hasil Voucher Satuan Selesai -->
<div class="mo" id="singleVoucherResultModal">
  <div class="mb" style="max-width:520px">
    <div class="mh">
      <span class="mt text-success"><i class="bi bi-check-circle-fill me-2"></i> Voucher Berhasil Dibuat!</span>
      <button class="mc" onclick="closeModal('singleVoucherResultModal')">&times;</button>
    </div>
    <div class="mbody">
      <div class="p-3 rounded-3 text-center mb-3" style="background:linear-gradient(135deg,rgba(30,41,59,0.85),rgba(15,23,42,0.95));border:1px solid rgba(16,185,129,0.4);">
        <small class="text-muted d-block text-uppercase fw-bold mb-1" id="resProfileName">Paket Hotspot</small>
        <div class="mono fw-extrabold text-white my-2" style="font-size:26px;letter-spacing:2px;" id="resVoucherCode">CODE</div>
        <div class="small text-muted mb-2" id="resVoucherPass">Password: -</div>
        <div class="d-flex justify-content-center gap-2 mt-2">
          <span class="badge bs" id="resVoucherPrice">Rp 0</span>
          <span class="badge bm" id="resVoucherValidity">Durasi: -</span>
        </div>
      </div>
      <div class="fg">
        <label class="fl">Format Pesan WhatsApp / SMS</label>
        <textarea class="fc mono" id="resWaText" rows="6" readonly style="font-size:12px;background:rgba(15,23,42,0.6);color:#7dd3fc;"></textarea>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="copyResultWaText()"><i class="bi bi-clipboard me-1"></i> Salin Pesan</button>
      <button type="button" class="btn btn-s" id="btnSendWaSingle" onclick="sendResultToWa()"><i class="bi bi-whatsapp me-1"></i> Kirim ke WhatsApp</button>
      <button type="button" class="btn btn-p" onclick="closeModal('singleVoucherResultModal')">Selesai</button>
    </div>
  </div>
</div>

<!-- Modal Kirim WhatsApp Universal -->
<div class="mo" id="sendWaModal">
  <div class="mb" style="max-width:500px">
    <div class="mh">
      <span class="mt"><i class="bi bi-whatsapp text-success me-2"></i> Kirim Voucher via WhatsApp</span>
      <button class="mc" onclick="closeModal('sendWaModal')">&times;</button>
    </div>
    <div class="mbody">
      <div class="fg mb-3">
        <label class="fl">Nomor WhatsApp Tujuan *</label>
        <input class="fc" id="sendWaPhone" placeholder="08xxxxxxxxxx atau 62xxxxxxxxxx">
      </div>
      <div class="fg">
        <label class="fl">Isi Pesan Voucher</label>
        <textarea class="fc mono" id="sendWaText" rows="7" style="font-size:12px;"></textarea>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('sendWaModal')">Batal</button>
      <button type="button" class="btn btn-g" onclick="openWaDirectWeb()"><i class="bi bi-box-arrow-up-right me-1"></i> Buka wa.me</button>
      <button type="button" class="btn btn-s" id="btnSendWaSubmit" onclick="submitSendWa()"><i class="bi bi-send-fill me-1"></i> Kirim via Bot WA</button>
    </div>
  </div>
</div>

<div class="mo" id="voucherTemplateModal">
  <div class="mb" style="max-width:980px">
    <div class="mh">
      <span class="mt"><%= t('admin.vouchers.template.title', 'Template Print Voucher') %></span>
      <button class="mc" onclick="closeModal('voucherTemplateModal')">&times;</button>
    </div>
    <div class="mbody">
      <div class="fg" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:12px">
        <div style="flex:1;min-width:240px">
          <label class="fl"><%= t('admin.vouchers.template.preset', 'Preset') %></label>
          <select class="fc" id="tpl_preset" onchange="applyTemplatePreset(this.value)">
            <option value=""><%= t('common.choose', '-- Pilih --') %></option>
            <option value="mks"><%= t('admin.vouchers.template.preset_mks', 'Mikhmon (MKS)') %></option>
            <option value="simple"><%= t('admin.vouchers.template.preset_simple', 'Simple') %></option>
            <option value="empty"><%= t('admin.vouchers.template.preset_empty', 'Kosong') %></option>
          </select>
        </div>
        <div class="hint" style="flex:2;min-width:260px">
          <%= t('admin.vouchers.template.preset_hint', 'Catatan: template Mikhmon yang masih berisi kode PHP tidak bisa dipakai langsung. Gunakan preset ini lalu edit sesuai kebutuhan.') %>
        </div>
      </div>
      <div class="fg" style="margin-bottom:12px">
        <label class="fl"><%= t('admin.vouchers.template.use', 'Gunakan template custom sebagai default print') %></label>
        <select class="fc" id="tpl_use">
          <option value="0" <%= settings.voucher_print_use_template ? '' : 'selected' %>><%= t('common.off', 'Off') %></option>
          <option value="1" <%= settings.voucher_print_use_template ? 'selected' : '' %>><%= t('common.on', 'On') %></option>
        </select>
      </div>
      <div class="fg" style="margin-bottom:12px">
        <label class="fl"><%= t('admin.vouchers.template.default_style', 'Default style print') %></label>
        <select class="fc" id="tpl_default_style">
          <option value="cards" <%= (settings.voucher_print_default_style || '') === 'cards' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_cards', 'Kartu (Default)') %></option>
          <option value="mks" <%= (settings.voucher_print_default_style || '') === 'mks' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_mks', 'Template Jadi: MKS') %></option>
          <option value="simple" <%= (settings.voucher_print_default_style || '') === 'simple' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_simple', 'Template Jadi: Simple') %></option>
          <option value="minimal" <%= (settings.voucher_print_default_style || '') === 'minimal' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_minimal', 'Template Jadi: Minimal') %></option>
          <option value="template" <%= (settings.voucher_print_default_style || '') === 'template' ? 'selected' : '' %>><%= t('admin.vouchers.print_style_custom', 'Template Custom (Editor)') %></option>
        </select>
      </div>
