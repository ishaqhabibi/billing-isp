          </select>
          <button class="btn btn-g btn-sm" onclick="refreshCurrentOlt()" title="Perbarui data OLT via SNMP">
            <i class="bi bi-arrow-clockwise" id="refreshIcon"></i> Refresh SNMP
          </button>
        </div>

        <div class="d-flex align-items-center gap-2">
          <span class="text-muted small"><i class="bi bi-clock me-1"></i> Diperbarui: <strong id="last-refresh-time">-</strong></span>
        </div>
      </div>

      <!-- Device Telemetry Hero Card -->
      <div class="device-telemetry-banner">
        <div class="device-main-info">
          <div class="device-icon-box">
            <i class="bi bi-hdd-rack"></i>
          </div>
          <div class="device-title-area">
            <h4>
              <span id="hero-olt-name">-</span>
              <span class="status-pill-pulse online" id="hero-status-pill">
                <i class="bi bi-circle-fill" style="font-size:6px"></i> <span id="hero-status-text">SNMP v2c Terhubung</span>
              </span>
            </h4>
            <div class="device-specs-line">
              <span>Model: <strong id="hero-model">-</strong></span>
              <span>•</span>
              <span>Firmware: <strong id="hero-firmware">-</strong></span>
              <span>•</span>
              <span>IP Host: <strong id="hero-host">-</strong></span>
              <span>•</span>
              <span>Uptime: <strong id="hero-uptime" class="text-primary">-</strong></span>
