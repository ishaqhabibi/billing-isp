<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dashboard OLT | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.7">
  <script src="/js/theme.js"></script>
  <style>
    /* ── DASHBOARD NOC MODERN STYLING ── */
    .olt-noc-dash {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Top Unit Bar */
    .olt-unit-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .olt-unit-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .custom-select-v2 {
      background: var(--bg3);
      color: var(--text);
      padding: 9px 14px;
      border-radius: 9px;
      border: 1px solid var(--border);
      font-weight: 600;
      font-size: 13.5px;
      min-width: 280px;
      outline: none;
      transition: all 0.2s;
    }
    .custom-select-v2:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(0, 82, 204, 0.18);
    }

    /* Device Telemetry Banner */
    .device-telemetry-banner {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      box-shadow: 0 3px 14px rgba(0,0,0,0.04);
    }
    .device-main-info {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .device-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: rgba(0, 82, 204, 0.12);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }
    .device-title-area h4 {
      margin: 0;
      font-weight: 800;
      font-size: 17px;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .device-specs-line {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 4px;
      font-size: 12.5px;
      color: var(--muted);
    }
    .device-specs-line strong {
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
    }

    .status-pill-pulse {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 9px;
      border-radius: 20px;
      font-size: 11.5px;
      font-weight: 700;
    }
    .status-pill-pulse.online {
      background: rgba(16, 185, 129, 0.14);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .status-pill-pulse.offline {
      background: rgba(239, 68, 68, 0.14);
      color: #dc2626;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    /* ── 4 KPI EXECUTIVE CARDS ── */
    .kpi-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    @media(max-width: 1024px) { .kpi-grid-4 { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 560px) { .kpi-grid-4 { grid-template-columns: 1fr; } }

    .kpi-card-v3 {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 3px 12px rgba(0,0,0,0.04);
      transition: all 0.2s ease;
    }
    .kpi-card-v3:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      border-color: var(--primary);
    }
    .kpi-card-v3::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .kpi-card-v3.kpi-blue::before { background: linear-gradient(90deg, #0052cc, #38bdf8); }
    .kpi-card-v3.kpi-green::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .kpi-card-v3.kpi-amber::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .kpi-card-v3.kpi-purple::before { background: linear-gradient(90deg, #8b5cf6, #c084fc); }

    .kpi-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .kpi-title {
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--muted);
    }
    .kpi-icon-badge {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }
    .kpi-blue .kpi-icon-badge { background: rgba(0, 82, 204, 0.12); color: var(--primary); }
    .kpi-green .kpi-icon-badge { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .kpi-amber .kpi-icon-badge { background: rgba(245, 158, 11, 0.12); color: #d97706; }
    .kpi-purple .kpi-icon-badge { background: rgba(139, 92, 246, 0.12); color: #8b5cf6; }

    .kpi-mid {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .kpi-big-num {
      font-size: 30px;
      font-weight: 800;
      line-height: 1;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
    .kpi-sub-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
    }

    .kpi-bottom-desc {
      font-size: 12px;
      color: var(--muted);
      border-top: 1px dashed var(--border);
      padding-top: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .kpi-bottom-desc strong {
      color: var(--text);
    }

    /* ── MATRIKS PORT PON FISIK ── */
    .pon-matrix-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.04);
    }
    .section-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .section-title {
      font-size: 14px;
      font-weight: 800;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pon-ports-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
    @media(max-width: 992px) { .pon-ports-grid { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 520px) { .pon-ports-grid { grid-template-columns: 1fr; } }

    .pon-slot {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: all 0.2s ease;
      position: relative;
    }
    .pon-slot:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }
    .pon-slot-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .pon-name {
      font-weight: 800;
      font-size: 13.5px;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'JetBrains Mono', monospace;
    }
    .pon-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
    }
    .pon-status-dot.idle { background: #94a3b8; }

    .pon-onu-counter {
      font-size: 22px;
      font-weight: 800;
      color: var(--text);
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .pon-onu-counter span {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
    }

    .pon-details-mini {
      font-size: 11.5px;
      color: var(--muted);
      border-top: 1px solid var(--border);
      padding-top: 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .pon-details-mini .row-item {
      display: flex;
      justify-content: space-between;
    }
    .pon-details-mini strong {
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
    }

    /* ── TWO COLUMNS: SPEKTRUM REDAMAN & TOP PERHATIAN ── */
    .dash-columns-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media(max-width: 900px) { .dash-columns-2 { grid-template-columns: 1fr; } }

    .panel-box-modern {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.04);
    }

    /* Spectrum Bar */
    .spectrum-bar-wrap {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .spectrum-multi-bar {
      height: 14px;
      border-radius: 999px;
      background: var(--bg3);
      display: flex;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .spectrum-seg {
      height: 100%;
      transition: width 0.3s ease;
    }
    .spectrum-seg.seg-good { background: #10b981; }
    .spectrum-seg.seg-warn { background: #f59e0b; }
    .spectrum-seg.seg-crit { background: #ef4444; }

    .spectrum-legend {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 12px;
      color: var(--muted);
    }
    .spectrum-legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 3px;
    }

    /* Top Attention List */
    .attention-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .attention-row {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      transition: all 0.15s ease;
    }
    .attention-row:hover {
      border-color: var(--primary);
    }
    .attention-left {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .attention-name {
      font-weight: 700;
      color: var(--text);
    }
    .attention-sub {
      font-size: 11.5px;
      color: var(--muted);
      font-family: 'JetBrains Mono', monospace;
    }

    /* Action CTA Box */
    .cta-banner-box {
      background: linear-gradient(135deg, rgba(0, 82, 204, 0.08), rgba(56, 189, 248, 0.08));
      border: 1px solid rgba(0, 82, 204, 0.2);
      border-radius: 14px;
      padding: 18px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .cta-banner-text h5 {
      margin: 0 0 4px 0;
      font-weight: 800;
      color: var(--text);
      font-size: 15px;
    }
    .cta-banner-text p {
      margin: 0;
      font-size: 13px;
      color: var(--muted);
    }

    /* Loading Overlay */
    .loading-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(3px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 20;
      border-radius: 14px;
    }
    body.light-theme .loading-overlay {
      background: rgba(255, 255, 255, 0.78);
    }

    /* Diagnostics Result Box */
    .diag-box {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      margin-top: 14px;
    }
    .diag-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px dashed var(--border);
      font-size: 13px;
    }
    .diag-item:last-child { border-bottom: none; }
    .diag-item .label { color: var(--muted); }
    .diag-item .val { font-weight: 700; color: var(--text); font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body>
<div class="mw">
  <!-- Topbar Header -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-speedometer2 text-primary"></i>
      <span>Dashboard OLT</span>
    </div>
    <div class="tb-right">
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-g btn-sm" onclick="runDiagnosticPrompt()" title="Diagnostik SNMP Cepat">
          <i class="bi bi-activity"></i> Test SNMP
        </button>
        <button class="btn btn-g btn-sm" onclick="openModal('manageOltsModal')" title="Kelola Daftar OLT">
          <i class="bi bi-gear"></i> Kelola OLT
        </button>
        <button class="btn btn-p btn-sm" onclick="openModal('addOltModal')" title="Tambah Perangkat OLT Baru">
          <i class="bi bi-plus-lg"></i> Tambah OLT
        </button>
        <!-- Theme Toggle Quick Button -->
        <button type="button" class="btn btn-g btn-sm theme-toggle-btn" onclick="toggleAppTheme()" title="Ganti Mode Terang / Gelap" style="padding:4px 9px;">
          <i class="bi bi-moon-stars-fill theme-toggle-icon" style="color:#fbbf24"></i>
        </button>
      </div>
    </div>
  </div>

  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'d':'s' %>"><%= msg.text %></div>
    <% } %>

    <!-- UNIFIED SUB-NAVIGATION TABS -->
    <div class="mtabs" style="margin-bottom:20px;">
      <a href="/admin/olts" class="mtab active"><i class="bi bi-speedometer2"></i> Dashboard Ringkasan OLT</a>
      <a href="/admin/olts/onus" class="mtab" id="linkTabOnus"><i class="bi bi-hdd-network"></i> Data Modem ONU <span class="badge bs ms-1" id="badgeTabOnuCount">-</span></a>
      <a href="/admin/onu-provision" class="mtab"><i class="bi bi-hdd-network-fill"></i> Provisioning ONU</a>
      <a href="/admin/acs" class="mtab"><i class="bi bi-broadcast"></i> GenieACS Pro</a>
      <a href="/admin/onu-stickers" class="mtab"><i class="bi bi-printer"></i> Stiker Modem ONU</a>
    </div>

    <% if (olts.length === 0) { %>
      <div class="olt-main-box" style="padding: 60px 24px; text-align: center;">
        <h4 style="font-weight: 800; color: var(--text); margin-bottom: 8px;">Belum Ada Perangkat OLT Terdaftar</h4>
        <p style="color: var(--muted); font-size: 14px; max-width: 500px; margin: 0 auto 20px;">
          Tambahkan perangkat OLT (HSGQ, ZTE, Huawei, HIOSO, VSOL) untuk memantau status modem dan redaman optik secara real-time.
        </p>
        <button class="btn btn-p" onclick="openModal('addOltModal')">
          <i class="bi bi-plus-lg me-1"></i> Tambah Perangkat OLT Pertama
        </button>
      </div>
    <% } else { %>

    <div class="olt-noc-dash position-relative">
      <div id="loading-overlay" class="loading-overlay">
        <div class="text-center">
          <div class="spinner-border text-primary" role="status" style="width: 2.2rem; height: 2.2rem;"></div>
          <div class="mt-2 fw-bold text-white small" id="loadingText">Mengambil telemetry OLT via SNMP...</div>
        </div>
      </div>

      <!-- OLT Unit Selector Bar -->
      <div class="olt-unit-card">
        <div class="olt-unit-left">
          <label class="fw-bold text-muted small text-uppercase mb-0">
            <i class="bi bi-hdd-network me-1"></i> Perangkat:
          </label>
          <select id="olt-selector" class="custom-select-v2" onchange="handleOltChange()">
            <% olts.forEach(olt => { %>
              <option value="<%= olt.id %>" data-brand="<%= olt.brand %>" data-host="<%= olt.host %>" <%= !olt.is_active ? 'disabled' : '' %>>
                <%= olt.name %> (<%= (olt.brand || '').toUpperCase() %> - <%= olt.host %>)
              </option>
            <% }) %>
          </select>
          <button class="btn btn-g btn-sm" onclick="refreshCurrentOlt()" title="Perbarui data OLT via SNMP">
            <i class="bi bi-arrow-clockwise" id="refreshIcon"></i> Refresh SNMP
          </button>
        </div>

        <div class="d-flex align-items-center gap-2">
          <span class="text-muted small"><i class="bi bi-clock me-1"></i> Diperbarui: <strong id="last-refresh-time">-</strong></span>
        </div>
      </div>

      <!-- Device Telemetry Hero Card -->
      <div class="device-telemetry-banner">
        <div class="device-main-info">
          <div class="device-icon-box">
            <i class="bi bi-hdd-rack"></i>
          </div>
          <div class="device-title-area">
            <h4>
              <span id="hero-olt-name">-</span>
              <span class="status-pill-pulse online" id="hero-status-pill">
                <i class="bi bi-circle-fill" style="font-size:6px"></i> <span id="hero-status-text">SNMP v2c Terhubung</span>
              </span>
            </h4>
            <div class="device-specs-line">
              <span>Model: <strong id="hero-model">-</strong></span>
              <span>•</span>
              <span>Firmware: <strong id="hero-firmware">-</strong></span>
              <span>•</span>
              <span>IP Host: <strong id="hero-host">-</strong></span>
              <span>•</span>
              <span>Uptime: <strong id="hero-uptime" class="text-primary">-</strong></span>
            </div>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/admin/olts/onus" id="btnHeroOpenOnus" class="btn btn-p btn-sm">
            <i class="bi bi-hdd-network me-1"></i> Buka Data Modem (<span id="hero-onu-count">0</span>)
          </a>
        </div>
      </div>

      <!-- 4 Ringkasan Eksekutif KPI -->
      <div class="kpi-grid-4">
        <!-- 1. Populasi Modem -->
        <div class="kpi-card-v3 kpi-blue">
          <div class="kpi-top">
            <span class="kpi-title">Modem Terpasang</span>
            <div class="kpi-icon-badge"><i class="bi bi-router"></i></div>
          </div>
          <div class="kpi-mid">
            <span class="kpi-big-num" id="stat-total-onu">-</span>
            <span class="kpi-sub-label">Unit</span>
          </div>
          <div class="kpi-bottom-desc">
            <span>Online: <strong class="text-success" id="stat-online-onu">-</strong> (<span id="stat-online-percent">0%</span>)</span>
            <span>Offline: <strong class="text-danger" id="stat-offline-onu">0</strong></span>
          </div>
        </div>

        <!-- 2. Kualitas Redaman Optik -->
        <div class="kpi-card-v3 kpi-green">
          <div class="kpi-top">
            <span class="kpi-title">Kondisi Redaman Optik</span>
            <div class="kpi-icon-badge"><i class="bi bi-lightning-charge"></i></div>
          </div>
          <div class="kpi-mid">
            <span class="kpi-big-num text-success" id="stat-good-onu">-</span>
            <span class="kpi-sub-label text-success">Normal</span>
          </div>
          <div class="kpi-bottom-desc">
            <span>Rata-rata: <strong id="stat-avg-rx">-</strong></span>
            <span>Kritis (&lt; -25): <strong class="text-danger" id="stat-crit-onu">0</strong></span>
          </div>
        </div>

        <!-- 3. Beban CPU & Memori -->
        <div class="kpi-card-v3 kpi-purple">
          <div class="kpi-top">
            <span class="kpi-title">Beban Hardware OLT</span>
            <div class="kpi-icon-badge"><i class="bi bi-cpu"></i></div>
          </div>
          <div class="kpi-mid">
            <span class="kpi-big-num" id="stat-cpu">-</span>
            <span class="kpi-sub-label">CPU Load</span>
          </div>
          <div class="kpi-bottom-desc">
            <span>Penggunaan RAM: <strong id="stat-ram">-</strong></span>
            <span class="badge bs">Stabil</span>
          </div>
        </div>

        <!-- 4. Suhu & Lingkungan Fisik -->
        <div class="kpi-card-v3 kpi-amber">
          <div class="kpi-top">
            <span class="kpi-title">Suhu &amp; Catu Daya</span>
            <div class="kpi-icon-badge"><i class="bi bi-thermometer-half"></i></div>
          </div>
          <div class="kpi-mid">
            <span class="kpi-big-num" id="stat-temp">-</span>
            <span class="kpi-sub-label">Temperatur</span>
          </div>
          <div class="kpi-bottom-desc">
            <span>Kipas: <strong id="stat-fan">-</strong></span>
            <span class="badge bs" id="stat-power-badge">AC/DC Normal</span>
          </div>
        </div>
      </div>

      <!-- Matriks Port PON Fisik (4 Port GPON OLT) -->
      <div class="pon-matrix-card">
        <div class="section-header-row">
          <div class="section-title">
            <i class="bi bi-grid-3x3-gap text-primary"></i>
            <span>Status Port Fisik PON (Transceiver SFP)</span>
          </div>
          <span class="text-muted small">Representasi 4 Port GPON pada sasis OLT</span>
        </div>

        <div class="pon-ports-grid" id="ponPortsGrid">
          <!-- Di-render dinamis via JavaScript -->
          <div class="pon-slot">
            <div class="pon-slot-top">
              <span class="pon-name"><i class="bi bi-broadcast me-1 text-primary"></i> PON 01</span>
              <span class="pon-status-dot"></span>
            </div>
            <div class="pon-onu-counter">0 <span>Modem</span></div>
            <div class="pon-details-mini">
              <div class="row-item"><span>Status:</span> <strong>In-Service</strong></div>
              <div class="row-item"><span>TX Power:</span> <strong>+8.09 dBm</strong></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Dua Kolom: Spektrum Redaman & Modem Butuh Perhatian -->
      <div class="dash-columns-2">
        <!-- Panel 1: Spektrum Kualitas Redaman Optik -->
        <div class="panel-box-modern">
          <div class="section-title">
            <i class="bi bi-bar-chart-fill text-primary"></i>
            <span>Distribusi Kualitas Redaman (Link Budget)</span>
          </div>
          <p class="text-muted small mb-1">
            Standar instalasi BionFiber: Nilai ideal berada di antara <strong>-18.00 dBm</strong> hingga <strong>-22.00 dBm</strong>.
          </p>

          <div class="spectrum-bar-wrap">
            <div class="spectrum-multi-bar">
              <div class="spectrum-seg seg-good" id="bar-good" style="width: 100%;" title="Bagus / Ideal"></div>
              <div class="spectrum-seg seg-warn" id="bar-warn" style="width: 0%;" title="Waspada"></div>
              <div class="spectrum-seg seg-crit" id="bar-crit" style="width: 0%;" title="Kritis"></div>
            </div>
            <div class="spectrum-legend">
              <div class="spectrum-legend-item">
                <span class="legend-dot" style="background:#10b981;"></span>
                <span>Ideal (-15 s/d -22 dBm): <strong id="legend-count-good" class="text-success">0</strong></span>
              </div>
              <div class="spectrum-legend-item">
                <span class="legend-dot" style="background:#f59e0b;"></span>
                <span>Waspada (-22 s/d -25 dBm): <strong id="legend-count-warn" class="text-warning">0</strong></span>
              </div>
              <div class="spectrum-legend-item">
                <span class="legend-dot" style="background:#ef4444;"></span>
                <span>Kritis (&lt; -25 dBm): <strong id="legend-count-crit" class="text-danger">0</strong></span>
              </div>
            </div>
          </div>

          <div class="diag-box p-3 mt-2" style="font-size:12.5px;">
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Redaman Terkuat (Terdekat):</span>
              <strong id="stat-rx-max" class="font-monospace text-success">-</strong>
            </div>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted">Redaman Terlemah (Terjauh):</span>
              <strong id="stat-rx-min" class="font-monospace text-warning">-</strong>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted">Jarak Kabel Terjauh:</span>
              <strong id="stat-dist-max" class="font-monospace text-primary">-</strong>
            </div>
          </div>
        </div>

        <!-- Panel 2: Modem yang Butuh Pemantauan / Perhatian Khusus -->
        <div class="panel-box-modern">
          <div class="section-title">
            <i class="bi bi-exclamation-diamond text-warning"></i>
            <span>Pemantauan Khusus (Top Watchlist)</span>
          </div>
          <p class="text-muted small mb-1">
            Daftar modem yang sedang offline atau memiliki redaman terendah yang rentan gangguan.
          </p>

          <div class="attention-list" id="attentionList">
            <!-- Di-render dinamis -->
            <div class="p-4 text-center text-muted">
              <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
              <div>Menganalisis redaman optik modem...</div>
            </div>
          </div>

          <div class="text-end mt-auto pt-2">
            <a href="/admin/olts/onus" id="btnLinkAllOnusBottom" class="btn btn-g btn-sm">
              Lihat Seluruh Data Modem ONU <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Action Call-To-Action Banner -->
      <div class="cta-banner-box">
        <div class="cta-banner-text">
          <h5><i class="bi bi-table me-2 text-primary"></i>Ingin Mengelola Seluruh Data Modem Pelanggan?</h5>
          <p>Halaman terpisah menyediakan tabel lengkap dengan pencarian real-time, filter port PON, riwayat uptime, dan export CSV.</p>
        </div>
        <a href="/admin/olts/onus" id="btnCtaFullPage" class="btn btn-p">
          Buka Tabel Lengkap Modem ONU <i class="bi bi-arrow-up-right ms-1"></i>
        </a>
      </div>
    </div>
    <% } %>
  </div>
</div>

