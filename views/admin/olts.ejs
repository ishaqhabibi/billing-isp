          </div>

          <div class="text-end mt-auto pt-2">
            <a href="/admin/olts/onus" id="btnLinkAllOnusBottom" class="btn btn-g btn-sm">
              Lihat Seluruh Data Modem ONU <i class="bi bi-arrow-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Action Call-To-Action Banner -->
      <div class="cta-banner-box">
        <div class="cta-banner-text">
          <h5><i class="bi bi-table me-2 text-primary"></i>Ingin Mengelola Seluruh Data Modem Pelanggan?</h5>
          <p>Halaman terpisah menyediakan tabel lengkap dengan pencarian real-time, filter port PON, riwayat uptime, dan export CSV.</p>
        </div>
        <a href="/admin/olts/onus" id="btnCtaFullPage" class="btn btn-p">
          Buka Tabel Lengkap Modem ONU <i class="bi bi-arrow-up-right ms-1"></i>
        </a>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/sidebar', { activePage: 'olts', company }) %>

<!-- MODAL: Kelola OLT -->
<div class="mo" id="manageOltsModal" onclick="if(event.target===this)closeModal('manageOltsModal')">
  <div class="mb" style="max-width: 900px; width: 95%;">
    <div class="mh">
      <div style="display:flex; align-items:center; gap:12px;">
        <div style="width:38px; height:38px; border-radius:10px; background:rgba(0,82,204,0.12); color:var(--primary); display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;">
          <i class="bi bi-hdd-rack-fill"></i>
        </div>
        <div>
          <h5 class="mt mb-0" style="font-size:15px; font-weight:800; color:var(--text);">Daftar Perangkat OLT Terdaftar</h5>
          <div style="font-size:11.5px; color:var(--muted); font-weight:500;">Sentral OLT (HSGQ, ZTE, Huawei, HIOSO, dll) untuk monitoring optical dan ONU</div>
        </div>
      </div>
      <button type="button" class="mc" onclick="closeModal('manageOltsModal')" title="Tutup">&times;</button>
    </div>
    <div class="mbody" style="padding:0;">
      <div style="overflow-x:auto;">
        <table class="modal-olt-table">
          <thead>
            <tr>
              <th>Perangkat &amp; Host</th>
              <th>Vendor Brand</th>
              <th>SNMP Port</th>
              <th>Status</th>
              <th>Titik Peta GIS</th>
              <th style="text-align:right">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (olts.length === 0) { %>
              <tr>
                <td colspan="6" style="text-align:center; padding:36px 16px;">
                  <div style="color:var(--muted); font-size:14px; margin-bottom:12px;">
                    <i class="bi bi-hdd-rack" style="font-size:32px; display:block; margin-bottom:8px; opacity:0.5;"></i>
                    Belum ada perangkat OLT yang didaftarkan ke sistem.
                  </div>
                  <button type="button" class="btn btn-p btn-sm" onclick="closeModal('manageOltsModal'); openModal('addOltModal');">
                    <i class="bi bi-plus-lg me-1"></i> Tambah OLT Sekarang
                  </button>
                </td>
              </tr>
            <% } else { %>
              <% olts.forEach(o => { %>
                <tr>
                  <td>
                    <div style="font-weight:700; color:var(--text); font-size:13.5px;"><%= o.name %></div>
                    <div style="margin-top:3px; display:flex; align-items:center; gap:6px;">
                      <code style="background:var(--bg3); color:var(--primary); padding:2px 7px; border-radius:6px; font-size:11.5px; font-family:'JetBrains Mono',monospace;"><%= o.host %></code>
                      <% if (o.description) { %>
                        <span style="font-size:11px; color:var(--muted); max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= o.description %>">• <%= o.description %></span>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <span class="badge bs" style="text-transform:uppercase; font-size:11px; font-weight:700; letter-spacing:0.3px;"><%= (o.brand || 'hsgq').toUpperCase() %></span>
                  </td>
                  <td>
                    <code style="background:var(--bg3); padding:2px 7px; border-radius:6px; font-size:12px; font-family:'JetBrains Mono',monospace;"><%= o.snmp_port || 161 %></code>
                  </td>
                  <td>
                    <% if (o.is_active) { %>
                      <span class="status-pill-pulse online" style="font-size:11px; padding:2px 8px;">
                        <i class="bi bi-circle-fill" style="font-size:5px;"></i> Aktif
                      </span>
                    <% } else { %>
                      <span class="status-pill-pulse offline" style="font-size:11px; padding:2px 8px;">
                        <i class="bi bi-circle-fill" style="font-size:5px;"></i> Nonaktif
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <% if (o.lat && o.lng) { %>
                      <div style="display:flex; align-items:center; gap:5px;">
                        <i class="bi bi-geo-alt-fill text-danger" style="font-size:12px;"></i>
                        <code style="background:var(--bg3); color:var(--text); font-size:11px; padding:2px 6px; border-radius:5px;"><%= Number(o.lat).toFixed(4) %>, <%= Number(o.lng).toFixed(4) %></code>
                      </div>
                    <% } else { %>
                      <a href="/admin/map" class="badge bw" style="text-decoration:none; font-size:10.5px;" title="Tentukan lokasi di peta topologi">
                        <i class="bi bi-exclamation-triangle me-1"></i>Belum Ada GPS
                      </a>
                    <% } %>
                  </td>
                  <td style="text-align:right; white-space:nowrap;">
                    <button type="button" class="btn btn-g btn-sm py-1 px-2" onclick="testOltSnmpDirect('<%= o.id %>')" title="Uji Koneksi SNMP OLT">
                      <i class="bi bi-activity text-primary"></i> Test
