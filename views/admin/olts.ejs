<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dashboard OLT | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=3.3">
  <script src="/js/theme.js"></script>
  <style>
    /* ── DASHBOARD NOC MODERN STYLING ── */
    .olt-noc-dash {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Top Unit Bar */
    .olt-unit-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .olt-unit-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .custom-select-v2 {
      background: var(--bg3);
      color: var(--text);
      padding: 9px 14px;
      border-radius: 9px;
      border: 1px solid var(--border);
      font-weight: 600;
      font-size: 13.5px;
      min-width: 280px;
      outline: none;
      transition: all 0.2s;
    }
    .custom-select-v2:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(0, 82, 204, 0.18);
    }

    /* Device Telemetry Banner */
    .device-telemetry-banner {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      box-shadow: 0 3px 14px rgba(0,0,0,0.04);
    }
    .device-main-info {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .device-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: rgba(0, 82, 204, 0.12);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }
    .device-title-area h4 {
      margin: 0;
      font-weight: 800;
      font-size: 17px;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .device-specs-line {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 4px;
      font-size: 12.5px;
      color: var(--muted);
    }
    .device-specs-line strong {
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
    }

    .status-pill-pulse {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 9px;
      border-radius: 20px;
      font-size: 11.5px;
      font-weight: 700;
    }
    .status-pill-pulse.online {
      background: rgba(16, 185, 129, 0.14);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .status-pill-pulse.offline {
      background: rgba(239, 68, 68, 0.14);
      color: #dc2626;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    /* ── 4 KPI EXECUTIVE CARDS ── */
    .kpi-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    @media(max-width: 1024px) { .kpi-grid-4 { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 560px) { .kpi-grid-4 { grid-template-columns: 1fr; } }

    .kpi-card-v3 {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 3px 12px rgba(0,0,0,0.04);
      transition: all 0.2s ease;
    }
    .kpi-card-v3:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      border-color: var(--primary);
    }
    .kpi-card-v3::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .kpi-card-v3.kpi-blue::before { background: linear-gradient(90deg, #0052cc, #38bdf8); }
    .kpi-card-v3.kpi-green::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .kpi-card-v3.kpi-amber::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .kpi-card-v3.kpi-purple::before { background: linear-gradient(90deg, #8b5cf6, #c084fc); }

    .kpi-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .kpi-title {
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--muted);
    }
    .kpi-icon-badge {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }
    .kpi-blue .kpi-icon-badge { background: rgba(0, 82, 204, 0.12); color: var(--primary); }
    .kpi-green .kpi-icon-badge { background: rgba(16, 185, 129, 0.12); color: #10b981; }
    .kpi-amber .kpi-icon-badge { background: rgba(245, 158, 11, 0.12); color: #d97706; }
    .kpi-purple .kpi-icon-badge { background: rgba(139, 92, 246, 0.12); color: #8b5cf6; }

    .kpi-mid {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .kpi-big-num {
      font-size: 30px;
      font-weight: 800;
      line-height: 1;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
    .kpi-sub-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
    }

    .kpi-bottom-desc {
      font-size: 12px;
      color: var(--muted);
      border-top: 1px dashed var(--border);
      padding-top: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .kpi-bottom-desc strong {
      color: var(--text);
    }

    /* ── MATRIKS PORT PON FISIK ── */
    .pon-matrix-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.04);
    }
    .section-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .section-title {
      font-size: 14px;
      font-weight: 800;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pon-ports-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
    @media(max-width: 992px) { .pon-ports-grid { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 520px) { .pon-ports-grid { grid-template-columns: 1fr; } }

    .pon-slot {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: all 0.2s ease;
      position: relative;
    }
    .pon-slot:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }
    .pon-slot-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .pon-name {
      font-weight: 800;
      font-size: 13.5px;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'JetBrains Mono', monospace;
    }
    .pon-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
    }
    .pon-status-dot.idle { background: #94a3b8; }

    .pon-onu-counter {
      font-size: 22px;
      font-weight: 800;
      color: var(--text);
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .pon-onu-counter span {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
    }

    .pon-details-mini {
      font-size: 11.5px;
      color: var(--muted);
      border-top: 1px solid var(--border);
      padding-top: 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .pon-details-mini .row-item {
      display: flex;
      justify-content: space-between;
    }
    .pon-details-mini strong {
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
    }

    /* ── TWO COLUMNS: SPEKTRUM REDAMAN & TOP PERHATIAN ── */
    .dash-columns-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media(max-width: 900px) { .dash-columns-2 { grid-template-columns: 1fr; } }

    .panel-box-modern {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.04);
    }

    /* Spectrum Bar */
    .spectrum-bar-wrap {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .spectrum-multi-bar {
      height: 14px;
      border-radius: 999px;
      background: var(--bg3);
      display: flex;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .spectrum-seg {
      height: 100%;
      transition: width 0.3s ease;
    }
    .spectrum-seg.seg-good { background: #10b981; }
    .spectrum-seg.seg-warn { background: #f59e0b; }
    .spectrum-seg.seg-crit { background: #ef4444; }

    .spectrum-legend {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 12px;
      color: var(--muted);
    }
    .spectrum-legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 3px;
    }

    /* Top Attention List */
    .attention-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .attention-row {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      transition: all 0.15s ease;
    }
    .attention-row:hover {
      border-color: var(--primary);
    }
    .attention-left {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .attention-name {
      font-weight: 700;
      color: var(--text);
    }
    .attention-sub {
      font-size: 11.5px;
      color: var(--muted);
      font-family: 'JetBrains Mono', monospace;
    }

    /* Action CTA Box */
    .cta-banner-box {
      background: linear-gradient(135deg, rgba(0, 82, 204, 0.08), rgba(56, 189, 248, 0.08));
      border: 1px solid rgba(0, 82, 204, 0.2);
      border-radius: 14px;
      padding: 18px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .cta-banner-text h5 {
      margin: 0 0 4px 0;
      font-weight: 800;
      color: var(--text);
      font-size: 15px;
    }
    .cta-banner-text p {
      margin: 0;
      font-size: 13px;
      color: var(--muted);
    }

    /* ── MODERN HIGH-TECH NOC TELEMETRY LOADING SCREEN ── */
    .noc-loading-screen {
      position: fixed !important;
      top: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      left: var(--sw, 240px) !important;
      width: auto !important;
      z-index: 900 !important;
      background: radial-gradient(circle at 50% 35%, rgba(14, 165, 233, 0.16), transparent 50%),
                  radial-gradient(circle at 80% 80%, rgba(99, 102, 241, 0.12), transparent 45%),
                  rgba(11, 17, 30, 0.94) !important;
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 20px !important;
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                  visibility 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
    @media (max-width: 991px) {
      .noc-loading-screen {
        left: 0 !important;
      }
    }
    body.light-theme .noc-loading-screen {
      background: radial-gradient(circle at 50% 30%, rgba(14, 165, 233, 0.18), transparent 50%),
                  radial-gradient(circle at 80% 80%, rgba(99, 102, 241, 0.12), transparent 45%),
                  rgba(248, 250, 252, 0.95);
    }
    .noc-loading-screen.fade-out {
      opacity: 0 !important;
      visibility: hidden !important;
      transform: scale(1.025) !important;
      pointer-events: none !important;
    }
    .noc-loading-card {
      position: relative;
      width: 100%;
      max-width: 460px;
      background: rgba(19, 27, 46, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 22px;
      padding: 34px 28px 28px;
      box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.65),
                  0 0 0 1px rgba(14, 165, 233, 0.18) inset;
      text-align: center;
      overflow: hidden;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      animation: nocCardEnter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    body.light-theme .noc-loading-card {
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(0, 82, 204, 0.18);
      box-shadow: 0 24px 64px -12px rgba(0, 82, 204, 0.22),
                  0 0 0 1px rgba(14, 165, 233, 0.25) inset;
    }
    @keyframes nocCardEnter {
      from { opacity: 0; transform: translateY(16px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .noc-loading-beam {
      position: absolute;
      top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, #0ea5e9, #6366f1, #10b981, #0ea5e9);
      background-size: 200% 100%;
      animation: nocBeamFlow 2.4s linear infinite;
    }
    @keyframes nocBeamFlow {
      0% { background-position: 0% 0%; }
      100% { background-position: 200% 0%; }
    }
    .noc-loading-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 5px 14px;
      border-radius: 999px;
      background: rgba(14, 165, 233, 0.14);
      border: 1px solid rgba(14, 165, 233, 0.35);
      color: #38bdf8;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 22px;
    }
    body.light-theme .noc-loading-badge {
      background: rgba(2, 132, 199, 0.1);
      border-color: rgba(2, 132, 199, 0.28);
      color: #0284c7;
    }
    .noc-loading-badge .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #38bdf8;
      box-shadow: 0 0 10px #38bdf8;
      animation: nocBadgePulse 1.4s infinite ease-in-out;
    }
    @keyframes nocBadgePulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.35); opacity: 0.55; }
    }
    .noc-loading-emblem {
      position: relative;
      width: 86px;
      height: 86px;
      margin: 0 auto 22px auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .noc-loading-ring-outer {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2.5px solid transparent;
      border-top-color: #0ea5e9;
      border-right-color: #6366f1;
      animation: nocRingRotate 1.8s cubic-bezier(0.5, 0, 0.5, 1) infinite;
      box-shadow: 0 0 16px rgba(14, 165, 233, 0.35);
    }
    .noc-loading-ring-inner {
      position: absolute;
      inset: 9px;
      border-radius: 50%;
      border: 2px dashed rgba(16, 185, 129, 0.7);
      border-bottom-color: transparent;
      animation: nocRingRotateReverse 2.4s linear infinite;
    }
    @keyframes nocRingRotate {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    @keyframes nocRingRotateReverse {
      0% { transform: rotate(360deg); }
      100% { transform: rotate(0deg); }
    }
    .noc-loading-icon-core {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(14, 165, 233, 0.25), rgba(99, 102, 241, 0.25));
      border: 1px solid rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      color: #38bdf8;
      box-shadow: 0 0 20px rgba(14, 165, 233, 0.45);
    }
    body.light-theme .noc-loading-icon-core {
      background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(99, 102, 241, 0.15));
      color: #0284c7;
    }
    .noc-loading-title {
      font-size: 18px;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 6px;
      letter-spacing: -0.2px;
    }
    .noc-loading-subtitle {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 22px;
      line-height: 1.5;
    }
    .noc-loading-subtitle strong {
      color: #38bdf8;
      font-weight: 700;
    }
    body.light-theme .noc-loading-subtitle strong {
      color: #0284c7;
    }
    .noc-progress-container {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 999px;
      overflow: hidden;
      position: relative;
      margin-bottom: 18px;
    }
    body.light-theme .noc-progress-container {
      background: rgba(0, 0, 0, 0.08);
    }
    .noc-progress-bar {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, #0ea5e9, #6366f1, #10b981, #0ea5e9);
      background-size: 200% 100%;
      border-radius: 999px;
      animation: nocProgressAnim 1.6s linear infinite;
      box-shadow: 0 0 12px rgba(14, 165, 233, 0.6);
    }
    @keyframes nocProgressAnim {
      0% { background-position: 100% 0%; }
      100% { background-position: -100% 0%; }
    }
    .noc-steps-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 18px;
    }
    .noc-step-item {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--muted);
      justify-content: center;
      padding: 7px 6px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: all 0.25s ease;
    }
    body.light-theme .noc-step-item {
      background: rgba(0, 0, 0, 0.02);
      border: 1px solid rgba(0, 0, 0, 0.06);
    }
    .noc-step-item.active {
      color: #38bdf8;
      background: rgba(14, 165, 233, 0.12);
      border-color: rgba(14, 165, 233, 0.35);
      box-shadow: 0 2px 8px rgba(14, 165, 233, 0.15);
    }
    .noc-step-item.done {
      color: #10b981;
      background: rgba(16, 185, 129, 0.12);
      border-color: rgba(16, 185, 129, 0.35);
    }
    body.light-theme .noc-step-item.active {
      color: #0284c7;
      background: rgba(2, 132, 199, 0.1);
      border-color: rgba(2, 132, 199, 0.3);
    }
    body.light-theme .noc-step-item.done {
      color: #059669;
      background: rgba(16, 185, 129, 0.1);
      border-color: rgba(16, 185, 129, 0.3);
    }
    .noc-live-status {
      font-size: 12px;
      font-family: 'JetBrains Mono', monospace;
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .noc-live-status .status-dot {
      width: 6.5px;
      height: 6.5px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 8px #10b981;
      animation: nocPulseDot 1.2s infinite ease-in-out;
    }
    @keyframes nocPulseDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* Refined In-Dashboard Loading Overlay */
    .loading-overlay {
      position: absolute;
      inset: 0;
      background: rgba(11, 17, 30, 0.82);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 50;
      border-radius: 16px;
      animation: nocFadeIn 0.2s ease;
    }
    body.light-theme .loading-overlay {
      background: rgba(248, 250, 252, 0.85);
    }
    @keyframes nocFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* Diagnostics Result Box */
    .diag-box {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      margin-top: 14px;
    }
    .diag-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px dashed var(--border);
      font-size: 13px;
    }
    /* Modal OLT Enhanced Styling */
    .modal-olt-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 13px;
    }
    .modal-olt-table th {
      background: var(--bg3);
      color: var(--muted);
      font-weight: 700;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    .modal-olt-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
      color: var(--text);
    }
    .modal-olt-table tbody tr:last-child td {
      border-bottom: none;
    }
    .modal-olt-table tbody tr:hover {
      background: rgba(0, 82, 204, 0.04);
    }
    html[data-theme="light"] .modal-olt-table th {
      background: #f8fafc;
      color: #64748b;
    }
    html[data-theme="light"] .modal-olt-table tbody tr:hover {
      background: #f1f5f9;
    }
  </style>
</head>
