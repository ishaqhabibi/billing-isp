<!-- Copied Toast -->
<div id="copiedToast" class="copied-toast">
  <i class="bi bi-check-circle-fill me-1"></i> SN berhasil disalin ke clipboard!
</div>

<div id="olt-data-store" data-olts='<%- JSON.stringify(olts || []) %>' style="display:none;"></div>

<script>
const I18N = {
  lang: "<%= lang || 'id' %>",
  confirmDeleteOlt: "<%= t('admin.olts.confirm_delete', 'Yakin ingin menghapus perangkat OLT ini?') %>",
  serverConnectFailed: "<%= t('admin.olts.errors.server_connect_failed', 'Gagal menghubungi server') %>",
  noOnuData: "<%= t('admin.olts.empty_no_onu', 'Tidak ada data ONU ditemukan.') %>",
  tryAgain: "<%= t('admin.olts.actions.try_again', 'Coba Lagi') %>",
  renamePrompt: "<%= t('admin.olts.actions.rename_prompt', 'Masukkan nama baru untuk ONU:') %>",
  renameTitle: "<%= t('admin.olts.actions.rename', 'Ubah Nama ONU') %>",
  rebootTitle: "<%= t('admin.olts.actions.reboot', 'Reboot ONU') %>",
  confirmReboot: "<%= t('admin.olts.confirm_reboot', 'Yakin ingin me-reboot ONU ini?') %>",
  rebootSent: "<%= t('admin.olts.reboot_sent', 'Perintah reboot berhasil dikirim.') %>",
  failedPrefix: "<%= t('admin.olts.failed_prefix', 'Gagal') %>: ",
  errorPrefix: "<%= t('admin.olts.error_prefix', 'Error') %>: ",
  statusOnline: "<%= t('admin.olts.status.online', 'Online') %>",
  statusOffline: "<%= t('admin.olts.status.offline', 'Offline') %>"
};

function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }

let rawOnus = [];
let currentStats = null;
let currentFilter = 'all';
let currentSearch = '';
let activeSubTab = 'onus';

const oltsData = JSON.parse(document.getElementById('olt-data-store').dataset.olts || '[]');

function editOlt(id) {
  const olt = oltsData.find(o => o.id == id);
  if (!olt) return;
  document.getElementById('editOltForm').action = '/admin/olts/' + olt.id + '/update';
  document.getElementById('e_name').value = olt.name || '';
  document.getElementById('e_host').value = olt.host || '';
  document.getElementById('e_snmp_port').value = olt.snmp_port || 161;
  document.getElementById('e_brand').value = olt.brand || 'hioso';
  document.getElementById('e_snmp_community').value = olt.snmp_community || 'public';
  document.getElementById('e_web_user').value = olt.web_user || 'admin';
  document.getElementById('e_web_password').value = '';
  document.getElementById('e_telnet_port').value = olt.telnet_port != null ? olt.telnet_port : 23;
  document.getElementById('e_enable_password').value = '';
  document.getElementById('e_api_base_url').value = olt.api_base_url || '';
  document.getElementById('e_description').value = olt.description || '';
  document.getElementById('e_is_active').value = olt.is_active ? '1' : '0';
  closeModal('manageOltsModal');
  openModal('editOltModal');
}

function formatBytes(bytes) {
  if (!bytes || bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
}

function copyToClipboard(text) {
  navigator.clipboard.writeText(text).then(() => {
    const toast = document.getElementById('copiedToast');
    if (toast) {
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 2200);
    }
  });
}

function switchOltTab(tabName) {
  activeSubTab = tabName;
  ['onus', 'unauth', 'cards', 'oid'].forEach(t => {
    const pane = document.getElementById('tab-pane-' + t);
    if (pane) pane.classList.toggle('active', t === tabName);
  });
  document.getElementById('tabBtnOnuList')?.classList.toggle('active', tabName === 'onus');
  document.getElementById('tabBtnUnauth')?.classList.toggle('active', tabName === 'unauth');
  document.getElementById('tabBtnCards')?.classList.toggle('active', tabName === 'cards');
  document.getElementById('tabBtnOid')?.classList.toggle('active', tabName === 'oid');
}

async function loadOltDashboard(id) {
  if (!id) return;
  
  const overlay = document.getElementById('loading-overlay');
  const refreshIcon = document.getElementById('refreshIcon');
  if (overlay) overlay.style.display = 'flex';
  if (refreshIcon) refreshIcon.classList.add('spin');
  
  try {
    const url = (id === 'all') ? `/admin/olts/all/stats?full=true` : `/admin/olts/${id}/stats?full=true`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(I18N.serverConnectFailed);
    const stats = await res.json();
    currentStats = stats;
    
    // KPI Cards
    const total = stats.onus_total || 0;
    const online = stats.onus_online || 0;
    const offline = stats.onus_offline || 0;
    const weak = stats.onus_weak || 0;
    
    document.getElementById('stat-total-onu').innerText = total;
    document.getElementById('stat-online-onu').innerText = online;
    document.getElementById('stat-offline-onu').innerText = offline;
    document.getElementById('stat-weak-onu').innerText = weak;
    
    const onlinePct = total > 0 ? Math.round((online / total) * 100) : 0;
    const offlinePct = total > 0 ? (100 - onlinePct) : 0;
    document.getElementById('stat-online-percent').innerText = `${onlinePct}%`;
    document.getElementById('stat-offline-percent').innerText = `${offlinePct}%`;
    
    // Sub-tab Badges
    document.getElementById('badgeOnuCount').innerText = total;
    document.getElementById('badgeUnauthCount').innerText = (stats.unauth_onus || []).length;
    document.getElementById('badgeCardsCount').innerText = (stats.cards || []).length;
    
    // Telemetry strip
    if (stats.is_all) {
      document.getElementById('stat-temp').innerText = 'Agregasi ' + (stats.olts_summary?.length || 0) + ' OLT';
      document.getElementById('stat-cpu').innerText = '-';
      document.getElementById('stat-ram').innerText = '-';
      document.getElementById('stat-uptime').innerText = 'Multi-Chassis';
      document.getElementById('stat-traffic-in').innerText = '-';
      document.getElementById('stat-traffic-out').innerText = '-';
    } else {
      document.getElementById('stat-temp').innerText = stats.temp || 'N/A';
      document.getElementById('stat-cpu').innerText = stats.cpu || 'N/A';
      document.getElementById('stat-ram').innerText = stats.ram || 'N/A';
      document.getElementById('stat-uptime').innerText = stats.uptime || 'N/A';
      document.getElementById('stat-traffic-in').innerText = formatBytes(stats.uplink_rx) + '/s';
      document.getElementById('stat-traffic-out').innerText = formatBytes(stats.uplink_tx) + '/s';
    }

    // Render OID Tab Content
    renderOidTab(stats);

    // Render Unauth Tab
    renderUnauthTab(stats.unauth_onus || [], id);

    // Render Card Slot Tab
    renderCardsTab(stats.cards || []);

    // Store ONUs & Render Table
    rawOnus = stats.onus || [];
    renderOnuTable();

    // Timestamp
    const now = new Date();
    document.getElementById('last-update').innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

  } catch (e) {
    document.getElementById('onu-table-body').innerHTML = `
      <tr><td colspan="9" class="text-center p-5 text-danger">
        <i class="bi bi-exclamation-triangle" style="font-size:28px"></i><br>
        <span class="fw-bold mt-2 d-inline-block">${I18N.errorPrefix}${e.message}</span>
        <div class="mt-2"><button class="btn btn-sm btn-p" onclick="refreshCurrentOlt()">${I18N.tryAgain}</button></div>
      </td></tr>
    `;
  } finally {
    if (overlay) overlay.style.display = 'none';
    if (refreshIcon) refreshIcon.classList.remove('spin');
  }
}

function renderOnuTable() {
  const tbody = document.getElementById('onu-table-body');
  if (!tbody) return;

  let filtered = [...rawOnus];

  // Status Filter
  if (currentFilter === 'online') {
    filtered = filtered.filter(o => String(o.status || '').toLowerCase() === 'online');
  } else if (currentFilter === 'offline') {
    filtered = filtered.filter(o => String(o.status || '').toLowerCase() !== 'online');
  } else if (currentFilter === 'weak') {
    filtered = filtered.filter(o => {
      const rx = parseFloat(o.rx);
      return Number.isFinite(rx) && rx < -24;
    });
  } else if (currentFilter === 'critical') {
    filtered = filtered.filter(o => {
      const rx = parseFloat(o.rx);
      return Number.isFinite(rx) && rx < -27;
    });
  }

  // Text Search
  if (currentSearch) {
    const q = currentSearch.toLowerCase();
    filtered = filtered.filter(o => {
      const name = String(o.name || '').toLowerCase();
      const sn = String(o.sn || '').toLowerCase();
      const id = String(o.id || o.index || '').toLowerCase();
      const cust = String(o.customer_name || '').toLowerCase();
      return name.includes(q) || sn.includes(q) || id.includes(q) || cust.includes(q);
    });
  }

  if (filtered.length === 0) {
    tbody.innerHTML = `
      <tr><td colspan="9" class="text-center p-5 text-muted">
        <i class="bi bi-search" style="font-size:32px; display:block; margin-bottom:10px; opacity:0.5;"></i>
        ${rawOnus.length === 0 ? (currentStats?.error || I18N.noOnuData) : 'Tidak ada data ONU yang cocok dengan filter atau kata kunci pencarian.'}
      </td></tr>
    `;
    return;
  }

  tbody.innerHTML = filtered.map((onu, index) => {
    const statusVal = String(onu.status || '');
    const isOnline = statusVal.toLowerCase() === 'online';
    const statusClass = isOnline ? 'pill-up' : 'pill-down';
    
    const rxVal = parseFloat(onu.rx);
    let rxClass = 'rx-good';
    if (!Number.isFinite(rxVal)) rxClass = 'rx-muted';
    else if (rxVal < -27) rxClass = 'rx-danger';
    else if (rxVal < -24) rxClass = 'rx-warning';

    const targetOltId = onu.olt_id || document.getElementById('olt-selector').value;
    const oltBadge = onu.olt_name ? `<span class="brand-badge brand-generic me-1">${onu.olt_name}</span>` : '';
    const custBadge = onu.customer_name 
      ? `<div style="font-size:11.5px;color:#38bdf8;font-weight:600;margin-top:2px;"><i class="bi bi-person-fill"></i> ${onu.customer_name}</div>` 
      : '';

    return `
      <tr>
        <td style="color:var(--muted); font-size:12px;">${index + 1}</td>
        <td>${oltBadge}<span class="sn-code" onclick="copyToClipboard('${onu.id || onu.index}')" title="Klik untuk salin">${onu.id || onu.index || '-'}</span></td>
        <td>
          <div style="font-weight:700; color:var(--text);">${onu.name || '-'}</div>
          ${custBadge}
        </td>
        <td>
          <span class="sn-code" onclick="copyToClipboard('${onu.sn}')" title="Klik untuk salin">
            <i class="bi bi-copy" style="font-size:10px; opacity:0.6;"></i> ${onu.sn || '-'}
          </span>
        </td>
        <td>
          <span class="status-pill-v3 ${statusClass}">
            <i class="bi bi-circle-fill" style="font-size:6px;"></i> ${formatStatus(statusVal) || '-'}
          </span>
          ${!isOnline && onu.offline_reason ? `<div class="text-danger small mt-1" style="font-size: 11px; font-weight: 600;"><i class="bi bi-exclamation-octagon"></i> ${onu.offline_reason}</div>` : ''}
        </td>
        <td><span class="rx-badge rx-muted">${onu.tx || 'N/A'}</span></td>
        <td><span class="rx-badge ${rxClass}">${onu.rx || 'N/A'}</span></td>
        <td><span class="small text-muted" style="font-family:'JetBrains Mono',monospace;">${onu.distance != null ? onu.distance : '-'}</span></td>
        <td style="text-align:right">
          <div class="d-flex justify-content-end align-items-center gap-1">
            <button class="btn btn-sm btn-outline-primary py-1 px-2" onclick="configureWanPrompt('${targetOltId}', '${onu.index}', '${onu.name || ''}', '${onu.sn || ''}')" style="font-size: 11.5px; border-radius:7px;">
              <i class="bi bi-globe"></i> WAN
            </button>
            <button class="btn-act btn-rename" onclick="renameOnuPrompt('${targetOltId}', '${onu.index}', '${onu.name || ''}')" title="${I18N.renameTitle}">
              <i class="bi bi-pencil-square"></i>
            </button>
            <button class="btn-act btn-reboot" onclick="rebootOnu('${targetOltId}', '${onu.index}')" title="${I18N.rebootTitle}">
              <i class="bi bi-arrow-clockwise"></i>
            </button>
          </div>
        </td>
      </tr>
    `;
  }).join('');
}

function renderUnauthTab(unauthList, currentOltId) {
  const tbody = document.getElementById('unauth-table-body');
  if (!tbody) return;

  if (unauthList.length === 0) {
    tbody.innerHTML = `
      <tr><td colspan="5" class="text-center p-5 text-muted">
        <i class="bi bi-shield-check text-success" style="font-size:32px; display:block; margin-bottom:8px;"></i>
        Semua ONU di OLT ini telah terotorisasi dan aktif.
      </td></tr>
    `;
    return;
  }

  tbody.innerHTML = unauthList.map(onu => {
    const targetOltId = onu.olt_id || currentOltId;
    return `
      <tr>
        <td><span class="sn-code">${onu.id || onu.index}</span></td>
        <td><span class="sn-code" onclick="copyToClipboard('${onu.sn}')" title="Salin SN"><i class="bi bi-copy"></i> ${onu.sn}</span></td>
        <td><span class="brand-badge brand-generic">${onu.type || 'ONU'}</span></td>
        <td>${onu.olt_name ? `<span class="brand-badge brand-zte">${onu.olt_name}</span>` : '-'}</td>
        <td style="text-align:right;">
          <button class="btn btn-sm btn-p" onclick="authorizeOnuPrompt('${targetOltId}', '${onu.index}', '${onu.sn}')">
            <i class="bi bi-check-circle me-1"></i> Otorisasi Sekarang
          </button>
        </td>
      </tr>
    `;
  }).join('');
}

function renderCardsTab(cards) {
  const tbody = document.getElementById('card-table-body');
  if (!tbody) return;

  if (cards.length === 0) {
    tbody.innerHTML = `
      <tr><td colspan="7" class="text-center p-4 text-muted">
        Informasi card slot tidak tersedia pada tipe OLT atau profil SNMP saat ini.
      </td></tr>
    `;
    return;
  }

  tbody.innerHTML = cards.map(c => {
    const isUp = c.status === 'INSERVICE' || c.status === 'ONLINE';
    return `
      <tr>
        <td><strong>Slot ${c.index}</strong></td>
        <td><span class="brand-badge brand-zte">${c.type}</span></td>
        <td><span class="status-pill-v3 ${isUp ? 'pill-up' : 'pill-down'}">${c.status}</span></td>
        <td><code>${c.ports || '-'}</code></td>
        <td><span class="sn-code">${c.serial || '-'}</span></td>
        <td><span style="font-family:monospace">${c.cpu || '-'}</span></td>
        <td><span style="font-family:monospace">${c.ram || '-'}</span></td>
      </tr>
    `;
  }).join('');
}

function renderOidTab(stats) {
  const oidTableBody = document.getElementById('oid-table-body');
  const oidBrandBadge = document.getElementById('oid-brand-badge');
  const oidProfileName = document.getElementById('oid-profile-name');
  const oidHost = document.getElementById('oid-host');
  const oidPort = document.getElementById('oid-port');
  const oidCommunity = document.getElementById('oid-community');

  if (stats.is_all && stats.olts_summary && stats.olts_summary.length > 0) {
    oidBrandBadge.innerText = 'MULTI OLT';
    oidProfileName.innerText = stats.olts_summary.length + ' Perangkat OLT Terdaftar';
    oidHost.innerText = 'Multi-Host';
    oidPort.innerText = '161';
    oidCommunity.innerText = 'Various';

    let rowsHtml = '';
    stats.olts_summary.forEach((oSummary, idx) => {
      const prof = oSummary.activeProfile;
      const brand = (oSummary.brand || 'N/A').toUpperCase();
      rowsHtml += `
        <tr style="border-top:2px solid var(--border); background:rgba(255,255,255,0.03);">
          <td colspan="2" style="color:#38bdf8; font-weight:bold; padding-top:10px;">
            OLT #${idx+1}: ${oSummary.name} (${oSummary.host}) - Brand: ${brand} [${oSummary.status}]
          </td>
        </tr>
        <tr><td>Profil SNMP Aktif</td><td><code>${prof ? prof.name : (oSummary.error || 'Pending')}</code></td></tr>
        <tr><td>OID Status Table</td><td><code>${prof ? prof.status_table : '-'}</code></td></tr>
        <tr><td>OID Name Table</td><td><code>${prof ? prof.name_table : '-'}</code></td></tr>
        <tr><td>OID Serial Table</td><td><code>${prof ? prof.sn_table : '-'}</code></td></tr>
        <tr><td>OID RX Power Table</td><td><code>${prof ? (prof.rx_power_table || '-') : '-'}</code></td></tr>
      `;
    });
    oidTableBody.innerHTML = rowsHtml;

  } else if (stats.activeProfile) {
    const prof = stats.activeProfile;
    const sysOids = stats.systemOids || {};
    const cfg = stats.snmpConfig || {};

    oidBrandBadge.innerText = (cfg.brand || stats.brand || 'HIOSO').toUpperCase();
    oidProfileName.innerText = prof.name || 'Custom SNMP';
    oidHost.innerText = cfg.host || stats.host || '-';
    oidPort.innerText = cfg.port || '161';
    oidCommunity.innerText = cfg.community || 'public';

    oidTableBody.innerHTML = `
      <tr><td>OID Probe Autodeteksi</td><td><code style="color:#10b981">${prof.probe_oid || '-'}</code></td></tr>
      <tr><td>OID Tabel Status ONU</td><td><code>${prof.status_table || '-'}</code></td></tr>
      <tr><td>OID Tabel Nama ONU</td><td><code>${prof.name_table || '-'}</code></td></tr>
      <tr><td>OID Tabel Serial Number (SN)</td><td><code>${prof.sn_table || '-'}</code></td></tr>
      <tr><td>OID Tabel Redaman RX Power</td><td><code>${prof.rx_power_table || '-'}</code></td></tr>
      <tr><td>OID Tabel Redaman TX Power</td><td><code>${prof.tx_power_table || '-'}</code></td></tr>
      <tr><td>OID Tabel Jarak ONU (Distance)</td><td><code>${prof.distance_table || '-'}</code></td></tr>
      <tr><td>OID Tabel Alasan Offline</td><td><code>${prof.offline_reason_table || '-'}</code></td></tr>
      <tr><td>OID Suhu / CPU / RAM System</td><td><code>${sysOids.temp || '-' } / ${sysOids.cpu || '-'} / ${sysOids.ram || '-'}</code></td></tr>
      <tr><td>OID Traffic Uplink In / Out</td><td><code>${sysOids.uplink_rx || '-'} / ${sysOids.uplink_tx || '-'}</code></td></tr>
    `;
  } else {
    oidTableBody.innerHTML = `<tr><td colspan="2" class="text-center p-3 text-muted">Profil OID belum aktif atau OLT sedang offline.</td></tr>`;
  }
}

function filterByKpi(filterType, cardEl) {
  currentFilter = filterType;
  // Update KPI card styles
  document.querySelectorAll('.kpi-card').forEach(c => c.classList.remove('active-filter'));
  if (cardEl) cardEl.classList.add('active-filter');

  // Update status pills
  document.querySelectorAll('.status-pill-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.filter === filterType);
  });

  // Switch to ONU list tab if not active
  switchOltTab('onus');
  renderOnuTable();
}

function filterByStatusPill(filterType) {
  currentFilter = filterType;
  document.querySelectorAll('.status-pill-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.filter === filterType);
  });

  // Sync with KPI cards
  document.querySelectorAll('.kpi-card').forEach(c => c.classList.remove('active-filter'));
  if (filterType === 'all') document.getElementById('kpiCardAll')?.classList.add('active-filter');
  else if (filterType === 'online') document.getElementById('kpiCardOnline')?.classList.add('active-filter');
  else if (filterType === 'offline') document.getElementById('kpiCardOffline')?.classList.add('active-filter');
  else if (filterType === 'weak') document.getElementById('kpiCardWeak')?.classList.add('active-filter');

  renderOnuTable();
}

function handleSearchInput() {
  const input = document.getElementById('onu-search');
  currentSearch = input.value.trim();
  const clearBtn = document.getElementById('searchClearBtn');
  if (clearBtn) clearBtn.style.display = currentSearch ? 'block' : 'none';
  renderOnuTable();
}

function clearSearch() {
  const input = document.getElementById('onu-search');
  input.value = '';
  currentSearch = '';
  document.getElementById('searchClearBtn').style.display = 'none';
  renderOnuTable();
}

function formatStatus(statusVal) {
  const v = String(statusVal || '').trim();
  if (!v) return '';
  if (v.toLowerCase() === 'online') return I18N.statusOnline;
  if (v.toLowerCase() === 'offline') return I18N.statusOffline;
  return v;
}

function handleOltChange() {
  const id = document.getElementById('olt-selector').value;
  if (id) loadOltDashboard(id);
}

function refreshCurrentOlt() {
  handleOltChange();
}

function runDiagnosticPrompt() {
  const sel = document.getElementById('olt-selector');
  if (!sel || !sel.value || sel.value === 'all') {
    alert('Pilih salah satu perangkat OLT spesifik terlebih dahulu pada dropdown untuk menjalankan test SNMP.');
    return;
  }
  testOltSnmpDirect(sel.value);
}

function testCurrentOltSnmp() {
  runDiagnosticPrompt();
}

async function testOltSnmpDirect(oltId) {
  openModal('testSnmpModal');
  const body = document.getElementById('testSnmpModalBody');
  body.innerHTML = `
    <div class="text-center p-4">
      <div class="spinner-border text-primary" role="status"></div>
      <div class="mt-2 text-muted small">Mengirim query SNMP Get ke OLT...</div>
    </div>
  `;

  try {
    const res = await fetch(`/admin/olts/${oltId}/test-snmp`, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      body.innerHTML = `
        <div class="text-center mb-3">
          <div style="width:54px; height:54px; border-radius:50%; background:rgba(16,185,129,0.15); color:#10b981; display:inline-flex; align-items:center; justify-content:center; font-size:26px;">
            <i class="bi bi-check2-circle"></i>
          </div>
          <h5 class="fw-bold mt-2 text-success" style="font-size:16px;">Koneksi SNMP Berhasil</h5>
          <span class="badge bs">Latency: ${data.latencyMs} ms</span>
        </div>
        <div class="diag-box">
          <div class="diag-item">
            <span class="label">Host:</span>
            <span class="val">${data.host}:${data.port}</span>
          </div>
          <div class="diag-item">
            <span class="label">System Name:</span>
            <span class="val">${data.sysName || '-'}</span>
          </div>
          <div class="diag-item">
            <span class="label">System Uptime:</span>
            <span class="val text-primary">${data.sysUpTime || '-'}</span>
          </div>
          <div class="diag-item" style="flex-direction:column; align-items:flex-start; gap:4px;">
            <span class="label">System Description (Firmware):</span>
            <span class="val" style="font-size:11.5px; word-break:break-all;">${data.sysDescr || '-'}</span>
          </div>
        </div>
      `;
    } else {
      body.innerHTML = `
        <div class="text-center mb-3">
          <div style="width:54px; height:54px; border-radius:50%; background:rgba(239,68,68,0.15); color:#ef4444; display:inline-flex; align-items:center; justify-content:center; font-size:26px;">
            <i class="bi bi-x-circle"></i>
          </div>
          <h5 class="fw-bold mt-2 text-danger" style="font-size:16px;">Koneksi SNMP Gagal</h5>
          <p class="text-muted small mb-0">${data.error || 'OLT tidak merespons SNMP.'}</p>
        </div>
        <div class="alert alert-d" style="font-size:12px;">
          Pastikan IP host dapat di-ping, port SNMP (161) terbuka, dan SNMP community string sesuai dengan konfigurasi OLT.
        </div>
      `;
    }
  } catch (err) {
    body.innerHTML = `
      <div class="text-center text-danger p-3">
        <i class="bi bi-exclamation-triangle" style="font-size:32px;"></i>
        <div class="fw-bold mt-2">Error Pengujian</div>
        <p class="small text-muted">${err.message}</p>
      </div>
    `;
  }
}

function exportOnuCsv() {
  if (!rawOnus || rawOnus.length === 0) {
    alert('Tidak ada data ONU untuk diexport.');
    return;
  }

  const headers = ['No', 'Port_ID', 'Nama_ONU', 'Pelanggan', 'Serial_Number', 'Status', 'TX_Power_dBm', 'RX_Power_dBm', 'Jarak_FO', 'Offline_Reason'];
  const rows = rawOnus.map((o, idx) => [
    idx + 1,
    `"${o.id || o.index || ''}"`,
    `"${(o.name || '').replace(/"/g, '""')}"`,
    `"${(o.customer_name || '').replace(/"/g, '""')}"`,
    `"${o.sn || ''}"`,
    `"${o.status || ''}"`,
    `"${o.tx || ''}"`,
    `"${o.rx || ''}"`,
    `"${o.distance != null ? o.distance : ''}"`,
    `"${(o.offline_reason || '').replace(/"/g, '""')}"`
  ]);

  const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
  const encodedUri = encodeURI(csvContent);
  const link = document.createElement('a');
  link.setAttribute('href', encodedUri);
  link.setAttribute('download', `ONU_Report_${new Date().toISOString().slice(0, 10)}.csv`);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
}

async function renameOnuPrompt(oltId, index, oldName) {
  const newName = prompt(I18N.renamePrompt, oldName);
  if (!newName || newName === oldName) return;
  try {
    const res = await fetch(`/admin/olts/${oltId}/onu/${index}/rename`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ name: newName })
    });
    const data = await res.json();
    if (data.success) { refreshCurrentOlt(); } else { alert(I18N.failedPrefix + data.error); }
  } catch (e) { alert(I18N.errorPrefix + e.message); }
}

async function rebootOnu(oltId, index) {
  if (!confirm(I18N.confirmReboot)) return;
  try {
    const res = await fetch(`/admin/olts/${oltId}/onu/${index}/reboot`, { method: 'POST' });
    const data = await res.json();
    if (data.success) { alert(I18N.rebootSent); } else { alert(I18N.failedPrefix + data.error); }
  } catch (e) { alert(I18N.errorPrefix + e.message); }
}

async function authorizeOnuPrompt(oltId, index, sn) {
  const name = prompt('Masukkan Nama Pelanggan / Deskripsi ONU:', '');
  if (!name) return;
  const vlan = prompt('Masukkan VLAN ID:', '100');
  if (!vlan) return;

  const overlay = document.getElementById('loading-overlay');
  if (overlay) overlay.style.display = 'flex';

  try {
    const res = await fetch(`/admin/olts/${oltId}/onu/authorize`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({ index, sn, name, vlan })
    });
    const data = await res.json();
    if (data.success) {
      alert('ONU berhasil diotorisasi!');
      refreshCurrentOlt();
    } else {
      alert(I18N.failedPrefix + data.error);
    }
  } catch (e) {
    alert(I18N.errorPrefix + e.message);
  } finally {
    if (overlay) overlay.style.display = 'none';
  }
}

function configureWanPrompt(oltId, index, name, sn) {
  document.getElementById('wan_olt_id').value = oltId;
  document.getElementById('wan_onu_index').value = index;
  document.getElementById('wan_onu_name').value = name;
  document.getElementById('wan_onu_sn').value = sn;
  document.getElementById('wan_method').value = 'telnet';
  onWanMethodChange();
  openModal('wanConfigModal');
}

function onWanMethodChange() {
  const m = document.getElementById('wan_method').value;
  const hint = document.getElementById('wan_goapi_hint');
  const extra = document.getElementById('wan_goapi_extra');
  const modeSel = document.getElementById('wan_mode');
  if (hint) hint.style.display = m === 'go-api' ? 'block' : 'none';
  if (extra) extra.style.display = m === 'go-api' ? 'block' : 'none';
  if (m === 'go-api' && modeSel) {
    modeSel.value = 'Bridge';
    toggleWanFields();
  }
}

function toggleWanFields() {
  const mode = document.getElementById('wan_mode').value;
  document.getElementById('pppoe_fields').style.display = mode === 'PPPoE' ? 'block' : 'none';
}

async function submitWanConfig(e) {
  e.preventDefault();
  const oltId = document.getElementById('wan_olt_id').value;
  const method = document.getElementById('wan_method').value;
  const mode = document.getElementById('wan_mode').value;
  if (method === 'go-api' && mode !== 'Bridge') {
    alert('Metode go-api-c320 pada integrasi ini hanya untuk mode Bridge + VLAN. Pilih Bridge atau ganti metode.');
    return;
  }
  const lans = Array.from(document.querySelectorAll('input[name="wan_lan"]:checked')).map(cb => cb.value);
  const ssids = Array.from(document.querySelectorAll('input[name="wan_ssid"]:checked')).map(cb => cb.value);
  
  const payload = {
    index: document.getElementById('wan_onu_index').value,
    sn: document.getElementById('wan_onu_sn').value,
    method,
    mode,
    vlan: document.getElementById('wan_vlan').value,
    username: document.getElementById('wan_username').value,
    password: document.getElementById('wan_password').value,
    lans: lans.join(','),
    ssids: ssids.join(',')
  };
  if (method === 'go-api') {
    payload.cvlan = document.getElementById('wan_cvlan').value;
    payload.vlan_mode = document.getElementById('wan_vlan_mode').value;
    payload.priority = document.getElementById('wan_priority').value;
  }

  const overlay = document.getElementById('loading-overlay');
  if (overlay) overlay.style.display = 'flex';

  try {
    const res = await fetch(`/admin/olts/${oltId}/onu/configure-wan`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(payload)
    });
    const data = await res.json();
    if (data.success) {
      alert('Konfigurasi WAN berhasil diterapkan!');
      closeModal('wanConfigModal');
      refreshCurrentOlt();
    } else {
      alert(I18N.failedPrefix + data.error);
    }
  } catch (e) {
    alert(I18N.errorPrefix + e.message);
  } finally {
    if (overlay) overlay.style.display = 'none';
  }
}

document.addEventListener('DOMContentLoaded', () => {
  const selector = document.getElementById('olt-selector');
  if (selector && selector.value) {
    handleOltChange();
  }
});
</script>
</body>
