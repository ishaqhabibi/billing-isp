<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.olt_management', 'Manajemen OLT') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.6">
  <style>
    /* ── DASHBOARD & TELEMETRY STYLING ── */
    .olt-dashboard { display: flex; flex-direction: column; gap: 20px; }
    
    /* Device Header Card */
    .olt-header-bar {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    }
    
    .olt-select-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    
    .custom-select-v2 {
      background: var(--bg3);
      color: var(--text);
      padding: 9px 14px;
      border-radius: 9px;
      border: 1px solid var(--border);
      font-weight: 600;
      font-size: 13.5px;
      min-width: 270px;
      outline: none;
      transition: all 0.2s;
    }
    .custom-select-v2:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(0, 82, 204, 0.2);
    }

    /* Telemetry Strip */
    .telemetry-strip {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 16px;
      font-size: 12.5px;
    }
    .telemetry-item {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--muted);
    }
    .telemetry-item strong {
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
    }
    .telemetry-item i { color: var(--primary); font-size: 14px; }
    .telemetry-sep { width: 1px; height: 16px; background: var(--border); }

    /* ── KPI EXECUTIVE STATS GRID ── */
    .kpi-grid { 
      display: grid; 
      grid-template-columns: repeat(4, 1fr); 
      gap: 16px; 
    }
    @media(max-width: 1024px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 560px) { .kpi-grid { grid-template-columns: 1fr; } }

    .kpi-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px 20px;
      position: relative;
      overflow: hidden;
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
    }
    .kpi-card:hover {
      transform: translateY(-3px);
      border-color: rgba(255,255,255,0.2);
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }
    .kpi-card.active-filter {
      border-color: var(--primary) !important;
      background: rgba(0, 82, 204, 0.12) !important;
      box-shadow: 0 0 0 1px var(--primary);
    }
    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
    }
    .kpi-card.c-primary::before { background: linear-gradient(90deg, #0052cc, #38bdf8); }
    .kpi-card.c-success::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .kpi-card.c-danger::before  { background: linear-gradient(90deg, #ef4444, #f87171); }
    .kpi-card.c-warning::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }

    .kpi-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .kpi-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }
    .kpi-icon {
      width: 36px;
      height: 36px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .kpi-card.c-primary .kpi-icon { background: rgba(0, 82, 204, 0.14); color: #38bdf8; }
    .kpi-card.c-success .kpi-icon { background: rgba(16, 185, 129, 0.14); color: #10b981; }
    .kpi-card.c-danger .kpi-icon  { background: rgba(239, 68, 68, 0.14); color: #ef4444; }
    .kpi-card.c-warning .kpi-icon { background: rgba(245, 158, 11, 0.14); color: #f59e0b; }

    .kpi-body {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 6px;
    }
    .kpi-val {
      font-size: 28px;
      font-weight: 800;
      line-height: 1;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
    .kpi-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 999px;
    }
    .kpi-footer {
      font-size: 11px;
      color: var(--muted);
      border-top: 1px dashed var(--border);
      padding-top: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* ── SEGMENTED SUB-TABS (Clean Architecture) ── */
    .segmented-control {
      display: inline-flex;
      background: var(--bg3);
      padding: 4px;
      border-radius: 12px;
      border: 1px solid var(--border);
      gap: 4px;
      flex-wrap: wrap;
    }
    .seg-btn {
      background: transparent;
      border: none;
      outline: none;
      padding: 8px 18px;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .seg-btn:hover { color: var(--text); }
    .seg-btn.active {
      background: var(--bg2);
      color: var(--text);
      font-weight: 700;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
      border: 1px solid var(--border);
    }
    .seg-badge {
      font-size: 10.5px;
      font-weight: 700;
      padding: 1px 7px;
      border-radius: 999px;
      background: rgba(255,255,255,0.08);
      color: var(--text);
    }
    .seg-badge-warn {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.4);
    }

    /* ── CARD WRAPPER & MODERN TABLES ── */
    .olt-main-box {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.14);
      position: relative;
    }
    .olt-tab-pane {
      display: none;
      padding: 22px;
      animation: fadeIn 0.22s ease;
    }
    .olt-tab-pane.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* Filter & Search Toolbar */
    .filter-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 18px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }
    .filter-left {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      flex: 1;
    }
    .filter-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .search-box-unified {
      position: relative;
      min-width: 260px;
      max-width: 380px;
      flex: 1;
    }
    .search-box-unified i.bi-search {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: 13px;
      pointer-events: none;
    }
    .search-box-unified .fc {
      padding-left: 36px;
      padding-right: 32px;
      height: 38px;
      border-radius: 9px;
      font-size: 13px;
      background: var(--bg3);
      color: var(--text);
      border: 1px solid var(--border);
    }
    .search-clear-btn {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 2px 6px;
      font-size: 14px;
      display: none;
    }

    .status-pills { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .status-pill-btn {
      border: 1px solid var(--border);
      background: var(--bg3);
      color: var(--muted);
      padding: 5px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .status-pill-btn:hover { border-color: rgba(255,255,255,0.2); color: var(--text); }
    .status-pill-btn.active {
      background: rgba(0, 82, 204, 0.18);
      border-color: var(--primary);
      color: #38bdf8;
      font-weight: 700;
    }

    /* Table Design */
    .table-responsive { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    table.onu-modern-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    table.onu-modern-table th {
      background: var(--bg3);
      color: var(--muted);
      font-weight: 700;
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 12px 14px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    table.onu-modern-table th:first-child { border-top-left-radius: 9px; border-bottom-left-radius: 9px; }
    table.onu-modern-table th:last-child { border-top-right-radius: 9px; border-bottom-right-radius: 9px; text-align: right; }
    table.onu-modern-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      color: var(--text);
      vertical-align: middle;
    }
    table.onu-modern-table tbody tr { transition: background 0.15s ease; }
    table.onu-modern-table tbody tr:hover td { background: rgba(255,255,255,0.025); }

    /* Badges & Monospace Tags */
    .sn-code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      background: var(--bg3);
      border: 1px solid var(--border);
      padding: 3px 7px;
      border-radius: 6px;
      color: #38bdf8;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s;
    }
    .sn-code:hover {
      border-color: #38bdf8;
      background: rgba(56, 189, 248, 0.1);
    }

    .rx-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 11.5px;
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
    }
    .rx-good { background: rgba(16, 185, 129, 0.14); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
    .rx-warning { background: rgba(245, 158, 11, 0.14); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .rx-danger { background: rgba(239, 68, 68, 0.16); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.35); }
    .rx-muted { background: rgba(255, 255, 255, 0.05); color: var(--muted); border: 1px solid var(--border); }

    .status-pill-v3 {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }
    .pill-up { background: rgba(16, 185, 129, 0.14); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
    .pill-down { background: rgba(239, 68, 68, 0.14); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }

    .brand-badge {
      font-weight: 700;
      text-transform: uppercase;
      font-size: 10px;
      padding: 2px 7px;
      border-radius: 5px;
      letter-spacing: 0.3px;
    }
    .brand-zte { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
    .brand-huawei { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .brand-vsol { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .brand-cdata { background: rgba(234, 88, 12, 0.15); color: #fb923c; border: 1px solid rgba(234, 88, 12, 0.3); }
    .brand-hioso { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .brand-hsgq { background: rgba(124, 58, 237, 0.15); color: #a78bfa; border: 1px solid rgba(124, 58, 237, 0.3); }
    .brand-fiberhome { background: rgba(13, 148, 136, 0.15); color: #2dd4bf; border: 1px solid rgba(13, 148, 136, 0.3); }
    .brand-bdcom { background: rgba(219, 39, 119, 0.15); color: #f472b6; border: 1px solid rgba(219, 39, 119, 0.3); }
    .brand-generic { background: rgba(255, 255, 255, 0.08); color: var(--muted); border: 1px solid var(--border); }

    /* Action Buttons in Table */
    .btn-act {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border);
      background: var(--bg3);
      color: var(--muted);
      cursor: pointer;
      transition: all 0.18s ease;
      font-size: 13.5px;
    }
    .btn-act:hover { color: var(--text); border-color: rgba(255,255,255,0.25); transform: translateY(-1px); }
    .btn-act.btn-reboot:hover { background: rgba(239, 68, 68, 0.15); color: #ef4444; border-color: rgba(239, 68, 68, 0.4); }
    .btn-act.btn-rename:hover { background: rgba(0, 82, 204, 0.15); color: #38bdf8; border-color: var(--primary); }
    .btn-act.btn-wan:hover { background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.4); }

    /* Loading Overlay */
    .loading-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(3px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 20;
      border-radius: 16px;
    }

    /* Diagnostics Result Box */
    .diag-box {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      margin-top: 14px;
    }
    .diag-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px dashed var(--border);
      font-size: 13px;
    }
    .diag-item:last-child { border-bottom: none; }
    .diag-item .label { color: var(--muted); }
    .diag-item .val { font-weight: 700; color: var(--text); font-family: 'JetBrains Mono', monospace; }

    /* Copy tooltip */
    .copied-toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #10b981;
      color: #fff;
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 13px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
      z-index: 99999;
      display: none;
      animation: fadeIn 0.2s ease;
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'olts', company }) %>

<div class="mw">
  <!-- Topbar Header -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-hdd-rack text-primary"></i>
      <span><%= t('admin.nav.olt_management', 'Manajemen OLT') %></span>
    </div>
    <div class="tb-right">
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-g btn-sm" onclick="runDiagnosticPrompt()" title="Diagnostik SNMP Cepat">
          <i class="bi bi-activity"></i> Test SNMP
        </button>
        <button class="btn btn-g btn-sm" onclick="openModal('manageOltsModal')">
          <i class="bi bi-gear"></i> <%= t('admin.olts.manage', 'Kelola OLT') %>
        </button>
        <button class="btn btn-p btn-sm" onclick="openModal('addOltModal')">
          <i class="bi bi-plus-lg"></i> <%= t('admin.olts.add', 'Tambah OLT') %>
        </button>
      </div>
    </div>
  </div>

  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'d':'s' %>"><%= msg.text %></div>
    <% } %>

    <!-- UNIFIED SUB-NAVIGATION TABS (Konsistensi Antar Modul Fiber Optik) -->
    <div class="mtabs" style="margin-bottom:20px;">
      <a href="/admin/olts" class="mtab active"><i class="bi bi-hdd-rack"></i> Manajemen OLT</a>
      <a href="/admin/onu-provision" class="mtab"><i class="bi bi-hdd-network-fill"></i> Provisioning ONU</a>
      <a href="/admin/acs" class="mtab"><i class="bi bi-broadcast"></i> GenieACS Pro</a>
      <a href="/admin/onu-stickers" class="mtab"><i class="bi bi-printer"></i> Stiker Modem ONU</a>
    </div>

    <% if (olts.length === 0) { %>
      <!-- HERO EMPTY STATE WHEN NO OLT CONFIGURED -->
      <div class="olt-main-box" style="padding: 60px 24px; text-align: center; margin-top: 10px;">
        <div style="width: 72px; height: 72px; border-radius: 18px; background: rgba(0, 82, 204, 0.12); color: #38bdf8; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 20px;">
          <i class="bi bi-hdd-rack"></i>
        </div>
        <h3 style="font-weight: 800; color: var(--text); margin-bottom: 10px;">Belum Ada Perangkat OLT Terdaftar</h3>
        <p style="color: var(--muted); max-width: 520px; margin: 0 auto 24px; font-size: 14px; line-height: 1.6;">
          Integrasikan OLT Anda (ZTE, Huawei, HIOSO, HSGQ, VSOL, Fiberhome, atau C-Data) untuk memantau status ONU real-time, redaman optik (RX/TX Power), deteksi ONU unauth, dan provisioning otomatis.
        </p>
        <button class="btn btn-p" onclick="openModal('addOltModal')">
          <i class="bi bi-plus-lg me-1"></i> Tambah Perangkat OLT Pertama
        </button>
      </div>
    <% } else { %>

    <div class="olt-dashboard">
      <!-- OLT Selector & Telemetry Bar -->
      <div class="olt-header-bar">
        <div class="olt-select-wrap">
          <label class="fw-bold text-muted small text-uppercase mb-0">
            <i class="bi bi-hdd-network me-1"></i> Perangkat:
          </label>
          <select id="olt-selector" class="custom-select-v2" onchange="handleOltChange()">
            <option value="all">🌐 Semua OLT (Agregasi Seluruh Jaringan)</option>
            <% olts.forEach(olt => { %>
              <option value="<%= olt.id %>" data-brand="<%= olt.brand %>" data-host="<%= olt.host %>" <%= !olt.is_active ? 'disabled' : '' %>>
                <%= olt.name %> (<%= (olt.brand || '').toUpperCase() %> - <%= olt.host %>) <%= !olt.is_active ? '[Nonaktif]' : '' %>
              </option>
            <% }) %>
          </select>
          <button class="btn btn-g btn-sm" id="btnTestSnmpHeader" onclick="testCurrentOltSnmp()" title="Test Koneksi SNMP">
            <i class="bi bi-broadcast"></i> Test SNMP
          </button>
        </div>

        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-sm btn-p" onclick="refreshCurrentOlt()" id="btnRefreshOlt">
            <i class="bi bi-arrow-clockwise" id="refreshIcon"></i> <%= t('admin.olts.refresh_data', 'Refresh Data') %>
          </button>
        </div>
      </div>

      <!-- Telemetry Hardware Strip -->
      <div class="telemetry-strip" id="telemetryStrip">
        <div class="telemetry-item">
          <i class="bi bi-thermometer-half"></i> Suhu OLT: <strong id="stat-temp">-</strong>
        </div>
        <div class="telemetry-sep"></div>
        <div class="telemetry-item">
          <i class="bi bi-cpu"></i> CPU: <strong id="stat-cpu">-</strong>
        </div>
        <div class="telemetry-sep"></div>
        <div class="telemetry-item">
          <i class="bi bi-memory"></i> RAM: <strong id="stat-ram">-</strong>
        </div>
        <div class="telemetry-sep"></div>
        <div class="telemetry-item">
          <i class="bi bi-clock-history"></i> Uptime: <strong id="stat-uptime">-</strong>
        </div>
        <div class="telemetry-sep"></div>
        <div class="telemetry-item ms-auto">
          <i class="bi bi-arrow-down-up"></i> Traffic Uplink:
          <span style="color:#10b981;font-weight:700;font-family:monospace;" id="stat-traffic-in">0 B/s</span> ↓
          <span style="color:#38bdf8;font-weight:700;font-family:monospace;margin-left:4px;" id="stat-traffic-out">0 B/s</span> ↑
        </div>
      </div>

      <!-- KPI Executive Summary Cards (Click-to-Filter) -->
      <div class="kpi-grid">
        <div class="kpi-card c-primary active-filter" id="kpiCardAll" onclick="filterByKpi('all', this)" title="Klik untuk menampilkan seluruh ONU">
          <div class="kpi-header">
            <span class="kpi-label"><%= t('admin.olts.stats.total_onu', 'Total ONU') %></span>
            <div class="kpi-icon"><i class="bi bi-router"></i></div>
          </div>
          <div class="kpi-body">
            <span class="kpi-val" id="stat-total-onu">-</span>
            <span class="kpi-badge" style="background:rgba(0,82,204,0.15);color:#38bdf8;">Unit</span>
          </div>
          <div class="kpi-footer">
            <span>Terdaftar di OLT</span>
            <span style="font-weight:700;"><i class="bi bi-chevron-right"></i></span>
          </div>
        </div>

        <div class="kpi-card c-success" id="kpiCardOnline" onclick="filterByKpi('online', this)" title="Klik untuk memfilter ONU online">
          <div class="kpi-header">
            <span class="kpi-label"><%= t('admin.olts.stats.online', 'Online') %></span>
            <div class="kpi-icon"><i class="bi bi-wifi"></i></div>
          </div>
          <div class="kpi-body">
            <span class="kpi-val" id="stat-online-onu">-</span>
            <span class="kpi-badge" style="background:rgba(16,185,129,0.15);color:#10b981;" id="stat-online-percent">0%</span>
          </div>
          <div class="kpi-footer">
            <span>Terkoneksi Normal</span>
            <span style="font-weight:700;"><i class="bi bi-chevron-right"></i></span>
          </div>
        </div>

        <div class="kpi-card c-danger" id="kpiCardOffline" onclick="filterByKpi('offline', this)" title="Klik untuk memfilter ONU offline / LOS">
          <div class="kpi-header">
            <span class="kpi-label"><%= t('admin.olts.stats.offline', 'Offline / LOS') %></span>
            <div class="kpi-icon"><i class="bi bi-wifi-off"></i></div>
          </div>
          <div class="kpi-body">
            <span class="kpi-val" id="stat-offline-onu">-</span>
            <span class="kpi-badge" style="background:rgba(239,68,68,0.15);color:#ef4444;" id="stat-offline-percent">0%</span>
          </div>
          <div class="kpi-footer">
            <span>LOS / Power Off</span>
            <span style="font-weight:700;"><i class="bi bi-chevron-right"></i></span>
          </div>
        </div>

        <div class="kpi-card c-warning" id="kpiCardWeak" onclick="filterByKpi('weak', this)" title="Klik untuk memfilter redaman sinyal lemah (< -24 dBm)">
          <div class="kpi-header">
            <span class="kpi-label"><%= t('admin.olts.stats.weak_signal', 'Sinyal Lemah') %></span>
            <div class="kpi-icon"><i class="bi bi-exclamation-triangle"></i></div>
          </div>
          <div class="kpi-body">
            <span class="kpi-val" id="stat-weak-onu">-</span>
            <span class="kpi-badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;">&lt; -24 dBm</span>
          </div>
          <div class="kpi-footer">
            <span>Rentan degradasi / LOS</span>
            <span style="font-weight:700;"><i class="bi bi-chevron-right"></i></span>
          </div>
        </div>
      </div>

      <!-- Segmented Inner Sub-Tab Bar -->
      <div class="segmented-control">
        <button class="seg-btn active" id="tabBtnOnuList" onclick="switchOltTab('onus')">
          <i class="bi bi-list-check"></i> Daftar ONU Terdaftar
          <span class="seg-badge" id="badgeOnuCount">0</span>
        </button>
        <button class="seg-btn" id="tabBtnUnauth" onclick="switchOltTab('unauth')">
          <i class="bi bi-exclamation-triangle"></i> ONU Unauth
          <span class="seg-badge seg-badge-warn" id="badgeUnauthCount">0</span>
        </button>
        <button class="seg-btn" id="tabBtnCards" onclick="switchOltTab('cards')">
          <i class="bi bi-grid-3x3-gap"></i> Slot Card
          <span class="seg-badge" id="badgeCardsCount">0</span>
        </button>
        <button class="seg-btn" id="tabBtnOid" onclick="switchOltTab('oid')">
          <i class="bi bi-diagram-3"></i> Profil &amp; OID SNMP
        </button>
      </div>

      <!-- Main OLT Card Wrapper with Loading Overlay -->
      <div class="olt-main-box">
        <div id="loading-overlay" class="loading-overlay">
          <div class="text-center">
            <div class="spinner-border text-primary" role="status" style="width: 2.4rem; height: 2.4rem;"></div>
            <div class="mt-3 fw-bold text-white small" id="loadingText"><%= t('admin.olts.loading', 'Mengambil Data OLT via SNMP...') %></div>
          </div>
        </div>

        <!-- TAB 1: DAFTAR ONU TERDAFTAR -->
        <div id="tab-pane-onus" class="olt-tab-pane active">
          <!-- Filter & Action Toolbar -->
          <div class="filter-toolbar">
            <div class="filter-left">
              <div class="search-box-unified">
                <i class="bi bi-search"></i>
                <input type="text" id="onu-search" class="fc" placeholder="Cari Pelanggan, SN, Port/ID..." onkeyup="handleSearchInput()" autocomplete="off">
                <button type="button" class="search-clear-btn" id="searchClearBtn" onclick="clearSearch()">&times;</button>
              </div>

              <!-- Filter Pills -->
              <div class="status-pills">
                <button type="button" class="status-pill-btn active" data-filter="all" onclick="filterByStatusPill('all')">
                  Semua
                </button>
                <button type="button" class="status-pill-btn" data-filter="online" onclick="filterByStatusPill('online')">
                  <i class="bi bi-circle-fill text-success" style="font-size:7px"></i> Online
                </button>
                <button type="button" class="status-pill-btn" data-filter="offline" onclick="filterByStatusPill('offline')">
                  <i class="bi bi-circle-fill text-danger" style="font-size:7px"></i> Offline
                </button>
                <button type="button" class="status-pill-btn" data-filter="weak" onclick="filterByStatusPill('weak')">
                  <i class="bi bi-exclamation-triangle text-warning" style="font-size:11px"></i> Lemah (&lt; -24 dBm)
                </button>
                <button type="button" class="status-pill-btn" data-filter="critical" onclick="filterByStatusPill('critical')">
                  <i class="bi bi-lightning-charge text-danger" style="font-size:11px"></i> Kritis (&lt; -27 dBm)
                </button>
              </div>
            </div>

            <div class="filter-right">
              <button class="btn btn-g btn-sm" onclick="exportOnuCsv()" title="Export data ONU ke format CSV">
                <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
              </button>
              <div class="text-muted small ms-1" style="font-size: 11.5px;">
                <i class="bi bi-clock me-1"></i> <span id="last-update">-</span>
              </div>
            </div>
          </div>

          <!-- Table Container -->
          <div class="table-responsive" style="max-height: 650px; overflow-y: auto;">
            <table class="onu-modern-table" id="onu-table">
              <thead>
                <tr>
                  <th style="width: 40px;"><%= t('admin.olts.table.no', 'No') %></th>
                  <th><%= t('admin.olts.table.id', 'ID / Port') %></th>
                  <th>Nama ONU / Pelanggan</th>
                  <th><%= t('admin.olts.table.serial', 'Serial Number') %></th>
                  <th><%= t('admin.olts.table.status', 'Status') %></th>
                  <th><%= t('admin.olts.table.tx', 'Tx Power') %></th>
                  <th><%= t('admin.olts.table.rx', 'Rx Power') %></th>
                  <th><%= t('admin.olts.table.distance', 'Jarak FO') %></th>
                  <th style="text-align:right"><%= t('common.actions', 'Aksi') %></th>
                </tr>
              </thead>
              <tbody id="onu-table-body">
                <tr>
                  <td colspan="9" class="text-center p-5 text-muted">
                    <div style="font-size: 32px; margin-bottom: 12px;"><i class="bi bi-arrow-repeat spin"></i></div>
                    Memuat data perangkat OLT...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- TAB 2: ONU UNAUTH (BELUM TERDAFTAR) -->
        <div id="tab-pane-unauth" class="olt-tab-pane">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h5 class="fw-bold mb-1 text-warning" style="font-size: 15px;">
                <i class="bi bi-exclamation-triangle me-1"></i> ONU Belum Terotorisasi (Unauth)
              </h5>
              <p class="text-muted small mb-0">Perangkat modem baru yang terdeteksi di PON port tetapi belum terdaftar dalam database OLT.</p>
            </div>
            <button class="btn btn-g btn-sm" onclick="refreshCurrentOlt()">
              <i class="bi bi-arrow-clockwise"></i> Periksa Ulang
            </button>
          </div>

          <div class="table-responsive">
            <table class="onu-modern-table">
              <thead>
                <tr>
                  <th>PORT / PON INDEX</th>
                  <th>SERIAL NUMBER (SN)</th>
                  <th>MODEL / TYPE</th>
                  <th>OLT</th>
                  <th style="text-align: right;">AKSI PROVISION</th>
                </tr>
              </thead>
              <tbody id="unauth-table-body">
                <tr>
                  <td colspan="5" class="text-center p-4 text-muted">
                    Tidak ada ONU unauth terdeteksi.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- TAB 3: SLOT CARD / BOARD -->
        <div id="tab-pane-cards" class="olt-tab-pane">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h5 class="fw-bold mb-1 text-primary" style="font-size: 15px;">
                <i class="bi bi-grid-3x3-gap me-1"></i> Informasi Board &amp; Card Slot OLT
              </h5>
              <p class="text-muted small mb-0">Status fisik slot board kontroler, uplink modul, dan PON card di chassis OLT.</p>
            </div>
          </div>

          <div class="table-responsive">
            <table class="onu-modern-table">
              <thead>
                <tr>
                  <th>SLOT</th>
                  <th>TIPE BOARD</th>
                  <th>STATUS</th>
                  <th>JUMLAH PORT</th>
                  <th>SERIAL NUMBER</th>
                  <th>CPU LOAD</th>
                  <th>RAM</th>
                </tr>
              </thead>
              <tbody id="card-table-body">
                <tr>
                  <td colspan="7" class="text-center p-4 text-muted">
                    Data board card slot tidak tersedia pada profil SNMP ini.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- TAB 4: PROFIL & OID SNMP -->
        <div id="tab-pane-oid" class="olt-tab-pane">
          <div class="row g-3">
            <div class="col-md-4">
              <div style="background:var(--bg3); padding:16px; border-radius:12px; border:1px solid var(--border);">
                <div class="fw-bold text-muted small text-uppercase mb-3 d-flex justify-content-between align-items-center">
                  <span><i class="bi bi-hdd-rack me-1"></i> Parameter SNMP</span>
                  <span id="oid-brand-badge" class="brand-badge brand-generic">-</span>
                </div>
                <div class="diag-item">
                  <span class="label">Profil Aktif:</span>
                  <span class="val text-primary" id="oid-profile-name">-</span>
                </div>
                <div class="diag-item">
                  <span class="label">Host OLT:</span>
                  <span class="val" id="oid-host">-</span>
                </div>
                <div class="diag-item">
                  <span class="label">Port SNMP:</span>
                  <span class="val" id="oid-port">161</span>
                </div>
                <div class="diag-item">
                  <span class="label">Community:</span>
                  <span class="val text-success" id="oid-community">public</span>
                </div>
                <div class="diag-item">
                  <span class="label">SNMP Version:</span>
                  <span class="val">v2c (BulkWalk)</span>
                </div>
              </div>
            </div>

            <div class="col-md-8">
              <div style="background:var(--bg3); padding:16px; border-radius:12px; border:1px solid var(--border);">
                <div class="fw-bold text-muted small text-uppercase mb-3">
                  <i class="bi bi-card-checklist me-1"></i> MIB &amp; Object Identifiers (SNMP OID Walk)
                </div>
                <div class="table-responsive">
                  <table class="table table-sm mb-0" style="font-family:'JetBrains Mono', monospace; font-size:11.5px; border-color:var(--border);">
                    <thead>
                      <tr>
                        <th style="color:var(--muted); background:transparent;">Deskripsi Metrik</th>
                        <th style="color:var(--muted); background:transparent;">OID Object Identifier</th>
                      </tr>
                    </thead>
                    <tbody id="oid-table-body">
                      <!-- OID rows rendered via JS -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
    <% } %>
  </div>
</div>

<!-- Modal Manage OLTs (Table List) -->
<div class="mo" id="manageOltsModal">
  <div class="mb" style="max-width: 920px;">
    <div class="mh">
      <span class="mt"><i class="bi bi-hdd-rack me-2 text-primary"></i> <%= t('admin.olts.manage_modal.title', 'Manajemen Perangkat OLT') %></span>
      <button type="button" class="mc" onclick="closeModal('manageOltsModal')">&times;</button>
    </div>
    <div class="mbody">
      <div class="table-responsive">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.olts.manage_modal.table.name', 'Nama OLT') %></th>
              <th><%= t('admin.olts.manage_modal.table.host', 'Host / IP') %></th>
              <th><%= t('admin.olts.manage_modal.table.brand', 'Brand') %></th>
              <th>SNMP Port</th>
              <th><%= t('admin.olts.manage_modal.table.status', 'Status') %></th>
              <th><%= t('admin.olts.manage_modal.table.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (olts.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center p-4 text-muted">Belum ada perangkat OLT terdaftar.</td>
              </tr>
            <% } else { %>
              <% olts.forEach(olt => { %>
                <tr>
                  <td><strong><%= olt.name %></strong></td>
                  <td><code><%= olt.host %></code></td>
                  <td><span class="brand-badge brand-<%= (olt.brand || 'generic').toLowerCase() %>"><%= (olt.brand || 'generic').toUpperCase() %></span></td>
                  <td><code><%= olt.snmp_port || 161 %></code></td>
                  <td>
                    <span class="badge <%= olt.is_active ? 'bs' : 'bd' %>">
                      <%= olt.is_active ? t('common.active', 'Aktif') : t('common.inactive', 'Nonaktif') %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex align-items-center gap-1">
                      <button class="btn btn-g btn-sm py-1 px-2" onclick="testOltSnmpDirect('<%= olt.id %>')" title="Test SNMP Connection">
                        <i class="bi bi-broadcast"></i> Test
                      </button>
                      <button class="btn btn-g btn-icon btn-sm" onclick="editOlt('<%= olt.id %>')" title="Edit OLT">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <form action="/admin/olts/<%= olt.id %>/delete" method="POST" onsubmit="return confirm(I18N.confirmDeleteOlt)" style="display:inline;">
                        <button type="submit" class="btn btn-d btn-icon btn-sm" title="Hapus OLT">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('manageOltsModal')"><%= t('common.close', 'Tutup') %></button>
      <button type="button" class="btn btn-p" onclick="closeModal('manageOltsModal'); openModal('addOltModal');">
        <i class="bi bi-plus-lg me-1"></i> Tambah OLT
      </button>
    </div>
  </div>
</div>

<!-- Modal Tambah OLT -->
<div class="mo" id="addOltModal">
  <div class="mb" style="max-width: 600px;">
    <form action="/admin/olts" method="POST">
      <div class="mh">
        <span class="mt"><i class="bi bi-plus-circle me-2 text-primary"></i> <%= t('admin.olts.add_modal.title', 'Tambah OLT Baru') %></span>
        <button type="button" class="mc" onclick="closeModal('addOltModal')">&times;</button>
      </div>
      <div class="mbody">
        <div class="fg">
          <label class="fl"><%= t('admin.olts.form.name', 'Nama Perangkat OLT') %></label>
          <input type="text" name="name" class="fc" placeholder="Contoh: OLT Pusat NOC" required>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl"><%= t('admin.olts.form.host', 'IP Address / Host') %></label>
            <input type="text" name="host" class="fc" placeholder="192.168.1.10" required>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.olts.form.snmp_port', 'Port SNMP') %></label>
            <input type="number" name="snmp_port" class="fc" value="161">
          </div>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl"><%= t('admin.olts.form.brand', 'Brand / Vendor OLT') %></label>
            <select name="brand" class="fs">
              <option value="zte">ZTE (C300 / C320 / C600)</option>
              <option value="huawei">Huawei (MA5600 / MA5800)</option>
              <option value="vsol">V-SOL (V1600 / V2400 EPON/GPON)</option>
              <option value="fiberhome">FiberHome (AN5516)</option>
              <option value="cdata">C-DATA (FD1600 / FD1800)</option>
              <option value="hioso" selected>HIOSO (EPON / GPON)</option>
              <option value="hsgq">HSGQ (EPON / GPON)</option>
              <option value="bdcom">BDCOM (EPON / GPON)</option>
              <option value="generic">Generic / Lainnya (Standard SNMP)</option>
            </select>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.olts.form.snmp_community', 'SNMP Community') %></label>
            <input type="text" name="snmp_community" class="fc" value="public" placeholder="public">
          </div>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl">Telnet / SSH User (Opsional)</label>
            <input type="text" name="web_user" class="fc" placeholder="admin">
          </div>
          <div class="fg">
            <label class="fl">Telnet / SSH Password (Opsional)</label>
            <input type="password" name="web_password" class="fc" placeholder="••••••••">
          </div>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl">Port Telnet</label>
            <input type="number" name="telnet_port" class="fc" value="23" min="1" max="65535">
          </div>
          <div class="fg">
            <label class="fl">Enable Password (ZTE)</label>
            <input type="password" name="enable_password" class="fc" placeholder="zxr10 (opsional)">
          </div>
        </div>
        <div class="fg">
          <label class="fl">API Base URL (go-api-c320 ZTE)</label>
          <input type="url" name="api_base_url" class="fc" placeholder="http://10.0.0.5:8081 (kosongkan jika tidak ada)">
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.olts.form.description', 'Deskripsi / Lokasi') %></label>
          <textarea name="description" class="fc" rows="2" placeholder="Lokasi rack OLT, POP atau catatan NOC..."></textarea>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addOltModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('admin.olts.add_modal.save', 'Simpan Perangkat') %></button>
      </div>
    </form>
  </div>
</div>

