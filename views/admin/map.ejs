    }
    .table-wrap {
      max-height: 320px;
      overflow-y: auto;
      border: 1px solid var(--border);
      border-radius: 10px;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
    }
    .data-table th, .data-table td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
      font-size: 12.5px;
      color: var(--text);
    }
    .data-table th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      color: var(--muted);
      font-weight: 800;
      position: sticky;
