<!-- Modal Catat Pengukuran Redaman Baru -->
<div class="mo" id="recordOpticalModal">
  <div class="mb" style="max-width: 520px;">
    <form id="recordOpticalForm" onsubmit="submitOpticalMeasurement(event)">
      <div class="mh">
        <span class="mt"><i class="bi bi-speedometer2 text-primary"></i> Catat Pengukuran Redaman (dBm)</span>
        <button type="button" class="mc" onclick="closeModal('recordOpticalModal')">&times;</button>
      </div>
      <div class="mbody">
        <input type="hidden" name="target_type" id="rec_target_type">
        <input type="hidden" name="target_id" id="rec_target_id">
        <input type="hidden" name="target_name" id="rec_target_name">

        <div style="padding: 8px 12px; background: var(--bg3); border-radius: 8px; margin-bottom: 12px; font-size: 12.5px;">
          Titik Pengukuran: <strong id="rec_target_display" style="color: var(--primary);">-</strong>
        </div>

        <div class="fg">
          <label class="fl">Port / Interface</label>
          <input type="text" name="target_port" id="rec_target_port" class="fc" placeholder="Misal: PON 1, Port Out 02, atau ONU RX">
        </div>

        <div class="fg">
          <label class="fl">Nilai Redaman Terukur (dBm) <span style="color:#ef4444;">*</span></label>
          <div style="display:flex; align-items:center;">
            <input type="number" step="0.01" name="measured_power_dbm" id="rec_power_dbm" class="fc" placeholder="-19.50" required>
            <span style="margin-left:8px; font-weight:800; font-size:13px; color:var(--muted);">dBm</span>
          </div>
          <small class="text-muted" style="font-size: 11px;">Standar normal GPON ONU: -15.00 s/d -24.00 dBm (&le; -27 dBm = Kritis)</small>
        </div>

        <div class="fg">
          <label class="fl">Nama Teknisi / Pengukur</label>
          <input type="text" name="measured_by" id="rec_measured_by" class="fc" placeholder="Nama teknisi lapangan">
        </div>

        <div class="fg">
          <label class="fl">Catatan / Tindakan Perbaikan</label>
          <textarea name="notes" id="rec_notes" class="fc" rows="2" placeholder="Misal: Splicing ulang pigtail, ganti adapter SC, pembersihan konektor..."></textarea>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('recordOpticalModal')">Batal</button>
        <button type="submit" class="btn btn-p" id="btnSubmitRecOpt">Simpan Pengukuran</button>
      </div>
    </form>
  </div>
</div>

<script id="settings-data" type="application/json"><%- JSON.stringify(settings) %></script>
<script id="customers-data" type="application/json"><%- JSON.stringify(customers).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="odps-data" type="application/json"><%- JSON.stringify(odps).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="odcs-data" type="application/json"><%- JSON.stringify(typeof odcs !== 'undefined' ? odcs : []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>

<script>
  const I18N = {
    layerOsm: "<%= t('admin.map.layers.osm', 'OpenStreetMap') %>",
    layerHybrid: "<%= t('admin.map.layers.hybrid', 'Satelit (Hybrid)') %>",
    layerDark: "Dark Mode (CartoDB)",
    popupDescription: "<%= t('admin.map.popup.description', 'Deskripsi') %>",
    popupLocation: "<%= t('admin.map.popup.location', 'Lokasi') %>",
    popupEdit: "<%= t('common.edit', 'Edit') %>",
    popupDelete: "Hapus",
    popupStatus: "<%= t('admin.map.popup.status', 'Status') %>",
    popupPackage: "<%= t('admin.map.popup.package', 'Paket') %>",
    popupAddress: "<%= t('admin.map.popup.address', 'Alamat') %>",
    viewDetails: "<%= t('admin.map.popup.view_details', 'Lihat Detail') %>",
    statusActive: "<%= t('admin.map.status.active', 'Aktif') %>",
    statusSuspended: "<%= t('admin.map.status.suspended', 'Isolir') %>"
  };

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  const appSettings = JSON.parse(document.getElementById('settings-data').textContent || '{}');
  const officeCoords = {
    lat: parseFloat(appSettings.office_lat) || -6.200000,
    lng: parseFloat(appSettings.office_lng) || 106.816666
  };

  // Initialize Map
  const map = L.map('map', {
    editable: true
  }).setView([officeCoords.lat, officeCoords.lng], 13);

  let currentEditingPolyline = null;
  let currentEditingCustomer = null;
  let showLabels = true;
  let filterEntity = 'all'; // 'all' | 'odc' | 'odp' | 'customer'
  let filterStatus = 'all'; // 'all' | 'active' | 'suspended'

  // Basemap Tile Layers (Tanpa butuh API key)
  const googleHybrid = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
    maxZoom: 20,
    subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
    attribution: '© Google Satellite'
  });

  const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '© OpenStreetMap'
  });

  googleHybrid.addTo(map);

  const baseMaps = {
    "🛰️ Google Satelit": googleHybrid,
    "🗺️ OpenStreetMap": osm
  };

  L.control.layers(baseMaps).addTo(map);

  let customers = [];
  let odps = [];
  let odcs = [];
  try {
    customers = JSON.parse(document.getElementById('customers-data').textContent || '[]');
    odps = JSON.parse(document.getElementById('odps-data').textContent || '[]');
    odcs = JSON.parse(document.getElementById('odcs-data').textContent || '[]');
  } catch (e) {
    console.error("Data mapping error:", e);
  }

  // Registries for quick search, focus, and filtering
  const odcMap = {}; // odcId -> { marker, data, coord }
  const odpMap = {}; // odpId -> { marker, data, coord }
  const customerMap = {}; // custId -> { marker, data, polyline }
  const odcPolylineList = []; // Feeder cables ODC ➔ ODP: { odcId, odpId, line }
  const odpCascadeLineList = []; // Daisy-chain Parent ODP ➔ Sub ODP: { parentId, childId, line }

  // 1. Render ODC Markers (Optical Distribution Cabinet - Purple node)
  odcs.forEach(odc => {
    if (odc.lat && odc.lng) {
      const lat = parseFloat(odc.lat);
      const lng = parseFloat(odc.lng);

      const odcIcon = L.divIcon({
        className: 'custom-onu-icon',
        html: `
          <div class="odc-marker-node" id="odc-node-${odc.id}">
            <div class="odc-marker-pin" title="${escapeHtml(odc.name)} (ODC)">
              <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div class="odc-marker-label">
              <span class="odc-marker-name">${escapeHtml(odc.name)}</span>
            </div>
          </div>
        `,
        iconSize: [30, 30],
        iconAnchor: [15, 15]
      });

      const marker = L.marker([lat, lng], { icon: odcIcon }).addTo(map);

      marker.bindPopup(`
        <div class="popup-content">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px; border-bottom:1px solid var(--border); padding-bottom:6px;">
            <div style="width:32px; height:32px; border-radius:8px; background:rgba(139,92,246,0.18); color:#8b5cf6; display:flex; align-items:center; justify-content:center; font-size:16px;">
              <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div>
              <div style="font-weight:900; font-size:13.5px; color:var(--text); line-height:1.2;">${escapeHtml(odc.name)}</div>
              <div style="font-size:11px; font-weight:700; color:#8b5cf6;">KABINET ODC INDUK</div>
            </div>
          </div>
          <div style="font-size:12px; margin-bottom:4px;"><strong>OLT:</strong> ${escapeHtml(odc.olt_name || '-')} ${odc.pon_port ? `(Port: <span class="badge" style="background:#8b5cf6; color:#fff;">${escapeHtml(odc.pon_port)}</span>)` : ''}</div>
          <div style="font-size:12px; margin-bottom:4px; display:flex; gap:10px;">
            <div>In: <strong>${odc.input_power_dbm !== null ? odc.input_power_dbm + ' dBm' : '<span style="color:var(--muted)">-</span>'}</strong></div>
            <div>Out: <strong style="color:#8b5cf6;">${odc.output_power_dbm !== null ? odc.output_power_dbm + ' dBm' : '<span style="color:var(--muted)">-</span>'}</strong></div>
          </div>
          <div style="font-size:12px; margin-bottom:4px;"><strong>Splitter:</strong> ${odc.splitter_ratio || '1:8'} | <strong>Total Port:</strong> ${odc.total_ports || 48}</div>
          <div style="font-size:12px; margin-bottom:4px;"><strong>ODP Terhubung:</strong> <span class="badge" style="background:#8b5cf6; color:#fff; padding:2px 6px; border-radius:4px; font-size:11px;">${odc.connected_odp_count || 0} ODP</span></div>
          <div style="font-size:12px; margin-bottom:4px;"><strong>${I18N.popupDescription}:</strong> ${escapeHtml(odc.description || '-')}</div>
          <div style="font-size:11.5px; font-family:monospace; margin-bottom:8px; color:var(--muted);"><strong>${I18N.popupLocation}:</strong> ${lat.toFixed(6)}, ${lng.toFixed(6)}</div>
          <div class="popup-actions" style="margin-top: 10px; display: flex; gap: 6px; flex-wrap: wrap;">
            <button class="btn btn-sm btn-warning" onclick="openRecordOpticalModal('odc', ${odc.id}, '${escapeHtml(odc.name)}', '${escapeHtml(odc.pon_port || 'PON Out')}')"><i class="bi bi-speedometer2 me-1"></i>Catat dBm</button>
            <button class="btn btn-sm btn-outline-secondary" onclick="openOpticalHistory('odc', ${odc.id}, '${escapeHtml(odc.name)}', 'ODC Cabinet')"><i class="bi bi-activity me-1"></i>Riwayat</button>
            <button class="btn btn-sm btn-p" onclick='editOdc(${JSON.stringify(odc)})'><i class="bi bi-pencil me-1"></i>${I18N.popupEdit}</button>
            <button class="btn btn-sm btn-d" onclick="promptDeleteOdc(${odc.id}, '${escapeHtml(odc.name)}')"><i class="bi bi-trash me-1"></i>${I18N.popupDelete}</button>
            <button class="btn btn-sm btn-g" onclick="focusOdc(${odc.id})"><i class="bi bi-geo-alt me-1"></i>Fokus</button>
          </div>
        </div>
      `);

      odcMap[odc.id] = { marker, data: odc, coord: [lat, lng] };
    }
  });

  // 2. Render ODP Markers (Optical Distribution Point - Amber node)
  odps.forEach(odp => {
    if (odp.lat && odp.lng) {
      const lat = parseFloat(odp.lat);
      const lng = parseFloat(odp.lng);
      
      const odpIcon = L.divIcon({
        className: 'custom-onu-icon',
        html: `
          <div class="odp-marker-node" id="odp-node-${odp.id}">
            <div class="odp-marker-pin" title="${escapeHtml(odp.name)} (ODP)">
              <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="odp-marker-label">
              <span class="odp-marker-name">${escapeHtml(odp.name)}</span>
            </div>
          </div>
        `,
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const marker = L.marker([lat, lng], { icon: odpIcon }).addTo(map);
      
      marker.bindPopup(`
        <div class="popup-content">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px; border-bottom:1px solid var(--border); padding-bottom:6px;">
            <div style="width:32px; height:32px; border-radius:8px; background:rgba(245,158,11,0.18); color:#f59e0b; display:flex; align-items:center; justify-content:center; font-size:16px;">
              <i class="bi bi-box-seam-fill"></i>
            </div>
            <div>
              <div style="font-weight:900; font-size:13.5px; color:var(--text); line-height:1.2;">${escapeHtml(odp.name)}</div>
              <div style="font-size:11px; font-weight:700; color:#f59e0b;">KOTAK DISTRIBUSI ODP</div>
            </div>
          </div>
          ${odp.odc_name ? `<div style="font-size:12px; margin-bottom:3px;"><i class="bi bi-diagram-3-fill" style="color:#8b5cf6;"></i> <strong>ODC Induk:</strong> ${escapeHtml(odp.odc_name)} ${odp.odc_out_port ? `(${escapeHtml(odp.odc_out_port)})` : ''}</div>` : ''}
          ${odp.parent_odp_name ? `<div style="font-size:12px; margin-bottom:3px;"><i class="bi bi-box-seam text-warning"></i> <strong>ODP Induk:</strong> ${escapeHtml(odp.parent_odp_name)}</div>` : ''}
          <div style="font-size:12px; margin-bottom:4px; display:flex; gap:10px;">
            <div>In: <strong>${odp.input_power_dbm !== null ? odp.input_power_dbm + ' dBm' : '<span style="color:var(--muted)">-</span>'}</strong></div>
            <div>Out: <strong class="text-primary">${odp.output_power_dbm !== null ? odp.output_power_dbm + ' dBm' : '<span style="color:var(--muted)">-</span>'}</strong></div>
          </div>
          <div style="font-size:12px; margin-bottom:4px;"><strong>Splitter:</strong> ${odp.splitter_ratio || '1:8'} | <strong>Kapasitas:</strong> <span class="badge" style="background:#2563eb; color:#fff; padding:2px 6px; border-radius:4px; font-size:11px;">${odp.connected_customer_count || 0} / ${odp.total_ports || 8} Port</span></div>
          <div style="font-size:12px; margin-bottom:4px;"><strong>${I18N.popupDescription}:</strong> ${escapeHtml(odp.description || '-')}</div>
          <div style="font-size:11.5px; font-family:monospace; margin-bottom:8px; color:var(--muted);"><strong>${I18N.popupLocation}:</strong> ${lat.toFixed(6)}, ${lng.toFixed(6)}</div>
          <div class="popup-actions" style="margin-top: 10px; display: flex; gap: 6px; flex-wrap: wrap;">
            <button class="btn btn-sm btn-warning" onclick="openRecordOpticalModal('odp', ${odp.id}, '${escapeHtml(odp.name)}', 'Port Out')"><i class="bi bi-speedometer2 me-1"></i>Catat dBm</button>
            <button class="btn btn-sm btn-outline-secondary" onclick="openOpticalHistory('odp', ${odp.id}, '${escapeHtml(odp.name)}', 'ODP Distribution')"><i class="bi bi-activity me-1"></i>Riwayat</button>
            <button class="btn btn-sm btn-p" onclick='editOdp(${JSON.stringify(odp)})'><i class="bi bi-pencil me-1"></i>${I18N.popupEdit}</button>
            <button class="btn btn-sm btn-d" onclick="promptDeleteOdp(${odp.id}, '${escapeHtml(odp.name)}')"><i class="bi bi-trash me-1"></i>${I18N.popupDelete}</button>
            <button class="btn btn-sm btn-g" onclick="focusOdp(${odp.id})"><i class="bi bi-geo-alt me-1"></i>Fokus</button>
          </div>
        </div>
      `);

      odpMap[odp.id] = {
        marker,
        data: odp,
        coord: [lat, lng]
      };
    }
  });

  // 3. Connect Cables: ODC ➔ ODP (Feeder) & Parent ODP ➔ Sub ODP (Cascade)
  odps.forEach(odp => {
    if (odp.lat && odp.lng) {
      const odpCoord = [parseFloat(odp.lat), parseFloat(odp.lng)];

      // A. ODC ➔ ODP cable line (Feeder Cable - Purple)
      if (odp.odc_id && odcMap[odp.odc_id]) {
        const odcEntry = odcMap[odp.odc_id];
        const odcLine = L.polyline([odcEntry.coord, odpCoord], {
          color: '#8b5cf6',
          weight: 3.5,
          opacity: 0.85,
          dashArray: '8, 6',
          className: 'flowing-line'
        }).addTo(map);
        odcLine.bindTooltip(`Kabel Feeder: ODC (${escapeHtml(odcEntry.data.name)}) ➔ ODP (${escapeHtml(odp.name)})`, { sticky: true });
        odcPolylineList.push({ odcId: odp.odc_id, odpId: odp.id, line: odcLine });
      }

      // B. Parent ODP ➔ Sub ODP cascade cable line (Amber)
      if (odp.parent_odp_id && odpMap[odp.parent_odp_id]) {
        const parentEntry = odpMap[odp.parent_odp_id];
        const cascadeLine = L.polyline([parentEntry.coord, odpCoord], {
          color: '#f59e0b',
          weight: 3,
          opacity: 0.85,
          dashArray: '6, 6',
          className: 'flowing-line'
        }).addTo(map);
        cascadeLine.bindTooltip(`Kabel Distribusi Kaskade: ODP ${escapeHtml(parentEntry.data.name)} ➔ ODP ${escapeHtml(odp.name)}`, { sticky: true });
        odpCascadeLineList.push({ parentId: odp.parent_odp_id, childId: odp.id, line: cascadeLine });
      }
    }
  });

  // 4. Render Customer ONU Markers & Drop Cables
  customers.forEach(cust => {
    if (cust.lat && cust.lng) {
      const lat = parseFloat(cust.lat);
      const lng = parseFloat(cust.lng);
      const is_active = cust.status === 'active';
      const downMaxMbps = (cust.speed_down && Number(cust.speed_down) > 0) ? Math.max(1, Math.round(Number(cust.speed_down) / 1000)) : 10;
      const upMaxMbps = (cust.speed_up && Number(cust.speed_up) > 0) ? Math.max(1, Math.round(Number(cust.speed_up) / 1000)) : 10;
      const waLink = buildWaLink(cust.phone, cust.name);
      
      // Draw Cable Line to ODP if connected (with flowing neon green line for active customers)
      let polyline = null;
      if (cust.odp_id && odpMap[cust.odp_id]) {
        let pathCoords = [[lat, lng], odpMap[cust.odp_id].coord];
        
        if (cust.cable_path) {
          try {
            pathCoords = JSON.parse(cust.cable_path);
          } catch(e) {}
        }

        polyline = L.polyline(pathCoords, {
          color: is_active ? '#10b981' : '#ef4444',
          weight: is_active ? 3.5 : 2,
          opacity: is_active ? 0.95 : 0.65,
          className: is_active ? 'flowing-line-active' : 'flowing-line-suspended'
        }).addTo(map);

        polyline.bindTooltip(`Drop Cable: ODP (${escapeHtml(cust.odp_name || 'ODP')}) ➔ Pelanggan (${escapeHtml(cust.name)}) [${is_active ? 'Aktif' : 'Isolir'}]`, { sticky: true });

        polyline.on('click', (e) => {
          if (currentEditingPolyline === polyline) {
             L.DomEvent.stopPropagation(e);
          }
        });
      }

      // Customer Optical Power Telemetry calculation
      const rxPower = (cust.optical_rx_power !== null && cust.optical_rx_power !== undefined) ? Number(cust.optical_rx_power) : null;
      let optBadgeClass = 'opt-badge-na';
      let optLabel = 'Belum Sinkron';
      if (rxPower !== null) {
        if (rxPower <= -27 || rxPower >= -8) {
          optBadgeClass = 'opt-badge-critical';
          optLabel = 'Kritis / Loss Tinggi';
        } else if (rxPower <= -24) {
          optBadgeClass = 'opt-badge-warning';
          optLabel = 'Waspada';
        } else {
          optBadgeClass = 'opt-badge-normal';
          optLabel = 'Prima / Normal';
        }
      }

      // Customer Marker Icon with Clean Floating Name
      const onuIcon = L.divIcon({
        className: 'custom-onu-icon',
        html: `
          <div class="onu-marker-node ${is_active ? 'is-active' : 'is-suspended'}" id="onu-node-${cust.id}">
            <div class="onu-marker-pin" title="${escapeHtml(cust.name)} (${is_active ? 'Aktif' : 'Isolir'})">
              <i class="bi bi-router-fill"></i>
            </div>
            <div class="onu-marker-label">
              <span class="onu-marker-name">${escapeHtml(cust.name)}</span>
            </div>
          </div>
        `,
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const marker = L.marker([lat, lng], { icon: onuIcon }).addTo(map);

      marker.bindPopup(`
        <div class="cust-popup">
          <div class="cp-head">
            <div class="cp-avatar"><i class="bi bi-person-fill"></i></div>
            <div class="cp-title">
              <div class="cp-name">${escapeHtml(cust.name)}</div>
              <div class="cp-badges">
                <span class="cp-chip ${is_active ? 'cp-chip-active' : 'cp-chip-suspended'}"><i class="bi bi-shield-check"></i>${is_active ? I18N.statusActive : I18N.statusSuspended}</span>
                <span class="cp-chip"><i class="bi bi-box-seam"></i>${escapeHtml(cust.package_name || '-')}</span>
              </div>
            </div>
          </div>

          <!-- FTTH Downstream Optical Budget Hierarchy -->
          <div class="ftth-flow-diagram">
            <div class="ftth-flow-step">
              <span style="color:#8b5cf6;"><i class="bi bi-diagram-3-fill"></i> ODC Induk:</span>
              <strong>${escapeHtml(cust.odc_name || '-')}</strong>
            </div>
            <div class="ftth-flow-step">
              <span style="color:#f59e0b;"><i class="bi bi-box-seam-fill"></i> ODP Box:</span>
              <strong>${escapeHtml(cust.odp_name || 'Tanpa ODP')} ${cust.odp_port_number ? `(Port ${cust.odp_port_number})` : ''}</strong>
            </div>
            <div class="ftth-flow-step">
              <span style="color:#10b981;"><i class="bi bi-activity"></i> Redaman ONU (Rx):</span>
              <span class="opt-badge ${optBadgeClass}">${rxPower !== null ? rxPower.toFixed(2) + ' dBm' : 'N/A'}</span>
            </div>
          </div>

          <div class="cp-meta">
            <div class="cp-meta-item"><i class="bi bi-router"></i><span>PPPoE: <strong>${escapeHtml(cust.pppoe_username || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-tag"></i><span>Tag/SN: <strong>${escapeHtml(cust.genieacs_tag || '-')}</strong></span></div>
            <div class="cp-meta-item"><i class="bi bi-telephone"></i><span>${escapeHtml(cust.phone || '-')}</span></div>
            <div class="cp-meta-item"><i class="bi bi-geo-alt"></i><span>${escapeHtml(cust.address || '-')}</span></div>
          </div>

          <div class="cp-traffic">
            <div class="cp-traffic-head"><i class="bi bi-activity"></i><span>Trafik Realtime</span></div>
            <div class="cp-traffic-grid">
              <div class="cp-chart">
                <div class="cp-chart-label"><i class="bi bi-download"></i><span>Download</span></div>
                <canvas class="cp-spark" id="cust_${cust.id}_dl_chart" width="160" height="60" data-max="${downMaxMbps}"></canvas>
                <div class="cp-overlay" id="cust_${cust.id}_dl_state"></div>
              </div>
              <div class="cp-chart">
                <div class="cp-chart-label"><i class="bi bi-upload"></i><span>Upload</span></div>
                <canvas class="cp-spark" id="cust_${cust.id}_ul_chart" width="160" height="60" data-max="${upMaxMbps}"></canvas>
                <div class="cp-overlay" id="cust_${cust.id}_ul_state"></div>
              </div>
            </div>
          </div>

          <div class="popup-actions" style="display:flex; gap:6px; flex-wrap:wrap; margin-top:10px;">
             ${cust.odp_id ? `<button onclick="snapCustomerCableRoad(${cust.id})" class="btn btn-sm btn-info" title="Snap otomatis mengikuti rute jalan raya/gang (OSRM)"><i class="bi bi-signpost-2-fill me-1"></i>Snap Jalan</button>` : ''}
             <button onclick="startCableDrawing(${cust.id}, ${lat}, ${lng}, ${cust.odp_id})" class="btn btn-sm btn-p" title="Gambar atau edit lekukan kabel"><i class="bi bi-pencil-fill me-1"></i>Jalur</button>
             <button onclick="openRecordOpticalModal('customer', ${cust.id}, '${escapeHtml(cust.name)}', 'ONU RX')" class="btn btn-sm btn-warning" title="Catat Pengukuran Redaman"><i class="bi bi-speedometer2"></i></button>
             <button onclick="openOpticalHistory('customer', ${cust.id}, '${escapeHtml(cust.name)}', 'ONU Pelanggan')" class="btn btn-sm btn-outline-secondary" title="Riwayat Redaman"><i class="bi bi-activity"></i></button>
             <a href="/admin/customers?search=${encodeURIComponent(cust.name || '')}" class="btn btn-sm btn-g"><i class="bi bi-eye me-1"></i>Detail</a>
             ${cust.phone ? `<a href="${waLink}" target="_blank" class="btn btn-sm btn-wa"><i class="bi bi-whatsapp"></i> Chat</a>` : ''}
          </div>
        </div>
      `);

      marker.on('popupopen', () => startCustomerTrafficPopup(cust.id));
      marker.on('popupclose', () => stopCustomerTrafficPopup(cust.id));

      customerMap[cust.id] = {
        marker,
        data: cust,
        polyline
      };
    }
  });

  // ─── SEARCH & AUTOCOMPLETE LOGIC ──────────────────────────────────────────
  const searchInput = document.getElementById('mapGlobalSearch');
  const searchDropdown = document.getElementById('mapSearchDropdown');
  const resultsList = document.getElementById('msResultsList');
  const resultsCount = document.getElementById('msHeaderCount');
  const clearBtn = document.getElementById('mapSearchClearBtn');
  let selectedSearchIndex = -1;
  let currentSearchResults = [];

  function highlightMatch(text, query) {
    if (!text) return '';
    if (!query) return escapeHtml(text);
    const escaped = escapeHtml(text);
    const qEsc = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${qEsc})`, 'gi');
    return escaped.replace(regex, '<mark>$1</mark>');
  }

  function doMapSearch(query) {
    const q = (query || '').trim().toLowerCase();
    if (!q) {
      searchDropdown.classList.remove('active');
      clearBtn.style.display = 'none';
      currentSearchResults = [];
      selectedSearchIndex = -1;
      return;
    }

    clearBtn.style.display = 'block';

    const matchedCustomers = customers.filter(c => {
      return (
        String(c.name || '').toLowerCase().includes(q) ||
        String(c.pppoe_username || '').toLowerCase().includes(q) ||
        String(c.phone || '').toLowerCase().includes(q) ||
        String(c.genieacs_tag || '').toLowerCase().includes(q) ||
        String(c.address || '').toLowerCase().includes(q) ||
        String(c.area || '').toLowerCase().includes(q) ||
        String(c.package_name || '').toLowerCase().includes(q) ||
        String(c.odp_name || '').toLowerCase().includes(q)
      );
    });

    const matchedOdps = odps.filter(o => {
      return (
        String(o.name || '').toLowerCase().includes(q) ||
        String(o.description || '').toLowerCase().includes(q) ||
        String(o.odc_name || '').toLowerCase().includes(q)
      );
    });

    const matchedOdcs = odcs.filter(c => {
      return (
        String(c.name || '').toLowerCase().includes(q) ||
        String(c.description || '').toLowerCase().includes(q) ||
        String(c.olt_name || '').toLowerCase().includes(q)
      );
    });

    currentSearchResults = [
      ...matchedCustomers.map(c => ({ type: 'customer', data: c })),
      ...matchedOdps.map(o => ({ type: 'odp', data: o })),
      ...matchedOdcs.map(c => ({ type: 'odc', data: c }))
    ];

    selectedSearchIndex = -1;
    resultsCount.textContent = `${currentSearchResults.length} Ditemukan`;

    if (currentSearchResults.length === 0) {
      resultsList.innerHTML = `
        <div class="ms-empty">
          <i class="bi bi-search" style="font-size: 24px; color: #cbd5e1; display: block; margin-bottom: 6px;"></i>
          Tidak ditemukan data untuk "<strong>${escapeHtml(query)}</strong>"
        </div>
      `;
    } else {
      let html = '';
      currentSearchResults.slice(0, 30).forEach((item, index) => {
        if (item.type === 'customer') {
          const c = item.data;
          const isActive = c.status === 'active';
          const hasGps = Boolean(c.lat && c.lng);
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon ${isActive ? 'active' : 'suspended'}">
                <i class="bi bi-router-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(c.name, query)}</span>
                  ${!hasGps ? '<span style="color:#ef4444; font-size:10px; font-weight:700;"><i class="bi bi-exclamation-triangle"></i> Tanpa GPS</span>' : ''}
                </div>
                <div class="ms-item-meta">
                  ${c.pppoe_username ? `<span>PPPoE: ${highlightMatch(c.pppoe_username, query)}</span> • ` : ''}
                  ${c.phone ? `<span>HP: ${highlightMatch(c.phone, query)}</span> • ` : ''}
                  ${c.odp_name ? `<span>ODP: ${highlightMatch(c.odp_name, query)}</span> • ` : ''}
                  <span>${escapeHtml(c.address || c.package_name || '-')}</span>
                </div>
              </div>
              <span class="ms-item-badge ${isActive ? 'ms-badge-active' : 'ms-badge-suspended'}">
                ${isActive ? 'Aktif' : 'Isolir'}
              </span>
            </div>
          `;
        } else if (item.type === 'odp') {
          const o = item.data;
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon odp">
                <i class="bi bi-box-seam-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(o.name, query)}</span>
                  <span style="font-size: 10px; color: #b45309; font-weight: 700;">(ODP Box)</span>
                </div>
                <div class="ms-item-meta">${highlightMatch(o.description || (o.odc_name ? 'ODC: ' + o.odc_name : 'Titik Distribusi ODP'), query)}</div>
              </div>
              <span class="ms-item-badge ms-badge-odp">ODP</span>
            </div>
          `;
        } else if (item.type === 'odc') {
          const c = item.data;
          html += `
            <div class="ms-item" data-index="${index}" onclick="selectSearchResult(${index})">
              <div class="ms-item-icon odc">
                <i class="bi bi-diagram-3-fill"></i>
              </div>
              <div class="ms-item-info">
                <div class="ms-item-name">
                  <span>${highlightMatch(c.name, query)}</span>
                  <span style="font-size: 10px; color: #8b5cf6; font-weight: 700;">(ODC Cabinet)</span>
                </div>
                <div class="ms-item-meta">${highlightMatch(c.description || (c.olt_name ? 'OLT: ' + c.olt_name : 'Titik Distribusi Feeder ODC'), query)}</div>
              </div>
              <span class="ms-item-badge ms-badge-odc">ODC</span>
            </div>
          `;
        }
      });
      resultsList.innerHTML = html;
    }

    searchDropdown.classList.add('active');
  }

  function clearMapSearch() {
    searchInput.value = '';
    doMapSearch('');
    searchInput.focus();
  }

  function selectSearchResult(index) {
    if (!currentSearchResults[index]) return;
    const item = currentSearchResults[index];
    searchDropdown.classList.remove('active');

    if (item.type === 'customer') {
      focusCustomer(item.data.id);
    } else if (item.type === 'odp') {
      focusOdp(item.data.id);
    } else if (item.type === 'odc') {
      focusOdc(item.data.id);
    }
  }

  // Keyboard navigation for search results
  searchInput.addEventListener('input', (e) => doMapSearch(e.target.value));
  searchInput.addEventListener('keydown', (e) => {
    if (!searchDropdown.classList.contains('active')) return;
    const items = resultsList.querySelectorAll('.ms-item');
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedSearchIndex = (selectedSearchIndex + 1) % items.length;
      updateSearchSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedSearchIndex = (selectedSearchIndex - 1 + items.length) % items.length;
      updateSearchSelection(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedSearchIndex >= 0 && selectedSearchIndex < items.length) {
        selectSearchResult(selectedSearchIndex);
      } else if (items.length > 0) {
        selectSearchResult(0);
      }
    } else if (e.key === 'Escape') {
      searchDropdown.classList.remove('active');
    }
  });

  function updateSearchSelection(items) {
    items.forEach((it, idx) => {
      if (idx === selectedSearchIndex) {
        it.classList.add('selected');
        it.scrollIntoView({ block: 'nearest' });
      } else {
        it.classList.remove('selected');
      }
    });
  }

  // Global hotkey: Ctrl+K or / to search
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey && e.key.toLowerCase() === 'k') || (e.key === '/' && document.activeElement !== searchInput && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA')) {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
  });

  // Close search dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.map-search-box')) {
      searchDropdown.classList.remove('active');
    }
  });

  // ─── FOCUS ACTIONS ────────────────────────────────────────────────────────
  function focusCustomer(id) {
    const entry = customerMap[id];
    if (!entry) {
      const c = customers.find(x => x.id === id);
      if (c && (!c.lat || !c.lng)) {
        alert(`Pelanggan "${c.name}" belum memiliki koordinat GPS.`);
      }
      return;
    }

    const { marker, data } = entry;
    const lat = parseFloat(data.lat);
    const lng = parseFloat(data.lng);

    map.flyTo([lat, lng], 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`onu-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function focusOdp(id) {
    const entry = odpMap[id];
    if (!entry) return;

    const { marker, coord } = entry;
    map.flyTo(coord, 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`odp-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function focusOdc(id) {
    const entry = odcMap[id];
    if (!entry) return;

    const { marker, coord } = entry;
    map.flyTo(coord, 18, { duration: 1 });

    setTimeout(() => {
      marker.openPopup();
      const node = document.getElementById(`odc-node-${id}`);
      if (node) {
        node.classList.add('marker-pulse-highlight');
        setTimeout(() => node.classList.remove('marker-pulse-highlight'), 2500);
      }
    }, 800);
  }

  function editOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = Number(btn.dataset.odpId);
    const found = odps.find(o => Number(o.id) === odpId);
    if (found) editOdp(found);
  }

  function focusOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    focusOdp(btn.dataset.odpId);
  }

  // ─── FILTER & TOGGLE ACTIONS ──────────────────────────────────────────────
  function setEntityFilter(type) {
    filterEntity = type;
    document.getElementById('pillEntAll').classList.toggle('active', type === 'all');
    document.getElementById('pillEntOdc').classList.toggle('active', type === 'odc');
    document.getElementById('pillEntOdp').classList.toggle('active', type === 'odp');
    document.getElementById('pillEntCust').classList.toggle('active', type === 'customer');
    applyMapFilters();
  }

  function setStatusFilter(status) {
    if (filterStatus === status) {
      filterStatus = 'all'; // toggle off
    } else {
      filterStatus = status;
    }
    document.getElementById('pillStatActive').classList.toggle('active', filterStatus === 'active');
    document.getElementById('pillStatSuspended').classList.toggle('active', filterStatus === 'suspended');
    applyMapFilters();
  }

  function applyMapFilters() {
    // 1. ODC Markers
    const showOdc = (filterEntity === 'all' || filterEntity === 'odc');
    Object.values(odcMap).forEach(e => {
      if (showOdc) {
        if (!map.hasLayer(e.marker)) map.addLayer(e.marker);
      } else {
        if (map.hasLayer(e.marker)) map.removeLayer(e.marker);
      }
    });

    // 2. ODP Markers
    const showOdp = (filterEntity === 'all' || filterEntity === 'odp');
    Object.values(odpMap).forEach(e => {
      if (showOdp) {
        if (!map.hasLayer(e.marker)) map.addLayer(e.marker);
      } else {
        if (map.hasLayer(e.marker)) map.removeLayer(e.marker);
      }
    });

    // 3. Customer Markers & Drop Cables
    const showCust = (filterEntity === 'all' || filterEntity === 'customer');
    Object.values(customerMap).forEach(e => {
      const { marker, data, polyline } = e;
      const isActive = data.status === 'active';
      let matchStatus = true;
      if (filterStatus === 'active' && !isActive) matchStatus = false;
      if (filterStatus === 'suspended' && isActive) matchStatus = false;

      const visible = showCust && matchStatus;
      if (visible) {
        if (!map.hasLayer(marker)) map.addLayer(marker);
        if (polyline && !map.hasLayer(polyline)) map.addLayer(polyline);
      } else {
        if (map.hasLayer(marker)) map.removeLayer(marker);
        if (polyline && map.hasLayer(polyline)) map.removeLayer(polyline);
      }
    });

    // 4. Feeder Cables (ODC ➔ ODP)
    odcPolylineList.forEach(item => {
      const visible = showOdc || showOdp;
      if (visible) {
        if (!map.hasLayer(item.line)) map.addLayer(item.line);
      } else {
        if (map.hasLayer(item.line)) map.removeLayer(item.line);
      }
    });

    // 5. Cascade Cables (ODP ➔ Sub ODP)
    odpCascadeLineList.forEach(item => {
      if (showOdp) {
        if (!map.hasLayer(item.line)) map.addLayer(item.line);
      } else {
        if (map.hasLayer(item.line)) map.removeLayer(item.line);
      }
    });
  }

  function toggleMarkerLabels() {
    showLabels = !showLabels;
    const btn = document.getElementById('pillLabels');
    const txt = document.getElementById('labelToggleText');
    const mapEl = document.getElementById('map');

    if (showLabels) {
      mapEl.classList.remove('hide-marker-labels');
      btn.classList.add('active');
      txt.textContent = 'Label: ON';
    } else {
      mapEl.classList.add('hide-marker-labels');
      btn.classList.remove('active');
      txt.textContent = 'Label: OFF';
    }
  }

  function fitAllMarkers() {
    const allLayers = [];
    Object.values(odcMap).forEach(e => {
      if (map.hasLayer(e.marker)) allLayers.push(e.marker);
    });
    Object.values(odpMap).forEach(e => {
      if (map.hasLayer(e.marker)) allLayers.push(e.marker);
    });
    Object.values(customerMap).forEach(e => {
      if (map.hasLayer(e.marker)) allLayers.push(e.marker);
    });

    if (allLayers.length > 0) {
      const group = L.featureGroup(allLayers);
      map.fitBounds(group.getBounds().pad(0.1));
    } else {
