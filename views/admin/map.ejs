    }
    .timeline-table td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    /* Tabbed Data Panel (ONU, ODP & ODC) */
    .data-tabs-panel {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.06);
      margin-top: 16px;
      margin-bottom: 24px;
      overflow: hidden;
    }
    .data-tabs-nav {
      display: flex;
      border-bottom: 1px solid var(--border);
      background: var(--bg3);
      padding: 6px 10px 0 10px;
      gap: 6px;
    }
    .tab-btn {
      padding: 10px 18px;
      border: 1px solid transparent;
      border-bottom: none;
      border-top-left-radius: 10px;
      border-top-right-radius: 10px;
      background: transparent;
      color: var(--muted);
