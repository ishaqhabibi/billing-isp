  // ─── FTTH SUB-PAGE & DATA PANEL LOGIC ─────────────────────────────────────
  function switchMainTab(tabId, btn) {
    document.querySelectorAll('.ftth-subpage').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.ftth-tab-btn').forEach(el => el.classList.remove('active'));
    
    const target = document.getElementById(tabId);
    if (target) target.classList.add('active');
    if (btn) btn.classList.add('active');

    // If switching to GIS Map, ensure Leaflet recalculates viewport
    if (tabId === 'tab-gis-map') {
      setTimeout(() => {
        if (typeof map !== 'undefined' && map) {
          map.invalidateSize();
        }
      }, 150);
    } else if (tabId === 'tab-customers') {
      renderTablePage('customer');
    } else if (tabId === 'tab-odps') {
      renderTablePage('odp');
    } else if (tabId === 'tab-odcs') {
      renderTablePage('odc');
    } else if (tabId === 'tab-olts') {
      renderTablePage('olt');
    }
  }

  function openGisMapTab(doFit = false) {
    const btn = document.getElementById('btnTabGisMap');
    switchMainTab('tab-gis-map', btn);
    if (doFit && typeof fitAllMarkers === 'function') {
      setTimeout(() => {
        fitAllMarkers();
      }, 200);
    }
  }

  function filterTopologyTree() {
    const searchVal = (document.getElementById('topoSearchInput')?.value || '').trim().toLowerCase();
    const oltVal = document.getElementById('topoOltSelect')?.value || 'all';

    const oltBlocks = document.querySelectorAll('.topo-tree-olt-block');
    oltBlocks.forEach(block => {
      const oltId = block.getAttribute('data-olt-id');
      const oltName = block.getAttribute('data-olt-name') || '';

      const matchOltFilter = (oltVal === 'all' || oltVal == oltId);
      if (!matchOltFilter) {
        block.style.display = 'none';
        return;
      }

      // Check search in block
      if (!searchVal) {
        block.style.display = '';
        block.querySelectorAll('.topo-odc-box').forEach(b => b.style.display = '');
        block.querySelectorAll('.topo-odp-item').forEach(i => i.style.display = '');
        return;
      }

      const oltMatch = oltName.includes(searchVal);
      let anyOdcMatch = false;

      const odcBoxes = block.querySelectorAll('.topo-odc-box');
      odcBoxes.forEach(odcBox => {
        const odcName = odcBox.getAttribute('data-odc-name') || '';
        const odcMatch = odcName.includes(searchVal);
        let anyOdpMatch = false;

        const odpItems = odcBox.querySelectorAll('.topo-odp-item');
        odpItems.forEach(odpItem => {
          const odpName = odpItem.getAttribute('data-odp-name') || '';
          if (odpName.includes(searchVal) || odcMatch || oltMatch) {
            odpItem.style.display = '';
            anyOdpMatch = true;
          } else {
            odpItem.style.display = 'none';
          }
        });

        if (odcMatch || anyOdpMatch || oltMatch) {
          odcBox.style.display = '';
          anyOdcMatch = true;
        } else {
          odcBox.style.display = 'none';
        }
      });

      if (oltMatch || anyOdcMatch) {
        block.style.display = '';
      } else {
        block.style.display = 'none';
      }
    });
  }

  function switchDataTab(tabId, btn) {
    // Kept for backward compatibility
    switchMainTab(tabId, btn);
  }

  // ─── CLIENT-SIDE DATA PAGINATOR ENGINE ────────────────────────────────────
  const TablePaginators = {
    customer: {
      currentPage: 1,
      pageSize: 15,
      allMatchedRows: [],
      tbodyId: 'customersTableBody',
      barId: 'custPaginationBar',
      singularLabel: 'pelanggan'
    },
    odp: {
      currentPage: 1,
      pageSize: 15,
      allMatchedRows: [],
      tbodyId: 'odpsTbody',
      barId: 'odpPaginationBar',
      singularLabel: 'ODP'
    },
    odc: {
      currentPage: 1,
      pageSize: 15,
      allMatchedRows: [],
      tbodyId: 'odcsTbody',
      barId: 'odcPaginationBar',
      singularLabel: 'ODC'
    },
    olt: {
      currentPage: 1,
      pageSize: 15,
      allMatchedRows: [],
      tbodyId: 'oltsTbody',
      barId: 'oltPaginationBar',
      singularLabel: 'OLT'
    }
  };

  function setTablePage(type, newPage) {
    const p = TablePaginators[type];
    if (!p) return;
    const totalPages = p.pageSize > 0 ? Math.ceil(p.allMatchedRows.length / p.pageSize) : 1;
    if (newPage < 1) newPage = 1;
    if (totalPages > 0 && newPage > totalPages) newPage = totalPages;
    p.currentPage = newPage;
    renderTablePage(type);
  }

  function setTablePageSize(type, newSize) {
    const p = TablePaginators[type];
    if (!p) return;
    p.pageSize = parseInt(newSize, 10);
    p.currentPage = 1;
    renderTablePage(type);
  }

  function renderTablePage(type) {
    const p = TablePaginators[type];
    if (!p) return;
    const tbody = document.getElementById(p.tbodyId);
    const bar = document.getElementById(p.barId);
    if (!tbody || !bar) return;

    // All original data rows in this table
    const allRows = Array.from(tbody.querySelectorAll('tr[data-id], tr[data-name]'));
    
    // First hide everything
    allRows.forEach(r => r.style.display = 'none');

    // Remove old empty match notification row
    const oldEmpty = tbody.querySelector('.tr-no-matched-data');
    if (oldEmpty) oldEmpty.remove();

    const total = p.allMatchedRows.length;
    if (total === 0) {
      const colCount = tbody.closest('table').querySelectorAll('thead th').length || 7;
      const emptyTr = document.createElement('tr');
      emptyTr.className = 'tr-no-matched-data';
      emptyTr.innerHTML = `<td colspan="${colCount}" style="padding: 24px; text-align: center; color: var(--muted); font-size: 13px;"><i class="bi bi-search me-1"></i> Tidak ada data ${p.singularLabel} yang sesuai dengan filter pencarian.</td>`;
      tbody.appendChild(emptyTr);

      bar.innerHTML = `
        <div class="pagination-info">Tidak ada data ditemukan</div>
        <div class="pagination-size-wrap">
          <span>Baris:</span>
          <select class="table-per-page-select" onchange="setTablePageSize('${type}', this.value)">
            <option value="15" ${p.pageSize === 15 ? 'selected' : ''}>15</option>
            <option value="25" ${p.pageSize === 25 ? 'selected' : ''}>25</option>
            <option value="50" ${p.pageSize === 50 ? 'selected' : ''}>50</option>
            <option value="100" ${p.pageSize === 100 ? 'selected' : ''}>100</option>
            <option value="-1" ${p.pageSize === -1 ? 'selected' : ''}>Semua</option>
          </select>
        </div>
      `;
      return;
    }

    let start = 0;
    let end = total;
    let totalPages = 1;

    if (p.pageSize > 0) {
      totalPages = Math.ceil(total / p.pageSize);
      if (p.currentPage > totalPages) p.currentPage = totalPages;
      if (p.currentPage < 1) p.currentPage = 1;
      start = (p.currentPage - 1) * p.pageSize;
      end = Math.min(start + p.pageSize, total);
    } else {
      p.currentPage = 1;
      totalPages = 1;
      start = 0;
      end = total;
    }

    // Show matching rows in slice
    for (let i = start; i < end; i++) {
      if (p.allMatchedRows[i]) {
        p.allMatchedRows[i].style.display = '';
      }
    }

    // Build pagination navigation markup
    let navHtml = '';
    if (totalPages > 1) {
      const cur = p.currentPage;
      navHtml += `<button type="button" class="pg-btn" ${cur === 1 ? 'disabled' : ''} onclick="setTablePage('${type}', 1)" title="Halaman Pertama"><i class="bi bi-chevron-double-left"></i></button>`;
      navHtml += `<button type="button" class="pg-btn" ${cur === 1 ? 'disabled' : ''} onclick="setTablePage('${type}', ${cur - 1})" title="Sebelumnya"><i class="bi bi-chevron-left"></i></button>`;

      let pStart = Math.max(1, cur - 2);
      let pEnd = Math.min(totalPages, cur + 2);
      if (pEnd - pStart < 4) {
        if (pStart === 1) pEnd = Math.min(totalPages, pStart + 4);
        else if (pEnd === totalPages) pStart = Math.max(1, pEnd - 4);
      }

      for (let page = pStart; page <= pEnd; page++) {
        navHtml += `<button type="button" class="pg-btn ${page === cur ? 'active' : ''}" onclick="setTablePage('${type}', ${page})">${page}</button>`;
      }

      navHtml += `<button type="button" class="pg-btn" ${cur === totalPages ? 'disabled' : ''} onclick="setTablePage('${type}', ${cur + 1})" title="Berikutnya"><i class="bi bi-chevron-right"></i></button>`;
      navHtml += `<button type="button" class="pg-btn" ${cur === totalPages ? 'disabled' : ''} onclick="setTablePage('${type}', ${totalPages})" title="Halaman Terakhir"><i class="bi bi-chevron-double-right"></i></button>`;
    }

    bar.innerHTML = `
      <div class="pagination-info">
        Menampilkan <strong>${start + 1}</strong> - <strong>${end}</strong> dari <strong>${total}</strong> ${p.singularLabel}
      </div>
      <div class="pagination-size-wrap">
        <span>Tampilkan:</span>
        <select class="table-per-page-select" onchange="setTablePageSize('${type}', this.value)">
          <option value="15" ${p.pageSize === 15 ? 'selected' : ''}>15 / hal</option>
          <option value="25" ${p.pageSize === 25 ? 'selected' : ''}>25 / hal</option>
          <option value="50" ${p.pageSize === 50 ? 'selected' : ''}>50 / hal</option>
          <option value="100" ${p.pageSize === 100 ? 'selected' : ''}>100 / hal</option>
          <option value="-1" ${p.pageSize === -1 ? 'selected' : ''}>Semua</option>
        </select>
      </div>
      <div class="pagination-nav">
        ${navHtml}
      </div>
    `;
  }

  // Filter Customer Table
  const custTableSearch = document.getElementById('customerTableSearch');
  const custGpsFilter = document.getElementById('customerGpsFilter');
  const custTbody = document.getElementById('customersTableBody');

  function filterCustomerTable() {
    if (!custTbody) return;
    const q = (custTableSearch ? custTableSearch.value : '').trim().toLowerCase();
    const gpsFilter = custGpsFilter ? custGpsFilter.value : 'all';
    const rows = Array.from(custTbody.querySelectorAll('tr[data-id]'));

    const matched = [];
    rows.forEach(r => {
      const name = r.getAttribute('data-name') || '';
      const pppoe = r.getAttribute('data-pppoe') || '';
      const phone = r.getAttribute('data-phone') || '';
      const tag = r.getAttribute('data-tag') || '';
      const address = r.getAttribute('data-address') || '';
      const status = r.getAttribute('data-status') || '';
      const hasGps = r.getAttribute('data-hasgps') === '1';

      const matchText = !q || name.includes(q) || pppoe.includes(q) || phone.includes(q) || tag.includes(q) || address.includes(q);
      
      let matchGps = true;
      if (gpsFilter === 'has_gps') matchGps = hasGps;
      else if (gpsFilter === 'no_gps') matchGps = !hasGps;
      else if (gpsFilter === 'active') matchGps = (status === 'active');
      else if (gpsFilter === 'suspended') matchGps = (status !== 'active');

      if (matchText && matchGps) {
        matched.push(r);
      }
    });

    TablePaginators.customer.allMatchedRows = matched;
    TablePaginators.customer.currentPage = 1;
    renderTablePage('customer');
