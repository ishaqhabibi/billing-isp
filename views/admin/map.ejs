  // ─── FOCUS ACTIONS ────────────────────────────────────────────────────────
  function ensureGisMapVisible() {
    const btnMap = document.getElementById('btnTabGisMap');
    if (btnMap && !btnMap.classList.contains('active')) {
      switchMainTab('tab-gis-map', btnMap);
    }
