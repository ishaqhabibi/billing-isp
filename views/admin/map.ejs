    }

    .timeline-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    .timeline-table th {
      background: var(--bg3);
      padding: 8px 10px;
      text-align: left;
      font-size: 11px;
      color: var(--muted);
