  // OLT Picker Map for addOltModal
  let oltPickerMap = null;
  let oltPickerMarker = null;

  function initOltPickerMap() {
    try {
      if (typeof L === 'undefined') return;
      const elLat = document.getElementById('new_olt_lat');
      const elLng = document.getElementById('new_olt_lng');
      const lat = (elLat && parseFloat(elLat.value)) ? parseFloat(elLat.value) : (typeof officeCoords !== 'undefined' ? officeCoords.lat : -6.2);
      const lng = (elLng && parseFloat(elLng.value)) ? parseFloat(elLng.value) : (typeof officeCoords !== 'undefined' ? officeCoords.lng : 106.8);

      const container = document.getElementById('olt-picker-map');
      if (!container) return;

      if (oltPickerMap) {
        oltPickerMap.setView([lat, lng], 16);
        if (oltPickerMarker) oltPickerMarker.setLatLng([lat, lng]);
        setTimeout(() => oltPickerMap.invalidateSize(), 200);
        return;
      }

      if (container._leaflet_id) {
        container._leaflet_id = null;
      }

      oltPickerMap = L.map('olt-picker-map').setView([lat, lng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(oltPickerMap);

      const oltIcon = L.divIcon({
        html: '<i class="bi bi-hdd-rack-fill" style="font-size:20px; color:#0284c7; filter:drop-shadow(0 2px 5px rgba(0,0,0,0.5));"></i>',
        className: 'custom-div-icon',
        iconSize: [24, 24],
        iconAnchor: [12, 12]
      });

      oltPickerMarker = L.marker([lat, lng], { draggable: true, icon: oltIcon }).addTo(oltPickerMap);

      const updateInputs = (l, g) => {
        if (elLat) elLat.value = Number(l).toFixed(6);
        if (elLng) elLng.value = Number(g).toFixed(6);
      };

      updateInputs(lat, lng);

      oltPickerMarker.on('dragend', (e) => {
        const pos = e.target.getLatLng();
        updateInputs(pos.lat, pos.lng);
      });

      oltPickerMap.on('click', (e) => {
        oltPickerMarker.setLatLng(e.latlng);
        updateInputs(e.latlng.lat, e.latlng.lng);
      });

      setTimeout(() => oltPickerMap.invalidateSize(), 300);
    } catch (err) {
      console.warn('initOltPickerMap warning:', err);
    }
  }

  function detectOltPickerGps() {
    if (!navigator.geolocation) return alert('Browser tidak mendukung geolokasi GPS.');
    const btn = event ? event.target.closest('button') : null;
    const origText = btn ? btn.innerHTML : '';
    if (btn) btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Mendeteksi...';
    navigator.geolocation.getCurrentPosition(
      pos => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        document.getElementById('new_olt_lat').value = Number(lat).toFixed(6);
        document.getElementById('new_olt_lng').value = Number(lng).toFixed(6);
        if (oltPickerMap && oltPickerMarker) {
          oltPickerMap.setView([lat, lng], 16);
          oltPickerMarker.setLatLng([lat, lng]);
          setTimeout(() => oltPickerMap.invalidateSize(), 200);
        }
        if (btn) btn.innerHTML = origText;
      },
      err => {
        alert('Gagal mendeteksi lokasi GPS: ' + err.message);
        if (btn) btn.innerHTML = origText;
      },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
    );
  }

