<!-- Modal Tambah ODP -->
<div class="mo" id="addOdpModal">
  <div class="mb">
    <form action="/admin/odps" method="POST">
      <div class="mh"><span class="mt"><%= t('admin.map.add_modal.title', 'Tambah ODP Baru') %></span><button type="button" class="mc" onclick="closeModal('addOdpModal')">&times;</button></div>
      <div class="mbody">
        <% const hasOdcs = (typeof odcs !== 'undefined' && odcs && odcs.length > 0); %>
        <% const hasOdps = (typeof odps !== 'undefined' && odps && odps.length > 0); %>
        <% if (!hasOdcs && !hasOdps) { %>
          <div class="odn-empty-box">
            <div style="width: 54px; height: 54px; border-radius: 50%; background: rgba(139,92,246,0.2); color: #8b5cf6; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 12px;">
              <i class="bi bi-diagram-3-fill"></i>
            </div>
            <h4 style="font-weight: 800; color: var(--text); margin-bottom: 8px;">ODC Belum Tersedia!</h4>
            <p style="font-size: 13px; color: var(--muted); max-width: 440px; margin: 0 auto 16px auto; line-height: 1.5;">
              Dalam hierarki jaringan ODN, setiap kotak <strong>ODP (Optical Distribution Point)</strong> wajib terhubung ke <strong>ODC Induk</strong> sebagai titik distribusi feeder serat optik. Harap buat ODC terlebih dahulu sebelum membuat ODP.
            </p>
            <button type="button" class="btn" style="background:#8b5cf6; color:#fff;" onclick="closeModal('addOdpModal'); openAddOdcModal();">
              <i class="bi bi-plus-circle me-1"></i> Buat ODC Sekarang
            </button>
          </div>
        <% } else { %>
          <div class="fg"><label class="fl"><%= t('admin.map.form.name', 'Nama ODP') %> <span class="text-danger">*</span></label><input type="text" name="name" class="fc" placeholder="<%= t('admin.map.form.name_placeholder', 'Contoh: ODP-A-01') %>" required></div>
          
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-diagram-3-fill" style="color:#8b5cf6;"></i> Sambung ke ODC Induk <span class="text-danger">*</span></label>
              <select name="odc_id" id="new_odp_odc_id" class="fc" required onchange="handleOdpHierarchyChange('new')">
                <option value="" disabled selected>-- Pilih ODC Induk (Wajib) --</option>
                <% if (typeof odcs !== 'undefined' && odcs) { %>
                  <% odcs.forEach(c => { %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><i class="bi bi-box-seam-fill text-warning"></i> Atau Kaskade dari ODP Induk (Opsional)</label>
              <select name="parent_odp_id" id="new_odp_parent_id" class="fc" onchange="handleOdpHierarchyChange('new')">
                <option value="">-- Bukan Sub-ODP (Langsung dari ODC) --</option>
                <% if (typeof odps !== 'undefined' && odps) { %>
                  <% odps.forEach(op => { %>
                    <option value="<%= op.id %>"><%= op.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>

        <div class="form-row">
          <div class="fg">
            <label class="fl"><i class="bi bi-plug text-info"></i> Port Output ODC Asal</label>
            <input type="text" name="odc_out_port" class="fc" placeholder="Misal: Port 01, Port 02">
          </div>
          <div class="fg">
            <label class="fl"><i class="bi bi-diagram-2 text-warning"></i> Rasio Splitter</label>
            <select name="splitter_ratio" class="fc">
              <option value="1:4">1:4 (Loss ~7 dB)</option>
              <option value="1:8" selected>1:8 (Loss ~10.5 dB)</option>
              <option value="1:16">1:16 (Loss ~14 dB)</option>
            </select>
          </div>
          <div class="fg">
            <label class="fl"><i class="bi bi-grid-3x3 text-secondary"></i> Kapasitas Port Pelanggan</label>
            <input type="number" name="total_ports" class="fc" value="8" min="1" max="64">
          </div>
        </div>

        <div class="form-row">
          <div class="fg">
            <label class="fl"><i class="bi bi-box-arrow-in-right text-success"></i> Redaman Masuk ODP (dari ODC)</label>
            <div style="display:flex; align-items:center;">
              <input type="number" step="0.01" name="input_power_dbm" class="fc" placeholder="-18.50">
              <span style="margin-left:6px; font-weight:700; font-size:12px; color:var(--muted);">dBm</span>
            </div>
          </div>
          <div class="fg">
            <label class="fl"><i class="bi bi-box-arrow-up-right text-primary"></i> Redaman Keluar ODP (ke Pelanggan)</label>
            <div style="display:flex; align-items:center;">
              <input type="number" step="0.01" name="output_power_dbm" class="fc" placeholder="-22.00">
              <span style="margin-left:6px; font-weight:700; font-size:12px; color:var(--muted);">dBm</span>
            </div>
          </div>
        </div>

        <label class="fl"><%= t('admin.map.form.pick_location', 'Pilih Lokasi di Peta') %></label>
        <div id="picker-map"></div>

        <div class="form-row">
            <div class="fg"><label class="fl"><%= t('admin.map.form.lat', 'Latitude') %></label><input type="text" name="lat" id="new_lat" class="fc" placeholder="-6.xxx" required></div>
            <div class="fg"><label class="fl"><%= t('admin.map.form.lng', 'Longitude') %></label><input type="text" name="lng" id="new_lng" class="fc" placeholder="106.xxx" required></div>
        </div>
        <p class="text-muted" style="font-size: 11px;"><%= t('admin.map.form.tips', '*Tips: Geser marker atau klik pada peta untuk menentukan posisi presisi') %></p>
        <div class="fg"><label class="fl"><%= t('admin.map.form.description', 'Deskripsi') %></label><textarea name="description" class="fc" rows="2"></textarea></div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addOdpModal')"><%= t('common.cancel', 'Batal') %></button>
        <% if (hasOdcs || hasOdps) { %>
          <button type="submit" class="btn btn-p"><%= t('admin.map.add_modal.save', 'Simpan ODP') %></button>
        <% } %>
      </div>
      <% } %>
    </form>
  </div>
</div>

