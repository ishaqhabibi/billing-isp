    document.getElementById('e_odp_lng').value = odp.lng || '';
    document.getElementById('e_odp_description').value = odp.description || '';
    const odcSel = document.getElementById('e_odp_odc_id');
    if (odcSel) odcSel.value = odp.odc_id || '';
    const parentSel = document.getElementById('e_odp_parent_id');
    if (parentSel) parentSel.value = odp.parent_odp_id || '';
    if (document.getElementById('e_odp_odc_out_port')) document.getElementById('e_odp_odc_out_port').value = odp.odc_out_port || '';
    if (document.getElementById('e_odp_splitter_ratio')) document.getElementById('e_odp_splitter_ratio').value = odp.splitter_ratio || '1:8';
    if (document.getElementById('e_odp_total_ports')) document.getElementById('e_odp_total_ports').value = odp.total_ports || 8;
    if (document.getElementById('e_odp_input_power_dbm')) document.getElementById('e_odp_input_power_dbm').value = (odp.input_power_dbm !== null && odp.input_power_dbm !== undefined) ? odp.input_power_dbm : '';
    if (document.getElementById('e_odp_output_power_dbm')) document.getElementById('e_odp_output_power_dbm').value = (odp.output_power_dbm !== null && odp.output_power_dbm !== undefined) ? odp.output_power_dbm : '';
    openModal('editOdpModal');
    initEditPickerMap(parseFloat(odp.lat), parseFloat(odp.lng));
  }

  // ─── OPTICAL MEASUREMENT & HISTORY AUDIT TRAIL ───────────────────────────
  let activeHistoryTarget = null;

  function openHistoryFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const { id, name, type } = btn.dataset;
    const meta = type === 'customer' ? 'ONU Pelanggan' : (type === 'odp' ? 'ODP Distribution' : 'ODC Cabinet');
    openOpticalHistory(type, id, name, meta);
  }

  function openRecordFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const { id, name, type, port } = btn.dataset;
    openRecordOpticalModal(type, id, name, port || '');
  }

  async function openOpticalHistory(targetType, targetId, targetName, metaInfo) {
    activeHistoryTarget = { targetType, targetId, targetName, metaInfo };
    const nameEl = document.getElementById('optHistTargetName');
    const metaEl = document.getElementById('optHistTargetMeta');
    const contentEl = document.getElementById('opticalHistoryContent');
    if (nameEl) nameEl.textContent = targetName;
    if (metaEl) metaEl.textContent = `${targetType.toUpperCase()} • ${metaInfo || ''}`;
    if (contentEl) contentEl.innerHTML = '<div style="text-align: center; padding: 30px; color: var(--muted);"><span class="spinner-border spinner-border-sm me-2"></span> Memuat riwayat pengukuran...</div>';
    
    openModal('opticalHistoryModal');

    try {
      const res = await fetch(`/admin/api/optical-history/${targetType}/${targetId}`);
      const data = await res.json();
      if (data.ok && Array.isArray(data.history)) {
        renderOpticalHistoryList(data.history);
      } else {
        if (contentEl) contentEl.innerHTML = '<div class="alert alert-d">Gagal memuat riwayat: ' + escapeHtml(data.error || 'Unknown error') + '</div>';
      }
    } catch (e) {
      if (contentEl) contentEl.innerHTML = '<div class="alert alert-d">Gagal memuat: ' + escapeHtml(e.message) + '</div>';
    }
  }

  function renderOpticalHistoryList(list) {
    const contentEl = document.getElementById('opticalHistoryContent');
    if (!contentEl) return;

    if (!list || list.length === 0) {
      contentEl.innerHTML = `
        <div style="text-align: center; padding: 35px 20px; color: var(--muted);">
          <i class="bi bi-clock-history" style="font-size: 32px; display: block; margin-bottom: 8px; opacity: 0.5;"></i>
          Belum ada riwayat pengukuran redaman untuk titik ini.<br>
          <small>Gunakan tombol "Catat Pengukuran Baru" untuk menambah data.</small>
        </div>
      `;
      return;
    }

    let rows = '';
    list.forEach(item => {
      const power = Number(item.measured_power_dbm);
      let badgeClass = 'opt-badge-normal';
      if (power <= -27 || power >= -8) {
        badgeClass = 'opt-badge-critical';
      } else if (power <= -24) {
        badgeClass = 'opt-badge-warning';
      }

      const loss = Number(item.reference_loss_db || 0);
      let lossBadge = '';
      if (loss !== 0) {
        const isWorse = loss < 0;
        lossBadge = `<span style="font-size: 10.5px; font-weight: 700; color: ${isWorse ? '#ef4444' : '#10b981'};">${loss > 0 ? '+' : ''}${loss} dB</span>`;
      }

      rows += `
        <tr>
          <td style="white-space: nowrap; font-size: 11px; font-family: monospace;">
            ${escapeHtml(item.created_at || '-')}
          </td>
          <td>
            <span style="font-size: 11px; font-weight: 700;">${escapeHtml(item.target_port || 'Main')}</span>
          </td>
          <td>
            <span class="opt-badge ${badgeClass}">${power.toFixed(2)} dBm</span>
            ${lossBadge ? `<div style="margin-top: 2px;">${lossBadge}</div>` : ''}
          </td>
          <td>
            <span style="font-size: 11.5px; font-weight: 600;"><i class="bi bi-person me-1"></i>${escapeHtml(item.measured_by || 'Teknisi')}</span>
          </td>
          <td>
            <div style="font-size: 11.5px; color: var(--muted); max-width: 260px;">${escapeHtml(item.notes || '-')}</div>
          </td>
        </tr>
      `;
    });

    contentEl.innerHTML = `
      <table class="timeline-table">
        <thead>
          <tr>
            <th>Waktu & Tanggal</th>
            <th>Port / Titik</th>
            <th>Redaman Terukur</th>
            <th>Teknisi / Sumber</th>
            <th>Catatan & Aksi</th>
          </tr>
        </thead>
        <tbody>
          ${rows}
        </tbody>
      </table>
    `;
  }

  function openRecordOpticalModal(targetType, targetId, targetName, defaultPort) {
    const tType = document.getElementById('rec_target_type');
    const tId = document.getElementById('rec_target_id');
    const tName = document.getElementById('rec_target_name');
    const tDisplay = document.getElementById('rec_target_display');
    const tPort = document.getElementById('rec_target_port');
    const pDbm = document.getElementById('rec_power_dbm');
    const mBy = document.getElementById('rec_measured_by');
    const nNotes = document.getElementById('rec_notes');

    if (tType) tType.value = targetType;
    if (tId) tId.value = targetId;
    if (tName) tName.value = targetName;
    if (tDisplay) tDisplay.textContent = `${targetType.toUpperCase()}: ${targetName}`;
    if (tPort) tPort.value = defaultPort || '';
    if (pDbm) pDbm.value = '';
    if (mBy) mBy.value = '';
    if (nNotes) nNotes.value = '';
    openModal('recordOpticalModal');
  }

  function openRecordOpticalModalFromHistory() {
    if (!activeHistoryTarget) return;
    openRecordOpticalModal(
      activeHistoryTarget.targetType,
      activeHistoryTarget.targetId,
      activeHistoryTarget.targetName,
      'Port Out'
    );
  }

  async function submitOpticalMeasurement(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitRecOpt');
    const origText = btn ? btn.textContent : '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menyimpan...';
    }

    const payload = {
      target_type: document.getElementById('rec_target_type').value,
      target_id: document.getElementById('rec_target_id').value,
      target_name: document.getElementById('rec_target_name').value,
      target_port: document.getElementById('rec_target_port').value,
      measured_power_dbm: parseFloat(document.getElementById('rec_power_dbm').value),
      measured_by: document.getElementById('rec_measured_by').value,
      notes: document.getElementById('rec_notes').value
    };

    try {
      const res = await fetch('/admin/api/optical-history', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.ok) {
        closeModal('recordOpticalModal');
        alert('Pengukuran redaman optik berhasil dicatat!');
        if (activeHistoryTarget && activeHistoryTarget.targetId == payload.target_id) {
          openOpticalHistory(activeHistoryTarget.targetType, activeHistoryTarget.targetId, activeHistoryTarget.targetName, activeHistoryTarget.metaInfo);
        }
        location.reload();
      } else {
        alert('Gagal menyimpan: ' + (data.error || 'Unknown error'));
      }
    } catch (err) {
      alert('Error: ' + err.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = origText;
      }
    }
  }

  async function triggerGenieacsOpticalSync() {
    const btn = document.getElementById('btnSyncGenieacs');
    const origHtml = btn ? btn.innerHTML : '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Syncing TR-069...';
    }

    try {
      const res = await fetch('/admin/api/sync-genieacs-optical', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.ok) {
        alert(`Berhasil sinkronisasi redaman GenieACS! ${data.syncedCount || 0} perangkat ONU diperbarui.`);
        location.reload();
      } else {
        alert('Gagal sinkronisasi GenieACS: ' + (data.error || 'Server error'));
      }
    } catch (e) {
      alert('Error: ' + e.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    }
  }

  function openModal(id) { 
    document.getElementById(id).style.display = 'flex'; 
    if (id === 'addOdpModal') {
      const lat = parseFloat(document.getElementById('new_lat').value) || officeCoords.lat;
      const lng = parseFloat(document.getElementById('new_lng').value) || officeCoords.lng;
      initPickerMap(lat, lng);
    } else if (id === 'addOdcModal') {
      const lat = parseFloat(document.getElementById('new_odc_lat').value) || officeCoords.lat;
      const lng = parseFloat(document.getElementById('new_odc_lng').value) || officeCoords.lng;
      initOdcPickerMap(lat, lng);
    }
  }

  function closeModal(id) { document.getElementById(id).style.display = 'none'; }

  // Right Click on Map to Add ODP
  map.on('contextmenu', function(e) {
    const lat = e.latlng.lat.toFixed(6);
    const lng = e.latlng.lng.toFixed(6);
    document.getElementById('new_lat').value = lat;
    document.getElementById('new_lng').value = lng;
    openModal('addOdpModal');
  });

  // Fit all initial markers
  setTimeout(() => {
    fitAllMarkers();
    map.invalidateSize();
  }, 500);

  window.onclick = function(e) {
    if (e.target.className === 'mo') {
      e.target.style.display = 'none';
    }
  };

  // ─── REALTIME SPARKLINE CHART ─────────────────────────────────────────────
  const customerTrafficIntervals = {};
  const customerTrafficSeries = {};

  function drawSparkline(canvas, series, maxMbps, color) {
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const w = canvas.width;
    const h = canvas.height;
    const padX = 6;
    const padY = 6;
    const innerW = w - padX * 2;
    const innerH = h - padY * 2;
    const max = Number.isFinite(maxMbps) && maxMbps > 0 ? maxMbps : 10;
    let vals = Array.isArray(series) ? series : [];

    ctx.clearRect(0, 0, w, h);

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.22)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = 0; i <= 3; i++) {
      const y = padY + (innerH * i) / 3;
      ctx.moveTo(padX, y);
      ctx.lineTo(padX + innerW, y);
    }
    ctx.stroke();

    if (vals.length === 1) vals = [vals[0], vals[0]];
    if (vals.length < 2) return;

    const toY = (v) => {
      const n = Math.max(0, Number(v || 0) || 0);
      const r = Math.min(1, n / max);
      return padY + innerH * (1 - r);
    };

    const grad = ctx.createLinearGradient(padX, padY, padX + innerW, padY);
    grad.addColorStop(0, color);
    grad.addColorStop(1, 'rgba(255,255,255,0.0)');

    ctx.beginPath();
    for (let i = 0; i < vals.length; i++) {
      const x = padX + (innerW * i) / (vals.length - 1);
      const y = toY(vals[i]);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.stroke();

    ctx.lineTo(padX + innerW, padY + innerH);
    ctx.lineTo(padX, padY + innerH);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.globalAlpha = 0.22;
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  function setOverlay(customerId, kind, text) {
    const el = document.getElementById(`cust_${customerId}_${kind}_state`);
    if (!el) return;
    const t = String(text || '').trim();
    el.textContent = t;
    if (t) el.classList.add('on');
    else el.classList.remove('on');
  }

  function updatePopupTraffic(customerId, dlMbps, ulMbps, labelOverride) {
    const dlCanvas = document.getElementById(`cust_${customerId}_dl_chart`);
    const ulCanvas = document.getElementById(`cust_${customerId}_ul_chart`);
    const dlMax = Number(dlCanvas && dlCanvas.dataset ? dlCanvas.dataset.max : 10) || 10;
    const ulMax = Number(ulCanvas && ulCanvas.dataset ? ulCanvas.dataset.max : 10) || 10;

    if (!customerTrafficSeries[customerId]) customerTrafficSeries[customerId] = { dl: [], ul: [] };
    const st = customerTrafficSeries[customerId];

    if (labelOverride) {
      setOverlay(customerId, 'dl', labelOverride);
      setOverlay(customerId, 'ul', labelOverride);
      st.dl = [];
      st.ul = [];
      drawSparkline(dlCanvas, [0, 0], dlMax, 'rgba(59,130,246,0.6)');
      drawSparkline(ulCanvas, [0, 0], ulMax, 'rgba(34,197,94,0.6)');
      return;
    }

    setOverlay(customerId, 'dl', '');
    setOverlay(customerId, 'ul', '');

    const dl = Math.max(0, Number(dlMbps || 0) || 0);
    const ul = Math.max(0, Number(ulMbps || 0) || 0);
    st.dl.push(dl);
    st.ul.push(ul);
    if (st.dl.length > 22) st.dl = st.dl.slice(-22);
    if (st.ul.length > 22) st.ul = st.ul.slice(-22);

    drawSparkline(dlCanvas, st.dl, dlMax, '#3b82f6');
    drawSparkline(ulCanvas, st.ul, ulMax, '#22c55e');
  }

  async function refreshCustomerTrafficPopup(customerId) {
    try {
      const r = await fetch(`/admin/api/customers/${customerId}/pppoe-traffic`, { cache: 'no-store' });
      const data = await r.json();
      if (!data || !data.ok) {
        updatePopupTraffic(customerId, 0, 0, '-');
        return;
      }
      if (!data.available) {
        updatePopupTraffic(customerId, 0, 0, 'N/A');
        return;
      }
      if (!data.online) {
        updatePopupTraffic(customerId, 0, 0, 'Offline');
        return;
      }
      if (data.warmup) {
        updatePopupTraffic(customerId, 0, 0, 'Mengukur');
        return;
      }

      const rx = Number(data.rxMbps || 0);
      const tx = Number(data.txMbps || 0);
      updatePopupTraffic(customerId, tx, rx, '');
    } catch {
      updatePopupTraffic(customerId, 0, 0, '-');
    }
  }

  function startCustomerTrafficPopup(customerId) {
    stopCustomerTrafficPopup(customerId);
    refreshCustomerTrafficPopup(customerId);
    customerTrafficIntervals[customerId] = setInterval(() => refreshCustomerTrafficPopup(customerId), 3000);
  }

  function stopCustomerTrafficPopup(customerId) {
    const t = customerTrafficIntervals[customerId];
    if (t) clearInterval(t);
    delete customerTrafficIntervals[customerId];
  }

  function normalizePhone(phone) {
    const raw = String(phone || '').trim();
    const digits = raw.replace(/\D/g, '');
    if (!digits) return '';
    if (digits.startsWith('62')) return digits;
    if (digits.startsWith('0')) return `62${digits.slice(1)}`;
    if (digits.length >= 9) return `62${digits}`;
    return digits;
  }

  function buildWaLink(phone, name) {
    const to = normalizePhone(phone);
    const msg = `Halo ${String(name || '').trim()}`;
    if (!to) return 'javascript:void(0)';
    return `https://wa.me/${to}?text=${encodeURIComponent(msg)}`;
  }
</script>
