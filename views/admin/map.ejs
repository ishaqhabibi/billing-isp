              </div>
              <div id="sdcMigrateBox" style="margin-top: 8px; display: none;">
                <select name="target_odc_id" id="sdcTargetOdcSelect" class="fc" style="font-size: 12px;">
                  <!-- dynamically populated -->
                </select>
              </div>
            </div>
          </label>
        </div>

        <div id="sdcSimpleConfirm" style="display: none; font-size: 13px; color: var(--text);">
          <p>ODC ini tidak memiliki ODP downstream yang tersambung. Apakah Anda yakin ingin menghapus data ODC ini?</p>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('smartDeleteOdcModal')">Batal</button>
        <button type="submit" class="btn btn-d"><i class="bi bi-trash-fill"></i> Konfirmasi & Hapus ODC</button>
      </div>
    </form>
  </div>
</div>

