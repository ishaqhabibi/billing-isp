  // ─── CABLE DRAWING & MODALS ────────────────────────────────────────────────
  let drawingMap, drawingPolyline, drawingMarkers = [];
  
  function interpolatePoints(p1, p2, count) {
    const points = [p1];
    for (let i = 1; i <= count; i++) {
      const lat = p1[0] + (p2[0] - p1[0]) * (i / (count + 1));
      const lng = p1[1] + (p2[1] - p1[1]) * (i / (count + 1));
      points.push([lat, lng]);
    }
    points.push(p2);
    return points;
  }

  function renderEditorMarkers() {
    drawingMarkers.forEach(m => drawingMap.removeLayer(m));
    drawingMarkers = [];

    const latlngs = drawingPolyline.getLatLngs();
    latlngs.forEach((ll, index) => {
      const isEdge = index === 0 || index === latlngs.length - 1;
      const marker = L.marker(ll, {
        draggable: true,
        zIndexOffset: 2000,
        icon: L.divIcon({
          html: `<div style="background: ${isEdge ? '#3b82f6' : '#ef4444'}; width: 16px; height: 16px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 5px rgba(0,0,0,0.5);"></div>`,
          className: 'custom-div-icon',
          iconSize: [16, 16],
          iconAnchor: [8, 8]
        })
      }).addTo(drawingMap);

      marker.on('drag', (e) => {
        const newLatLngs = drawingPolyline.getLatLngs();
        newLatLngs[index] = e.latlng;
        drawingPolyline.setLatLngs(newLatLngs);
      });

      drawingMarkers.push(marker);
    });
  }

  function startCableDrawing(customerId, lat, lng, odpId) {
    const odp = odpMap[odpId];
    if (!odp) return alert('Data ODP tidak ditemukan atau belum dipilih');

    currentEditingCustomer = customerId;
    openModal('cablePathModal');

    setTimeout(() => {
      try {
        if (drawingMap) drawingMap.remove();
        
        drawingMap = L.map('cable-drawing-map').setView([lat, lng], 17);
        L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
          maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
        }).addTo(drawingMap);

        const customer = customers.find(c => c.id === customerId);
        let pathCoords = [];
        if (customer && customer.cable_path) {
          try { pathCoords = JSON.parse(customer.cable_path); } catch(e) {}
        }
        
        if (pathCoords.length <= 2) {
          pathCoords = interpolatePoints([parseFloat(lat), parseFloat(lng)], odp.coord, 5);
        }

        drawingPolyline = L.polyline(pathCoords, {
          color: '#f59e0b', weight: 6, dashArray: '5, 5', interactive: false
        }).addTo(drawingMap);

        renderEditorMarkers();

        setTimeout(() => {
          drawingMap.invalidateSize();
          drawingMap.fitBounds(drawingPolyline.getBounds(), { padding: [50, 50] });
        }, 200);
      } catch (err) {
        console.error("Drawing map error:", err);
      }
    }, 600);
  }

  function addMorePoints() {
    if (!drawingPolyline || !drawingMap) return;
    const latlngs = drawingPolyline.getLatLngs();
    const newPath = [];
    for (let i = 0; i < latlngs.length - 1; i++) {
      newPath.push(latlngs[i]);
      const midLat = (latlngs[i].lat + latlngs[i+1].lat) / 2;
      const midLng = (latlngs[i].lng + latlngs[i+1].lng) / 2;
      newPath.push(L.latLng(midLat, midLng));
    }
    newPath.push(latlngs[latlngs.length - 1]);
    drawingPolyline.setLatLngs(newPath);
    renderEditorMarkers();
  }

  async function saveCablePath() {
    if (!drawingPolyline || !currentEditingCustomer) return;
    const latlngs = drawingPolyline.getLatLngs().map(ll => [ll.lat, ll.lng]);
    const pathJson = JSON.stringify(latlngs);

    try {
      const res = await fetch(`/admin/api/customers/${currentEditingCustomer}/cable-path`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ path: pathJson })
      });
      
      const contentType = res.headers.get("content-type");
      if (contentType && contentType.indexOf("application/json") !== -1) {
        const data = await res.json();
        if (data.ok) {
          alert('Jalur kabel berhasil disimpan!');
          location.reload();
        } else {
          alert('Gagal menyimpan: ' + data.error);
        }
      } else {
        alert('Gagal menyimpan jalur kabel.');
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  async function snapCurrentDrawingToRoad() {
    if (!currentEditingCustomer || !drawingPolyline || !drawingMap) return;
    const cust = customers.find(c => c.id === currentEditingCustomer);
    if (!cust || !cust.odp_id || !odpMap[cust.odp_id]) return alert('Data ODP tidak ditemukan atau belum dipilih');
    
    const odp = odpMap[cust.odp_id];
    const btn = document.getElementById('btnSnapRoadDrawing');
    const origText = btn ? btn.innerHTML : '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menghitung Rute Jalan...';
    }

    try {
      const res = await fetch('/admin/api/snap-cable-road', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          startLat: odp.coord[0],
          startLng: odp.coord[1],
          endLat: parseFloat(cust.lat),
          endLng: parseFloat(cust.lng)
        })
      });
      const data = await res.json();
      if (data.ok && Array.isArray(data.path) && data.path.length > 0) {
        drawingPolyline.setLatLngs(data.path);
        renderEditorMarkers();
        drawingMap.fitBounds(drawingPolyline.getBounds(), { padding: [30, 30] });
      } else {
        alert('Gagal mengambil rute jalan: ' + (data.error || 'Rute jalan tidak ditemukan'));
      }
    } catch (e) {
      alert('Error: ' + e.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    }
  }

  async function snapCustomerCableRoad(customerId) {
    const cust = customers.find(c => c.id === customerId);
    if (!cust) return alert('Pelanggan tidak ditemukan');
    if (!cust.odp_id) return alert('Pelanggan belum dihubungkan ke ODP. Silakan tentukan ODP terlebih dahulu.');

    if (!confirm(`Tarik jalur kabel otomatis mengikuti kontur jalan raya/gang dari ODP ke pelanggan "${cust.name}"?`)) return;

    try {
      const res = await fetch(`/admin/api/customers/${customerId}/snap-cable-road`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.ok && Array.isArray(data.path)) {
        cust.cable_path = JSON.stringify(data.path);
        const entry = customerMap[customerId];
        if (entry) {
          if (entry.polyline) {
            entry.polyline.setLatLngs(data.path);
          } else {
            const is_active = cust.status === 'active';
            entry.polyline = L.polyline(data.path, {
              color: is_active ? '#10b981' : '#ef4444',
              weight: is_active ? 3.5 : 2,
              opacity: is_active ? 0.95 : 0.65,
              className: is_active ? 'flowing-line-active' : 'flowing-line-suspended'
            }).addTo(map);
          }
        }
        alert(`Jalur kabel untuk "${cust.name}" berhasil diselaraskan dengan rute jalan raya/gang!`);
      } else {
        alert('Gagal: ' + (data.error || 'Rute jalan tidak dapat dihitung'));
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

