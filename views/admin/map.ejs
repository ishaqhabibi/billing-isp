          <div style="font-size: 11.5px; color: var(--muted);" id="optHistTargetMeta">-</div>
        </div>
        <div>
          <button type="button" class="btn btn-sm btn-p" onclick="openRecordOpticalModalFromHistory()">
            <i class="bi bi-plus-circle me-1"></i> Catat Pengukuran Baru
          </button>
        </div>
      </div>
      <div id="opticalHistoryContent">
        <div style="text-align: center; padding: 30px; color: var(--muted);">Memuat riwayat pengukuran...</div>
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g" onclick="closeModal('opticalHistoryModal')">Tutup</button>
    </div>
  </div>
</div>

<!-- Modal Catat Pengukuran Redaman Baru -->
<div class="mo" id="recordOpticalModal">
  <div class="mb" style="max-width: 520px;">
    <form id="recordOpticalForm" onsubmit="submitOpticalMeasurement(event)">
      <div class="mh">
        <span class="mt"><i class="bi bi-speedometer2 text-primary"></i> Catat Pengukuran Redaman (dBm)</span>
        <button type="button" class="mc" onclick="closeModal('recordOpticalModal')">&times;</button>
      </div>
      <div class="mbody">
        <input type="hidden" name="target_type" id="rec_target_type">
        <input type="hidden" name="target_id" id="rec_target_id">
        <input type="hidden" name="target_name" id="rec_target_name">

        <div style="padding: 8px 12px; background: var(--bg3); border-radius: 8px; margin-bottom: 12px; font-size: 12.5px;">
          Titik Pengukuran: <strong id="rec_target_display" style="color: var(--primary);">-</strong>
        </div>

        <div class="fg">
          <label class="fl">Port / Interface</label>
          <input type="text" name="target_port" id="rec_target_port" class="fc" placeholder="Misal: PON 1, Port Out 02, atau ONU RX">
        </div>

        <div class="fg">
          <label class="fl">Nilai Redaman Terukur (dBm) <span style="color:#ef4444;">*</span></label>
          <div style="display:flex; align-items:center;">
            <input type="number" step="0.01" name="measured_power_dbm" id="rec_power_dbm" class="fc" placeholder="-19.50" required>
            <span style="margin-left:8px; font-weight:800; font-size:13px; color:var(--muted);">dBm</span>
          </div>
          <small class="text-muted" style="font-size: 11px;">Standar normal GPON ONU: -15.00 s/d -24.00 dBm (&le; -27 dBm = Kritis)</small>
        </div>

        <div class="fg">
          <label class="fl">Nama Teknisi / Pengukur</label>
          <input type="text" name="measured_by" id="rec_measured_by" class="fc" placeholder="Nama teknisi lapangan">
        </div>

        <div class="fg">
          <label class="fl">Catatan / Tindakan Perbaikan</label>
          <textarea name="notes" id="rec_notes" class="fc" rows="2" placeholder="Misal: Splicing ulang pigtail, ganti adapter SC, pembersihan konektor..."></textarea>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('recordOpticalModal')">Batal</button>
        <button type="submit" class="btn btn-p" id="btnSubmitRecOpt">Simpan Pengukuran</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Tambah OLT (Central Office / POP) -->
<div class="mo" id="addOltModal" style="z-index: 99999;" onclick="if(event.target===this)closeModal('addOltModal')">
  <div class="mb" style="max-width: 620px; width: 95%;">
    <form action="/admin/olts" method="POST">
      <input type="hidden" name="redirect_to" value="/admin/map">
      <div class="mh">
        <span class="mt"><i class="bi bi-hdd-rack-fill" style="color: #0ea5e9;"></i> Tambah OLT Baru (Central Office)</span>
        <button type="button" class="mc" onclick="closeModal('addOltModal')">&times;</button>
      </div>
      <div class="mbody">
        <div class="fg">
          <label class="fl">Nama Perangkat OLT <span class="text-danger">*</span></label>
          <input type="text" name="name" class="fc" placeholder="Contoh: OLT-PUSAT-NOC" required>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl">IP Address / Host <span class="text-danger">*</span></label>
            <input type="text" name="host" class="fc" placeholder="192.168.1.10" required>
          </div>
          <div class="fg">
            <label class="fl">Port SNMP</label>
            <input type="number" name="snmp_port" class="fc" value="161">
          </div>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl">Brand / Vendor OLT</label>
            <select name="brand" class="fs">
              <option value="zte">ZTE (C300 / C320 / C600)</option>
              <option value="huawei">Huawei (MA5600 / MA5800)</option>
              <option value="vsol">V-SOL (V1600 / V2400 EPON/GPON)</option>
              <option value="fiberhome">FiberHome (AN5516)</option>
              <option value="cdata">C-DATA (FD1600 / FD1800)</option>
              <option value="hioso" selected>HIOSO (EPON / GPON)</option>
              <option value="hsgq">HSGQ (EPON / GPON)</option>
              <option value="bdcom">BDCOM (EPON / GPON)</option>
              <option value="generic">Generic / Lainnya</option>
            </select>
          </div>
          <div class="fg">
            <label class="fl">SNMP Community</label>
            <input type="text" name="snmp_community" class="fc" value="public">
          </div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
          <label class="fl mb-0"><i class="bi bi-pin-map text-primary"></i> Tentukan Titik Lokasi OLT di Peta</label>
          <button type="button" class="btn btn-g btn-sm py-0 px-2" style="font-size:11px;" onclick="detectOltPickerGps()">
            <i class="bi bi-crosshair me-1"></i> Deteksi GPS Saya
          </button>
        </div>
        <div id="olt-picker-map" style="height: 220px; border-radius: 8px; margin-bottom: 10px; border: 1px solid var(--border);"></div>

        <div class="form-row">
          <div class="fg">
            <label class="fl">Latitude (Peta)</label>
            <input type="text" name="lat" id="new_olt_lat" class="fc" placeholder="-6.xxx">
          </div>
          <div class="fg">
            <label class="fl">Longitude (Peta)</label>
            <input type="text" name="lng" id="new_olt_lng" class="fc" placeholder="106.xxx">
          </div>
        </div>
        <p class="text-muted" style="font-size: 11px;">*Tips: Klik atau geser marker biru pada peta untuk menentukan lokasi server / NOC OLT</p>

        <div class="fg">
          <label class="fl">Deskripsi / Ruangan Server</label>
          <textarea name="description" class="fc" rows="2" placeholder="Catatan letak rack server atau POP NOC..."></textarea>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addOltModal')">Batal</button>
        <button type="submit" class="btn btn-p" style="background:#0284c7; border:1px solid #0369a1; color:#fff;">Simpan OLT</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Set Koordinat OLT -->
<div class="mo" id="setOltLocationModal">
  <div class="mb" style="max-width: 600px;">
    <form id="setOltLocationForm" onsubmit="saveOltLocationAjax(event)">
      <input type="hidden" id="set_olt_id" value="">
      <div class="mh">
        <span class="mt"><i class="bi bi-pin-map-fill" style="color: #0ea5e9;"></i> Tentukan Lokasi OLT: <span id="set_olt_name_title"></span></span>
        <button type="button" class="mc" onclick="closeModal('setOltLocationModal')">&times;</button>
      </div>
      <div class="mbody">
        <p style="font-size:12px; color:var(--muted); margin-bottom:8px;">Klik pada peta untuk menempatkan titik koordinat OLT. Kabel Backbone feeder ke seluruh ODC yang terhubung akan otomatis ditarik dari titik ini.</p>
        <div id="set-olt-picker-map" style="height: 280px; border-radius: 8px; margin-bottom: 10px; border: 1px solid var(--border);"></div>
        <div class="form-row">
          <div class="fg">
            <label class="fl">Latitude</label>
            <input type="text" id="set_olt_lat" class="fc" required>
          </div>
          <div class="fg">
            <label class="fl">Longitude</label>
            <input type="text" id="set_olt_lng" class="fc" required>
          </div>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('setOltLocationModal')">Batal</button>
        <button type="submit" class="btn btn-p" id="btnSaveOltLoc">Simpan Lokasi OLT</button>
      </div>
