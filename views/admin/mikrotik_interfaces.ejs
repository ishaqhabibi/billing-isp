<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Telemetri Interface &amp; Port | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.7">
  <style>
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block; animation: pulse 1.8s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.85); } }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .spin { animation: spin 1s linear infinite; display: inline-block; }

    /* Summary Bar */
    .iface-kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
    @media(max-width: 992px) { .iface-kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 480px) { .iface-kpi-grid { grid-template-columns: 1fr; } }

    .iface-kpi-card {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 14px;
      padding: 16px 18px; display: flex; flex-direction: column; justify-content: space-between;
      position: relative; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }
    .iface-kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
    .iface-kpi-card.c-blue::before { background: linear-gradient(90deg, #0052cc, #38bdf8); }
    .iface-kpi-card.c-green::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .iface-kpi-card.c-cyan::before { background: linear-gradient(90deg, #06b6d4, #22d3ee); }
    .iface-kpi-card.c-purple::before { background: linear-gradient(90deg, #7c3aed, #a78bfa); }

    .iface-kpi-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .iface-kpi-lbl { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .iface-kpi-val { font-size: 26px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }
    .iface-kpi-sub { font-size: 11px; color: var(--muted); margin-top: 6px; }

    /* Card & Tables */
    .card-modern { background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.15); }
    .card-modern-hd { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
    .card-modern-title { font-size: 14px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0; }

    .status-filter-pills { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .status-filter-btn {
      border: 1px solid var(--border); background: var(--bg3); color: var(--muted);
      padding: 5px 12px; border-radius: 8px; font-size: 12px; font-weight: 600;
      cursor: pointer; transition: all 0.15s ease;
    }
    .status-filter-btn:hover { border-color: rgba(255,255,255,0.25); color: var(--text); }
    .status-filter-btn.active { background: rgba(0,82,204,0.18); border-color: var(--primary); color: #38bdf8; font-weight: 700; }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'mikrotik', company }) %>
<div class="mw">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-broadcast text-primary"></i>
      <span>Telemetri Interface &amp; Port MikroTik</span>
    </div>
    <div class="tb-right" style="display:flex;align-items:center;gap:12px">
      <!-- Router Selector -->
      <div style="display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);padding:4px 10px;border-radius:9px;">
        <i class="bi bi-hdd-network text-primary" style="font-size:13px;"></i>
        <select id="global-router-id" class="fs" style="background:transparent;border:none;color:var(--text);font-size:12.5px;cursor:pointer;padding:0;" onchange="changeRouter()">
          <option value="" <%= (!selectedRouterId) ? 'selected' : '' %>><%= t('admin.mikrotik.default_router', '-- Default Core Router --') %></option>
          <% routers.forEach(r => { %>
            <option value="<%= r.id %>" <%= (String(selectedRouterId || activeRouterId || '') === String(r.id)) ? 'selected' : '' %>><%= r.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- Auto Refresh Toggle -->
      <button id="auto-refresh-toggle" onclick="toggleAutoRefresh()" class="btn btn-sm" style="background:rgba(34,197,94,0.15);color:#22c55e;border:1px solid rgba(34,197,94,0.3);font-size:12px;" title="Auto-refresh live SNMP (5 detik)">
        <i class="bi bi-arrow-clockwise"></i>
        <span id="refresh-status">Auto</span>
      </button>

      <!-- Backup RSC -->
      <a href="#" onclick="downloadBackup(event)" class="btn btn-p btn-sm" title="Download Script Backup .rsc RouterOS">
        <i class="bi bi-download"></i> Backup RSC
      </a>

      <!-- Theme Toggle Quick Button -->
      <button type="button" class="btn btn-g btn-sm theme-toggle-btn" onclick="toggleAppTheme()" title="Ganti Mode Terang / Gelap" style="padding:4px 9px;">
        <i class="bi bi-moon-stars-fill theme-toggle-icon" style="color:#fbbf24"></i>
      </button>

      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? 'Kasir' : 'Admin' %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm" title="Logout"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>

  <div class="page">
    <% const mTab = 'interfaces'; %>

    <!-- MIKROTIK MODULAR SUB-NAVIGATION -->
    <div class="mtabs" style="margin-bottom:20px; overflow-x:auto; white-space:nowrap;">
      <a href="/admin/mikrotik" class="mtab <%= mTab==='mikrotik' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard NOC</a>
      <a href="/admin/mikrotik/interfaces" class="mtab <%= mTab==='interfaces' ? 'active' : '' %>"><i class="bi bi-broadcast"></i> Interface &amp; Port</a>
      <a href="/admin/mikrotik/pppoe" class="mtab <%= mTab==='pppoe' ? 'active' : '' %>"><i class="bi bi-ethernet"></i> Akun PPPoE</a>
      <a href="/admin/mikrotik/hotspot" class="mtab <%= mTab==='hotspot' ? 'active' : '' %>"><i class="bi bi-wifi"></i> Hotspot Users</a>
      <a href="/admin/routers" class="mtab <%= mTab==='routers' ? 'active' : '' %>"><i class="bi bi-hdd-network"></i> Manajemen Router</a>
      <a href="/admin/vouchers" class="mtab <%= mTab==='vouchers' ? 'active' : '' %>"><i class="bi bi-ticket-perforated"></i> Voucher Hotspot</a>
      <a href="/admin/vouchers/packages" class="mtab <%= mTab==='packages' ? 'active' : '' %>"><i class="bi bi-tags"></i> Paket Voucher</a>
    </div>

    <!-- SUMMARY METRICS -->
    <div class="iface-kpi-grid">
      <div class="iface-kpi-card c-blue">
        <div class="iface-kpi-top">
          <span class="iface-kpi-lbl">Total Interfaces</span>
          <i class="bi bi-hdd-stack text-primary" style="font-size:18px;"></i>
        </div>
        <div class="iface-kpi-val" id="kpi-total-ifaces">0</div>
        <div class="iface-kpi-sub"><span id="kpi-up-ifaces">0</span> Link Aktif (UP)</div>
      </div>

      <div class="iface-kpi-card c-purple">
        <div class="iface-kpi-top">
          <span class="iface-kpi-lbl">Physical Ports (RB5009)</span>
          <i class="bi bi-ethernet text-purple" style="font-size:18px;"></i>
        </div>
        <div class="iface-kpi-val" id="kpi-phys-ifaces">0</div>
        <div class="iface-kpi-sub">8x Gigabit/2.5G + 1x SFP+ 10G</div>
      </div>

      <div class="iface-kpi-card c-green">
        <div class="iface-kpi-top">
          <span class="iface-kpi-lbl">Total Download (Rx)</span>
          <i class="bi bi-arrow-down-circle-fill text-success" style="font-size:18px;"></i>
        </div>
        <div class="iface-kpi-val" id="kpi-total-rx">0.00 Mbps</div>
        <div class="iface-kpi-sub">Live Incoming Throughput</div>
      </div>

      <div class="iface-kpi-card c-cyan">
        <div class="iface-kpi-top">
          <span class="iface-kpi-lbl">Total Upload (Tx)</span>
          <i class="bi bi-arrow-up-circle-fill text-info" style="font-size:18px;"></i>
        </div>
        <div class="iface-kpi-val" id="kpi-total-tx">0.00 Mbps</div>
        <div class="iface-kpi-sub">Live Outgoing Throughput</div>
      </div>
    </div>

    <!-- INTERFACE TABLE CARD -->
    <div class="card-modern">
      <div class="card-modern-hd">
        <div class="card-modern-title">
          <i class="bi bi-broadcast text-primary"></i> Daftar Seluruh Interface Router (SNMP 64-bit HC)
        </div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
          <!-- Filter Pills -->
          <div class="status-filter-pills">
            <button type="button" class="status-filter-btn active" data-if-filter="all" onclick="filterSnmpInterfaces('all', this)">Semua (<span id="if-count-all">0</span>)</button>
            <button type="button" class="status-filter-btn" data-if-filter="physical" onclick="filterSnmpInterfaces('physical', this)">Physical (<span id="if-count-phys">0</span>)</button>
            <button type="button" class="status-filter-btn" data-if-filter="vlan" onclick="filterSnmpInterfaces('vlan', this)">VLAN (<span id="if-count-vlan">0</span>)</button>
            <button type="button" class="status-filter-btn" data-if-filter="bridge" onclick="filterSnmpInterfaces('bridge', this)">Bridge</button>
            <button type="button" class="status-filter-btn" data-if-filter="vpn" onclick="filterSnmpInterfaces('vpn', this)">VPN / Tunnel</button>
            <button type="button" class="status-filter-btn" data-if-filter="pppoe" onclick="filterSnmpInterfaces('pppoe', this)">PPPoE Client</button>
          </div>
          <!-- Search -->
          <div class="sinput" style="max-width:240px;">
            <i class="bi bi-search"></i>
            <input type="text" id="snmpInterfaceSearch" class="fc" placeholder="Cari nama interface..." onkeyup="filterSnmpInterfaceTable(this.value)">
          </div>
          <button class="btn btn-g btn-sm" onclick="loadSnmpInterfaces()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="dtbl">
          <thead>
            <tr>
              <th>Port / OID</th>
              <th>Nama Interface</th>
              <th>Tipe</th>
              <th>Status Link</th>
              <th>Kapasitas Speed</th>
              <th>Download (Rx Live)</th>
              <th>Upload (Tx Live)</th>
              <th>Total In (GB)</th>
              <th>Total Out (GB)</th>
              <th style="text-align:right;">Aksi</th>
            </tr>
          </thead>
          <tbody id="snmp-iface-list">
            <tr>
              <td colspan="10" class="text-center text-muted" style="padding:28px;">
                <i class="bi bi-arrow-clockwise spin me-1"></i> Mengambil data interface via SNMP...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  let snmpInterfacesData = [];
  let currentIfFilter = 'all';
  let isAutoRefreshEnabled = true;
  let refreshTimer = null;

  function getRouterId() {
    return document.getElementById('global-router-id')?.value || '';
  }

  function changeRouter() {
    const rId = getRouterId();
    window.location.href = '/admin/set-active-router?router_id=' + (rId || 'all');
  }

  function downloadBackup(e) {
    e.preventDefault();
    const routerId = getRouterId();
    window.location.href = `/admin/api/mikrotik/backup?routerId=${routerId}`;
  }

  function escapeHtmlAttr(s) {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  async function loadSnmpInterfaces() {
    const routerId = getRouterId();
    try {
      const res = await fetch(`/admin/api/mikrotik/snmp-interfaces?routerId=${routerId}`);
      if (!res.ok) return;
      const d = await res.json();
      if (!d || !Array.isArray(d.interfaces)) return;

      snmpInterfacesData = d.interfaces;

      // Update KPI Cards
      const totalCount = snmpInterfacesData.length;
      const upCount = snmpInterfacesData.filter(i => i.isUp).length;
      const physCount = snmpInterfacesData.filter(i => i.isPhysical).length;
      const vlanCount = snmpInterfacesData.filter(i => i.isVlan).length;

      document.getElementById('kpi-total-ifaces').textContent = totalCount;
      document.getElementById('kpi-up-ifaces').textContent = upCount;
      document.getElementById('kpi-phys-ifaces').textContent = physCount;
      document.getElementById('kpi-total-rx').textContent = `${d.totalRxMbps || 0} Mbps`;
      document.getElementById('kpi-total-tx').textContent = `${d.totalTxMbps || 0} Mbps`;

      document.getElementById('if-count-all').textContent = totalCount;
      document.getElementById('if-count-phys').textContent = physCount;
      document.getElementById('if-count-vlan').textContent = vlanCount;

      renderSnmpInterfacesTable();
    } catch (e) {
      console.warn('SNMP interfaces poll error:', e.message);
    }
  }

  function filterSnmpInterfaces(type, btn) {
    currentIfFilter = type;
    document.querySelectorAll('[data-if-filter]').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    renderSnmpInterfacesTable();
  }

  function filterSnmpInterfaceTable(val) {
    const q = val.toLowerCase();
    const tbody = document.getElementById('snmp-iface-list');
    if (!tbody) return;
    const rows = tbody.getElementsByTagName('tr');
    for (let i = 0; i < rows.length; i++) {
      const text = rows[i].textContent.toLowerCase();
      rows[i].style.display = text.includes(q) ? '' : 'none';
    }
  }

  function renderSnmpInterfacesTable() {
    const tbody = document.getElementById('snmp-iface-list');
    if (!tbody) return;

    if (!snmpInterfacesData || snmpInterfacesData.length === 0) {
      tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted" style="padding:28px;">Tidak ada interface ditemukan via SNMP.</td></tr>';
      return;
    }

    const filtered = snmpInterfacesData.filter(i => {
      if (currentIfFilter === 'physical') return i.isPhysical;
      if (currentIfFilter === 'vlan') return i.isVlan;
      if (currentIfFilter === 'bridge') return i.isBridge;
      if (currentIfFilter === 'vpn') return i.isVpn;
      if (currentIfFilter === 'pppoe') return i.isPppoe;
      return true;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted" style="padding:24px;">Tidak ada interface dengan kategori ini.</td></tr>';
      return;
    }

    tbody.innerHTML = filtered.map(i => {
      const statusBadge = i.isUp
        ? '<span class="badge bs" style="display:inline-flex;align-items:center;gap:4px;"><span class="live-dot" style="width:6px;height:6px;"></span> Up</span>'
        : '<span class="badge bd">Down</span>';

      let typeBadge = '<span class="badge" style="background:#334155;color:#94a3b8;">Virtual</span>';
      if (i.isPhysical) typeBadge = `<span class="badge bp">${escapeHtmlAttr(i.portBadge || 'Physical')}</span>`;
      else if (i.isVlan) typeBadge = '<span class="badge" style="background:rgba(245,158,11,0.2);color:#fbbf24;">VLAN</span>';
      else if (i.isBridge) typeBadge = '<span class="badge" style="background:rgba(56,189,248,0.2);color:#38bdf8;">Bridge</span>';
      else if (i.isVpn) typeBadge = '<span class="badge" style="background:rgba(168,85,247,0.2);color:#c084fc;">VPN</span>';
      else if (i.isPppoe) typeBadge = '<span class="badge" style="background:rgba(16,185,129,0.2);color:#34d399;">PPPoE</span>';

      return `
        <tr>
          <td style="font-family:monospace;color:var(--muted);">${escapeHtmlAttr(i.index)}</td>
          <td class="fw6" style="color:var(--text);font-family:monospace;">${escapeHtmlAttr(i.name)}</td>
          <td>${typeBadge}</td>
          <td>${statusBadge}</td>
          <td><span style="font-size:12px;font-weight:700;color:var(--muted);">${escapeHtmlAttr(i.speedLabel)}</span></td>
          <td style="font-family:monospace;color:#10b981;font-weight:700;">${i.rxMbps} Mbps</td>
          <td style="font-family:monospace;color:#38bdf8;font-weight:700;">${i.txMbps} Mbps</td>
          <td style="font-size:12px;font-family:monospace;color:var(--muted);">${i.inGB} GB</td>
          <td style="font-size:12px;font-family:monospace;color:var(--muted);">${i.outGB} GB</td>
          <td style="text-align:right;">
            <a href="/admin/mikrotik?iface=${encodeURIComponent(i.name)}" class="btn btn-sm btn-g" style="font-size:11px;padding:3px 8px;" title="Monitor pada grafik Dashboard NOC">
              <i class="bi bi-activity text-primary"></i> Pantau
            </a>
          </td>
        </tr>
      `;
    }).join('');
  }

  function toggleAutoRefresh() {
    isAutoRefreshEnabled = !isAutoRefreshEnabled;
    const btn = document.getElementById('auto-refresh-toggle');
    const status = document.getElementById('refresh-status');
    if (isAutoRefreshEnabled) {
      btn.style.background = 'rgba(34,197,94,0.15)';
      btn.style.color = '#22c55e';
      btn.style.borderColor = 'rgba(34,197,94,0.3)';
      if (status) status.textContent = 'Auto';
      startAutoRefresh();
    } else {
      btn.style.background = 'rgba(239,68,68,0.15)';
      btn.style.color = '#ef4444';
      btn.style.borderColor = 'rgba(239,68,68,0.3)';
      if (status) status.textContent = 'Manual';
      stopAutoRefresh();
    }
  }

  function startAutoRefresh() {
    if (refreshTimer) clearInterval(refreshTimer);
    refreshTimer = setInterval(() => {
      if (isAutoRefreshEnabled) loadSnmpInterfaces();
    }, 5000);
  }

  function stopAutoRefresh() {
    if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopAutoRefresh();
    else { loadSnmpInterfaces(); startAutoRefresh(); }
  });

  document.addEventListener('DOMContentLoaded', () => {
    loadSnmpInterfaces();
    startAutoRefresh();
  });
</script>
</body>
</html>
