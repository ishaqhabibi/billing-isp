    } catch (e) {
      alert(e.message);
      window.location.href = '/admin/settings';
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-upload"></i> Upload Logo';
    }
  });
})();

// QRIS Upload JavaScript
(function () {
  const fileInput = document.getElementById('qris_upload_file');
  const btn = document.getElementById('qris_upload_btn');
  if (!fileInput || !btn) return;

  const normalizePayload = (raw) => {
    let s = String(raw || '').replace(/[\r\n\t]+/g, '').trim();
    const idx = s.indexOf('000201');
    if (idx > 0) s = s.slice(idx);
    const lastCrc = s.lastIndexOf('6304');
    if (lastCrc >= 0 && s.length >= lastCrc + 8) s = s.slice(0, lastCrc + 8);
    return s;
  };

  const decodeQrPayloadInBrowser = async (file) => {
    try {
      if (!window.jsQR) return '';
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.decoding = 'async';
      img.src = url;
      await new Promise((resolve, reject) => {
        img.onload = () => resolve();
        img.onerror = () => reject(new Error('Gagal membaca gambar'));
      });
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return '';
      canvas.width = img.naturalWidth || img.width || 0;
      canvas.height = img.naturalHeight || img.height || 0;
      if (!canvas.width || !canvas.height) return '';
      ctx.drawImage(img, 0, 0);
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const res = window.jsQR(imageData.data, canvas.width, canvas.height, { inversionAttempts: 'attemptBoth' });
      URL.revokeObjectURL(url);
      if (!res || !res.data) return '';
      const s = normalizePayload(res.data);
      return s.startsWith('000201') ? s : '';
    } catch {
      return '';
    }
  };

  btn.addEventListener('click', async () => {
    const f = fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
    if (!f) return;
    const fd = new FormData();
    fd.append('qris_file', f);
    const payload = await decodeQrPayloadInBrowser(f);
    if (payload) fd.append('qris_payload', payload);
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Uploading...';
    try {
      const r = await fetch('/admin/settings/qris-upload', { method: 'POST', body: fd, credentials: 'same-origin' });
      if (!r.ok) throw new Error('Upload gagal');
      window.location.href = '/admin/settings#payment';
    } catch (e) {
      window.location.href = '/admin/settings#payment';
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-upload"></i> Upload';
    }
  });
})();

  async function applyIsolirToAllCustomers(btn) {
    const isolirDay = document.getElementById('set_isolir_day')?.value || '1';
    if (!confirm(`Terapkan Tanggal Isolir = ${isolirDay} ke SELURUH pelanggan pascabayar yang ada di database?`)) return;

    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i> Menerapkan...';

    try {
      const res = await fetch('/admin/settings/apply-isolir-to-all', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ isolir_day: isolirDay })
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data && data.success) {
        alert(data.message || `Berhasil menerapkan tanggal isolir ${isolirDay} ke semua pelanggan.`);
      } else {
        alert((data && data.message) || 'Gagal menerapkan ke semua pelanggan.');
      }
    } catch (e) {
      alert('Koneksi terputus: ' + e.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHtml;
    }
  // Modal Helper Functions
  function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
  }
  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
  }
  document.addEventListener('click', function(e) {
    if (e.target && e.target.classList && e.target.classList.contains('mo')) {
      e.target.classList.remove('show');
    }
  });

  // EMVCo Tag Parser (Tag, Length, Value)
  function parseEmvcoTags(str) {
    const tags = {};
    if (!str || typeof str !== 'string') return tags;
    let s = str.trim();
    const idx = s.indexOf('000201');
    if (idx > 0) s = s.slice(idx);
    let pos = 0;
    while (pos < s.length - 4) {
      const tag = s.substr(pos, 2);
      const len = parseInt(s.substr(pos + 2, 2), 10);
      if (isNaN(len) || len <= 0 || pos + 4 + len > s.length) break;
      tags[tag] = s.substr(pos + 4, len);
      pos += 4 + len;
    }
    return tags;
  }

  // Open QRIS Preview Modal
  function openQrisPreviewModal(customUrl, customPayload) {
    const urlInput = document.querySelector('input[name="qris_static_qr_url"]');
    const payloadInput = document.querySelector('textarea[name="qris_static_payload"]');
    
    const url = customUrl || urlInput?.value || '<%= settings.qris_static_qr_url || "" %>';
    const payload = (customPayload !== undefined && customPayload !== null) ? customPayload : (payloadInput?.value || '<%- (settings.qris_static_payload || "").replace(/[\r\n]+/g, "") %>');

    const imgEl = document.getElementById('qrisModalImg');
    const downloadBtn = document.getElementById('qrisModalDownloadBtn');
    const merchantEl = document.getElementById('qrisModalMerchant');
    const cityEl = document.getElementById('qrisModalCity');
    const typeEl = document.getElementById('qrisModalType');
    const payloadEl = document.getElementById('qrisModalPayload');

    if (imgEl) {
      imgEl.src = url || '/img/logo.png';
    }
    if (downloadBtn) {
      downloadBtn.href = url || '#';
    }

    const tags = parseEmvcoTags(payload);
    if (merchantEl) {
      merchantEl.innerText = tags['59'] || (payload ? 'Terbaca dari EMVCo' : 'Belum diatur');
    }
    if (cityEl) {
      cityEl.innerText = tags['60'] || '-';
    }
    if (typeEl) {
      if (tags['01'] === '12') {
        typeEl.innerText = 'Dinamis (Auto Amount)';
        typeEl.className = 'badge bg-success';
      } else {
        typeEl.innerText = 'Statis (Standard)';
        typeEl.className = 'badge bg-info';
      }
    }
    if (payloadEl) {
      payloadEl.innerText = payload || '(Tidak ada string payload EMVCo)';
    }

    openModal('qrisPreviewModal');
  }

  function copyModalPayload() {
    const text = document.getElementById('qrisModalPayload')?.innerText || '';
    if (!text || text.startsWith('(')) return;
    navigator.clipboard.writeText(text).then(() => {
      alert('Payload EMVCo berhasil disalin!');
    }).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      alert('Payload EMVCo berhasil disalin!');
    });
  }

setTimeout(loadEwalletLogs, 200);
