  // Render PPPoE Table with Status & Actions
  function renderPppoeTable() {
    const tbody = document.getElementById('pppoe-list');
    if (!tbody) return;

    if (!pppoeData || pppoeData.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted" style="padding:28px;">' + I18N.emptySecrets + '</td></tr>';
      return;
    }

    const filtered = pppoeData.filter(s => {
      const isOnline = onlineUsersData.some(a => a.name === s.name);
      const isDisabled = s.disabled === true || s.disabled === 'true';
      if (currentPppoeFilter === 'online') return isOnline;
      if (currentPppoeFilter === 'offline') return !isOnline && !isDisabled;
      if (currentPppoeFilter === 'disabled') return isDisabled;
      return true;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted" style="padding:24px;">Tidak ada secret yang cocok dengan filter.</td></tr>';
      return;
    }

    tbody.innerHTML = filtered.map((s, i) => {
      const active = onlineUsersData.find(a => a.name === s.name);
      const isOnline = !!active;
      const isDisabled = s.disabled === true || s.disabled === 'true';
      
      let statusHtml = '';
      if (isOnline) {
        statusHtml = '<span class="badge bs" style="display:inline-flex;align-items:center;gap:4px;"><span class="live-dot" style="width:6px;height:6px;"></span> Online</span>';
      } else if (isDisabled) {
        statusHtml = '<span class="badge bd">Disabled</span>';
      } else {
        statusHtml = '<span class="badge bw">Offline</span>';
      }

      const remoteIp = s.remoteAddress || s['remote-address'] || (active ? active.address : '-');

      return `
        <tr>
          <td class="fw6" style="color:var(--text);font-family:monospace;">
            <i class="bi bi-person-fill text-muted me-1"></i>${escapeHtmlAttr(s.name)}
          </td>
          <td><span class="badge bp">${escapeHtmlAttr(s.profile)}</span></td>
          <td><span style="font-size:12px;font-family:monospace;color:var(--muted);">${escapeHtmlAttr(s.localAddress || s['local-address'] || '-')}</span></td>
          <td>
            <a href="javascript:void(0)" onclick="openPingModal('${escapeHtmlAttr(remoteIp)}')" title="Klik untuk Ping IP ini" style="font-size:12px;font-family:monospace;color:var(--primary);text-decoration:none;">
              <i class="bi bi-hdd-network me-1"></i>${escapeHtmlAttr(remoteIp)}
            </a>
