<div class="mo" id="pingModal">
  <div class="mb" style="max-width:540px;">
    <div class="mh">
      <span class="mt"><i class="bi bi-broadcast-pin text-primary"></i> Diagnostik Ping MikroTik</span>
      <button class="mc" onclick="closeModal('pingModal')">&times;</button>
    </div>
    <div class="mbody">
      <div style="display:flex;gap:10px;align-items:flex-end;margin-bottom:14px;">
        <div class="fg" style="margin:0;flex:1;">
          <label class="fl">Host / IP Address Tujuan</label>
          <input type="text" id="pingHostInput" class="fc" placeholder="192.168.1.1 atau 8.8.8.8" value="8.8.8.8">
        </div>
        <div class="fg" style="margin:0;width:90px;">
          <label class="fl">Paket</label>
          <select id="pingCountInput" class="fc">
            <option value="4" selected>4 Paket</option>
            <option value="8">8 Paket</option>
          </select>
        </div>
        <button type="button" class="btn btn-p" id="btnExecutePing" onclick="executePing()" style="height:38px;padding:0 16px;">
          <i class="bi bi-send-fill"></i> Ping
        </button>
      </div>

      <div class="ping-terminal" id="pingTerminalOutput"># Siap menjalankan ICMP ping test dari router MikroTik...
Ketik alamat IP tujuan untuk menguji konektivitas &amp; latency.</div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g btn-sm" onclick="closeModal('pingModal')">Tutup</button>
    </div>
  </div>
</div>

<script>
  let trafficChart = null;
  const CHART_MAX_POINTS = 24;
  let chartRxPeak = 0;
  let chartTxPeak = 0;
  let currentChartInterface = '<%= (typeof selectedInterface !== "undefined" && selectedInterface && selectedInterface !== "__total__") ? selectedInterface : "sfp-wan-metro" %>';
  let snmpTrafficTimer = null;
  let snmpTelemetryTimer = null;
  let sessionTimer = null;
  let isAutoRefreshEnabled = true;

  function getRouterId() {
    return document.getElementById('global-router-id')?.value || '';
  }

  function changeRouter() {
    const rId = getRouterId();
    window.location.href = '/admin/set-active-router?router_id=' + (rId || 'all');
  }

  function downloadBackup(e) {
    e.preventDefault();
    const routerId = getRouterId();
    window.location.href = `/admin/api/mikrotik/backup?routerId=${routerId}`;
  }

  function escapeHtmlAttr(s) {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
  }

  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
  }

  document.querySelectorAll('.mo').forEach(m => m.addEventListener('click', e => {
    if (e.target === m) closeModal(m.id);
  }));

  // ── TRAFFIC CHART ENGINE ──
  function updateChartTheme() {
    if (!trafficChart) return;
    const isLight = document.documentElement.getAttribute('data-theme') === 'light' ||
                    document.documentElement.classList.contains('light-theme') ||
                    document.body?.classList.contains('light-theme');
    const gridColor = isLight ? 'rgba(0, 52, 120, 0.08)' : 'rgba(255, 255, 255, 0.08)';
    const tickColor = isLight ? '#64748b' : '#94a3b8';
    const legendColor = isLight ? '#334155' : '#94a3b8';

    if (trafficChart.options.scales?.y?.grid) trafficChart.options.scales.y.grid.color = gridColor;
    if (trafficChart.options.scales?.y?.ticks) trafficChart.options.scales.y.ticks.color = tickColor;
    if (trafficChart.options.scales?.x?.ticks) trafficChart.options.scales.x.ticks.color = tickColor;
    if (trafficChart.options.plugins?.legend?.labels) trafficChart.options.plugins.legend.labels.color = legendColor;
    trafficChart.update('none');
  }

  window.addEventListener('appThemeChanged', () => {
    updateChartTheme();
  });

  function initTrafficChart() {
    const canvas = document.getElementById('trafficChartCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const rxGrad = ctx.createLinearGradient(0, 0, 0, 240);
    rxGrad.addColorStop(0, 'rgba(16, 185, 129, 0.35)');
    rxGrad.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

    const txGrad = ctx.createLinearGradient(0, 0, 0, 240);
    txGrad.addColorStop(0, 'rgba(56, 189, 248, 0.35)');
    txGrad.addColorStop(1, 'rgba(56, 189, 248, 0.0)');

    const isLight = document.documentElement.getAttribute('data-theme') === 'light' ||
                    document.documentElement.classList.contains('light-theme') ||
                    document.body?.classList.contains('light-theme');

    trafficChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: Array(CHART_MAX_POINTS).fill(''),
        datasets: [
          {
            label: 'Download (Rx Mbps)',
            data: Array(CHART_MAX_POINTS).fill(0),
            borderColor: '#10b981',
            backgroundColor: rxGrad,
            borderWidth: 2.2,
            tension: 0.35,
            fill: true,
            pointRadius: 0,
            pointHoverRadius: 4,
            pointBackgroundColor: '#10b981'
          },
          {
            label: 'Upload (Tx Mbps)',
            data: Array(CHART_MAX_POINTS).fill(0),
            borderColor: '#38bdf8',
            backgroundColor: txGrad,
            borderWidth: 2.2,
            tension: 0.35,
            fill: true,
            pointRadius: 0,
            pointHoverRadius: 4,
            pointBackgroundColor: '#38bdf8'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 350, easing: 'easeOutQuart' },
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: {
            display: true,
            position: 'top',
            align: 'end',
            labels: { boxWidth: 12, boxHeight: 12, color: isLight ? '#334155' : '#94a3b8', font: { size: 11, weight: '600' } }
          },
          tooltip: {
            backgroundColor: '#0f172a',
            borderColor: '#334155',
            borderWidth: 1,
            titleColor: '#e2e8f0',
            bodyColor: '#e2e8f0',
            padding: 10,
            callbacks: {
              label: (c) => ` ${c.dataset.label}: ${Number(c.raw || 0).toFixed(2)} Mbps`
            }
          }
        },
        scales: {
          x: { grid: { display: false }, ticks: { color: isLight ? '#64748b' : '#94a3b8', font: { size: 10 }, maxRotation: 0 } },
          y: {
            beginAtZero: true,
            suggestedMax: 10,
            grid: { color: isLight ? 'rgba(0, 52, 120, 0.08)' : 'rgba(255, 255, 255, 0.06)' },
            ticks: {
              color: isLight ? '#64748b' : '#94a3b8',
              font: { size: 10 },
              callback: (v) => v >= 1000 ? (v / 1000).toFixed(1) + ' Gbps' : v + ' Mbps'
            }
          }
        }
      }
    });
  }

  async function loadSnmpTraffic() {
    const routerId = getRouterId();
    try {
      const iface = (currentChartInterface && currentChartInterface !== '__total__') ? currentChartInterface : 'sfp-wan-metro';
      const url = `/admin/api/mikrotik/snmp-traffic?routerId=${routerId}&interface=${encodeURIComponent(iface)}`;
      const res = await fetch(url);
      if (!res.ok) return;
      const data = await res.json();
      if (!data) return;

      const rx = Number(data.rxMbps) || 0;
      const tx = Number(data.txMbps) || 0;

      const rxEl = document.getElementById('live-rx-val');
      const txEl = document.getElementById('live-tx-val');
      if (rxEl) rxEl.textContent = `${rx.toFixed(2)} Mbps`;
      if (txEl) txEl.textContent = `${tx.toFixed(2)} Mbps`;

      if (rx > chartRxPeak) chartRxPeak = rx;
      if (tx > chartTxPeak) chartTxPeak = tx;
      const prxEl = document.getElementById('peak-rx-val');
      const ptxEl = document.getElementById('peak-tx-val');
      if (prxEl) prxEl.textContent = chartRxPeak.toFixed(2);
      if (ptxEl) ptxEl.textContent = chartTxPeak.toFixed(2);

      if (trafficChart) {
        const timeStr = new Date(data.timestamp || Date.now()).toLocaleTimeString([], { hour12: false });
        trafficChart.data.labels.push(timeStr);
        trafficChart.data.datasets[0].data.push(rx);
        trafficChart.data.datasets[1].data.push(tx);

        if (trafficChart.data.labels.length > CHART_MAX_POINTS) {
          trafficChart.data.labels.shift();
          trafficChart.data.datasets[0].data.shift();
          trafficChart.data.datasets[1].data.shift();
        }
        trafficChart.update('none');
      }
    } catch (e) {}
  }

  async function loadSnmpTelemetry() {
    const routerId = getRouterId();
    try {
      const res = await fetch(`/admin/api/mikrotik/snmp-telemetry?routerId=${routerId}`);
      if (!res.ok) return;
      const d = await res.json();
      if (!d || !d.isOnline) {
        const badge = document.getElementById('snmp-status-badge');
        if (badge) {
          badge.className = 'snmp-badge-latency';
          badge.style.background = 'rgba(239,68,68,0.12)';
          badge.style.color = '#ef4444';
          badge.innerHTML = '<i class="bi bi-x-circle-fill"></i> SNMP Disconnected';
        }
        return;
      }

      // Router Info
      const idEl = document.getElementById('tel-identity');
      const modelEl = document.getElementById('tel-board-name');
      const rosEl = document.getElementById('tel-ros-version');
      const rackBadgeEl = document.getElementById('rack-model-badge');
      if (idEl) idEl.textContent = d.identity || d.routerName || 'MikroTik';
      if (modelEl) modelEl.textContent = d.model || 'MikroTik';
      if (rosEl) rosEl.textContent = `RouterOS ${d.rosVersion || ''}`;
      if (rackBadgeEl) rackBadgeEl.textContent = `${d.model || 'RB5009'} • PHYSICAL PORTS & SFP+ 10G`;

      // Status & Latency & Uptime
      const badge = document.getElementById('snmp-status-badge');
      if (badge) {
        badge.className = 'snmp-badge-live';
        badge.style.background = 'rgba(16, 185, 129, 0.12)';
        badge.style.color = '#10b981';
        badge.innerHTML = '<span class="live-dot"></span> SNMP Online';
      }
      const latEl = document.getElementById('tel-latency');
      if (latEl) latEl.textContent = `${d.latencyMs || 0} ms`;
      const upEl = document.getElementById('tel-uptime-val');
      if (upEl) upEl.textContent = d.uptime || '-';

      // CPU Matrix
      const cpu = d.cpu || {};
      const avgCpu = Number(cpu.average || 0);
      const avgBadge = document.getElementById('tel-cpu-avg-badge');
      if (avgBadge) avgBadge.textContent = `Avg: ${avgCpu}%`;

      const matrixBox = document.getElementById('cpuMatrixContainer');
      if (matrixBox && Array.isArray(cpu.cores) && cpu.cores.length > 0) {
        matrixBox.innerHTML = cpu.cores.map(c => {
          const load = Number(c.load || 0);
          const barClass = load > 80 ? 'bar-rose' : load > 60 ? 'bar-amber' : 'bar-emerald';
          return `
            <div class="cpu-core-tile">
              <div class="cpu-core-name">Core ${c.core}</div>
              <div class="cpu-core-load">${load}%</div>
              <div class="mini-progress">
                <div class="mini-progress-bar ${barClass}" style="width:${Math.min(load, 100)}%"></div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Thermal & Health Sensors
      const health = d.health || {};
      const bTempEl = document.getElementById('tel-board-temp');
      const cTempEl = document.getElementById('tel-cpu-temp');
      if (bTempEl) bTempEl.textContent = health.boardTemp || 'N/A';
      if (cTempEl) cTempEl.textContent = health.cpuTemp || 'N/A';

      // RAM & Storage
      const ram = d.ram || {};
      const memPct = Number(ram.percent || 0);
      const memValEl = document.getElementById('tel-mem-val');
      const memBarEl = document.getElementById('tel-mem-bar');
      const memPctEl = document.getElementById('tel-mem-percent');
      if (memValEl) memValEl.textContent = `${ram.usedMB || 0} / ${ram.totalMB || 0} MB`;
      if (memBarEl) memBarEl.style.width = `${Math.min(memPct, 100)}%`;
      if (memPctEl) memPctEl.textContent = `${memPct}%`;

      const disk = d.disk || {};
      const diskPct = Number(disk.percent || 0);
      const diskValEl = document.getElementById('tel-disk-val');
      const diskBarEl = document.getElementById('tel-disk-bar');
      if (diskValEl) diskValEl.textContent = `${disk.usedMB || 0} / ${disk.totalMB || 0} MB`;
      if (diskBarEl) diskBarEl.style.width = `${Math.min(diskPct, 100)}%`;
    } catch (e) {
      console.warn(e);
    }
  }

  async function loadRackPorts() {
    const routerId = getRouterId();
    try {
      const res = await fetch(`/admin/api/mikrotik/snmp-interfaces?routerId=${routerId}`);
      if (!res.ok) return;
      const d = await res.json();
      if (!d || !Array.isArray(d.interfaces)) return;

      const physicals = d.interfaces.filter(i => i.isPhysical);
      const rackGrid = document.getElementById('rackPortsGrid');
      if (!rackGrid) return;

      if (physicals.length === 0) {
        rackGrid.innerHTML = '<div class="text-muted text-center" style="grid-column: 1 / -1; padding: 14px;">Tidak ada port fisik terdeteksi.</div>';
        return;
      }

      // Populate Interface Selector Dropdown strictly from physical interfaces
      const select = document.getElementById('traffic-interface-select');
      if (select && (select.options.length <= 1 || !select.querySelector(`option[value="${select.value}"]`))) {
        const curTarget = (currentChartInterface && currentChartInterface !== '__total__') ? currentChartInterface : select.value;
        select.innerHTML = physicals.map(iface => {
          const badgeStr = iface.portBadge ? `[${iface.portBadge}] ` : '';
          const isSel = (iface.name === curTarget);
          return `<option value="${escapeHtmlAttr(iface.name)}" ${isSel ? 'selected' : ''}>${escapeHtmlAttr(badgeStr)}${escapeHtmlAttr(iface.name)} (${iface.isUp ? 'UP' : 'DOWN'})</option>`;
        }).join('');
        if (curTarget && select.querySelector(`option[value="${curTarget}"]`)) {
          select.value = curTarget;
        } else if (physicals.length > 0) {
          select.value = physicals[0].name;
          currentChartInterface = physicals[0].name;
        }
      }

      rackGrid.innerHTML = physicals.map(port => {
        const isSelected = currentChartInterface === port.name;
        const isSfp = (port.portBadge && port.portBadge.includes('SFP')) || port.name.toLowerCase().includes('sfp');
        const cardClass = `rack-port-card ${port.isUp ? 'is-up' : ''} ${isSelected ? 'selected' : ''} ${isSfp ? 'sfp-port' : ''}`;
        const ledClass = `rack-port-led ${port.isUp ? (isSfp ? 'sfp-up' : 'up') : ''}`;
        const speedClass = port.speedMbps >= 10000 ? 'speed-10g' : (port.speedMbps >= 2500 ? 'speed-25g' : (port.speedMbps >= 1000 ? 'speed-1g' : ''));
        const portTitle = port.portBadge || `Port ${port.index}`;
        const iconClass = isSfp ? 'bi bi-lightning-charge' : 'bi bi-ethernet';

        return `
          <div class="${cardClass}" onclick="selectRackPort('${escapeHtmlAttr(port.name)}')" title="Klik untuk monitor ${escapeHtmlAttr(port.name)}">
            <div style="display:flex;align-items:center;justify-content:space-between;width:100%;margin-bottom:2px;">
              <span class="rack-port-header-label">${escapeHtmlAttr(portTitle)}</span>
              <span class="${ledClass}"></span>
            </div>
            <i class="${iconClass} rack-port-icon"></i>
            <span class="rack-port-name">${escapeHtmlAttr(port.name)}</span>
            <span class="rack-port-speed ${speedClass}">${port.isUp ? escapeHtmlAttr(port.speedLabel) : 'DOWN'}</span>
            <span class="rack-port-traffic">↓${port.rxMbps} ↑${port.txMbps}M</span>
          </div>
        `;
      }).join('');
    } catch (e) {
      console.warn(e);
    }
  }

  function selectRackPort(portName) {
    if (!portName || portName === '__total__') portName = 'sfp-wan-metro';
    if (currentChartInterface !== portName) {
      currentChartInterface = portName;
      chartRxPeak = 0;
      chartTxPeak = 0;
      if (trafficChart) {
        trafficChart.data.labels = Array(CHART_MAX_POINTS).fill('');
        trafficChart.data.datasets[0].data = Array(CHART_MAX_POINTS).fill(0);
        trafficChart.data.datasets[1].data = Array(CHART_MAX_POINTS).fill(0);
        trafficChart.update('none');
      }
    }
    const select = document.getElementById('traffic-interface-select');
    if (select) select.value = portName;
    try {
      const newUrl = new URL(window.location);
      newUrl.searchParams.set('iface', portName);
      window.history.replaceState({}, '', newUrl);
    } catch(_) {}
    loadRackPorts();
    loadSnmpTraffic();
  }

  function onTrafficInterfaceChange() {
    const select = document.getElementById('traffic-interface-select');
    if (!select) return;
    const val = (select.value && select.value !== '__total__') ? select.value : 'sfp-wan-metro';
    if (currentChartInterface !== val) {
      currentChartInterface = val;
      chartRxPeak = 0;
      chartTxPeak = 0;
      if (trafficChart) {
        trafficChart.data.labels = Array(CHART_MAX_POINTS).fill('');
        trafficChart.data.datasets[0].data = Array(CHART_MAX_POINTS).fill(0);
        trafficChart.data.datasets[1].data = Array(CHART_MAX_POINTS).fill(0);
        trafficChart.update('none');
      }
      try {
        const newUrl = new URL(window.location);
        newUrl.searchParams.set('iface', val);
        window.history.replaceState({}, '', newUrl);
      } catch(_) {}
      loadRackPorts();
      loadSnmpTraffic();
    }
  }

  // ── NOC ACTIVE SESSIONS & KPI SUMMARY ──
  async function loadNocSessions() {
    const routerId = getRouterId();
    try {
      const [pRes, aRes, hRes, haRes] = await Promise.all([
        fetch(`/admin/api/mikrotik/secrets?routerId=${routerId}`),
        fetch(`/admin/api/mikrotik/active-pppoe?routerId=${routerId}`),
        fetch(`/admin/api/mikrotik/hotspot-users?routerId=${routerId}`),
        fetch(`/admin/api/mikrotik/active-hotspot?routerId=${routerId}`)
      ]);

      const secrets = pRes.ok ? await pRes.json() : [];
      const pppoeActive = aRes.ok ? await aRes.json() : [];
      const hotspotUsers = hRes.ok ? await hRes.json() : [];
      const hotspotActive = haRes.ok ? await haRes.json() : [];

      // Update KPI counters
      const pOnEl = document.getElementById('pppoe-online-count');
      const pOffEl = document.getElementById('pppoe-offline-count');
      const pTotEl = document.getElementById('total-secrets-count');
      const hOnEl = document.getElementById('hotspot-online-count');
      const hTotEl = document.getElementById('total-hotspot-count');

      const offlineCount = secrets.filter(s => {
        const isOnline = pppoeActive.some(a => a.name === s.name);
        const isDisabled = s.disabled === true || s.disabled === 'true';
        return !isOnline && !isDisabled;
      }).length;

      if (pOnEl) pOnEl.textContent = pppoeActive.length;
      if (pOffEl) pOffEl.textContent = offlineCount;
      if (pTotEl) pTotEl.textContent = secrets.length;
      if (hOnEl) hOnEl.textContent = hotspotActive.length;
      if (hTotEl) hTotEl.textContent = hotspotUsers.length;

      // Render NOC PPPoE Preview (Top 5)
      const pTbody = document.getElementById('noc-active-pppoe-list');
      if (pTbody) {
        if (pppoeActive.length === 0) {
          pTbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted" style="padding:18px;">Tidak ada sesi PPPoE aktif</td></tr>';
        } else {
          pTbody.innerHTML = pppoeActive.slice(0, 5).map(a => `
            <tr>
              <td class="fw6" style="font-family:monospace;color:var(--text);">
                <i class="bi bi-person-check-fill text-success me-1"></i>${escapeHtmlAttr(a.name)}
              </td>
              <td><code>${escapeHtmlAttr(a.address || '-')}</code></td>
              <td style="font-size:12px;font-family:monospace;color:#10b981;">${escapeHtmlAttr(a.uptime || '-')}</td>
              <td style="text-align:right;">
                <button class="btn btn-d btn-sm py-0 px-2" style="font-size:11px;" onclick="kickPppoeUser('${escapeHtmlAttr(a.name)}', this)" title="Putuskan Sesi">
                  <i class="bi bi-power"></i> Putus
                </button>
              </td>
            </tr>
          `).join('');
        }
      }

      // Render NOC Hotspot Preview (Top 5)
      const hTbody = document.getElementById('noc-active-hotspot-list');
      if (hTbody) {
        if (hotspotActive.length === 0) {
          hTbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted" style="padding:18px;">Tidak ada voucher hotspot aktif</td></tr>';
        } else {
          hTbody.innerHTML = hotspotActive.slice(0, 5).map(a => {
            const u = a.user || a.name || '-';
            return `
              <tr>
                <td class="fw6" style="font-family:monospace;color:var(--text);">
                  <i class="bi bi-ticket-fill text-emerald me-1"></i>${escapeHtmlAttr(u)}
                </td>
                <td><code>${escapeHtmlAttr(a.address || '-')}</code></td>
                <td style="font-size:12px;font-family:monospace;color:#10b981;">${escapeHtmlAttr(a.uptime || '-')}</td>
                <td style="text-align:right;">
                  <button class="btn btn-d btn-sm py-0 px-2" style="font-size:11px;" onclick="kickHotspotUser('${escapeHtmlAttr(u)}', this)" title="Putuskan Sesi">
                    <i class="bi bi-power"></i> Putus
                  </button>
                </td>
              </tr>
            `;
          }).join('');
        }
      }
    } catch (e) {
      console.warn(e);
    }
  }

  // ── QUICK KICK ACTIONS ──
  async function kickPppoeUser(username, btn) {
    if (!confirm(`Putuskan paksa sesi PPPoE aktif untuk user "${username}"?`)) return;
    let oldHtml = '';
    if (btn) { oldHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i>'; }
    try {
      const res = await fetch('/admin/api/mikrotik/kick-pppoe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, routerId: getRouterId() })
      });
      const d = await res.json();
      if (d && d.success) {
        alert(d.message || 'Sesi berhasil diputus!');
        loadNocSessions();
      } else {
        alert('Gagal: ' + (d.error || 'Terjadi kesalahan'));
      }
    } catch (e) {
      alert('Error: ' + e.message);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = oldHtml; }
    }
  }

  async function kickHotspotUser(username, btn) {
    if (!confirm(`Putuskan paksa sesi Hotspot aktif untuk voucher "${username}"?`)) return;
    let oldHtml = '';
    if (btn) { oldHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i>'; }
    try {
      const res = await fetch('/admin/api/mikrotik/kick-hotspot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, routerId: getRouterId() })
      });
      const d = await res.json();
      if (d && d.success) {
        alert(d.message || 'Sesi berhasil diputus!');
        loadNocSessions();
      } else {
        alert('Gagal: ' + (d.error || 'Terjadi kesalahan'));
      }
    } catch (e) {
      alert('Error: ' + e.message);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = oldHtml; }
    }
  }

  // ── PING DIAGNOSTIC MODAL ──
  function openPingModal(targetIp = '') {
    if (targetIp) {
      const input = document.getElementById('pingHostInput');
      if (input) input.value = targetIp;
    }
    openModal('pingModal');
  }

  async function executePing() {
    const host = document.getElementById('pingHostInput').value.trim();
    const count = document.getElementById('pingCountInput').value;
    const btn = document.getElementById('btnExecutePing');
    const term = document.getElementById('pingTerminalOutput');

    if (!host) return alert('Silakan masukkan Host / IP tujuan.');

    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i> Menguji...';
    term.textContent = `Mengirim ${count} paket ICMP ping ke ${host} via MikroTik...\n`;

    try {
      const res = await fetch('/admin/api/mikrotik/ping', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ host, count, routerId: getRouterId() })
      });
      const data = await res.json();
      if (data && data.success && Array.isArray(data.results)) {
        let out = `PING ${host} (${data.results.length} respons diterima):\n\n`;
        data.results.forEach((p, idx) => {
          const seq = p.seq || (idx + 1);
          const time = p.time || p['round-trip-time'] || '-';
          const size = p.size || '56';
          const ttl = p.ttl || '-';
          const status = p.status ? `[${p.status}]` : '';
          out += `  seq=${seq}  size=${size} bytes  ttl=${ttl}  time=${time} ${status}\n`;
        });
        term.textContent = out;
      } else {
        term.textContent = `Gagal menjalankan ping: ${data.error || 'Router tidak merespons'}`;
      }
    } catch (e) {
      term.textContent = `Error: ${e.message}`;
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-send-fill"></i> Ping';
    }
  }

  // ── AUTO REFRESH TIMERS ──
  function startPolling() {
    stopPolling();

    loadSnmpTelemetry();
    loadSnmpTraffic();
    loadRackPorts();
    loadNocSessions();

    // Fast 2.5s for bandwidth throughput
    snmpTrafficTimer = setInterval(() => {
      if (!isAutoRefreshEnabled) return;
      loadSnmpTraffic();
    }, 2500);

    // 5s for CPU telemetry & rack links
    snmpTelemetryTimer = setInterval(() => {
      if (!isAutoRefreshEnabled) return;
      loadSnmpTelemetry();
      loadRackPorts();
    }, 5000);

    // 10s for active PPPoE & Hotspot sessions preview
    sessionTimer = setInterval(() => {
      if (!isAutoRefreshEnabled) return;
      loadNocSessions();
    }, 10000);
  }

  function stopPolling() {
    if (snmpTrafficTimer) { clearInterval(snmpTrafficTimer); snmpTrafficTimer = null; }
    if (snmpTelemetryTimer) { clearInterval(snmpTelemetryTimer); snmpTelemetryTimer = null; }
    if (sessionTimer) { clearInterval(sessionTimer); sessionTimer = null; }
  }

  function toggleAutoRefresh() {
    isAutoRefreshEnabled = !isAutoRefreshEnabled;
    const btn = document.getElementById('auto-refresh-toggle');
    const status = document.getElementById('refresh-status');
    if (isAutoRefreshEnabled) {
      btn.style.background = 'rgba(34,197,94,0.15)';
      btn.style.color = '#22c55e';
      btn.style.borderColor = 'rgba(34,197,94,0.3)';
      if (status) status.textContent = 'Auto';
      startPolling();
    } else {
      btn.style.background = 'rgba(239,68,68,0.15)';
      btn.style.color = '#ef4444';
      btn.style.borderColor = 'rgba(239,68,68,0.3)';
      if (status) status.textContent = 'Manual';
      stopPolling();
    }
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopPolling();
    else if (isAutoRefreshEnabled) startPolling();
  });

  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const ifaceParam = urlParams.get('iface');
    if (ifaceParam && ifaceParam !== '__total__') {
      currentChartInterface = ifaceParam;
    }
    initTrafficChart();
    startPolling();
  });
</script>
</body>
