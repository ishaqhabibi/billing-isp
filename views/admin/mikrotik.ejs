<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dashboard NOC MikroTik | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.7">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    /* ── PAGE LAYOUT & HEADER ── */
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block; animation: pulse 1.8s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.85); } }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .spin { animation: spin 1s linear infinite; display: inline-block; }

    /* ── NOC SNMP TELEMETRY & HARDWARE PANELS ── */
    .snmp-badge-live {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 10px; border-radius: 999px;
      font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
      background: rgba(16, 185, 129, 0.12); color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.3); text-transform: uppercase;
    }
    .snmp-badge-latency {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 4px 10px; border-radius: 999px;
      font-size: 11px; font-weight: 700;
      background: rgba(56, 189, 248, 0.12); color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.25);
    }

    .noc-hardware-grid {
      display: grid;
      grid-template-columns: 1.3fr 1.6fr 1.1fr;
      gap: 16px;
      margin-bottom: 20px;
    }
    @media (max-width: 1200px) { .noc-hardware-grid { grid-template-columns: 1fr; } }

    .noc-box {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px 20px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .noc-box::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, #0052cc, #06b6d4, #10b981);
    }
    .noc-box-title {
      font-size: 12px; font-weight: 700; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.8px;
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 12px;
    }

    /* CPU Matrix (Quad-Core RB5009) */
    .cpu-matrix-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }
    @media (max-width: 600px) { .cpu-matrix-grid { grid-template-columns: repeat(2, 1fr); } }
    .cpu-core-tile {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 8px;
      text-align: center;
      transition: all 0.2s ease;
    }
    .cpu-core-tile:hover {
      border-color: rgba(255,255,255,0.25);
      transform: translateY(-2px);
    }
    .cpu-core-name { font-size: 11px; font-weight: 600; color: var(--muted); margin-bottom: 3px; }
    .cpu-core-load { font-size: 18px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; margin-bottom: 6px; }

    /* Health & Sensors */
    .health-stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 12px;
    }
    @media (max-width: 600px) { .health-stats-row { grid-template-columns: 1fr; } }
    .health-stat-chip {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .health-stat-lbl { font-size: 10.5px; font-weight: 600; color: var(--muted); display: flex; align-items: center; gap: 5px; text-transform: uppercase; }
    .health-stat-val { font-size: 15px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }

    /* Mini Progress */
    .mini-progress {
      width: 100%; height: 6px; background: var(--bg3); border-radius: 999px; overflow: hidden; margin-top: 4px;
    }
    .mini-progress-bar { height: 100%; border-radius: 999px; transition: width 0.4s ease; }
    .bar-emerald { background: #10b981; }
    .bar-amber { background: #f59e0b; }
    .bar-rose { background: #ef4444; }
    .bar-blue { background: #0052cc; }
    .bar-cyan { background: #06b6d4; }

    /* Visual Switchport Rack Panel (RB5009 Rackmount) */
    .rack-panel {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px 20px;
      margin-bottom: 22px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
      position: relative;
      transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .rack-panel-header {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 10px; margin-bottom: 14px;
      border-bottom: 1px solid var(--border); padding-bottom: 10px;
      transition: border-color 0.25s ease;
    }
    .rack-branding {
      display: flex; align-items: center; gap: 12px;
    }
    .rack-logo {
      font-size: 13px; font-weight: 900; letter-spacing: 1.5px;
      color: var(--primary); text-transform: uppercase;
      background: var(--pdim); border: 1px solid rgba(0, 82, 204, 0.25);
      padding: 3px 8px; border-radius: 6px;
    }
    .rack-model-text { font-size: 12px; font-weight: 700; color: var(--muted); letter-spacing: 0.5px; }

    .rack-status-legend {
      display: flex; align-items: center; gap: 12px; font-size: 11px; color: var(--muted);
    }
    .rack-all-btn {
      font-size: 11px; font-weight: 700;
      color: var(--primary); border: 1px solid var(--border);
      background: var(--bg3); transition: all 0.2s ease;
    }
    .rack-all-btn:hover {
      background: var(--primary); color: #ffffff !important; border-color: var(--primary);
    }

    .rack-ports-grid {
      display: grid;
      grid-template-columns: repeat(9, 1fr);
      gap: 8px;
    }
    @media (max-width: 1200px) { .rack-ports-grid { grid-template-columns: repeat(5, 1fr); } }
    @media (max-width: 768px) { .rack-ports-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 480px) { .rack-ports-grid { grid-template-columns: repeat(2, 1fr); } }

    .rack-port-card {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 8px;
      display: flex; flex-direction: column; align-items: center; text-align: center;
      gap: 6px; cursor: pointer; transition: all 0.2s ease;
      position: relative; user-select: none;
    }
    .rack-port-card:hover {
      border-color: var(--primary);
      background: var(--bg2);
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(0, 82, 204, 0.15);
    }
    .rack-port-card.selected {
      border-color: #10b981 !important;
      background: rgba(16, 185, 129, 0.12) !important;
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.3) !important;
    }
    .rack-port-card.sfp-port {
      background: rgba(6, 182, 212, 0.06);
      border: 1.5px dashed rgba(6, 182, 212, 0.45);
    }
    .rack-port-card.sfp-port:hover {
      border-color: #06b6d4;
      background: rgba(6, 182, 212, 0.12);
    }
    .rack-port-card.sfp-port.selected {
      border-color: #10b981 !important;
      background: rgba(16, 185, 129, 0.14) !important;
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.35) !important;
    }
    .rack-port-header-label {
      font-size: 10px; font-weight: 700; color: var(--muted);
    }
    .rack-port-led {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--muted); opacity: 0.35; transition: all 0.3s;
    }
    .rack-port-led.up {
      opacity: 1;
      background: #10b981;
      box-shadow: 0 0 8px #10b981, 0 0 12px rgba(16, 185, 129, 0.6);
      animation: pulse 2s infinite;
    }
    .rack-port-led.sfp-up {
      opacity: 1;
      background: #06b6d4;
      box-shadow: 0 0 8px #06b6d4, 0 0 12px rgba(6, 182, 212, 0.6);
      animation: pulse 2s infinite;
    }
    .rack-port-icon { font-size: 16px; color: var(--muted); }
    .rack-port-card.is-up .rack-port-icon { color: var(--primary); }
    .rack-port-card.sfp-port.is-up .rack-port-icon { color: #06b6d4; }
    .rack-port-name {
      font-size: 11px; font-weight: 700; color: var(--text);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
    }
    .rack-port-speed {
      font-size: 9.5px; font-weight: 700;
      padding: 2px 6px; border-radius: 4px;
      background: var(--bg2); color: var(--muted);
      border: 1px solid var(--border);
    }
    .rack-port-speed.speed-10g { background: rgba(168, 85, 247, 0.15); color: #9333ea; border: 1px solid rgba(168, 85, 247, 0.35); }
    .rack-port-speed.speed-25g { background: rgba(56, 189, 248, 0.15); color: #0284c7; border: 1px solid rgba(56, 189, 248, 0.35); }
    .rack-port-speed.speed-1g { background: rgba(16, 185, 129, 0.15); color: #16a34a; border: 1px solid rgba(16, 185, 129, 0.3); }
    .rack-port-traffic {
      font-size: 9.5px; font-family: monospace; color: var(--muted);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
    }

    /* ── Light Mode Explicit Overrides (Clean White & High Contrast) ── */
    [data-theme="light"] .rack-panel,
    html.light-theme .rack-panel,
    body.light-theme .rack-panel {
      background: #ffffff !important;
      border: 1px solid rgba(0, 52, 120, 0.1) !important;
      box-shadow: 0 4px 20px rgba(0, 52, 120, 0.06) !important;
    }
    [data-theme="light"] .rack-panel-header,
    html.light-theme .rack-panel-header,
    body.light-theme .rack-panel-header {
      border-bottom-color: rgba(0, 52, 120, 0.08) !important;
    }
    [data-theme="light"] .rack-status-legend,
    html.light-theme .rack-status-legend,
    body.light-theme .rack-status-legend {
      color: #5a6e85 !important;
    }
    [data-theme="light"] .rack-all-btn,
    html.light-theme .rack-all-btn,
    body.light-theme .rack-all-btn {
      color: #0052cc !important;
      border-color: rgba(0, 82, 204, 0.25) !important;
      background: #f1f6fc !important;
    }
    [data-theme="light"] .rack-all-btn:hover,
    html.light-theme .rack-all-btn:hover,
    body.light-theme .rack-all-btn:hover {
      background: #0052cc !important;
      color: #ffffff !important;
    }
    [data-theme="light"] .rack-port-card,
    html.light-theme .rack-port-card,
    body.light-theme .rack-port-card {
      background: #f1f6fc !important;
      border: 1px solid rgba(0, 52, 120, 0.1) !important;
    }
    [data-theme="light"] .rack-port-card:hover,
    html.light-theme .rack-port-card:hover,
    body.light-theme .rack-port-card:hover {
      background: #ffffff !important;
      border-color: #0052cc !important;
      box-shadow: 0 4px 14px rgba(0, 82, 204, 0.15) !important;
    }
    [data-theme="light"] .rack-port-card.selected,
    html.light-theme .rack-port-card.selected,
    body.light-theme .rack-port-card.selected {
      background: rgba(16, 185, 129, 0.1) !important;
      border-color: #10b981 !important;
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.25) !important;
    }
    [data-theme="light"] .rack-port-card.sfp-port,
    html.light-theme .rack-port-card.sfp-port,
    body.light-theme .rack-port-card.sfp-port {
      background: rgba(6, 182, 212, 0.07) !important;
      border: 1.5px dashed rgba(6, 182, 212, 0.45) !important;
    }
    [data-theme="light"] .rack-port-card.sfp-port:hover,
    html.light-theme .rack-port-card.sfp-port:hover,
    body.light-theme .rack-port-card.sfp-port:hover {
      background: rgba(6, 182, 212, 0.14) !important;
      border-color: #0891b2 !important;
    }
    [data-theme="light"] .rack-port-header-label,
    html.light-theme .rack-port-header-label,
    body.light-theme .rack-port-header-label {
      color: #5a6e85 !important;
    }
    [data-theme="light"] .rack-port-name,
    html.light-theme .rack-port-name,
    body.light-theme .rack-port-name {
      color: #0f172a !important;
    }
    [data-theme="light"] .rack-port-speed,
    html.light-theme .rack-port-speed,
    body.light-theme .rack-port-speed {
      background: #ffffff !important;
      color: #334155 !important;
      border-color: rgba(0, 52, 120, 0.1) !important;
    }
    [data-theme="light"] .rack-port-traffic,
    html.light-theme .rack-port-traffic,
    body.light-theme .rack-port-traffic {
      color: #5a6e85 !important;
    }
    [data-theme="light"] .chart-container-card,
    html.light-theme .chart-container-card,
    body.light-theme .chart-container-card {
      box-shadow: 0 4px 20px rgba(0, 52, 120, 0.06) !important;
    }

    /* ── Dark Mode Explicit Polish ── */
    [data-theme="dark"] .rack-panel,
    html:not(.light-theme) .rack-panel {
      box-shadow: 0 8px 30px rgba(0,0,0,0.4);
    }
    [data-theme="dark"] .rack-port-card:hover,
    html:not(.light-theme) .rack-port-card:hover {
      background: #1e293b;
      border-color: #38bdf8;
    }
    [data-theme="dark"] .rack-port-header-label,
    html:not(.light-theme) .rack-port-header-label {
      color: #94a3b8;
    }
    [data-theme="dark"] .rack-port-name,
    html:not(.light-theme) .rack-port-name {
      color: #e2e8f0;
    }
    [data-theme="dark"] .rack-port-speed,
    html:not(.light-theme) .rack-port-speed {
      background: #1e293b;
      color: #94a3b8;
    }
    [data-theme="dark"] .rack-port-traffic,
    html:not(.light-theme) .rack-port-traffic {
      color: #94a3b8;
    }
    [data-theme="dark"] .rack-port-speed.speed-10g,
    html:not(.light-theme) .rack-port-speed.speed-10g { color: #c084fc; background: rgba(168, 85, 247, 0.2); }
    [data-theme="dark"] .rack-port-speed.speed-25g,
    html:not(.light-theme) .rack-port-speed.speed-25g { color: #38bdf8; background: rgba(56, 189, 248, 0.2); }
    [data-theme="dark"] .rack-port-speed.speed-1g,
    html:not(.light-theme) .rack-port-speed.speed-1g { color: #34d399; background: rgba(16, 185, 129, 0.2); }

    /* Live Bandwidth Chart Container */
    .chart-container-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 22px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.25);
      transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .chart-top-bar {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 14px; margin-bottom: 18px;
    }
    .chart-traffic-readout {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .traffic-pill {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px; border-radius: 10px;
      font-size: 12.5px; font-weight: 700;
    }
    .traffic-pill.pill-rx {
      background: rgba(16, 185, 129, 0.12); color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .traffic-pill.pill-tx {
      background: rgba(56, 189, 248, 0.12); color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.3);
    }
    .traffic-pill.pill-peak {
      background: var(--bg3); color: var(--muted);
      border: 1px solid var(--border); font-size: 11px;
    }
    .chart-canvas-wrapper {
      position: relative; height: 260px; width: 100%;
    }

    /* ── KPI STAT GRID (5 Modern Link Cards) ── */
    .kpi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-bottom: 22px; }
    @media(max-width: 1200px) { .kpi-grid { grid-template-columns: repeat(3, 1fr); } }
    @media(max-width: 768px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 480px) { .kpi-grid { grid-template-columns: 1fr; } }

    .kpi-card {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 14px;
      padding: 16px 18px; position: relative; overflow: hidden;
      transition: all 0.2s ease; cursor: pointer; user-select: none;
      display: flex; flex-direction: column; justify-content: space-between;
      text-decoration: none;
    }
    .kpi-card:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.2); box-shadow: 0 6px 20px rgba(0,0,0,0.3); }
    .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
    .kpi-card.c-success::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .kpi-card.c-warning::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .kpi-card.c-primary::before { background: linear-gradient(90deg, #0052cc, #38bdf8); }
    .kpi-card.c-emerald::before { background: linear-gradient(90deg, #059669, #10b981); }
    .kpi-card.c-purple::before { background: linear-gradient(90deg, #7c3aed, #a78bfa); }

    .kpi-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .kpi-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .kpi-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; background: var(--bg3); }
    .kpi-card.c-success .kpi-icon { color: #10b981; background: rgba(16,185,129,0.12); }
    .kpi-card.c-warning .kpi-icon { color: #f59e0b; background: rgba(245,158,11,0.12); }
    .kpi-card.c-primary .kpi-icon { color: #38bdf8; background: rgba(0,82,204,0.12); }
    .kpi-card.c-emerald .kpi-icon { color: #10b981; background: rgba(16,185,129,0.12); }
    .kpi-card.c-purple .kpi-icon { color: #a78bfa; background: rgba(124,58,237,0.12); }

    .kpi-val { font-size: 26px; font-weight: 800; line-height: 1; color: var(--text); font-variant-numeric: tabular-nums; margin-bottom: 8px; }
    .kpi-bottom { font-size: 11px; color: var(--muted); border-top: 1px dashed var(--border); padding-top: 6px; display: flex; justify-content: space-between; align-items: center; }

    /* ── NOC DUAL PREVIEW GRID ── */
    .noc-preview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
    @media(max-width: 992px) { .noc-preview-grid { grid-template-columns: 1fr; } }

    .card-modern { background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.15); }
    .card-modern-hd { padding: 14px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
    .card-modern-title { font-size: 13.5px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0; }

    /* Ping Terminal Area */
    .ping-terminal {
      background: #090d16; border: 1px solid #1e293b; border-radius: 10px;
      padding: 14px; font-family: monospace; font-size: 12px; color: #38bdf8;
      max-height: 240px; overflow-y: auto; line-height: 1.6; white-space: pre-wrap;
    }

    /* Modal */
    .mo { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 2000; padding: 20px; }
    .mo.show { display: flex; animation: fadeIn 0.2s ease; }
    .mb { background: var(--bg2); border: 1px solid var(--border); border-radius: 18px; width: 100%; box-shadow: 0 16px 40px rgba(0,0,0,0.5); overflow: hidden; display: flex; flex-direction: column; max-height: 90vh; }
    .mh { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--bg3); }
    .mt { font-size: 15px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0; }
    .mc { background: transparent; border: none; color: var(--muted); font-size: 20px; cursor: pointer; padding: 4px; }
    .mbody { padding: 20px; overflow-y: auto; }
    .mf { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: flex-end; gap: 10px; background: var(--bg3); }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'mikrotik', company }) %>
<div class="mw">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-speedometer2 text-primary"></i>
      <span>Dashboard NOC MikroTik</span>
    </div>
    <div class="tb-right" style="display:flex;align-items:center;gap:12px">
      <!-- Router Selector -->
      <div style="display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);padding:4px 10px;border-radius:9px;">
        <i class="bi bi-hdd-network text-primary" style="font-size:13px;"></i>
