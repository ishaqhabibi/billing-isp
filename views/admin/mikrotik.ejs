          <td>${statusHtml}</td>
          <td style="text-align:right;">
            <div class="action-group" style="justify-content:flex-end;">
              ${isOnline ? `
                <button class="btn-act btn-kick" onclick="kickPppoeUser('${escapeHtmlAttr(s.name)}', this)" title="Putuskan Sesi Aktif (Kick)">
                  <i class="bi bi-power"></i>
