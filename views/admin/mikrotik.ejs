<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.mikrotik_monitoring', 'Monitoring MikroTik') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.6">
  <style>
    /* ── PAGE LAYOUT & HEADER ── */
    .mt-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 20px; }
    .mt-title-group { display: flex; flex-direction: column; gap: 4px; }
    .mt-title { font-size: 20px; font-weight: 800; color: var(--text); margin: 0; display: flex; align-items: center; gap: 10px; letter-spacing: -0.02em; }
    .mt-subtitle { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block; animation: pulse 1.8s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.85); } }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .spin { animation: spin 1s linear infinite; display: inline-block; }

    /* ── ROUTER HARDWARE TELEMETRY STRIP ── */
    .telemetry-strip {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px 20px;
      margin-bottom: 20px;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 16px;
      align-items: center;
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }
    @media(max-width: 992px) { .telemetry-strip { grid-template-columns: 1fr 1fr; } }
    @media(max-width: 580px) { .telemetry-strip { grid-template-columns: 1fr; } }

    .telemetry-item { display: flex; align-items: center; gap: 12px; }
    .telemetry-icon {
      width: 40px; height: 40px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
      background: var(--bg3); color: var(--primary);
    }
    .telemetry-info { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .telemetry-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .telemetry-val { font-size: 14px; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .mini-progress {
      width: 100%; height: 6px; background: var(--bg3); border-radius: 999px; overflow: hidden; margin-top: 4px;
    }
    .mini-progress-bar { height: 100%; border-radius: 999px; transition: width 0.4s ease; }
    .bar-emerald { background: #10b981; }
    .bar-amber { background: #f59e0b; }
    .bar-rose { background: #ef4444; }
    .bar-blue { background: #0052cc; }

    /* ── KPI STAT GRID (5 Modern Cards) ── */
    .kpi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-bottom: 22px; }
    @media(max-width: 1200px) { .kpi-grid { grid-template-columns: repeat(3, 1fr); } }
    @media(max-width: 768px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 480px) { .kpi-grid { grid-template-columns: 1fr; } }

    .kpi-card {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 12px;
      padding: 16px 18px; position: relative; overflow: hidden;
      transition: all 0.2s ease; cursor: pointer; user-select: none;
      display: flex; flex-direction: column; justify-content: space-between;
    }
    .kpi-card:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.2); box-shadow: 0 6px 20px rgba(0,0,0,0.3); }
    .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
    .kpi-card.c-success::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .kpi-card.c-warning::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .kpi-card.c-primary::before { background: linear-gradient(90deg, #0052cc, #38bdf8); }
    .kpi-card.c-emerald::before { background: linear-gradient(90deg, #059669, #10b981); }
    .kpi-card.c-purple::before { background: linear-gradient(90deg, #7c3aed, #a78bfa); }

    .kpi-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .kpi-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .kpi-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; background: var(--bg3); }
    .kpi-card.c-success .kpi-icon { color: #10b981; background: rgba(16,185,129,0.12); }
    .kpi-card.c-warning .kpi-icon { color: #f59e0b; background: rgba(245,158,11,0.12); }
    .kpi-card.c-primary .kpi-icon { color: #38bdf8; background: rgba(0,82,204,0.12); }
    .kpi-card.c-emerald .kpi-icon { color: #10b981; background: rgba(16,185,129,0.12); }
    .kpi-card.c-purple .kpi-icon { color: #a78bfa; background: rgba(124,58,237,0.12); }

    .kpi-val { font-size: 26px; font-weight: 800; line-height: 1; color: var(--text); font-variant-numeric: tabular-nums; margin-bottom: 8px; }
    .kpi-bottom { font-size: 11px; color: var(--muted); border-top: 1px dashed var(--border); padding-top: 6px; display: flex; justify-content: space-between; align-items: center; }

    /* ── SEGMENTED NAVIGATION TABS ── */
    .segmented-control {
      display: inline-flex; background: var(--bg3); padding: 4px; border-radius: 12px;
      border: 1px solid var(--border); margin-bottom: 18px;
    }
    .seg-btn {
      background: transparent; border: none; outline: none; padding: 8px 18px;
      border-radius: 9px; font-size: 13px; font-weight: 600; color: var(--muted);
      cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 8px;
    }
    .seg-btn:hover { color: var(--text); }
    .seg-btn.active { background: var(--bg2); color: var(--text); font-weight: 700; box-shadow: 0 2px 8px rgba(0,0,0,0.25); border: 1px solid var(--border); }
    .tab-content { display: none; }
    .tab-content.active { display: block; animation: fadeIn 0.25s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* ── CARD & TABLES ── */
    .card-modern {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 16px;
      overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    .card-modern-hd {
      padding: 16px 20px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px; background: rgba(255,255,255,0.015);
    }
    .card-modern-title { font-size: 14px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0; }
    
    .status-filter-pills { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .status-filter-btn {
      border: 1px solid var(--border); background: var(--bg3); color: var(--muted);
      padding: 4px 10px; border-radius: 7px; font-size: 11.5px; font-weight: 600;
      cursor: pointer; transition: all 0.15s ease;
    }
    .status-filter-btn:hover { border-color: rgba(255,255,255,0.2); color: var(--text); }
    .status-filter-btn.active { background: rgba(0,82,204,0.18); border-color: var(--primary); color: #38bdf8; font-weight: 700; }

    /* Action Buttons in Table */
    .action-group { display: flex; align-items: center; gap: 5px; }
    .btn-act {
      width: 30px; height: 30px; border-radius: 7px; display: inline-flex;
      align-items: center; justify-content: center; border: 1px solid var(--border);
      background: var(--bg3); color: var(--muted); cursor: pointer; transition: all 0.15s ease; font-size: 13px;
    }
    .btn-act:hover { color: var(--text); border-color: rgba(255,255,255,0.25); transform: translateY(-1px); }
    .btn-act.btn-kick { color: #f87171; }
    .btn-act.btn-kick:hover { background: rgba(239,68,68,0.2); border-color: #ef4444; color: #fff; }
    .btn-act.btn-ping:hover { background: rgba(56,189,248,0.15); border-color: #38bdf8; color: #38bdf8; }
    .btn-act.btn-toggle:hover { background: rgba(245,158,11,0.15); border-color: #f59e0b; color: #fbbf24; }
    .btn-act.btn-edit:hover { background: rgba(0,82,204,0.2); border-color: var(--primary); color: #38bdf8; }
    .btn-act.btn-del:hover { background: rgba(239,68,68,0.2); border-color: #ef4444; color: #ef4444; }

    /* Modals */
    .mo { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 2000; padding: 20px; }
    .mo.show { display: flex; animation: fadeIn 0.2s ease; }
    .mb { background: var(--bg2); border: 1px solid var(--border); border-radius: 18px; width: 100%; box-shadow: 0 16px 40px rgba(0,0,0,0.5); overflow: hidden; display: flex; flex-direction: column; max-height: 90vh; }
    .mh { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--bg3); }
    .mt { font-size: 15px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0; }
    .mc { background: transparent; border: none; color: var(--muted); font-size: 20px; cursor: pointer; padding: 4px; }
    .mc:hover { color: var(--text); }
    .mbody { padding: 20px; overflow-y: auto; }
    .mf { padding: 14px 20px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: flex-end; gap: 10px; background: var(--bg3); }

    /* Terminal Area for Ping Diagnostic */
    .ping-terminal {
      background: #090d16; border: 1px solid #1e293b; border-radius: 10px;
      padding: 14px; font-family: monospace; font-size: 12px; color: #38bdf8;
      max-height: 240px; overflow-y: auto; line-height: 1.6; white-space: pre-wrap;
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'mikrotik', company }) %>
<div class="mw">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-router text-primary"></i>
      <span><%= t('admin.nav.mikrotik_monitoring', 'Monitoring MikroTik') %></span>
    </div>
    <div class="tb-right" style="display:flex;align-items:center;gap:12px">
      <!-- Router Selector -->
      <div style="display:flex;align-items:center;gap:6px;background:var(--bg3);border:1px solid var(--border);padding:4px 10px;border-radius:9px;">
        <i class="bi bi-hdd-network text-primary" style="font-size:13px;"></i>
        <select id="global-router-id" class="fs" style="background:transparent;border:none;color:var(--text);font-size:12.5px;cursor:pointer;padding:0;" onchange="changeRouter()">
          <option value="" <%= (!selectedRouterId) ? 'selected' : '' %>><%= t('admin.mikrotik.default_router', '-- Default Core Router --') %></option>
          <% routers.forEach(r => { %>
            <option value="<%= r.id %>" <%= (String(selectedRouterId || activeRouterId || '') === String(r.id)) ? 'selected' : '' %>><%= r.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- Auto Refresh Toggle -->
      <button id="auto-refresh-toggle" onclick="toggleAutoRefresh()" class="btn btn-sm" style="background:rgba(34,197,94,0.15);color:#22c55e;border:1px solid rgba(34,197,94,0.3);font-size:12px;" title="Auto-refresh live (10 detik)">
        <i class="bi bi-arrow-clockwise"></i>
        <span id="refresh-status">Auto</span>
      </button>

      <!-- Ping Diagnostic Tool -->
      <button onclick="openPingModal()" class="btn btn-g btn-sm" title="Uji Diagnostik Ping &amp; Latency Router">
        <i class="bi bi-broadcast-pin text-primary"></i> Ping Tool
      </button>

      <!-- Backup RSC -->
      <a href="#" onclick="downloadBackup(event)" class="btn btn-p btn-sm" title="Download Script Backup .rsc RouterOS">
        <i class="bi bi-download"></i> Backup RSC
      </a>

      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? 'Kasir' : 'Admin' %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm" title="Logout"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>

  <div class="page">
    <% const mTab = 'monitoring'; %>

    <!-- SUB-NAVIGATION TABS -->
    <div class="mtabs" style="margin-bottom:18px;">
      <a href="/admin/mikrotik" class="mtab <%= mTab==='monitoring' ? 'active' : '' %>"><i class="bi bi-router"></i> Monitoring &amp; Manajemen Sesi</a>
      <a href="/admin/vouchers" class="mtab <%= mTab==='vouchers' ? 'active' : '' %>"><i class="bi bi-ticket-perforated"></i> Voucher Hotspot</a>
      <a href="/admin/routers" class="mtab <%= mTab==='routers' ? 'active' : '' %>"><i class="bi bi-hdd-network"></i> Konfigurasi Router NAS</a>
    </div>

    <!-- ROUTER HARDWARE TELEMETRY STRIP (LIVE) -->
    <div class="telemetry-strip" id="routerTelemetryStrip">
      <div class="telemetry-item">
        <div class="telemetry-icon"><i class="bi bi-cpu"></i></div>
        <div class="telemetry-info">
          <span class="telemetry-label">Router Model &amp; OS</span>
          <span class="telemetry-val" id="tel-board-name">Memeriksa router...</span>
          <span style="font-size:11px;color:var(--muted);" id="tel-ros-version">-</span>
        </div>
      </div>

      <div class="telemetry-item">
        <div class="telemetry-icon"><i class="bi bi-activity"></i></div>
        <div class="telemetry-info">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span class="telemetry-label">Beban CPU</span>
            <span style="font-size:12px;font-weight:700;" id="tel-cpu-val">0%</span>
          </div>
          <div class="mini-progress">
            <div class="mini-progress-bar bar-emerald" id="tel-cpu-bar" style="width:0%"></div>
          </div>
        </div>
      </div>

      <div class="telemetry-item">
        <div class="telemetry-icon"><i class="bi bi-memory"></i></div>
        <div class="telemetry-info">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span class="telemetry-label">Penggunaan RAM</span>
            <span style="font-size:11px;font-weight:700;" id="tel-mem-val">0 MB</span>
          </div>
          <div class="mini-progress">
            <div class="mini-progress-bar bar-blue" id="tel-mem-bar" style="width:0%"></div>
          </div>
        </div>
      </div>

      <div class="telemetry-item">
        <div class="telemetry-icon"><i class="bi bi-clock-history"></i></div>
        <div class="telemetry-info">
          <span class="telemetry-label">Uptime Router</span>
          <span class="telemetry-val font-monospace" id="tel-uptime-val" style="font-size:13px;">-</span>
          <span style="font-size:10.5px;color:var(--muted);display:flex;align-items:center;gap:4px;">
            <span class="live-dot" style="width:6px;height:6px;"></span>
            <span>API Online</span>
          </span>
        </div>
      </div>
    </div>

    <!-- SUMMARY KPI STATS (5 Interactive Cards) -->
    <div class="kpi-grid">
      <!-- 1. PPPoE Online -->
      <div class="kpi-card c-success" onclick="showOnlineUsersModal()" title="Klik untuk melihat &amp; mengelola user PPPoE online">
        <div class="kpi-top">
          <span class="kpi-label"><%= t('admin.mikrotik.stats.pppoe_online', 'PPPoE Online') %></span>
          <div class="kpi-icon"><i class="bi bi-ethernet"></i></div>
        </div>
        <div class="kpi-val" id="pppoe-online-count">0</div>
        <div class="kpi-bottom">
          <span>Sesi Aktif Tersambung</span>
          <span><i class="bi bi-chevron-right"></i></span>
        </div>
      </div>

      <!-- 2. PPPoE Offline -->
      <div class="kpi-card c-warning" onclick="showOfflineUsersModal()" title="Klik untuk melihat user PPPoE offline">
        <div class="kpi-top">
          <span class="kpi-label"><%= t('admin.mikrotik.stats.pppoe_offline', 'PPPoE Offline') %></span>
          <div class="kpi-icon"><i class="bi bi-plug"></i></div>
        </div>
        <div class="kpi-val" id="pppoe-offline-count">0</div>
        <div class="kpi-bottom">
          <span>Secret Belum Terhubung</span>
          <span><i class="bi bi-chevron-right"></i></span>
        </div>
      </div>

      <!-- 3. Total Secrets -->
      <div class="kpi-card c-primary" onclick="showAllSecretsModal()" title="Klik untuk melihat semua daftar secret">
        <div class="kpi-top">
          <span class="kpi-label"><%= t('admin.mikrotik.stats.total_secrets', 'Total Secrets') %></span>
          <div class="kpi-icon"><i class="bi bi-key-fill"></i></div>
        </div>
        <div class="kpi-val" id="total-secrets-count">0</div>
        <div class="kpi-bottom">
          <span>Database Akun PPPoE</span>
          <span><i class="bi bi-chevron-right"></i></span>
        </div>
      </div>

      <!-- 4. Hotspot Online -->
      <div class="kpi-card c-emerald" onclick="showHotspotOnlineModal()" title="Klik untuk melihat voucher hotspot yang sedang aktif">
        <div class="kpi-top">
          <span class="kpi-label"><%= t('admin.mikrotik.stats.hotspot_online', 'Hotspot Online') %></span>
          <div class="kpi-icon"><i class="bi bi-wifi"></i></div>
        </div>
        <div class="kpi-val" id="hotspot-online-count">0</div>
        <div class="kpi-bottom">
          <span>Voucher Aktif di Jaringan</span>
          <span><i class="bi bi-chevron-right"></i></span>
        </div>
      </div>

      <!-- 5. Total Hotspot Users -->
      <div class="kpi-card c-purple" onclick="showAllHotspotModal()" title="Klik untuk melihat seluruh akun voucher hotspot">
        <div class="kpi-top">
          <span class="kpi-label"><%= t('admin.mikrotik.stats.total_hotspot', 'Total Hotspot') %></span>
          <div class="kpi-icon"><i class="bi bi-person-badge"></i></div>
        </div>
        <div class="kpi-val" id="total-hotspot-count">0</div>
        <div class="kpi-bottom">
          <span>Total Database Voucher</span>
          <span><i class="bi bi-chevron-right"></i></span>
        </div>
      </div>
    </div>

    <!-- INNER SEGMENTED TABS -->
    <div class="segmented-control">
      <button class="seg-btn active" onclick="showInnerTab(event, 'pppoe')">
        <i class="bi bi-ethernet"></i> PPPoE Secrets
      </button>
      <button class="seg-btn" onclick="showInnerTab(event, 'hotspot')">
        <i class="bi bi-wifi"></i> Hotspot Users
      </button>
      <button class="seg-btn" onclick="showInnerTab(event, 'pppoe-profiles')">
        <i class="bi bi-speedometer2"></i> PPPoE Profiles
      </button>
      <button class="seg-btn" onclick="showInnerTab(event, 'hotspot-profiles-tab')">
        <i class="bi bi-ticket-detailed"></i> Hotspot Profiles
      </button>
    </div>

    <!-- TAB 1: PPPOE SECRETS -->
    <div id="pppoe" class="tab-content active">
      <div class="card-modern">
        <div class="card-modern-hd">
          <div class="card-modern-title">
            <i class="bi bi-ethernet text-primary"></i> Daftar PPPoE Secrets &amp; Status Sesi
          </div>
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <!-- Filter Pills -->
            <div class="status-filter-pills">
              <button type="button" class="status-filter-btn active" data-filter="all" onclick="filterPppoeStatus('all', this)">Semua</button>
              <button type="button" class="status-filter-btn" data-filter="online" onclick="filterPppoeStatus('online', this)">Online</button>
              <button type="button" class="status-filter-btn" data-filter="offline" onclick="filterPppoeStatus('offline', this)">Offline</button>
              <button type="button" class="status-filter-btn" data-filter="disabled" onclick="filterPppoeStatus('disabled', this)">Disabled</button>
            </div>
            <!-- Search -->
            <div class="sinput" style="max-width:240px;">
              <i class="bi bi-search"></i>
              <input type="text" id="pppoeSearchInput" class="fc" placeholder="Cari nama, profile, IP..." onkeyup="filterTable('pppoe-list', this.value)">
            </div>
            <button class="btn btn-p btn-sm" onclick="openAddSecret()"><i class="bi bi-plus-lg"></i> Tambah Secret</button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="dtbl">
            <thead>
              <tr>
                <th>Username</th>
                <th>Profile</th>
                <th>Local Address</th>
                <th>Remote Address / IP</th>
                <th>Live Uptime</th>
                <th>Status</th>
                <th style="text-align:right;">Aksi</th>
              </tr>
            </thead>
            <tbody id="pppoe-list">
              <tr><td colspan="7" class="text-center text-muted" style="padding:28px;"><i class="bi bi-arrow-clockwise spin me-1"></i> Memuat data PPPoE Secrets...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 2: HOTSPOT USERS -->
    <div id="hotspot" class="tab-content">
      <div class="card-modern">
        <div class="card-modern-hd">
          <div class="card-modern-title">
            <i class="bi bi-wifi text-primary"></i> Daftar Hotspot Voucher Users
          </div>
          <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <!-- Search -->
            <div class="sinput" style="max-width:260px;">
              <i class="bi bi-search"></i>
              <input type="text" id="hotspotSearchInput" class="fc" placeholder="Cari voucher, profile, MAC..." onkeyup="filterTable('hotspot-list', this.value)">
            </div>
            <button class="btn btn-p btn-sm" onclick="openAddHotspot()"><i class="bi bi-plus-lg"></i> Tambah User</button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="dtbl">
            <thead>
              <tr>
                <th>Username</th>
                <th>Profile</th>
                <th>Address</th>
                <th>Limit Uptime</th>
                <th>Komentar</th>
                <th>Live Uptime</th>
