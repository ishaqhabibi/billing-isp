  // ── PING DIAGNOSTIC MODAL ──
  function openPingModal(targetIp = '') {
    if (targetIp) {
      const input = document.getElementById('pingHostInput');
      if (input) input.value = targetIp;
    }
    openModal('pingModal');
  }

  async function executePing() {
    const host = document.getElementById('pingHostInput').value.trim();
    const count = document.getElementById('pingCountInput').value;
    const btn = document.getElementById('btnExecutePing');
    const term = document.getElementById('pingTerminalOutput');

    if (!host) return alert('Silakan masukkan Host / IP tujuan.');

    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i> Menguji...';
    term.textContent = `Mengirim ${count} paket ICMP ping ke ${host} via MikroTik...\n`;

    try {
      const res = await fetch('/admin/api/mikrotik/ping', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ host, count, routerId: getRouterId() })
      });
      const data = await res.json();
      if (data && data.success && Array.isArray(data.results)) {
        let out = `PING ${host} (${data.results.length} respons diterima):\n\n`;
        data.results.forEach((p, idx) => {
          const seq = p.seq || (idx + 1);
          const time = p.time || p['round-trip-time'] || '-';
          const size = p.size || '56';
          const ttl = p.ttl || '-';
          const status = p.status ? `[${p.status}]` : '';
          out += `  seq=${seq}  size=${size} bytes  ttl=${ttl}  time=${time} ${status}\n`;
        });
        term.textContent = out;
      } else {
        term.textContent = `Gagal menjalankan ping: ${data.error || 'Router tidak merespons'}`;
      }
    } catch (e) {
      term.textContent = `Error: ${e.message}`;
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-send-fill"></i> Ping';
    }
  }

