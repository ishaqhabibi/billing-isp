<script>
  const I18N = {
    addSecret: "Tambah Secret",
    editSecret: "Edit Secret",
    addHotspotUser: "Tambah User Hotspot",
    editHotspotUser: "Edit User Hotspot",
    addPppoeProfile: "Tambah PPPoE Profile",
    editPppoeProfile: "Edit PPPoE Profile",
    addHotspotProfile: "Tambah Hotspot Profile",
    editHotspotProfile: "Edit Hotspot Profile",
    saveFailed: "Gagal menyimpan data",
    deleteFailed: "Gagal menghapus data",
    deleteSecretConfirm: "Hapus secret PPPoE ini dari router?",
    deleteHotspotConfirm: "Hapus user hotspot ini dari router?",
    deleteProfileConfirm: "Hapus profile ini dari router?",
    emptySecrets: "Tidak ada data secret PPPoE.",
    emptyHotspotUsers: "Tidak ada data user hotspot.",
    loadFailed: "Gagal memuat data dari router",
    statusOnline: "Online",
    statusOffline: "Offline",
    statusDisabled: "Disabled"
  };

  function showInnerTab(e, id) {
    document.querySelectorAll('.seg-btn').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    e.currentTarget.classList.add('active');
    document.getElementById(id).classList.add('active');
    if(id==='pppoe') loadSecrets();
    else if(id==='hotspot') loadHotspotUsers();
    else if(id==='pppoe-profiles') loadPppoeProfiles();
    else if(id==='hotspot-profiles-tab') loadHotspotUserProfiles();
  }

  function openModal(id){
    pauseAutoRefresh();
    const el = document.getElementById(id);
    if(el) el.classList.add('show');
  }
  function closeModal(id){
    const el = document.getElementById(id);
    if(el) el.classList.remove('show');
    resumeAutoRefresh();
  }
  document.querySelectorAll('.mo').forEach(m => m.addEventListener('click', e => {
    if (e.target === m) closeModal(m.id);
  }));

  function getRouterId() {
    return document.getElementById('global-router-id')?.value || '';
  }

  function changeRouter() {
    const rId = getRouterId();
    window.location.href = '/admin/set-active-router?router_id=' + (rId || 'all');
  }

  function downloadBackup(e) {
    e.preventDefault();
    const routerId = getRouterId();
    window.location.href = `/admin/api/mikrotik/backup?routerId=${routerId}`;
  }

  function escapeHtmlAttr(s) {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // ── ROUTER HARDWARE TELEMETRY ──
  async function loadRouterHealth() {
    const routerId = getRouterId();
    try {
      const res = await fetch(`/admin/api/mikrotik/monitoring-display-data?routerId=${routerId}`);
      if (!res.ok) return;
      const data = await res.json();
      if (!data || !data.ok || !data.resources) return;

      const r = data.resources;
      // Board Name & ROS
      const boardEl = document.getElementById('tel-board-name');
      const rosEl = document.getElementById('tel-ros-version');
      if (boardEl) boardEl.textContent = r.boardName || 'MikroTik RouterOS';
      if (rosEl) rosEl.textContent = `RouterOS ${r.version || ''}`;

      // CPU
      const cpuVal = Number(r.cpu || 0);
      const cpuValEl = document.getElementById('tel-cpu-val');
      const cpuBarEl = document.getElementById('tel-cpu-bar');
      if (cpuValEl) cpuValEl.textContent = `${cpuVal}%`;
      if (cpuBarEl) {
        cpuBarEl.style.width = `${Math.min(cpuVal, 100)}%`;
        cpuBarEl.className = 'mini-progress-bar ' + (cpuVal > 80 ? 'bar-rose' : cpuVal > 60 ? 'bar-amber' : 'bar-emerald');
      }

      // Memory
      const freeMem = Number(r.freeMemory || 0);
      const totalMem = Number(r.totalMemory || 0);
      const usedMem = Math.max(totalMem - freeMem, 0);
      const memPct = totalMem > 0 ? Math.round((usedMem / totalMem) * 100) : 0;
      const memValEl = document.getElementById('tel-mem-val');
      const memBarEl = document.getElementById('tel-mem-bar');
      if (memValEl) {
        const freeMB = (freeMem / (1024*1024)).toFixed(0);
        const totalMB = (totalMem / (1024*1024)).toFixed(0);
        memValEl.textContent = `${memPct}% (${freeMB}/${totalMB} MB)`;
      }
      if (memBarEl) memBarEl.style.width = `${Math.min(memPct, 100)}%`;

      // Uptime
      const uptimeEl = document.getElementById('tel-uptime-val');
      if (uptimeEl) uptimeEl.textContent = r.uptime || '-';
    } catch (e) {
      console.warn('Failed to load router health telemetry:', e.message);
    }
  }

  // ── KICK SESSIONS (PPPOE & HOTSPOT) ──
  async function kickPppoeUser(username, btn) {
    if (!confirm(`Putuskan paksa sesi PPPoE aktif untuk user "${username}"?`)) return;
    let oldHtml = '';
    if (btn) { oldHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i>'; }
    try {
      const res = await fetch('/admin/api/mikrotik/kick-pppoe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, routerId: getRouterId() })
      });
      const d = await res.json();
      if (d && d.success) {
        alert(d.message || 'Sesi PPPoE berhasil diputus!');
        loadSecrets();
        const m = document.getElementById('onlineUsersModal');
        if (m && m.classList.contains('show')) showOnlineUsersModal();
      } else {
        alert('Gagal: ' + (d.error || 'Terjadi kesalahan'));
      }
    } catch (e) {
      alert('Error: ' + e.message);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = oldHtml; }
    }
  }

