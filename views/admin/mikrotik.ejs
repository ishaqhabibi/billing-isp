  // ── LOAD DATA HANDLERS ──
  async function loadSecrets() {
    try {
      const routerId = getRouterId();
      const [sRes, aRes] = await Promise.all([
        fetch(`/admin/api/mikrotik/secrets?routerId=${routerId}`),
        fetch(`/admin/api/mikrotik/active-pppoe?routerId=${routerId}`)
      ]);
      const tbody = document.getElementById('pppoe-list');
      if (!sRes.ok || !aRes.ok) {
        pppoeData = [];
        offlineUsersData = [];
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-danger">${I18N.loadFailed}</td></tr>`;
        return;
      }
      pppoeData = await sRes.json();
      const activeSessions = await aRes.json();
      
      onlineUsersData = activeSessions.map(active => {
        const secret = pppoeData.find(s => s.name === active.name);
        return { ...active, profile: secret ? secret.profile : '-' };
      });
      
      offlineUsersData = pppoeData.filter(s => {
        const isOnline = activeSessions.some(a => a.name === s.name);
        const isDisabled = s.disabled === true || s.disabled === 'true';
        return !isOnline && !isDisabled;
      });
      
      document.getElementById('pppoe-online-count').innerText = activeSessions.length;
      document.getElementById('pppoe-offline-count').innerText = offlineUsersData.length;
      document.getElementById('total-secrets-count').innerText = pppoeData.length;

      renderPppoeTable();
    } catch (err) {
      console.error('Error loadSecrets:', err);
    }
  }

