function toRupiah(n) {
  const v = Number(n) || 0;
  return 'Rp ' + v.toLocaleString('id-ID');
}

function monthsRangesText(months) {
  const list = (Array.isArray(months) ? months : []).map(m => parseInt(m)).filter(m => m >= 1 && m <= 12).sort((a, b) => a - b);
  if (list.length === 0) return '';
  const ranges = [];
  let s = list[0];
  let p = list[0];
  for (let i = 1; i < list.length; i++) {
    const m = list[i];
    if (m === p + 1) { p = m; continue; }
    ranges.push([s, p]);
    s = m; p = m;
  }
  ranges.push([s, p]);
  return ranges.map(([a, b]) => (a === b ? PAY_MNS[a - 1] : (PAY_MNS[a - 1] + '–' + PAY_MNS[b - 1]))).join(', ');
}

function updatePayTotal() {
  const totalEl = document.getElementById('payInvoiceTotal');
  const btn = document.querySelector('#payInvoiceForm button[type="submit"]');
  const checks = Array.from(document.querySelectorAll('#payInvoiceModal .pay-month'));
  const selected = checks.filter(cb => cb.checked && !cb.disabled).map(cb => parseInt(cb.value));
  const meta = payBillingMeta || { packagePrice: 0, invoices: {} };
  let total = 0;
  for (const m of selected) {
    const inv = meta.invoices && meta.invoices[m];
    const amount = inv && typeof inv.amount !== 'undefined' ? Number(inv.amount) : Number(meta.packagePrice || 0);
    total += Number.isFinite(amount) ? amount : 0;
  }
  const txt = `${PAY_I18N.totalSelectedLabel} ${toRupiah(total)} (${selected.length} ${PAY_I18N.monthsSuffix})`;
  if (totalEl) totalEl.textContent = txt;
  if (btn) btn.disabled = selected.length === 0;
}

async function loadBillingYear() {
  if (!payCustomerId) return;
  const yearEl = document.getElementById('payInvoiceYear');
  const year = yearEl ? yearEl.value : new Date().getFullYear();
  const paidSummaryEl = document.getElementById('payInvoicePaidSummary');
  const checks = Array.from(document.querySelectorAll('#payInvoiceModal .pay-month'));
  checks.forEach(cb => {
    cb.disabled = false;
    const label = cb.closest('label');
    if (label) label.style.opacity = '';
    const badge = label ? label.querySelector('.pay-month-badge') : null;
    if (badge) badge.style.display = 'none';
  });
  try {
    const r = await fetch('/admin/api/customers/' + payCustomerId + '/billing-year?year=' + encodeURIComponent(year));
    const data = await r.json();
    const invoices = (data && Array.isArray(data.invoices)) ? data.invoices : [];
    const invMap = {};
    for (const it of invoices) {
      const m = parseInt(it.month);
      if (m >= 1 && m <= 12) invMap[m] = { status: it.status, amount: it.amount };
    }
    payBillingMeta = { packagePrice: Number(data && data.packagePrice) || (payBillingMeta ? payBillingMeta.packagePrice : 0), invoices: invMap };
    const paidMonths = Object.keys(invMap).map(n => parseInt(n)).filter(m => invMap[m] && invMap[m].status === 'paid').sort((a, b) => a - b);
    const ranges = monthsRangesText(paidMonths);
    if (paidSummaryEl) {
      paidSummaryEl.textContent = paidMonths.length ? (PAY_I18N.paidMonthsLabel + ' ' + ranges) : PAY_I18N.nonePaid;
    }
    checks.forEach(cb => {
      const m = parseInt(cb.value);
      const inv = invMap[m];
      if (inv && inv.status === 'paid') {
        cb.checked = true;
        cb.disabled = true;
        const label = cb.closest('label');
        if (label) label.style.opacity = '0.7';
        const badge = label ? label.querySelector('.pay-month-badge') : null;
        if (badge) badge.style.display = 'inline-block';
      }
    });
  } catch (e) {}
  updatePayTotal();
}

document.getElementById('payInvoiceYear')?.addEventListener('change', () => loadBillingYear());
document.getElementById('payInvoiceModal')?.addEventListener('change', (e) => {
  if (e.target && e.target.classList && e.target.classList.contains('pay-month')) updatePayTotal();
});

// ─── MODERN CUSTOM AUTOCOMPLETE FOR PPPOE CREDENTIALS ───────────────
const cachedPppoeUsers = { add: [], edit: [] };

function setCachedPppoeUsers(type, users) {
  cachedPppoeUsers[type] = Array.isArray(users) ? users : [];
  renderPppoeDropdown(type);
}

function renderPppoeDropdown(type, query = '') {
  const dropdownEl = document.getElementById(type === 'add' ? 'add_pppoe_dropdown' : 'e_pppoe_dropdown');
  if (!dropdownEl) return;

  const users = cachedPppoeUsers[type] || [];
  const q = String(query).trim().toLowerCase();
  const filtered = q
    ? users.filter(u => u && u.name && (u.name.toLowerCase().includes(q) || (u.profile && u.profile.toLowerCase().includes(q)) || (u.caller_id && u.caller_id.toLowerCase().includes(q))))
    : users;

  if (filtered.length === 0) {
    dropdownEl.innerHTML = `
      <div class="autocomplete-empty">
        <div style="margin-bottom:6px;"><i class="bi bi-search text-muted"></i> Tidak ada secret yang cocok</div>
        ${q ? `<div style="font-size:11px; color:var(--primary); cursor:pointer; font-weight:600;" onclick="selectPppoeItem('${type}', '${q.replace(/'/g, "\\'")}')">Gunakan "${q}" sebagai Username Baru</div>` : ''}
      </div>
    `;
    return;
  }

  let html = '';
  filtered.slice(0, 35).forEach(u => {
    const uname = String(u.name || '').replace(/"/g, '&quot;');
    const upass = String(u.password || '').replace(/"/g, '&quot;');
    const uprof = String(u.profile || '').replace(/"/g, '&quot;');
    const uip = String(u.remote_address || u.address || '').replace(/"/g, '&quot;');
    
    html += `
      <div class="autocomplete-item" onclick="selectPppoeItem('${type}', '${uname.replace(/'/g, "\\'")}', '${upass.replace(/'/g, "\\'")}', '${uprof.replace(/'/g, "\\'")}')">
        <div>
          <div class="autocomplete-item-name"><i class="bi bi-person-fill text-primary me-1"></i>${uname}</div>
          ${uip ? `<div style="font-size:10px; color:var(--muted); font-family:monospace;">IP: ${uip}</div>` : ''}
        </div>
        <div class="autocomplete-item-meta">
          ${uprof ? `<span class="badge" style="background:rgba(99,102,241,0.18); color:var(--primary); font-size:10px;">${uprof}</span>` : ''}
          <i class="bi bi-arrow-right-short text-muted"></i>
        </div>
      </div>
    `;
  });

  if (filtered.length > 35) {
    html += `<div style="padding:8px; text-align:center; font-size:10.5px; color:var(--muted); border-top:1px solid rgba(255,255,255,0.04);">Menampilkan 35 dari ${filtered.length} secret. Ketik untuk mempersempit.</div>`;
  }

  dropdownEl.innerHTML = html;
}

function selectPppoeItem(type, username, password = '', profile = '') {
  const inputEl = document.getElementById(type === 'add' ? 'add_pppoe_username' : 'e_pppoe');
  if (inputEl) inputEl.value = username;

  if (password) {
    const passEl = document.getElementById(type === 'add' ? 'add_pppoe_password' : 'e_pppoe_password');
    if (passEl && (!passEl.value || type === 'add')) {
      passEl.value = password;
    }
  }

  // Auto-fill GenieACS Tag if empty
  const tagEl = document.getElementById(type === 'add' ? 'add_genieacs_tag' : 'e_tag');
  if (tagEl && !tagEl.value) {
    tagEl.value = username;
  }

  closePppoeDropdown(type);
}

function openPppoeDropdown(type) {
  const dropdownEl = document.getElementById(type === 'add' ? 'add_pppoe_dropdown' : 'e_pppoe_dropdown');
  const iconEl = document.getElementById(type === 'add' ? 'add_pppoe_toggle_icon' : 'e_pppoe_toggle_icon');
  const inputEl = document.getElementById(type === 'add' ? 'add_pppoe_username' : 'e_pppoe');
  if (dropdownEl) {
    dropdownEl.classList.add('show');
    renderPppoeDropdown(type, inputEl ? inputEl.value : '');
  }
  if (iconEl) iconEl.style.transform = 'rotate(180deg)';
}

function closePppoeDropdown(type) {
  const dropdownEl = document.getElementById(type === 'add' ? 'add_pppoe_dropdown' : 'e_pppoe_dropdown');
  const iconEl = document.getElementById(type === 'add' ? 'add_pppoe_toggle_icon' : 'e_pppoe_toggle_icon');
  if (dropdownEl) dropdownEl.classList.remove('show');
  if (iconEl) iconEl.style.transform = 'rotate(0deg)';
}

function togglePppoeDropdown(type) {
  const dropdownEl = document.getElementById(type === 'add' ? 'add_pppoe_dropdown' : 'e_pppoe_dropdown');
  if (dropdownEl && dropdownEl.classList.contains('show')) {
    closePppoeDropdown(type);
  } else {
    openPppoeDropdown(type);
  }
}

function filterPppoeDropdown(type, val) {
  openPppoeDropdown(type);
  renderPppoeDropdown(type, val);
}

// Global click outside & Escape listeners to auto-dismiss dropdowns
document.addEventListener('click', (e) => {
  ['add', 'edit'].forEach(type => {
    const wrap = document.getElementById(type === 'add' ? 'add_pppoe_autocomplete_wrap' : 'e_pppoe_autocomplete_wrap');
    if (wrap && !wrap.contains(e.target)) {
      closePppoeDropdown(type);
    }
  });
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
