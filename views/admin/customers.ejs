const PAY_I18N = JSON.parse(document.getElementById('pay-i18n-data').textContent);

const officeCoords = {
  lat: parseFloat(appSettings.office_lat) || -6.200000,
  lng: parseFloat(appSettings.office_lng) || 106.816666
};

function openModal(id){document.getElementById(id).classList.add('show')}
function closeModal(id){document.getElementById(id).classList.remove('show')}

function openPicker(type) {
  activePickerType = type;
  openModal('mapPickerModal');
  
  let currentLat = document.getElementById(type === 'add' ? 'add_lat' : 'e_lat').value;
  let currentLng = document.getElementById(type === 'add' ? 'add_lng' : 'e_lng').value;
  
  let startLat = parseFloat(currentLat) || officeCoords.lat;
  let startLng = parseFloat(currentLng) || officeCoords.lng;

  setTimeout(() => {
    if (!pickerMap) {
      pickerMap = L.map('picker-map').setView([startLat, startLng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(pickerMap);
      
      const customIcon = L.divIcon({
        html: '<i class="bi bi-geo-alt-fill picker-icon"></i>',
        className: 'custom-div-icon',
        iconSize: [32, 32],
        iconAnchor: [16, 32]
      });

      pickerMarker = L.marker([startLat, startLng], { 
        draggable: true,
        icon: customIcon
      }).addTo(pickerMap);
      
      pickerMarker.on('dragend', function() {
        const pos = pickerMarker.getLatLng();
        updateInputs(pos.lat, pos.lng);
      });

      pickerMap.on('click', function(e) {
        pickerMarker.setLatLng(e.latlng);
        updateInputs(e.latlng.lat, e.latlng.lng);
      });
    } else {
      pickerMap.setView([startLat, startLng], 16);
      pickerMarker.setLatLng([startLat, startLng]);
      pickerMap.invalidateSize();
    }
  }, 300);
}

function updateInputs(lat, lng) {
  const prefix = activePickerType === 'add' ? 'add_' : 'e_';
  document.getElementById(prefix + 'lat').value = lat.toFixed(8);
  document.getElementById(prefix + 'lng').value = lng.toFixed(8);
}

// ─── CUSTOMER STEPPER MODAL & INTERACTIVE CARDS ──────────────────────
let currentCustModalTab = { add: 1, edit: 1 };

function switchCustModalTab(type, step) {
  currentCustModalTab[type] = step;
  for (let i = 1; i <= 5; i++) {
    const pane = document.getElementById(`pane_${type}_${i}`);
    const btn = document.getElementById(`tab_btn_${type}_${i}`);
    if (pane) pane.classList.toggle('active', i === step);
    if (btn) btn.classList.toggle('active', i === step);
  }
  const btnPrev = document.getElementById(`btn_prev_${type}`);
  const btnNext = document.getElementById(`btn_next_${type}`);
  const btnSubmit = document.getElementById(`btn_submit_${type}`);
  if (btnPrev) btnPrev.style.display = step > 1 ? 'inline-flex' : 'none';
  if (btnNext) btnNext.style.display = step < 5 ? 'inline-flex' : 'none';
}

function prevCustModalTab(type) {
  if (currentCustModalTab[type] > 1) {
    switchCustModalTab(type, currentCustModalTab[type] - 1);
  }
}

function nextCustModalTab(type) {
  if (currentCustModalTab[type] < 5) {
    switchCustModalTab(type, currentCustModalTab[type] + 1);
  }
}

function selectAuthModeCard(type, val) {
  const isRadius = (String(val) === '1');
  const inputEl = document.getElementById(type === 'add' ? 'add_is_radius' : 'e_is_radius');
  if (inputEl) inputEl.value = isRadius ? '1' : '0';

  const chkEl = document.getElementById(type === 'add' ? 'add_sync_to_radius' : 'e_sync_to_radius');
  if (chkEl) chkEl.checked = isRadius;

  updateRadiusSyncPill(type, isRadius);

  const cardMikrotik = document.getElementById(`auth_card_${type}_mikrotik`);
  const cardRadius = document.getElementById(`auth_card_${type}_radius`);
  if (cardMikrotik) cardMikrotik.classList.toggle('active', !isRadius);
  if (cardRadius) cardRadius.classList.toggle('active', isRadius);

  if (type === 'edit') {
    const hintBox = document.getElementById('edit_migration_hint');
    const hintText = document.getElementById('edit_migration_hint_text');
    if (hintBox && hintText) {
      hintBox.style.display = 'block';
      if (isRadius) {
        hintText.innerHTML = '<strong>Migrasi ke RADIUS Server:</strong> Kredensial akan divalidasi terpusat di server database RADIUS. Beban RAM MikroTik tetap ringan.';
      } else {
        hintText.innerHTML = '<strong>Migrasi ke MikroTik Local Secret:</strong> Kredensial akan disimpan langsung di <code>/ppp secret</code> RouterOS MikroTik.';
      }
    }
  }

  handleAuthModeChange(type, isRadius ? '1' : '0');
}

function toggleRadiusSync(type, isChecked) {
  const isRadius = Boolean(isChecked);
  const inputEl = document.getElementById(type === 'add' ? 'add_is_radius' : 'e_is_radius');
  if (inputEl) inputEl.value = isRadius ? '1' : '0';

  const cardMikrotik = document.getElementById(`auth_card_${type}_mikrotik`);
  const cardRadius = document.getElementById(`auth_card_${type}_radius`);
  if (cardMikrotik) cardMikrotik.classList.toggle('active', !isRadius);
  if (cardRadius) cardRadius.classList.toggle('active', isRadius);

  updateRadiusSyncPill(type, isRadius);
  handleAuthModeChange(type, isRadius ? '1' : '0');
}

function updateRadiusSyncPill(type, isRadius) {
  const pill = document.getElementById(type === 'add' ? 'add_radius_sync_pill' : 'e_radius_sync_pill');
  if (pill) {
    if (isRadius) {
      pill.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> RADIUS Aktif';
      pill.style.background = 'rgba(16,185,129,0.18)';
      pill.style.color = '#10b981';
      pill.style.borderColor = 'rgba(16,185,129,0.3)';
    } else {
      pill.innerHTML = '<i class="bi bi-dash-circle me-1"></i> MikroTik Lokal Saja';
      pill.style.background = 'rgba(245,158,11,0.18)';
      pill.style.color = '#f59e0b';
      pill.style.borderColor = 'rgba(245,158,11,0.3)';
    }
  }
}

function handleAuthModeChange(type, val) {
  const isRadius = String(val) === '1';
  if (type === 'add') {
    const radioMikrotik = document.querySelector('#addModal input[name="pppoe_input_mode"][value="mikrotik"]');
    const radioManual = document.querySelector('#addModal input[name="pppoe_input_mode"][value="manual"]');
    if (isRadius) {
      if (radioManual) radioManual.checked = true;
    } else {
      if (radioMikrotik) radioMikrotik.checked = true;
    }
    togglePppoeInputMode('add');
  }
}

function togglePppoeInputMode(type) {
  const mode = document.querySelector(`input[name="pppoe_input_mode"]:checked`)?.value || 'mikrotik';
  const mikrotikInput = document.getElementById(type + '_pppoe_mikrotik_input');
  const manualInput = document.getElementById(type + '_pppoe_manual_input');
  const usernameField = document.querySelector(`input[name="pppoe_username"]`);
  const manualUsernameField = document.getElementById(type + '_pppoe_username_manual');
  
  if (mode === 'manual') {
    if (mikrotikInput) mikrotikInput.style.display = 'none';
    if (manualInput) manualInput.style.display = 'block';
    if (usernameField) usernameField.removeAttribute('name');
    if (manualUsernameField) manualUsernameField.setAttribute('name', 'pppoe_username');
  } else {
    if (mikrotikInput) mikrotikInput.style.display = 'block';
    if (manualInput) manualInput.style.display = 'none';
    if (usernameField) usernameField.setAttribute('name', 'pppoe_username');
    if (manualUsernameField) manualUsernameField.removeAttribute('name');
  }
}

function toggleConnectionFields(type) {
  const connType = document.getElementById(type === 'add' ? 'add_connection_type' : 'e_connection_type').value;
  const pppoeField = document.getElementById(type === 'add' ? 'add_pppoe_field' : 'e_pppoe_field');
  const staticField = document.getElementById(type === 'add' ? 'add_static_field' : 'e_static_field');
  const hotspotField = document.getElementById(type === 'add' ? 'add_hotspot_field' : 'e_hotspot_field');
  const macField = document.getElementById(type === 'add' ? 'add_mac_field' : 'e_mac_field');
  const radiusFg = document.getElementById(type === 'add' ? 'add_radius_select_fg' : 'e_radius_select_fg');

  if (radiusFg) radiusFg.style.display = connType === 'pppoe' ? 'block' : 'none';

  if (connType === 'pppoe') {
    pppoeField.style.display = 'block';
    staticField.style.display = 'none';
    hotspotField.style.display = 'none';
    macField.style.display = 'none';
  } else if (connType === 'static') {
    pppoeField.style.display = 'none';
    staticField.style.display = 'block';
    hotspotField.style.display = 'none';
    macField.style.display = 'block';
  } else {
    pppoeField.style.display = 'none';
    staticField.style.display = 'none';
    hotspotField.style.display = 'block';
    macField.style.display = 'block';
  }

  const pppoePasswordEl = document.getElementById(type === 'add' ? 'add_pppoe_password' : 'e_pppoe_password');
  const pppoeUsernameEl = type === 'add' ? null : document.getElementById('e_pppoe');
  if (pppoePasswordEl) {
    if (connType === 'pppoe') {
      pppoePasswordEl.setAttribute('required', '');
    } else {
      pppoePasswordEl.removeAttribute('required');
      pppoePasswordEl.value = '';
    }
  }
  if (pppoeUsernameEl) {
    if (connType === 'pppoe') {
      pppoeUsernameEl.setAttribute('required', '');
    } else {
      pppoeUsernameEl.removeAttribute('required');
    }
  }

  if (connType === 'hotspot') {
    const routerId = (type === 'add' ? document.getElementById('add_router_select') : document.getElementById('e_router_id'))?.value || '';
    loadHotspotProfiles(type, routerId);
  }
}

// ─── QUICK IMPORT UNREGISTERED SECRETS (MIKROTIK) ─────────────────────
let unregisteredSecretsCache = [];

async function openQuickImportModal() {
  openModal('quickImportModal');
  loadUnregisteredSecrets();
}

async function loadUnregisteredSecrets() {
  const routerId = document.getElementById('qi_router_select')?.value || '';
  const tbody = document.getElementById('qi_table_body');
  const countLabel = document.getElementById('qi_count_label');
  if (tbody) tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:24px; color:var(--muted);"><i class="bi bi-hourglass-split"></i> Memindai secret di Router MikroTik...</td></tr>';
  if (countLabel) countLabel.textContent = 'Memindai...';

  try {
    const qs = routerId ? `?routerId=${encodeURIComponent(routerId)}` : '';
    const res = await fetch(`/admin/api/customers/unregistered-secrets${qs}`);
    const data = await res.json();

    if (!data.ok || !Array.isArray(data.secrets)) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:24px; color:#ef4444;"><i class="bi bi-exclamation-triangle me-1"></i> ${data.message || 'Gagal memuat data secret.'}</td></tr>`;
      return;
    }

    unregisteredSecretsCache = data.secrets;
    renderUnregisteredSecretsTable(data.secrets);
  } catch (err) {
    if (tbody) tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:24px; color:#ef4444;"><i class="bi bi-exclamation-triangle me-1"></i> Terjadi kesalahan koneksi ke server: ${err.message}</td></tr>`;
  }
}

function renderUnregisteredSecretsTable(secrets) {
  const tbody = document.getElementById('qi_table_body');
  const countLabel = document.getElementById('qi_count_label');
  if (countLabel) countLabel.textContent = `Ditemukan ${secrets.length} Secret Belum Terdaftar di Billing`;

  if (!tbody) return;
  if (secrets.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:32px; color:var(--muted);"><i class="bi bi-check2-circle text-success" style="font-size:28px; display:block; margin-bottom:8px;"></i> Semua secret PPPoE di MikroTik sudah terdaftar di database Billing!</td></tr>';
    qiUpdateSelectedCount();
    return;
  }

  tbody.innerHTML = secrets.map((s, idx) => `
    <tr style="border-bottom:1px solid var(--border);">
      <td style="padding:10px; text-align:center;">
        <input type="checkbox" class="qi-cb" data-idx="${idx}" checked onchange="qiUpdateSelectedCount()" style="accent-color:var(--primary); cursor:pointer;">
      </td>
      <td style="padding:10px; font-weight:700; font-family:monospace; color:var(--primary);">
        ${s.name || '-'}
      </td>
      <td style="padding:10px; font-family:monospace; color:var(--muted);">
        ${s.password ? '••••••' : '<em style="color:#ef4444">Kosong</em>'}
      </td>
      <td style="padding:10px;">
        <span class="badge bp" style="font-size:10px;">${s.profile || 'default'}</span>
      </td>
      <td style="padding:10px; font-family:monospace;">
        ${s['remote-address'] || '-'}
      </td>
      <td style="padding:10px; font-size:11px; color:var(--muted);">
        ${s._router_name || 'Router'}
      </td>
      <td style="padding:10px;">
        <span class="badge bw" style="font-size:10px;"><i class="bi bi-exclamation-circle me-1"></i>Belum di Billing</span>
      </td>
    </tr>
  `).join('');

  qiUpdateSelectedCount();
}

function qiToggleAll(checked) {
  document.querySelectorAll('.qi-cb').forEach(cb => cb.checked = checked);
  qiUpdateSelectedCount();
}

function qiSelectAll(checked) {
  const master = document.getElementById('qi_check_all');
  if (master) master.checked = checked;
  qiToggleAll(checked);
}

function qiUpdateSelectedCount() {
  const checked = document.querySelectorAll('.qi-cb:checked');
  const countEl = document.getElementById('qi_selected_count');
  const submitBtn = document.getElementById('qi_submit_btn');
  if (countEl) countEl.textContent = checked.length;
  if (submitBtn) submitBtn.disabled = (checked.length === 0);
}

async function executeQuickImport() {
  const checked = Array.from(document.querySelectorAll('.qi-cb:checked'));
  if (checked.length === 0) {
    alert('Pilih minimal satu secret untuk diimpor!');
    return;
  }

  const selectedSecrets = checked.map(cb => {
    const idx = parseInt(cb.getAttribute('data-idx'));
    return unregisteredSecretsCache[idx];
  }).filter(Boolean);

  const packageId = document.getElementById('qi_package_select')?.value || null;
  const isRadius = document.getElementById('qi_auth_mode')?.value || '0';

  if (!confirm(`Yakin ingin mengimpor ${selectedSecrets.length} akun pelanggan terpilih ke sistem Billing ISP?`)) return;

  const submitBtn = document.getElementById('qi_submit_btn');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Mengimpor Data...';
  }

  try {
    const res = await fetch('/admin/api/customers/quick-import-secrets', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        secrets: selectedSecrets,
        packageId,
        isRadius: parseInt(isRadius)
      })
    });
    const data = await res.json();

    if (data.ok) {
      alert(`✅ Berhasil mengimpor ${data.importedCount} pelanggan ke Billing!`);
      closeModal('quickImportModal');
      window.location.reload();
    } else {
      alert(`❌ Gagal impor: ${data.message || 'Terjadi kesalahan'}`);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<i class="bi bi-check-lg me-1"></i> Impor (${selectedSecrets.length}) Pelanggan Masuk ke Billing`;
      }
    }
  } catch (err) {
    alert(`❌ Terjadi kesalahan: ${err.message}`);
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Coba Lagi';
    }
  }
}

// ─── AVAILABLE ONU PICKER (GENIEACS TR-069) ───────────────────────────
let availableOnusCache = [];
let currentOnuPickerTarget = 'add';

async function openOnuPickerModal(target = 'add') {
  currentOnuPickerTarget = target;
  openModal('onuPickerModal');
  loadAvailableOnus();
}

async function loadAvailableOnus() {
  const tbody = document.getElementById('onu_picker_tbody');
  if (tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:24px; color:var(--muted);"><i class="bi bi-hourglass-split"></i> Memindai modem TR-069 dari GenieACS...</td></tr>';

  try {
    const res = await fetch('/admin/api/customers/available-onus');
    const data = await res.json();
    const list = data.devices || data.onus || [];

    if (!data.ok || !Array.isArray(list)) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:24px; color:#ef4444;"><i class="bi bi-exclamation-triangle me-1"></i> ${data.error || data.message || 'GenieACS tidak terhubung atau belum ada modem terdeteksi.'}</td></tr>`;
      return;
    }

    availableOnusCache = list;
    renderOnuTable(list);
  } catch (err) {
    if (tbody) tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:24px; color:#ef4444;"><i class="bi bi-exclamation-triangle me-1"></i> Koneksi gagal: ${err.message}</td></tr>`;
  }
}

function renderOnuTable(onus) {
  const tbody = document.getElementById('onu_picker_tbody');
  if (!tbody) return;

  if (!onus || onus.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:24px; color:var(--muted);">Tidak ada modem ONU yang terdeteksi di GenieACS. Pastikan ONU telah disetting ACS URL.</td></tr>';
    return;
  }

  tbody.innerHTML = onus.map((o) => {
    const snVal = o.serialNumber || o.sn || '-';
    const isPaired = o.isAssigned || o.is_paired;
    const pairedWith = o.assignedTo || o.paired_with || 'Pelanggan';
    const pairedBadge = isPaired 
      ? `<span class="badge bw" style="font-size:10px;"><i class="bi bi-link-45deg me-1"></i>Terpasang: ${pairedWith}</span>`
      : `<span class="badge bs" style="font-size:10px;"><i class="bi bi-check-circle me-1"></i>Tersedia / Bebas</span>`;

    const tagVal = o.tag || o.genieacs_tag || '';
    const tagEsc = (tagVal || snVal || '').replace(/'/g, "\\'");
    const snEsc = (snVal || '').replace(/'/g, "\\'");

    return `
      <tr style="border-bottom:1px solid var(--border);">
        <td style="padding:10px; font-weight:700; font-family:monospace; color:var(--primary);">${snVal}</td>
        <td style="padding:10px;">${o.model || o.productClass || o.manufacturer || 'ONT Generic'}</td>
        <td style="padding:10px; font-family:monospace; font-size:11px;">${o.ip || '-'}</td>
        <td style="padding:10px; font-family:monospace; font-size:11px;">${tagVal || '-'}</td>
        <td style="padding:10px;">${pairedBadge}</td>
        <td style="padding:10px; text-align:center;">
          <button type="button" class="btn btn-p btn-sm" style="font-size:11px; padding:3px 10px;" onclick="selectOnuForCustomer('${snEsc}', '${tagEsc}')">
            <i class="bi bi-check2 me-1"></i> Gunakan
          </button>
        </td>
      </tr>
    `;
  }).join('');
}

function filterOnuList() {
  const query = (document.getElementById('onu_picker_search')?.value || '').toLowerCase().trim();
  if (!query) {
    renderOnuTable(availableOnusCache);
    return;
  }
  const filtered = availableOnusCache.filter(o => 
    (o.sn && o.sn.toLowerCase().includes(query)) ||
    (o.model && o.model.toLowerCase().includes(query)) ||
    (o.manufacturer && o.manufacturer.toLowerCase().includes(query)) ||
    (o.ip && o.ip.toLowerCase().includes(query)) ||
    (o.genieacs_tag && o.genieacs_tag.toLowerCase().includes(query))
  );
  renderOnuTable(filtered);
}

function selectOnuForCustomer(sn, tag) {
  const prefix = currentOnuPickerTarget === 'add' ? 'add_' : 'e_';
  const tagField = currentOnuPickerTarget === 'add' ? document.getElementById('add_genieacs_tag') : document.getElementById('e_tag');
  const snField = document.getElementById(prefix + 'ont_sn');

  if (snField) snField.value = sn;
  if (tagField) {
    if (!tagField.value || tagField.value.trim() === '') {
      tagField.value = tag || sn;
    }
  }

  closeModal('onuPickerModal');
  alert(`Modem ONU (SN: ${sn}) berhasil dipasangkan ke form!`);
}

