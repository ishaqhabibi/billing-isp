      <div id="cust_tab_conn" class="cust-detail-pane active">
        <div class="cust-modal-grid-2">
          <!-- Credentials & Session Card -->
          <div class="cust-card-panel">
            <div class="fw6 mb-3 text-primary d-flex align-items-center justify-content-between" style="font-size:13px; display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
              <span><i class="bi bi-key me-1"></i> Akun & Kredensial MikroTik</span>
              <span class="badge bp" style="font-size:11px;" id="v_conn_type">PPPOE</span>
            </div>
            <div style="display:grid; gap:10px; font-size:12px;">
              <div style="display:flex; justify-content:space-between; align-items:center; padding:7px 0; border-bottom:1px solid rgba(255,255,255,0.06);">
                <span class="text-muted">Username PPPoE / Hotspot</span>
                <div style="display:flex; align-items:center; gap:6px;">
                  <code id="v_username" style="font-weight:700; color:#38bdf8; font-size:13px;">-</code>
                  <button type="button" class="btn btn-g btn-sm py-0 px-2" style="font-size:11px; padding:2px 7px;" onclick="copyToClipboard('v_username', 'Username')"><i class="bi bi-copy"></i></button>
                </div>
              </div>
              <div style="display:flex; justify-content:space-between; align-items:center; padding:7px 0; border-bottom:1px solid rgba(255,255,255,0.06);">
                <span class="text-muted">Password PPPoE / Hotspot</span>
                <div style="display:flex; align-items:center; gap:6px;">
                  <code id="v_password" style="font-weight:700; color:#f472b6; font-size:13px;">-</code>
                  <button type="button" class="btn btn-g btn-sm py-0 px-2" style="font-size:11px; padding:2px 7px;" onclick="copyToClipboard('v_password', 'Password')"><i class="bi bi-copy"></i></button>
                </div>
              </div>
              <div style="display:flex; justify-content:space-between; align-items:center; padding:7px 0; border-bottom:1px solid rgba(255,255,255,0.06);">
                <span class="text-muted">IP Address (Sesi / Static)</span>
                <div style="display:flex; align-items:center; gap:6px;">
                  <code id="v_ip" style="font-weight:700; color:#4ade80; font-size:13px;">-</code>
                  <button type="button" class="btn btn-g btn-sm py-0 px-2" style="font-size:11px; padding:2px 7px;" onclick="copyToClipboard('v_ip', 'IP Address')"><i class="bi bi-copy"></i></button>
