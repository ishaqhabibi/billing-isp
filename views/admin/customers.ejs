    if (badge) {
      badge.innerHTML = '<span><i class="bi bi-cloud-check-fill text-success me-1"></i> <strong>Mode: Ambil dari MikroTik</strong> — Memetakan secret eksisting yang sedang running tanpa menimpa/membuat ulang di router.</span>';
