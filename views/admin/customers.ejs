      btnMikrotik.style.background = 'transparent';
      btnMikrotik.style.color = 'var(--primary)';
      btnMikrotik.classList.add('btn-g');
    }
    if (badge) {
      badge.innerHTML = '<span><i class="bi bi-info-circle text-primary me-1"></i> <strong>Mode: Buat Baru</strong> — Kredensial akan otomatis didaftarkan ke MikroTik <code>/ppp secret</code> saat formulir disimpan.</span>';
      badge.style.background = 'rgba(99,102,241,0.08)';
      badge.style.borderColor = 'rgba(99,102,241,0.3)';
