function generateRandomPassword(length = 6) {
  const chars = '23456789abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ';
  let pass = '';
  for (let i = 0; i < length; i++) {
    pass += chars.charAt(Math.floor(Math.random() * chars.length));
  }
  return pass;
}

async function autoGenerateCustomerCode(type = 'add') {
  const prefix = type === 'add' ? 'add_' : 'e_';
  const areaSelect = document.getElementById(prefix + 'area');
  const codeInput = document.getElementById(prefix + 'customer_code');

  if (!codeInput) return;

  // Jika input kode sudah terisi manual oleh admin, konfirmasi sebelum menimpa
  if (codeInput.value && codeInput.value.trim()) {
    if (!confirm('Kode pelanggan saat ini sudah terisi (' + codeInput.value + '). Apakah Anda ingin menggantinya dengan kode generate baru?')) {
      return;
    }
  }

  let areaVal = '';
  let areaCodeAttr = '';
  if (areaSelect && areaSelect.selectedIndex > 0) {
    const opt = areaSelect.options[areaSelect.selectedIndex];
    areaVal = opt ? (opt.value || opt.text || '').trim() : '';
    areaCodeAttr = opt ? (opt.getAttribute('data-code') || '').trim() : '';
  }

  // Coba ambil next-code otomatis dari server database backend
  try {
    const queryParam = encodeURIComponent(areaCodeAttr || areaVal);
    const res = await fetch(`/admin/api/customers/next-code?area=${queryParam}`);
    const data = await res.json();
    if (data.ok && data.customer_code) {
      codeInput.value = data.customer_code;
      return;
    }
  } catch (e) {
    console.warn('Gagal fetch next-code dari server, gunakan fallback lokal:', e);
  }

  // Fallback lokal jika fetch offline
  const finalArea = areaCodeAttr || (areaVal ? areaVal.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 3) : 'BN');
  const year2 = String(new Date().getFullYear()).slice(-2);
  const fallbackCode = `${finalArea}${year2}001`;
  codeInput.value = fallbackCode;
}

