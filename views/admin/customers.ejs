// ─── ACTION DROPDOWN TOGGLER ─────────────────────────────────────────
function toggleActionDropdown(btn, e) {
  if (e) {
    e.stopPropagation();
    e.preventDefault();
  }
  const parent = btn.closest('.action-dropdown');
  if (!parent) return;
  const menu = parent.querySelector('.action-dropdown-menu');
  if (!menu) return;
  const wasActive = parent.classList.contains('active');
  
  // Close any other open dropdowns
  document.querySelectorAll('.action-dropdown.active').forEach(d => {
    if (d !== parent) d.classList.remove('active');
  });

  if (!wasActive) {
    parent.classList.add('active');

    // Get trigger button screen coordinates
    const rect = btn.getBoundingClientRect();
    const menuWidth = 220; // Standard menu width
    const menuHeight = 280; // Total height of action items
    const viewportWidth = document.documentElement.clientWidth || window.innerWidth;
    const viewportHeight = window.innerHeight;

    // HORIZONTAL POSITIONING:
    // Place menu so its right edge aligns with the button's right edge
    let targetLeft = rect.right - menuWidth;

    // Strict boundary checks to ensure menu NEVER overflows the screen:
    if (targetLeft + menuWidth > viewportWidth - 14) {
      targetLeft = viewportWidth - menuWidth - 14;
    }
    if (targetLeft < 10) {
      targetLeft = 10;
    }

    menu.style.position = 'fixed';
    menu.style.left = Math.round(targetLeft) + 'px';
    menu.style.right = 'auto';
    menu.style.width = menuWidth + 'px';

    // VERTICAL POSITIONING:
    const spaceBelow = viewportHeight - rect.bottom;
    const spaceAbove = rect.top;

    if (spaceBelow < menuHeight && spaceAbove > spaceBelow) {
      // Open upwards (dropup)
      menu.style.top = 'auto';
      menu.style.bottom = Math.round(viewportHeight - rect.top + 6) + 'px';
    } else {
      // Open downwards
      menu.style.bottom = 'auto';
      menu.style.top = Math.round(rect.bottom + 6) + 'px';
    }
  } else {
    parent.classList.remove('active');
  }
}

// Global click listener to close action dropdowns
document.addEventListener('click', (e) => {
  if (!e.target.closest('.action-dropdown')) {
    document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
  }
});
document.addEventListener('keydown', (e) => {
