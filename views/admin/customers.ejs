function updateTopupEstimatedBalance() {
  if (!currentTopupCust) return;
  const currentBal = Number(currentTopupCust.balance || 0);
  const amt = Number(document.getElementById('topupAmount')?.value) || 0;
  const isDeduct = document.querySelector('#topupBalanceModal input[name="action_type"]:checked')?.value === 'deduct';
  const helpEl = document.getElementById('topupEstimateHelp');
  if (!helpEl) return;
  
  if (amt <= 0) {
    helpEl.textContent = '';
    return;
  }
  
  const finalBal = isDeduct ? Math.max(0, currentBal - amt) : (currentBal + amt);
  helpEl.innerHTML = `Estimasi saldo akhir: <strong style="color:${isDeduct ? '#ef4444' : '#10b981'}">Rp ${finalBal.toLocaleString('id-ID')}</strong>`;
}

function updateTopupActionUI() {
  const isDeduct = document.querySelector('#topupBalanceModal input[name="action_type"]:checked')?.value === 'deduct';
  const submitBtn = document.getElementById('topupSubmitBtn');
  const noteInput = document.getElementById('topupNote');
  if (isDeduct) {
    if (submitBtn) {
      submitBtn.className = 'btn btn-d';
      submitBtn.innerHTML = '<i class="bi bi-dash-circle"></i> Potong Saldo';
    }
    if (noteInput && !noteInput.value) {
      noteInput.placeholder = 'Alasan / keterangan pemotongan saldo';
    }
  } else {
    if (submitBtn) {
      submitBtn.className = 'btn btn-s';
      submitBtn.innerHTML = '<i class="bi bi-check-lg"></i> Proses Top-Up';
    }
    if (noteInput && !noteInput.value) {
      noteInput.placeholder = 'Contoh: Setor Tunai di Loket Kasir, Refund, dll.';
    }
  }
  updateTopupEstimatedBalance();
}

