let currentCustomerCpeTag = null;
let currentCustomerObj = null;

async function loadCustomerCpeInfo(c) {
  currentCustomerObj = c;
  const cpeCard = document.getElementById('v_cpe_card');
  const cpeDot = document.getElementById('v_tab_cpe_dot');
  if (cpeDot) cpeDot.style.display = 'none';
  if (!cpeCard) return;

  const targetTag = (c.genieacs_tag || c.pppoe_username || '').trim();
  currentCustomerCpeTag = targetTag;

  if (!targetTag) {
    cpeCard.style.display = 'none';
    if (cpeDot) cpeDot.style.display = 'none';
    return;
  }

  cpeCard.style.display = 'block';
  document.getElementById('v_cpe_status_badge').className = 'badge bm';
  document.getElementById('v_cpe_status_badge').textContent = 'Memuat ACS...';
  document.getElementById('v_cpe_ssid').textContent = '...';
  document.getElementById('v_cpe_clients').textContent = '...';
  document.getElementById('v_cpe_uptime').textContent = '...';
  document.getElementById('v_cpe_model').textContent = '-';
  document.getElementById('v_cpe_sn').textContent = '-';
  document.getElementById('v_cpe_rx').textContent = '-';

  try {
    const res = await fetch('/admin/api/device/' + encodeURIComponent(targetTag));
    if (!res.ok) {
      if (cpeDot) cpeDot.style.display = 'none';
      document.getElementById('v_cpe_status_badge').className = 'badge bm';
      document.getElementById('v_cpe_status_badge').textContent = 'Tidak Terhubung ke ACS';
      document.getElementById('v_cpe_ssid').textContent = '-';
      document.getElementById('v_cpe_clients').textContent = '0 User';
      document.getElementById('v_cpe_uptime').textContent = '-';
      return;
    }
    const d = await res.json();
    const isOnline = (d.status || '').toLowerCase() === 'online';
    if (cpeDot) cpeDot.style.display = isOnline ? 'inline-block' : 'none';
    document.getElementById('v_cpe_status_badge').className = 'badge ' + (isOnline ? 'bs' : 'bd');
    document.getElementById('v_cpe_status_badge').textContent = isOnline ? 'Online' : 'Offline';

    document.getElementById('v_cpe_ssid').textContent = d.ssid || '-';
    
    // Connected users count
    let clientCount = 0;
    if (Array.isArray(d.connectedUsers)) clientCount = d.connectedUsers.length;
    else if (d.totalAssociations) clientCount = d.totalAssociations;
    document.getElementById('v_cpe_clients').textContent = clientCount + ' User';
    
    document.getElementById('v_cpe_uptime').textContent = d.uptime || d.pppoeUptime || '-';
    document.getElementById('v_cpe_model').textContent = d.model || d.productClass || 'CPE';
    document.getElementById('v_cpe_sn').textContent = d.serialNumber || d.phone || targetTag;
    document.getElementById('v_cpe_rx').textContent = (d.rxPower && d.rxPower !== '-') ? (d.rxPower + ' dBm') : '-';
  } catch (err) {
    if (cpeDot) cpeDot.style.display = 'none';
    document.getElementById('v_cpe_status_badge').className = 'badge bm';
    document.getElementById('v_cpe_status_badge').textContent = 'Gagal Memuat';
  }
}

function openCustomerWifiModal() {
  if (!currentCustomerObj || !currentCustomerCpeTag) return alert('Data perangkat/pelanggan tidak ditemukan.');
  document.getElementById('wifi_target_tag').value = currentCustomerCpeTag;
  document.getElementById('wifi_cust_name').value = currentCustomerObj.name + ' (' + (currentCustomerObj.pppoe_username || currentCustomerObj.code || '') + ')';
  const currSsid = document.getElementById('v_cpe_ssid').textContent;
  document.getElementById('wifi_new_ssid').value = (currSsid && currSsid !== '-' && currSsid !== '...') ? currSsid : '';
  document.getElementById('wifi_new_password').value = '';
  openModal('customerWifiModal');
}

async function submitCustomerWifi(e) {
  e.preventDefault();
  const tag = document.getElementById('wifi_target_tag').value;
  const ssid = document.getElementById('wifi_new_ssid').value.trim();
  const password = document.getElementById('wifi_new_password').value.trim();
  const notifyWa = document.getElementById('wifi_notify_wa').checked;
  const btn = document.getElementById('btn_save_wifi');

  if (!ssid && !password) return alert('Silakan isi nama SSID atau password baru.');
  if (password && password.length < 8) return alert('Password Wi-Fi minimal 8 karakter.');

  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Mengirim ke Modem...';

  try {
    const res = await fetch('/admin/api/device/' + encodeURIComponent(tag) + '/wifi', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ssid, password, notifyWa })
    });
    const data = await res.json();
    if (data.success) {
      alert(data.message || 'Pengaturan Wi-Fi berhasil diperbarui!');
      closeModal('customerWifiModal');
      if (currentCustomerObj) loadCustomerCpeInfo(currentCustomerObj);
    } else {
      alert('Gagal: ' + (data.error || 'Terjadi kesalahan'));
    }
  } catch (err) {
    alert('Error: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-save"></i> Simpan Perubahan Wi-Fi';
  }
}

async function rebootCustomerDevice() {
  if (!currentCustomerCpeTag) return;
  if (!confirm('Apakah Anda yakin ingin me-reboot modem pelanggan ini? Koneksi internet pelanggan akan terputus sementara selama modem restart.')) return;
  try {
    const res = await fetch('/admin/api/device/' + encodeURIComponent(currentCustomerCpeTag) + '/reboot', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      alert('Perintah reboot berhasil dikirimkan ke modem!');
    } else {
      alert('Gagal reboot: ' + (data.error || 'Perangkat tidak merespons'));
    }
  } catch (e) {
    alert('Error: ' + e.message);
  }
}

function togglePassVisibility(inputId, btn) {
  const el = document.getElementById(inputId);
