<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.customers.title', 'Pelanggan') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <link rel="stylesheet" href="/css/admin.css?v=2.6">
  <style>
    .usage-bar { height: 4px; background: var(--bg3); border-radius: 2px; margin: 4px 0; overflow: hidden; width: 100px; }
    .usage-fill { height: 100%; width: var(--p, 0%); background: var(--b, var(--primary)); transition: width 0.3s; }
    #picker-map { height: 400px; width: 100%; border-radius: 8px; margin-bottom: 15px; }
    .picker-icon { color: #3b82f6; font-size: 32px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3)); display: block; width: 32px; height: 32px; text-align: center; line-height: 32px; text-shadow: -1.5px -1.5px 0 #fff, 1.5px -1.5px 0 #fff, -1.5px 1.5px 0 #fff, 1.5px 1.5px 0 #fff; }
    
    /* Responsive Mobile CSS */
    @media (max-width: 768px) {
      .stat-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 10px !important; }
      .card-hd { flex-direction: column !important; align-items: stretch !important; gap: 10px !important; }
      .card-hd > div { flex-wrap: wrap !important; justify-content: stretch !important; }
      .card-hd .btn { flex: 1 1 auto; justify-content: center; }
      .srow { flex-direction: column !important; gap: 10px !important; }
      .sinput, .srow select { width: 100% !important; max-width: 100% !important; }
      .mo .mb { width: 95vw !important; max-width: 95vw !important; margin: 10px auto !important; padding: 14px !important; border-radius: 14px !important; }
      .mo .mbody { max-height: 72vh !important; padding-right: 4px !important; }
      .form-row { flex-direction: column !important; gap: 8px !important; }
      .form-row > .fg { width: 100% !important; max-width: 100% !important; margin-bottom: 6px !important; }
      .mf { flex-wrap: wrap !important; gap: 8px !important; }
      .mf button, .mf a { flex: 1 1 100% !important; text-align: center !important; justify-content: center !important; }
    }

    /* Customer Detail Modal Professional Styling */
    .cust-detail-tab-btn {
      flex: 1;
      padding: 9px 14px;
      border-radius: 9px;
      border: none;
      background: transparent;
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      white-space: nowrap;
      text-decoration: none;
    }
    .cust-detail-tab-btn:hover {
      color: var(--text);
      background: rgba(255,255,255,0.05);
    }
    .cust-detail-tab-btn.active {
      background: var(--bg2) !important;
      color: var(--primary) !important;
      font-weight: 700;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }
    .cust-detail-pane {
      display: none;
      animation: fadeInCustPane 0.2s ease forwards;
    }
    .cust-detail-pane.active {
      display: block;
    }
    @keyframes fadeInCustPane {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Modal Grid & Card Layout Classes */
    .cust-modal-grid-2 {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 16px;
      align-items: stretch;
    }
    .cust-modal-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .cust-modal-grid-traffic {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }
    .cust-card-panel {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
    }
    .cust-kpi-card {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 12px;
      text-align: center;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .cust-kpi-card:hover {
      border-color: rgba(99, 102, 241, 0.4);
      transform: translateY(-2px);
    }
    @media (max-width: 768px) {
      .cust-modal-grid-2 {
        grid-template-columns: 1fr !important;
        gap: 14px !important;
      }
      .cust-modal-grid-3 {
        grid-template-columns: 1fr !important;
        gap: 10px !important;
      }
      .cust-modal-grid-traffic {
        grid-template-columns: 1fr !important;
        gap: 10px !important;
      }
    }
    /* Quick Filter Chips */
    .cust-quick-filters {
      display: flex;
      gap: 8px;
      margin: 14px 0 16px 0;
      flex-wrap: wrap;
      align-items: center;
    }
    .cust-filter-chip {
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      background: var(--bg2);
      border: 1px solid var(--border);
      color: var(--muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .cust-filter-chip:hover {
      background: var(--bg3);
      color: var(--text);
      border-color: rgba(255,255,255,0.2);
    }
    .cust-filter-chip.active {
      background: rgba(99, 102, 241, 0.15);
      border-color: var(--primary);
      color: var(--primary);
      font-weight: 700;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.2);
    }
    .online-pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 6px #10b981;
      animation: pulseGreen 1.5s infinite;
    }
    @keyframes pulseGreen {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* Action Dropdown Menu */
    .action-dropdown {
      position: relative;
      display: inline-block;
    }
    .action-dropdown-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--bg2);
      color: var(--text);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .action-dropdown-btn:hover, .action-dropdown.active .action-dropdown-btn {
      background: var(--bg3);
      border-color: var(--primary);
      color: var(--primary);
    }
    .action-dropdown-menu {
      display: none;
      position: fixed;
      min-width: 215px;
      max-width: 260px;
      background: var(--bg2, #131b2e);
      color: var(--text, #e6edf3);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
      z-index: 999999;
      padding: 6px 0;
      text-align: left;
    }
    .action-dropdown.active .action-dropdown-menu {
      display: block;
      animation: fadeInDropdown 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes fadeInDropdown {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .action-dropdown-item {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 8px 14px;
      font-size: 12px;
      font-weight: 500;
      color: var(--text, #e6edf3);
      background: transparent;
      border: none;
      text-align: left;
      cursor: pointer;
      text-decoration: none;
      box-sizing: border-box;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .action-dropdown-item:hover {
      background: rgba(0, 82, 204, 0.08);
      color: var(--primary);
    }
    .action-dropdown-item.danger-item {
      color: var(--danger, #ef4444);
    }
    .action-dropdown-item.danger-item:hover {
      background: rgba(239, 68, 68, 0.1);
      color: var(--danger, #ef4444);
    }
    .action-dropdown-divider {
      height: 1px;
      background: var(--border);
      margin: 4px 0;
    }
    .tbl-wrap {
      min-height: 180px;
    }

    /* Light Theme Explicit Support for Dropdown */
    html[data-theme="light"] .action-dropdown-menu,
    body.light-theme .action-dropdown-menu {
      background: #ffffff !important;
      color: #0f172a !important;
      border: 1px solid rgba(0, 52, 120, 0.16) !important;
      box-shadow: 0 12px 30px rgba(0, 52, 120, 0.18), 0 4px 10px rgba(0, 0, 0, 0.05) !important;
    }
    html[data-theme="light"] .action-dropdown-item,
    body.light-theme .action-dropdown-item {
      color: #1e293b !important;
    }
    html[data-theme="light"] .action-dropdown-item:hover,
    body.light-theme .action-dropdown-item:hover {
      background: #f1f6fc !important;
      color: #0052cc !important;
    }
    html[data-theme="light"] .action-dropdown-item.danger-item,
    body.light-theme .action-dropdown-item.danger-item {
      color: #ef4444 !important;
    }
    html[data-theme="light"] .action-dropdown-item.danger-item:hover,
    body.light-theme .action-dropdown-item.danger-item:hover {
      background: #fef2f2 !important;
      color: #dc2626 !important;
    }
    html[data-theme="light"] .action-dropdown-divider,
    body.light-theme .action-dropdown-divider {
      background: rgba(0, 52, 120, 0.09) !important;
    }
    html[data-theme="light"] .action-dropdown-btn,
    body.light-theme .action-dropdown-btn {
      background: #ffffff !important;
      color: #334155 !important;
      border: 1px solid rgba(0, 52, 120, 0.18) !important;
    }
    html[data-theme="light"] .action-dropdown-btn:hover,
    html[data-theme="light"] .action-dropdown.active .action-dropdown-btn,
    body.light-theme .action-dropdown-btn:hover,
    body.light-theme .action-dropdown.active .action-dropdown-btn {
      background: #f1f6fc !important;
      border-color: #0052cc !important;
      color: #0052cc !important;
    }

    /* Bulk Action Bar */
    .bulk-action-bar {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.98), rgba(15, 23, 42, 0.98));
      border: 1px solid rgba(99, 102, 241, 0.35);
      border-radius: 12px;
      padding: 10px 16px;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
      animation: fadeInBulk 0.2s ease forwards;
    }
    @keyframes fadeInBulk {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Direct WhatsApp button */
    .btn-wa-direct {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 5px;
      background: rgba(37, 211, 102, 0.12);
      color: #25d366;
      border: 1px solid rgba(37, 211, 102, 0.25);
      text-decoration: none;
      font-size: 11px;
      transition: all 0.15s ease;
    }
    .btn-wa-direct:hover {
      background: #25d366;
      color: #fff;
      transform: scale(1.1);
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'customers', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-people"></i> <%= t('admin.customers.manage_title', 'Manajemen Pelanggan') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type === 'success' ? 's' : 'd' %>">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <!-- Stats (Clickable Filter Cards) -->
    <style>
      .sc-clickable { cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
      .sc-clickable:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.15); }
      .stat-card-active { border: 2px solid var(--primary) !important; box-shadow: 0 0 12px var(--pdim); }
      .sc.s.stat-card-active { border-color: var(--success) !important; box-shadow: 0 0 12px var(--sdim); }
      .sc.w.stat-card-active { border-color: var(--warning) !important; box-shadow: 0 0 12px var(--wdim); }
      .sc.d.stat-card-active { border-color: var(--danger) !important; box-shadow: 0 0 12px var(--ddim); }
    </style>
    <div class="stat-grid" style="grid-template-columns:repeat(5,1fr)">
      <div class="sc p sc-clickable <%= (!filterStatus) ? 'stat-card-active' : '' %>" onclick="filterByStatus('')" title="Klik untuk tampilkan semua pelanggan">
        <i class="bi bi-people sc-icon"></i>
        <div class="sc-label"><%= t('admin.customers.stats.total', 'Total') %></div>
        <div class="sc-val"><%= stats.total %></div>
        <% if (!filterStatus) { %>
          <div style="font-size:10px;font-weight:800;color:var(--primary);margin-top:4px"><i class="bi bi-funnel-fill"></i> Filter Aktif</div>
        <% } %>
      </div>
      <div class="sc s sc-clickable <%= (filterStatus === 'active') ? 'stat-card-active' : '' %>" onclick="filterByStatus('active')" title="Klik untuk filter pelanggan Aktif">
        <i class="bi bi-check-circle sc-icon"></i>
        <div class="sc-label"><%= t('admin.customers.stats.active', 'Aktif') %></div>
        <div class="sc-val"><%= stats.active %></div>
        <% if (filterStatus === 'active') { %>
          <div style="font-size:10px;font-weight:800;color:var(--success);margin-top:4px"><i class="bi bi-funnel-fill"></i> Filter Aktif</div>
        <% } %>
      </div>
      <div class="sc d sc-clickable <%= (filterStatus === 'unpaid') ? 'stat-card-active' : '' %>" onclick="filterByStatus('unpaid')" title="Klik untuk filter pelanggan Menunggak (Ada Tagihan Belum Lunas)">
        <i class="bi bi-exclamation-octagon sc-icon" style="color:#f43f5e;"></i>
        <div class="sc-label" style="color:#f43f5e;">Menunggak</div>
        <div class="sc-val" style="color:#f43f5e;"><%= stats.unpaid || 0 %></div>
        <% if (filterStatus === 'unpaid') { %>
          <div style="font-size:10px;font-weight:800;color:#f43f5e;margin-top:4px"><i class="bi bi-funnel-fill"></i> Filter Aktif</div>
        <% } %>
      </div>
      <div class="sc w sc-clickable <%= (filterStatus === 'suspended') ? 'stat-card-active' : '' %>" onclick="filterByStatus('suspended')" title="Klik untuk filter pelanggan Disuspend">
        <i class="bi bi-pause-circle sc-icon"></i>
        <div class="sc-label"><%= t('admin.customers.stats.suspended', 'Disuspend') %></div>
        <div class="sc-val"><%= stats.suspended %></div>
        <% if (filterStatus === 'suspended') { %>
          <div style="font-size:10px;font-weight:800;color:var(--warning);margin-top:4px"><i class="bi bi-funnel-fill"></i> Filter Aktif</div>
        <% } %>
      </div>
      <div class="sc d sc-clickable <%= (filterStatus === 'inactive') ? 'stat-card-active' : '' %>" onclick="filterByStatus('inactive')" title="Klik untuk filter Pendaftar Baru / Nonaktif">
        <i class="bi bi-person-plus sc-icon"></i>
        <div class="sc-label"><%= t('admin.customers.stats.inactive', 'Pendaftar Baru') %></div>
        <div class="sc-val"><%= stats.inactive %></div>
        <% if (filterStatus === 'inactive') { %>
          <div style="font-size:10px;font-weight:800;color:var(--danger);margin-top:4px"><i class="bi bi-funnel-fill"></i> Filter Aktif</div>
        <% } %>
      </div>
    </div>

    <!-- Quick Filter Chips -->
    <div class="cust-quick-filters">
      <span style="font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-right:2px;"><i class="bi bi-funnel"></i> Filter:</span>
      <button type="button" class="cust-filter-chip <%= (!filterStatus) ? 'active' : '' %>" onclick="filterByStatus('')">
        Semua (<%= stats.total %>)
      </button>
      <button type="button" class="cust-filter-chip <%= (filterStatus === 'active') ? 'active' : '' %>" onclick="filterByStatus('active')">
        <i class="bi bi-check-circle-fill text-success"></i> Aktif (<%= stats.active %>)
      </button>
      <button type="button" class="cust-filter-chip <%= (filterStatus === 'unpaid') ? 'active' : '' %>" onclick="filterByStatus('unpaid')">
        <i class="bi bi-exclamation-circle-fill text-danger"></i> Menunggak (<%= stats.unpaid || 0 %>)
      </button>
      <button type="button" class="cust-filter-chip <%= (filterStatus === 'suspended') ? 'active' : '' %>" onclick="filterByStatus('suspended')">
        <i class="bi bi-pause-circle-fill text-warning"></i> Disuspend (<%= stats.suspended %>)
      </button>
      <button type="button" class="cust-filter-chip <%= (filterStatus === 'inactive') ? 'active' : '' %>" onclick="filterByStatus('inactive')">
        <i class="bi bi-person-x-fill text-muted"></i> Nonaktif (<%= stats.inactive %>)
      </button>
      <span style="width:1px;height:18px;background:var(--border);margin:0 4px;display:inline-block;"></span>
      <button type="button" class="cust-filter-chip" id="chip_filter_online" onclick="toggleConnFilter('online')">
        <span class="online-pulse-dot"></span> Online (<span id="count_live_online">0</span>)
      </button>
      <button type="button" class="cust-filter-chip" id="chip_filter_offline" onclick="toggleConnFilter('offline')">
        <i class="bi bi-circle-fill text-muted" style="font-size:8px;"></i> Offline (<span id="count_live_offline">0</span>)
      </button>
    </div>

    <!-- Print Header (Only visible on paper print) -->
    <div class="print-only" style="margin-bottom:14px;border-bottom:2px solid #0f172a;padding-bottom:10px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div>
          <h2 style="font-size:16pt;font-weight:800;text-transform:uppercase;margin:0"><%= company %></h2>
          <div style="font-size:10pt;color:#334155"><%= t('admin.customers.manage_title', 'Daftar Data Pelanggan') %> &bull; Status: <%= filterStatus ? filterStatus.toUpperCase() : 'SEMUA' %></div>
        </div>
        <div style="text-align:right;font-size:8.5pt;color:#475569">
          <div>Dicetak: <%= getNowLocal() %></div>
          <div>Total Pelanggan: <strong><%= customers.length %> Orang</strong></div>
        </div>
      </div>
    </div>

    <!-- Bulk Actions Floating Bar -->
    <div id="bulkActionBar" class="bulk-action-bar" style="display:none;">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <span class="badge bp" style="font-size:12px;padding:6px 12px;font-weight:700;">
          <i class="bi bi-check2-square me-1"></i> <span id="selectedCountText">0</span> Pelanggan Dipilih
        </span>
        <button type="button" class="btn btn-w btn-sm" onclick="triggerBulkAction('isolate', 'Apakah Anda yakin ingin MENGISOLIR semua pelanggan terpilih?')">
          <i class="bi bi-pause-circle me-1"></i> Isolir Terpilih
        </button>
        <button type="button" class="btn btn-s btn-sm" onclick="triggerBulkAction('unisolate', 'Apakah Anda yakin ingin MENGAKTIFKAN kembali semua pelanggan terpilih?')">
          <i class="bi bi-play-circle me-1"></i> Buka Isolir
        </button>
        <button type="button" class="btn btn-g btn-sm" onclick="openBulkWaModal()">
          <i class="bi bi-whatsapp text-success me-1"></i> Kirim WhatsApp
        </button>
        <% if (typeof session !== 'undefined' && session && !session.isCashier) { %>
        <button type="button" class="btn btn-d btn-sm" onclick="triggerBulkAction('delete', 'PERINGATAN: Hapus semua data pelanggan terpilih?')">
          <i class="bi bi-trash me-1"></i> Hapus Terpilih
        </button>
        <% } %>
      </div>
      <button type="button" class="btn btn-g btn-sm" onclick="clearSelectedCust()"><i class="bi bi-x-lg"></i> Batal Pilih</button>
    </div>

    <form id="bulkActionForm" method="POST" action="/admin/customers/bulk-action" style="display:none;">
      <input type="hidden" name="action" id="bulkActionInput">
      <input type="hidden" name="customer_ids" id="bulkCustomerIdsInput">
    </form>

    <!-- Search & Add -->
    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-people"></i> <%= t('admin.customers.list', 'Daftar Pelanggan') %> (<%= customers.length %>)</h6>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button type="button" class="btn btn-g btn-sm" onclick="window.print()" title="Cetak Data Pelanggan"><i class="bi bi-printer"></i> Cetak</button>
          <a href="/admin/onu-stickers" class="btn btn-g btn-sm" title="Cetak Stiker Modem / ONU"><i class="bi bi-qr-code-scan"></i> Stiker ONU</a>
          <a href="/admin/customers/export" class="btn btn-g btn-sm"><i class="bi bi-file-earmark-excel"></i> <%= t('admin.customers.export_excel', 'Export Excel') %></a>
          <button class="btn btn-g btn-sm" onclick="openModal('importModal')"><i class="bi bi-file-earmark-arrow-up"></i> <%= t('admin.customers.import_excel', 'Import Excel') %></button>
          <button class="btn btn-p btn-sm" onclick="openModal('addModal')"><i class="bi bi-plus-lg"></i> <%= t('admin.customers.add', 'Tambah Pelanggan') %></button>
        </div>
      </div>
      <div class="card-bd" style="padding-bottom:0">
        <form method="GET" action="/admin/customers" class="srow">
          <div class="sinput" style="max-width:320px">
            <i class="bi bi-search"></i>
            <input class="fc" name="search" placeholder="<%= t('admin.customers.search_placeholder', 'Cari nama, telepon, tag...') %>" value="<%= search %>">
          </div>
          <select class="fs" name="status" style="width:160px" onchange="this.form.submit()">
            <option value=""><%= t('admin.customers.filter.all_status', 'Semua Status') %></option>
            <option value="active" <%= filterStatus==='active' ? 'selected':'' %>><%= t('admin.customers.filter.active', 'Aktif') %></option>
            <option value="unpaid" <%= filterStatus==='unpaid' ? 'selected':'' %>>⚠️ Menunggak (Unpaid)</option>
            <option value="suspended" <%= filterStatus==='suspended' ? 'selected':'' %>><%= t('admin.customers.filter.suspended', 'Suspend / Isolir') %></option>
            <option value="inactive" <%= filterStatus==='inactive' ? 'selected':'' %>><%= t('admin.customers.filter.inactive', 'Pendaftar Baru / Nonaktif') %></option>
          </select>
          <select class="fs" name="area" style="width:160px" onchange="this.form.submit()">
            <option value="">Semua Area</option>
            <% if (typeof areas !== 'undefined' && areas && areas.length > 0) { %>
              <% areas.forEach(a => { %>
                <option value="<%= a %>" <%= (typeof filterArea !== 'undefined' && filterArea === a) ? 'selected' : '' %>><%= a %></option>
              <% }) %>
            <% } %>
          </select>
          <% if (typeof routers !== 'undefined' && routers && routers.length > 0) { %>
          <select class="fs" style="width:160px;" onchange="window.location.href='/admin/set-active-router?router_id=' + this.value">
            <option value="all" <%= (!selectedRouterId) ? 'selected' : '' %>>🌐 Semua Router</option>
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>" <%= (selectedRouterId === r.id) ? 'selected' : '' %>>🔌 <%= r.name %></option>
            <% }) %>
          </select>
          <% } %>
          <button class="btn btn-g btn-sm" type="submit"><i class="bi bi-search"></i> <%= t('common.search', 'Cari') %></button>
          <% if (search || filterStatus || selectedRouterId) { %><a href="/admin/set-active-router?router_id=all" class="btn btn-g btn-sm"><i class="bi bi-x"></i> <%= t('common.reset', 'Reset') %></a><% } %>
        </form>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th style="width:36px;text-align:center;">
                <input type="checkbox" id="selectAllCust" onchange="toggleSelectAllCust(this)" style="cursor:pointer;width:15px;height:15px;" title="Pilih Semua">
              </th>
              <th>#</th>
              <th>Kode ID</th>
              <th><%= t('admin.customers.table.name', 'Nama') %></th>
              <th><%= t('admin.customers.table.phone_tag', 'Kontak & WhatsApp') %></th>
              <th><%= t('admin.customers.table.package', 'Paket') %></th>
              <th>Koneksi MikroTik</th>
              <th><%= t('admin.customers.table.address', 'Alamat & Topologi') %></th>
              <th><%= t('admin.customers.table.status', 'Status') %></th>
              <th><%= t('admin.customers.table.unpaid', 'Tagihan') %></th>
              <th style="text-align:center;"><%= t('admin.customers.table.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
          <% if (customers.length === 0) { %>
            <tr><td colspan="11" class="text-center text-muted" style="padding:32px"><%= t('admin.customers.empty', 'Belum ada pelanggan') %></td></tr>
          <% } %>
          <% customers.forEach((c, i) => { 
            const username = String(c.pppoe_username || c.hotspot_username || '').trim().toLowerCase();
            const session = username && typeof activeSessionsMap !== 'undefined' && activeSessionsMap && activeSessionsMap.get ? activeSessionsMap.get(username) : null;
            const isOnline = !!session;
            
            const rxBytes = session && session.bytesIn ? session.bytesIn : (c.bytes_in || 0);
            const txBytes = session && session.bytesOut ? session.bytesOut : (c.bytes_out || 0);
            
            function fmtB(b) {
              const num = Number(b) || 0;
              if (num <= 0) return '0 B';
              const k = 1024;
              const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
              const i = Math.floor(Math.log(num) / Math.log(k));
              return (num / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];
            }
          %>
            <tr class="cust-row" data-conn="<%= isOnline ? 'online' : 'offline' %>">
              <td style="text-align:center;">
                <input type="checkbox" class="cust-select-cb" value="<%= c.id %>" onchange="updateBulkBar()" style="cursor:pointer;width:15px;height:15px;">
              </td>
              <td class="text-muted"><%= i+1 %></td>
              <td>
                <span class="badge" style="background:rgba(59,130,246,0.12);color:#3b82f6;border:1px solid rgba(59,130,246,0.25);font-family:monospace;font-weight:800;letter-spacing:0.5px;font-size:11px;">
                  <%= c.customer_code || ('AJ-' + String(c.id).padStart(4, '0')) %>
                </span>
              </td>
              <td class="fw6">
                <a href="javascript:void(0)" onclick="viewCustDetail(<%= i %>)" style="color:var(--primary);text-decoration:none;font-weight:700;display:inline-flex;align-items:center;gap:5px;cursor:pointer;" title="Klik untuk lihat detail pelanggan & MikroTik">
                  <%= c.name %>
                  <i class="bi bi-info-circle-fill" style="font-size:12px;opacity:0.75;"></i>
                </a>
                <div style="font-size:11px;font-weight:700;color:#10b981;margin-top:2px;display:flex;align-items:center;gap:4px;" title="Saldo Dompet Pelanggan">
                  <i class="bi bi-wallet2"></i> Rp <%= Number(c.balance || 0).toLocaleString('id-ID') %>
                </div>
              </td>
              <td>
                <div style="display:flex;align-items:center;gap:6px;">
                  <span><%= c.phone || '-' %></span>
                  <% if (c.phone) { 
                    const cleanPhone = String(c.phone).replace(/\D/g, '').replace(/^0/, '62');
                  %>
                    <a href="https://wa.me/<%= cleanPhone %>" target="_blank" class="btn-wa-direct" title="Chat WhatsApp">
                      <i class="bi bi-whatsapp"></i>
                    </a>
                  <% } %>
                </div>
                <% if (c.genieacs_tag) { %><div style="font-size:11px;color:var(--primary)"><i class="bi bi-wifi"></i> <%= c.genieacs_tag %></div><% } %>
              </td>
              <td>
                <% if (c.package_name) { %>
                  <div style="font-weight:600;"><%= c.package_name %></div>
                  <div style="font-size:11px;color:var(--muted)"><%= (c.speed_down/1000).toFixed(0) %>/<%= (c.speed_up/1000).toFixed(0) %> Mbps &bull; Rp <%= c.package_price ? c.package_price.toLocaleString('id-ID') : '-' %></div>
                  <% if (c.package_billing_type === 'prepaid' || c.expired_at) { %>
                    <% 
                      const expDateStr = c.expired_at ? String(c.expired_at).slice(0, 10) : '-';
                      const isExpired = c.expired_at ? (new Date(c.expired_at) < new Date()) : false;
                    %>
                    <div style="margin-top:2px;">
                      <span class="badge <%= isExpired ? 'bd' : 'bs' %>" style="font-size:9px;padding:2px 5px;" title="Masa Aktif Paket Prabayar">
                        <i class="bi bi-hourglass-split"></i> Exp: <%= expDateStr %>
                      </span>
                    </div>
                  <% } %>
                <% } else { %><span class="text-muted">-</span><% } %>
              </td>
              <td class="cust-conn-cell" data-username="<%= username %>">
                <% if (isOnline) { %>
                  <span class="badge" style="background:rgba(16,185,129,0.18);color:#10b981;border:1px solid rgba(16,185,129,0.35);font-weight:700">
                    <span class="online-pulse-dot" style="margin-right:4px;"></span>ONLINE
                  </span>
                  <div style="font-size:12px;font-weight:800;color:var(--text);margin-top:3px">
                    <i class="bi bi-clock-history text-success me-1"></i><span class="conn-uptime"><%= session.uptime %></span>
                  </div>
                  <div style="font-size:10px;color:var(--muted)">
                    <span class="conn-ip"><%= session.ip %></span><% if (session.type) { %> (<%= session.type.toUpperCase() %>)<% } %>
                  </div>
                <% } else { %>
                  <span class="badge" style="background:rgba(148,163,184,0.12);color:#94a3b8;border:1px solid rgba(148,163,184,0.25)">
                    <i class="bi bi-circle-fill" style="font-size:7px;margin-right:4px"></i>OFFLINE
                  </span>
                  <div style="font-size:10px;color:var(--muted);margin-top:3px">Tidak Terhubung</div>
                <% } %>
                <div style="font-size:11px;margin-top:4px;display:flex;gap:6px;font-family:monospace;flex-wrap:wrap">
                  <span style="color:#38bdf8" title="Download (Receive)"><i class="bi bi-arrow-down"></i>RX: <strong class="conn-rx"><%= fmtB(rxBytes) %></strong></span>
                  <span style="color:#f472b6" title="Upload (Transmit)"><i class="bi bi-arrow-up"></i>TX: <strong class="conn-tx"><%= fmtB(txBytes) %></strong></span>
                </div>
              </td>
              <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                <div style="display:flex;align-items:center;gap:4px;">
                  <span><%= c.address || '-' %></span>
                  <% if (c.lat && c.lng) { %>
                    <a href="https://www.google.com/maps?q=<%= c.lat %>,<%= c.lng %>" target="_blank" style="color:#38bdf8;font-size:11px;" title="Lihat Lokasi GPS di Google Maps"><i class="bi bi-geo-alt-fill"></i></a>
                  <% } %>
                </div>
                <% if (c.area) { %><div style="font-size:11px;color:#0284c7"><i class="bi bi-geo-alt"></i> <%= c.area %></div><% } %>
                <% if (c.odc_name || c.odp_name) { %>
                  <div style="font-size:10px;color:var(--muted);margin-top:2px;" title="Topologi: <%= c.odc_name || 'ODC' %> / <%= c.odp_name || 'ODP' %>">
                    <i class="bi bi-diagram-2 text-info"></i> <%= c.odc_name || 'ODC' %> &bull; <%= c.odp_name || 'ODP' %><%= c.odp_port ? ' [P' + c.odp_port + ']' : '' %>
                  </div>
                <% } %>
                <% if (c.initial_rx_power !== null && c.initial_rx_power !== undefined && c.initial_rx_power !== '') { %>
                  <div style="font-size:10px;margin-top:1px;">
                    <span class="badge" style="padding:1px 5px;font-size:9px;background:rgba(56,189,248,0.12);color:#38bdf8;border:1px solid rgba(56,189,248,0.25);" title="Redaman Awal Saat QC">
                      <i class="bi bi-speedometer2"></i> <%= Number(c.initial_rx_power).toFixed(2) %> dBm
                    </span>
                  </div>
                <% } %>
              </td>
              <td>
                <% if (c.status==='active') { %><span class="badge bs"><i class="bi bi-circle-fill" style="font-size:7px"></i><%= t('admin.customers.filter.active', 'Aktif') %></span>
                <% } else if (c.status==='suspended') { %><span class="badge bw"><i class="bi bi-pause-circle" style="font-size:9px"></i> <%= t('admin.customers.filter.suspended', 'Suspend') %></span>
                <% } else { %><span class="badge bm"><%= t('admin.customers.filter.inactive', 'Nonaktif') %></span><% } %>
                <div style="font-size:10px;margin-top:4px">
                  <i class="bi bi-clock-history"></i> <%= t('admin.customers.auto_isolate.label', 'Auto Isolir') %>:
                  <span class="<%= c.auto_isolate === 0 ? 'text-danger' : 'text-success' %>">
                    <%= c.auto_isolate === 0 ? t('admin.customers.auto_isolate.off', 'OFF') : t('admin.customers.auto_isolate.date_prefix', 'Tgl ') + (c.isolate_day || 10) %>
                  </span>
                </div>
              </td>
              <td class="text-center">
                <% if (c.unpaid_count > 0) { %>
                  <span class="badge bd" style="font-weight:700;"><%= c.unpaid_count %> <%= t('admin.customers.unpaid_suffix', 'tagihan') %></span>
                <% } else { %><span class="text-muted" style="font-size:12px"><i class="bi bi-check2 text-success"></i> <%= t('admin.customers.paid_label', 'Lunas') %></span><% } %>
              </td>
              <td style="white-space:nowrap;text-align:center;">
                <!-- Clean & Ergonomic Action Group -->
                <div style="display:inline-flex;align-items:center;gap:4px;">
                  <button class="btn btn-g btn-sm" title="Lihat Detail & Koneksi" onclick="viewCustDetail(<%= i %>)" style="padding:4px 8px;font-size:11px;font-weight:600;">
                    <i class="bi bi-eye"></i> Detail
                  </button>
                  <button class="btn btn-p btn-sm" title="<%= t('admin.customers.actions.pay_invoice', 'Bayar Tagihan') %>" data-idx="<%= i %>" onclick="openPayInvoice(+this.dataset.idx)" style="padding:4px 8px;font-size:11px;font-weight:600;">
                    <i class="bi bi-cash-coin"></i> Bayar
                  </button>
                  <div class="action-dropdown">
                    <button type="button" class="action-dropdown-btn" onclick="toggleActionDropdown(this, event)" title="Aksi Lainnya">
                      <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <div class="action-dropdown-menu">
                      <% if (c.status === 'suspended') { %>
                        <form method="POST" action="/admin/customers/<%= c.id %>/unisolate" style="margin:0;" onsubmit="return confirm('Aktifkan kembali layanan untuk pelanggan ini?')">
                          <button type="submit" class="action-dropdown-item" style="color:#10b981;">
                            <i class="bi bi-play-circle"></i> Buka Isolir (Aktifkan)
                          </button>
                        </form>
                      <% } else { %>
                        <form method="POST" action="/admin/customers/<%= c.id %>/isolate" style="margin:0;" onsubmit="return confirm('Apakah Anda yakin ingin mengisolir pelanggan ini secara manual?')">
                          <button type="submit" class="action-dropdown-item" style="color:#f59e0b;">
                            <i class="bi bi-pause-circle"></i> Isolir Pelanggan
                          </button>
                        </form>
                      <% } %>
                      <button type="button" class="action-dropdown-item" onclick="openTopupModal(<%= i %>)">
                        <i class="bi bi-wallet2 text-success"></i> Kelola Saldo Dompet
                      </button>
                      <button type="button" class="action-dropdown-item" onclick="openGenInvoice(<%= i %>)">
                        <i class="bi bi-lightning-charge text-warning"></i> Generate Tagihan
                      </button>
                      <a href="/admin/customers/<%= c.id %>/sticker-onu" target="_blank" class="action-dropdown-item">
                        <i class="bi bi-qr-code text-info"></i> Cetak Stiker ONU
                      </a>
                      <button type="button" class="action-dropdown-item" onclick="editCust(<%= i %>)">
                        <i class="bi bi-pencil text-primary"></i> Edit Data Pelanggan
                      </button>
                      <% if (typeof session !== 'undefined' && session && !session.isCashier) { %>
                        <% if (c.package_id && (c.package_promo_cycles || 0) > 0) { %>
                          <form method="POST" action="/admin/customers/<%= c.id %>/billing/reset-promo-cycles" style="margin:0;" onsubmit="return confirm('Reset counter siklus promo untuk pelanggan ini?')">
                            <button type="submit" class="action-dropdown-item">
                              <i class="bi bi-arrow-counterclockwise text-secondary"></i> Reset Siklus Promo
                            </button>
                          </form>
                        <% } %>
                        <% if (c.package_id && c.install_date && c.package_prorate_first_invoice) { %>
                          <form method="POST" action="/admin/customers/<%= c.id %>/billing/install-prorata" style="margin:0;" onsubmit="return confirm('Buat tagihan susulan prorata untuk bulan pasang?')">
                            <button type="submit" class="action-dropdown-item">
                              <i class="bi bi-calendar2-check text-secondary"></i> Susulan Prorata Pasang
                            </button>
                          </form>
                        <% } %>
                      <% } %>
                      <div class="action-dropdown-divider"></div>
                      <form method="POST" action="/admin/customers/<%= c.id %>/delete" style="margin:0;" onsubmit="return confirm('Apakah Anda yakin ingin MENGHAPUS pelanggan ini? Data tidak dapat dipulihkan!')">
                        <button type="submit" class="action-dropdown-item danger-item">
                          <i class="bi bi-trash"></i> Hapus Pelanggan
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class="mo" id="addModal">
  <div class="mb" style="max-width:720px;">
    <div class="mh"><span class="mt"><i class="bi bi-person-plus"></i> Tambah Pelanggan Baru</span><button class="mc" onclick="closeModal('addModal')">&times;</button></div>
    <form method="POST" action="/admin/customers" enctype="multipart/form-data">
      <div class="mbody" style="max-height:75vh; overflow-y:auto; padding-right:6px;">
        
        <% const isRadiusActive = (typeof settings !== 'undefined' && settings && String(settings.radius_enabled) === '1'); %>
        <% if (isRadiusActive) { %>
        <!-- SECTION 1: MODE AUTENTIKASI KONEKSI (UTAMA) -->
        <div style="background: rgba(99, 102, 241, 0.08); padding: 14px 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.25); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="color:var(--primary); font-size:13px; display:flex; align-items:center; justify-content:space-between;">
            <span><i class="bi bi-cpu text-primary me-1"></i> Mode Autentikasi Pelanggan (Utama)</span>
            <span class="badge bp" style="font-size:10px; padding:3px 8px;">Diutamakan MikroTik API</span>
          </div>
          <div class="form-row" style="margin-bottom:0;" id="add_radius_select_fg">
            <div class="fg" style="margin-bottom:0;">
              <select class="fs" name="is_radius" id="add_is_radius" style="font-weight:700; height:42px;" onchange="handleAuthModeChange('add', this.value)">
                <option value="0" selected>⚡ MikroTik API (Lokal /ppp secret - Utama & Default)</option>
                <option value="1">📡 RADIUS Server (Billing Database Only)</option>
              </select>
              <small class="text-muted" style="font-size:11px; display:block; margin-top:4px;">
                Mode MikroTik API mengelola kredensial PPP langsung di menu /ppp secret RouterOS MikroTik.
              </small>
            </div>
          </div>
        </div>
        <% } else { %>
          <input type="hidden" name="is_radius" id="add_is_radius" value="0">
        <% } %>

        <!-- SECTION 2: INFORMASI PELANGGAN -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-person-vcard text-info me-1"></i> Informasi Pribadi Pelanggan</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl" style="font-weight:700;color:var(--primary);"><i class="bi bi-upc-scan"></i> Kode Pelanggan (ID)</label>
              <div style="display:flex;gap:6px;">
                <input class="fc" name="customer_code" id="add_customer_code" placeholder="Contoh: PWK010204" style="font-family:monospace;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
                <button type="button" class="btn btn-g btn-sm" onclick="triggerAutoGenerateCode('add')" title="Generate Kode & PPPoE"><i class="bi bi-magic text-primary"></i> Auto</button>
              </div>
              <small class="text-muted" style="font-size:11px;">Format: <strong>[AREA][ODC][ODP][PORT]</strong> (otomatis terisi saat Area, ODC, ODP, & Port dipilih).</small>
            </div>
            <div class="fg">
              <label class="fl"><i class="bi bi-card-text"></i> NIK / No. KTP (Opsional)</label>
              <input class="fc" name="nik" placeholder="Contoh: 3201xxxxxxxxxxxx">
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Nama Lengkap *</label><input class="fc" name="name" required placeholder="Contoh: John Doe"></div>
            <div class="fg"><label class="fl">No. Telepon / WA *</label><input class="fc" name="phone" placeholder="Contoh: 08123456789" required></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-geo-alt"></i> Area / Wilayah</label>
              <select class="fs" name="area" id="add_area" onchange="autoGenerateCustomerCode('add')">
                <option value="">-- Pilih Area --</option>
                <% if (typeof masterAreas !== 'undefined' && masterAreas && masterAreas.length > 0) { %>
                  <% masterAreas.forEach(a => { %>
                    <option value="<%= a.name %>" data-code="<%= a.code || '' %>"><%= a.name %><%= a.code ? ' [' + a.code + ']' : '' %></option>
                  <% }) %>
                <% } else if (typeof areas !== 'undefined') { %>
                  <% areas.forEach(a => { %>
                    <option value="<%= a %>"><%= a %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg"><label class="fl">Email (Notifikasi Billing)</label><input class="fc" name="email" type="email" placeholder="customer@example.com"></div>
          </div>
          <div class="fg"><label class="fl">Alamat Lengkap</label><textarea class="fc" name="address" placeholder="Jl. Raya No. 123..."></textarea></div>
        </div>

        <!-- SECTION 3: PAKET & PENGATURAN KONEKSI -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-router text-warning me-1"></i> Paket & Akses Jaringan (MikroTik / RADIUS)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Paket Internet *</label>
              <select class="fs" name="package_id" required>
                <option value="">-- Pilih Paket --</option>
                <% packages.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %> — Rp <%= p.price.toLocaleString('id-ID') %></option>
                <% }) %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Router MikroTik</label>
              <select class="fs" name="router_id" id="add_router_select" onchange="loadRouterLists('add', this.value)">
                <option value="">-- Default (Pengaturan) --</option>
                <% if (typeof routers !== 'undefined') { %>
                  <% routers.forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="fg">
              <label class="fl">Metode Koneksi</label>
              <select class="fs" name="connection_type" id="add_connection_type" onchange="toggleConnectionFields('add')">
                <option value="pppoe" selected><%= isRadiusActive ? 'PPPoE (RADIUS / MikroTik)' : 'PPPoE (MikroTik API)' %></option>
                <option value="static">Static IP (MikroTik)</option>
                <option value="hotspot">Hotspot (MikroTik)</option>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Tag ONU (GenieACS)</label>
              <input class="fc" name="genieacs_tag" placeholder="Sama dengan ID/User Pelanggan">
            </div>
          </div>

          <!-- KREDENSIAL PPPoE / RADIUS -->
          <div id="add_pppoe_field">
            <div class="form-row" style="background:rgba(59,130,246,0.04); padding:12px 14px; border-radius:10px; border:1px solid rgba(59,130,246,0.15);">
              <div class="fg">
                <label class="fl" style="font-weight:700; color:var(--primary);"><i class="bi bi-person-fill"></i> PPPoE Username *</label>
                <% if (isRadiusActive) { %>
                <div style="display:flex;gap:12px;align-items:center;margin-bottom:6px">
                  <label style="margin:0;display:flex;align-items:center;gap:4px;cursor:pointer;font-size:11px;font-weight:600;">
                    <input type="radio" name="pppoe_input_mode" value="mikrotik" checked onchange="togglePppoeInputMode('add')">
                    <span>Pilih dari MikroTik (API)</span>
                  </label>
                  <label style="margin:0;display:flex;align-items:center;gap:4px;cursor:pointer;font-size:11px;font-weight:600;">
                    <input type="radio" name="pppoe_input_mode" value="manual" onchange="togglePppoeInputMode('add')">
                    <span>Input Manual (RADIUS)</span>
                  </label>
                </div>
                <% } else { %>
                  <input type="hidden" name="pppoe_input_mode" value="mikrotik">
                <% } %>
                <div id="add_pppoe_mikrotik_input">
                  <input class="fc" name="pppoe_username" list="add_pppoe_list" placeholder="Pilih / cari username PPPoE MikroTik">
                  <datalist id="add_pppoe_list"></datalist>
                  <div class="hint" id="add_pppoe_hint"></div>
                </div>
                <div id="add_pppoe_manual_input" style="display:none">
                  <input class="fc" id="add_pppoe_username_manual" placeholder="Ketik username PPPoE baru...">
                </div>
              </div>
              <div class="fg">
                <label class="fl" style="font-weight:700; color:var(--warning);"><i class="bi bi-key-fill"></i> <%= isRadiusActive ? 'Password PPPoE / RADIUS *' : 'Password PPPoE *' %></label>
                <input class="fc" name="pppoe_password" id="add_pppoe_password" placeholder="Masukkan password PPPoE" required>
                <small class="text-muted" style="font-size:10px;display:block;margin-top:4px"><%= isRadiusActive ? 'Kredensial login modem pelanggan untuk RADIUS & PPPoE.' : 'Kredensial login modem pelanggan untuk PPPoE MikroTik API.' %></small>
              </div>
            </div>
          </div>

          <!-- STATIC IP -->
          <div class="form-row" id="add_static_field" style="display:none">
            <div class="fg">
              <label class="fl">IP Address Pelanggan</label>
              <input class="fc" name="static_ip" placeholder="Contoh: 192.168.10.10">
            </div>
          </div>

          <!-- HOTSPOT -->
          <div id="add_hotspot_field" style="display:none">
            <div class="form-row">
              <div class="fg">
                <label class="fl">Hotspot Username</label>
                <input class="fc" name="hotspot_username" placeholder="Contoh: user01">
              </div>
              <div class="fg">
                <label class="fl">Hotspot Password</label>
                <input class="fc" name="hotspot_password" placeholder="Kosong = sama dengan username">
              </div>
            </div>
            <div class="form-row">
              <div class="fg">
                <label class="fl">Hotspot User Profile</label>
                <input class="fc" name="hotspot_profile" list="add_hotspot_profile_list" placeholder="Pilih profile hotspot">
                <datalist id="add_hotspot_profile_list"></datalist>
                <div class="hint" id="add_hotspot_profile_hint"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 4: BILLING & OTOMASI -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-cash-stack text-success me-1"></i> Penagihan, Kolektor, & Status Akun</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Status Akun</label>
              <select class="fs" name="status">
                <option value="active" selected>Aktif</option>
                <option value="suspended">Suspend / Isolir</option>
                <option value="inactive">Nonaktif</option>
              </select>
            </div>
            <div class="fg"><label class="fl">Tanggal Pasang</label><input class="fc" type="date" name="install_date"></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Isolir Otomatis</label>
              <select class="fs" name="auto_isolate">
                <option value="1" selected>Aktif (Auto-Isolir Jatuh Tempo)</option>
                <option value="0">Bebas Isolir (Tidak Pernah Isolir)</option>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Tanggal Isolir (1-31)</label>
              <input class="fc" type="number" name="isolate_day" value="10" min="1" max="31">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-person-badge"></i> Kolektor Penagihan</label>
              <select class="fs" name="collector_id" id="add_collector_id">
                <option value="">-- Tanpa Kolektor --</option>
                <% if (typeof collectors !== 'undefined') { %>
                  <% collectors.forEach(col => { %>
                    <option value="<%= col.id %>" data-area="<%= col.area || '' %>"><%= col.name %> (<%= col.username %>)<%= col.area ? ' [Area: ' + col.area + ']' : '' %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Profile Isolir / Address List</label>
              <select class="fs" name="isolir_profile" id="add_isolir_select">
                <option value="isolir">isolir</option>
              </select>
            </div>
          </div>
        </div>

        <!-- SECTION 5: OPSEK & INFRASTRUKTUR (OLT, ODC, ODP, & PORT) -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-diagram-3 text-secondary me-1"></i> Infrastruktur FTTH (OLT, ODC, ODP, & Port)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Perangkat OLT</label>
              <select class="fs" name="olt_id" id="add_olt_id">
                <option value="">-- Tanpa OLT --</option>
                <% if (typeof olts !== 'undefined') { %>
                  <% olts.forEach(o => { %>
                    <option value="<%= o.id %>"><%= o.name %> (<%= o.brand %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><i class="bi bi-hdd-network text-info"></i> ODC (Optical Distribution Cabinet)</label>
              <select class="fs" name="odc_id" id="add_odc_id" onchange="handleOdcChange('add'); autoGenerateCustomerCode('add');">
                <option value="">-- Tanpa ODC --</option>
                <% if (typeof odcs !== 'undefined') { %>
                  <% odcs.forEach(o => { %>
                    <option value="<%= o.id %>" data-name="<%= o.name %>"><%= o.name %><%= o.olt_name ? ' (' + o.olt_name + ')' : '' %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-distribute-vertical text-warning"></i> ODP (Optical Distribution Point)</label>
              <select class="fs" name="odp_id" id="add_odp_id" onchange="handleOdpChange('add'); autoGenerateCustomerCode('add');">
                <option value="">-- Tanpa ODP --</option>
                <% if (typeof odps !== 'undefined') { %>
                  <% odps.forEach(o => { %>
                    <option value="<%= o.id %>" data-name="<%= o.name %>" data-odc-id="<%= o.odc_id || '' %>"><%= o.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><i class="bi bi-plug text-success"></i> Nomor Port ODP</label>
              <input class="fc" type="number" min="1" max="64" name="odp_port" id="add_odp_port" oninput="autoGenerateCustomerCode('add')" placeholder="Contoh: 1 s/d 16">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Port PON OLT (Opsional)</label>
              <input class="fc" name="pon_port" id="add_pon_port" placeholder="Contoh: PON 1/1/1">
            </div>
            <div class="fg" id="add_mac_field" style="display:none">
              <label class="fl">MAC Address (Opsional)</label>
              <input class="fc" name="mac_address" placeholder="Contoh: AA:BB:CC:DD:EE:FF">
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Latitude</label><input class="fc" name="lat" id="add_lat" placeholder="-6.xxx"></div>
            <div class="fg">
              <label class="fl">Longitude</label>
              <div style="display:flex;gap:4px">
                <input class="fc" name="lng" id="add_lng" placeholder="106.xxx">
                <button type="button" class="btn btn-g btn-sm" onclick="openPicker('add')" title="Pilih di Peta"><i class="bi bi-geo-alt"></i></button>
              </div>
            </div>
          </div>
          <div class="fg" style="margin-top:10px;"><label class="fl">Catatan</label><textarea class="fc" name="notes" placeholder="Catatan internal opsional..."></textarea></div>
        </div>

        <!-- SECTION 6: DOKUMENTASI INSTALASI & KYC BERSTANDAR ISP -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <div class="fw6" style="font-size:13px; color:var(--text);">
              <i class="bi bi-camera-fill text-primary me-1"></i> Dokumentasi Instalasi & QC Redaman (SOP ISP)
            </div>
            <span class="badge bp" style="font-size:10px; padding:3px 8px;"><i class="bi bi-patch-check me-1"></i>Commissioning Standard</span>
          </div>

          <!-- Redaman Awal (Optical Power Meter) -->
          <div style="background:var(--bg3); border:1px solid var(--border); border-radius:10px; padding:12px; margin-bottom:14px;">
            <div class="form-row" style="margin-bottom:0; align-items:center;">
              <div class="fg" style="margin-bottom:0; flex:1;">
                <label class="fl" style="font-weight:700; color:var(--text); display:flex; justify-content:space-between;">
                  <span><i class="bi bi-speedometer2 text-info me-1"></i> Redaman Awal / Rx Optical Power (dBm)</span>
                  <span id="add_rx_status_badge" class="badge" style="display:none; font-size:11px;"></span>
                </label>
                <div style="display:flex; gap:8px; align-items:center;">
                  <input class="fc" type="number" step="0.01" name="initial_rx_power" id="add_initial_rx_power" placeholder="Contoh: -19.50" oninput="updateRxBadge('add')" style="font-family:monospace; font-weight:700; font-size:14px; max-width:200px;">
                  <span style="font-size:13px; font-weight:600; color:var(--muted);">dBm</span>
                </div>
                <small class="text-muted" style="font-size:11px; display:block; margin-top:4px;">
                  Standar GPON: <strong>-15.00 dBm s/d -24.00 dBm</strong> (Ideal). Di atas -27.00 dBm dianggap redaman loss tinggi.
                </small>
              </div>
            </div>
          </div>

          <!-- Grid 3 Foto: Rumah, Pelanggan, Redaman OPM -->
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:12px;">
            
            <!-- Card 1: Foto Rumah -->
            <div style="border:1px dashed var(--border); border-radius:10px; padding:12px; background:var(--bg2); text-align:center; position:relative;">
              <div style="font-size:12px; font-weight:700; color:var(--text); margin-bottom:8px;">
                <i class="bi bi-house-door text-primary me-1"></i> Foto Rumah Pelanggan
              </div>
              <div id="add_preview_house_box" style="width:100%; height:110px; border-radius:8px; background:rgba(255,255,255,0.03); display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom:8px; border:1px solid var(--border);">
                <i class="bi bi-image text-muted" style="font-size:32px;"></i>
              </div>
              <label class="btn btn-g btn-sm w-100" style="cursor:pointer; font-size:11px; margin:0;">
                <i class="bi bi-upload me-1"></i> Upload Foto Rumah
                <input type="file" name="photo_house" accept="image/*" style="display:none" onchange="previewDocFile(this, 'add_preview_house_box')">
              </label>
              <div style="font-size:10px; color:var(--muted); margin-top:4px;">Tampak depan & nomor rumah</div>
            </div>

            <!-- Card 2: Foto Pelanggan / KYC -->
            <div style="border:1px dashed var(--border); border-radius:10px; padding:12px; background:var(--bg2); text-align:center; position:relative;">
              <div style="font-size:12px; font-weight:700; color:var(--text); margin-bottom:8px;">
                <i class="bi bi-person-bounding-box text-success me-1"></i> Foto Pelanggan / KTP
              </div>
              <div id="add_preview_customer_box" style="width:100%; height:110px; border-radius:8px; background:rgba(255,255,255,0.03); display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom:8px; border:1px solid var(--border);">
                <i class="bi bi-person-badge text-muted" style="font-size:32px;"></i>
              </div>
              <label class="btn btn-g btn-sm w-100" style="cursor:pointer; font-size:11px; margin:0;">
                <i class="bi bi-upload me-1"></i> Upload Foto Pelanggan
                <input type="file" name="photo_customer" accept="image/*" style="display:none" onchange="previewDocFile(this, 'add_preview_customer_box')">
              </label>
              <div style="font-size:10px; color:var(--muted); margin-top:4px;">Verifikasi identitas / KTP</div>
            </div>

            <!-- Card 3: Foto Layar OPM Redaman -->
            <div style="border:1px dashed var(--border); border-radius:10px; padding:12px; background:var(--bg2); text-align:center; position:relative;">
              <div style="font-size:12px; font-weight:700; color:var(--text); margin-bottom:8px;">
                <i class="bi bi-broadcast-pin text-warning me-1"></i> Foto Redaman OPM
              </div>
              <div id="add_preview_optical_box" style="width:100%; height:110px; border-radius:8px; background:rgba(255,255,255,0.03); display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom:8px; border:1px solid var(--border);">
                <i class="bi bi-activity text-muted" style="font-size:32px;"></i>
              </div>
              <label class="btn btn-g btn-sm w-100" style="cursor:pointer; font-size:11px; margin:0;">
                <i class="bi bi-upload me-1"></i> Upload Foto OPM
                <input type="file" name="photo_optical_power" accept="image/*" style="display:none" onchange="previewDocFile(this, 'add_preview_optical_box')">
              </label>
              <div style="font-size:10px; color:var(--muted); margin-top:4px;">Layar Optical Power Meter saat QC</div>
            </div>

          </div>
        </div>

      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Simpan Pelanggan</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Import -->
<div class="mo" id="importModal">
  <div class="mb" style="max-width:400px">
    <div class="mh"><span class="mt"><i class="bi bi-file-earmark-arrow-up"></i> Import Pelanggan</span><button class="mc" onclick="closeModal('importModal')">&times;</button></div>
    <form method="POST" action="/admin/customers/import" enctype="multipart/form-data">
      <div class="mbody">
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px">
          Unggah file Excel (.xlsx). Pastikan format kolom sesuai dengan hasil Export.
          <br><br>
          <a href="/admin/customers/export" style="color:var(--primary);text-decoration:none"><i class="bi bi-download"></i> Unduh format excel</a>
        </p>
        <div class="fg">
          <label class="fl">Pilih File Excel</label>
          <input type="file" name="file" class="fc" accept=".xlsx" required>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('importModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-upload"></i> Mulai Impor</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit -->
<div class="mo" id="editModal">
  <div class="mb" style="max-width:720px;">
    <div class="mh"><span class="mt"><i class="bi bi-pencil"></i> Edit Pelanggan</span><button class="mc" onclick="closeModal('editModal')">&times;</button></div>
    <form method="POST" id="editForm" enctype="multipart/form-data">
      <div class="mbody" style="max-height:75vh; overflow-y:auto; padding-right:6px;">
        
        <% if (isRadiusActive) { %>
        <!-- SECTION 1: MODE AUTENTIKASI KONEKSI (UTAMA) -->
        <div style="background: rgba(99, 102, 241, 0.08); padding: 14px 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.25); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="color:var(--primary); font-size:13px; display:flex; align-items:center; justify-content:space-between;">
            <span><i class="bi bi-cpu text-primary me-1"></i> Mode Autentikasi Pelanggan (Utama)</span>
            <span class="badge bp" style="font-size:10px; padding:3px 8px;">Diutamakan MikroTik API</span>
          </div>
          <div class="form-row" style="margin-bottom:0;" id="e_radius_select_fg">
            <div class="fg" style="margin-bottom:0;">
              <select class="fs" name="is_radius" id="e_is_radius" style="font-weight:700; height:42px;" onchange="handleAuthModeChange('edit', this.value)">
                <option value="0">⚡ MikroTik API (Lokal /ppp secret - Utama & Default)</option>
                <option value="1">📡 RADIUS Server (Billing Database Only)</option>
              </select>
              <small class="text-muted" style="font-size:11px; display:block; margin-top:4px;">
                Mode MikroTik API mengelola kredensial PPP langsung di menu /ppp secret RouterOS MikroTik.
              </small>
            </div>
          </div>
        </div>
        <% } else { %>
          <input type="hidden" name="is_radius" id="e_is_radius" value="0">
        <% } %>

        <!-- SECTION 2: INFORMASI PELANGGAN -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-person-vcard text-info me-1"></i> Informasi Pribadi Pelanggan</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl" style="font-weight:700;color:var(--primary);"><i class="bi bi-upc-scan"></i> Kode Pelanggan (ID)</label>
              <div style="display:flex;gap:6px;">
                <input class="fc" name="customer_code" id="e_customer_code" placeholder="Contoh: PWK010204" style="font-family:monospace;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
                <button type="button" class="btn btn-g btn-sm" onclick="triggerAutoGenerateCode('edit')" title="Generate Kode dari Area/ODP/Port"><i class="bi bi-magic text-primary"></i> Auto</button>
              </div>
              <small class="text-muted" style="font-size:11px;">Format: <strong>[AREA][ODC][ODP][PORT]</strong> (otomatis terisi saat Area, ODC, ODP, & Port dipilih).</small>
            </div>
            <div class="fg">
              <label class="fl"><i class="bi bi-card-text"></i> NIK / No. KTP (Opsional)</label>
              <input class="fc" name="nik" id="e_nik" placeholder="Contoh: 3201xxxxxxxxxxxx">
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Nama Lengkap *</label><input class="fc" name="name" id="e_name" required></div>
            <div class="fg"><label class="fl">No. Telepon / WA *</label><input class="fc" name="phone" id="e_phone" required></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-geo-alt"></i> Area / Wilayah</label>
              <select class="fs" name="area" id="e_area" onchange="autoGenerateCustomerCode('edit')">
                <option value="">-- Pilih Area --</option>
                <% if (typeof masterAreas !== 'undefined' && masterAreas && masterAreas.length > 0) { %>
                  <% masterAreas.forEach(a => { %>
                    <option value="<%= a.name %>" data-code="<%= a.code || '' %>"><%= a.name %><%= a.code ? ' [' + a.code + ']' : '' %></option>
                  <% }) %>
                <% } else if (typeof areas !== 'undefined') { %>
                  <% areas.forEach(a => { %>
                    <option value="<%= a %>"><%= a %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg"><label class="fl">Email (Notifikasi Billing)</label><input class="fc" name="email" id="e_email" type="email"></div>
          </div>
          <div class="fg"><label class="fl">Alamat Lengkap</label><textarea class="fc" name="address" id="e_address"></textarea></div>
        </div>

        <!-- SECTION 3: PAKET & PENGATURAN KONEKSI -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-router text-warning me-1"></i> Paket & Akses Jaringan (MikroTik / RADIUS)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Paket Internet *</label>
              <select class="fs" name="package_id" id="e_package" required>
                <option value="">-- Pilih Paket --</option>
                <% packages.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %> — Rp <%= p.price.toLocaleString('id-ID') %></option>
                <% }) %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Router MikroTik</label>
              <select class="fs" name="router_id" id="e_router_id" onchange="loadRouterLists('edit', this.value)">
                <option value="">-- Default (Pengaturan) --</option>
                <% if (typeof routers !== 'undefined') { %>
                  <% routers.forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.name %> (<%= r.host %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="fg">
              <label class="fl">Metode Koneksi</label>
              <select class="fs" name="connection_type" id="e_connection_type" onchange="toggleConnectionFields('edit')">
                <option value="pppoe"><%= isRadiusActive ? 'PPPoE (RADIUS / MikroTik)' : 'PPPoE (MikroTik API)' %></option>
                <option value="static">Static IP (MikroTik)</option>
                <option value="hotspot">Hotspot (MikroTik)</option>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Tag ONU (GenieACS)</label>
              <input class="fc" name="genieacs_tag" id="e_tag">
            </div>
          </div>

          <!-- KREDENSIAL PPPoE / RADIUS -->
          <div id="e_pppoe_field">
            <div class="form-row" style="background:rgba(59,130,246,0.04); padding:12px 14px; border-radius:10px; border:1px solid rgba(59,130,246,0.15);">
              <div class="fg">
                <label class="fl" style="font-weight:700; color:var(--primary);"><i class="bi bi-person-fill"></i> PPPoE Username *</label>
                <input class="fc" name="pppoe_username" id="e_pppoe" list="e_pppoe_list" placeholder="PPPoE Username" required>
                <datalist id="e_pppoe_list"></datalist>
                <div class="hint" id="e_pppoe_hint"></div>
              </div>
              <div class="fg">
                <label class="fl" style="font-weight:700; color:var(--warning);"><i class="bi bi-key-fill"></i> Password PPPoE / RADIUS *</label>
                <input class="fc" name="pppoe_password" id="e_pppoe_password" placeholder="Masukkan password PPPoE" required>
                <small class="text-muted" style="font-size:10px;display:block;margin-top:4px">Kredensial login modem pelanggan untuk RADIUS & PPPoE.</small>
              </div>
            </div>
          </div>

          <!-- STATIC IP -->
          <div class="form-row" id="e_static_field" style="display:none">
            <div class="fg">
              <label class="fl">IP Address Pelanggan</label>
              <input class="fc" name="static_ip" id="e_static_ip" placeholder="Contoh: 192.168.10.10">
            </div>
          </div>

          <!-- HOTSPOT -->
          <div id="e_hotspot_field" style="display:none">
            <div class="form-row">
              <div class="fg">
                <label class="fl">Hotspot Username</label>
                <input class="fc" name="hotspot_username" id="e_hotspot_username" placeholder="Contoh: user01">
              </div>
              <div class="fg">
                <label class="fl">Hotspot Password</label>
                <input class="fc" name="hotspot_password" id="e_hotspot_password" placeholder="Kosong = sama dengan username">
              </div>
            </div>
            <div class="form-row">
              <div class="fg">
                <label class="fl">Hotspot User Profile</label>
                <input class="fc" name="hotspot_profile" id="e_hotspot_profile" list="e_hotspot_profile_list" placeholder="Pilih profile hotspot">
                <datalist id="e_hotspot_profile_list"></datalist>
                <div class="hint" id="e_hotspot_profile_hint"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 4: BILLING & OTOMASI -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-cash-stack text-success me-1"></i> Penagihan, Kolektor, & Status Akun</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Status Akun</label>
              <select class="fs" name="status" id="e_status">
                <option value="active">Aktif</option>
                <option value="suspended">Suspend / Isolir</option>
                <option value="inactive">Nonaktif</option>
              </select>
            </div>
            <div class="fg"><label class="fl">Tanggal Pasang</label><input class="fc" type="date" name="install_date" id="e_install"></div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Isolir Otomatis</label>
              <select class="fs" name="auto_isolate" id="e_auto_isolate">
                <option value="1">Aktif (Auto-Isolir Jatuh Tempo)</option>
                <option value="0">Bebas Isolir (Tidak Pernah Isolir)</option>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Tanggal Isolir (Pascabayar)</label>
              <input class="fc" type="number" name="isolate_day" id="e_isolate_day" min="1" max="31">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-hourglass-split text-warning me-1"></i> Masa Aktif / Expired Date (Khusus Prabayar)</label>
              <input class="fc" type="date" name="expired_at" id="e_expired_at">
              <small class="text-muted" style="font-size:10px;display:block;margin-top:2px;">Otomatis dihitung saat pasang/bayar. Bisa disesuaikan manual jika perlu.</small>
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-person-badge"></i> Kolektor Penagihan</label>
              <select class="fs" name="collector_id" id="e_collector_id">
                <option value="">-- Tanpa Kolektor --</option>
                <% if (typeof collectors !== 'undefined') { %>
                  <% collectors.forEach(col => { %>
                    <option value="<%= col.id %>" data-area="<%= col.area || '' %>"><%= col.name %> (<%= col.username %>)<%= col.area ? ' [Area: ' + col.area + ']' : '' %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl">Profile Isolir / Address List</label>
              <select class="fs" name="isolir_profile" id="e_isolir_profile">
                <option value="isolir">isolir</option>
              </select>
            </div>
          </div>
        </div>

        <!-- SECTION 5: OPSEK & INFRASTRUKTUR (OLT, ODC, ODP, & PORT) -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div class="fw6 mb-2" style="font-size:13px; color:var(--text);"><i class="bi bi-diagram-3 text-secondary me-1"></i> Infrastruktur FTTH (OLT, ODC, ODP, & Port)</div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Perangkat OLT</label>
              <select class="fs" name="olt_id" id="e_olt_id">
                <option value="">-- Tanpa OLT --</option>
                <% if (typeof olts !== 'undefined') { %>
                  <% olts.forEach(o => { %>
                    <option value="<%= o.id %>"><%= o.name %> (<%= o.brand %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><i class="bi bi-hdd-network text-info"></i> ODC (Optical Distribution Cabinet)</label>
              <select class="fs" name="odc_id" id="e_odc_id" onchange="handleOdcChange('edit'); autoGenerateCustomerCode('edit');">
                <option value="">-- Tanpa ODC --</option>
                <% if (typeof odcs !== 'undefined') { %>
                  <% odcs.forEach(o => { %>
                    <option value="<%= o.id %>" data-name="<%= o.name %>"><%= o.name %><%= o.olt_name ? ' (' + o.olt_name + ')' : '' %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><i class="bi bi-distribute-vertical text-warning"></i> ODP (Optical Distribution Point)</label>
              <select class="fs" name="odp_id" id="e_odp_id" onchange="handleOdpChange('edit'); autoGenerateCustomerCode('edit');">
                <option value="">-- Tanpa ODP --</option>
                <% if (typeof odps !== 'undefined') { %>
                  <% odps.forEach(o => { %>
                    <option value="<%= o.id %>" data-name="<%= o.name %>" data-odc-id="<%= o.odc_id || '' %>"><%= o.name %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="fg">
              <label class="fl"><i class="bi bi-plug text-success"></i> Nomor Port ODP</label>
              <input class="fc" type="number" min="1" max="64" name="odp_port" id="e_odp_port" oninput="autoGenerateCustomerCode('edit')" placeholder="Contoh: 1 s/d 16">
            </div>
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl">Port PON OLT (Opsional)</label>
              <input class="fc" name="pon_port" id="e_pon_port" placeholder="Contoh: PON 1/1/1">
            </div>
            <div class="fg" id="e_mac_field" style="display:none">
              <label class="fl">MAC Address (Opsional)</label>
              <input class="fc" name="mac_address" id="e_mac_address" placeholder="Contoh: AA:BB:CC:DD:EE:FF">
            </div>
          </div>
          <div class="form-row">
            <div class="fg"><label class="fl">Latitude</label><input class="fc" name="lat" id="e_lat" placeholder="-6.xxx"></div>
            <div class="fg">
              <label class="fl">Longitude</label>
              <div style="display:flex;gap:4px">
                <input class="fc" name="lng" id="e_lng" placeholder="106.xxx">
                <button type="button" class="btn btn-g btn-sm" onclick="openPicker('edit')" title="Pilih di Peta"><i class="bi bi-geo-alt"></i></button>
              </div>
            </div>
          </div>
          <div class="fg" style="margin-top:10px;"><label class="fl">Catatan</label><textarea class="fc" name="notes" id="e_notes" placeholder="Catatan internal opsional..."></textarea></div>
        </div>

        <!-- SECTION 6: DOKUMENTASI INSTALASI & KYC BERSTANDAR ISP -->
        <div style="background: rgba(255, 255, 255, 0.02); padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <div class="fw6" style="font-size:13px; color:var(--text);">
              <i class="bi bi-camera-fill text-primary me-1"></i> Dokumentasi Instalasi & QC Redaman (SOP ISP)
            </div>
            <span class="badge bp" style="font-size:10px; padding:3px 8px;"><i class="bi bi-patch-check me-1"></i>Commissioning Standard</span>
          </div>

          <!-- Redaman Awal (Optical Power Meter) -->
          <div style="background:var(--bg3); border:1px solid var(--border); border-radius:10px; padding:12px; margin-bottom:14px;">
            <div class="form-row" style="margin-bottom:0; align-items:center;">
              <div class="fg" style="margin-bottom:0; flex:1;">
                <label class="fl" style="font-weight:700; color:var(--text); display:flex; justify-content:space-between;">
                  <span><i class="bi bi-speedometer2 text-info me-1"></i> Redaman Awal / Rx Optical Power (dBm)</span>
                  <span id="e_rx_status_badge" class="badge" style="display:none; font-size:11px;"></span>
                </label>
                <div style="display:flex; gap:8px; align-items:center;">
                  <input class="fc" type="number" step="0.01" name="initial_rx_power" id="e_initial_rx_power" placeholder="Contoh: -19.50" oninput="updateRxBadge('edit')" style="font-family:monospace; font-weight:700; font-size:14px; max-width:200px;">
                  <span style="font-size:13px; font-weight:600; color:var(--muted);">dBm</span>
                </div>
                <small class="text-muted" style="font-size:11px; display:block; margin-top:4px;">
                  Standar GPON: <strong>-15.00 dBm s/d -24.00 dBm</strong> (Ideal). Di atas -27.00 dBm dianggap redaman loss tinggi.
                </small>
              </div>
            </div>
          </div>

          <!-- Grid 3 Foto: Rumah, Pelanggan, Redaman OPM -->
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:12px;">
            
            <!-- Card 1: Foto Rumah -->
            <div style="border:1px dashed var(--border); border-radius:10px; padding:12px; background:var(--bg2); text-align:center; position:relative;">
              <div style="font-size:12px; font-weight:700; color:var(--text); margin-bottom:8px;">
                <i class="bi bi-house-door text-primary me-1"></i> Foto Rumah Pelanggan
              </div>
              <div id="e_preview_house_box" style="width:100%; height:110px; border-radius:8px; background:rgba(255,255,255,0.03); display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom:8px; border:1px solid var(--border);">
                <i class="bi bi-image text-muted" style="font-size:32px;"></i>
              </div>
              <label class="btn btn-g btn-sm w-100" style="cursor:pointer; font-size:11px; margin:0;">
                <i class="bi bi-upload me-1"></i> Ganti Foto Rumah
                <input type="file" name="photo_house" accept="image/*" style="display:none" onchange="previewDocFile(this, 'e_preview_house_box')">
              </label>
              <div style="font-size:10px; color:var(--muted); margin-top:4px;">Tampak depan & nomor rumah</div>
            </div>

            <!-- Card 2: Foto Pelanggan / KYC -->
            <div style="border:1px dashed var(--border); border-radius:10px; padding:12px; background:var(--bg2); text-align:center; position:relative;">
              <div style="font-size:12px; font-weight:700; color:var(--text); margin-bottom:8px;">
                <i class="bi bi-person-bounding-box text-success me-1"></i> Foto Pelanggan / KTP
              </div>
              <div id="e_preview_customer_box" style="width:100%; height:110px; border-radius:8px; background:rgba(255,255,255,0.03); display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom:8px; border:1px solid var(--border);">
                <i class="bi bi-person-badge text-muted" style="font-size:32px;"></i>
              </div>
              <label class="btn btn-g btn-sm w-100" style="cursor:pointer; font-size:11px; margin:0;">
                <i class="bi bi-upload me-1"></i> Ganti Foto Pelanggan
                <input type="file" name="photo_customer" accept="image/*" style="display:none" onchange="previewDocFile(this, 'e_preview_customer_box')">
              </label>
              <div style="font-size:10px; color:var(--muted); margin-top:4px;">Verifikasi identitas / KTP</div>
            </div>

            <!-- Card 3: Foto Layar OPM Redaman -->
            <div style="border:1px dashed var(--border); border-radius:10px; padding:12px; background:var(--bg2); text-align:center; position:relative;">
              <div style="font-size:12px; font-weight:700; color:var(--text); margin-bottom:8px;">
                <i class="bi bi-broadcast-pin text-warning me-1"></i> Foto Redaman OPM
              </div>
              <div id="e_preview_optical_box" style="width:100%; height:110px; border-radius:8px; background:rgba(255,255,255,0.03); display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom:8px; border:1px solid var(--border);">
                <i class="bi bi-activity text-muted" style="font-size:32px;"></i>
              </div>
              <label class="btn btn-g btn-sm w-100" style="cursor:pointer; font-size:11px; margin:0;">
                <i class="bi bi-upload me-1"></i> Ganti Foto OPM
                <input type="file" name="photo_optical_power" accept="image/*" style="display:none" onchange="previewDocFile(this, 'e_preview_optical_box')">
              </label>
              <div style="font-size:10px; color:var(--muted); margin-top:4px;">Layar Optical Power Meter saat QC</div>
            </div>

          </div>
        </div>

      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> Update Pelanggan</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Generate Tagihan (Per Pelanggan) -->
<div class="mo" id="genInvoiceModal">
  <div class="mb" style="max-width:520px">
    <div class="mh"><span class="mt"><i class="bi bi-lightning-charge"></i> <%= t('admin.customers.generate_invoice_title', 'Generate Tagihan (Pelanggan)') %></span><button class="mc" onclick="closeModal('genInvoiceModal')">&times;</button></div>
    <form method="POST" id="genInvoiceForm">
      <div class="mbody">
        <div class="alert alert-i"><i class="bi bi-info-circle"></i> <%= t('admin.customers.generate_invoice_hint', 'Tagihan hanya dibuat untuk pelanggan yang dipilih. Jika sudah ada, tidak akan dibuat ulang.') %></div>
        <div class="fg">
          <label class="fl"><%= t('admin.customers.generate_invoice_customer', 'Pelanggan') %></label>
          <input class="fc" id="genInvoiceCustomer" readonly>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl"><%= t('admin.billing.month', 'Bulan') %></label>
            <select class="fs" name="month" required>
              <% const genMns = (lang === 'en')
                ? ['January','February','March','April','May','June','July','August','September','October','November','December']
                : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
                 for(let m=1;m<=12;m++){%>
              <option value="<%= m %>" <%= m===new Date().getMonth()+1?'selected':'' %>><%= genMns[m-1] %></option>
              <% } %>
            </select>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.billing.year', 'Tahun') %></label>
            <select class="fs" name="year" required>
              <% for(let y=new Date().getFullYear()+1; y>=2023; y--){ %>
              <option value="<%= y %>" <%= y===new Date().getFullYear() ? 'selected' : '' %>><%= y %></option>
              <% } %>
            </select>
          </div>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('genInvoiceModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-lightning-charge"></i> <%= t('admin.customers.generate_invoice_btn', 'Generate') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Bayar Tagihan (Per Pelanggan) -->
<div class="mo" id="payInvoiceModal">
  <div class="mb" style="max-width:560px">
    <div class="mh"><span class="mt"><i class="bi bi-cash-coin"></i> <%= t('admin.customers.pay_invoice_title', 'Bayar Tagihan (Pelanggan)') %></span><button class="mc" onclick="closeModal('payInvoiceModal')">&times;</button></div>
    <form method="POST" id="payInvoiceForm">
      <div class="mbody">
        <div class="alert alert-i"><i class="bi bi-info-circle"></i> <%= t('admin.customers.pay_invoice_hint', 'Untuk pembayaran di muka: pilih periode. Jika tagihan belum ada, sistem akan membuat tagihan lalu langsung menandai Lunas.') %></div>
        <div id="payInvoicePaidSummary" style="margin:-2px 0 12px 0;color:rgba(148,163,184,1);font-size:12px"></div>
        <div id="payInvoiceTotal" style="margin:-2px 0 14px 0;padding:10px 12px;border:1px solid rgba(148,163,184,.25);border-radius:12px;background:rgba(15,23,42,0.28);font-weight:700"></div>
        <div class="fg">
          <label class="fl"><%= t('admin.customers.pay_invoice_customer', 'Pelanggan') %></label>
          <input class="fc" id="payInvoiceCustomer" readonly>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl"><%= t('admin.billing.month', 'Bulan') %></label>
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
              <% const payMns = (lang === 'en')
                ? ['January','February','March','April','May','June','July','August','September','October','November','December']
                : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
                 for(let m=1;m<=12;m++){%>
              <label style="display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid rgba(148,163,184,.25);border-radius:12px;cursor:pointer">
                <input type="checkbox" class="pay-month" name="months" value="<%= m %>" <%= m===new Date().getMonth()+1?'checked':'' %> style="width:16px;height:16px">
                <span style="font-size:13px"><%= payMns[m-1] %></span>
                <span class="pay-month-badge" style="margin-left:auto;font-size:11px;padding:3px 8px;border-radius:999px;background:rgba(34,197,94,.12);color:rgba(34,197,94,1);display:none"><%= t('admin.customers.paid_badge', 'Lunas') %></span>
              </label>
              <% } %>
            </div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.billing.year', 'Tahun') %></label>
            <select class="fs" name="year" id="payInvoiceYear" required>
              <% for(let y=new Date().getFullYear()+1; y>=2023; y--){ %>
              <option value="<%= y %>" <%= y===new Date().getFullYear() ? 'selected' : '' %>><%= y %></option>
              <% } %>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl"><%= t('admin.billing.received_by', 'Diterima Oleh') %></label>
            <% const payByDefault = (typeof session !== 'undefined' && session && session.isCashier)
              ? (`Kasir ${(session.cashierName || '').trim()}` + ((session.cashierUsername || '').trim() ? ` (@${String(session.cashierUsername).trim()})` : '')).trim()
              : 'Admin'; %>
            <input class="fc" name="paid_by_name" value="<%= payByDefault || 'Admin' %>" placeholder="<%= t('admin.billing.received_by_placeholder', 'Nama petugas / teknisi') %>">
          </div>
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.billing.notes_optional', 'Catatan (opsional)') %></label>
          <textarea class="fc" name="notes" placeholder="<%= t('admin.customers.pay_invoice_notes_placeholder', 'Contoh: Bayar di muka') %>"></textarea>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('payInvoiceModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('admin.customers.pay_invoice_btn', 'Bayar') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Map Picker -->
<div class="mo" id="mapPickerModal">
  <div class="mb" style="max-width:800px">
    <div class="mh"><span class="mt"><i class="bi bi-geo-alt"></i> Pilih Lokasi Pelanggan</span><button class="mc" onclick="closeModal('mapPickerModal')">&times;</button></div>
    <div class="mbody">
      <div id="picker-map"></div>
      <div class="alert alert-i" style="margin-bottom:0">
        <i class="bi bi-info-circle"></i> Geser penanda (marker) atau klik pada peta untuk menentukan lokasi yang akurat.
      </div>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-p" onclick="closeModal('mapPickerModal')">Selesai</button>
    </div>
  </div>
</div>

<!-- Modal Detail & Koneksi Pelanggan (Professional Modern Redesign) -->
<div class="mo" id="viewDetailModal">
  <div class="mb" style="max-width:780px; width:95vw; border-radius:18px; padding:0; overflow:hidden; border:1px solid var(--border); box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
    
    <!-- Header Hero Profile Banner -->
    <div style="background:linear-gradient(135deg, rgba(0,82,204,0.12), rgba(56,189,248,0.08)); padding:20px 24px; border-bottom:1px solid var(--border); position:relative;">
      <button type="button" class="mc" onclick="closeModal('viewDetailModal')" style="position:absolute; right:18px; top:18px; font-size:24px; border:none; background:transparent; color:var(--muted); cursor:pointer;">&times;</button>
      
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; padding-right:32px;">
        <div style="display:flex; align-items:center; gap:14px;">
          <div style="width:48px; height:48px; border-radius:14px; background:linear-gradient(135deg, var(--primary), #0284c7); color:#fff; display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:800; box-shadow:0 4px 14px rgba(0,82,204,0.35);">
