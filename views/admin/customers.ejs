        <div style="width:38px; height:38px; border-radius:10px; background:linear-gradient(135deg, rgba(99,102,241,0.2), rgba(168,85,247,0.2)); border:1px solid rgba(99,102,241,0.4); display:flex; align-items:center; justify-content:center; color:var(--primary); font-size:18px;">
