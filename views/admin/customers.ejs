function setPppoeSourceMode(target, mode) {
  const srcInput = document.getElementById(target + '_pppoe_source');
  const btnNew = document.getElementById('btn_mode_pppoe_new');
  const btnMikrotik = document.getElementById('btn_mode_pppoe_mikrotik');
  const badge = document.getElementById(target + '_pppoe_mode_badge');

  if (srcInput) srcInput.value = mode;

  if (mode === 'mikrotik') {
    if (btnNew) {
      btnNew.style.background = 'transparent';
      btnNew.style.color = 'var(--text)';
      btnNew.classList.add('btn-g');
    }
    if (btnMikrotik) {
      btnMikrotik.style.background = 'var(--primary)';
      btnMikrotik.style.color = '#fff';
      btnMikrotik.classList.remove('btn-g');
