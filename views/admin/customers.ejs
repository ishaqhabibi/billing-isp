async function loadCustomerInvoices(customerId) {
  const loadingEl = document.getElementById('v_invoices_loading');
  const contentEl = document.getElementById('v_invoices_content');
  const tbody = document.getElementById('v_invoices_tbody');
  if (!tbody) return;
  if (loadingEl) loadingEl.style.display = 'block';
  if (contentEl) contentEl.style.display = 'none';
  tbody.innerHTML = '';
  try {
    const res = await fetch('/admin/api/customers/' + customerId + '/invoices');
    const data = await res.json();
    if (data.ok && Array.isArray(data.invoices) && data.invoices.length > 0) {
      const months = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
      tbody.innerHTML = data.invoices.map(inv => {
        const isPaid = inv.status === 'paid';
        const mStr = (months[inv.period_month - 1] || inv.period_month) + ' ' + inv.period_year;
        const amountStr = 'Rp ' + Number(inv.amount || 0).toLocaleString('id-ID');
        const badgeClass = isPaid ? 'bs' : 'bd';
        const badgeText = isPaid ? 'Lunas' : 'Belum Bayar';
        const extraInfo = isPaid 
          ? ('Dibayar: ' + (inv.paid_at ? String(inv.paid_at).slice(0, 10) : '-') + (inv.paid_by ? (' (' + inv.paid_by + ')') : ''))
          : '<span style="color:#ef4444;font-weight:600;"><i class="bi bi-clock-history"></i> Menunggak</span>';
        return `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
            <td style="padding:9px 10px;font-weight:700;">${mStr}</td>
            <td style="padding:9px 10px;font-family:monospace;color:var(--primary);">${inv.invoice_number || '-'}</td>
            <td style="padding:9px 10px;font-weight:700;">${amountStr}</td>
            <td style="padding:9px 10px;"><span class="badge ${badgeClass}">${badgeText}</span></td>
            <td style="padding:9px 10px;color:var(--muted);">${extraInfo}</td>
          </tr>
        `;
      }).join('');
    } else {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:24px;color:var(--muted);">Belum ada riwayat tagihan untuk pelanggan ini.</td></tr>`;
    }
  } catch (e) {
    tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:24px;color:#ef4444;">Gagal memuat tagihan: ${e.message}</td></tr>`;
  } finally {
    if (loadingEl) loadingEl.style.display = 'none';
    if (contentEl) contentEl.style.display = 'block';
  }
}

