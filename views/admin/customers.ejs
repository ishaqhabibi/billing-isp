        <button type="button" class="cust-detail-tab-btn active" id="tab_btn_conn" onclick="switchCustDetailTab('conn', this)">
          <i class="bi bi-router me-1"></i> Koneksi & MikroTik
        </button>
        <button type="button" class="cust-detail-tab-btn" id="tab_btn_wifi" onclick="switchCustDetailTab('wifi', this)">
          <i class="bi bi-wifi me-1"></i> Modem & Wi-Fi (ACS)
          <span id="v_tab_cpe_dot" style="display:none; width:7px; height:7px; border-radius:50%; background:#10b981; margin-left:4px;"></span>
        </button>
        <button type="button" class="cust-detail-tab-btn" id="tab_btn_profile" onclick="switchCustDetailTab('profile', this)">
          <i class="bi bi-person-vcard me-1"></i> Data Pelanggan
        </button>
      </div>
    </div>

    <!-- Modal Body Content -->
    <div class="mbody" style="padding:20px 24px; max-height:60vh; overflow-y:auto;">
      
