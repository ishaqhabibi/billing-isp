    return `
      <tr style="border-bottom:1px solid var(--border);">
        <td style="padding:10px; font-weight:700; font-family:monospace; color:var(--primary);">${uName}</td>
        <td style="padding:10px;"><span class="badge bp" style="font-size:10px;">${s.profile || 'default'}</span></td>
        <td style="padding:10px; font-family:monospace;">${ipAddr}</td>
        <td style="padding:10px; color:var(--muted);">${s.comment || '-'}</td>
        <td style="padding:10px; text-align:center;">
          <button type="button" class="btn btn-p btn-sm" style="font-size:11px; padding:3px 10px;" onclick="applySecretToForm('${nameEsc}', '${passEsc}', '${rId}')">
            <i class="bi bi-check2 me-1"></i> Pilih
          </button>
        </td>
      </tr>
    `;
  }).join('');
