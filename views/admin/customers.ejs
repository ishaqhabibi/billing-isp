    if (document.getElementById('v_username')) document.getElementById('v_username').textContent = c.pppoe_username || c.hotspot_username || '-';
    if (document.getElementById('v_password')) document.getElementById('v_password').textContent = c.pppoe_password || c.hotspot_password || '-';
    if (document.getElementById('v_ip')) document.getElementById('v_ip').textContent = (session && session.ip) ? session.ip : (c.static_ip || '-');
    if (document.getElementById('v_mac')) document.getElementById('v_mac').textContent = (session && session.callerId) ? session.callerId : (c.mac_address || '-');
    
    const routerObj = (routersData || []).find(r => Number(r.id) === Number(c.router_id));
    if (document.getElementById('v_router_name')) document.getElementById('v_router_name').textContent = routerObj ? routerObj.name : (c.router_id ? ('Router #' + c.router_id) : '-');
    if (document.getElementById('v_conn_type')) document.getElementById('v_conn_type').textContent = (c.connection_type || 'pppoe').toUpperCase();
    if (document.getElementById('v_uptime')) document.getElementById('v_uptime').textContent = session ? (session.uptime || 'Active') : 'Tidak Terhubung (Offline)';

    const rxBytes = session && session.bytesIn ? session.bytesIn : (c.bytes_in || 0);
    const txBytes = session && session.bytesOut ? session.bytesOut : (c.bytes_out || 0);
    const totalBytes = rxBytes + txBytes;

    if (document.getElementById('v_rx_fmt')) document.getElementById('v_rx_fmt').textContent = formatBytesVal(rxBytes);
    if (document.getElementById('v_rx_bytes')) document.getElementById('v_rx_bytes').textContent = Number(rxBytes).toLocaleString('id-ID') + ' Bytes';
    if (document.getElementById('v_tx_fmt')) document.getElementById('v_tx_fmt').textContent = formatBytesVal(txBytes);
    if (document.getElementById('v_tx_bytes')) document.getElementById('v_tx_bytes').textContent = Number(txBytes).toLocaleString('id-ID') + ' Bytes';
    
    const limitGB = c.fup_limit_gb || 0;
    const useFup = c.use_fup === 1;
    const fupText = formatBytesVal(totalBytes) + (useFup && limitGB > 0 ? ` (Limit FUP: ${limitGB} GB)` : ' (Unlimited)');
    if (document.getElementById('v_total_fup')) document.getElementById('v_total_fup').textContent = fupText;

    if (document.getElementById('v_nik')) document.getElementById('v_nik').textContent = c.nik || '-';
    if (document.getElementById('v_phone')) document.getElementById('v_phone').textContent = c.phone || '-';
    if (document.getElementById('v_address_area')) document.getElementById('v_address_area').textContent = (c.address || '-') + (c.area ? ` [Area: ${c.area}]` : '');
    if (document.getElementById('v_package')) document.getElementById('v_package').textContent = c.package_name ? `${c.package_name} (Rp ${Number(c.package_price||0).toLocaleString('id-ID')})` : '-';
    if (document.getElementById('v_expired_at')) {
      if (c.package_billing_type === 'prepaid' || c.expired_at) {
        const expStr = c.expired_at ? String(c.expired_at).slice(0, 10) : '-';
        const isExp = c.expired_at ? (new Date(c.expired_at) < new Date()) : false;
        document.getElementById('v_expired_at').innerHTML = `
          <span class="badge ${isExp ? 'bd' : 'bs'}" style="font-weight:700;">
            <i class="bi bi-clock-history"></i> ${expStr} ${isExp ? '(Expired / Terisolir)' : '(Aktif)'}
          </span>
        `;
      } else {
        document.getElementById('v_expired_at').textContent = 'Pascabayar (Bulanan Kalender)';
      }
    }
    if (document.getElementById('v_genieacs')) document.getElementById('v_genieacs').textContent = c.genieacs_tag || '-';
    if (document.getElementById('v_status_account')) document.getElementById('v_status_account').textContent = `Status: ${c.status || 'active'} | Auto Isolir: ${c.auto_isolate === 0 ? 'Nonaktif' : 'Aktif (Tgl ' + (c.isolate_day || '-') + ')'}`;
    if (document.getElementById('v_balance')) document.getElementById('v_balance').textContent = 'Rp ' + Number(c.balance || 0).toLocaleString('id-ID');

    if (document.getElementById('v_disconnect_form')) {
      document.getElementById('v_disconnect_form').action = '/admin/customers/' + c.id + '/disconnect';
