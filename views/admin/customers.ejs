function applySecretToForm(name, pass, routerId) {
  if (secretPickerTarget === 'add') {
    const userField = document.querySelector('#addModal input[name="pppoe_username"]');
    const userManual = document.getElementById('add_pppoe_username_manual');
    const passField = document.getElementById('add_pppoe_password');
    const tagField = document.getElementById('add_genieacs_tag');
    const routerSelect = document.getElementById('add_router_select');
    const nameField = document.querySelector('#addModal input[name="name"]');
    const srcInput = document.getElementById('add_pppoe_source');

    if (userField) userField.value = name;
    if (userManual) userManual.value = name;
    if (passField) passField.value = pass || generateRandomPassword(6);
    if (tagField && (!tagField.value || tagField.value.trim() === '')) tagField.value = name;
    if (routerSelect && routerId) routerSelect.value = routerId;
    if (srcInput) srcInput.value = 'mikrotik';

    // Otomatis aktifkan opsi kirim secret ke RADIUS saat memilih dari MikroTik
    toggleRadiusSync('add', true);
    const addChk = document.getElementById('add_sync_to_radius');
    if (addChk) addChk.checked = true;

    const btnNew = document.getElementById('btn_mode_pppoe_new');
    const btnMikrotik = document.getElementById('btn_mode_pppoe_mikrotik');
    const badge = document.getElementById('add_pppoe_mode_badge');
    if (btnNew) { btnNew.style.background = 'transparent'; btnNew.style.color = 'var(--text)'; btnNew.classList.add('btn-g'); }
    if (btnMikrotik) { btnMikrotik.style.background = 'var(--primary)'; btnMikrotik.style.color = '#fff'; btnMikrotik.classList.remove('btn-g'); }
    if (badge) {
      badge.innerHTML = `<span><i class="bi bi-check2-circle text-success me-1"></i> <strong>Terpilih dari MikroTik:</strong> <code>${name}</code> (Mapping Aktif & Siap Disinkronkan ke RADIUS Server)</span>`;
      badge.style.background = 'rgba(16,185,129,0.08)';
      badge.style.borderColor = 'rgba(16,185,129,0.3)';
    }

    if (nameField && !nameField.value) {
      nameField.value = name.replace(/@.*$/, '').replace(/[_\-\.]/g, ' ').toUpperCase();
    }
  } else if (secretPickerTarget === 'edit') {
    const userField = document.getElementById('e_pppoe');
    const passField = document.getElementById('e_pppoe_password');
    const routerSelect = document.getElementById('e_router_id');
    const tagField = document.getElementById('e_tag');

    if (userField) userField.value = name;
    if (passField) passField.value = pass || '';
    if (tagField && (!tagField.value || tagField.value.trim() === '')) tagField.value = name;
    if (routerSelect && routerId) routerSelect.value = routerId;

    toggleRadiusSync('edit', true);
    const editChk = document.getElementById('e_sync_to_radius');
    if (editChk) editChk.checked = true;
  }
  closeModal('secretPickerModal');
}

