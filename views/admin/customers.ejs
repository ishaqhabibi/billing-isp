function renderSecretPickerTable(secrets) {
  const tbody = document.getElementById('secret_picker_tbody');
  if (!tbody) return;
  if (!secrets || secrets.length === 0) {
    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:24px; color:var(--muted);">Tidak ada secret yang belum terdaftar di MikroTik.</td></tr>';
    return;
  }
  tbody.innerHTML = secrets.map((s) => {
