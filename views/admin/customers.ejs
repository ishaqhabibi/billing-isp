<script>
function openModal(id){
  const el = document.getElementById(id);
  if (el) {
    el.classList.add('show');
    if (id === 'addModal') {
      if (typeof switchCustModalTab === 'function') switchCustModalTab('add', 1);
      if (typeof selectAuthModeCard === 'function') selectAuthModeCard('add', 0);
    }
  }
}
function closeModal(id){
  const el = document.getElementById(id);
  if (el) el.classList.remove('show');
}

function safeParseJSON(elementId, fallback = []) {
  try {
    const el = document.getElementById(elementId);
    if (!el || !el.textContent || !el.textContent.trim()) return fallback;
    return JSON.parse(el.textContent);
  } catch (e) {
    console.warn('Failed to parse JSON for ' + elementId, e);
    return fallback;
  }
}

const customersData = safeParseJSON('customers-data', []);
const odcsData = safeParseJSON('odcs-data', []);
const odpsData = safeParseJSON('odps-data', []);
const activeSessionsArray = safeParseJSON('sessions-data', []);
const activeSessionsMapObj = new Map(Array.isArray(activeSessionsArray) ? activeSessionsArray : []);
const routersData = safeParseJSON('routers-data', []);
const appSettings = safeParseJSON('settings-data', {});
let pickerMap, pickerMarker, activePickerType;
let payCustomerId = null;
let payBillingMeta = null;

function formatBytesVal(b) {
  const num = Number(b) || 0;
  if (num <= 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(num) / Math.log(k));
  return (num / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];
}

function copyToClipboard(elementId, label) {
  const el = document.getElementById(elementId);
  const text = el ? (el.innerText || el.textContent || '').trim() : '';
  if (!text || text === '-') {
    alert('Tidak ada data ' + label + ' untuk disalin.');
    return;
  }
  navigator.clipboard.writeText(text).then(() => {
    alert('📋 ' + label + ' berhasil disalin: ' + text);
  }).catch(() => {
    const input = document.createElement('textarea');
    input.value = text;
    document.body.appendChild(input);
    input.select();
    document.execCommand('copy');
    document.body.removeChild(input);
    alert('📋 ' + label + ' berhasil disalin: ' + text);
  });
}

function renderPhotoBox(wrapId, linkId, photoUrl, label) {
  const wrap = document.getElementById(wrapId);
  const link = document.getElementById(linkId);
  if (!wrap) return;
  if (photoUrl && String(photoUrl).trim()) {
    wrap.innerHTML = `<img src="${photoUrl}" alt="${label}" style="width:100%; height:100%; object-fit:cover; cursor:pointer;" onclick="window.open('${photoUrl}', '_blank')" title="Klik untuk perbesar">`;
    if (link) {
      link.href = photoUrl;
      link.style.display = 'inline-flex';
    }
  } else {
    wrap.innerHTML = `<span class="text-muted" style="font-size:12px;"><i class="bi bi-image me-1"></i> Belum ada foto</span>`;
    if (link) link.style.display = 'none';
  }
}

function setupEditPhotoPreview(boxId, photoUrl, defaultIcon) {
  const box = document.getElementById(boxId);
  if (!box) return;
  if (photoUrl && String(photoUrl).trim()) {
    box.innerHTML = `<img src="${photoUrl}" style="width:100%; height:100%; object-fit:cover; border-radius:6px;" title="Foto saat ini (akan ditimpa jika file baru diupload)">`;
  } else {
    box.innerHTML = `<i class="bi ${defaultIcon} text-muted" style="font-size:32px;"></i>`;
  }
}

function updateRxBadge(type = 'add') {
  const prefix = type === 'add' ? 'add_' : 'e_';
  const input = document.getElementById(prefix + 'initial_rx_power');
  const badge = document.getElementById(prefix + 'rx_status_badge');
  if (!input || !badge) return;
  const val = parseFloat(input.value);
  if (isNaN(val) || input.value.trim() === '') {
    badge.style.display = 'none';
    return;
  }
  badge.style.display = 'inline-block';
  if (val >= -24.0 && val <= -15.0) {
    badge.className = 'badge bs';
    badge.innerHTML = `<i class="bi bi-check-circle me-1"></i>Optimal (${val.toFixed(2)} dBm)`;
  } else if (val >= -26.5 && val < -24.0) {
    badge.className = 'badge bw';
    badge.innerHTML = `<i class="bi bi-exclamation-triangle me-1"></i>Peringatan (${val.toFixed(2)} dBm)`;
  } else {
    badge.className = 'badge bd';
    badge.innerHTML = `<i class="bi bi-x-octagon me-1"></i>Loss Tinggi / Kritis (${val.toFixed(2)} dBm)`;
  }
}

function previewDocFile(inputEl, boxId) {
  const box = document.getElementById(boxId);
  if (!box || !inputEl.files || !inputEl.files[0]) return;
  const file = inputEl.files[0];
  const reader = new FileReader();
  reader.onload = function(e) {
    box.innerHTML = `<img src="${e.target.result}" style="width:100%; height:100%; object-fit:cover; border-radius:6px;">`;
  };
  reader.readAsDataURL(file);
}

function handleOdpChange(type = 'add') {
  const prefix = type === 'add' ? 'add_' : 'e_';
  const odpSelect = document.getElementById(prefix + 'odp_id');
  const odcSelect = document.getElementById(prefix + 'odc_id');
  if (!odpSelect || !odcSelect) return;
  
  if (odpSelect.selectedIndex > 0) {
    const opt = odpSelect.options[odpSelect.selectedIndex];
    const dataOdcId = opt ? opt.getAttribute('data-odc-id') : null;
    if (dataOdcId && (!odcSelect.value || odcSelect.value === '')) {
      odcSelect.value = dataOdcId;
    }
  }
}

function handleOdcChange(type = 'add') {
  const prefix = type === 'add' ? 'add_' : 'e_';
  const odcSelect = document.getElementById(prefix + 'odc_id');
  const odpSelect = document.getElementById(prefix + 'odp_id');
  if (!odcSelect || !odpSelect) return;
  const selectedOdcId = odcSelect.value;

  Array.from(odpSelect.options).forEach(opt => {
    if (!opt.value) return;
    const optOdcId = opt.getAttribute('data-odc-id');
    if (!selectedOdcId) {
      opt.style.display = '';
    } else {
      if (optOdcId === selectedOdcId) {
        opt.style.display = '';
      } else {
        opt.style.display = 'none';
      }
    }
  });

  if (selectedOdcId && odpSelect.selectedIndex > 0) {
    const curOpt = odpSelect.options[odpSelect.selectedIndex];
    if (curOpt && curOpt.getAttribute('data-odc-id') && curOpt.getAttribute('data-odc-id') !== selectedOdcId) {
      odpSelect.value = '';
    }
  }
}

function switchCustDetailTab(tabKey, btn) {
  document.querySelectorAll('.cust-detail-pane').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.cust-detail-tab-btn').forEach(el => el.classList.remove('active'));
  const target = document.getElementById('cust_tab_' + tabKey);
  if (target) target.classList.add('active');
  if (btn) {
    btn.classList.add('active');
  } else {
    const defaultBtn = document.getElementById('tab_btn_' + tabKey);
    if (defaultBtn) defaultBtn.classList.add('active');
  }
}

