  } else {
    url.searchParams.delete('status');
  }
  window.location.href = url.toString();
}

// ─── ACTION DROPDOWN TOGGLER ─────────────────────────────────────────
function toggleActionDropdown(btn, e) {
  if (e) {
    e.stopPropagation();
    e.preventDefault();
  }
  const parent = btn.closest('.action-dropdown');
  if (!parent) return;
  const menu = parent.querySelector('.action-dropdown-menu');
  if (!menu) return;
  const wasActive = parent.classList.contains('active');
  
  // Close any other open dropdowns
  document.querySelectorAll('.action-dropdown.active').forEach(d => {
    if (d !== parent) d.classList.remove('active');
  });

  if (!wasActive) {
    parent.classList.add('active');

    // Get trigger button screen coordinates
    const rect = btn.getBoundingClientRect();
    const menuWidth = 220; // Standard menu width
    const menuHeight = 280; // Total height of action items
    const viewportWidth = document.documentElement.clientWidth || window.innerWidth;
    const viewportHeight = window.innerHeight;

    // HORIZONTAL POSITIONING:
    // Place menu so its right edge aligns with the button's right edge
    let targetLeft = rect.right - menuWidth;

    // Strict boundary checks to ensure menu NEVER overflows the screen:
    if (targetLeft + menuWidth > viewportWidth - 14) {
      targetLeft = viewportWidth - menuWidth - 14;
    }
    if (targetLeft < 10) {
      targetLeft = 10;
    }

    menu.style.position = 'fixed';
    menu.style.left = Math.round(targetLeft) + 'px';
    menu.style.right = 'auto';
    menu.style.width = menuWidth + 'px';

    // VERTICAL POSITIONING:
    const spaceBelow = viewportHeight - rect.bottom;
    const spaceAbove = rect.top;

    if (spaceBelow < menuHeight && spaceAbove > spaceBelow) {
      // Open upwards (dropup)
      menu.style.top = 'auto';
      menu.style.bottom = Math.round(viewportHeight - rect.top + 6) + 'px';
    } else {
      // Open downwards
      menu.style.bottom = 'auto';
      menu.style.top = Math.round(rect.bottom + 6) + 'px';
    }
  } else {
    parent.classList.remove('active');
  }
}

// Global click listener to close action dropdowns
document.addEventListener('click', (e) => {
  if (!e.target.closest('.action-dropdown')) {
    document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
  }
});
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
  }
});

// Auto close dropdown on any scroll (window, main container, or table)
window.addEventListener('scroll', () => {
  document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
}, { passive: true });
document.addEventListener('DOMContentLoaded', () => {
  const mw = document.querySelector('.mw');
  if (mw) {
    mw.addEventListener('scroll', () => {
      document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
    }, { passive: true });
  }
  document.querySelectorAll('.tbl-wrap').forEach(w => {
    w.addEventListener('scroll', () => {
      document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
    }, { passive: true });
  });
});

// ─── BULK ACTIONS SELECTION & OPERATIONS ──────────────────────────────
function toggleSelectAllCust(masterCb) {
  const cbs = document.querySelectorAll('.cust-select-cb');
  cbs.forEach(cb => {
    const row = cb.closest('tr');
    if (row && row.style.display !== 'none') {
      cb.checked = masterCb.checked;
    }
  });
  updateBulkBar();
}

function updateBulkBar() {
  const checked = document.querySelectorAll('.cust-select-cb:checked');
  const count = checked.length;
  const bar = document.getElementById('bulkActionBar');
  const countText = document.getElementById('selectedCountText');
  if (countText) countText.textContent = count;
  
  if (bar) {
    bar.style.display = (count > 0) ? 'flex' : 'none';
  }

  const allCbs = document.querySelectorAll('.cust-select-cb');
  const masterCb = document.getElementById('selectAllCust');
  if (masterCb && allCbs.length > 0) {
    masterCb.checked = (checked.length === allCbs.length);
    masterCb.indeterminate = (checked.length > 0 && checked.length < allCbs.length);
  }
}

function clearSelectedCust() {
  document.querySelectorAll('.cust-select-cb').forEach(cb => cb.checked = false);
  const masterCb = document.getElementById('selectAllCust');
  if (masterCb) {
    masterCb.checked = false;
    masterCb.indeterminate = false;
  }
  updateBulkBar();
}

function triggerBulkAction(action, confirmMsg) {
  const checked = document.querySelectorAll('.cust-select-cb:checked');
  if (checked.length === 0) {
    alert('Pilih minimal satu pelanggan terlebih dahulu!');
    return;
  }
  if (!confirm(confirmMsg)) return;

  const ids = Array.from(checked).map(cb => cb.value);
  const actionInput = document.getElementById('bulkActionInput');
  const idsInput = document.getElementById('bulkCustomerIdsInput');
  const form = document.getElementById('bulkActionForm');

  if (actionInput) actionInput.value = action;
  if (idsInput) idsInput.value = ids.join(',');
  if (form) form.submit();
}

function openBulkWaModal() {
  const checked = document.querySelectorAll('.cust-select-cb:checked');
  if (checked.length === 0) {
    alert('Pilih minimal satu pelanggan terlebih dahulu!');
    return;
  }
  const ids = Array.from(checked).map(cb => cb.value);
  const idsInput = document.getElementById('bulkWaCustomerIds');
  const countText = document.getElementById('bulkWaCountText');
  if (idsInput) idsInput.value = ids.join(',');
  if (countText) countText.textContent = ids.length + ' Pelanggan';
  openModal('bulkWaModal');
}

function insertWaVar(val) {
  const textarea = document.getElementById('bulkWaMessage');
  if (!textarea) return;
  const start = textarea.selectionStart;
  const end = textarea.selectionEnd;
  const text = textarea.value;
  textarea.value = text.substring(0, start) + val + text.substring(end);
  textarea.focus();
  textarea.selectionStart = textarea.selectionEnd = start + val.length;
}

// ─── LIVE ONLINE / OFFLINE FILTERING ──────────────────────────────────
let currentActiveConnFilter = null;

function toggleConnFilter(type) {
  const chipOnline = document.getElementById('chip_filter_online');
  const chipOffline = document.getElementById('chip_filter_offline');

  if (currentActiveConnFilter === type) {
    currentActiveConnFilter = null;
    if (chipOnline) chipOnline.classList.remove('active');
    if (chipOffline) chipOffline.classList.remove('active');
    document.querySelectorAll('.cust-row').forEach(r => r.style.display = '');
  } else {
    currentActiveConnFilter = type;
    if (chipOnline) chipOnline.classList.toggle('active', type === 'online');
    if (chipOffline) chipOffline.classList.toggle('active', type === 'offline');
    document.querySelectorAll('.cust-row').forEach(r => {
      const conn = r.getAttribute('data-conn') || 'offline';
      r.style.display = (conn === type) ? '' : 'none';
    });
  }
  updateBulkBar();
}

function updateLiveConnCounts() {
  let onlineCount = 0;
  let offlineCount = 0;
  document.querySelectorAll('.cust-row').forEach(r => {
    const conn = r.getAttribute('data-conn') || 'offline';
    if (conn === 'online') onlineCount++;
    else offlineCount++;
  });
  const elOnline = document.getElementById('count_live_online');
  const elOffline = document.getElementById('count_live_offline');
  if (elOnline) elOnline.textContent = onlineCount;
  if (elOffline) elOffline.textContent = offlineCount;
}

document.addEventListener('DOMContentLoaded', () => {
  updateLiveConnCounts();
});

