</div>

<!-- Modal Detail & Koneksi Pelanggan (Professional Modern Redesign) -->
<div class="mo" id="viewDetailModal">
  <div class="mb" style="max-width:780px; width:95vw; border-radius:18px; padding:0; overflow:hidden; border:1px solid var(--border); box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);">
    
    <!-- Header Hero Profile Banner -->
    <div style="background:linear-gradient(135deg, rgba(0,82,204,0.12), rgba(56,189,248,0.08)); padding:20px 24px; border-bottom:1px solid var(--border); position:relative;">
      <button type="button" class="mc" onclick="closeModal('viewDetailModal')" style="position:absolute; right:18px; top:18px; font-size:24px; border:none; background:transparent; color:var(--muted); cursor:pointer;">&times;</button>
      
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; padding-right:32px;">
        <div style="display:flex; align-items:center; gap:14px;">
          <div style="width:48px; height:48px; border-radius:14px; background:linear-gradient(135deg, var(--primary), #0284c7); color:#fff; display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:800; box-shadow:0 4px 14px rgba(0,82,204,0.35);">
            <i class="bi bi-person-fill"></i>
          </div>
          <div>
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
              <h4 id="v_cust_name" style="margin:0; font-size:18px; font-weight:800; color:var(--text);">-</h4>
              <span id="v_cust_code" class="badge bp" style="font-family:monospace; font-weight:700; font-size:12px; padding:3px 8px;">-</span>
            </div>
            <div style="font-size:12px; color:var(--muted); margin-top:2px;">
              ID: #<strong id="v_cust_id">-</strong> &bull; Router: <span id="v_router_name" style="font-weight:600; color:var(--text);">-</span>
            </div>
          </div>
        </div>
        <div id="v_online_badge">
          <!-- Badge Online/Offline inserted dynamically -->
        </div>
      </div>
      
      <!-- Quick Ribbon Pills -->
      <div style="display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; font-size:12px;">
        <div style="background:var(--bg3); padding:7px 12px; border-radius:8px; border:1px solid var(--border); display:flex; align-items:center; gap:6px;">
          <i class="bi bi-box-seam text-primary"></i> <span class="text-muted">Paket:</span> <strong id="v_package">-</strong>
        </div>
        <div style="background:var(--bg3); padding:7px 12px; border-radius:8px; border:1px solid var(--border); display:flex; align-items:center; gap:6px;">
          <i class="bi bi-clock-history text-warning"></i> <span id="v_expired_at">-</span>
        </div>
        <div style="background:var(--bg3); padding:7px 12px; border-radius:8px; border:1px solid var(--border); display:flex; align-items:center; gap:6px;">
          <i class="bi bi-wallet2 text-success"></i> <span class="text-muted">Saldo:</span> <strong id="v_balance" style="color:#10b981;">Rp 0</strong>
          <button type="button" class="btn btn-s btn-sm py-0 px-2 ms-1" style="font-size:11px; padding:2px 8px;" onclick="openTopupFromDetail()"><i class="bi bi-plus"></i></button>
        </div>
      </div>
    </div>

    <!-- Segmented Tab Navigation -->
    <div style="padding:12px 24px 0 24px; background:var(--bg2); border-bottom:1px solid var(--border);">
