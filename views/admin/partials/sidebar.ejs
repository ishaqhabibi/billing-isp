<!-- views/admin/partials/sidebar.ejs -->
<script src="/js/theme.js"></script>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<aside class="sidebar" id="sidebar">
  <!-- ── 1. FIGCRAFT BRAND HEADER (215x46) ── -->
  <div class="sb-brand-header">
    <div class="sb-logo-circle">
      <span>NOC</span>
    </div>
    <div class="sb-text-stack">
      <div class="sb-brand-title">NOC System</div>
      <div class="sb-brand-sub"><%= (typeof company !== 'undefined' && company) ? company : 'IndoBSD Billing' %></div>
      <div class="sb-version-pill">v1.2.0-dev</div>
    </div>
    <button type="button" class="sb-close d-md-none" onclick="toggleSidebar()" aria-label="Tutup"><i class="bi bi-x-lg"></i></button>
  </div>

  <!-- ── 2. FIGCRAFT STATUS ROW (215x24 SISTEM AKTIF) ── -->
  <div class="sb-status-row">
    <span class="sb-status-dot"></span>
    <span class="sb-status-label">SISTEM AKTIF</span>
  </div>

  <!-- ── 3. COLLAPSE TOGGLE PILL (24x24 ON RIGHT BORDER) ── -->
  <button type="button" class="sb-collapse-toggle d-none d-md-flex" onclick="toggleSidebarCollapse()" title="Sembunyikan Sidebar">
    <i class="bi bi-chevron-left" id="sbCollapseIcon"></i>
  </button>

  <!-- ── 4. FIGCRAFT NAV CONTAINER WITH TREE CONNECTORS ── -->
  <nav class="sb-nav" id="sidebarNav">
    <%
      const navSections = [
        {
          key: 'overview',
          title: 'IKHTISAR',
          icon: 'bi bi-compass',
          iconColor: '#6366F1',
          items: [
            { label: 'Beranda', href: '/admin', icon: 'bi bi-house-door', iconColor: '#6D28D9', active: ['dashboard'] }
          ]
        },
        {
          key: 'customers',
          title: 'PELANGGAN & LAYANAN',
          icon: 'bi bi-briefcase',
          iconColor: '#F59E0B',
          items: [
            { label: 'Pendaftaran & Pasang', href: '/admin/collector/live', icon: 'bi bi-activity', iconColor: '#F43F5E', active: ['collector_live'] },
            { label: 'Pelanggan', href: '/admin/customers', icon: 'bi bi-people', iconColor: '#64748B', active: ['customers'] },
            { label: 'Tiket Gangguan', href: '/admin/tickets', icon: 'bi bi-exclamation-triangle', iconColor: '#EF4444', active: ['tickets'] },
            { label: 'Paket Internet', href: '/admin/packages', icon: 'bi bi-box-seam', iconColor: '#F97316', active: ['packages', 'voucher_packages'] }
          ]
        },
        {
          key: 'billing',
          title: 'BILLING & KEUANGAN',
          icon: 'bi bi-shield-check',
          iconColor: '#10B981',
          items: [
            { label: 'Tagihan Bulanan', href: '/admin/billing', icon: 'bi bi-receipt', iconColor: '#F59E0B', active: ['billing'] },
            { label: 'Setoran Kolektor', href: '/admin/collector-settlements', icon: 'bi bi-wallet2', iconColor: '#10B981', active: ['collector_settlements', 'collector_payments'] },
            { label: 'Laporan Keuangan', href: '/admin/reports', icon: 'bi bi-graph-up-arrow', iconColor: '#10B981', active: ['reports', 'cash_in', 'expenses'] }
          ]
        },
        {
          key: 'infra',
          title: 'INFRASTRUKTUR & NOC',
          icon: 'bi bi-hdd-stack',
          iconColor: '#3B82F6',
          items: [
            { label: 'Router MikroTik', href: '/admin/mikrotik', icon: 'bi bi-router', iconColor: '#F43F5E', active: ['mikrotik', 'routers'] },
            { label: 'Server RADIUS', href: '/admin/radius-settings', icon: 'bi bi-hdd-network', iconColor: '#6366F1', active: ['radius_settings'] },
            { label: 'Monitoring OLT', href: '/admin/olts', icon: 'bi bi-ethernet', iconColor: '#06B6D4', active: ['olts'] },
            { label: 'GenieACS (TR-069)', href: '/admin/acs', icon: 'bi bi-modem', iconColor: '#8B5CF6', active: ['acs_pro', 'onu_provision'] },
            { label: 'Wilayah & Peta FTTH', href: '/admin/map', icon: 'bi bi-geo-alt', iconColor: '#3B82F6', active: ['map', 'areas'] }
          ]
        },
        {
          key: 'system',
          title: 'SISTEM & KEAMANAN',
          icon: 'bi bi-shield-check',
          iconColor: '#10B981',
          items: [
            { label: 'WhatsApp Gateway', href: '/admin/whatsapp', icon: 'bi bi-whatsapp', iconColor: '#0EA5E9', active: ['whatsapp', 'broadcast'] },
            { label: 'Log Login User', href: '/admin/audit-logs', icon: 'bi bi-shield-lock', iconColor: '#0EA5E9', active: ['audit_logs'] },
            { label: 'Pengaturan', href: '/admin/settings', icon: 'bi bi-gear', iconColor: '#64748B', active: ['settings', 'sidebar_settings'] }
          ]
        }
      ];
    %>

    <% navSections.forEach((section, sIdx) => { %>
      <div class="sb-nav-group">
        <div class="sb-group-header" onclick="toggleNavGroup('sbGroup_<%= sIdx %>')">
          <div class="sb-group-header-left">
            <i class="<%= section.icon %>" style="color: <%= section.iconColor %>;"></i>
            <span class="sb-group-title"><%= section.title %></span>
          </div>
          <i class="bi bi-chevron-down sb-group-chevron" id="chevron_<%= sIdx %>"></i>
        </div>
        
        <div class="sb-tree-list" id="sbGroup_<%= sIdx %>">
          <% section.items.forEach((item, iIdx) => { %>
            <% const isLast = (iIdx === section.items.length - 1); %>
            <% const isCurrentActive = item.active.includes(activePage); %>
            <div class="sb-tree-row">
              <div class="sb-tree-connector <%= isLast ? 'is-last' : '' %>">
                <span class="sb-curve-line"></span>
              </div>
              <a href="<%= item.href %>" class="sb-nav-item <%= isCurrentActive ? 'active' : '' %>">
                <i class="<%= item.icon %>" style="color: <%= item.iconColor %>;"></i>
                <span class="sb-nav-label"><%= item.label %></span>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </nav>

  <!-- ── 5. FIGCRAFT USER FOOTER CARD (215x50) ── -->
  <div class="sb-user-footer">
    <div class="sb-user-avatar">
      <span><%= (typeof session !== 'undefined' && session && session.adminUser ? session.adminUser.substring(0, 2).toUpperCase() : 'AD') %></span>
    </div>
    <div class="sb-user-meta">
      <div class="sb-user-name"><%= (typeof session !== 'undefined' && session && session.adminUser) ? session.adminUser : 'Administrator' %></div>
      <div class="sb-user-role"><%= (typeof session !== 'undefined' && session && session.isCashier) ? 'Kasir Billing' : 'Admin ISP' %></div>
    </div>
    <a href="/admin/logout" class="sb-logout-btn" title="Keluar">
      <i class="bi bi-box-arrow-right"></i>
    </a>
  </div>
</aside>

<script>
(function() {
  const sb = document.getElementById('sidebarNav');
  if (!sb) return;

  function restoreSidebarScroll() {
    const savedScroll = sessionStorage.getItem('sidebar_scroll_pos');
    if (savedScroll !== null) {
      sb.scrollTop = parseInt(savedScroll, 10);
    }
  }

  restoreSidebarScroll();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', restoreSidebarScroll);
  }
  window.addEventListener('load', restoreSidebarScroll);

  sb.addEventListener('scroll', function() {
    sessionStorage.setItem('sidebar_scroll_pos', sb.scrollTop);
  }, { passive: true });
})();

function toggleNavGroup(id) {
  const list = document.getElementById(id);
  if (!list) return;
  const isHidden = list.style.display === 'none';
  list.style.display = isHidden ? 'flex' : 'none';
  const chevronId = id.replace('sbGroup_', 'chevron_');
  const chevron = document.getElementById(chevronId);
  if (chevron) {
    chevron.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(-90deg)';
  }
}

function toggleSidebarCollapse() {
  const sb = document.getElementById('sidebar');
  if (sb) {
    sb.classList.toggle('collapsed');
    const icon = document.getElementById('sbCollapseIcon');
    if (icon) {
      icon.className = sb.classList.contains('collapsed') ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
    }
  }
}
</script>

<!-- Bottom Navigation (Mobile Only) -->
<nav class="bottom-nav" id="bottomNav">
  <a href="/admin" class="bn-item <%= activePage === 'dashboard' ? 'active' : '' %>">
    <i class="bi bi-grid-1x2"></i>
    <span>Beranda</span>
  </a>
  <a href="/admin/customers" class="bn-item <%= activePage === 'customers' ? 'active' : '' %>">
    <i class="bi bi-people"></i>
    <span>Pelanggan</span>
  </a>
  <a href="/admin/billing" class="bn-item <%= activePage === 'billing' ? 'active' : '' %>">
    <i class="bi bi-receipt"></i>
    <span>Tagihan</span>
  </a>
  <a href="/admin/mikrotik" class="bn-item <%= activePage === 'mikrotik' ? 'active' : '' %>">
    <i class="bi bi-router"></i>
    <span>MikroTik</span>
  </a>
  <button class="bn-item" onclick="toggleSidebar()">
    <i class="bi bi-grid-3x3-gap"></i>
    <span>Menu</span>
  </button>
</nav>
