<!-- views/admin/partials/sidebar.ejs -->
<script src="/js/theme.js"></script>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<aside class="sidebar" id="sidebar">
  <!-- ── 1. FIGCRAFT BRAND HEADER ── -->
  <div class="sb-brand-header">
    <div class="sb-logo-circle">
      <span>NOC</span>
    </div>
    <div class="sb-text-stack">
      <div class="sb-brand-title">NOC System</div>
      <div class="sb-brand-sub"><%= (typeof company !== 'undefined' && company) ? company : 'Bionfiber' %> Billing</div>
      <div class="sb-version-pill">v4.8.1</div>
    </div>
    <button type="button" class="sb-close d-md-none" onclick="toggleSidebar()" aria-label="Tutup"><i class="bi bi-x-lg"></i></button>
  </div>

  <!-- ── 2. FIGCRAFT STATUS ROW (SISTEM AKTIF) ── -->
  <div class="sb-status-row">
    <span class="sb-status-dot"></span>
    <span class="sb-status-label">SISTEM AKTIF</span>
  </div>

  <!-- ── ROUTER FILTER (MULTI-ROUTER MODE) ── -->
  <% if (typeof multiRouterMode !== 'undefined' && multiRouterMode && allActiveRouters && allActiveRouters.length > 0) { %>
    <div class="sb-router-filter" style="margin: 0 15px 10px; padding: 6px 8px; border-radius: 8px; background: var(--sb-item-hover-bg); border: 1px solid var(--sb-border);">
      <div style="font-size:10px; color:var(--sb-group-title); margin-bottom:4px; font-weight:700; display:flex; align-items:center; gap:4px; text-transform:uppercase;">
        <i class="bi bi-router"></i> Router Filter
      </div>
      <select class="form-select form-select-sm" style="font-size:11px; padding:3px 6px; cursor:pointer; width:100%; border-radius:6px; background:transparent; color:var(--sb-item-text); border:1px solid var(--sb-border);" onchange="window.location.href='/admin/set-active-router?router_id=' + this.value">
        <option value="all" <%= (!selectedRouterId) ? 'selected' : '' %>>🌐 Semua Router (<%= allActiveRouters.length %>)</option>
        <% allActiveRouters.forEach(r => { %>
          <option value="<%= r.id %>" <%= (selectedRouterId === r.id) ? 'selected' : '' %>>
            🔌 <%= r.name %> (<%= r.host %>)
          </option>
        <% }) %>
      </select>
    </div>
  <% } %>

  <!-- ── 3. FIGCRAFT NAV CONTAINER (ACCORDION GROUPS) ── -->
  <nav class="sb-nav" id="sidebarNav">
    <% (sidebarSections || []).forEach((section, sIdx) => { %>
      <div class="sb-group">
        <div class="sb-group-header" onclick="toggleNavGroup('sbGroup_<%= sIdx %>')">
          <span class="sb-group-title"><%= section.labelKey ? t(section.labelKey, section.labelDefault) : section.labelDefault %></span>
          <i class="bi bi-chevron-down sb-group-chevron" id="chevron_<%= sIdx %>"></i>
        </div>
        <div class="sb-group-list" id="sbGroup_<%= sIdx %>">
          <% section.items.forEach((item) => { %>
            <a
              href="<%= item.hrefResolved %>"
              class="sb-item <%= (item.activePages || []).includes(activePage) ? 'active' : '' %>"
              <% if (item.locked) { %>
                onclick='return showLockedMenuNotice(<%- JSON.stringify(item.lockedMessage) %>)'
              <% } %>
            >
              <i class="<%= item.icon %> sb-item-icon"></i>
              <span class="sb-item-label"><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
              <% if (item.locked) { %>
                <span class="sb-lock-pill">Kunci</span>
              <% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% }) %>

    <div class="sb-group" style="margin-top:4px;">
      <a href="/admin/sidebar-settings" class="sb-item <%= activePage==='sidebar_settings' ? 'active' : '' %>">
        <i class="bi bi-layout-sidebar-inset sb-item-icon"></i>
        <span class="sb-item-label">Pengaturan Sidebar</span>
      </a>
    </div>
  </nav>

  <!-- ── 4. FIGCRAFT USER FOOTER CARD ── -->
  <div class="sb-user-footer">
    <div class="sb-user-avatar">
      <span><%= (typeof session !== 'undefined' && session && session.adminUser ? session.adminUser.substring(0, 2).toUpperCase() : 'AD') %></span>
    </div>
    <div class="sb-user-meta">
      <div class="sb-user-name"><%= (typeof session !== 'undefined' && session && session.adminUser) ? session.adminUser : 'Administrator' %></div>
      <div class="sb-user-role"><%= (typeof session !== 'undefined' && session && session.isCashier) ? 'Kasir Billing' : 'Admin ISP' %></div>
    </div>
    <a href="/admin/logout" class="sb-logout-btn" title="Keluar">
      <i class="bi bi-box-arrow-right"></i>
    </a>
  </div>
</aside>

<script>
(function() {
  const sb = document.getElementById('sidebarNav');
  if (!sb) return;

  function restoreSidebarScroll() {
    const savedScroll = sessionStorage.getItem('sidebar_scroll_pos');
    if (savedScroll !== null) {
      sb.scrollTop = parseInt(savedScroll, 10);
    } else {
      const active = sb.querySelector('.sb-item.active');
      if (active) {
        active.scrollIntoView({ block: 'nearest' });
      }
    }
  }

  // Restore immediately before paint
  restoreSidebarScroll();

  // Restore again on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', restoreSidebarScroll);
  }

  // Double check after full load and ensure active item is visible
  window.addEventListener('load', function() {
    restoreSidebarScroll();
    const active = sb.querySelector('.sb-item.active');
    if (active) {
      const sbRect = sb.getBoundingClientRect();
      const aRect = active.getBoundingClientRect();
      if (aRect.top < sbRect.top || aRect.bottom > sbRect.bottom) {
        active.scrollIntoView({ block: 'nearest' });
        sessionStorage.setItem('sidebar_scroll_pos', sb.scrollTop);
      }
    }
  });

  // Track scroll position
  sb.addEventListener('scroll', function() {
    sessionStorage.setItem('sidebar_scroll_pos', sb.scrollTop);
  }, { passive: true });

  // Save on clicking any link in sidebar
  sb.addEventListener('click', function(e) {
    const link = e.target.closest('a');
    if (link) {
      sessionStorage.setItem('sidebar_scroll_pos', sb.scrollTop);
    }
  });
})();

function toggleNavGroup(id) {
  const list = document.getElementById(id);
  if (!list) return;
  const isHidden = list.style.display === 'none';
  list.style.display = isHidden ? 'flex' : 'none';
  const chevronId = id.replace('sbGroup_', 'chevron_');
  const chevron = document.getElementById(chevronId);
  if (chevron) {
    chevron.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(-90deg)';
  }
}
</script>

<div id="lockedMenuModal" style="display:none;position:fixed;inset:0;z-index:1200;background:rgba(2,6,23,.72);backdrop-filter:blur(4px);padding:16px;align-items:center;justify-content:center">
  <div style="width:min(100%,420px);background:linear-gradient(180deg,rgba(15,23,42,.98),rgba(30,41,59,.98));border:1px solid rgba(148,163,184,.18);border-radius:18px;box-shadow:0 24px 60px rgba(2,6,23,.45);overflow:hidden">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid rgba(148,163,184,.14)">
      <div style="display:flex;align-items:center;gap:10px">
        <div style="width:40px;height:40px;border-radius:12px;background:rgba(245,158,11,.16);color:#fde68a;display:grid;place-items:center;font-size:18px">
          <i class="bi bi-lock-fill"></i>
        </div>
        <div>
          <div style="font-weight:800;color:#f8fafc">Menu Terkunci</div>
          <div style="font-size:12px;color:#94a3b8">Aktivasi diperlukan untuk membuka fitur ini</div>
        </div>
      </div>
      <button type="button" class="btn btn-g btn-sm" onclick="hideLockedMenuNotice()" style="padding:6px 10px">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <div style="padding:18px">
      <div id="lockedMenuModalMessage" style="color:#e2e8f0;line-height:1.6">
        Menu ini sedang terkunci.
      </div>
      <div style="margin-top:16px;padding:12px 14px;border-radius:14px;background:rgba(59,130,246,.12);border:1px solid rgba(59,130,246,.22);color:#bfdbfe;font-size:13px">
        Dukung pengembangan aplikasi untuk mendapatkan kode aktivasi (seikhlasnya).
      </div>
      <div style="margin-top:14px;display:flex;flex-direction:column;gap:8px">
        <a href="https://app.alijaya.com/donasi" target="_blank" class="btn btn-p" style="width:100%;display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,#f59e0b,#d97706);border:none;color:#0f172a;font-weight:800;box-shadow:0 8px 20px rgba(245,158,11,0.35);">
          <i class="bi bi-heart-fill" style="color:#e11d48"></i> Donasi & Dapatkan Kode Aktivasi
        </a>
        <a href="/admin/sidebar-settings" class="btn btn-g" style="width:100%;display:flex;align-items:center;justify-content:center;gap:8px" onclick="hideLockedMenuNotice()">
          <i class="bi bi-layout-sidebar-inset"></i> Buka Pengaturan Sidebar
        </a>
      </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:10px;padding:0 18px 18px 18px">
      <button type="button" class="btn btn-p" onclick="hideLockedMenuNotice()">
        <i class="bi bi-check2-circle"></i> Mengerti
      </button>
    </div>
  </div>
</div>

<script>
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    if (sb) sb.classList.toggle('open');
    if (ov) ov.classList.toggle('show');
  }

  function showLockedMenuNotice(message) {
    const modal = document.getElementById('lockedMenuModal');
    const messageBox = document.getElementById('lockedMenuModalMessage');
    if (messageBox) {
      messageBox.textContent = message || 'Menu ini sedang terkunci.';
    }
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    return false;
  }

  function hideLockedMenuNotice() {
    const modal = document.getElementById('lockedMenuModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') hideLockedMenuNotice();
  });
</script>

<!-- Bottom Navigation (Mobile Only) -->
<nav class="bottom-nav" id="bottomNav">
  <% (sidebarBottomNavItems || []).slice(0, 4).forEach((item) => { %>
    <a
      href="<%= item.hrefResolved %>"
      class="bn-item <%= (item.activePages || []).includes(activePage) ? 'active' : '' %>"
      <% if (item.locked) { %>
        onclick='return showLockedMenuNotice(<%- JSON.stringify(item.lockedMessage) %>)'
      <% } %>
    >
      <i class="<%= item.icon %>"></i>
      <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
    </a>
  <% }) %>
  <button class="bn-item" onclick="toggleSidebar()">
    <i class="bi bi-grid-3x3-gap"></i>
    <span><%= t('common.menu', 'Menu') %></span>
  </button>
</nav>
