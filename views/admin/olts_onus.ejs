<div class="copied-toast" id="copiedToast">
  <i class="bi bi-check-circle-fill me-1"></i> Serial Number berhasil disalin ke clipboard!
</div>

<script>
let allOnus = [];
let filteredOnus = [];
let currentFilterStatus = 'all';
let currentSearch = '';
let currentPonPort = 'all';
let currentOpticalQuality = 'all';
let currentBillingLink = 'all';
let currentPage = 1;
let rowsPerPage = 25;
let currentOltId = null;
let currentActionOnu = null;
let sortField = 'port';
let sortDirection = 'asc';

function showToast() {
  const t = document.getElementById('copiedToast');
  if (!t) return;
  t.style.display = 'block';
  setTimeout(() => { t.style.display = 'none'; }, 2000);
}

function copyToClipboard(text) {
  if (!text || text === '-') return;
  navigator.clipboard.writeText(text).then(showToast).catch(() => {
    const el = document.createElement('textarea');
    el.value = text;
    document.body.appendChild(el);
    el.select();
    document.execCommand('copy');
    document.body.removeChild(el);
    showToast();
  });
}

function openModal(id) {
  const m = document.getElementById(id);
  if (m) m.classList.add('show');
}
function closeModal(id) {
  const m = document.getElementById(id);
  if (m) m.classList.remove('show');
}

function handleOltChange() {
  const sel = document.getElementById('olt-selector');
  const id = sel ? sel.value : '';
  if (id) {
    try {
      const url = new URL(window.location);
      url.searchParams.set('olt_id', id);
      window.history.replaceState({}, '', url);

      const linkDash = document.getElementById('linkTabDashboard');
      const btnBack = document.getElementById('btnBackToDashboard');
      if (linkDash) linkDash.href = `/admin/olts?olt_id=${id}`;
      if (btnBack) btnBack.href = `/admin/olts?olt_id=${id}`;
    } catch (_) {}
    loadOnuData(id);
  }
}

function refreshCurrentOlt() {
  const sel = document.getElementById('olt-selector');
  if (sel && sel.value) loadOnuData(sel.value);
}

async function loadOnuData(oltId) {
  currentOltId = oltId;
  const overlay = document.getElementById('loading-overlay');
  const icon = document.getElementById('refreshIcon');
  if (overlay) overlay.style.display = 'flex';
  if (icon) icon.classList.add('spin');

  try {
    const res = await fetch(`/admin/olts/${oltId}/stats?full=true`);
    const data = await res.json();

    allOnus = Array.isArray(data.onus) ? data.onus : [];

    updatePonPortFilterOptions();

    // Update KPI Ribbon
    const total = allOnus.length;
    const online = allOnus.filter(o => String(o.status).toLowerCase() === 'online').length;
    const offline = total - online;
    const weak = allOnus.filter(o => {
      const r = parseFloat(o.rx);
      return Number.isFinite(r) && r < -24;
    }).length;

    const onlinePct = total > 0 ? Math.round((online / total) * 100) : 0;

    document.getElementById('kpi-total-val').textContent = total + ' Unit';
    document.getElementById('kpi-online-val').textContent = online + ' Unit';
    document.getElementById('kpi-online-pct').textContent = onlinePct + '% aktif';
    document.getElementById('kpi-offline-val').textContent = offline + ' Unit';
    document.getElementById('kpi-weak-val').textContent = weak + ' Unit';
    document.getElementById('last-update-time').textContent = new Date().toLocaleTimeString('id-ID');

    currentPage = 1;
    applyFilters();
  } catch (err) {
    console.error('Error fetching ONU stats:', err);
    document.getElementById('onu-table-body').innerHTML = `
      <tr>
        <td colspan="10" class="text-center p-4 text-danger">
          <i class="bi bi-exclamation-triangle me-1"></i> Gagal mengambil data OLT via SNMP: ${err.message}
        </td>
      </tr>
    `;
  } finally {
    if (overlay) overlay.style.display = 'none';
    if (icon) icon.classList.remove('spin');
  }
}

function updatePonPortFilterOptions() {
  const sel = document.getElementById('filter-pon-port');
  if (!sel) return;

  const ports = new Set();
  allOnus.forEach(o => {
    const rawId = String(o.id || o.index || '');
    if (rawId.includes('/')) {
      const p = rawId.split('/')[0];
      ports.add('PON ' + p);
    }
  });

  const curVal = sel.value;
  sel.innerHTML = '<option value="all">Semua Port PON</option>';
  Array.from(ports).sort().forEach(p => {
    const opt = document.createElement('option');
    opt.value = p;
    opt.textContent = p;
    sel.appendChild(opt);
  });
  if (curVal && sel.querySelector(`option[value="${curVal}"]`)) {
    sel.value = curVal;
  }
}

function handleSearchInput() {
  const val = document.getElementById('onu-search-input').value.trim();
  currentSearch = val.toLowerCase();
  document.getElementById('searchClearBtn').style.display = currentSearch ? 'block' : 'none';
  currentPage = 1;
  applyFilters();
}

function clearSearch() {
  document.getElementById('onu-search-input').value = '';
  currentSearch = '';
  document.getElementById('searchClearBtn').style.display = 'none';
  currentPage = 1;
  applyFilters();
}

function applyFilters() {
  const statusEl = document.getElementById('filter-status');
  if (statusEl) currentFilterStatus = statusEl.value;
  currentPonPort = document.getElementById('filter-pon-port').value;
  currentOpticalQuality = document.getElementById('filter-optical-quality').value;
  currentBillingLink = document.getElementById('filter-billing-link').value;

  filteredOnus = allOnus.filter(o => {
    const st = String(o.status || '').toLowerCase();
    const rx = parseFloat(o.rx);

    // 1. Status Filter
    if (currentFilterStatus === 'online' && st !== 'online') return false;
    if (currentFilterStatus === 'offline' && st === 'online') return false;
    if (currentFilterStatus === 'weak') {
      if (!Number.isFinite(rx) || rx >= -24) return false;
    }

    // 2. Optical Quality Filter
    if (currentOpticalQuality === 'good') {
      if (!Number.isFinite(rx) || rx < -22) return false;
    } else if (currentOpticalQuality === 'warn') {
      if (!Number.isFinite(rx) || rx >= -22 || rx < -25) return false;
    } else if (currentOpticalQuality === 'crit') {
      if (!Number.isFinite(rx) || rx >= -25) return false;
    }

    // 3. Billing Link Filter
    if (currentBillingLink === 'linked' && !o.customer_id) return false;
    if (currentBillingLink === 'unlinked' && o.customer_id) return false;

    // 4. Port PON Filter
    if (currentPonPort !== 'all') {
      const targetPortNum = currentPonPort.replace('PON ', '');
      const rawId = String(o.id || o.index || '');
      const portPart = rawId.split('/')[0];
      if (portPart !== targetPortNum) return false;
    }

    // 5. Search Filter
    if (currentSearch) {
      const name = String(o.name || '').toLowerCase();
      const custName = String(o.customer_name || '').toLowerCase();
      const ppp = String(o.pppoe_username || '').toLowerCase();
      const sn = String(o.sn || '').toLowerCase();
      const id = String(o.id || o.index || '').toLowerCase();
      const model = String(o.model || '').toLowerCase();
      const dist = String(o.distance || '').toLowerCase();

      if (!name.includes(currentSearch) && !custName.includes(currentSearch) && !ppp.includes(currentSearch) &&
          !sn.includes(currentSearch) && !id.includes(currentSearch) && !model.includes(currentSearch) && !dist.includes(currentSearch)) {
        return false;
      }
    }

    return true;
  });

  // Apply Sorting
  sortFilteredOnus();
  renderTable();
}

function sortTable(field) {
  if (sortField === field) {
    sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
  } else {
    sortField = field;
    sortDirection = 'asc';
  }
  updateSortIcons();
  sortFilteredOnus();
  renderTable();
}

function updateSortIcons() {
  document.querySelectorAll('th[data-sort]').forEach(th => {
    const f = th.getAttribute('data-sort');
    const icon = th.querySelector('.sort-icon');
    if (!icon) return;
    if (f === sortField) {
      icon.className = `bi bi-sort-${sortDirection === 'asc' ? 'down' : 'up'} sort-icon text-primary`;
    } else {
      icon.className = 'bi bi-arrow-down-up sort-icon text-muted';
    }
  });
}

function sortFilteredOnus() {
  filteredOnus.sort((a, b) => {
    let valA = a[sortField];
    let valB = b[sortField];

    if (sortField === 'rx') {
      valA = parseFloat(a.rx) || -999;
      valB = parseFloat(b.rx) || -999;
    } else if (sortField === 'dist') {
      valA = parseInt(a.distance) || 0;
      valB = parseInt(b.distance) || 0;
    } else if (sortField === 'port') {
      valA = String(a.id || a.index || '');
      valB = String(b.id || b.index || '');
    } else {
      valA = String(valA || '').toLowerCase();
      valB = String(valB || '').toLowerCase();
    }

    if (valA < valB) return sortDirection === 'asc' ? -1 : 1;
    if (valA > valB) return sortDirection === 'asc' ? 1 : -1;
    return 0;
  });
}

function changeRowsPerPage() {
  rowsPerPage = parseInt(document.getElementById('rows-per-page').value) || 25;
  currentPage = 1;
  renderTable();
}

function renderTable() {
  const tbody = document.getElementById('onu-table-body');
  if (!tbody) return;

  const total = filteredOnus.length;
  if (total === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="10" class="text-center p-5 text-muted">
          <i class="bi bi-inbox" style="font-size: 32px; display:block; margin-bottom: 8px;"></i>
          Tidak ada modem yang cocok dengan filter atau kata kunci pencarian.
        </td>
      </tr>
    `;
    document.getElementById('pagination-info').textContent = 'Menampilkan 0 dari 0 modem';
    document.getElementById('pagination-buttons').innerHTML = '';
    return;
  }

  const totalPages = Math.ceil(total / rowsPerPage);
  if (currentPage > totalPages) currentPage = totalPages;
  if (currentPage < 1) currentPage = 1;

  const startIdx = (currentPage - 1) * rowsPerPage;
  const endIdx = Math.min(startIdx + rowsPerPage, total);
  const pageItems = filteredOnus.slice(startIdx, endIdx);

  let html = '';
  pageItems.forEach((o, i) => {
    const rowNo = startIdx + i + 1;
    const isUp = String(o.status || '').toLowerCase() === 'online';
    const rxNum = parseFloat(o.rx);

    // Optical Quality styling
    let rxClass = 'rx-crit';
    let rxPct = 30;
    let rxQualityText = 'Kritis';
    if (isUp && Number.isFinite(rxNum)) {
      if (rxNum >= -22) {
        rxClass = 'rx-good';
        rxPct = 95;
        rxQualityText = 'Bagus';
      } else if (rxNum >= -25) {
        rxClass = 'rx-warn';
        rxPct = 65;
        rxQualityText = 'Waspada';
      }
    }

    // Device Vendor & Model
    const vendorName = o.vendor || 'FiberHome';
    const modelName = o.model || 'HG6145D2';

    // Customer & Alias Name
    const hasCust = !!o.customer_name;
    const custDisplay = hasCust
      ? `<a href="/admin/customers/${o.customer_id}" class="text-primary fw-bold" title="Buka Detail Pelanggan">${escapeHtml(o.customer_name)}</a>`
      : `<span class="fw-bold">${escapeHtml(o.name || 'Modem-' + o.id)}</span>`;

    const subInfo = [];
    if (hasCust && o.name) subInfo.push(`<span title="Alias OLT">${escapeHtml(o.name)}</span>`);
    if (o.pppoe_username) subInfo.push(`<span class="text-muted" title="Akun PPPoE"><i class="bi bi-person me-1"></i>${escapeHtml(o.pppoe_username)}</span>`);

    // Hardware Uptime & Temp
    const tempVolt = (o.temp && o.temp !== 'N/A') ? `${o.temp}` : '';
    const uptimeStr = o.uptime || '-';

    html += `
      <tr>
        <td class="text-muted small">${rowNo}</td>
        <td>
          <span class="port-chip" title="Port PON dan ONU Index">
            <i class="bi bi-broadcast text-primary"></i> ${o.id || o.index}
          </span>
        </td>
        <td>
          <div class="client-title">${custDisplay}</div>
          <div class="client-sub">${subInfo.join(' • ') || '<span class="text-muted">Tanpa Nama Pelanggan</span>'}</div>
        </td>
        <td>
          <div class="d-flex flex-column gap-1">
            <div class="d-flex align-items-center gap-1">
              <span class="device-model-badge">${vendorName} ${modelName}</span>
            </div>
            <span class="sn-tag" onclick="copyToClipboard('${o.sn}')" title="Klik untuk menyalin Serial Number">
              <i class="bi bi-clipboard text-muted"></i> ${o.sn}
            </span>
          </div>
        </td>
        <td>
          <span class="status-badge ${isUp ? 'up' : 'down'}">
            <i class="bi bi-circle-fill" style="font-size:6px"></i> ${isUp ? 'Online' : 'Offline'}
          </span>
          ${!isUp && o.offline_reason ? `<div class="text-danger small mt-1" style="font-size:10px;">${escapeHtml(o.offline_reason)}</div>` : ''}
        </td>
        <td>
          <div class="rx-cell-box ${rxClass}">
            <span class="rx-val-badge">
              <i class="bi ${rxClass === 'rx-good' ? 'bi-check2' : (rxClass === 'rx-warn' ? 'bi-exclamation-triangle' : 'bi-lightning-charge')}"></i>
              ${o.rx || '-'}
            </span>
            <div class="rx-bar-mini" title="Kualitas Sinyal: ${rxQualityText}">
              <div class="rx-bar-mini-fill" style="width: ${rxPct}%;"></div>
            </div>
          </div>
        </td>
        <td class="font-monospace small">${o.tx || '-'}</td>
        <td class="font-monospace small text-muted">${o.distance || '-'}</td>
        <td>
          <div class="small fw-semibold">${uptimeStr}</div>
          <div class="text-muted small font-monospace">${tempVolt ? tempVolt + (o.voltage ? ' • ' + o.voltage : '') : '-'}</div>
        </td>
        <td style="text-align: right; white-space: nowrap;">
          <div class="d-inline-flex gap-1">
            <button type="button" class="action-btn-circle btn-act-detail" onclick="openDetailModal(${startIdx + i})" title="Diagnostik Optik &amp; Sinyal">
              <i class="bi bi-speedometer2"></i>
            </button>
            <a href="/admin/acs?search=${encodeURIComponent(o.sn || '')}" class="action-btn-circle btn-act-acs" title="Buka GenieACS Pro (${o.sn})">
              <i class="bi bi-router"></i>
            </a>
            <button type="button" class="action-btn-circle" onclick="openRenameModal('${o.id || o.index}', '${escapeHtml(o.name || '')}')" title="Ubah Nama di OLT">
              <i class="bi bi-pencil"></i>
            </button>
            <button type="button" class="action-btn-circle btn-act-reboot" onclick="openRebootModal('${o.id || o.index}', '${escapeHtml(o.name || '')}', '${o.sn}')" title="Reboot Modem Remote">
              <i class="bi bi-arrow-repeat"></i>
            </button>
          </div>
        </td>
      </tr>
    `;
  });

  tbody.innerHTML = html;
  document.getElementById('pagination-info').textContent = `Menampilkan ${startIdx + 1} - ${endIdx} dari ${total} modem terdaftar`;

  renderPaginationButtons(totalPages);
}

function renderPaginationButtons(totalPages) {
  const container = document.getElementById('pagination-buttons');
  if (!container) return;

  if (totalPages <= 1) {
    container.innerHTML = '';
    return;
  }

  let btns = `
    <button class="page-nav-btn" onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>
      <i class="bi bi-chevron-left"></i>
    </button>
  `;

  for (let p = 1; p <= totalPages; p++) {
    if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
      btns += `<button class="page-nav-btn ${p === currentPage ? 'active' : ''}" onclick="goToPage(${p})">${p}</button>`;
    } else if (p === currentPage - 2 || p === currentPage + 2) {
      btns += `<span class="px-1 text-muted">...</span>`;
    }
  }

  btns += `
    <button class="page-nav-btn" onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>
      <i class="bi bi-chevron-right"></i>
    </button>
  `;
  container.innerHTML = btns;
}

function goToPage(p) {
  currentPage = p;
  renderTable();
}

function openDetailModal(idx) {
  const item = filteredOnus[idx];
  if (!item) return;

  const isUp = String(item.status || '').toLowerCase() === 'online';
  const rxNum = parseFloat(item.rx);
  let rxEval = 'Sinyal Tidak Terbaca';
  let rxColor = '#94a3b8';
  let rxRecommendation = 'Periksa apakah kabel dropcore tersambung dan laser SFP OLT aktif.';

  if (isUp && Number.isFinite(rxNum)) {
    if (rxNum >= -22) {
      rxEval = 'Sangat Bagus (Optimal)';
      rxColor = '#10b981';
      rxRecommendation = 'Redaman optik sangat ideal untuk kapasitas bandwidth tinggi tanpa packet loss.';
    } else if (rxNum >= -25) {
      rxEval = 'Normal / Cukup';
      rxColor = '#d97706';
      rxRecommendation = 'Koneksi stabil, tetapi disarankan memeriksa konektor patchcord jika terjadi penurunan.';
    } else {
      rxEval = 'Kritis / Redup';
      rxColor = '#dc2626';
      rxRecommendation = 'Redaman terlalu redup (< -25 dBm). Rentan terjadi RTO. Perlu dilakukan perapian sambungan / splicing ulang.';
    }
  }

  const b = document.getElementById('onuDetailModalBody');
  b.innerHTML = `
    <div class="diag-box mb-3">
      <div class="diag-item">
        <span class="label">Identitas Pelanggan:</span>
        <span class="val text-primary">${item.customer_name ? escapeHtml(item.customer_name) : 'Belum Ditautkan'}</span>
      </div>
      <div class="diag-item">
        <span class="label">Nama Modem di OLT:</span>
        <span class="val">${escapeHtml(item.name || '-')}</span>
      </div>
      <div class="diag-item">
        <span class="label">Port PON / Index:</span>
        <span class="val font-monospace">${item.id || item.index || '-'}</span>
      </div>
      <div class="diag-item">
        <span class="label">Perangkat:</span>
        <span class="val">${item.vendor || 'FiberHome'} ${item.model || 'HG6145D2'}</span>
      </div>
      <div class="diag-item">
        <span class="label">Serial Number (SN):</span>
        <span class="val font-monospace">${item.sn || '-'}</span>
      </div>
      <div class="diag-item">
        <span class="label">Status Operasional:</span>
        <span class="val ${isUp ? 'text-success' : 'text-danger'}">${isUp ? '● Online (Aktif)' : '● Offline'}</span>
      </div>
    </div>

    <h6 class="fw-bold mb-2 small text-uppercase text-muted"><i class="bi bi-speedometer2 me-1 text-primary"></i>Kualitas Redaman &amp; Optical Power</h6>
    <div class="diag-box mb-3">
      <div class="diag-item">
        <span class="label">Daya Terima Optik (Rx Power):</span>
        <span class="val" style="color:${rxColor}; font-size:16px;">${item.rx || '-'} <small class="fw-normal">(${rxEval})</small></span>
      </div>
      <div class="diag-item">
        <span class="label">Daya Pancar Modem (Tx Power):</span>
        <span class="val">${item.tx || '-'}</span>
      </div>
      <div class="diag-item">
        <span class="label">Jarak Kabel Fiber (ODN):</span>
        <span class="val">${item.distance ? item.distance : '-'}</span>
      </div>
      <div class="p-2 mt-2 rounded-2 small" style="background:rgba(0,82,204,0.06); border:1px dashed var(--border); font-size:12px;">
        <i class="bi bi-info-circle text-primary me-1"></i> ${rxRecommendation}
      </div>
    </div>

    <h6 class="fw-bold mb-2 small text-uppercase text-muted"><i class="bi bi-cpu me-1 text-danger"></i>Parameter Fisik &amp; Uptime Modem</h6>
    <div class="diag-box">
      <div class="diag-item"><span class="label">Suhu Transceiver Modem:</span> <span class="val">${item.temp || '-'}</span></div>
      <div class="diag-item"><span class="label">Voltase Suplai Adaptor:</span> <span class="val">${item.voltage || '-'}</span></div>
      <div class="diag-item"><span class="label">Waktu Aktif (Uptime):</span> <span class="val">${item.uptime || '-'}</span></div>
      <div class="diag-item"><span class="label">Terakhir Online:</span> <span class="val">${item.last_up || '-'}</span></div>
    </div>
  `;

  openModal('onuDetailModal');
}

function openRebootModal(id, name, sn) {
  currentActionOnu = id;
  document.getElementById('rebootOnuId').textContent = id;
  document.getElementById('rebootOnuName').textContent = name;
  document.getElementById('rebootOnuSn').textContent = sn;
  openModal('rebootOnuModal');
}

async function executeRebootOnu() {
  if (!currentOltId || !currentActionOnu) return;
  const btn = document.getElementById('btnConfirmReboot');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Mengirim sinyal reboot...';

  try {
    const res = await fetch(`/admin/olts/${currentOltId}/onu/${encodeURIComponent(currentActionOnu)}/reboot`, { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      alert('Perintah reboot berhasil dikirim ke modem.');
      closeModal('rebootOnuModal');
      setTimeout(refreshCurrentOlt, 1500);
    } else {
      alert('Gagal reboot: ' + (data.error || 'Unknown error'));
    }
  } catch (e) {
    alert('Error: ' + e.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Ya, Reboot Sekarang';
  }
}

function openRenameModal(id, currentName) {
  currentActionOnu = id;
  document.getElementById('renameOnuId').value = id;
  document.getElementById('renameOnuNewName').value = currentName;
  openModal('renameOnuModal');
}

async function executeRenameOnu() {
  if (!currentOltId || !currentActionOnu) return;
  const newName = document.getElementById('renameOnuNewName').value.trim();
  if (!newName) {
    alert('Nama alias tidak boleh kosong');
    return;
  }

  const btn = document.getElementById('btnConfirmRename');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menyimpan...';

  try {
    const res = await fetch(`/admin/olts/${currentOltId}/onu/${encodeURIComponent(currentActionOnu)}/rename`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: newName })
    });
    const data = await res.json();
    if (data.success) {
      alert('Nama alias modem berhasil diubah.');
      closeModal('renameOnuModal');
      refreshCurrentOlt();
    } else {
      alert('Gagal ubah nama: ' + (data.error || 'Unknown error'));
    }
  } catch (e) {
    alert('Error: ' + e.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Simpan Perubahan';
  }
}

function exportOnuCsv() {
  if (!allOnus || allOnus.length === 0) {
    alert('Tidak ada data modem untuk diexport.');
    return;
  }

  const headers = ['No', 'Port_ID', 'Pelanggan', 'Nama_Alias_OLT', 'PPPoE_User', 'Vendor', 'Model', 'Serial_Number', 'Status', 'TX_Power_dBm', 'RX_Power_dBm', 'Jarak_FO', 'Suhu', 'Voltase', 'Uptime'];
  const rows = allOnus.map((o, idx) => [
    idx + 1,
    `"${o.id || o.index || ''}"`,
    `"${(o.customer_name || '').replace(/"/g, '""')}"`,
    `"${(o.name || '').replace(/"/g, '""')}"`,
    `"${(o.pppoe_username || '').replace(/"/g, '""')}"`,
    `"${o.vendor || 'FiberHome'}"`,
    `"${o.model || 'HG6145D2'}"`,
    `"${o.sn || ''}"`,
    `"${o.status || ''}"`,
    `"${o.tx || ''}"`,
    `"${o.rx || ''}"`,
    `"${o.distance || ''}"`,
    `"${o.temp || ''}"`,
    `"${o.voltage || ''}"`,
    `"${o.uptime || ''}"`
  ]);

  const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
  const encodedUri = encodeURI(csvContent);
  const link = document.createElement('a');
  link.setAttribute('href', encodedUri);
  link.setAttribute('download', `Daftar_Modem_OLT_${currentOltId}_${new Date().toISOString().slice(0,10)}.csv`);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
}

function runDiagnosticPrompt() {
  const sel = document.getElementById('olt-selector');
  if (!sel || !sel.value) return;
  openModal('testSnmpModal');
  const b = document.getElementById('testSnmpModalBody');
  b.innerHTML = '<div class="text-center p-4"><div class="spinner-border text-primary"></div><div class="mt-2 text-muted small">Menguji respon SNMP OLT...</div></div>';
  fetch(`/admin/olts/${sel.value}/test-snmp`, { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        b.innerHTML = `
          <div class="text-center mb-3">
            <div style="width:48px; height:48px; border-radius:50%; background:rgba(16,185,129,0.15); color:#10b981; display:inline-flex; align-items:center; justify-content:center; font-size:24px;">
              <i class="bi bi-check2-circle"></i>
            </div>
            <h6 class="fw-bold mt-2 text-success">Koneksi SNMP v2c Berhasil</h6>
            <span class="badge bs">Latency: ${data.latencyMs} ms</span>
          </div>
          <div class="diag-box">
            <div class="diag-item"><span class="label">Host:</span><span class="val">${data.host}:${data.port}</span></div>
            <div class="diag-item"><span class="label">System Name:</span><span class="val">${data.sysName || '-'}</span></div>
            <div class="diag-item"><span class="label">System Uptime:</span><span class="val text-primary">${data.sysUpTime || '-'}</span></div>
            <div class="diag-item" style="flex-direction:column; align-items:flex-start; gap:4px;">
              <span class="label">Firmware:</span>
              <span class="val" style="font-size:12px;">${data.sysDescr || '-'}</span>
            </div>
          </div>
        `;
      } else {
        b.innerHTML = `
          <div class="text-center mb-3 text-danger">
            <i class="bi bi-x-circle" style="font-size:36px;"></i>
            <h6 class="fw-bold mt-2">Koneksi SNMP Gagal</h6>
            <p class="small text-muted">${data.error || 'Tidak ada respons SNMP.'}</p>
          </div>
        `;
      }
    })
    .catch(e => {
      b.innerHTML = `<div class="text-center text-danger p-3">${e.message}</div>`;
    });
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

document.addEventListener('DOMContentLoaded', () => {
  const sel = document.getElementById('olt-selector');
  const urlParams = new URLSearchParams(window.location.search);
  const paramOltId = urlParams.get('olt_id');

  if (paramOltId && sel) {
    sel.value = paramOltId;
  }
  if (sel && !sel.value) {
    const activeOpt = Array.from(sel.options).find(opt => opt.value && !opt.disabled);
    if (activeOpt) sel.value = activeOpt.value;
  }

  if (sel && sel.value) {
    handleOltChange();
  }
});
</script>
</body>
</html>
