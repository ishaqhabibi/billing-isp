<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' && lang) ? lang : 'id' %>" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
  <title><%= title %> | <%= company %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.8">
  <script src="/js/theme.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    /* ─── FIGCRAFT A02 THEME TOKENS ─── */
    :root, html[data-theme="dark"], body.dark-theme {
      --a02-canvas: #090D16;
      --a02-card: #111827;
      --a02-card-border: rgba(255, 255, 255, 0.08);
      --a02-sub-bg: rgba(255, 255, 255, 0.03);
      --a02-sub-border: rgba(255, 255, 255, 0.07);
      --a02-text-main: #F8FAFC;
      --a02-text-sub: #94A3B8;
      --a02-text-muted: #64748B;
      --a02-footer-bg: #0D1322;
      --a02-card-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
      --a02-pill-bg: rgba(255, 255, 255, 0.06);
      --a02-pill-border: rgba(255, 255, 255, 0.1);
      --a02-chart-grid: rgba(255, 255, 255, 0.06);
      --a02-chart-text: #94A3B8;
      --a02-row-bg: rgba(255, 255, 255, 0.02);
    }

    html[data-theme="light"], body.light-theme {
      --a02-canvas: #EEF1F8;
      --a02-card: #FFFFFF;
      --a02-card-border: #E2E8F0;
      --a02-sub-bg: #F8FAFC;
      --a02-sub-border: #E2E8F0;
      --a02-text-main: #0F172A;
      --a02-text-sub: #334155;
      --a02-text-muted: #5E6D83;
      --a02-footer-bg: #F8FAFC;
      --a02-card-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
      --a02-pill-bg: #F1F5F9;
      --a02-pill-border: #E2E8F0;
      --a02-chart-grid: rgba(0, 0, 0, 0.05);
      --a02-chart-text: #64748B;
      --a02-row-bg: #F8FAFC;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
      background-color: var(--a02-canvas) !important;
      color: var(--a02-text-main) !important;
    }

    /* ─── A02 DASHBOARD WRAPPER & HEADER ─── */
    .a02-dash-container {
      padding: 16px 20px 40px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
      box-sizing: border-box;
    }

    /* ─── FIGCRAFT A02 TOP UTILITY & FLOATING PILL ─── */
    .a02-top-utility {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      height: 40px;
    }
    .a02-breadcrumb {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 13px;
      font-weight: 500;
      color: var(--a02-text-muted);
    }
    .a02-breadcrumb i {
      font-size: 13px;
      color: var(--a02-text-muted);
    }
    .a02-breadcrumb-root {
      color: var(--a02-text-muted);
      text-decoration: none;
    }
    .a02-breadcrumb-slash {
      color: var(--a02-text-muted);
      font-size: 12px;
      opacity: 0.6;
    }
    .a02-breadcrumb-current {
      color: var(--a02-text-main);
      font-weight: 700;
    }

    .a02-utility-dock {
      display: flex;
      align-items: center;
    }
    .a02-floating-pill {
      background: var(--a02-card);
      border: 1px solid var(--a02-card-border);
      border-radius: 999px;
      height: 38px;
      padding: 3px 10px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: var(--a02-card-shadow);
    }
    .a02-pill-icon-btn {
      width: 26px;
      height: 26px;
      border: none;
      background: transparent;
      color: var(--a02-text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      cursor: pointer;
      border-radius: 50%;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .a02-pill-icon-btn:hover {
      background: var(--a02-pill-bg);
      color: #2563EB;
    }
    .a02-theme-pill {
      background: var(--a02-sub-bg);
      border: 1px solid var(--a02-card-border);
      color: var(--a02-text-sub);
      padding: 2px 10px;
      border-radius: 999px;
      height: 26px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }
    .a02-theme-pill:hover {
      background: var(--a02-pill-bg);
      color: var(--a02-text-main);
    }

    /* ─── FIGCRAFT A02 HERO TOOLBAR WRAP ─── */
    .a02-hero-toolbar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .a02-hero-text {
      flex: 1;
      min-width: 280px;
    }
    .a02-hero-over {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.8px;
      color: var(--a02-text-muted);
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .a02-hero-title {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--a02-text-main);
      margin: 0;
      line-height: 1.25;
    }
    .a02-hero-sub {
      font-size: 12.5px;
      color: var(--a02-text-muted);
      margin-top: 5px;
      max-width: 720px;
      line-height: 1.45;
    }

    .a02-hero-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }
    .a02-btn-range {
      background: var(--a02-card);
      border: 1px solid var(--a02-card-border);
      color: var(--a02-text-sub);
      height: 36px;
      padding: 0 14px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      box-shadow: var(--a02-card-shadow);
      transition: all 0.15s ease;
    }
    .a02-btn-range:hover {
      background: var(--a02-pill-bg);
      color: var(--a02-text-main);
    }
    .a02-btn-sync {
      background: #2563EB;
      color: #FFFFFF !important;
      border: none;
      height: 36px;
      padding: 0 16px;
      border-radius: 8px;
      font-size: 12.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
      transition: all 0.15s ease;
    }
    .a02-btn-sync:hover {
      background: #1D4ED8;
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
    }

    /* ─── ROW 1: 4 FIGCRAFT KPI METRIC CARDS ─── */
    .a02-kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
    .a02-kpi-card {
      background: var(--a02-card);
      border: 1px solid var(--a02-card-border);
      border-radius: 14px;
      padding: 16px 18px 14px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 104px;
      box-shadow: var(--a02-card-shadow);
      position: relative;
      overflow: hidden;
      transition: all 0.2s ease;
      text-decoration: none;
      color: inherit;
    }
    .a02-kpi-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.12);
      border-color: rgba(37, 99, 235, 0.3);
    }
    .a02-kpi-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }
    .a02-kpi-label {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--a02-text-muted);
    }
    .a02-kpi-icon {
      font-size: 15px;
      color: var(--a02-text-muted);
      opacity: 0.8;
    }
    .a02-kpi-value {
      font-size: 24px;
      font-weight: 800;
      line-height: 1.15;
      font-variant-numeric: tabular-nums;
      margin-bottom: 8px;
    }
    .a02-kpi-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      color: var(--a02-text-muted);
      border-top: 1px dashed var(--a02-card-border);
      padding-top: 8px;
    }
    .a02-badge {
      font-size: 10.5px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 3px;
    }
    .a02-badge-blue { background: rgba(37, 99, 235, 0.12); color: #2563EB; }
    html[data-theme="dark"] .a02-badge-blue { color: #60A5FA; background: rgba(37, 99, 235, 0.2); }
    .a02-badge-indigo { background: rgba(79, 70, 229, 0.12); color: #4F46E5; }
    html[data-theme="dark"] .a02-badge-indigo { color: #818CF8; background: rgba(79, 70, 229, 0.2); }
    .a02-badge-green { background: rgba(16, 185, 129, 0.12); color: #047857; }
    html[data-theme="dark"] .a02-badge-green { color: #34D399; background: rgba(16, 185, 129, 0.2); }
    .a02-badge-amber { background: rgba(245, 158, 11, 0.12); color: #B45309; }
    html[data-theme="dark"] .a02-badge-amber { color: #FBBF24; background: rgba(245, 158, 11, 0.2); }

    /* ─── 2-COLUMN SPLIT GRID (60% / 40%) ─── */
    .a02-chart-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 16px;
    }
    .a02-chart-card {
      background: var(--a02-card);
      border: 1px solid var(--a02-card-border);
      border-radius: 14px;
      box-shadow: var(--a02-card-shadow);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .a02-card-head {
      padding: 16px 20px 12px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    .a02-card-title {
      font-size: 14px;
      font-weight: 800;
      color: var(--a02-text-main);
      margin: 0;
    }
    .a02-card-sub {
      font-size: 11px;
      color: var(--a02-text-muted);
      margin-top: 3px;
    }
    .a02-card-pill {
      font-size: 10px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      white-space: nowrap;
    }
    .a02-card-body {
      padding: 0 20px 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .a02-legend-row {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 10.5px;
      color: var(--a02-text-muted);
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .a02-legend-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .a02-legend-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }

    .a02-card-footer {
      background: var(--a02-footer-bg);
      border-top: 1px solid var(--a02-card-border);
      padding: 10px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      color: var(--a02-text-muted);
    }

    /* Donut Chart Specifics */
    .a02-donut-row {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 18px;
      align-items: center;
    }
    .a02-donut-wrap {
      position: relative;
      width: 140px;
      height: 140px;
      margin: 0 auto;
    }
    .a02-donut-center {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }
    .a02-donut-num {
      font-size: 22px;
      font-weight: 800;
      line-height: 1;
      color: var(--a02-text-main);
    }
    .a02-donut-lbl {
      font-size: 9.5px;
      color: var(--a02-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 3px;
    }

    .a02-breakdown-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .a02-breakdown-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      padding: 4px 8px;
      border-radius: 6px;
      background: var(--a02-row-bg);
      border: 1px solid var(--a02-card-border);
    }
    .a02-breakdown-row strong {
      font-variant-numeric: tabular-nums;
      font-weight: 700;
    }

    /* Router & OLT Progress Rows */
    .a02-device-list {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }
    .a02-device-row {
      background: var(--a02-row-bg);
      border: 1px solid var(--a02-card-border);
      border-radius: 8px;
      padding: 9px 12px;
    }
    .a02-device-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11.5px;
      margin-bottom: 5px;
    }
    .a02-device-title {
      font-weight: 700;
      color: var(--a02-text-main);
    }
    .a02-device-stat {
      font-weight: 700;
      font-size: 11px;
      color: var(--a02-text-muted);
    }
    .a02-multi-bar {
      display: flex;
      height: 6px;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(148, 163, 184, 0.15);
      gap: 2px;
    }
    .a02-bar-seg {
      height: 100%;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    /* ─── RESPONSIVE BREAKPOINTS (A02 HP FIGCRAFT) ─── */
    @media (max-width: 1024px) {
      .a02-kpi-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .a02-chart-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .a02-dash-container {
        padding: 12px 10px 80px;
        gap: 12px;
      }
      .a02-kpi-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
      }
      .a02-kpi-card {
        padding: 12px 14px 10px;
        min-height: 92px;
      }
      .a02-kpi-value {
        font-size: 18px;
      }
      .a02-donut-row {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .a02-hero-title {
        font-size: 18px;
      }
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'dashboard', company }) %>

<div class="mw">
  <div class="a02-dash-container">
    
    <!-- ── TOP UTILITY & BREADCRUMB BAR (FIGCRAFT A02) ── -->
    <div class="a02-top-utility">
      <div class="a02-breadcrumb">
        <i class="bi bi-grid-1x2"></i>
        <span class="a02-breadcrumb-root">Workspace</span>
        <span class="a02-breadcrumb-slash">/</span>
        <span class="a02-breadcrumb-current">Beranda Utama</span>
      </div>

      <div class="a02-utility-dock">
        <div class="a02-floating-pill">
          <button type="button" class="a02-pill-icon-btn" title="Pengaturan Sidebar" onclick="location.href='/admin/sidebar-settings'">
            <i class="bi bi-grid-3x3-gap"></i>
          </button>
          <button type="button" class="a02-theme-pill" onclick="toggleAppTheme()" title="Ganti Mode Tema">
            <i class="bi bi-moon-stars-fill theme-toggle-icon" style="color:#fbbf24"></i>
            <span id="themeToggleText">Mode Gelap</span>
          </button>
          <button type="button" class="a02-pill-icon-btn" title="Notifikasi Tiket" onclick="location.href='/admin/tickets'">
            <i class="bi bi-bell"></i>
          </button>
          <a href="/admin/settings" class="a02-pill-icon-btn" title="Pengaturan Akun">
            <i class="bi bi-person-circle"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- ── MAIN TOOLBAR HERO (FIGCRAFT A02) ── -->
    <div class="a02-hero-toolbar">
      <div class="a02-hero-text">
        <div class="a02-hero-over">PUSAT PANTAU INFRASTRUKTUR NOC &bull; MIKROTIK &bull; RADIUS &bull; GENIEACS &bull; OLT</div>
        <h1 class="a02-hero-title">Beranda Infrastruktur &amp; Telemetri Jaringan</h1>
        <p class="a02-hero-sub">
          Visualisasi kesehatan router MikroTik, autentikasi FreeRADIUS, redaman optik GenieACS (TR-069), dan utilisasi OLT dalam satu konsol.
        </p>
      </div>

      <div class="a02-hero-actions">
        <!-- Date Range Filter -->
        <button type="button" class="a02-btn-range" id="btnDateRange" title="Rentang Waktu Laporan">
          <span>Rentang: 7 Hari</span> <i class="bi bi-chevron-down" style="font-size:10px;"></i>
        </button>

        <!-- Cek Sinkronisasi Primary Button -->
        <button type="button" class="a02-btn-sync" onclick="refreshAll()" title="Perbarui data realtime MikroTik &amp; GenieACS">
          <i class="bi bi-arrow-clockwise" id="dash-refresh-icon"></i>
          <span>Cek Sinkronisasi</span>
        </button>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- VIEW 1: TELEMETRI JARINGAN & NOC (FIGCRAFT A02 CORE DESIGN) -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="viewSectionTelemetry" style="display:flex; flex-direction:column; gap:16px;">
      
      <!-- ── ROW 1: 4 FIGCRAFT KPI METRIC CARDS ── -->
      <div class="a02-kpi-grid">
        <!-- 1. Sesi PPPoE (RADIUS) -->
        <div class="a02-kpi-card">
          <div class="a02-kpi-top">
            <span class="a02-kpi-label">Sesi PPPoE (RADIUS)</span>
            <i class="bi bi-person-fill a02-kpi-icon"></i>
          </div>
          <div class="a02-kpi-value" style="color:var(--a02-text-main);">
            <%= (custStats && custStats.active) || 0 %> / <%= (custStats && custStats.total) || 0 %>
          </div>
          <div class="a02-kpi-bottom">
            <span><%= (custStats && custStats.suspended) || 0 %> Terisolir &bull; <%= Math.max(0, ((custStats && custStats.total) || 0) - ((custStats && custStats.active) || 0) - ((custStats && custStats.suspended) || 0)) %> Putus</span>
            <% const actPct = (custStats && custStats.total > 0) ? Math.round((custStats.active / custStats.total) * 100) : 100; %>
            <span class="a02-badge a02-badge-blue"><%= actPct %>% Aktif</span>
          </div>
        </div>

        <!-- 2. Router MikroTik -->
        <div class="a02-kpi-card">
          <div class="a02-kpi-top">
            <span class="a02-kpi-label">Router MikroTik</span>
            <i class="bi bi-hdd-network-fill a02-kpi-icon"></i>
          </div>
          <div class="a02-kpi-value" style="color:#4F46E5;">
            <%= (routers && routers.length) ? routers.filter(r => r.is_active !== 0).length : 1 %> / <%= (routers && routers.length) ? routers.length : 1 %> Aktif
          </div>
          <div class="a02-kpi-bottom">
            <span id="kpi-router-sub"><%= (routers && routers.length > 0 && routers[0].name) ? routers[0].name : 'Core Router' %> &bull; API</span>
            <span class="a02-badge a02-badge-indigo" id="kpi-router-status-badge">Sinkron</span>
          </div>
        </div>

        <!-- 3. GenieACS (TR-069) -->
        <div class="a02-kpi-card">
          <div class="a02-kpi-top">
            <span class="a02-kpi-label">GenieACS (TR-069)</span>
            <i class="bi bi-broadcast-pin a02-kpi-icon"></i>
          </div>
          <div class="a02-kpi-value" style="color:#047857;">
            <span id="kpi-ont-active-val">-</span> / <span id="kpi-ont-total-val">-</span> ONT
          </div>
          <div class="a02-kpi-bottom">
            <span id="kpi-ont-inform-val">- Inform</span>
            <span class="a02-badge a02-badge-green" id="kpi-ont-pct-badge">- % Aktif</span>
          </div>
        </div>

        <!-- 4. Unit & Port OLT -->
        <div class="a02-kpi-card">
          <div class="a02-kpi-top">
            <span class="a02-kpi-label">Unit &amp; Port OLT</span>
            <i class="bi bi-shield-check a02-kpi-icon"></i>
          </div>
          <div class="a02-kpi-value" style="color:#B45309;">
            <span id="kpi-olt-val">2 OLT &bull; 16 PON</span>
          </div>
          <div class="a02-kpi-bottom">
            <span id="kpi-olt-sub">Normal Sinyal</span>
            <span class="a02-badge a02-badge-amber" id="kpi-olt-badge">Optimal</span>
          </div>
        </div>
      </div>

      <!-- ── ROW 2: FIGCRAFT CHARTS ROW 1 (60% / 40%) ── -->
