// ── TOAST NOTIFICATION ─────────────────────────────────────────
function showToast(msg, type = 's') {
  const old = document.querySelector('.toast-notif');
  if (old) old.remove();
  
  const t = document.createElement('div');
  t.className = 'toast-notif';
  t.style.cssText = `position:fixed;bottom:32px;right:32px;z-index:10000;background:var(--bg2);border-left:5px solid var(--${type==='s'?'success':'danger'});border-radius:8px;padding:16px 24px;font-size:14px;display:flex;align-items:center;gap:12px;box-shadow:0 12px 32px rgba(0,0,0,.5);animation:slideInRight .3s ease;color:var(--text);min-width:300px`;
  
  const icon = type === 's' ? 'check-circle-fill' : 'exclamation-circle-fill';
  const color = type === 's' ? 'var(--success)' : 'var(--danger)';
  
  t.innerHTML = `
    <i class="bi bi-${icon}" style="font-size:20px;color:${color}"></i>
    <div style="flex:1">
      <div style="font-weight:600;margin-bottom:2px">${type === 's' ? I18N.success : I18N.failed}</div>
      <div style="color:var(--muted);font-size:13px">${msg}</div>
    </div>
    <button onclick="this.parentElement.remove()" style="background:none;border:none;color:var(--muted);cursor:pointer;padding:4px"><i class="bi bi-x-lg"></i></button>
  `;
  document.body.appendChild(t);
  setTimeout(() => { if(t.parentElement) t.style.animation = 'slideOutRight .3s ease forwards'; setTimeout(() => t.remove(), 300); }, 5000);
}

// ── SYSTEM HEALTH CHECK (MikroTik & GenieACS Real Status) ──────
async function checkSystemHealth(force = false) {
  try {
    const res = await fetch('/admin/api/system-health' + (force ? '?force=1' : ''));
    if (!res.ok) return;
    const data = await res.json();

    // 1. Update MikroTik Gateway Status
    const mt = data.mikrotik || {};
    const routerNameEl = document.getElementById('header-router-name');
    const routerHostEl = document.getElementById('header-router-host');
    const routerBadgeEl = document.getElementById('header-router-badge');
    const routerDotEl = document.getElementById('header-router-dot');
    const dashRouterBadge = document.getElementById('dash-router-badge');
    const dashRouterSubtext = document.getElementById('dash-router-subtext');

    if (routerNameEl && mt.name && mt.name !== '-') routerNameEl.textContent = mt.name;
    if (routerHostEl && mt.host && mt.host !== '-') routerHostEl.textContent = '(' + mt.host + ')';
    if (dashRouterSubtext && mt.host && mt.host !== '-') {
      dashRouterSubtext.textContent = mt.host + ' • ' + (mt.name || 'Mikrotik');
    }

    if (!mt.configured) {
      if (routerDotEl) routerDotEl.className = 'dot dot-off';
      if (routerBadgeEl) { routerBadgeEl.className = 'badge bw'; routerBadgeEl.textContent = 'Belum Diatur'; routerBadgeEl.title = mt.message || ''; }
      if (dashRouterBadge) { dashRouterBadge.className = 'pill-badge pb-amber'; dashRouterBadge.textContent = 'Belum Diatur'; dashRouterBadge.title = mt.message || ''; }
    } else if (mt.connected) {
      if (routerDotEl) routerDotEl.className = 'dot dot-on';
      if (routerBadgeEl) { routerBadgeEl.className = 'badge bs'; routerBadgeEl.textContent = 'Terhubung'; routerBadgeEl.title = 'Terhubung ke router API'; }
      if (dashRouterBadge) { dashRouterBadge.className = 'pill-badge pb-emerald'; dashRouterBadge.textContent = 'Terhubung'; dashRouterBadge.title = 'Terhubung ke router API'; }
    } else {
      if (routerDotEl) routerDotEl.className = 'dot dot-off';
      if (routerBadgeEl) { routerBadgeEl.className = 'badge bd'; routerBadgeEl.textContent = 'Terputus'; routerBadgeEl.title = mt.message || 'Koneksi gagal'; }
      if (dashRouterBadge) { dashRouterBadge.className = 'pill-badge pb-rose'; dashRouterBadge.textContent = 'Terputus'; dashRouterBadge.title = mt.message || 'Koneksi gagal'; }
    }

    // 2. Update GenieACS TR-069 Status
    const acs = data.genieacs || {};
    const tr069DotEl = document.getElementById('header-tr069-dot');
    const tr069BadgeEl = document.getElementById('header-tr069-badge');
    const tr069SyncEl = document.getElementById('header-sync-time');

    if (!acs.configured) {
      if (tr069DotEl) tr069DotEl.className = 'dot dot-off';
      if (tr069BadgeEl) { tr069BadgeEl.className = 'badge bw'; tr069BadgeEl.textContent = 'Belum Diatur'; tr069BadgeEl.title = acs.message || ''; }
      if (tr069SyncEl) { tr069SyncEl.textContent = '-'; tr069SyncEl.style.color = 'var(--muted)'; }
    } else if (acs.connected) {
      if (tr069DotEl) tr069DotEl.className = 'live-dot';
      if (tr069BadgeEl) {
        tr069BadgeEl.className = 'badge bs';
        tr069BadgeEl.textContent = acs.deviceCount > 0 ? 'Aktif' : 'Online (0 ONU)';
        tr069BadgeEl.title = acs.message || '';
      }
      if (tr069SyncEl && acs.lastSync) {
        tr069SyncEl.textContent = new Date(acs.lastSync).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        tr069SyncEl.style.color = 'var(--text)';
      }
    } else {
      if (tr069DotEl) tr069DotEl.className = 'dot dot-off';
      if (tr069BadgeEl) {
        tr069BadgeEl.className = 'badge bd';
        tr069BadgeEl.textContent = (acs.mode === 'builtin' && acs.deviceCount === 0) ? 'Belum Ada ONU' : 'Terputus';
        tr069BadgeEl.title = acs.message || 'GenieACS tidak terhubung';
      }
      if (tr069SyncEl) { tr069SyncEl.textContent = '-'; tr069SyncEl.style.color = 'var(--muted)'; }
    }
  } catch (err) {
    console.error('Check system health error:', err);
  }
}

