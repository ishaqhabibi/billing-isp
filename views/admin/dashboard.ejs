<script>

  // ── FIGCRAFT A02 DYNAMIC CHARTS INITIALIZATION ──
  let radiusChartInstance = null;
  let tr069ChartInstance = null;

  function initFigCraftA02Charts() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || document.body.classList.contains('dark-theme');
    const gridColor = isDark ? 'rgba(255, 255, 255, 0.06)' : 'rgba(0, 0, 0, 0.06)';
    const textColor = isDark ? '#94A3B8' : '#64748B';

    // 1. Aktivitas Autentikasi & CoA FreeRADIUS (Stacked Bar)
    const ctxRadius = document.getElementById('chartRadiusAuth');
    if (ctxRadius) {
      if (radiusChartInstance) radiusChartInstance.destroy();
      radiusChartInstance = new Chart(ctxRadius, {
        type: 'bar',
        data: {
          labels: ['Sen', 'Sel (Tgl 1)', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'],
          datasets: [
            {
              label: 'Access-Accept (Lolos)',
              data: [120, 145, 130, 126, 134, 118, 128],
              backgroundColor: '#10B981',
              borderRadius: 3,
              stack: 'auth'
            },
            {
              label: 'CoA Isolir & Pulih',
              data: [8, 15, 6, 7, 9, 5, 8],
              backgroundColor: '#2563EB',
              borderRadius: 3,
              stack: 'auth'
            },
            {
              label: 'Access-Reject / Duplikat MAC',
              data: [3, 4, 2, 3, 2, 2, 3],
              backgroundColor: '#EF4444',
              borderRadius: 4,
              stack: 'auth'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: isDark ? '#1E293B' : '#0F172A',
              titleFont: { family: 'Plus Jakarta Sans', weight: '700' },
              bodyFont: { family: 'Plus Jakarta Sans' },
              padding: 10,
              cornerRadius: 8
            }
          },
          scales: {
            x: {
              stacked: true,
              grid: { display: false },
              ticks: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 10.5 } }
            },
            y: {
              stacked: true,
              grid: { color: gridColor },
              ticks: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 10 } }
            }
          }
        }
      });
    }

    // 2. Tren Kejadian GenieACS TR-069 (Grouped Bar)
    const ctxTr069 = document.getElementById('chartTr069Events');
    if (ctxTr069) {
      if (tr069ChartInstance) tr069ChartInstance.destroy();
      tr069ChartInstance = new Chart(ctxTr069, {
        type: 'bar',
        data: {
          labels: ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'],
          datasets: [
            {
              label: 'Auto-Push Sukses',
              data: [6, 9, 7, 11, 10, 6, 12],
              backgroundColor: '#10B981',
              borderRadius: 3
            },
            {
              label: 'Laser Out / LOS',
              data: [1, 2, 1, 1, 2, 1, 1],
              backgroundColor: '#EF4444',
              borderRadius: 3
            },
            {
              label: 'Dying Gasp / Padam',
              data: [2, 1, 3, 2, 4, 2, 2],
              backgroundColor: '#F59E0B',
              borderRadius: 3
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: isDark ? '#1E293B' : '#0F172A',
              titleFont: { family: 'Plus Jakarta Sans', weight: '700' },
              bodyFont: { family: 'Plus Jakarta Sans' },
              padding: 10,
              cornerRadius: 8
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 10.5 } }
            },
            y: {
              grid: { color: gridColor },
              ticks: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 10 } }
            }
          }
        }
      });
    }
  }

  // Segment Tab Switcher Function
  function switchA02View(viewName) {
    const secTel = document.getElementById('viewSectionTelemetry');
    const secFin = document.getElementById('viewSectionFinance');
    const secMon = document.getElementById('monitoring-section');
    
    const btnTel = document.getElementById('tabBtnTelemetry');
    const btnFin = document.getElementById('tabBtnFinance');
    const btnMon = document.getElementById('tabBtnMonitoring');

    if (btnTel) btnTel.classList.remove('active');
    if (btnFin) btnFin.classList.remove('active');
    if (btnMon) btnMon.classList.remove('active');

    if (secTel) secTel.style.display = 'none';
    if (secFin) secFin.style.display = 'none';
    if (secMon) secMon.style.display = 'none';

    if (viewName === 'telemetry') {
      if (secTel) secTel.style.display = 'flex';
      if (btnTel) btnTel.classList.add('active');
      window.location.hash = '#telemetry';
      setTimeout(() => { if (radiusChartInstance) radiusChartInstance.resize(); if (tr069ChartInstance) tr069ChartInstance.resize(); }, 50);
    } else if (viewName === 'finance') {
      if (secFin) secFin.style.display = 'flex';
      if (btnFin) btnFin.classList.add('active');
      window.location.hash = '#finance';
    } else if (viewName === 'monitoring') {
      if (secMon) secMon.style.display = 'block';
      if (btnMon) btnMon.classList.add('active');
      window.location.hash = '#monitoring';
    }
  }

  // Update Donut with FigCraft styling and indicators
  const originalUpdateDonut = window.updateDonut;
  window.addEventListener('DOMContentLoaded', () => {
    initFigCraftA02Charts();
  });
  window.addEventListener('appThemeChanged', () => {
    setTimeout(initFigCraftA02Charts, 100);
  });


/*
 * ═══════════════════════════════════════════════════════════════════════════
 * DASHBOARD ONU MONITORING - AUTO-REFRESH DISABLED
 * ═══════════════════════════════════════════════════════════════════════════
 * 
 * AUTO-REFRESH INTENTIONALLY DISABLED TO PREVENT CONTINUOUS POLLING
 * 
 * Previously, this dashboard would refresh automatically:
 * - Every 30 seconds (setInterval at the bottom)
 * - Every 5 seconds during sync operations (scheduleFastRefreshIfNeeded)
 * 
 * All auto-refresh mechanisms have been disabled. The dashboard will:
 * - Load data once when the page is first opened
 * - Only refresh when the user manually clicks the "Refresh" button
 * - NOT refresh automatically during operations
 * 
 * If you need to update the data, click the "Refresh" button in the UI.
 * ═══════════════════════════════════════════════════════════════════════════
 */

// ── STATE ──────────────────────────────────────────────────────
let devicesData = [];
let donutChart = null;
let fastRefreshTimer = null;
let autoRefreshDisabled = true;  // Disable all auto-refresh mechanisms

function escHtml(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
const I18N = {
  pageDashboard: "<%= t('admin.nav.dashboard', 'Dashboard') %>",
  pageMonitoring: "<%= t('admin.dashboard.monitoring_onu', 'Monitoring ONU') %>",
  online: "<%= t('admin.dashboard.online', 'Online') %>",
  offline: "<%= t('admin.dashboard.offline', 'Offline') %>",
  allStatus: "<%= t('common.all_status', 'Semua Status') %>",
  refresh: "<%= t('common.refresh', 'Refresh') %>",
  devicesSuffix: " <%= t('admin.dashboard.devices_suffix', 'perangkat') %>",
