<script>
  function switchTab(tabId) {
    document.querySelectorAll('.mtab, .seg-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(c => c.style.display = 'none');
    
    const targetBtn = document.getElementById('tab-btn-' + tabId);
    const targetPane = document.getElementById('tab-content-' + tabId);
    
    if (targetBtn) targetBtn.classList.add('active');
    if (targetPane) targetPane.style.display = 'block';

    try {
      localStorage.setItem('radius_active_tab', tabId);
      history.replaceState(null, null, '#' + tabId);
    } catch(e) {}
  }

  // Restore active tab from hash or localStorage
  document.addEventListener('DOMContentLoaded', () => {
    let initialTab = 'online';
    const hash = window.location.hash.replace('#', '');
    if (hash && ['online', 'settings', 'nas', 'accounting'].includes(hash)) {
      initialTab = hash;
    } else {
      const savedTab = localStorage.getItem('radius_active_tab');
      if (savedTab && ['online', 'settings', 'nas', 'accounting'].includes(savedTab)) {
        initialTab = savedTab;
      }
    }
    switchTab(initialTab);

    // Initial table filter check
    filterRadiusOnlineTable();

    // Start auto-refresh by default if checked
    const autoBox = document.getElementById('autoRefreshOnline');
    if (autoBox && autoBox.checked) {
      startOnlineAutoRefresh();
    }
  });

  // ─── RADIUS SERVICE TOGGLE ───
  async function toggleRadiusAction(action, btn) {
    let originalHtml = '';
    if (btn) {
      originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i> Memproses...';
    }
    
    try {
      const res = await fetch('/admin/radius/' + action, {
        method: 'POST',
        headers: { 
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      if (res.status === 401) {
        showToast('d', 'Sesi login telah berakhir. Halaman dialihkan ke login.');
        window.location.href = '/admin/login';
        return;
      }

      const data = await res.json().catch(() => null);

      if (res.ok && data && data.success) {
        showToast('s', data.message || 'Layanan RADIUS berhasil diperbarui.');
        setTimeout(() => window.location.reload(), 600);
      } else {
        const errorMsg = (data && (data.error || data.message)) || ('Gagal memproses aksi RADIUS (Status: ' + res.status + ')');
        showToast('d', errorMsg);
      }
    } catch (e) {
      showToast('d', 'Koneksi aksi RADIUS terputus: ' + e.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        if (originalHtml) btn.innerHTML = originalHtml;
      }
    }
  }

  // ─── SEARCH & FILTER ONLINE SESSIONS ───
  function filterRadiusOnlineTable() {
    const q = (document.getElementById('radiusSearchInput')?.value || '').toLowerCase().trim();
    const nasFilter = (document.getElementById('radiusNasFilter')?.value || '').trim();
    const clearBtn = document.getElementById('radiusClearSearch');
    if (clearBtn) clearBtn.style.display = q ? 'block' : 'none';

    const rows = document.querySelectorAll('.radius-session-row');
    let visibleCount = 0;

    rows.forEach(r => {
      const username = r.getAttribute('data-username') || '';
      const customer = r.getAttribute('data-customer') || '';
      const ip = r.getAttribute('data-ip') || '';
      const nas = r.getAttribute('data-nas') || '';

      const matchQ = !q || username.includes(q) || customer.includes(q) || ip.includes(q) || nas.includes(q);
      const matchNas = !nasFilter || nas === nasFilter;

      if (matchQ && matchNas) {
        r.style.display = '';
        visibleCount++;
      } else {
        r.style.display = 'none';
      }
    });

    const countEl = document.getElementById('filteredSessionCount');
    if (countEl) countEl.textContent = visibleCount;

    const searchEmpty = document.getElementById('radiusOnlineSearchEmpty');
    const tableEl = document.getElementById('radiusOnlineTable');
    if (rows.length > 0) {
      if (searchEmpty) searchEmpty.style.display = visibleCount === 0 ? 'block' : 'none';
      if (tableEl) tableEl.style.display = visibleCount === 0 ? 'none' : '';
    }
  }

  function clearRadiusSearch() {
    const searchInput = document.getElementById('radiusSearchInput');
    const nasFilter = document.getElementById('radiusNasFilter');
    if (searchInput) searchInput.value = '';
    if (nasFilter) nasFilter.value = '';
    filterRadiusOnlineTable();
    if (searchInput) searchInput.focus();
  }

  // ─── AJAX DISCONNECT RADIUS SESSION ───
  async function disconnectRadiusSession(username, sessionId, nasIp, btn) {
    if (!confirm(`Putuskan sesi aktif RADIUS untuk user "${username}"?`)) return;

    let originalHtml = '';
    if (btn) {
      originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i>';
    }

    try {
      const res = await fetch('/admin/radius/disconnect', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          username: username,
          session_id: sessionId,
          nas_ip: nasIp
        })
      });

      const data = await res.json().catch(() => null);

      if (res.ok && data && data.success) {
        showToast('s', data.message || `Sesi user "${username}" berhasil diputus.`);

        // Animate row removal
        const row = btn ? btn.closest('tr') : null;
        if (row) {
          row.style.transition = 'all 0.35s ease';
          row.style.opacity = '0';
          row.style.transform = 'translateX(20px)';
          setTimeout(() => {
            row.remove();
            recalcSessionCounts();
          }, 350);
        }
      } else {
        const errorMsg = (data && (data.error || data.message)) || ('Gagal memutus sesi RADIUS (Status: ' + res.status + ')');
        showToast('d', errorMsg);
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      }
    } catch (e) {
      showToast('d', 'Koneksi error: ' + e.message);
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    }
  }

  function recalcSessionCounts() {
    const rows = document.querySelectorAll('.radius-session-row');
    const total = rows.length;
    
    const kpiCount = document.getElementById('kpi-online-count');
    if (kpiCount) kpiCount.textContent = total;

    const badgeCount = document.getElementById('badge-online-count');
    if (badgeCount) badgeCount.textContent = total;

    const indicatorLabel = document.getElementById('online-counter-label');
    if (indicatorLabel) indicatorLabel.textContent = `${total} Sesi Terhubung`;

    const emptyBox = document.getElementById('radiusOnlineEmptyState');
    const tableEl = document.getElementById('radiusOnlineTable');
    if (total === 0) {
      if (emptyBox) emptyBox.style.display = 'block';
      if (tableEl) tableEl.style.display = 'none';
    }

    filterRadiusOnlineTable();
  }

  // ─── LIVE AUTO-SYNC & REFRESH ───
  let onlineCountdownSec = 10;
  let onlineCountdownInterval = null;

  function toggleAutoRefreshOnline(checkbox) {
    if (checkbox.checked) {
      startOnlineAutoRefresh();
      showToast('i', 'Live auto-sync sesi RADIUS aktif (interval 10 detik).');
    } else {
      stopOnlineAutoRefresh();
      showToast('i', 'Live auto-sync dinonaktifkan.');
    }
  }

  function startOnlineAutoRefresh() {
    stopOnlineAutoRefresh();
    onlineCountdownSec = 10;
    updateOnlineTimerBadge();

    onlineCountdownInterval = setInterval(() => {
      onlineCountdownSec--;
      if (onlineCountdownSec <= 0) {
        onlineCountdownSec = 10;
        refreshOnlineSessions(true);
      }
      updateOnlineTimerBadge();
    }, 1000);
  }

  function stopOnlineAutoRefresh() {
    if (onlineCountdownInterval) clearInterval(onlineCountdownInterval);
    onlineCountdownInterval = null;
    const badge = document.getElementById('onlineTimerCountdown');
    if (badge) badge.textContent = 'Pause';
  }

  function updateOnlineTimerBadge() {
    const badge = document.getElementById('onlineTimerCountdown');
    if (badge) badge.textContent = `${onlineCountdownSec}s`;
  }

  async function refreshOnlineSessions(silent) {
    const btn = document.getElementById('btnManualRefreshOnline');
    const icon = document.getElementById('iconRefreshOnline');
    if (!silent && icon) icon.classList.add('spin');
    if (!silent && btn) btn.disabled = true;

    try {
      const res = await fetch('/admin/api/radius/online-sessions', {
        headers: { 'Accept': 'application/json' }
      });
      const data = await res.json().catch(() => null);

      if (res.ok && data && data.success) {
        renderOnlineSessionsTable(data.sessions || []);
        if (!silent) showToast('s', `Data sesi online diperbarui (${(data.sessions || []).length} sesi aktif).`);
      }
    } catch (e) {
      if (!silent) showToast('d', 'Gagal memuat sesi online: ' + e.message);
    } finally {
      if (!silent && icon) icon.classList.remove('spin');
      if (!silent && btn) btn.disabled = false;
    }
  }

  function formatBytes(bytes) {
    if (!bytes || isNaN(bytes)) return '0.00 MB';
    if (bytes >= 1073741824) return (bytes / 1073741824).toFixed(2) + ' GB';
    return (bytes / 1048576).toFixed(2) + ' MB';
  }

  function formatDuration(sec) {
    sec = parseInt(sec, 10) || 0;
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    const s = sec % 60;
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function renderOnlineSessionsTable(sessions) {
    const tbody = document.getElementById('radiusOnlineTableBody');
    const emptyBox = document.getElementById('radiusOnlineEmptyState');
    const tableEl = document.getElementById('radiusOnlineTable');

    const total = sessions.length;
    const kpiCount = document.getElementById('kpi-online-count');
    if (kpiCount) kpiCount.textContent = total;
    const badgeCount = document.getElementById('badge-online-count');
    if (badgeCount) badgeCount.textContent = total;
    const indicatorLabel = document.getElementById('online-counter-label');
    if (indicatorLabel) indicatorLabel.textContent = `${total} Sesi Terhubung`;

    if (!sessions || sessions.length === 0) {
      if (tbody) tbody.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
      if (tableEl) tableEl.style.display = 'none';
      filterRadiusOnlineTable();
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';
    if (tableEl) tableEl.style.display = '';

    let html = '';
    sessions.forEach((s, idx) => {
      const totalIn = ((s.input_gigawords || 0) * 4294967296) + (s.input_octets || 0);
      const totalOut = ((s.output_gigawords || 0) * 4294967296) + (s.output_octets || 0);
      const inMB = formatBytes(totalIn);
      const outMB = formatBytes(totalOut);
      const stStr = formatDuration(s.session_time || 0);
      const rowKey = s.session_id ? `sess-${String(s.session_id).replace(/[^a-zA-Z0-9_-]/g, '')}` : `user-${s.username}`;

      html += `
        <tr id="radius-row-${rowKey}" class="radius-session-row" 
            data-username="${(s.username || '').toLowerCase()}" 
            data-customer="${(s.customer_name || '').toLowerCase()}" 
            data-ip="${s.framed_ip || ''}" 
            data-nas="${s.nas_ip || ''}">
          <td style="color:var(--muted);font-size:11px;font-family:monospace;">${idx + 1}</td>
          <td>
            <div style="font-weight:700;color:var(--text);display:flex;align-items:center;gap:6px;">
              <span>${s.username}</span>
              <button type="button" class="btn-copy-sm" onclick="copyText('${s.username}', this)" title="Salin Username">
                <i class="bi bi-copy"></i>
              </button>
            </div>
            <div style="font-size:11.5px;color:var(--muted);margin-top:2px;">
              ${s.customer_name || 'Pelanggan Mandiri'}
            </div>
          </td>
          <td>
            <div style="display:flex;flex-direction:column;gap:3px;">
              <span style="font-family:monospace;font-size:12px;color:#10b981;font-weight:700;">
                <i class="bi bi-hdd-network"></i> ${s.framed_ip || '-'}
              </span>
              <span style="font-size:10.5px;color:var(--muted);font-family:monospace;">
                NAS: ${s.nas_ip || '-'}
              </span>
            </div>
          </td>
          <td>
            <div style="display:flex;flex-direction:column;gap:2px;font-size:11px;font-family:monospace;">
              <span style="color:#38bdf8;"><i class="bi bi-arrow-up"></i> ${inMB}</span>
              <span style="color:#34d399;"><i class="bi bi-arrow-down"></i> ${outMB}</span>
            </div>
          </td>
          <td>
            <span class="badge" style="background:rgba(99,102,241,0.12);color:var(--primary);font-family:monospace;font-weight:700;font-size:11.5px;">
              <i class="bi bi-clock-history"></i> ${stStr}
            </span>
          </td>
          <td>
            <span style="font-size:11px;color:var(--muted);">${s.updated_at || '-'}</span>
          </td>
          <td style="text-align:right;white-space:nowrap;">
            <button type="button" class="btn btn-d btn-sm" onclick="disconnectRadiusSession('${s.username}', '${s.session_id || ''}', '${s.nas_ip || ''}', this)" title="Putuskan Sesi Active RADIUS">
              <i class="bi bi-power"></i> Putuskan
            </button>
          </td>
        </tr>
      `;
    });

    if (tbody) tbody.innerHTML = html;
    filterRadiusOnlineTable();
  }

  // ─── CSV EXPORTS ───
  function exportRadiusOnlineCsv() {
    const rows = Array.from(document.querySelectorAll('.radius-session-row')).filter(r => r.style.display !== 'none');
    if (rows.length === 0) {
      alert('Tidak ada data sesi online untuk di-export.');
      return;
    }

    const headers = ['No', 'Username', 'Nama Pelanggan', 'Framed IP', 'NAS IP', 'Upload', 'Download', 'Durasi', 'Waktu Update'];
    const csvRows = [headers.join(',')];

    rows.forEach((r, idx) => {
      const cols = r.querySelectorAll('td');
      if (cols.length >= 7) {
        const username = r.getAttribute('data-username') || '';
        const customer = (cols[1].querySelector('div:last-child')?.textContent || '').trim();
        const framedIp = r.getAttribute('data-ip') || '';
        const nasIp = r.getAttribute('data-nas') || '';
        const upload = (cols[3].querySelector('span:first-child')?.textContent || '').replace(/[^\d.MGK B]/g, '').trim();
        const download = (cols[3].querySelector('span:last-child')?.textContent || '').replace(/[^\d.MGK B]/g, '').trim();
        const duration = (cols[4]?.textContent || '').trim();
        const updatedAt = (cols[5]?.textContent || '').trim();

        csvRows.push([
          idx + 1,
          `"${username}"`,
          `"${customer}"`,
          `"${framedIp}"`,
          `"${nasIp}"`,
          `"${upload}"`,
          `"${download}"`,
          `"${duration}"`,
          `"${updatedAt}"`
        ].join(','));
      }
    });

    const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(csvRows.join('\n'));
    const link = document.createElement('a');
    const dateStr = new Date().toISOString().split('T')[0];
    link.setAttribute('href', csvContent);
    link.setAttribute('download', `radius_online_sessions_${dateStr}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showToast('s', 'File CSV sesi online berhasil diunduh.');
  }

  function filterAccountingTable() {
    const q = (document.getElementById('accountingSearchInput')?.value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.accounting-row');
    rows.forEach(r => {
      const username = r.getAttribute('data-username') || '';
      const nas = r.getAttribute('data-nas') || '';
      const sess = r.getAttribute('data-session') || '';
      if (!q || username.includes(q) || nas.includes(q) || sess.includes(q)) {
        r.style.display = '';
      } else {
        r.style.display = 'none';
      }
    });
  }

  function exportAccountingCsv() {
    const rows = Array.from(document.querySelectorAll('.accounting-row')).filter(r => r.style.display !== 'none');
    if (rows.length === 0) {
      alert('Tidak ada data log accounting untuk di-export.');
      return;
    }
    const headers = ['ID', 'Username', 'Session ID', 'NAS IP', 'Status Type', 'Upload', 'Download', 'Durasi', 'Timestamp'];
    const csvRows = [headers.join(',')];

    rows.forEach(r => {
      const cols = r.querySelectorAll('td');
      if (cols.length >= 9) {
        const id = (cols[0]?.textContent || '').trim();
        const username = (cols[1]?.textContent || '').trim();
        const session = (cols[2]?.textContent || '').trim();
        const nas = (cols[3]?.textContent || '').trim();
        const status = (cols[4]?.textContent || '').trim();
        const up = (cols[5]?.textContent || '').trim();
        const down = (cols[6]?.textContent || '').trim();
        const dur = (cols[7]?.textContent || '').trim();
        const time = (cols[8]?.textContent || '').trim();
        csvRows.push([`"${id}"`, `"${username}"`, `"${session}"`, `"${nas}"`, `"${status}"`, `"${up}"`, `"${down}"`, `"${dur}"`, `"${time}"`].join(','));
      }
    });

    const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(csvRows.join('\n'));
    const link = document.createElement('a');
    const dateStr = new Date().toISOString().split('T')[0];
    link.setAttribute('href', csvContent);
    link.setAttribute('download', `radius_accounting_logs_${dateStr}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showToast('s', 'File CSV log accounting berhasil diunduh.');
  }

  // ─── UTILITIES & MODALS ───
  function copyText(text, btn) {
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      if (btn) {
        const oldHtml = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2 text-success"></i>';
        setTimeout(() => { btn.innerHTML = oldHtml; }, 1800);
      }
      showToast('s', `Tersalin ke clipboard: ${text}`);
    }).catch(() => {
      prompt('Salin:', text);
    });
  }

  function showToast(type, msg) {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const t = document.createElement('div');
    t.className = `toast-msg ${type}`;
    const icon = type === 's' ? 'check-circle-fill' : (type === 'd' ? 'exclamation-circle-fill' : 'info-circle-fill');
    t.innerHTML = `<i class="bi bi-${icon}"></i> <span>${msg}</span>`;
    container.appendChild(t);
    setTimeout(() => {
      t.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      t.style.opacity = '0';
      t.style.transform = 'translateY(10px)';
      setTimeout(() => t.remove(), 400);
    }, 3800);
  }

  function showModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
  }

  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
  }

  function openEditNasModal(nas) {
    if (!nas) return;
    document.getElementById('edit_nas_id').value = nas.id || '';
    document.getElementById('edit_nas_nasname').value = nas.nasname || '';
    document.getElementById('edit_nas_shortname').value = nas.shortname || '';
    document.getElementById('edit_nas_secret').value = nas.secret || '';
    document.getElementById('edit_nas_description').value = nas.description || '';
    document.getElementById('edit_nas_is_active').value = nas.is_active ? '1' : '0';
    showModal('editNasModal');
  }

  function toggleSecretVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      if (btn) btn.innerHTML = '<i class="bi bi-eye-slash"></i>';
    } else {
      input.type = 'password';
      if (btn) btn.innerHTML = '<i class="bi bi-eye"></i>';
    }
  }

  function setPreset(inputId, value) {
    const input = document.getElementById(inputId);
    if (!input) return;
    input.value = value;
    input.focus();
    input.style.transition = 'background-color 0.25s ease';
    const oldBg = input.style.backgroundColor;
    input.style.backgroundColor = 'rgba(99, 102, 241, 0.22)';
    setTimeout(() => {
      input.style.backgroundColor = oldBg;
    }, 280);
  }

  function copyMikrotikScript(btn) {
    const el = document.getElementById('mikrotik-script-area');
    if (!el) return;
    navigator.clipboard.writeText(el.value).then(() => {
      if (btn) {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2"></i> <span>Tersalin!</span>';
        btn.style.color = '#10b981';
        btn.style.borderColor = '#10b981';
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.style.color = '';
          btn.style.borderColor = '';
        }, 2000);
      } else {
        showToast('s', 'Script MikroTik berhasil disalin!');
      }
    }).catch(() => {
      el.select();
      document.execCommand('copy');
      showToast('s', 'Script MikroTik berhasil disalin!');
    });
  }

  function copyUfwCommand(btn) {
    const el = document.getElementById('ufw-command-text');
    if (!el) return;
    const text = (el.innerText || el.textContent || '').trim();
    navigator.clipboard.writeText(text).then(() => {
      if (btn) {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2"></i> Tersalin';
        btn.style.color = '#10b981';
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.style.color = '';
        }, 1800);
      }
    }).catch(() => {
      prompt('Salin perintah UFW di bawah ini:', text);
    });
  }

  // Auto dismiss notification alert after 4 seconds
  setTimeout(() => {
    const alertEl = document.getElementById('autoAlert');
    if (alertEl) {
      alertEl.style.transition = 'opacity 0.5s ease, max-height 0.5s ease, margin 0.5s ease, padding 0.5s ease';
      alertEl.style.opacity = '0';
      alertEl.style.maxHeight = '0';
      alertEl.style.margin = '0';
      alertEl.style.padding = '0';
      alertEl.style.overflow = 'hidden';
      setTimeout(() => alertEl.remove(), 500);
    }
  }, 4000);
</script>
</body>
</html>
