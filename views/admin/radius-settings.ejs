<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.radius.title', 'Pengaturan RADIUS') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.6">
  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
    /* RADIUS Modern Redesign Layout */
    .radius-settings-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(330px, 1.05fr);
      gap: 22px;
      align-items: start;
    }
    .settings-left-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .settings-right-col {
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: sticky;
      top: 18px;
    }

    .radius-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 18px rgba(0,0,0,0.05);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .radius-card:hover {
      border-color: rgba(99, 102, 241, 0.35);
    }
    .radius-card-hd {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 13px 18px;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--border);
    }
    html[data-theme="light"] .radius-card-hd {
      background: #f8fafc;
    }
    .radius-card-title {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0;
    }
    .radius-card-title i {
      color: var(--primary);
      font-size: 16px;
    }
    .radius-card-bd {
      padding: 18px;
    }

    /* Input Icon Prepend */
    .input-icon-wrap {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
    }
    .input-icon-wrap .input-icon {
      position: absolute;
      left: 12px;
      color: var(--muted);
      pointer-events: none;
      font-size: 14px;
      z-index: 2;
    }
    .input-icon-wrap input.fc,
    .input-icon-wrap select.fs {
      padding-left: 36px !important;
      width: 100%;
    }
    .input-icon-wrap .input-btn-append {
      position: absolute;
      right: 8px;
      background: transparent;
      border: none;
      color: var(--muted);
      cursor: pointer;
      padding: 5px 8px;
      border-radius: 6px;
      transition: color 0.2s;
      z-index: 2;
    }
    .input-icon-wrap .input-btn-append:hover {
      color: var(--text);
    }

    /* Preset Chips */
    .preset-chips-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 6px;
    }
    .preset-chip-title {
      font-size: 11px;
      color: var(--muted);
      font-weight: 600;
    }
    .preset-chip {
      display: inline-flex;
      align-items: center;
      font-size: 11px;
      font-weight: 600;
      font-family: monospace;
      padding: 3px 8px;
      border-radius: 6px;
      background: rgba(99, 102, 241, 0.1);
      color: var(--primary);
      border: 1px solid rgba(99, 102, 241, 0.25);
      cursor: pointer;
      transition: all 0.15s ease;
      user-select: none;
    }
    .preset-chip:hover {
      background: var(--primary);
      color: #ffffff;
      transform: translateY(-1px);
      box-shadow: 0 2px 6px var(--pdim);
    }

    /* Subnet Badge */
    .subnet-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 20px;
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
      font-weight: 600;
    }

    /* Terminal Console */
    .terminal-card {
      background: #090d16;
      border: 1px solid #1e293b;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0,0,0,0.35);
    }
    .terminal-card-hd {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
    }
    .terminal-dots {
      display: flex;
      gap: 6px;
      align-items: center;
    }
    .terminal-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    .terminal-dot.red { background: #ff5f56; }
    .terminal-dot.yellow { background: #ffbd2e; }
    .terminal-dot.green { background: #27c93f; }
    .terminal-title {
      font-size: 11.5px;
      font-family: monospace;
      color: #94a3b8;
      font-weight: 600;
      margin-left: 4px;
    }
    .terminal-copy-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      color: #cbd5e1;
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .terminal-copy-btn:hover {
      background: rgba(255,255,255,0.18);
      color: #ffffff;
    }
    .terminal-body {
      padding: 12px 14px;
      position: relative;
    }
    .terminal-body textarea {
      width: 100%;
      height: 255px;
      background: transparent;
      border: none;
      outline: none;
      resize: vertical;
      font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
      font-size: 11.5px;
      line-height: 1.5;
      color: #38bdf8;
      white-space: pre;
    }

    /* Save Glowing Button */
    .btn-save-glow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 13px 20px;
      font-size: 13.5px;
      font-weight: 700;
      border-radius: 10px;
      background: linear-gradient(135deg, #0052cc 0%, #0284c7 100%);
      color: #ffffff;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0, 82, 204, 0.45);
      transition: all 0.2s ease;
      letter-spacing: 0.2px;
    }
    .btn-save-glow:hover {
      background: linear-gradient(135deg, #0043a8 0%, #0052cc 100%);
      box-shadow: 0 6px 20px rgba(0, 82, 204, 0.65);
      transform: translateY(-1px);
    }
    .btn-save-glow:active {
      transform: translateY(0);
    }

    .status-indicator-pill {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 10px;
      border: 1px solid var(--border);
      margin-bottom: 16px;
    }
    .pulse-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }
    .pulse-dot.online {
      background: #10b981;
      box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
      animation: pulseGreen 2s infinite;
    }
    .pulse-dot.offline {
      background: #ef4444;
    }
    @keyframes pulseGreen {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* ── KPI STAT GRID (Modern Enterprise Cards) ── */
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
    @media(max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width: 580px) { .kpi-grid { grid-template-columns: 1fr; } }

    .kpi-card {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 12px;
      padding: 16px 18px; position: relative; overflow: hidden;
      transition: all 0.2s ease; cursor: pointer; user-select: none;
      display: flex; flex-direction: column; justify-content: space-between;
    }
    .kpi-card:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.2); box-shadow: 0 6px 20px rgba(0,0,0,0.3); }
    .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
    .kpi-card.c-primary::before { background: linear-gradient(90deg, #0052cc, #38bdf8); }
    .kpi-card.c-success::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .kpi-card.c-warning::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .kpi-card.c-purple::before { background: linear-gradient(90deg, #7c3aed, #a78bfa); }

    .kpi-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .kpi-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .kpi-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; background: var(--bg3); }
    .kpi-card.c-primary .kpi-icon { color: #38bdf8; background: rgba(0,82,204,0.12); }
    .kpi-card.c-success .kpi-icon { color: #10b981; background: rgba(16,185,129,0.12); }
    .kpi-card.c-warning .kpi-icon { color: #f59e0b; background: rgba(245,158,11,0.12); }
    .kpi-card.c-purple .kpi-icon { color: #a78bfa; background: rgba(124,58,237,0.12); }

    .kpi-val { font-size: 24px; font-weight: 800; line-height: 1.1; color: var(--text); font-variant-numeric: tabular-nums; margin-bottom: 8px; display: flex; align-items: baseline; gap: 6px; }
    .kpi-bottom { font-size: 11.5px; color: var(--muted); border-top: 1px dashed var(--border); padding-top: 8px; display: flex; justify-content: space-between; align-items: center; }

    /* ── SEGMENTED NAVIGATION TABS ── */
    .segmented-control {
      display: inline-flex; background: var(--bg3); padding: 4px; border-radius: 12px;
      border: 1px solid var(--border); margin-bottom: 18px; max-width: 100%; overflow-x: auto;
    }
    .seg-btn {
      background: transparent; border: none; outline: none; padding: 8px 16px;
      border-radius: 9px; font-size: 13px; font-weight: 600; color: var(--muted);
      cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    }
    .seg-btn:hover { color: var(--text); }
    .seg-btn.active { background: var(--bg2); color: var(--text); font-weight: 700; box-shadow: 0 2px 8px rgba(0,0,0,0.25); border: 1px solid var(--border); }
    .seg-count {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 1px 7px; border-radius: 999px; font-size: 10.5px; font-weight: 700;
      background: rgba(255,255,255,0.08); color: var(--muted);
    }
    .seg-btn.active .seg-count {
      background: var(--pdim); color: var(--primary);
    }

    /* ── MODERN CARD & TOOLBAR ── */
    .card-modern {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 14px;
      overflow: hidden; box-shadow: 0 4px 18px rgba(0,0,0,0.12);
    }
    .card-modern-hd {
      padding: 14px 20px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px; background: rgba(255,255,255,0.015);
    }
    .card-modern-title { font-size: 14px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0; }
    
    /* Search & Action Bar */
    .table-toolbar {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 10px; padding: 12px 18px; border-bottom: 1px solid var(--border);
      background: rgba(0,0,0,0.08);
    }
    .search-filter-wrap {
      display: flex; align-items: center; gap: 10px; flex: 1; min-width: 260px; flex-wrap: wrap;
    }
    .search-input-box {
      position: relative; flex: 1; min-width: 220px; max-width: 340px;
    }
    .search-input-box i.search-icon {
      position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
      color: var(--muted); font-size: 13px; pointer-events: none;
    }
    .search-input-box input {
      width: 100%; padding: 7px 30px 7px 34px; border-radius: 8px;
      background: var(--bg3); border: 1px solid var(--border); color: var(--text);
      font-size: 12.5px; outline: none; transition: border-color 0.2s; box-sizing: border-box;
    }
    .search-input-box input:focus {
      border-color: var(--primary); box-shadow: 0 0 0 2px var(--pdim);
    }
    .btn-clear-search {
      position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: var(--muted); cursor: pointer; padding: 2px;
      display: none; font-size: 14px; line-height: 1;
    }
    .btn-clear-search:hover { color: var(--text); }

    /* Auto-refresh Switch */
    .auto-refresh-badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 8px; background: var(--bg3);
      border: 1px solid var(--border); font-size: 12px; font-weight: 600; color: var(--text);
      cursor: pointer; user-select: none;
    }
    .auto-refresh-badge input { margin: 0; cursor: pointer; accent-color: var(--primary); }
    .refresh-timer-count { font-size: 10.5px; color: var(--primary); font-family: monospace; font-weight: 700; }

    .btn-copy-sm {
      background: none; border: none; padding: 2px 4px; font-size: 11px;
      color: var(--muted); cursor: pointer; border-radius: 4px; transition: color 0.15s, background 0.15s;
    }
    .btn-copy-sm:hover { color: var(--primary); background: var(--pdim); }

    /* Empty state */
    .empty-state-box {
      padding: 44px 20px; text-align: center; color: var(--muted);
    }
    .empty-state-box i { font-size: 40px; opacity: 0.4; margin-bottom: 10px; display: block; }
    .empty-state-box h4 { font-size: 15px; color: var(--text); margin: 0 0 6px 0; }
    .empty-state-box p { font-size: 12px; margin: 0; }

    /* Toast Notification */
    #toast-container {
      position: fixed; bottom: 24px; right: 24px; z-index: 99999;
      display: flex; flex-direction: column; gap: 10px; pointer-events: none;
    }
    .toast-msg {
      pointer-events: auto; padding: 12px 18px; border-radius: 10px;
      font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 10px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.35); animation: toastIn 0.3s ease;
      max-width: 380px; color: #fff;
    }
    .toast-msg.s { background: #065f46; border: 1px solid #10b981; }
    .toast-msg.d { background: #991b1b; border: 1px solid #ef4444; }
    .toast-msg.i { background: #1e3a8a; border: 1px solid #3b82f6; }
    @keyframes toastIn { from { transform: translateY(15px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    @media (max-width: 992px) {
      .radius-settings-layout {
        grid-template-columns: 1fr;
      }
      .settings-right-col {
        position: static;
      }
    }

    /* Mobile Responsive Optimizations */
    @media (max-width: 768px) {
      .settings-form-grid { grid-template-columns: 1fr; }
      .mtabs {
        overflow-x: auto;
        flex-wrap: nowrap;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 8px;
        margin-bottom: 14px;
        scrollbar-width: thin;
      }
      .mtab {
        padding: 8px 14px;
        font-size: 12px;
        flex-shrink: 0;
      }
      .stat-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 10px !important;
      }
      .tbl-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        width: 100%;
        margin-bottom: 0;
      }
      .dtbl {
        min-width: 600px;
      }
      .topbar .tb-title span {
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
      }
      .mo .mb {
        width: 95vw !important;
        max-width: 95vw !important;
        margin: 10px auto !important;
        padding: 14px !important;
        border-radius: 14px !important;
      }
      .mo .mbody {
        max-height: 70vh !important;
        overflow-y: auto !important;
        padding-right: 4px !important;
      }
      .mf {
        flex-wrap: wrap !important;
        gap: 8px !important;
      }
      .mf button, .mf a {
        flex: 1 1 100% !important;
        justify-content: center !important;
      }
    }
    @media (max-width: 480px) {
      .stat-grid {
        grid-template-columns: 1fr !important;
      }
      .topbar .tb-title span {
        max-width: 140px;
      }
    }
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'radius_settings', company }) %>

<div class="mw">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-broadcast"></i>
      <span><%= t('admin.radius.title', 'Pengaturan RADIUS') %> &amp; Monitoring</span>
    </div>
    <div class="tb-right" style="display:flex;align-items:center;gap:8px;">
      <!-- RADIUS Service Control Buttons in Topbar -->
      <% if (!radiusStatus.running) { %>
        <button type="button" class="btn btn-s btn-sm" style="display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:6px 14px;background:#10b981;border:none;color:#fff;border-radius:8px;font-weight:700;box-shadow:0 2px 8px rgba(16,185,129,0.35);cursor:pointer;" onclick="toggleRadiusAction('start', this)" title="Start / Jalankan Layanan RADIUS (UDP 1812/1813)">
          <i class="bi bi-play-fill" style="font-size:16px;"></i> Start RADIUS
        </button>
      <% } else { %>
        <button type="button" class="btn btn-d btn-sm" style="display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:6px 12px;background:#ef4444;border:none;color:#fff;border-radius:8px;font-weight:700;cursor:pointer;" onclick="toggleRadiusAction('stop', this)" title="Stop / Hentikan Layanan RADIUS">
          <i class="bi bi-stop-fill" style="font-size:14px;"></i> Stop
        </button>
        <button type="button" class="btn btn-w btn-sm" style="display:inline-flex;align-items:center;gap:6px;font-size:12px;padding:6px 12px;background:#f59e0b;border:none;color:#0f172a;border-radius:8px;font-weight:700;cursor:pointer;" onclick="toggleRadiusAction('restart', this)" title="Restart Service UDP RADIUS">
          <i class="bi bi-arrow-clockwise" style="font-size:14px;"></i> Restart
        </button>
      <% } %>
      <span class="adm-badge" style="font-size:12px;opacity:0.7;"><%= company %></span>
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i> 
        <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %>
      </span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type === 'danger' || msg.type === 'error' ? 'd' : msg.type === 'success' ? 's' : 'w' %> mb16" id="autoAlert">
      <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-triangle' %>"></i>
      <%= msg.text %>
    </div>
    <% } %>

    <!-- SUMMARY STAT CARDS (4 Modern Enterprise KPI Cards) -->
    <div class="kpi-grid">
      <div class="kpi-card <%= radiusStatus.running ? 'c-primary' : 'c-warning' %>" onclick="switchTab('settings')" title="Klik untuk membuka pengaturan server">
        <div class="kpi-top">
          <span class="kpi-label">Status Server RADIUS</span>
          <div class="kpi-icon"><i class="bi bi-broadcast"></i></div>
        </div>
        <div class="kpi-val" style="<%= radiusStatus.running ? 'color:#38bdf8;' : 'color:#f59e0b;' %>">
          <span><%= radiusStatus.running ? 'ONLINE' : 'STOPPED' %></span>
          <span class="live-dot" style="<%= radiusStatus.running ? 'background:#10b981;' : 'background:#ef4444;' %>"></span>
        </div>
        <div class="kpi-bottom">
          <span>UDP Auth: <strong><%= radiusStatus.authPort %></strong></span>
          <span>Acct: <strong><%= radiusStatus.acctPort %></strong></span>
        </div>
      </div>

      <div class="kpi-card c-success" onclick="switchTab('online')" title="Klik untuk melihat sesi online">
        <div class="kpi-top">
          <span class="kpi-label">Sesi RADIUS Online</span>
          <div class="kpi-icon"><i class="bi bi-wifi"></i></div>
        </div>
        <div class="kpi-val" style="color:#10b981;">
          <span id="kpi-online-count"><%= onlineSessions.length %></span>
          <span style="font-size:12px;color:var(--muted);font-weight:600;">Sesi Aktif</span>
        </div>
        <div class="kpi-bottom">
          <span>Koneksi PPPoE / IPoE Terhubung</span>
          <i class="bi bi-chevron-right" style="font-size:11px;"></i>
        </div>
      </div>

      <div class="kpi-card c-purple" onclick="switchTab('nas')" title="Klik untuk mengelola router NAS">
        <div class="kpi-top">
          <span class="kpi-label">Router NAS Terdaftar</span>
          <div class="kpi-icon"><i class="bi bi-router"></i></div>
        </div>
        <div class="kpi-val" style="color:#a78bfa;">
          <span><%= nasList.length %></span>
          <span style="font-size:12px;color:var(--muted);font-weight:600;">Router Client</span>
        </div>
        <div class="kpi-bottom">
          <span>Network Access Server Aktif</span>
          <i class="bi bi-chevron-right" style="font-size:11px;"></i>
        </div>
      </div>

      <div class="kpi-card c-warning" onclick="switchTab('accounting')" title="Klik untuk membuka log accounting">
        <div class="kpi-top">
          <span class="kpi-label">Trafik RADIUS Hari Ini</span>
          <div class="kpi-icon"><i class="bi bi-activity"></i></div>
        </div>
        <div class="kpi-val" style="color:#fbbf24;">
          <span><%= typeof todayTrafficMB !== 'undefined' ? todayTrafficMB : '0.0' %></span>
          <span style="font-size:13px;font-weight:700;">MB</span>
        </div>
        <div class="kpi-bottom">
          <span><strong><%= typeof todayEvents !== 'undefined' ? todayEvents : 0 %></strong> Log Accounting Dicatat</span>
          <i class="bi bi-chevron-right" style="font-size:11px;"></i>
        </div>
      </div>
    </div>

    <!-- SEGMENTED NAVIGATION TABS -->
    <div class="segmented-control">
      <button type="button" class="seg-btn active" id="tab-btn-online" onclick="switchTab('online')">
        <i class="bi bi-wifi"></i> Sesi Aktif RADIUS
        <span class="seg-count" id="badge-online-count"><%= onlineSessions.length %></span>
      </button>
      <button type="button" class="seg-btn" id="tab-btn-settings" onclick="switchTab('settings')">
        <i class="bi bi-sliders"></i> Pengaturan RADIUS
      </button>
      <button type="button" class="seg-btn" id="tab-btn-nas" onclick="switchTab('nas')">
        <i class="bi bi-router"></i> Daftar NAS Router
        <span class="seg-count"><%= nasList.length %></span>
      </button>
      <button type="button" class="seg-btn" id="tab-btn-accounting" onclick="switchTab('accounting')">
        <i class="bi bi-journal-text"></i> Log Accounting
        <span class="seg-count"><%= acctLogs ? acctLogs.length : 0 %></span>
      </button>
    </div>

    <!-- TAB 1: PENGATURAN RADIUS -->
    <div id="tab-content-settings" class="tab-pane" style="display:none;">
      <form action="/admin/radius-settings" method="POST">
        
        <!-- Top Banner Header -->
        <div style="display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg, rgba(99,102,241,0.08) 0%, rgba(16,185,129,0.06) 100%);border:1px solid rgba(99,102,241,0.2);padding:14px 20px;border-radius:12px;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:40px;height:40px;border-radius:10px;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 4px 12px var(--pdim);">
              <i class="bi bi-sliders"></i>
            </div>
            <div>
              <div style="font-weight:700;font-size:14.5px;color:var(--text);display:flex;align-items:center;gap:8px;">
                Konfigurasi Server RADIUS
                <span class="badge <%= radiusStatus.running ? 'bs' : 'bd' %>" style="font-size:10px;padding:2px 8px;">
                  <i class="bi bi-<%= radiusStatus.running ? 'check-circle-fill' : 'x-circle-fill' %>"></i> <%= radiusStatus.running ? 'Service Aktif' : 'Service Non-Aktif' %>
                </span>
              </div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px;">
                Sesuaikan port UDP, shared secret, alokasi IP dinamis otomatis, dan kebijakan isolir pelanggan terpusat.
              </div>
            </div>
          </div>
        </div>

        <!-- 2-Column Responsive Layout -->
        <div class="radius-settings-layout">
          
          <!-- LEFT COLUMN: Forms & Parameters (~65%) -->
          <div class="settings-left-col">

            <!-- Card 1: Core Service & Credentials -->
            <div class="radius-card">
              <div class="radius-card-hd">
                <div class="radius-card-title">
                  <i class="bi bi-shield-lock-fill"></i>
                  <span>Kredensial & Jaringan Server RADIUS</span>
                </div>
                <span class="badge bs" style="font-size:10.5px;">UDP Daemon</span>
              </div>
              <div class="radius-card-bd">
                <div class="fg">
                  <label class="fl">Status Service Background RADIUS</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-toggle2-on input-icon"></i>
                    <select name="radius_enabled" class="fs">
                      <option value="1" <%= radiusStatus.enabled ? 'selected' : '' %>>Aktif (Running Background UDP Service)</option>
                      <option value="0" <%= !radiusStatus.enabled ? 'selected' : '' %>>Non-Aktif (Disabled)</option>
                    </select>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Mendengarkan paket Access-Request (Auth) & Accounting-Request (Acct) dari router NAS MikroTik.
                  </small>
                </div>

                <div class="fg">
                  <label class="fl">Global Shared Secret RADIUS</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-key-fill input-icon"></i>
                    <input type="password" name="radius_secret" id="radius_secret_input" class="fc" value="<%= radiusStatus.secret %>" placeholder="Masukkan secret password" required autocomplete="off">
                    <button type="button" class="input-btn-append" onclick="toggleSecretVisibility('radius_secret_input', this)" title="Lihat / Sembunyikan Secret">
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Kunci rahasia bersama antara server billing dan router MikroTik. Wajib sama dengan secret di menu <code>/radius</code> MikroTik.
                  </small>
                </div>

                <div class="form-row">
                  <div class="fg">
                    <label class="fl">Port Auth (UDP)</label>
                    <div class="input-icon-wrap">
                      <i class="bi bi-door-open input-icon"></i>
                      <input type="number" name="radius_auth_port" class="fc" value="<%= radiusStatus.authPort %>" required>
                    </div>
                    <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">Default standar: 1812</small>
                  </div>

                  <div class="fg">
                    <label class="fl">Port Accounting (UDP)</label>
                    <div class="input-icon-wrap">
                      <i class="bi bi-calculator input-icon"></i>
                      <input type="number" name="radius_acct_port" class="fc" value="<%= radiusStatus.acctPort %>" required>
                    </div>
                    <small class="text-muted" style="font-size:11px;display:block;margin-top:4px;">Default standar: 1813</small>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card 2: Dynamic IP Pool -->
            <div class="radius-card">
              <div class="radius-card-hd">
                <div class="radius-card-title">
                  <i class="bi bi-diagram-3-fill"></i>
                  <span>Alokasi IP Dinamis Otomatis (IP Pool)</span>
                </div>
                <span class="subnet-badge"><i class="bi bi-hdd-network"></i> Subnet /24 (~253 IP)</span>
              </div>
              <div class="radius-card-bd">
                <div class="fg">
                  <label class="fl">Metode Alokasi IP Client PPPoE / IPoE</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-shuffle input-icon"></i>
                    <select name="radius_ip_pool_enabled" class="fs">
                      <option value="1" <%= (typeof radiusStatus.ipPoolEnabled === 'undefined' || radiusStatus.ipPoolEnabled) ? 'selected' : '' %>>Aktif - RADIUS Bagikan IP Otomatis dari Rentang IP Pool (Rekomendasi)</option>
                      <option value="0" <%= (typeof radiusStatus.ipPoolEnabled !== 'undefined' && !radiusStatus.ipPoolEnabled) ? 'selected' : '' %>>Non-Aktif - Delegasikan IP ke Dynamic Pool MikroTik (Framed-Pool)</option>
                    </select>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Jika aktif, RADIUS langsung mengirimkan atribut <code>Framed-IP-Address</code> unik ke pelanggan tanpa membebani konfigurasi IP pool di setiap router MikroTik.
                  </small>
                </div>

                <div class="form-row">
                  <div class="fg">
                    <label class="fl">Rentang IP Pool Normal (Awal)</label>
                    <div class="input-icon-wrap">
                      <i class="bi bi-geo-alt input-icon"></i>
                      <input type="text" name="radius_ip_pool_start" class="fc" value="<%= typeof radiusStatus.ipPoolStart !== 'undefined' ? radiusStatus.ipPoolStart : '10.10.10.2' %>" placeholder="10.10.10.2" required>
                    </div>
                  </div>
                  <div class="fg">
                    <label class="fl">Rentang IP Pool Normal (Akhir)</label>
                    <div class="input-icon-wrap">
                      <i class="bi bi-geo input-icon"></i>
                      <input type="text" name="radius_ip_pool_end" class="fc" value="<%= typeof radiusStatus.ipPoolEnd !== 'undefined' ? radiusStatus.ipPoolEnd : '10.10.10.254' %>" placeholder="10.10.10.254" required>
                    </div>
                  </div>
                </div>

                <div class="fg" style="margin-bottom:0;">
                  <label class="fl">Nama Framed-Pool Cadangan (Fallback MikroTik)</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-tag input-icon"></i>
                    <input type="text" name="radius_framed_pool" class="fc" value="<%= radiusStatus.framedPool %>" placeholder="Contoh: pool-pppoe" required>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Atribut <code>Framed-Pool</code> yang dikirim ke MikroTik jika alokasi IP dinamis RADIUS dinonaktifkan.
                  </small>
                </div>
              </div>
            </div>

            <!-- Card 3: Isolir Settings -->
            <div class="radius-card">
              <div class="radius-card-hd">
                <div class="radius-card-title">
                  <i class="bi bi-shield-slash-fill"></i>
                  <span>Kebijakan Isolir & Pelanggan Suspended</span>
                </div>
                <span class="badge bd" style="font-size:10.5px;"><i class="bi bi-lock-fill"></i> Isolir Guard</span>
              </div>
              <div class="radius-card-bd">
                <div class="fg">
                  <label class="fl">Aksi Saat Pelanggan Jatuh Tempo / Terisolir</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-slash-circle input-icon"></i>
                    <select name="radius_isolir_action" class="fs">
                      <option value="pool" <%= radiusStatus.isolirAction === 'pool' ? 'selected' : '' %>>Access-Accept dengan Dynamic IP Pool Isolir (Rekomendasi - Dialihkan ke Info Bayar)</option>
                      <option value="reject" <%= radiusStatus.isolirAction === 'reject' ? 'selected' : '' %>>Access-Reject (Koneksi Ditolak Total / Dial-up PPP Gagal)</option>
                    </select>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Dengan opsi <em>Access-Accept</em>, pelanggan tetap terhubung tetapi hanya mendapat subnet IP isolir untuk menampilkan halaman pemberitahuan tagihan.
                  </small>
                </div>

                <div class="fg">
                  <label class="fl">Alokasi IP Pool Isolir Khusus oleh RADIUS</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-shield-check input-icon"></i>
                    <select name="radius_isolir_ip_pool_enabled" class="fs">
                      <option value="1" <%= (typeof radiusStatus.isolirIpPoolEnabled === 'undefined' || radiusStatus.isolirIpPoolEnabled) ? 'selected' : '' %>>Aktif - RADIUS Alokasikan IP Isolir Khusus Secara Otomatis</option>
                      <option value="0" <%= (typeof radiusStatus.isolirIpPoolEnabled !== 'undefined' && !radiusStatus.isolirIpPoolEnabled) ? 'selected' : '' %>>Non-Aktif - Hanya Kirim Atribut Mikrotik-Group / Framed-Pool</option>
                    </select>
                  </div>
                </div>

                <div class="form-row">
                  <div class="fg">
                    <label class="fl">Rentang IP Pool Isolir (Awal)</label>
                    <div class="input-icon-wrap">
                      <i class="bi bi-shield-lock input-icon"></i>
                      <input type="text" name="radius_isolir_ip_pool_start" class="fc" value="<%= typeof radiusStatus.isolirIpPoolStart !== 'undefined' ? radiusStatus.isolirIpPoolStart : '10.10.99.2' %>" placeholder="10.10.99.2" required>
                    </div>
                  </div>
                  <div class="fg">
                    <label class="fl">Rentang IP Pool Isolir (Akhir)</label>
                    <div class="input-icon-wrap">
                      <i class="bi bi-shield-x input-icon"></i>
                      <input type="text" name="radius_isolir_ip_pool_end" class="fc" value="<%= typeof radiusStatus.isolirIpPoolEnd !== 'undefined' ? radiusStatus.isolirIpPoolEnd : '10.10.99.254' %>" placeholder="10.10.99.254" required>
                    </div>
                  </div>
                </div>

                <div class="fg">
                  <label class="fl">Batas Kecepatan Pelanggan Terisolir (Rate-Limit)</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-speedometer input-icon"></i>
                    <input type="text" name="radius_isolir_rate_limit" id="radius_isolir_rate_limit_input" class="fc" value="<%= typeof radiusStatus.isolirRateLimit !== 'undefined' ? radiusStatus.isolirRateLimit : '512k/512k' %>" placeholder="Contoh: 512k/512k" required>
                  </div>
                  <!-- Preset Chips for Isolir Speed -->
                  <div class="preset-chips-wrap">
                    <span class="preset-chip-title"><i class="bi bi-lightning-charge-fill"></i> Preset Cepat:</span>
                    <button type="button" class="preset-chip" onclick="setPreset('radius_isolir_rate_limit_input', '256k/256k')">256k/256k</button>
                    <button type="button" class="preset-chip" onclick="setPreset('radius_isolir_rate_limit_input', '512k/512k')">512k/512k</button>
                    <button type="button" class="preset-chip" onclick="setPreset('radius_isolir_rate_limit_input', '1M/1M')">1M/1M</button>
                    <button type="button" class="preset-chip" onclick="setPreset('radius_isolir_rate_limit_input', '2M/2M')">2M/2M</button>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Format: <code>Upload/Download</code>. Memberikan bandwidth minimal agar pelanggan dapat mengakses portal isolir / pembayaran.
                  </small>
                </div>

                <div class="fg" style="margin-bottom:0;">
                  <label class="fl">Nama Pool / Mikrotik-Group Isolir</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-folder2-open input-icon"></i>
                    <input type="text" name="radius_isolir_pool" class="fc" value="<%= radiusStatus.isolirPool %>" placeholder="Contoh: isolir" required>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Atribut <code>Mikrotik-Group</code> yang dikirim ke router untuk mencocokkan filter firewall isolir.
                  </small>
                </div>
              </div>
            </div>

            <!-- Card 4: Limitasi Sesi & Fallback Kecepatan -->
            <div class="radius-card">
              <div class="radius-card-hd">
                <div class="radius-card-title">
                  <i class="bi bi-person-slash"></i>
                  <span>Limitasi Sesi & Fallback Kecepatan</span>
                </div>
                <span class="badge bw" style="font-size:10.5px;"><i class="bi bi-shield-check"></i> Session Guard</span>
              </div>
              <div class="radius-card-bd">
                <div class="fg">
                  <label class="fl">Pembatasan Sesi Aktif Ganda (Simultaneous-Use)</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-person-lock input-icon"></i>
                    <select name="radius_limit_simultaneous" class="fs">
                      <option value="1" <%= (typeof radiusStatus.limitSimultaneous === 'undefined' || radiusStatus.limitSimultaneous) ? 'selected' : '' %>>Aktif - Batasi 1 Akun 1 Sesi Online (Rejek Login Ganda)</option>
                      <option value="0" <%= (typeof radiusStatus.limitSimultaneous !== 'undefined' && !radiusStatus.limitSimultaneous) ? 'selected' : '' %>>Non-Aktif - Bebas Multi-Login (Multi-Device)</option>
                    </select>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Mencegah pencurian akun atau penggunaan bersamaan 1 username PPPoE/Hotspot pada lebih dari satu perangkat.
                  </small>
                </div>

                <div class="fg" style="margin-bottom:0;">
                  <label class="fl">Default Rate Limit (Fallback Bandwidth)</label>
                  <div class="input-icon-wrap">
                    <i class="bi bi-speedometer2 input-icon"></i>
                    <input type="text" name="radius_default_rate_limit" id="radius_default_rate_limit_input" class="fc" value="<%= typeof radiusStatus.defaultRateLimit !== 'undefined' ? radiusStatus.defaultRateLimit : '5M/10M' %>" placeholder="Contoh: 5M/10M">
                  </div>
                  <!-- Preset Chips for Default Rate Limit -->
                  <div class="preset-chips-wrap">
                    <span class="preset-chip-title"><i class="bi bi-lightning-charge-fill"></i> Preset Cepat:</span>
                    <button type="button" class="preset-chip" onclick="setPreset('radius_default_rate_limit_input', '5M/10M')">5M/10M</button>
                    <button type="button" class="preset-chip" onclick="setPreset('radius_default_rate_limit_input', '10M/20M')">10M/20M</button>
                    <button type="button" class="preset-chip" onclick="setPreset('radius_default_rate_limit_input', '20M/50M')">20M/50M</button>
                    <button type="button" class="preset-chip" onclick="setPreset('radius_default_rate_limit_input', '50M/100M')">50M/100M</button>
                  </div>
                  <small class="text-muted" style="font-size:11px;display:block;margin-top:5px;">
                    Kecepatan default jika akun pengguna tidak terhubung ke Paket Internet khusus (Format: <code>Upload/Download</code>).
                  </small>
                </div>
              </div>
            </div>

          </div>

          <!-- RIGHT COLUMN: Sticky Actions & macOS Terminal (~35%) -->
          <div class="settings-right-col">

            <!-- Sticky Save & Status Card -->
            <div class="radius-card" style="box-shadow: 0 6px 24px rgba(0,0,0,0.08);">
              <div class="radius-card-hd">
                <div class="radius-card-title">
                  <i class="bi bi-broadcast-pin"></i>
                  <span>Panel Tindakan Cepat</span>
                </div>
              </div>
              <div class="radius-card-bd" style="padding: 22px 20px;">
                <!-- Status Pill Indicator -->
                <div class="status-indicator-pill" style="<%= radiusStatus.running ? 'background:rgba(16,185,129,0.08);border-color:rgba(16,185,129,0.3);' : 'background:rgba(239,68,68,0.08);border-color:rgba(239,68,68,0.3);' %>">
                  <span class="pulse-dot <%= radiusStatus.running ? 'online' : 'offline' %>"></span>
                  <div style="flex:1;">
                    <div style="font-weight:700;font-size:13px;color:var(--text);">
                      Service RADIUS: <%= radiusStatus.running ? 'Berjalan (Online)' : 'Non-Aktif (Offline)' %>
                    </div>
                    <div style="font-size:11px;color:var(--muted);margin-top:2px;">
                      Port UDP <%= radiusStatus.authPort %> (Auth) &amp; <%= radiusStatus.acctPort %> (Acct)
                    </div>
                  </div>
                </div>

                <!-- Glowing Primary Save Button -->
                <button type="submit" class="btn-save-glow" id="btn-save-radius">
                  <i class="bi bi-floppy-fill" style="font-size:16px;"></i>
                  <span>Simpan Konfigurasi RADIUS</span>
                </button>

                <div style="margin-top:14px;font-size:11.5px;color:var(--muted);text-align:center;line-height:1.5;">
                  <i class="bi bi-info-circle" style="color:var(--primary);"></i> Perubahan langsung tersimpan ke database &amp; file. Sesi online aktif tetap berjalan normal.
                </div>
              </div>
            </div>

            <!-- macOS Style Terminal Card -->
            <div class="terminal-card">
              <div class="terminal-card-hd">
                <div class="terminal-dots">
                  <span class="terminal-dot red"></span>
                  <span class="terminal-dot yellow"></span>
                  <span class="terminal-dot green"></span>
                  <span class="terminal-title">MikroTik RouterOS Terminal</span>
                </div>
                <button type="button" class="terminal-copy-btn" id="btn-copy-mikrotik" onclick="copyMikrotikScript(this)">
                  <i class="bi bi-clipboard-check"></i>
                  <span>Salin Script</span>
                </button>
              </div>
              <div class="terminal-body">
                <textarea id="mikrotik-script-area" readonly spellcheck="false"># =========================================================
# SCRIPT OTOMATIS RADIUS & FITUR ISOLIR RADIUS MIKROTIK
# =========================================================

# 1. Aktifkan Fitur RADIUS pada PPP MikroTik
/ppp aaa set use-radius=yes accounting=yes interim-update=1m

# 2. Tambahkan Server RADIUS Billing ke MikroTik
/radius remove [find comment="RTRW-Billing-RADIUS"]
/radius add service=ppp address=IP_SERVER_BILLING secret="<%= radiusStatus.secret %>" authentication-port=<%= radiusStatus.authPort %> accounting-port=<%= radiusStatus.acctPort %> timeout=3000ms comment="RTRW-Billing-RADIUS"

# 3. Tambahkan IP Address Gateway Subnet Isolir RADIUS (Interface Bridge)
/ip address remove [find comment="Gateway-Isolir-RADIUS"]
:do { /ip address add address=<%= (typeof radiusStatus.isolirIpPoolStart !== 'undefined' ? radiusStatus.isolirIpPoolStart.replace(/\.\d+$/, '.1') : '10.10.99.1') %>/24 interface=([/interface find type=bridge]->0) comment="Gateway-Isolir-RADIUS" } on-error={ /ip address add address=<%= (typeof radiusStatus.isolirIpPoolStart !== 'undefined' ? radiusStatus.isolirIpPoolStart.replace(/\.\d+$/, '.1') : '10.10.99.1') %>/24 interface=([/interface find]->0) comment="Gateway-Isolir-RADIUS" }

# 4. Filter Drop Akses Internet Pelanggan Terisolir RADIUS (Universal)
/ip firewall filter remove [find comment="Isolir-RADIUS-Block-Internet"]
/ip firewall filter add chain=forward src-address=<%= (typeof radiusStatus.isolirIpPoolStart !== 'undefined' ? radiusStatus.isolirIpPoolStart.replace(/\.\d+$/, '.0') : '10.10.99.0') %>/24 action=drop comment="Isolir-RADIUS-Block-Internet"</textarea>
              </div>
              <div style="padding:10px 14px;background:#0d1322;border-top:1px solid #1e293b;font-size:11px;color:#94a3b8;display:flex;align-items:flex-start;gap:8px;">
                <i class="bi bi-lightbulb-fill" style="color:#f59e0b;font-size:13px;margin-top:1px;"></i>
                <span>Buka <strong>Winbox &gt; New Terminal</strong> lalu paste script. Ganti <code>IP_SERVER_BILLING</code> dengan IP Server Billing ini (misal: <code>192.168.8.8</code>).</span>
              </div>
            </div>

            <!-- UFW Firewall Linux Helper Card -->
            <div class="radius-card" style="background:var(--bg3);">
              <div class="radius-card-hd" style="padding:10px 14px;">
                <div class="radius-card-title" style="font-size:12px;">
                  <i class="bi bi-shield-check"></i> Firewall Server Linux (UFW)
                </div>
                <button type="button" class="btn btn-g btn-sm" style="font-size:11px;padding:3px 9px;" onclick="copyUfwCommand(this)">
                  <i class="bi bi-clipboard"></i> Salin
                </button>
              </div>
              <div class="radius-card-bd" style="padding:12px 14px;">
                <div id="ufw-command-text" style="font-family:monospace;font-size:11.5px;color:var(--info);word-break:break-all;user-select:all;line-height:1.5;">sudo ufw allow <%= radiusStatus.authPort %>/udp &amp;&amp; sudo ufw allow <%= radiusStatus.acctPort %>/udp</div>
                <div style="font-size:10.5px;color:var(--muted);margin-top:6px;">
                  Jalankan di terminal server VPS Linux agar router MikroTik diizinkan berkomunikasi dengan port UDP RADIUS.
                </div>
              </div>
            </div>

          </div>

        </div>
      </form>
    </div>

    <!-- TAB 2: DAFTAR NAS CLIENTS -->
    <div id="tab-content-nas" class="tab-pane" style="display:none;">
      <div class="card-modern mb16">
        <div class="card-modern-hd">
          <div class="card-modern-title">
            <i class="bi bi-router text-primary"></i> Daftar Router NAS (Network Access Server)
            <span class="badge" style="background:rgba(99,102,241,0.12);color:var(--primary);font-size:11px;"><%= nasList.length %> Router Terdaftar</span>
          </div>
          <button type="button" class="btn btn-p btn-sm" onclick="showModal('addNasModal')">
            <i class="bi bi-plus-lg"></i> Tambah NAS Client
          </button>
        </div>
        <div class="card-bd" style="padding:0;">
          <div class="tbl-wrap">
            <table class="dtbl">
              <thead>
                <tr>
                  <th>IP Address NAS</th>
                  <th>Nama Shortname</th>
                  <th>Shared Secret</th>
                  <th>Keterangan</th>
                  <th>Status</th>
                  <th style="width:140px;text-align:right;">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (nasList && nasList.length > 0) { %>
                  <% nasList.forEach(nas => { %>
                    <tr>
                      <td><strong style="color:var(--text);font-family:monospace;"><%= nas.nasname %></strong></td>
                      <td><%= nas.shortname || '<span class="text-muted">-</span>' %></td>
                      <td><code><%= nas.secret %></code></td>
                      <td><%= nas.description || '<span class="text-muted">-</span>' %></td>
                      <td>
                        <% if (nas.is_active) { %>
                          <span class="badge bs"><i class="bi bi-check-circle-fill"></i> Aktif</span>
                        <% } else { %>
                          <span class="badge bd"><i class="bi bi-x-circle-fill"></i> Non-Aktif</span>
                        <% } %>
                      </td>
                      <td style="text-align:right;white-space:nowrap;">
                        <!-- Toggle Status -->
                        <form action="/admin/radius/nas/toggle" method="POST" style="display:inline;">
                          <input type="hidden" name="id" value="<%= nas.id %>">
                          <button type="submit" class="btn btn-g btn-sm" title="<%= nas.is_active ? 'Non-aktifkan NAS' : 'Aktifkan NAS' %>">
                            <i class="bi bi-<%= nas.is_active ? 'pause-circle-fill text-warning' : 'play-circle-fill text-success' %>"></i>
                          </button>
                        </form>
                        <!-- Edit NAS -->
                        <button type="button" class="btn btn-p btn-sm" onclick='openEditNasModal(<%- JSON.stringify(nas) %>)' title="Edit NAS Client">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <!-- Hapus NAS -->
                        <form action="/admin/radius/nas/delete" method="POST" onsubmit="return confirm('Hapus NAS <%= nas.nasname %>?')" style="display:inline;">
                          <input type="hidden" name="id" value="<%= nas.id %>">
                          <button type="submit" class="btn btn-d btn-sm" title="Hapus NAS"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center text-muted" style="padding:32px;">
                      <i class="bi bi-router" style="font-size:32px;opacity:0.4;display:block;margin-bottom:8px;"></i>
                      Belum ada NAS khusus terdaftar. Server akan menggunakan <strong>Global Shared Secret</strong> untuk semua router MikroTik.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: SESI ONLINE RADIUS -->
    <div id="tab-content-online" class="tab-pane">
      <div class="card-modern mb16">
        <div class="card-modern-hd">
          <div class="card-modern-title">
            <i class="bi bi-wifi text-success"></i> Sesi Aktif RADIUS (Active Connections)
            <span class="badge bs" style="font-size:11px;" id="online-badge-indicator">
              <span class="live-dot" style="width:6px;height:6px;background:#fff;display:inline-block;border-radius:50%;margin-right:4px;"></span>
              <span id="online-counter-label"><%= onlineSessions.length %> Sesi Terhubung</span>
            </span>
          </div>
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <label class="auto-refresh-badge" title="Perbarui data otomatis secara real-time">
              <input type="checkbox" id="autoRefreshOnline" checked onchange="toggleAutoRefreshOnline(this)">
              <span>Live Auto-Sync</span>
              <span class="refresh-timer-count" id="onlineTimerCountdown">10s</span>
            </label>
            <button type="button" class="btn btn-g btn-sm" id="btnManualRefreshOnline" onclick="refreshOnlineSessions(false)" title="Refresh Sesi Sekarang">
              <i class="bi bi-arrow-clockwise" id="iconRefreshOnline"></i> Refresh
            </button>
            <button type="button" class="btn btn-p btn-sm" onclick="exportRadiusOnlineCsv()" title="Export CSV Sesi Aktif">
              <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
            </button>
          </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="table-toolbar">
          <div class="search-filter-wrap">
            <div class="search-input-box">
              <i class="bi bi-search search-icon"></i>
              <input type="text" id="radiusSearchInput" placeholder="Cari username, IP, pelanggan..." oninput="filterRadiusOnlineTable()" autocomplete="off">
              <button type="button" class="btn-clear-search" id="radiusClearSearch" onclick="clearRadiusSearch()">&times;</button>
            </div>
            
            <div style="min-width:180px;">
              <select id="radiusNasFilter" class="fs" style="padding:6px 12px;font-size:12px;height:auto;background:var(--bg3);border-color:var(--border);" onchange="filterRadiusOnlineTable()">
                <option value="">Semua Router NAS</option>
                <% if (nasList && nasList.length > 0) { %>
                  <% nasList.forEach(nas => { %>
                    <option value="<%= nas.nasname %>"><%= nas.shortname ? `${nas.shortname} (${nas.nasname})` : nas.nasname %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>

          <div style="font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px;">
            <span>Menampilkan:</span>
            <strong id="filteredSessionCount" style="color:var(--text);"><%= onlineSessions.length %></strong> sesi
          </div>
        </div>

        <div class="card-bd" style="padding:0;">
          <div class="tbl-wrap">
            <table class="dtbl" id="radiusOnlineTable">
              <thead>
                <tr>
                  <th style="width:45px;">#</th>
                  <th>Username &amp; Pelanggan</th>
                  <th>IP Address &amp; Router NAS</th>
                  <th>Trafik Data (In / Out)</th>
                  <th>Durasi Sesi</th>
                  <th>Waktu Update</th>
                  <th style="width:110px;text-align:right;">Aksi</th>
                </tr>
              </thead>
              <tbody id="radiusOnlineTableBody">
                <% if (onlineSessions && onlineSessions.length > 0) { %>
                  <% onlineSessions.forEach((s, idx) => { %>
                    <%
                      const totalIn = ((s.input_gigawords || 0) * 4294967296) + (s.input_octets || 0);
                      const totalOut = ((s.output_gigawords || 0) * 4294967296) + (s.output_octets || 0);
                      const inMB = totalIn >= 1073741824 ? (totalIn / 1073741824).toFixed(2) + ' GB' : (totalIn / 1048576).toFixed(2) + ' MB';
                      const outMB = totalOut >= 1073741824 ? (totalOut / 1073741824).toFixed(2) + ' GB' : (totalOut / 1048576).toFixed(2) + ' MB';
                      const st = s.session_time || 0;
                      const h = Math.floor(st / 3600);
                      const m = Math.floor((st % 3600) / 60);
                      const sec = st % 60;
                      const stStr = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
                      const rowKey = s.session_id ? `sess-${String(s.session_id).replace(/[^a-zA-Z0-9_-]/g, '')}` : `user-${s.username}`;
                    %>
                    <tr id="radius-row-<%= rowKey %>" class="radius-session-row" 
                        data-username="<%= (s.username || '').toLowerCase() %>" 
                        data-customer="<%= (s.customer_name || '').toLowerCase() %>" 
                        data-ip="<%= s.framed_ip || '' %>" 
                        data-nas="<%= s.nas_ip || '' %>">
                      <td style="color:var(--muted);font-size:11px;font-family:monospace;"><%= idx + 1 %></td>
                      <td>
                        <div style="font-weight:700;color:var(--text);display:flex;align-items:center;gap:6px;">
                          <span><%= s.username %></span>
                          <button type="button" class="btn-copy-sm" onclick="copyText('<%= s.username %>', this)" title="Salin Username">
                            <i class="bi bi-copy"></i>
                          </button>
                        </div>
                        <div style="font-size:11.5px;color:var(--muted);margin-top:2px;">
                          <%= s.customer_name || 'Pelanggan Mandiri' %>
                        </div>
                      </td>
                      <td>
                        <div style="display:flex;flex-direction:column;gap:3px;">
                          <span style="font-family:monospace;font-size:12px;color:#10b981;font-weight:700;">
                            <i class="bi bi-hdd-network"></i> <%= s.framed_ip || '-' %>
                          </span>
                          <span style="font-size:10.5px;color:var(--muted);font-family:monospace;">
                            NAS: <%= s.nas_ip || '-' %>
                          </span>
                        </div>
                      </td>
                      <td>
                        <div style="display:flex;flex-direction:column;gap:2px;font-size:11px;font-family:monospace;">
                          <span style="color:#38bdf8;"><i class="bi bi-arrow-up"></i> <%= inMB %></span>
                          <span style="color:#34d399;"><i class="bi bi-arrow-down"></i> <%= outMB %></span>
                        </div>
                      </td>
                      <td>
                        <span class="badge" style="background:rgba(99,102,241,0.12);color:var(--primary);font-family:monospace;font-weight:700;font-size:11.5px;">
                          <i class="bi bi-clock-history"></i> <%= stStr %>
                        </span>
                      </td>
                      <td>
                        <span style="font-size:11px;color:var(--muted);"><%= s.updated_at %></span>
                      </td>
                      <td style="text-align:right;white-space:nowrap;">
                        <button type="button" class="btn btn-d btn-sm" onclick="disconnectRadiusSession('<%= s.username %>', '<%= s.session_id %>', '<%= s.nas_ip %>', this)" title="Putuskan Sesi Active RADIUS">
                          <i class="bi bi-power"></i> Putuskan
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>

            <div id="radiusOnlineEmptyState" class="empty-state-box" style="display:<%= (!onlineSessions || onlineSessions.length === 0) ? 'block' : 'none' %>;">
              <i class="bi bi-wifi-off"></i>
              <h4>Belum Ada Sesi Aktif Terhubung</h4>
              <p>Saat pelanggan melakukan dial PPPoE atau hotspot melalui RADIUS, sesi koneksi langsung terpantau di sini secara real-time.</p>
              <div style="margin-top:14px;">
                <button type="button" class="btn btn-g btn-sm" onclick="refreshOnlineSessions(false)">
                  <i class="bi bi-arrow-clockwise"></i> Periksa Ulang
                </button>
              </div>
            </div>

            <div id="radiusOnlineSearchEmpty" class="empty-state-box" style="display:none;">
              <i class="bi bi-search"></i>
              <h4>Tidak Ditemukan Hasil Pencarian</h4>
              <p>Tidak ada sesi online yang cocok dengan kata kunci atau filter yang Anda masukkan.</p>
              <div style="margin-top:14px;">
                <button type="button" class="btn btn-g btn-sm" onclick="clearRadiusSearch()">
                  <i class="bi bi-x-circle"></i> Reset Filter
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- TAB 4: LOG ACCOUNTING -->
    <div id="tab-content-accounting" class="tab-pane" style="display:none;">
      <div class="card-modern mb16">
        <div class="card-modern-hd">
          <div class="card-modern-title">
            <i class="bi bi-journal-text text-warning"></i> Log Accounting RADIUS (100 Terakhir)
            <span class="badge" style="background:rgba(245,158,11,0.12);color:#f59e0b;font-size:11px;">
              <%= acctLogs ? acctLogs.length : 0 %> Log Terbaru
            </span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <div class="search-input-box" style="max-width:240px;">
              <i class="bi bi-search search-icon"></i>
              <input type="text" id="accountingSearchInput" placeholder="Cari log..." oninput="filterAccountingTable()" autocomplete="off">
            </div>
            <button type="button" class="btn btn-g btn-sm" onclick="exportAccountingCsv()">
              <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
            </button>
          </div>
        </div>
        <div class="card-bd" style="padding:0;">
          <div class="tbl-wrap">
            <table class="dtbl" id="accountingTable">
              <thead>
                <tr>
                  <th style="width:50px;">ID</th>
                  <th>Username</th>
                  <th>Session ID</th>
                  <th>NAS IP</th>
                  <th>Status Type</th>
                  <th>Upload (In)</th>
                  <th>Download (Out)</th>
                  <th>Durasi Sesi</th>
                  <th>Timestamp</th>
                </tr>
              </thead>
              <tbody id="accountingTableBody">
                <% if (acctLogs && acctLogs.length > 0) { %>
                  <% acctLogs.forEach(log => { %>
                    <%
                      const logIn = ((log.input_gigawords || 0) * 4294967296) + (log.input_octets || 0);
                      const logOut = ((log.output_gigawords || 0) * 4294967296) + (log.output_octets || 0);
                      const logInStr = logIn >= 1073741824 ? (logIn / 1073741824).toFixed(2) + ' GB' : (logIn / 1048576).toFixed(2) + ' MB';
                      const logOutStr = logOut >= 1073741824 ? (logOut / 1073741824).toFixed(2) + ' GB' : (logOut / 1048576).toFixed(2) + ' MB';
                      const lst = log.session_time || 0;
                      const lh = Math.floor(lst / 3600);
                      const lm = Math.floor((lst % 3600) / 60);
                      const ls = lst % 60;
                      const lstStr = `${String(lh).padStart(2,'0')}:${String(lm).padStart(2,'0')}:${String(ls).padStart(2,'0')}`;
                    %>
                    <tr class="accounting-row" data-username="<%= (log.username || '').toLowerCase() %>" data-nas="<%= log.nas_ip || '' %>" data-session="<%= (log.session_id || '').toLowerCase() %>">
                      <td style="color:var(--muted);font-family:monospace;font-size:11px;">#<%= log.id %></td>
                      <td><strong style="color:var(--text);"><%= log.username %></strong></td>
                      <td><code style="font-size:11px;"><%= log.session_id %></code></td>
                      <td style="font-family:monospace;font-size:11.5px;"><%= log.nas_ip %></td>
                      <td>
                        <% if (log.status_type === 1) { %>
                          <span class="badge bs"><i class="bi bi-play-circle-fill"></i> Start</span>
                        <% } else if (log.status_type === 2) { %>
                          <span class="badge bd"><i class="bi bi-stop-circle-fill"></i> Stop</span>
                        <% } else { %>
                          <span class="badge bp"><i class="bi bi-arrow-repeat"></i> Interim</span>
                        <% } %>
                      </td>
                      <td style="font-family:monospace;font-size:11.5px;color:#38bdf8;"><%= logInStr %></td>
                      <td style="font-family:monospace;font-size:11.5px;color:#34d399;"><%= logOutStr %></td>
                      <td><code><%= lstStr %></code></td>
                      <td style="font-size:11.5px;color:var(--muted);"><%= log.created_at %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="9" class="text-center text-muted" style="padding:28px;">
                      <i class="bi bi-journal-x" style="font-size:32px;opacity:0.4;display:block;margin-bottom:8px;"></i>
                      Belum ada data log accounting RADIUS yang tercatat.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container"></div>

  </div>
</div>

