<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Verifikasi Setoran Kas Kolektor | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css?v=2.7">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'collector_settlements', company }) %>

<div class="mw">
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-wallet2"></i>
      <span>Verifikasi Setoran Kas Kolektor</span>
    </div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/collector-settlements?status=pending" class="btn btn-g btn-sm <%= status==='pending'?'btn-p':'' %>">Pending</a>
      <a href="/admin/collector-settlements?status=approved" class="btn btn-g btn-sm <%= status==='approved'?'btn-p':'' %>">Approved</a>
      <a href="/admin/collector-settlements?status=rejected" class="btn btn-g btn-sm <%= status==='rejected'?'btn-p':'' %>">Rejected</a>
    </div>
  </div>

  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'d':'s' %>"><%= msg.text %></div>
    <% } %>

    <div style="display:flex;gap:8px;margin-bottom:14px;">
      <a href="/admin/collector-payments" class="btn btn-g btn-sm fw6"><i class="bi bi-receipt"></i> Tagihan Pelanggan</a>
      <a href="/admin/collector-settlements" class="btn btn-p btn-sm fw6"><i class="bi bi-wallet2"></i> Setoran Kas Kolektor</a>
    </div>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-cash-stack"></i> Daftar Pengajuan Setoran Kas (<%= (rows || []).length %>)</h6>
      </div>
      <div class="hint" style="padding:12px 16px 0 16px;font-size:12px;color:var(--muted)">
        Halaman ini digunakan kasir/admin kantor untuk menerima dan memverifikasi uang fisik/transfer yang diserahkan oleh petugas kolektor lapangan.
      </div>
      <div class="tbl-wrap" style="margin-top: 12px;">
        <table class="dtbl">
          <thead>
            <tr>
              <th>Waktu</th>
              <th>Kolektor</th>
              <th class="num">Nominal Setor</th>
              <th>Metode</th>
              <th>Catatan Kolektor</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows || rows.length === 0) { %>
              <tr><td colspan="7" class="text-center text-muted" style="padding:24px">Tidak ada data pengajuan setoran kas.</td></tr>
            <% } else { %>
              <% rows.forEach(s => { %>
                <tr>
                  <td style="font-size:11px;color:var(--muted)"><%= s.created_at ? new Date(s.created_at).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-' %></td>
                  <td class="fw6">
                    <div><%= s.collector_name %> <span class="text-muted" style="font-size:11px"><%= s.collector_username ? '(@'+s.collector_username+')' : '' %></span></div>
                    <div style="font-size:11px;color:var(--muted)">Area: <%= s.collector_area || '-' %></div>
                  </td>
                  <td class="num fw6" style="font-size:15px;color:#10b981;">
                    Rp <%= Number(s.amount || 0).toLocaleString('id-ID') %>
                  </td>
                  <td>
                    <span class="badge <%= s.method === 'transfer' ? 'bp' : 'bs' %>">
                      <i class="bi <%= s.method === 'transfer' ? 'bi-bank' : 'bi-cash-coin' %>"></i>
                      <%= s.method === 'transfer' ? 'Transfer Bank' : 'Tunai Fisik' %>
                    </span>
                  </td>
                  <td style="font-size:12px;color:var(--muted)">
                    <%= s.note || '-' %>
                  </td>
                  <td>
                    <% if (s.status === 'approved') { %>
                      <span class="badge bs"><i class="bi bi-check-circle-fill"></i> Diterima</span>
                    <% } else if (s.status === 'rejected') { %>
                      <span class="badge bd"><i class="bi bi-x-circle-fill"></i> Ditolak</span>
                    <% } else { %>
                      <span class="badge bm"><i class="bi bi-hourglass-split"></i> Menunggu Kasir</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.status === 'pending') { %>
                      <div style="display:flex;gap:6px;flex-wrap:wrap">
                        <form method="POST" action="/admin/collector-settlements/<%= s.id %>/approve" onsubmit="return confirm('Konfirmasi terima uang fisik/setoran sebesar Rp <%= Number(s.amount).toLocaleString('id-ID') %> dari kolektor <%= s.collector_name %>?')">
                          <input type="text" name="decided_note" placeholder="Catatan kasir..." style="font-size:11px;padding:3px 6px;max-width:110px;border:1px solid var(--border);border-radius:4px;">
                          <button type="submit" class="btn btn-s btn-sm"><i class="bi bi-check-lg"></i> Terima</button>
                        </form>
                        <form method="POST" action="/admin/collector-settlements/<%= s.id %>/reject" onsubmit="return confirm('Tolak pengajuan setoran ini?')">
                          <input type="text" name="decided_note" placeholder="Alasan tolak..." style="font-size:11px;padding:3px 6px;max-width:110px;border:1px solid var(--border);border-radius:4px;">
                          <button type="submit" class="btn btn-d btn-sm"><i class="bi bi-x-lg"></i> Tolak</button>
                        </form>
                      </div>
                    <% } else { %>
                      <div style="font-size:11px;color:var(--muted)">
                        <div>Oleh: <strong><%= s.decided_by_name || '-' %></strong> (<%= s.decided_by_role || '-' %>)</div>
                        <div>Tgl: <%= s.decided_at ? new Date(s.decided_at).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-' %></div>
                        <% if (s.decided_note) { %><div>Catatan: <em><%= s.decided_note %></em></div><% } %>
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>