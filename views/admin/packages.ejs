                <form method="POST" action="/admin/packages/<%= p.id %>/delete" style="display:inline" onsubmit="return confirmDeletePkg('<%= p.name.replace(/'/g, "\\'") %>', <%= p.customer_count || 0 %>)">
                  <button class="btn btn-d btn-icon btn-sm" title="Hapus Paket"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
</div>

