          </div>

          <div class="form-section-card" style="border-left:3px solid #f59e0b;">
            <div class="form-section-title" style="color:#f59e0b;">
              <i class="bi bi-percent"></i> Promo &amp; Prorata Awal
            </div>
            <div class="form-row">
              <div class="fg">
                <label class="fl">Harga Promo (Rp / siklus)</label>
                <input class="fc" name="promo_price" id="e_promo_price" type="number" min="0" placeholder="Kosong = tanpa diskon">
              </div>
              <div class="fg">
                <label class="fl">Jumlah Bulan Promo</label>
                <input class="fc" name="promo_cycles" id="e_promo_cycles" type="number" min="0" value="0">
              </div>
            </div>
            <div class="flex ai-c" style="gap:8px;margin-top:8px">
              <input type="checkbox" name="prorate_first_invoice" id="e_prorate" value="1">
              <label for="e_prorate" style="margin:0;font-size:12px;cursor:pointer">
                <strong>Prorata tagihan pertama</strong> (hitung sisa hari aktif bulan pasang)
              </label>
            </div>
          </div>
        </div>

        <!-- TAB 4: PAJAK & FUP / JAM KALONG (EDIT) -->
        <div class="mo-tab-content" id="edit_tab_advanced">
          <!-- Pajak Section -->
          <div class="form-section-card" style="border-left:3px solid #06b6d4;">
            <div class="form-section-title" style="color:#06b6d4;">
              <i class="bi bi-receipt"></i> Pajak &amp; Regulasi (PPN &amp; USO)
            </div>
            <div class="form-row">
              <div class="fg">
                <label style="display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;margin-top:20px;cursor:pointer">
                  <input type="checkbox" name="use_ppn" id="e_use_ppn" value="1">
                  Aktifkan PPN Tambahan
                </label>
              </div>
              <div class="fg">
                <label class="fl">Persentase PPN (%)</label>
                <input class="fc" name="ppn_percentage" id="e_ppn_percentage" type="number" step="any" min="0">
              </div>
            </div>
            <div class="form-row">
              <div class="fg">
                <label style="display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;margin-top:20px;cursor:pointer">
                  <input type="checkbox" name="use_uso" id="e_use_uso" value="1">
                  Aktifkan ULO/USO
                </label>
              </div>
              <div class="fg">
                <label class="fl">Persentase ULO/USO (%)</label>
                <input class="fc" name="uso_percentage" id="e_uso_percentage" type="number" step="any" min="0">
              </div>
            </div>
          </div>

          <!-- Jam Kalong Malam -->
          <div class="form-section-card" style="border-left:3px solid #a855f7;">
            <div class="flex ai-c" style="gap:10px;margin-bottom:8px">
              <input type="checkbox" name="use_night_speed" id="e_use_night" value="1" onchange="toggleEditNight()">
              <label for="e_use_night" class="form-section-title" style="margin:0;color:#a855f7;cursor:pointer">
                <i class="bi bi-moon-stars"></i> Bonus Jam Kalong (Malam Hari 00:00 - 06:00)
              </label>
            </div>
            <div id="e_night_fields" style="display:none;margin-top:10px">
              <div class="fg">
                <label class="fl">Nama Profile Malam (MikroTik)</label>
                <div style="display:flex;gap:8px">
                  <select class="fs" id="e_night_profile_select" style="max-width:210px" onchange="document.getElementById('e_night_profile').value=this.value">
                    <option value="">-- Pilih Profile --</option>
                  </select>
                  <input class="fc" name="night_profile_name" id="e_night_profile">
                </div>
              </div>
              <div class="form-row">
                <div class="fg"><label class="fl">Download Malam (Mbps)</label><input class="fc" name="night_speed_down" id="e_night_down" type="number" step="any" min="0"></div>
                <div class="fg"><label class="fl">Upload Malam (Mbps)</label><input class="fc" name="night_speed_up" id="e_night_up" type="number" step="any" min="0"></div>
              </div>
            </div>
          </div>

          <!-- FUP Policy -->
          <div class="form-section-card" style="border-left:3px solid #ef4444;">
            <div class="flex ai-c" style="gap:10px;margin-bottom:8px">
              <input type="checkbox" name="use_fup" id="e_use_fup" value="1" onchange="toggleEditFup()">
              <label for="e_use_fup" class="form-section-title" style="margin:0;color:#ef4444;cursor:pointer">
                <i class="bi bi-speedometer2"></i> Kebijakan Batas Kuota Wajar (FUP)
              </label>
            </div>
            <div id="e_fup_fields" style="display:none;margin-top:10px">
              <div class="fg">
                <label class="fl">Nama Profile FUP (MikroTik)</label>
                <div style="display:flex;gap:8px">
                  <select class="fs" id="e_fup_profile_select" style="max-width:210px" onchange="document.getElementById('e_fup_profile').value=this.value">
                    <option value="">-- Pilih Profile --</option>
                  </select>
                  <input class="fc" name="fup_profile_name" id="e_fup_profile">
                </div>
              </div>
              <div class="form-row">
                <div class="fg"><label class="fl">Batas Kuota Bulanan (GB)</label><input class="fc" name="fup_limit_gb" id="e_fup_limit" type="number" step="any" min="0"></div>
                <div class="fg"><label class="fl">Speed Pasca FUP (Mbps)</label><input class="fc" name="fup_speed_down" id="e_fup_speed" type="number" step="any" min="0"></div>
              </div>
            </div>
          </div>
        </div>

      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('admin.packages.update', 'Perbarui Paket') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Floating Toast Element -->
<div id="pkgToast"><i class="bi bi-info-circle-fill text-primary"></i> <span id="pkgToastText"></span></div>

<script type="application/json" id="packages-data"><%- JSON.stringify(packages) %></script>
<script>
const packagesData = JSON.parse(document.getElementById('packages-data').textContent);

function showToast(text, iconClass = 'bi-check-circle-fill text-success') {
  const toast = document.getElementById('pkgToast');
  const toastText = document.getElementById('pkgToastText');
  toast.innerHTML = `<i class="bi ${iconClass}"></i> <span>${text}</span>`;
  toast.style.display = 'flex';
  setTimeout(() => { toast.style.display = 'none'; }, 3200);
}

function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
document.querySelectorAll('.mo').forEach(m => m.addEventListener('click', e => { if (e.target === m) m.classList.remove('show'); }));

function openAddModal() {
  document.getElementById('addForm').reset();
  document.getElementById('add_billing_type').value = 'postpaid';
  toggleAddBillingType('postpaid');
  toggleAddNight();
  toggleAddFup();
  switchAddTab('add_tab_general', document.querySelector('#addModal .mo-tab-btn'));
  openModal('addModal');
}

// Tab Switching
function switchAddTab(tabId, btn) {
  document.querySelectorAll('#addModal .mo-tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('#addModal .mo-tab-content').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(tabId).classList.add('active');
}

function switchEditTab(tabId, btn) {
  document.querySelectorAll('#editModal .mo-tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('#editModal .mo-tab-content').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(tabId).classList.add('active');
}

// Edit Package Pre-fill
function editPkg(idx) {
  const p = packagesData[idx];
  if (!p) return;
  document.getElementById('editForm').action = '/admin/packages/' + p.id + '/update';
  document.getElementById('e_name').value = p.name || '';
  document.getElementById('e_router_id').value = p.router_id || '';
  document.getElementById('e_price').value = p.price || 0;
  document.getElementById('e_promo_price').value = (p.promo_price != null && p.promo_price !== '') ? p.promo_price : '';
  document.getElementById('e_promo_cycles').value = p.promo_cycles != null ? p.promo_cycles : 0;
  document.getElementById('e_prorate').checked = !!p.prorate_first_invoice;
  document.getElementById('e_use_ppn').checked = !!p.use_ppn;
  document.getElementById('e_ppn_percentage').value = p.ppn_percentage != null ? p.ppn_percentage : 11.0;
  document.getElementById('e_use_uso').checked = !!p.use_uso;
  document.getElementById('e_uso_percentage').value = p.uso_percentage != null ? p.uso_percentage : 1.75;
  document.getElementById('e_down').value = p.speed_down ? (p.speed_down/1000) : 0;
  document.getElementById('e_up').value = p.speed_up ? (p.speed_up/1000) : 0;
  document.getElementById('e_down_upto').value = p.speed_down_upto ? (p.speed_down_upto/1000) : '';
  document.getElementById('e_up_upto').value = p.speed_up_upto ? (p.speed_up_upto/1000) : '';
  document.getElementById('e_night_down').value = p.night_speed_down ? (p.night_speed_down/1000) : 0;
  document.getElementById('e_night_up').value = p.night_speed_up ? (p.night_speed_up/1000) : 0;
  document.getElementById('e_night_profile').value = p.night_profile_name || '';
  document.getElementById('e_use_night').checked = !!p.use_night_speed;
  document.getElementById('e_night_fields').style.display = p.use_night_speed ? 'block' : 'none';

  document.getElementById('e_fup_limit').value = p.fup_limit_gb || 0;
  document.getElementById('e_fup_speed').value = p.fup_speed_down ? (p.fup_speed_down/1000) : 0;
  document.getElementById('e_fup_profile').value = p.fup_profile_name || '';
  document.getElementById('e_use_fup').checked = !!p.use_fup;
  document.getElementById('e_fup_fields').style.display = p.use_fup ? 'block' : 'none';

  document.getElementById('e_active').value = p.is_active ? '1' : '0';
  document.getElementById('e_desc').value = p.description || '';
  
  const isPrepaid = p.billing_type === 'prepaid';
  document.getElementById('e_billing_type').value = isPrepaid ? 'prepaid' : 'postpaid';
  document.getElementById('e_duration_days').value = p.duration_days || 30;
  document.getElementById('e_duration_days_fg').style.display = isPrepaid ? 'block' : 'none';

  switchEditTab('edit_tab_general', document.querySelector('#editModal .mo-tab-btn'));
  openModal('editModal');
}

// Clone / Duplicate Package
function clonePkg(idx) {
  const p = packagesData[idx];
  if (!p) return;
  document.getElementById('addForm').reset();
  document.getElementById('add_name').value = (p.name || '') + ' (Kloning)';
  document.getElementById('add_router_id').value = p.router_id || '';
  document.getElementById('add_price').value = p.price || 0;
  document.getElementById('add_description').value = p.description || '';
  document.getElementById('add_down').value = p.speed_down ? (p.speed_down/1000) : 0;
  document.getElementById('add_up').value = p.speed_up ? (p.speed_up/1000) : 0;
  document.getElementById('add_down_upto').value = p.speed_down_upto ? (p.speed_down_upto/1000) : '';
  document.getElementById('add_up_upto').value = p.speed_up_upto ? (p.speed_up_upto/1000) : '';
  
  const isPrepaid = p.billing_type === 'prepaid';
  document.getElementById('add_billing_type').value = isPrepaid ? 'prepaid' : 'postpaid';
  document.getElementById('add_duration_days').value = p.duration_days || 30;
  document.getElementById('add_duration_days_fg').style.display = isPrepaid ? 'block' : 'none';

  document.getElementById('add_promo_price').value = (p.promo_price != null && p.promo_price !== '') ? p.promo_price : '';
  document.getElementById('add_promo_cycles').value = p.promo_cycles != null ? p.promo_cycles : 0;
  document.getElementById('add_prorate').checked = !!p.prorate_first_invoice;

  document.getElementById('add_use_ppn').checked = !!p.use_ppn;
  document.getElementById('add_ppn_percentage').value = p.ppn_percentage != null ? p.ppn_percentage : 11.0;
  document.getElementById('add_use_uso').checked = !!p.use_uso;
  document.getElementById('add_uso_percentage').value = p.uso_percentage != null ? p.uso_percentage : 1.75;

  document.getElementById('add_use_night').checked = !!p.use_night_speed;
  document.getElementById('add_night_speed_down').value = p.night_speed_down ? (p.night_speed_down/1000) : 0;
  document.getElementById('add_night_speed_up').value = p.night_speed_up ? (p.night_speed_up/1000) : 0;
  document.getElementById('add_night_profile_input').value = p.night_profile_name || '';
  toggleAddNight();

  document.getElementById('add_use_fup').checked = !!p.use_fup;
  document.getElementById('add_fup_limit_gb').value = p.fup_limit_gb || 0;
  document.getElementById('add_fup_speed_down').value = p.fup_speed_down ? (p.fup_speed_down/1000) : 0;
  document.getElementById('add_fup_profile_input').value = p.fup_profile_name || '';
  toggleAddFup();

  switchAddTab('add_tab_general', document.querySelector('#addModal .mo-tab-btn'));
  openModal('addModal');
  showToast(`Data paket "${p.name}" berhasil dikloning. Silakan sesuaikan dan simpan.`, 'bi-copy text-info');
}

// Quick AJAX Status Toggle
async function togglePackageStatus(pkgId, checkbox) {
  const label = document.getElementById('status_label_' + pkgId);
  const row = checkbox.closest('.pkg-row');
  try {
    const res = await fetch(`/admin/packages/${pkgId}/toggle-status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (data.ok) {
      const isActive = !!data.is_active;
      checkbox.checked = isActive;
      label.textContent = isActive ? 'Aktif' : 'Nonaktif';
      label.style.color = isActive ? 'var(--success)' : 'var(--muted)';
      if (row) row.dataset.status = isActive ? 'active' : 'inactive';
      showToast(`Status paket berhasil diubah ke ${isActive ? 'Aktif' : 'Nonaktif'}.`);
    } else {
      checkbox.checked = !checkbox.checked;
      showToast('Gagal mengubah status: ' + (data.error || 'Unknown error'), 'bi-exclamation-triangle-fill text-danger');
    }
  } catch (err) {
    checkbox.checked = !checkbox.checked;
    showToast('Terjadi kesalahan jaringan.', 'bi-exclamation-triangle-fill text-danger');
  }
}

// Delete Confirmation with Customer Warning
function confirmDeletePkg(name, customerCount) {
  if (customerCount > 0) {
    return confirm(`⚠️ PERINGATAN: Paket "${name}" saat ini sedang digunakan oleh ${customerCount} pelanggan aktif!\n\nJika dihapus, pelanggan tersebut akan kehilangan referensi paket internet mereka.\n\nApakah Anda benar-benar yakin ingin menghapus paket ini?`);
  }
  return confirm(`Hapus paket internet "${name}"?`);
}

function toggleAddBillingType(val) {
  document.getElementById('add_duration_days_fg').style.display = (val === 'prepaid') ? 'block' : 'none';
}
function toggleEditBillingType(val) {
  document.getElementById('e_duration_days_fg').style.display = (val === 'prepaid') ? 'block' : 'none';
}
function toggleAddNight() { document.getElementById('add_night_fields').style.display = document.getElementById('add_use_night').checked ? 'block' : 'none'; }
function toggleAddFup() { document.getElementById('add_fup_fields').style.display = document.getElementById('add_use_fup').checked ? 'block' : 'none'; }
function toggleEditNight() { document.getElementById('e_night_fields').style.display = document.getElementById('e_use_night').checked ? 'block' : 'none'; }
function toggleEditFup() { document.getElementById('e_fup_fields').style.display = document.getElementById('e_use_fup').checked ? 'block' : 'none'; }

// Filter Table Logic
function filterTable() {
  const query = (document.getElementById('pkgSearch').value || '').toLowerCase().trim();
  const statusFilter = document.getElementById('filterStatus').value;
  const billingFilter = document.getElementById('filterBilling').value;

  const rows = document.querySelectorAll('.pkg-row');
  let visibleCount = 0;

  rows.forEach(r => {
    const name = r.dataset.name || '';
    const desc = r.dataset.desc || '';
    const status = r.dataset.status || '';
    const billing = r.dataset.billing || '';

    const matchQuery = !query || name.includes(query) || desc.includes(query);
    const matchStatus = !statusFilter || status === statusFilter;
    const matchBilling = !billingFilter || billing === billingFilter;

    if (matchQuery && matchStatus && matchBilling) {
      r.style.display = '';
      visibleCount++;
    } else {
      r.style.display = 'none';
    }
  });

  const countEl = document.getElementById('visiblePkgCount');
  if (countEl) countEl.textContent = visibleCount;
}

function filterByStatCard(status) {
  document.querySelectorAll('.stat-grid .sc').forEach(c => c.classList.remove('stat-card-active'));
  if (status === 'active') {
    document.getElementById('sc_active').classList.add('stat-card-active');
    document.getElementById('filterStatus').value = 'active';
  } else if (status === 'inactive') {
    document.getElementById('sc_inactive').classList.add('stat-card-active');
    document.getElementById('filterStatus').value = 'inactive';
  } else {
    document.getElementById('sc_all').classList.add('stat-card-active');
    document.getElementById('filterStatus').value = '';
  }
  filterTable();
}

// Auto-Push PPP Profile ke Router MikroTik
async function pushPkgToMikrotik(pkgId, pkgName, btn) {
  const origHtml = btn ? btn.innerHTML : '';
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin text-primary"></i>';
  }
  showToast(`Sedang melakukan sinkronisasi profile "${pkgName}" ke MikroTik...`, 'bi-arrow-repeat spin text-primary');
  try {
    const res = await fetch(`/admin/packages/${pkgId}/push-mikrotik`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (data.ok) {
      const successes = (data.results || []).filter(r => r.action !== 'failed');
      const fails = (data.results || []).filter(r => r.action === 'failed');
      if (successes.length > 0) {
        const routerNames = successes.map(s => s.routerName).join(', ');
        showToast(`Profile "${pkgName}" (${data.rateLimit}) berhasil di-push ke MikroTik (${routerNames})!`, 'bi-check-circle-fill text-success');
      } else if (fails.length > 0) {
        showToast(`Sinkronisasi gagal ke router ${fails[0].routerName}: ${fails[0].error}`, 'bi-exclamation-triangle-fill text-danger');
      } else {
        showToast(data.message || 'Tidak ada router aktif untuk disinkronkan.', 'bi-info-circle text-info');
      }
    } else {
      showToast('Gagal push ke MikroTik: ' + (data.error || 'Terjadi kesalahan'), 'bi-exclamation-triangle-fill text-danger');
    }
  } catch (err) {
    showToast('Terjadi kesalahan jaringan: ' + err.message, 'bi-exclamation-triangle-fill text-danger');
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }
}

// Load MikroTik profiles into select dropdowns
async function loadProfiles() {
  try {
    const routerParam = '<%= (typeof selectedRouterId !== "undefined" && selectedRouterId) ? selectedRouterId : "" %>';
    const res = await fetch('/admin/api/mikrotik/profiles' + (routerParam ? '?routerId=' + routerParam : ''));
    if (!res.ok) return;
    const profiles = await res.json();
    const selAdd = document.getElementById('add_profile_select');
    const selEdit = document.getElementById('e_profile_select');
    const selAddNight = document.getElementById('add_night_profile_select');
    const selAddFup = document.getElementById('add_fup_profile_select');
    const selEditNight = document.getElementById('e_night_profile_select');
    const selEditFup = document.getElementById('e_fup_profile_select');

    profiles.forEach(p => {
      const opt = `<option value="${p.name}">${p.name}</option>`;
      if (selAdd) selAdd.innerHTML += opt;
      if (selEdit) selEdit.innerHTML += opt;
      if (selAddNight) selAddNight.innerHTML += opt;
      if (selAddFup) selAddFup.innerHTML += opt;
      if (selEditNight) selEditNight.innerHTML += opt;
      if (selEditFup) selEditFup.innerHTML += opt;
    });
  } catch (e) {
    console.error('Failed to load MikroTik profiles', e);
  }
}
loadProfiles();

setTimeout(() => document.querySelectorAll('.alert').forEach(a => a.style.display = 'none'), 4000);
</script>
</body>
</html>
