<div class="mo" id="mapCustomerModal">
  <div class="mb" style="max-width:480px">
    <div class="mh">
      <h3 class="mt"><i class="bi bi-person-plus text-primary"></i> Tautkan Modem ke Pelanggan</h3>
      <button class="mc" onclick="closeModal('mapCustomerModal')">&times;</button>
    </div>
    <div class="mbody">
      <form id="mapCustomerForm" onsubmit="submitMapCustomer(event)">
        <div style="background:var(--bg3); padding:12px 16px; border-radius:10px; margin-bottom:16px; border:1px solid var(--border);">
          <div style="font-size:12px; color:var(--muted); margin-bottom:4px;">Serial Number Perangkat:</div>
          <div style="font-size:16px; font-weight:700; font-family:monospace; color:var(--text);" id="lblMapSn">-</div>
          <input type="hidden" id="inputMapSn" value="">
        </div>

        <div class="fg" style="margin-bottom:18px;">
          <label class="fl" style="font-weight:600; font-size:13px;">Pilih Pelanggan Billing</label>
          <select id="selectMapCustomer" class="fc" style="height:42px; font-size:13px;" required>
            <option value="">-- Pilih Pelanggan --</option>
            <% const mapCustList = (typeof customers !== 'undefined' && Array.isArray(customers)) ? customers : ((typeof customersList !== 'undefined' && Array.isArray(customersList)) ? customersList : []); %>
            <% mapCustList.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %> (<%= c.pppoe_username ? c.pppoe_username : (c.customer_code || 'ID: ' + c.id) %>)</option>
            <% }) %>
          </select>
          <small style="color:var(--muted); font-size:11px; margin-top:4px; display:block;">
            SN modem akan tersimpan di profil pelanggan dan otomatis sinkron dengan nama pelanggan di tabel.
          </small>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
          <button type="button" class="btn btn-g btn-sm" onclick="closeModal('mapCustomerModal')">Batal</button>
          <button type="submit" class="btn btn-p btn-sm" id="btnSubmitMapCustomer">
            <i class="bi bi-check-circle"></i> Simpan Tautan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// ── CUSTOMER MAPPING HELPERS ──
function openMapCustomerModal(sn) {
    const inputSn = document.getElementById('inputMapSn');
    const lblSn = document.getElementById('lblMapSn');
    const select = document.getElementById('selectMapCustomer');
    if (inputSn) inputSn.value = sn;
    if (lblSn) lblSn.textContent = sn;
    if (select) select.value = '';
    openModal('mapCustomerModal');
}

async function submitMapCustomer(e) {
    e.preventDefault();
    const sn = document.getElementById('inputMapSn').value;
    const customerId = document.getElementById('selectMapCustomer').value;
    const btn = document.getElementById('btnSubmitMapCustomer');

    if (!sn || !customerId) {
        alert('Silakan pilih pelanggan terlebih dahulu.');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Menyimpan...';

    try {
        const res = await fetch('/admin/acs/map-customer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sn, customerId })
        });
        const data = await res.json();
        if (data.success) {
            closeModal('mapCustomerModal');
            window.location.reload();
        } else {
            alert(data.message || 'Gagal menyimpan tautan.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle"></i> Simpan Tautan';
        }
    } catch (err) {
        alert('Terjadi kesalahan: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle"></i> Simpan Tautan';
    }
}

async function unmapCustomer(sn, custName) {
    if (!confirm(`Lepas tautan perangkat SN ${sn} dari pelanggan "${custName || ''}"?`)) {
        return;
    }
    try {
        const res = await fetch('/admin/acs/unmap-customer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sn })
        });
        const data = await res.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.message || 'Gagal melepas tautan.');
        }
    } catch (err) {
        alert('Terjadi kesalahan: ' + err.message);
    }
}

// ── TAB SWITCHING ──
function switchAcsTab(tabName, btn) {
    document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.seg-tab-btn').forEach(b => b.classList.remove('active'));
    const target = document.getElementById('tab-' + tabName);
    if (target) target.classList.add('active');
    if (btn) btn.classList.add('active');
}

// ── MODAL HELPERS ──
function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
}

function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
    if (id === 'addWanModal') stopAddWanProgressPolling();
}

document.querySelectorAll('.mo').forEach(m => m.addEventListener('click', e => {
    if (e.target === m) closeModal(m.id);
}));

// ── CLIENT-SIDE FAST STATUS FILTERING ──
let currentActiveFilter = 'all';

function filterDevicesByStatus(status, el) {
    // 1. Jika pengguna sedang di tab lain (Kelola Server ACS / Console), otomatis alihkan ke tab Perangkat
    const tabBtnDev = document.getElementById('tabBtnDevices');
    if (tabBtnDev && !tabBtnDev.classList.contains('active')) {
        switchAcsTab('devices', tabBtnDev);
    }

    currentActiveFilter = status;
    


    // 3. Update status pills active style
    document.querySelectorAll('.status-pill-btn').forEach(b => {
        if (b.dataset.filter === status) b.classList.add('active');
        else b.classList.remove('active');
    });

    // 4. Terapkan filter ke baris tabel
    applyCombinedFilters();

    // 5. Scroll halus ke tabel jika posisi layar sudah scroll ke bawah
    if (window.scrollY > 300) {
        document.querySelector('.segmented-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

function instantFilterTable(query) {
    applyCombinedFilters(query);
}

function applyCombinedFilters(queryOverride) {
    const q = (typeof queryOverride === 'string' ? queryOverride : (document.getElementById('instantFilterInput')?.value || '')).trim().toLowerCase();
    const rows = document.querySelectorAll('#devicesTableBody tr.device-row');
    let visibleCount = 0;

    rows.forEach(row => {
        const isOnline = row.dataset.online === '1';
        const isCritical = row.dataset.critical === '1';

        // Check status filter
        let matchStatus = true;
        if (currentActiveFilter === 'online') matchStatus = isOnline;
        else if (currentActiveFilter === 'offline') matchStatus = !isOnline;
        else if (currentActiveFilter === 'critical') matchStatus = isCritical;

        // Check text query filter
        let matchText = true;
        if (q) {
            const sn = row.dataset.sn || '';
            const customer = row.dataset.customer || '';
            const pppoe = row.dataset.pppoe || '';
            const ip = row.dataset.ip || '';
            const ssid = row.dataset.ssid || '';
            matchText = sn.includes(q) || customer.includes(q) || pppoe.includes(q) || ip.includes(q) || ssid.includes(q);
        }

        if (matchStatus && matchText) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });

    // Handle empty row display
    let noRow = document.getElementById('dynamicNoDevicesRow');
    if (visibleCount === 0 && rows.length > 0) {
        if (!noRow) {
            noRow = document.createElement('tr');
            noRow.id = 'dynamicNoDevicesRow';
            noRow.innerHTML = `
                <td colspan="7">
                    <div class="empty-state" style="padding:28px 16px;">
                        <div class="empty-icon"><i class="bi bi-funnel"></i></div>
                        <div class="empty-title">Tidak Ada Hasil Cocok</div>
                        <div class="empty-desc">Tidak ada perangkat yang sesuai dengan filter atau kata kunci saat ini.</div>
                        <button class="btn btn-g btn-sm" onclick="resetClientFilters()"><i class="bi bi-arrow-counterclockwise"></i> Reset Filter</button>
                    </div>
                </td>
            `;
            document.getElementById('devicesTableBody').appendChild(noRow);
        }
    } else if (noRow) {
        noRow.remove();
    }
}

function resetClientFilters() {
    const input = document.getElementById('instantFilterInput');
    if (input) input.value = '';
    filterDevicesByStatus('all', document.querySelector('.status-pill-btn[data-filter="all"]'));
}

// ── WI-FI MODAL ACTIONS (DUAL BAND 2.4G & 5G) ──
function syncWifi5gPassword(chk) {
    const p24 = document.getElementById('acs_wifi_new_password');
    const p5 = document.getElementById('acs_wifi_new_password_5g');
    if (!p24 || !p5) return;
    if (chk && chk.checked) {
        if (!p24.value) {
            p24.focus();
            p24.placeholder = 'Ketik kata sandi 2.4 GHz di sini...';
        }
        p5.value = p24.value;
        p5.disabled = true;
        p5.placeholder = '(Mengikuti kata sandi 2.4 GHz)';
    } else {
        p5.disabled = false;
        p5.placeholder = 'Biarkan kosong jika tidak diubah';
    }
