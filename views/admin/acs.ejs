<!DOCTYPE html>
<html lang="<%= (typeof lang !== 'undefined' ? lang : 'id') %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GenieACS Pro | <%= company %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/admin.css?v=2.7">
    <style>
        /* ── PAGE LAYOUT & HEADER ── */
        .acs-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; }
        .acs-title-group { display: flex; flex-direction: column; gap: 4px; }
        .acs-title { font-size: 20px; font-weight: 800; color: var(--text); margin: 0; display: flex; align-items: center; gap: 10px; letter-spacing: -0.02em; }
        .acs-subtitle { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
        .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block; animation: pulse 1.8s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.85); } }

        /* ── KPI TELEMETRY GRID ── */
        .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
        @media(max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
        @media(max-width: 640px) { .kpi-grid { grid-template-columns: 1fr; } }

        .kpi-card { background: var(--bg2); border: 1px solid var(--border); border-radius: 14px; padding: 20px; position: relative; overflow: hidden; transition: all 0.22s ease; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; text-decoration: none; color: inherit; user-select: none; }
        .kpi-card:hover { transform: translateY(-3px); border-color: rgba(255,255,255,0.2); box-shadow: 0 8px 24px rgba(0,0,0,0.35); }
        .kpi-card.active-filter { border-color: var(--primary) !important; background: rgba(0, 82, 204, 0.12) !important; box-shadow: 0 0 0 1px var(--primary); }
        .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
        .kpi-card.c-primary::before { background: linear-gradient(90deg, #0052cc, #38bdf8); }
        .kpi-card.c-success::before { background: linear-gradient(90deg, #10b981, #34d399); }
        .kpi-card.c-danger::before { background: linear-gradient(90deg, #ef4444, #f87171); }
        .kpi-card.c-warning::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }

        .kpi-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .kpi-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.6px; }
        .kpi-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .kpi-card.c-primary .kpi-icon { background: rgba(0, 82, 204, 0.15); color: #38bdf8; }
        .kpi-card.c-success .kpi-icon { background: rgba(16, 185, 129, 0.15); color: #10b981; }
        .kpi-card.c-danger .kpi-icon { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
        .kpi-card.c-warning .kpi-icon { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }

        .kpi-body { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
        .kpi-val { font-size: 28px; font-weight: 800; line-height: 1; color: var(--text); font-variant-numeric: tabular-nums; }
        .kpi-badge { font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 999px; }
        .kpi-footer { font-size: 11px; color: var(--muted); border-top: 1px dashed var(--border); padding-top: 8px; display: flex; justify-content: space-between; align-items: center; }

        /* ── SEGMENTED NAVIGATION TABS ── */
        .segmented-tabs { display: inline-flex; background: var(--bg3); padding: 4px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 20px; }
        .seg-tab-btn { background: transparent; border: none; outline: none; padding: 8px 18px; border-radius: 9px; font-size: 13px; font-weight: 600; color: var(--muted); cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 8px; }
        .seg-tab-btn:hover { color: var(--text); }
        .seg-tab-btn.active { background: var(--bg2); color: var(--text); font-weight: 700; box-shadow: 0 2px 8px rgba(0,0,0,0.25); border: 1px solid var(--border); }
        .seg-tab-count { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 999px; background: rgba(255,255,255,0.08); color: var(--text); }

        /* ── CARD WRAPPER & TAB CONTENT ── */
        .acs-box { background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.18); }
        .tab-pane { padding: 22px; display: none; animation: fadeIn 0.25s ease; }
        .tab-pane.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

        /* ── SEARCH & FILTER TOOLBAR ── */
        .filter-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
        .filter-left { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; flex: 1; }
        .filter-right { display: flex; align-items: center; gap: 10px; }

        .search-box-unified { position: relative; min-width: 280px; max-width: 380px; flex: 1; }
        .search-box-unified i.bi-search { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 14px; pointer-events: none; }
        .search-box-unified .fc { padding-left: 36px; padding-right: 32px; height: 38px; border-radius: 9px; font-size: 13px; }
        .search-clear-btn { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: var(--muted); cursor: pointer; padding: 2px 6px; font-size: 14px; display: none; }
        .search-clear-btn:hover { color: var(--text); }

        .status-pills { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .status-pill-btn { border: 1px solid var(--border); background: var(--bg3); color: var(--muted); padding: 5px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.15s ease; display: inline-flex; align-items: center; gap: 6px; }
        .status-pill-btn:hover { border-color: rgba(255,255,255,0.2); color: var(--text); }
        .status-pill-btn.active { background: rgba(0, 82, 204, 0.18); border-color: var(--primary); color: #38bdf8; font-weight: 700; }

        /* ── BULK ACTION DOCK ── */
        .bulk-dock { display: none; align-items: center; justify-content: space-between; background: rgba(0, 82, 204, 0.12); border: 1px solid rgba(0, 82, 204, 0.35); padding: 10px 18px; border-radius: 12px; margin-bottom: 16px; animation: slideDown 0.2s ease; }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
        .bulk-info { font-size: 13px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; }
        .bulk-actions { display: flex; gap: 8px; }

        /* ── MODERN DATA TABLE ── */
        .table-responsive { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        table.acs-table { width: 100%; border-collapse: separate; border-spacing: 0; }
        table.acs-table th { background: var(--bg3); color: var(--muted); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border); white-space: nowrap; }
        table.acs-table th:first-child { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
        table.acs-table th:last-child { border-top-right-radius: 10px; border-bottom-right-radius: 10px; text-align: right; }
        table.acs-table td { padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--text); vertical-align: middle; }
        table.acs-table tr:last-child td { border-bottom: none; }
        table.acs-table tbody tr { transition: background 0.15s ease; }
        table.acs-table tbody tr:hover td { background: rgba(255,255,255,0.025); }

        /* Cell Styling & Badges */
        .dev-identity { display: flex; flex-direction: column; gap: 3px; }
        .dev-sn { font-weight: 700; color: var(--primary); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-family: monospace; font-size: 13px; }
        .dev-sn:hover { text-decoration: underline; color: #38bdf8; }
        .dev-meta { font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
        
        .vendor-badge { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.3px; background: rgba(255,255,255,0.08); color: var(--text); }
        .vendor-huawei { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
        .vendor-zte { background: rgba(0,82,204,0.15); color: #60a5fa; border: 1px solid rgba(0,82,204,0.3); }
        .vendor-fiberhome { background: rgba(16,185,129,0.15); color: #34d399; border: 1px solid rgba(16,185,129,0.3); }

        .cust-cell { display: flex; flex-direction: column; gap: 2px; }
        .cust-name { font-weight: 700; color: var(--text); font-size: 13px; display: flex; align-items: center; gap: 6px; }
        .cust-sub { font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 6px; font-family: monospace; }

        /* Optical RX Power Badges */
        .rx-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700; font-family: monospace; }
        .rx-good { background: rgba(16,185,129,0.12); color: #10b981; border: 1px solid rgba(16,185,129,0.25); }
        .rx-warning { background: rgba(245,158,11,0.12); color: #f59e0b; border: 1px solid rgba(245,158,11,0.25); }
        .rx-danger { background: rgba(239,68,68,0.14); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }
        .rx-muted { background: rgba(255,255,255,0.05); color: var(--muted); border: 1px solid var(--border); }

        /* Online / Offline Badges */
        .status-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
        .status-up { background: rgba(16,185,129,0.12); color: #10b981; border: 1px solid rgba(16,185,129,0.25); }
        .status-down { background: rgba(239,68,68,0.12); color: #ef4444; border: 1px solid rgba(239,68,68,0.25); }

        /* Action Buttons */
        .action-group { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
        .btn-act { width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border); background: var(--bg3); color: var(--muted); cursor: pointer; transition: all 0.18s ease; font-size: 14px; text-decoration: none; }
        .btn-act:hover { color: var(--text); border-color: rgba(255,255,255,0.25); transform: translateY(-1px); }
        .btn-act.btn-wifi:hover { background: rgba(0, 82, 204, 0.2); color: #38bdf8; border-color: var(--primary); }
        .btn-act.btn-refresh:hover { background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: #10b981; }
        .btn-act.btn-wan:hover { background: rgba(147, 51, 234, 0.18); color: #c084fc; border-color: #a855f7; }
        .btn-act.btn-del:hover { background: rgba(239, 68, 68, 0.18); color: #ef4444; border-color: #ef4444; }
        .btn-act:disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }

        /* ── MODALS & FORMS ── */
        .mo { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 2000; padding: 20px; }
        .mo.show { display: flex; animation: fadeIn 0.2s ease; }
        .mb { background: var(--bg2); border: 1px solid var(--border); border-radius: 20px; width: 100%; box-shadow: 0 16px 40px rgba(0,0,0,0.5); overflow: hidden; display: flex; flex-direction: column; max-height: 90vh; }
        .mh { padding: 18px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--bg3); }
        .mt { font-size: 16px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; margin: 0; }
        .mc { background: transparent; border: none; color: var(--muted); font-size: 20px; cursor: pointer; padding: 4px; border-radius: 6px; }
        .mc:hover { color: var(--text); }
        .mbody { padding: 22px; overflow-y: auto; }
        .mf { padding: 16px 22px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: flex-end; gap: 10px; background: var(--bg3); }

        /* Form Controls */
        .fg { margin-bottom: 16px; }
        .fl { display: block; font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.4px; }
        .fc { width: 100%; background: var(--bg3); border: 1px solid var(--border); border-radius: 9px; padding: 9px 13px; color: var(--text); font-size: 13px; font-family: inherit; transition: border-color 0.15s ease; }
        .fc:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px var(--pdim); }
        .fc[readonly] { opacity: 0.8; background: var(--bg); cursor: default; }
        .form-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        @media(max-width: 580px) { .form-row2 { grid-template-columns: 1fr; } }

        /* Interactive Port Binding Tags */
        .bind-tag { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg3); font-size: 12px; font-weight: 700; cursor: pointer; text-align: center; transition: all 0.18s ease; color: var(--muted); user-select: none; }
        .bind-tag:hover { border-color: var(--primary); color: var(--text); background: rgba(0, 82, 204, 0.08); }
        .bind-tag.active { background: var(--primary) !important; color: #fff !important; border-color: var(--primary) !important; box-shadow: 0 4px 12px rgba(0, 82, 204, 0.3); }

        /* Provisioning Progress Stepper */
        .step-progress-item { display: flex; justify-content: space-between; align-items: center; gap: 12px; border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; background: var(--bg3); }
        .spin { animation: spin 1s linear infinite; display: inline-block; }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        /* Empty State */
        .empty-state { padding: 48px 20px; text-align: center; }
        .empty-icon { width: 64px; height: 64px; border-radius: 16px; background: var(--bg3); display: inline-flex; align-items: center; justify-content: center; font-size: 28px; color: var(--muted); margin-bottom: 14px; }
        .empty-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 6px; }
        .empty-desc { font-size: 13px; color: var(--muted); max-width: 420px; margin: 0 auto 18px; }

        /* ── DEVSTUDIO SCRIPT & NBI CONSOLE STYLES ── */
        .console-container { display: flex; flex-direction: column; gap: 16px; }
        .console-toolbar { background: var(--bg3); border: 1px solid var(--border); border-radius: 14px; padding: 14px 18px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; justify-content: space-between; }
        .console-workspace { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; min-height: 520px; }
        @media(max-width: 992px) { .console-workspace { grid-template-columns: 1fr; } }
        
        .console-panel { background: #080d1a; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 8px 30px rgba(0,0,0,0.4); }
        .console-panel-header { background: #0d1527; padding: 10px 16px; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
        .console-panel-title { font-size: 12px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .console-editor-area { width: 100%; height: 420px; background: #070b14; color: #38bdf8; font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace; font-size: 13px; line-height: 1.6; padding: 16px; border: none; resize: vertical; outline: none; tab-size: 2; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .console-editor-area:focus { background: #090e1c; }
        
        .console-terminal-area { width: 100%; height: 420px; background: #050811; color: #cbd5e1; font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace; font-size: 12.5px; line-height: 1.6; padding: 16px; overflow-y: auto; overflow-x: auto; flex: 1; }
        .console-statusbar { background: #0a101f; border-top: 1px solid rgba(255,255,255,0.08); padding: 8px 16px; font-size: 11px; font-family: monospace; display: flex; align-items: center; justify-content: space-between; color: var(--muted); }
        
        .terminal-log-line { display: flex; gap: 8px; margin-bottom: 4px; word-break: break-all; }
        .terminal-log-time { color: #64748b; flex-shrink: 0; }
        .terminal-log-text { color: #e2e8f0; }
        .terminal-log-success { color: #34d399; font-weight: 600; }
        .terminal-log-error { color: #f87171; font-weight: 600; }
        .terminal-log-warn { color: #fbbf24; }
        .terminal-log-info { color: #38bdf8; }
        
        .console-subtab-btn { background: transparent; border: none; color: var(--muted); font-size: 11.5px; font-weight: 600; padding: 4px 10px; border-radius: 6px; cursor: pointer; transition: all 0.15s ease; display: inline-flex; align-items: center; gap: 6px; }
        .console-subtab-btn:hover { color: var(--text); background: rgba(255,255,255,0.05); }
        .console-subtab-btn.active { color: #fff; background: rgba(0,82,204,0.4); font-weight: 700; }
        
        .param-table-scroll { max-height: 410px; overflow-y: auto; }
        .param-row-item { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 7px 12px; border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 11.5px; }
        .param-row-item:hover { background: rgba(255,255,255,0.03); }
        .param-key { color: #94a3b8; font-family: monospace; word-break: break-all; }
        .param-val { color: #38bdf8; font-family: monospace; font-weight: 700; word-break: break-all; text-align: right; }
    </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'acs_pro', company }) %>
<div class="mw">
    <!-- Topbar Header -->
    <div class="topbar">
        <div class="tb-title">
            <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
            <i class="bi bi-hdd-network-fill text-primary"></i> GenieACS Monitoring Pro
        </div>
        <div class="tb-right">
            <span class="adm-badge" style="font-size:12px;opacity:0.8;"><%= company %></span>
            <span class="adm-badge"><i class="bi bi-person-circle"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? 'Kasir' : 'Administrator' %></span>
            <a href="/admin/logout" class="btn btn-g btn-sm" title="Keluar"><i class="bi bi-box-arrow-left"></i></a>
        </div>
    </div>

    <div class="page">
        <!-- UNIFIED SUB-NAVIGATION TABS (Konsistensi Antar Modul Fiber Optik) -->
        <div class="mtabs" style="margin-bottom:20px;">
          <a href="/admin/olts" class="mtab"><i class="bi bi-hdd-rack"></i> Manajemen OLT</a>
          <a href="/admin/onu-provision" class="mtab"><i class="bi bi-hdd-network-fill"></i> Provisioning ONU</a>
          <a href="/admin/acs" class="mtab active"><i class="bi bi-broadcast"></i> GenieACS Pro</a>
          <a href="/admin/onu-stickers" class="mtab"><i class="bi bi-printer"></i> Stiker Modem ONU</a>
        </div>

        <!-- Page Header & Action Bar -->
        <div class="acs-header">
            <div class="acs-title-group">
                <h1 class="acs-title"><i class="bi bi-hdd-network"></i> GenieACS Enterprise Console</h1>
                <div class="acs-subtitle">
                    <span class="live-dot"></span>
                    <span>TR-069 Auto Configuration Server</span>
                    <span>&bull;</span>
                    <span>Aktif: <strong style="color:var(--text);"><%= (acsServers.find(s => String(s.id) === String(selectedAcsId)) || {}).name || 'Semua ACS Server' %></strong></span>
                </div>
            </div>
            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                <a href="/panduan-tr069-fiberhome.html" target="_blank" class="btn btn-g btn-sm" style="text-decoration:none;" title="Panduan Setup TR-069 Fiberhome D2 & F3">
                    <i class="bi bi-book"></i> Panduan TR-069
                </a>
                <button class="btn btn-g btn-sm" onclick="openAddServerModal()">
                    <i class="bi bi-plus-circle"></i> Tambah Server
                </button>
                <button class="btn btn-p btn-sm" id="btnSyncAll" onclick="syncAllACS()">
                    <i class="bi bi-arrow-repeat"></i> <span id="syncBtnText">Sinkronkan Semua ACS</span>
                </button>
            </div>
        </div>

        <%
            const totalDev = devices.length;
            const onlineDev = devices.filter(d => d.isOnline).length;
            const offlineDev = totalDev - onlineDev;
            const criticalDev = devices.filter(d => {
                const rx = parseFloat(d.rx_power);
                return !isNaN(rx) && rx < -27;
            }).length;
            const onlinePercent = totalDev > 0 ? Math.round((onlineDev / totalDev) * 100) : 0;
        %>

        <!-- KPI Telemetry Grid (4 Executive Cards with Click-to-Filter) -->
        <div class="kpi-grid">
            <div class="kpi-card c-primary active-filter" id="kpiCardAll" onclick="filterDevicesByStatus('all', this)" title="Klik untuk menampilkan semua perangkat">
                <div class="kpi-header">
                    <span class="kpi-label">Total Perangkat</span>
                    <div class="kpi-icon"><i class="bi bi-router"></i></div>
                </div>
                <div class="kpi-body">
                    <span class="kpi-val"><%= totalDev %></span>
                    <span class="kpi-badge" style="background:rgba(0,82,204,0.15);color:#38bdf8;">Unit</span>
                </div>
                <div class="kpi-footer">
                    <span>Terdaftar di ACS Server</span>
                    <span style="font-weight:700;"><i class="bi bi-chevron-right"></i></span>
                </div>
            </div>

            <div class="kpi-card c-success" id="kpiCardOnline" onclick="filterDevicesByStatus('online', this)" title="Klik untuk memfilter perangkat online">
                <div class="kpi-header">
                    <span class="kpi-label">Perangkat Online</span>
                    <div class="kpi-icon"><i class="bi bi-wifi"></i></div>
                </div>
                <div class="kpi-body">
                    <span class="kpi-val"><%= onlineDev %></span>
                    <span class="kpi-badge" style="background:rgba(16,185,129,0.15);color:#10b981;"><%= onlinePercent %>% Rasio</span>
                </div>
                <div class="kpi-footer">
                    <span>Tersambung TR-069 & Sesi Aktif</span>
                    <span style="font-weight:700;"><i class="bi bi-chevron-right"></i></span>
                </div>
            </div>

            <div class="kpi-card c-danger" id="kpiCardOffline" onclick="filterDevicesByStatus('offline', this)" title="Klik untuk memfilter perangkat offline">
                <div class="kpi-header">
                    <span class="kpi-label">Perangkat Offline</span>
                    <div class="kpi-icon"><i class="bi bi-exclamation-octagon"></i></div>
                </div>
                <div class="kpi-body">
                    <span class="kpi-val"><%= offlineDev %></span>
                    <span class="kpi-badge" style="background:rgba(239,68,68,0.15);color:#ef4444;"><%= totalDev > 0 ? (100 - onlinePercent) : 0 %>%</span>
                </div>
                <div class="kpi-footer">
                    <span>Mati listrik / Kabel FO Putus</span>
                    <span style="font-weight:700;"><i class="bi bi-chevron-right"></i></span>
                </div>
            </div>

            <div class="kpi-card c-warning" id="kpiCardCritical" onclick="filterDevicesByStatus('critical', this)" title="Klik untuk memfilter redaman kritis (< -27 dBm)">
                <div class="kpi-header">
                    <span class="kpi-label">Redaman Kritis</span>
                    <div class="kpi-icon"><i class="bi bi-broadcast-pin"></i></div>
                </div>
                <div class="kpi-body">
                    <span class="kpi-val"><%= criticalDev %></span>
                    <span class="kpi-badge" style="background:rgba(245,158,11,0.15);color:#f59e0b;">&lt; -27 dBm</span>
                </div>
                <div class="kpi-footer">
                    <span>Rentan degradasi / Disconnect</span>
                    <span style="font-weight:700;"><i class="bi bi-chevron-right"></i></span>
                </div>
            </div>
        </div>

        <!-- Segmented Tab Navigation -->
        <div class="segmented-tabs">
            <button class="seg-tab-btn active" id="tabBtnDevices" onclick="switchAcsTab('devices', this)">
                <i class="bi bi-hdd-network"></i> Perangkat ONU / ONT
                <span class="seg-tab-count" id="badgeDevCount"><%= devices.length %></span>
            </button>
            <button class="seg-tab-btn" id="tabBtnServers" onclick="switchAcsTab('servers', this)">
                <i class="bi bi-server"></i> Kelola Server ACS
                <span class="seg-tab-count"><%= acsServers.length %></span>
            </button>
            <button class="seg-tab-btn" id="tabBtnConsole" onclick="switchAcsTab('console', this)">
                <i class="bi bi-terminal-fill text-warning"></i> DevStudio Console
                <span class="badge" style="background:rgba(245,158,11,0.18); color:#f59e0b; font-size:10px; padding:2px 7px; border-radius:999px;">PRO</span>
            </button>
        </div>

        <!-- Main ACS Card Wrapper -->
        <div class="acs-box">
            <!-- TAB 1: PERANGKAT (ONU/ONT) -->
            <div id="tab-devices" class="tab-pane active">
                <!-- Search & Filters Toolbar -->
                <div class="filter-toolbar">
                    <div class="filter-left">
                        <!-- Server Search Form -->
                        <form action="/admin/acs/search" method="GET" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; flex:1;">
                            <div class="search-box-unified">
                                <i class="bi bi-search"></i>
                                <input class="fc" id="serverSearchInput" name="q" value="<%= searchQuery || '' %>" placeholder="Cari SN, Pelanggan, PPPoE User, IP..." autocomplete="off">
                                <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                                    <a href="/admin/acs<%= selectedAcsId ? '?acs=' + encodeURIComponent(selectedAcsId) : '' %>" class="search-clear-btn" style="display:block;" title="Reset Pencarian"><i class="bi bi-x-circle-fill"></i></a>
                                <% } %>
                            </div>
                            
                            <select class="fc" id="acsFilter" name="acs" style="width:190px; height:38px;" onchange="this.form.submit()">
                                <option value="all">Semua ACS Server</option>
                                <% acsServers.forEach(s => { %>
                                    <option value="<%= s.id %>" <%= String(selectedAcsId) === String(s.id) ? 'selected' : '' %>><%= s.name %></option>
                                <% }); %>
                            </select>

                            <button class="btn btn-g btn-sm" type="submit" style="height:38px; padding:0 14px;">
                                <i class="bi bi-search"></i> Cari
                            </button>
                        </form>

                        <!-- Instant Status Filter Pills -->
                        <div class="status-pills">
                            <button type="button" class="status-pill-btn active" data-filter="all" onclick="filterDevicesByStatus('all', this)">
                                Semua (<%= totalDev %>)
                            </button>
                            <button type="button" class="status-pill-btn" data-filter="online" onclick="filterDevicesByStatus('online', this)">
                                <span class="live-dot" style="width:6px; height:6px;"></span> Online (<%= onlineDev %>)
                            </button>
                            <button type="button" class="status-pill-btn" data-filter="offline" onclick="filterDevicesByStatus('offline', this)">
                                <i class="bi bi-circle-fill text-danger" style="font-size:7px;"></i> Offline (<%= offlineDev %>)
                            </button>
                            <button type="button" class="status-pill-btn" data-filter="critical" onclick="filterDevicesByStatus('critical', this)">
                                <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size:10px;"></i> Kritis (<%= criticalDev %>)
                            </button>
                        </div>
                    </div>

                    <div class="filter-right">
                        <!-- Quick Instant Live Client Filter -->
                        <div style="position:relative; width:180px;">
                            <input type="text" id="instantFilterInput" class="fc" style="height:34px; font-size:12px; padding-left:28px;" placeholder="Filter instan..." onkeyup="instantFilterTable(this.value)">
                            <i class="bi bi-funnel" style="position:absolute; left:9px; top:50%; transform:translateY(-50%); color:var(--muted); font-size:11px;"></i>
                        </div>
                    </div>
                </div>

                <!-- Bulk Actions Floating Dock -->
                <div id="bulkActionsPanel" class="bulk-dock">
                    <div class="bulk-info">
                        <i class="bi bi-check2-circle text-primary" style="font-size:18px;"></i>
                        <span><strong id="selectedCount" style="color:var(--text); font-size:14px;">0</strong> perangkat dipilih</span>
                    </div>
                    <div class="bulk-actions">
                        <button class="btn btn-g btn-sm" onclick="bulkSummon()" style="background:var(--bg3); border-color:rgba(255,255,255,0.15);">
                            <i class="bi bi-arrow-repeat text-primary"></i> Summon Terpilih
                        </button>
                        <button class="btn btn-d btn-sm" onclick="bulkDelete()">
                            <i class="bi bi-trash3"></i> Hapus Terpilih
                        </button>
                    </div>
                </div>

                <!-- Devices Data Table -->
                <div class="table-responsive">
                    <table class="acs-table" id="devicesTable">
                        <thead>
                            <tr>
                                <th style="width:36px; text-align:center;">
                                    <input type="checkbox" id="selectAllDevices" onchange="toggleSelectAll(this)" style="cursor:pointer; width:16px; height:16px;">
                                </th>
                                <th>Perangkat & SN</th>
                                <th>Pelanggan & PPPoE</th>
                                <th>Wi-Fi & Klien</th>
                                <th>Kualitas Optik</th>
                                <th>Status & Uptime</th>
                                <th style="text-align:right;">Aksi Cepat</th>
                            </tr>
                        </thead>
                        <tbody id="devicesTableBody">
                            <% if (devices.length === 0) { %>
                                <tr id="noDevicesRow">
                                    <td colspan="7">
                                        <div class="empty-state">
                                            <div class="empty-icon"><i class="bi bi-hdd-network"></i></div>
                                            <div class="empty-title">Tidak Ada Perangkat Ditemukan</div>
                                            <div class="empty-desc">
                                                <%= searchQuery ? `Tidak ada perangkat yang cocok dengan kueri "${searchQuery}". Silakan periksa kembali nomor SN atau nama pelanggan.` : 'Belum ada data perangkat yang tersinkronisasi dari GenieACS server yang dipilih.' %>
                                            </div>
                                            <div>
                                                <% if (searchQuery) { %>
                                                    <a href="/admin/acs<%= selectedAcsId ? '?acs=' + encodeURIComponent(selectedAcsId) : '' %>" class="btn btn-g btn-sm me-2"><i class="bi bi-x-circle"></i> Reset Filter</a>
                                                <% } %>
                                                <button class="btn btn-p btn-sm" onclick="syncAllACS()"><i class="bi bi-arrow-repeat"></i> Sinkronkan Sekarang</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% devices.forEach(d => {
                                    const mfg = (d.manufacturer || '').toLowerCase();
                                    let vendorClass = 'vendor-badge';
                                    if (mfg.includes('huawei')) vendorClass += ' vendor-huawei';
                                    else if (mfg.includes('zte')) vendorClass += ' vendor-zte';
                                    else if (mfg.includes('fiberhome')) vendorClass += ' vendor-fiberhome';

                                    const rxNum = parseFloat(d.rx_power);
                                    const hasRx = !isNaN(rxNum);
                                    let rxBadgeClass = 'rx-badge rx-muted';
                                    let rxLabel = hasRx ? `${d.rx_power} dBm` : '-';
                                    let rxIcon = 'bi-activity';
                                    let isCriticalRx = false;

                                    if (hasRx) {
                                        if (rxNum >= -22.0) {
                                            rxBadgeClass = 'rx-badge rx-good';
                                            rxIcon = 'bi-reception-4';
                                        } else if (rxNum >= -26.9) {
                                            rxBadgeClass = 'rx-badge rx-warning';
                                            rxIcon = 'bi-reception-3';
                                        } else {
                                            rxBadgeClass = 'rx-badge rx-danger';
                                            rxIcon = 'bi-exclamation-triangle-fill';
                                            isCriticalRx = true;
                                        }
                                    }
                                %>
                                <tr class="device-row" 
                                    data-online="<%= d.isOnline ? '1' : '0' %>" 
                                    data-critical="<%= isCriticalRx ? '1' : '0' %>"
                                    data-sn="<%= (d.sn || '').toLowerCase() %>"
                                    data-customer="<%= (d.customer_name || '').toLowerCase() %>"
                                    data-pppoe="<%= (d.pppoe_user || '').toLowerCase() %>"
                                    data-ip="<%= (d.ip || '').toLowerCase() %>"
                                    data-ssid="<%= (d.ssid || '').toLowerCase() %>">
                                    <td style="text-align:center;">
                                        <input type="checkbox" class="device-checkbox" data-id="<%= d.id %>" data-acs="<%= d.acs_server_id || selectedAcsId %>" onchange="updateBulkPanel()" style="cursor:pointer; width:16px; height:16px;">
                                    </td>
                                    <td>
                                        <div class="dev-identity">
                                            <a href="/admin/acs/device/<%= encodeURIComponent(d.id) %>?acsId=<%= d.acs_server_id || selectedAcsId %>" class="dev-sn" title="Buka Detail Telemetri Perangkat">
                                                <i class="bi bi-router text-muted"></i>
                                                <span><%= d.sn || d.id %></span>
                                            </a>
                                            <div class="dev-meta">
                                                <span class="<%= vendorClass %>"><%= d.manufacturer && d.manufacturer !== '-' ? d.manufacturer : 'ONU' %></span>
                                                <span><%= d.model && d.model !== '-' ? d.model : '' %></span>
                                                <% if (d.acs_server_name) { %>
                                                    <span style="opacity:0.6;">&bull; <%= d.acs_server_name %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="cust-cell">
                                            <div class="cust-name">
                                                <% if (d.customer_name && d.customer_name !== '-') { %>
                                                    <i class="bi bi-person-circle text-primary" style="font-size:12px;"></i>
                                                    <span><%= d.customer_name %></span>
                                                <% } else { %>
                                                    <span style="color:var(--muted); font-style:italic; font-size:12px;">Belum Terhubung Tagihan</span>
                                                <% } %>
                                            </div>
                                            <div class="cust-sub">
                                                <% if (d.pppoe_user && d.pppoe_user !== '-') { %>
                                                    <span title="PPPoE Username" style="color:#60a5fa;"><i class="bi bi-key-fill"></i> <%= d.pppoe_user %></span>
                                                <% } %>
                                                <% if (d.ip && d.ip !== '-') { %>
                                                    <span title="IP Address" style="opacity:0.8;"><%= d.ip %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="display:flex; flex-direction:column; gap:3px;">
                                            <div style="font-size:12px; font-weight:600; color:var(--text); display:flex; align-items:center; gap:5px;">
                                                <i class="bi bi-wifi text-primary"></i>
                                                <span title="SSID Wi-Fi"><%= (d.ssid && d.ssid !== '-') ? d.ssid : 'Default SSID' %></span>
                                            </div>
                                            <div>
                                                <span class="badge <%= (d.client_count && d.client_count > 0) ? 'bs' : 'bm' %>" style="font-size:10px; padding:2px 7px; font-weight:700;" title="Jumlah Klien Aktif di Wi-Fi">
                                                    <i class="bi bi-people-fill me-1"></i><%= (d.client_count !== null && d.client_count !== undefined) ? (d.client_count + ' Klien') : '0 Klien' %>
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="<%= rxBadgeClass %>" title="Optical Received Power">
                                            <i class="bi <%= rxIcon %>"></i> <%= rxLabel %>
                                        </span>
                                    </td>
                                    <td>
                                        <div style="display:flex; flex-direction:column; gap:3px;">
                                            <div>
                                                <span class="status-pill <%= d.isOnline ? 'status-up' : 'status-down' %>">
                                                    <span class="<%= d.isOnline ? 'live-dot' : '' %>" style="width:6px; height:6px; background:<%= d.isOnline ? '#10b981' : '#ef4444' %>;"></span>
                                                    <%= d.isOnline ? 'Online' : 'Offline' %>
                                                </span>
                                            </div>
                                            <div style="font-size:11px; color:var(--muted); font-family:monospace;" class="live-uptime-ticker" data-seconds="<%= d.uptime_seconds || 0 %>" data-online="<%= d.isOnline ? '1' : '0' %>">
                                                <i class="bi bi-clock-history"></i> <span class="uptime-clock-text"><%= d.uptime || '-' %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="action-group">
                                            <button class="btn-act btn-wifi" onclick="openAcsWifiModal('<%= d.id %>', '<%= d.sn %>', '<%= d.ssid || "" %>', '<%= d.customer_name || "" %>', '<%= d.acs_server_id || selectedAcsId %>')" title="Ganti Nama / Sandi Wi-Fi 2.4G & 5G (TR-069)">
                                                <i class="bi bi-wifi"></i>
                                            </button>
                                            <button class="btn-act btn-refresh" onclick="refreshDevice('<%= d.id %>')" title="Summon / Refresh Data Perangkat">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                            <button class="btn-act btn-wan" onclick="openAddWanModal('<%= d.id %>', '<%= d.acs_server_id || selectedAcsId %>', '<%= d.sn %>', '<%= d.manufacturer || "" %>', '<%= d.model || "" %>')" title="Provisioning WAN All-in-One (VLAN, PPPoE & Binding)">
                                                <i class="bi bi-hdd-network"></i>
                                            </button>
                                            <button class="btn-act btn-del" onclick="deleteDevice('<%= d.id %>', '<%= d.acs_server_id || selectedAcsId %>')" title="Hapus Perangkat dari ACS">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 2: ACS SERVERS -->
            <div id="tab-servers" class="tab-pane">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
                    <div>
                        <h3 style="font-size:16px; font-weight:800; color:var(--text); margin:0;">Daftar GenieACS Server</h3>
                        <p style="font-size:12px; color:var(--muted); margin:4px 0 0;">Hubungkan satu atau beberapa server GenieACS untuk manajemen terpusat multi-region.</p>
                    </div>
                    <button class="btn btn-p btn-sm" onclick="openAddServerModal()"><i class="bi bi-plus-lg"></i> Tambah ACS Server</button>
                </div>

                <div class="table-responsive">
                    <table class="acs-table">
                        <thead>
                            <tr>
                                <th>Nama Server</th>
                                <th>API URL</th>
                                <th>Lokasi / Catatan</th>
                                <th>Total Perangkat</th>
                                <th style="text-align:right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% acsServers.forEach(s => { %>
                            <tr>
                                <td>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <div style="width:32px; height:32px; border-radius:8px; background:rgba(0,82,204,0.15); color:#38bdf8; display:flex; align-items:center; justify-content:center; font-size:14px;">
                                            <i class="bi bi-server"></i>
                                        </div>
                                        <div>
                                            <strong style="color:var(--text); font-size:13px;"><%= s.name %></strong>
                                            <% if (String(s.id) === 'legacy' || String(s.id) === 'builtin') { %>
                                                <span class="badge" style="background:rgba(16,185,129,0.12); color:#10b981; font-size:10px; margin-left:6px;">Default Core</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td><code style="font-size:12px; background:var(--bg3); padding:3px 8px; border-radius:6px;"><%= s.url %></code></td>
                                <td><%= s.location || '-' %></td>
                                <td>
                                    <span class="badge" style="background:rgba(255,255,255,0.08); font-size:11px; font-weight:700;">
                                        <i class="bi bi-hdd-network me-1"></i><%= s.device_count || 0 %> Perangkat
                                    </span>
                                </td>
                                <td>
                                    <div class="action-group">
                                        <% if (String(s.id) !== 'legacy') { %>
                                            <button class="btn-act" type="button" onclick="openEditServerModal(this)" title="Edit Konfigurasi Server"
                                                data-id="<%= s.id %>"
                                                data-name="<%= s.name %>"
                                                data-url="<%= s.url %>"
                                                data-username="<%= s.username || '' %>"
                                                data-location="<%= s.location || '' %>">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn-act btn-del" type="button" onclick="deleteServer('<%= s.id %>')" title="Hapus Server">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        <% } else { %>
                                            <button class="btn-act" type="button" onclick="openEditLegacyAcsModal()" title="Edit Default ACS">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn-act btn-del" type="button" disabled title="Default ACS tidak dapat dihapus">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 3: DEVSTUDIO SCRIPT & NBI CONSOLE -->
            <div id="tab-console" class="tab-pane">
                <div class="console-container">
                    <!-- Top Control Toolbar -->
                    <div class="console-toolbar">
                        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; flex:1;">
                            <!-- Target Device Selector -->
                            <div style="min-width:280px; flex:1;">
                                <label style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; display:block; margin-bottom:4px;">
                                    <i class="bi bi-router text-primary me-1"></i> Target Device (ONU/ONT)
                                </label>
                                <select id="consoleDeviceSelect" class="fc" style="height:38px; font-family:monospace; font-size:12px;" onchange="onConsoleDeviceChange()">
                                    <% if (devices && devices.length > 0) { %>
                                        <% devices.forEach((d, idx) => { %>
                                            <% const devId = d.id || d._id || d.sn; %>
                                            <% const devSn = d.sn || d.serial_number || devId; %>
                                            <% const devMfg = d.manufacturer || d.vendor || '-'; %>
                                            <% const devModel = d.model || d.product_class || '-'; %>
                                            <% const devCust = d.customer_name || d.pppoe_user || d.pppoe_username || 'No Customer'; %>
                                            <option value="<%= devId %>" 
                                                    <%= idx === 0 ? 'selected' : '' %>
                                                    data-sn="<%= devSn %>" 
                                                    data-model="<%= devModel %>" 
                                                    data-vendor="<%= devMfg %>" 
                                                    data-online="<%= d.isOnline ? 'true' : 'false' %>"
                                                    data-acsid="<%= d.acs_server_id || d._acs_server_id || 'builtin' %>">
                                                <%= (d.isOnline ? '🟢' : '⚪') %> <%= devMfg.toUpperCase() %> <%= devSn %> &bull; <%= devCust %>
                                            </option>
                                        <% }); %>
                                    <% } else { %>
                                        <option value="">-- Tidak ada perangkat terdaftar --</option>
                                    <% } %>
                                </select>
                            </div>

                            <!-- Target ACS Server -->
                            <div style="min-width:180px;">
                                <label style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; display:block; margin-bottom:4px;">
                                    <i class="bi bi-server text-info me-1"></i> ACS Server
                                </label>
                                <select id="consoleAcsSelect" class="fc" style="height:38px; font-size:12px;">
                                    <option value="builtin">Built-in ACS (Local)</option>
                                    <% acsServers.forEach(s => { %>
                                        <% if (String(s.id) !== 'builtin') { %>
                                            <option value="<%= s.id %>"><%= s.name %></option>
                                        <% } %>
                                    <% }); %>
                                </select>
                            </div>

                            <!-- Preset Template Library -->
                            <div style="min-width:280px; flex:1;">
                                <label style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; display:block; margin-bottom:4px;">
                                    <i class="bi bi-magic text-warning me-1"></i> Pustaka Template Skrip
                                </label>
                                <select id="consoleTemplateSelect" class="fc" style="height:38px; font-size:12px;" onchange="onConsoleTemplateSelect(this.value)">
                                    <option value="">-- Pilih Template Skrip Siap Pakai --</option>
                                    <optgroup label="📡 Telemetri & Status Optik">
                                        <option value="optics_all" selected>Kualitas Optik & Redaman (RX/TX Power, Temp)</option>
                                        <option value="dev_info">Informasi Hardware & Firmware DeviceInfo</option>
                                    </optgroup>
                                    <optgroup label="🌐 WAN & Jaringan Internet">
                                        <option value="wan_status">Status & Konfigurasi WAN PPPoE (IP, Gateway, DNS)</option>
                                        <option value="wan_refresh">Refresh WAN Connection Device (refreshObject)</option>
                                    </optgroup>
                                    <optgroup label="📶 Wi-Fi & Klien Terhubung">
                                        <option value="wifi_dualband">Audit Wi-Fi Dual-Band (SSID 2.4G & 5G + Sandi)</option>
                                        <option value="wifi_client_list">Pindai Klien Wi-Fi Aktif (WIFI Client List Real-Time)</option>
                                        <option value="lan_hosts">Pindai Seluruh Host DHCP / LAN (Hosts / ARP)</option>
                                        <option value="set_wifi_ssid">Ubah Nama Wi-Fi (SetParameterValues SSID)</option>
                                        <option value="set_wifi_pass">Ubah Kata Sandi Wi-Fi (SetParameterValues Pass)</option>
                                    </optgroup>
                                    <optgroup label="⚙️ Manajemen CPE">
                                        <option value="refresh_all">Refresh Seluruh Root Parameter (Full Refresh)</option>
                                        <option value="reboot">Reboot / Nyalakan Ulang Modem</option>
                                        <option value="factory_reset">Factory Reset (Kembalikan ke Setelan Pabrik)</option>
                                    </optgroup>
                                </select>
                            </div>
                        </div>

                        <!-- Device Quick Info Badge -->
                        <div id="consoleDeviceBadge" style="display:flex; align-items:center; gap:8px; padding:7px 14px; background:rgba(255,255,255,0.04); border-radius:10px; border:1px solid var(--border); font-size:12px;">
                            <span id="consoleBadgeDot" class="live-dot" style="background:#10b981;"></span>
                            <span id="consoleBadgeText" class="font-monospace text-primary fw-bold">-</span>
                        </div>
                    </div>

                    <!-- Split-Screen Workspace (Editor vs Terminal) -->
                    <div class="console-workspace">
                        <!-- LEFT PANEL: SCRIPT / TASK JSON EDITOR -->
                        <div class="console-panel">
                            <div class="console-panel-header">
                                <div class="console-panel-title">
                                    <i class="bi bi-code-slash text-info"></i> Task / Script Editor
                                    <span class="badge" style="background:rgba(56,189,248,0.15); color:#38bdf8; font-size:10px;">TR-069 Payload</span>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <button type="button" class="btn btn-g btn-sm" onclick="formatConsoleJson()" title="Format Indentasi JSON">
                                        <i class="bi bi-braces"></i> Format
                                    </button>
                                    <button type="button" class="btn btn-g btn-sm" onclick="clearConsoleEditor()" title="Bersihkan Editor">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                    <button type="button" class="btn btn-g btn-sm" onclick="copyConsoleEditor()" title="Salin Payload">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </div>

                            <textarea id="consoleEditor" class="console-editor-area" spellcheck="false" placeholder="// Masukkan payload TR-069 task atau pilih dari pustaka template di atas...">{
  "name": "getParameterValues",
  "parameterNames": [
    "InternetGatewayDevice.WANDevice.1.X_GponInterfaceConfig.RXPower",
    "InternetGatewayDevice.WANDevice.1.X_GponInterfaceConfig.TXPower",
    "InternetGatewayDevice.WANDevice.1.X_GponInterfaceConfig.TransceiverTemperature",
    "InternetGatewayDevice.WANDevice.1.X_GponInterfaceConfig.SupplyVoltage",
    "Device.Optical.Interface.1.OpticalStatus"
  ]
}</textarea>

                            <div style="background:#0d1527; padding:12px 16px; border-top:1px solid rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:12px; color:var(--text); margin:0;">
                                    <input type="checkbox" id="chkConnectionRequest" checked style="accent-color:var(--primary); width:16px; height:16px;">
                                    <span>Kirim Connection Request (Eksekusi Sekarang)</span>
                                </label>
                                <button type="button" class="btn btn-p" id="btnExecuteConsole" onclick="executeConsoleScript()" style="font-weight:700; padding:8px 20px; box-shadow:0 4px 14px rgba(0,82,204,0.4);">
                                    <i class="bi bi-play-fill fs-5"></i> <span>JALANKAN KE MODEM</span>
                                </button>
                            </div>
                        </div>

                        <!-- RIGHT PANEL: LIVE OUTPUT TERMINAL -->
                        <div class="console-panel">
                            <div class="console-panel-header">
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <button type="button" class="console-subtab-btn active" id="btnSubtabLog" onclick="switchConsoleSubtab('log')">
                                        <i class="bi bi-terminal"></i> Console Log
                                    </button>
                                    <button type="button" class="console-subtab-btn" id="btnSubtabTree" onclick="switchConsoleSubtab('tree')">
                                        <i class="bi bi-diagram-3"></i> Parameter Tree
                                    </button>
                                    <button type="button" class="console-subtab-btn" id="btnSubtabRaw" onclick="switchConsoleSubtab('raw')">
                                        <i class="bi bi-filetype-json"></i> Raw Response
                                    </button>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <button type="button" class="btn btn-g btn-sm" onclick="clearConsoleTerminal()" title="Bersihkan Terminal">
                                        <i class="bi bi-eraser"></i> Bersihkan
                                    </button>
                                    <button type="button" class="btn btn-g btn-sm" onclick="copyConsoleOutput()" title="Salin Output">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Screen 1: Terminal Log Screen -->
                            <div id="screenConsoleLog" class="console-terminal-area">
                                <div class="terminal-log-line">
                                    <span class="terminal-log-time">[System]</span>
                                    <span class="terminal-log-info">GenieACS DevStudio Console siap digunakan.</span>
                                </div>
                                <div class="terminal-log-line">
                                    <span class="terminal-log-time">[Ready]</span>
                                    <span class="terminal-log-text">Pilih target perangkat dan template di atas, lalu klik <strong>JALANKAN KE MODEM</strong> untuk menguji skrip langsung.</span>
                                </div>
                            </div>

                            <!-- Screen 2: Interactive Parameter Tree Screen -->
                            <div id="screenConsoleTree" class="console-terminal-area" style="display:none; padding:0;">
                                <div style="padding:10px 14px; background:#0a101f; border-bottom:1px solid rgba(255,255,255,0.08); display:flex; align-items:center; gap:8px;">
                                    <i class="bi bi-search text-muted"></i>
                                    <input type="text" id="filterTreeInput" placeholder="Cari nama parameter atau nilai..." onkeyup="filterParameterTree()" style="background:transparent; border:none; outline:none; color:#fff; font-size:12px; width:100%;">
                                </div>
                                <div class="param-table-scroll" id="paramTreeContainer">
                                    <div style="padding:30px; text-align:center; color:var(--muted); font-size:12px;">
                                        Belum ada data parameter. Jalankan perintah `getParameterValues` untuk memuat parameter live.
                                    </div>
                                </div>
                            </div>

                            <!-- Screen 3: Raw JSON Screen -->
                            <div id="screenConsoleRaw" class="console-terminal-area" style="display:none;">
                                <pre id="rawJsonResponse" style="margin:0; font-family:inherit; color:#94a3b8; font-size:12px;">// Hasil raw response JSON akan tampil di sini...</pre>
                            </div>

                            <!-- Bottom Status Bar -->
                            <div class="console-statusbar">
                                <div style="display:flex; align-items:center; gap:12px;">
                                    <span id="consoleStatusPill" style="display:inline-flex; align-items:center; gap:6px; color:#10b981;">
                                        <span style="width:7px; height:7px; border-radius:50%; background:#10b981; display:inline-block;"></span>
                                        <span id="consoleStatusText">Ready</span>
                                    </span>
                                    <span>&bull;</span>
                                    <span>Latensi: <strong id="consoleLatencyText" style="color:var(--text);">-</strong></span>
                                </div>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span id="consoleHttpStatusBadge" class="badge" style="background:rgba(255,255,255,0.08); color:var(--muted); font-size:10px;">HTTP -</span>
                                    <span id="consoleTaskIdBadge" class="badge" style="background:rgba(56,189,248,0.1); color:#38bdf8; font-size:10px;">Task: -</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer style="margin-top:24px; padding:18px; text-align:center; color:var(--muted); font-size:12px; border-top:1px solid var(--border);">
            &copy; <%= new Date().getFullYear() %> <%= (typeof settings !== 'undefined' ? settings.company_header : 'ALIJAYA NET') %> &bull; GenieACS Pro Provisioning Engine v2.6
        </footer>
    </div>
  <%- include('partials/footer') %>
</div>

<!-- ========================================== -->
<!-- MODAL: ADD WAN ALL-IN-ONE PROVISIONING      -->
<!-- ========================================== -->
<div class="mo" id="addWanModal">
  <div class="mb" style="max-width:680px">
    <div class="mh">
      <h3 class="mt"><i class="bi bi-hdd-network text-primary"></i> Provisioning All-in-One WAN</h3>
      <button class="mc" onclick="closeModal('addWanModal')">&times;</button>
    </div>
    <div class="mbody" style="max-height: 72vh; overflow-y: auto;">
      <form id="addWanForm" onsubmit="submitAddWanForm(event)">
        <input type="hidden" id="wanDeviceId" value="">
        <input type="hidden" id="wanAcsId" value="">
        
        <!-- Target Device Info Strip -->
        <div style="background:var(--bg3); padding:14px 18px; border-radius:12px; margin-bottom:18px; border:1px solid var(--border);">
            <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; font-size:12px;">
                <div><span style="color:var(--muted);">SN Perangkat:</span> <strong id="lblWanSn" class="text-primary font-monospace">-</strong></div>
                <div><span style="color:var(--muted);">Vendor:</span> <strong id="lblWanVendor" style="text-transform:capitalize;">-</strong></div>
                <div><span style="color:var(--muted);">Tipe Model:</span> <strong id="lblWanModel">-</strong></div>
            </div>
        </div>

        <!-- WAN Mode & VLAN ID -->
        <div class="form-row2" style="margin-bottom:14px;">
            <div class="fg" style="margin:0;">
              <label class="fl">Mode Koneksi WAN</label>
              <select id="wanMode" class="fc" onchange="toggleWanModeFields()" style="height:40px;">
                <option value="pppoe">PPPoE (Router Mode)</option>
                <option value="bridge">Bridge Mode</option>
              </select>
            </div>
            <div class="fg" style="margin:0;">
              <label class="fl">VLAN ID (1 - 4094)</label>
              <input type="number" id="wanVlanId" class="fc" required min="1" max="4094" placeholder="Contoh: 100" style="height:40px;">
            </div>
        </div>

        <div style="margin-bottom:18px;">
            <label style="display:flex; align-items:center; gap:10px; font-size:12px; color:var(--text); font-weight:600; cursor:pointer;">
              <input type="checkbox" id="wanDhcp" checked style="width:17px; height:17px; cursor:pointer;">
              <i class="bi bi-hdd-rack text-primary"></i> Aktifkan DHCP Server LAN (Rekomendasi: Nonaktifkan jika Bridge)
            </label>
        </div>

        <!-- Pilih Pelanggan (Auto-fill) -->
        <div style="background:rgba(56, 189, 248, 0.08); border:1px solid rgba(56, 189, 248, 0.25); padding:14px; border-radius:12px; margin-bottom:16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <label class="fl" style="margin:0; font-weight:700; color:#38bdf8; display:flex; align-items:center; gap:6px;">
                    <i class="bi bi-person-check-fill"></i> Pilih Pelanggan (Auto-fill Akun & Wi-Fi)
                </label>
                <span style="font-size:11px; color:var(--muted);">Tersambung ke Database Billing</span>
            </div>
            <select id="wanCustomerSelect" class="fc" onchange="onWanCustomerSelected(this.value)" style="height:40px; font-weight:600;">
                <option value="">-- Pilih Pelanggan Langsung (Otomatis Isi Data) --</option>
                <% if (typeof customers !== 'undefined' && Array.isArray(customers)) { %>
                    <% customers.forEach(c => { %>
                        <option value="<%= c.id %>" 
                            data-code="<%= c.customer_code || '' %>"
                            data-name="<%= c.name || '' %>"
                            data-pppoe="<%= c.pppoe_username || '' %>"
                            data-pppoepass="<%= c.pppoe_password || '' %>"
                            data-ssid="<%= c.wifi_ssid || '' %>"
                            data-wifipass="<%= c.wifi_password || '' %>"
                            data-phone="<%= c.phone || '' %>"
                        >
                            <%= c.customer_code ? '[' + c.customer_code + '] ' : '' %><%= c.name %> (<%= c.pppoe_username || 'Belum ada PPPoE' %>)
                        </option>
                    <% }); %>
                <% } %>
            </select>
        </div>

        <!-- PPPoE Credentials Block -->
        <div id="pppoeFields" style="background:rgba(0,82,204,0.05); border:1px solid rgba(0,82,204,0.18); padding:16px; border-radius:14px; margin-bottom:16px;">
            <h4 style="margin:0 0 12px 0; font-size:13px; color:var(--text); font-weight:700; display:flex; align-items:center; gap:6px;">
                <i class="bi bi-key-fill text-primary"></i> Kredensial PPPoE
            </h4>
            <div class="form-row2" style="margin-bottom:12px;">
                <div class="fg" style="margin:0;">
                  <label class="fl">Username PPPoE (Wajib @bionfiber.net)</label>
                  <input type="text" id="wanPppoeUser" class="fc" placeholder="user@bionfiber.net" onblur="enforceWanBionDomain(this)">
                </div>
                <div class="fg" style="margin:0;">
                  <label class="fl">Password PPPoE</label>
                  <input type="text" id="wanPppoePass" class="fc" placeholder="Password rahasia">
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1.2fr 0.8fr; gap:14px; align-items:center; padding-top:12px; border-top:1px dashed var(--border);">
                <div>
                    <label style="display:flex; align-items:center; gap:8px; font-size:12px; color:var(--text); font-weight:600; cursor:pointer;">
                      <input type="checkbox" id="wanAutoMikrotik" checked style="width:17px; height:17px; cursor:pointer;" onchange="toggleMikrotikProfileField()">
                      Auto-create PPPoE Secret di MikroTik
                    </label>
                </div>
                <div class="fg" style="margin:0;" id="pppoeProfileContainer">
                  <label class="fl">Profile MikroTik</label>
                  <select id="wanPppoeProfile" class="fc" style="height:36px;">
                    <% pppoeProfiles.forEach(p => { %>
                        <option value="<%= p.name %>" <%= p.name === 'default' ? 'selected' : '' %>><%= p.name %></option>
                    <% }); %>
                  </select>
                </div>
            </div>
        </div>

        <!-- Unified Wi-Fi Block -->
        <div style="border:1px solid var(--border); border-radius:14px; margin-bottom:18px; overflow:hidden;">
            <div style="background:var(--bg3); padding:12px 16px; display:flex; justify-content:space-between; align-items:center;">
                <label style="display:flex; align-items:center; gap:10px; font-weight:700; font-size:13px; cursor:pointer; margin:0; width:100%;">
                    <input type="checkbox" id="wanConfigureWifi" onchange="toggleWifiFields()" style="width:17px; height:17px; cursor:pointer;">
                    <i class="bi bi-wifi text-primary"></i> Konfigurasikan Wi-Fi Sekaligus (TR-069)
                </label>
            </div>
            <div id="wifiFields" style="display:none; padding:18px; background:var(--bg2);">
                <div id="wifiLoading" style="text-align:center; padding:12px; color:var(--muted); font-size:12px;">
                    <i class="bi bi-arrow-repeat spin" style="font-size:18px;"></i> Mengunduh parameter SSID saat ini...
                </div>
                <div id="wifiBandsContainer" style="display:grid; gap:14px;">
                    <!-- 2.4GHz Band -->
                    <div id="band24Fields" style="display:block;">
                        <h5 style="margin:0 0 10px 0; font-size:12px; color:var(--text); font-weight:700;"><i class="bi bi-broadcast"></i> Wi-Fi 2.4GHz</h5>
                        <div class="form-row2">
                            <div class="fg" style="margin:0;">
                              <label class="fl">SSID (Nama Wi-Fi)</label>
                              <input type="text" id="wifiSsid24" class="fc" placeholder="Mengunduh...">
                            </div>
                            <div class="fg" style="margin:0;">
                              <label class="fl">Sandi Wi-Fi (WPA2)</label>
                              <input type="password" id="wifiPass24" class="fc" placeholder="Kosongkan jika tidak diubah">
                            </div>
                        </div>
                    </div>
                    <!-- 5GHz Band -->
                    <div id="band5Fields" style="display:none; border-top:1px dashed var(--border); padding-top:14px;">
                        <h5 style="margin:0 0 10px 0; font-size:12px; color:var(--text); font-weight:700;"><i class="bi bi-lightning-charge-fill text-warning"></i> Wi-Fi 5GHz (Dual Band)</h5>
                        <div class="form-row2">
                            <div class="fg" style="margin:0;">
                              <label class="fl">SSID 5G</label>
                              <input type="text" id="wifiSsid5" class="fc" placeholder="Mengunduh...">
                            </div>
                            <div class="fg" style="margin:0;">
                              <label class="fl">Sandi 5G (WPA2)</label>
                              <input type="password" id="wifiPass5" class="fc" placeholder="Kosongkan jika tidak diubah">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LAN / WLAN Port Binding -->
        <div style="background:var(--bg3); border:1px solid var(--border); padding:16px; border-radius:14px; margin-bottom:12px;">
            <h4 style="margin:0 0 10px 0; font-size:13px; color:var(--text); font-weight:700; display:flex; align-items:center; gap:6px;">
                <i class="bi bi-diagram-3-fill text-primary"></i> LAN &amp; WLAN Port Binding
            </h4>
            
            <label class="fl" style="margin-bottom:6px;">Binding LAN Ports:</label>
            <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:8px; margin-bottom:14px;">
                <label class="bind-tag active" id="lblLan1">
                    <input type="checkbox" name="lanPorts" value="LAN1" checked style="display:none;" onchange="syncTagClass(this, 'lblLan1')"> LAN 1
                </label>
                <label class="bind-tag active" id="lblLan2">
                    <input type="checkbox" name="lanPorts" value="LAN2" checked style="display:none;" onchange="syncTagClass(this, 'lblLan2')"> LAN 2
                </label>
                <label class="bind-tag active" id="lblLan3">
                    <input type="checkbox" name="lanPorts" value="LAN3" checked style="display:none;" onchange="syncTagClass(this, 'lblLan3')"> LAN 3
                </label>
                <label class="bind-tag active" id="lblLan4">
                    <input type="checkbox" name="lanPorts" value="LAN4" checked style="display:none;" onchange="syncTagClass(this, 'lblLan4')"> LAN 4
                </label>
            </div>

            <label class="fl" style="margin-bottom:6px;">Binding WLAN (SSID):</label>
            <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:8px;">
                <label class="bind-tag active" id="lblWlan1">
                    <input type="checkbox" name="wlanSsids" value="SSID1" checked style="display:none;" onchange="syncTagClass(this, 'lblWlan1')"> SSID 1
                </label>
                <label class="bind-tag" id="lblWlan2">
                    <input type="checkbox" name="wlanSsids" value="SSID2" style="display:none;" onchange="syncTagClass(this, 'lblWlan2')"> SSID 2
                </label>
                <label class="bind-tag" id="lblWlan3">
                    <input type="checkbox" name="wlanSsids" value="SSID3" style="display:none;" onchange="syncTagClass(this, 'lblWlan3')"> SSID 3
                </label>
                <label class="bind-tag" id="lblWlan4">
                    <input type="checkbox" name="wlanSsids" value="SSID4" style="display:none;" onchange="syncTagClass(this, 'lblWlan4')"> SSID 4
                </label>
            </div>
        </div>

        <!-- Live Provisioning Progress Card -->
        <div id="addWanProgressBox" style="display:none; margin-top:16px; border:1px solid rgba(0,82,204,0.3); border-radius:14px; padding:16px; background:rgba(0,82,204,0.06);">
            <div style="display:flex; justify-content:space-between; gap:12px; align-items:center; margin-bottom:8px;">
                <strong style="font-size:13px; color:var(--text);"><i class="bi bi-terminal-split me-1 text-primary"></i> Status Provisioning TR-069</strong>
                <span id="addWanProgressBadge" class="text-primary" style="font-size:12px; font-weight:700;">Menunggu</span>
            </div>
            <div id="addWanProgressSummary" style="font-size:12px; color:var(--muted); margin-bottom:10px;">Workflow sedang diproses ke modem...</div>
            <div id="addWanProgressList" style="display:grid; gap:8px;"></div>
        </div>

      </form>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g btn-sm" onclick="closeModal('addWanModal')">Batal</button>
      <button type="submit" form="addWanForm" class="btn btn-p btn-sm" id="btn-save-add-wan">
        <span class="btn-text"><i class="bi bi-send-check"></i> Jalankan Provisioning</span>
        <span class="btn-loader" style="display:none"><i class="bi bi-arrow-repeat spin"></i> Memproses...</span>
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL: KELOLA ACS SERVER                   -->
<!-- ========================================== -->
<div class="mo" id="serverModal">
  <div class="mb" style="max-width:540px">
    <div class="mh">
      <h3 class="mt" id="acsServerModalTitle"><i class="bi bi-server text-primary"></i> Tambah ACS Server</h3>
      <button class="mc" onclick="closeModal('serverModal')">&times;</button>
    </div>
    <div class="mbody">
      <form id="acsServerForm" onsubmit="saveServer(event)">
        <input type="hidden" id="sId" value="">
        <div class="fg">
          <label class="fl">Nama Server</label>
          <input type="text" id="sName" class="fc" required placeholder="Contoh: Server Core Jakarta">
        </div>
        <div class="fg">
          <label class="fl">API URL (Port 7557)</label>
          <input type="text" id="sUrl" class="fc" required placeholder="http://192.168.1.10:7557">
        </div>
        <div class="form-row2">
          <div class="fg" style="margin:0">
            <label class="fl">Username</label>
            <input type="text" id="sUser" class="fc" placeholder="Opsional">
            <label style="display:flex;align-items:center;gap:6px;margin-top:6px;font-size:11px;color:var(--muted);cursor:pointer;">
              <input type="checkbox" id="sClearUser">
              Kosongkan username
            </label>
          </div>
          <div class="fg" style="margin:0">
            <label class="fl">Password</label>
            <input type="password" id="sPass" class="fc" placeholder="Opsional">
            <label style="display:flex;align-items:center;gap:6px;margin-top:6px;font-size:11px;color:var(--muted);cursor:pointer;">
              <input type="checkbox" id="sClearPass">
              Kosongkan password
            </label>
          </div>
        </div>
        <div class="fg" style="margin-top:14px;">
          <label class="fl">Lokasi / Catatan</label>
          <input type="text" id="sLoc" class="fc" placeholder="Contoh: Data Center NOC / OLT Timur">
        </div>
      </form>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-g btn-sm" onclick="closeModal('serverModal')">Batal</button>
      <button type="submit" form="acsServerForm" class="btn btn-p btn-sm" id="btn-save-acs-server">
        <span class="btn-text"><i class="bi bi-save"></i> Simpan Server</span>
        <span class="btn-loader" style="display:none"><i class="bi bi-arrow-repeat spin"></i> Menyimpan...</span>
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL: KELOLA WI-FI PERANGKAT (TR-069)     -->
<!-- ========================================== -->
<div class="mo" id="acsWifiModal">
  <div class="mb" style="max-width:540px; border-radius:16px;">
    <div class="mh" style="padding:16px 20px; border-bottom:1px solid var(--border);">
      <h3 class="mt" style="font-size:16px; font-weight:700;"><i class="bi bi-wifi text-primary me-2"></i>Kelola Wi-Fi Perangkat (TR-069)</h3>
      <button type="button" class="mc" onclick="closeModal('acsWifiModal')">&times;</button>
    </div>
    <form id="acsWifiForm" onsubmit="submitAcsWifi(event)">
      <div class="mbody" style="padding:20px;">
        <input type="hidden" id="acs_wifi_device_id" value="">
        <input type="hidden" id="acs_wifi_acs_id" value="">
        
        <div style="font-size:12px; padding:10px 14px; background:rgba(0,82,204,0.08); border:1px solid rgba(0,82,204,0.25); border-radius:10px; color:var(--text); margin-bottom:16px;">
          <i class="bi bi-info-circle-fill me-1 text-primary"></i> Perubahan konfigurasi Wi-Fi akan dikirimkan ke antrean TR-069 dan langsung diterapkan oleh modem.
        </div>

        <div class="fg" style="margin-bottom:14px;">
          <label class="fl" style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase;">Perangkat / Pelanggan</label>
          <input type="text" class="fc" id="acs_wifi_device_label" readonly style="font-weight:700; background:var(--bg3);">
        </div>

        <div id="acs_wifi_loading" style="display:none; text-align:center; padding:10px; font-size:12px; color:var(--muted); margin-bottom:10px;">
          <i class="bi bi-arrow-repeat spin me-1 text-primary"></i> Membaca konfigurasi SSID modem...
        </div>

        <!-- 2.4 GHz Section -->
        <div style="background:var(--bg3); border:1px solid var(--border); border-radius:10px; padding:14px; margin-bottom:14px;">
          <div style="font-size:12px; font-weight:700; color:#10b981; margin-bottom:10px; display:flex; align-items:center; gap:6px;">
            <i class="bi bi-broadcast"></i> Wi-Fi 2.4 GHz (Default)
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <div>
              <label class="fl" style="font-size:11px;">Nama SSID (2.4G)</label>
              <input type="text" class="fc" id="acs_wifi_new_ssid" placeholder="Contoh: BIONFIBER">
            </div>
            <div>
              <label class="fl" style="font-size:11px;">Password (2.4G)</label>
              <div style="position:relative">
                <input type="password" class="fc" id="acs_wifi_new_password" placeholder="Kosongkan jika tak diubah" minlength="8" style="padding-right:36px" oninput="onAdminPass24Input(this)">
                <button type="button" onclick="togglePassVisibility('acs_wifi_new_password', this)" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);border:none;background:transparent;color:var(--muted);cursor:pointer;padding:4px">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- 5 GHz Section (Dual-Band) -->
        <div id="acs_wifi_5g_container" style="background:var(--bg3); border:1px solid var(--border); border-radius:10px; padding:14px; margin-bottom:14px;">
          <div style="font-size:12px; font-weight:700; color:#38bdf8; margin-bottom:10px; display:flex; align-items:center; justify-content:space-between;">
            <span style="display:flex; align-items:center; gap:6px;"><i class="bi bi-lightning-charge-fill"></i> Wi-Fi 5 GHz (Dual Band)</span>
            <label style="font-size:11px; font-weight:normal; color:var(--muted); cursor:pointer; display:flex; align-items:center; gap:4px;">
              <input type="checkbox" id="acs_wifi_sync_pass" onchange="syncWifi5gPassword(this)"> Samakan Password
            </label>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <div>
              <label class="fl" style="font-size:11px;">Nama SSID (5G)</label>
              <input type="text" class="fc" id="acs_wifi_new_ssid_5g" placeholder="Contoh: BIONFIBER-5G">
            </div>
            <div>
              <label class="fl" style="font-size:11px;">Password (5G)</label>
              <div style="position:relative">
                <input type="password" class="fc" id="acs_wifi_new_password_5g" placeholder="Kosongkan jika tak diubah" minlength="8" style="padding-right:36px">
                <button type="button" onclick="togglePassVisibility('acs_wifi_new_password_5g', this)" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);border:none;background:transparent;color:var(--muted);cursor:pointer;padding:4px">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Status & Log TR-069 Section -->
        <div style="background:rgba(255,255,255,0.03); border:1px solid var(--border); border-radius:10px; padding:12px; margin-bottom:14px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
            <span style="font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase;">
              <i class="bi bi-cpu me-1"></i> Status Parameter & Antrean TR-069
            </span>
            <button type="button" class="btn btn-sm" id="btn_detect_wlan" onclick="triggerWlanDiscovery()" style="font-size:11px; padding:2px 8px; background:rgba(56,189,248,0.15); color:#38bdf8; border:1px solid rgba(56,189,248,0.3); border-radius:6px; cursor:pointer;">
              <i class="bi bi-search"></i> Deteksi Parameter Modem
            </button>
          </div>
          <div id="acs_wifi_action_alert" style="display:none; font-size:11.5px; padding:8px 12px; border-radius:8px; margin-bottom:8px;"></div>
          <div id="acs_wifi_diag_status" style="font-size:11px; color:var(--muted);">
            Memuat status parameter modem...
          </div>
          <div id="acs_wifi_task_logs" style="margin-top:8px; max-height:130px; overflow-y:auto; font-family:monospace; font-size:10.5px; display:none; background:var(--bg); padding:8px 10px; border-radius:8px; border:1px solid var(--border);">
          </div>
        </div>

        <div class="fg" style="margin-bottom:6px;">
          <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer">
            <input type="checkbox" id="acs_wifi_notify_wa" checked style="width:16px; height:16px;">
            <span>Kirim notifikasi otomatis ke WhatsApp pelanggan</span>
          </label>
        </div>
      </div>
      <div class="mf" style="padding:14px 20px; border-top:1px solid var(--border); display:flex; justify-content:space-between;">
        <button type="button" class="btn btn-g btn-sm" onclick="closeModal('acsWifiModal')">Batal</button>
        <button type="submit" class="btn btn-p btn-sm" id="btn_save_acs_wifi">
          <i class="bi bi-save"></i> Terapkan Pengaturan
        </button>
      </div>
    </form>
  </div>
</div>

<script>
// ── TAB SWITCHING ──
function switchAcsTab(tabName, btn) {
    document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.seg-tab-btn').forEach(b => b.classList.remove('active'));
    const target = document.getElementById('tab-' + tabName);
    if (target) target.classList.add('active');
    if (btn) btn.classList.add('active');
}

// ── MODAL HELPERS ──
function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
}

function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
    if (id === 'addWanModal') stopAddWanProgressPolling();
}

document.querySelectorAll('.mo').forEach(m => m.addEventListener('click', e => {
    if (e.target === m) closeModal(m.id);
}));

// ── CLIENT-SIDE FAST STATUS FILTERING ──
let currentActiveFilter = 'all';

function filterDevicesByStatus(status, el) {
    currentActiveFilter = status;
    
    // Update KPI card active style
    document.querySelectorAll('.kpi-card').forEach(c => c.classList.remove('active-filter'));
    if (status === 'all') document.getElementById('kpiCardAll')?.classList.add('active-filter');
    else if (status === 'online') document.getElementById('kpiCardOnline')?.classList.add('active-filter');
    else if (status === 'offline') document.getElementById('kpiCardOffline')?.classList.add('active-filter');
    else if (status === 'critical') document.getElementById('kpiCardCritical')?.classList.add('active-filter');

    // Update status pills active style
    document.querySelectorAll('.status-pill-btn').forEach(b => {
        if (b.dataset.filter === status) b.classList.add('active');
        else b.classList.remove('active');
    });

    applyCombinedFilters();
}

function instantFilterTable(query) {
    applyCombinedFilters(query);
}

function applyCombinedFilters(queryOverride) {
    const q = (typeof queryOverride === 'string' ? queryOverride : (document.getElementById('instantFilterInput')?.value || '')).trim().toLowerCase();
    const rows = document.querySelectorAll('#devicesTableBody tr.device-row');
    let visibleCount = 0;

    rows.forEach(row => {
        const isOnline = row.dataset.online === '1';
        const isCritical = row.dataset.critical === '1';

        // Check status filter
        let matchStatus = true;
        if (currentActiveFilter === 'online') matchStatus = isOnline;
        else if (currentActiveFilter === 'offline') matchStatus = !isOnline;
        else if (currentActiveFilter === 'critical') matchStatus = isCritical;

        // Check text query filter
        let matchText = true;
        if (q) {
            const sn = row.dataset.sn || '';
            const customer = row.dataset.customer || '';
            const pppoe = row.dataset.pppoe || '';
            const ip = row.dataset.ip || '';
            const ssid = row.dataset.ssid || '';
            matchText = sn.includes(q) || customer.includes(q) || pppoe.includes(q) || ip.includes(q) || ssid.includes(q);
        }

        if (matchStatus && matchText) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });

    // Handle empty row display
    let noRow = document.getElementById('dynamicNoDevicesRow');
    if (visibleCount === 0 && rows.length > 0) {
        if (!noRow) {
            noRow = document.createElement('tr');
            noRow.id = 'dynamicNoDevicesRow';
            noRow.innerHTML = `
                <td colspan="7">
                    <div class="empty-state" style="padding:28px 16px;">
                        <div class="empty-icon"><i class="bi bi-funnel"></i></div>
                        <div class="empty-title">Tidak Ada Hasil Cocok</div>
                        <div class="empty-desc">Tidak ada perangkat yang sesuai dengan filter atau kata kunci saat ini.</div>
                        <button class="btn btn-g btn-sm" onclick="resetClientFilters()"><i class="bi bi-arrow-counterclockwise"></i> Reset Filter</button>
                    </div>
                </td>
            `;
            document.getElementById('devicesTableBody').appendChild(noRow);
        }
    } else if (noRow) {
        noRow.remove();
    }
}

function resetClientFilters() {
    const input = document.getElementById('instantFilterInput');
    if (input) input.value = '';
    filterDevicesByStatus('all', document.querySelector('.status-pill-btn[data-filter="all"]'));
}

// ── WI-FI MODAL ACTIONS (DUAL BAND 2.4G & 5G) ──
function syncWifi5gPassword(chk) {
    const p24 = document.getElementById('acs_wifi_new_password');
    const p5 = document.getElementById('acs_wifi_new_password_5g');
    if (!p24 || !p5) return;
    if (chk && chk.checked) {
        if (!p24.value) {
            p24.focus();
            p24.placeholder = 'Ketik sandi baru 2.4G di sini...';
        }
        p5.value = p24.value;
        p5.disabled = true;
        p5.placeholder = '(Sama dengan sandi 2.4G)';
    } else {
        p5.disabled = false;
        p5.placeholder = 'Kosongkan jika tak diubah';
    }
}

function onAdminPass24Input(input) {
    const chk = document.getElementById('acs_wifi_sync_pass');
    const p5 = document.getElementById('acs_wifi_new_password_5g');
    if (chk && chk.checked && p5) {
        p5.value = input.value;
    }
}

async function openAcsWifiModal(id, sn, currentSsid, custName, acsId) {
    document.getElementById('acs_wifi_device_id').value = id;
    document.getElementById('acs_wifi_acs_id').value = acsId || 'builtin';
    document.getElementById('acs_wifi_device_label').value = (custName && custName !== '-' ? (custName + ' — ') : '') + (sn || id);
    
    const initial24 = (currentSsid && currentSsid !== '-' ? currentSsid : '');
    document.getElementById('acs_wifi_new_ssid').value = initial24;
    document.getElementById('acs_wifi_new_password').value = '';
    
    // Sensible default for 5G so it is never empty by accident
    let default5g = '';
    if (initial24) {
        if (/5g/i.test(initial24)) default5g = initial24;
        else if (/2\.?4g/i.test(initial24)) default5g = initial24.replace(/2\.?4g/i, '5G');
        else default5g = initial24 + ' 5G';
    }
    document.getElementById('acs_wifi_new_ssid_5g').value = default5g;
    document.getElementById('acs_wifi_new_password_5g').value = '';
    
    const syncChk = document.getElementById('acs_wifi_sync_pass');
    if (syncChk) syncChk.checked = false;
    
    const loading = document.getElementById('acs_wifi_loading');
    const container5g = document.getElementById('acs_wifi_5g_container');
    if (container5g) container5g.style.display = 'block';
    if (loading) loading.style.display = 'block';
    
    openModal('acsWifiModal');

    // Load diagnostics status & tasks
    loadWifiDiagnostics(id);

    // Async fetch WLAN actual SSID names from modem
    try {
        const res = await fetch(`/admin/acs/api/wifi-settings/${encodeURIComponent(id)}?acsId=${encodeURIComponent(acsId || 'builtin')}`);
        const d = await res.json();
        if (d && d.success && Array.isArray(d.bands) && d.bands.length > 0) {
            d.bands.forEach(b => {
                if (b.index === '1') {
                    if (b.ssid) document.getElementById('acs_wifi_new_ssid').value = b.ssid;
                } else if (b.index === '5' || b.index === '2' || b.index === 'landev2_1') {
                    if (b.ssid) document.getElementById('acs_wifi_new_ssid_5g').value = b.ssid;
                }
            });
        }
    } catch (e) {
        console.error('Gagal mengambil detail WiFi perangkat:', e);
    } finally {
        if (loading) loading.style.display = 'none';
    }
}

let wlanDiscoveryTimer = null;

async function loadWifiDiagnostics(deviceId) {
    const statusEl = document.getElementById('acs_wifi_diag_status');
    const logsEl = document.getElementById('acs_wifi_task_logs');
    if (!statusEl) return;

    try {
        const res = await fetch(`/admin/acs/api/device-diagnostics/${encodeURIComponent(deviceId)}`);
        const data = await res.json();
        if (data && data.success) {
            let statusHtml = '';
            if (data.detected5gPath) {
                const shortPath = data.detected5gPath.split('.').slice(-2).join('.');
                statusHtml = `<span style="color:#10b981; font-weight:700;"><i class="bi bi-check-circle-fill"></i> 2.4G & 5G Terdeteksi</span> &bull; <span style="color:var(--muted); font-size:11px;">Path 5G: <code>${shortPath}</code></span>`;
            } else {
                statusHtml = `<span style="color:#f59e0b; font-weight:700;"><i class="bi bi-exclamation-triangle-fill"></i> Jalur 5GHz Belum Terpetakan</span> &bull; <span style="font-size:11px; color:var(--muted);">Klik "Deteksi Parameter Modem" di samping untuk sinkronisasi otomatis.</span>`;
            }

            if (data.ip_address) {
                statusHtml += ` <span class="badge" style="font-size:10px; background:var(--bg); color:var(--muted); margin-left:6px;">IP: ${data.ip_address}</span>`;
            }
            statusEl.innerHTML = statusHtml;

            // Render last tasks
            if (Array.isArray(data.recentTasks) && data.recentTasks.length > 0) {
                logsEl.style.display = 'block';
                logsEl.innerHTML = data.recentTasks.slice(0, 6).map(t => {
                    let badge = '';
                    if (t.status === 'completed') badge = '<span style="color:#10b981; font-weight:bold;">[SUKSES]</span>';
                    else if (t.status === 'failed') {
                        const fault = t.result?.faultCode ? `Fault ${t.result.faultCode}` : (t.result?.error || 'Gagal');
                        badge = `<span style="color:#ef4444; font-weight:bold;">[GAGAL: ${fault}]</span>`;
                    } else if (t.status === 'in_progress') badge = '<span style="color:#38bdf8; font-weight:bold;">[PROSES]</span>';
                    else badge = '<span style="color:#f59e0b; font-weight:bold;">[ANTRE]</span>';

                    let detail = t.name;
                    if (t.payload) {
                        if (t.payload.parameterValues && Array.isArray(t.payload.parameterValues)) {
                            detail += ' ' + t.payload.parameterValues.map(p => `${p[0]?.split('.').pop()}=${p[1]}`).join(', ');
                        } else if (t.payload.parameterNames && Array.isArray(t.payload.parameterNames)) {
                            detail += ' ' + t.payload.parameterNames.map(p => p?.split('.').pop()).join(', ');
                        } else if (t.payload.objectName) {
                            detail += ' ' + t.payload.objectName;
                        }
                    }
                    let time = '';
                    if (t.updated_at) {
                        try {
                            const rawIso = String(t.updated_at).replace(' ', 'T');
                            const dt = new Date(rawIso.includes('Z') ? rawIso : rawIso + 'Z');
                            if (!isNaN(dt.getTime())) {
                                const day = String(dt.getDate()).padStart(2, '0');
                                const month = String(dt.getMonth() + 1).padStart(2, '0');
                                const hours = String(dt.getHours()).padStart(2, '0');
                                const mins = String(dt.getMinutes()).padStart(2, '0');
                                const secs = String(dt.getSeconds()).padStart(2, '0');
                                time = `<span style="color:#94a3b8; font-weight:600;">${day}/${month} ${hours}:${mins}:${secs}</span>`;
                            } else {
                                time = rawIso.slice(5, 19).replace('T', ' ');
                            }
                        } catch (_) {
                            time = String(t.updated_at).slice(5, 19);
                        }
                    }
                    return `<div style="padding:3px 0; border-bottom:1px solid rgba(255,255,255,0.05);">${time} ${badge} ${detail}</div>`;
                }).join('');
            }
        }
    } catch (e) {
        console.warn('Gagal memuat diagnostik WiFi:', e.message);
    }
}

async function triggerWlanDiscovery() {
    const deviceId = document.getElementById('acs_wifi_device_id').value;
    const btn = document.getElementById('btn_detect_wlan');
    const statusEl = document.getElementById('acs_wifi_diag_status');
    if (!deviceId || !btn) return;

    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Mendeteksi...';
    if (statusEl) statusEl.innerHTML = '<span style="color:#38bdf8;"><i class="bi bi-arrow-repeat spin"></i> Mengirim perintah deteksi parameter ke modem via TR-069...</span>';

    try {
        const res = await fetch(`/admin/acs/api/discover-wlan/${encodeURIComponent(deviceId)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data && data.success) {
            // Poll diagnostics every 2s for 16s
            let attempts = 0;
            if (wlanDiscoveryTimer) clearInterval(wlanDiscoveryTimer);
            wlanDiscoveryTimer = setInterval(async () => {
                attempts++;
                await loadWifiDiagnostics(deviceId);
                try {
                    const r = await fetch(`/admin/acs/api/wifi-settings/${encodeURIComponent(deviceId)}?acsId=builtin`);
                    const d = await r.json();
                    if (d && d.success && Array.isArray(d.bands)) {
                        d.bands.forEach(b => {
                            if (b.index === '1' && b.ssid) document.getElementById('acs_wifi_new_ssid').value = b.ssid;
                            else if ((b.index === '5' || b.index === '2' || b.index === 'landev2_1') && b.ssid) {
                                document.getElementById('acs_wifi_new_ssid_5g').value = b.ssid;
                            }
                        });
                        if (d.detected5gPath) {
                            clearInterval(wlanDiscoveryTimer);
                            wlanDiscoveryTimer = null;
                            btn.disabled = false;
                            btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Berhasil';
                            setTimeout(() => { btn.innerHTML = '<i class="bi bi-search"></i> Deteksi Parameter Modem'; }, 3000);
                        }
                    }
                } catch (_) {}

                if (attempts >= 8) {
                    clearInterval(wlanDiscoveryTimer);
                    wlanDiscoveryTimer = null;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-search"></i> Deteksi Parameter Modem';
                }
            }, 2000);
        } else {
            alert('Gagal: ' + (data.message || 'Terjadi kesalahan'));
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search"></i> Deteksi Parameter Modem';
        }
    } catch (e) {
        alert('Error: ' + e.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-search"></i> Deteksi Parameter Modem';
    }
}

let wlanProgressPollingTimer = null;

async function submitAcsWifi(e) {
    e.preventDefault();
    const deviceId = document.getElementById('acs_wifi_device_id').value;
    const ssid24 = document.getElementById('acs_wifi_new_ssid').value.trim();
    const password24 = document.getElementById('acs_wifi_new_password').value.trim();
    const ssid5 = document.getElementById('acs_wifi_new_ssid_5g').value.trim();
    let password5 = document.getElementById('acs_wifi_new_password_5g').value.trim();
    const syncPass = document.getElementById('acs_wifi_sync_pass')?.checked;
    if (syncPass && password24) {
        password5 = password24;
    }
    const notifyWa = document.getElementById('acs_wifi_notify_wa').checked;
    const btn = document.getElementById('btn_save_acs_wifi');
    const alertBox = document.getElementById('acs_wifi_action_alert');

    if (!ssid24 && !password24 && !ssid5 && !password5) {
        return alert('Silakan masukkan nama SSID atau password baru.');
    }
    if (password24 && password24.length < 8) return alert('Password Wi-Fi 2.4G minimal 8 karakter.');
    if (password5 && password5.length < 8) return alert('Password Wi-Fi 5G minimal 8 karakter.');

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Mengirim ke Modem...';

    if (alertBox) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'rgba(56,189,248,0.12)';
        alertBox.style.border = '1px solid rgba(56,189,248,0.3)';
        alertBox.style.color = '#38bdf8';
        alertBox.innerHTML = '<i class="bi bi-arrow-repeat spin me-1"></i> Mengirim perintah Wi-Fi ke antrean TR-069...';
    }

    try {
        const res = await fetch('/admin/api/device/' + encodeURIComponent(deviceId) + '/wifi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                ssid24, 
                password24, 
                ssid5, 
                password5, 
                notifyWa 
            })
        });
        const data = await res.json();
        if (data.success) {
            if (alertBox) {
                alertBox.style.display = 'block';
                alertBox.style.background = 'rgba(16,185,129,0.12)';
                alertBox.style.border = '1px solid rgba(16,185,129,0.3)';
                alertBox.style.color = '#10b981';
                alertBox.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> <strong>Perintah Terkirim!</strong> Memantau proses eksekusi modem secara live di bawah...';
            }

            // Segera muat log diagnostik
            await loadWifiDiagnostics(deviceId);

            // Jalankan live polling setiap 2 detik selama 16 detik
            if (wlanProgressPollingTimer) clearInterval(wlanProgressPollingTimer);
            let pollCounter = 0;
            wlanProgressPollingTimer = setInterval(async () => {
                pollCounter++;
                await loadWifiDiagnostics(deviceId);
                if (pollCounter >= 8) {
                    clearInterval(wlanProgressPollingTimer);
                    wlanProgressPollingTimer = null;
                }
            }, 2000);
        } else {
            if (alertBox) {
                alertBox.style.display = 'block';
                alertBox.style.background = 'rgba(239,68,68,0.12)';
                alertBox.style.border = '1px solid rgba(239,68,68,0.3)';
                alertBox.style.color = '#ef4444';
                alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Gagal: ' + (data.error || data.message || 'Terjadi kesalahan');
            }
        }
    } catch (err) {
        if (alertBox) {
            alertBox.style.display = 'block';
            alertBox.style.background = 'rgba(239,68,68,0.12)';
            alertBox.style.border = '1px solid rgba(239,68,68,0.3)';
            alertBox.style.color = '#ef4444';
            alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Error: ' + err.message;
        }
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-save"></i> Terapkan Pengaturan';
    }
}

