<script>
// ── TAB SWITCHING ──
function switchAcsTab(tabName, btn) {
    document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.seg-tab-btn').forEach(b => b.classList.remove('active'));
    const target = document.getElementById('tab-' + tabName);
    if (target) target.classList.add('active');
    if (btn) btn.classList.add('active');
}

// ── MODAL HELPERS ──
function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
}

function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
    if (id === 'addWanModal') stopAddWanProgressPolling();
}

document.querySelectorAll('.mo').forEach(m => m.addEventListener('click', e => {
    if (e.target === m) closeModal(m.id);
}));

// ── CLIENT-SIDE FAST STATUS FILTERING ──
let currentActiveFilter = 'all';

function filterDevicesByStatus(status, el) {
    currentActiveFilter = status;
    
    // Update KPI card active style
    document.querySelectorAll('.kpi-card').forEach(c => c.classList.remove('active-filter'));
    if (status === 'all') document.getElementById('kpiCardAll')?.classList.add('active-filter');
    else if (status === 'online') document.getElementById('kpiCardOnline')?.classList.add('active-filter');
    else if (status === 'offline') document.getElementById('kpiCardOffline')?.classList.add('active-filter');
    else if (status === 'critical') document.getElementById('kpiCardCritical')?.classList.add('active-filter');

    // Update status pills active style
    document.querySelectorAll('.status-pill-btn').forEach(b => {
        if (b.dataset.filter === status) b.classList.add('active');
        else b.classList.remove('active');
    });

    applyCombinedFilters();
}

function instantFilterTable(query) {
    applyCombinedFilters(query);
}

function applyCombinedFilters(queryOverride) {
    const q = (typeof queryOverride === 'string' ? queryOverride : (document.getElementById('instantFilterInput')?.value || '')).trim().toLowerCase();
    const rows = document.querySelectorAll('#devicesTableBody tr.device-row');
    let visibleCount = 0;

    rows.forEach(row => {
        const isOnline = row.dataset.online === '1';
        const isCritical = row.dataset.critical === '1';

        // Check status filter
        let matchStatus = true;
        if (currentActiveFilter === 'online') matchStatus = isOnline;
        else if (currentActiveFilter === 'offline') matchStatus = !isOnline;
        else if (currentActiveFilter === 'critical') matchStatus = isCritical;

        // Check text query filter
        let matchText = true;
        if (q) {
            const sn = row.dataset.sn || '';
            const customer = row.dataset.customer || '';
            const pppoe = row.dataset.pppoe || '';
            const ip = row.dataset.ip || '';
            const ssid = row.dataset.ssid || '';
            matchText = sn.includes(q) || customer.includes(q) || pppoe.includes(q) || ip.includes(q) || ssid.includes(q);
        }

        if (matchStatus && matchText) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });

    // Handle empty row display
    let noRow = document.getElementById('dynamicNoDevicesRow');
    if (visibleCount === 0 && rows.length > 0) {
        if (!noRow) {
            noRow = document.createElement('tr');
            noRow.id = 'dynamicNoDevicesRow';
            noRow.innerHTML = `
                <td colspan="7">
                    <div class="empty-state" style="padding:28px 16px;">
                        <div class="empty-icon"><i class="bi bi-funnel"></i></div>
                        <div class="empty-title">Tidak Ada Hasil Cocok</div>
                        <div class="empty-desc">Tidak ada perangkat yang sesuai dengan filter atau kata kunci saat ini.</div>
                        <button class="btn btn-g btn-sm" onclick="resetClientFilters()"><i class="bi bi-arrow-counterclockwise"></i> Reset Filter</button>
                    </div>
                </td>
            `;
            document.getElementById('devicesTableBody').appendChild(noRow);
        }
    } else if (noRow) {
        noRow.remove();
    }
}

function resetClientFilters() {
    const input = document.getElementById('instantFilterInput');
    if (input) input.value = '';
    filterDevicesByStatus('all', document.querySelector('.status-pill-btn[data-filter="all"]'));
}

// ── WI-FI MODAL ACTIONS ──
function openAcsWifiModal(id, sn, currentSsid, custName) {
    document.getElementById('acs_wifi_device_id').value = id;
    document.getElementById('acs_wifi_device_label').value = (custName && custName !== '-' ? (custName + ' — ') : '') + (sn || id);
    document.getElementById('acs_wifi_new_ssid').value = (currentSsid && currentSsid !== '-' ? currentSsid : '');
    document.getElementById('acs_wifi_new_password').value = '';
    openModal('acsWifiModal');
}

async function submitAcsWifi(e) {
    e.preventDefault();
    const deviceId = document.getElementById('acs_wifi_device_id').value;
    const ssid = document.getElementById('acs_wifi_new_ssid').value.trim();
    const password = document.getElementById('acs_wifi_new_password').value.trim();
    const notifyWa = document.getElementById('acs_wifi_notify_wa').checked;
    const btn = document.getElementById('btn_save_acs_wifi');

    if (!ssid && !password) return alert('Silakan masukkan nama SSID atau password baru.');
    if (password && password.length < 8) return alert('Password Wi-Fi minimal 8 karakter.');

    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Menerapkan ke Modem...';

    try {
        const res = await fetch('/admin/api/device/' + encodeURIComponent(deviceId) + '/wifi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ssid, password, notifyWa })
        });
        const data = await res.json();
        if (data.success) {
            alert(data.message || 'Pengaturan Wi-Fi berhasil diperbarui via TR-069!');
            closeModal('acsWifiModal');
            location.reload();
        } else {
            alert('Gagal: ' + (data.error || 'Terjadi kesalahan'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-save"></i> Terapkan Pengaturan';
    }
}

function togglePassVisibility(inputId, btn) {
    const el = document.getElementById(inputId);
    if (!el) return;
    if (el.type === 'password') {
        el.type = 'text';
        btn.innerHTML = '<i class="bi bi-eye-slash"></i>';
    } else {
        el.type = 'password';
        btn.innerHTML = '<i class="bi bi-eye"></i>';
    }
}

// ── REFRESH & SINKRONISASI SINGLE DEVICE ──
async function refreshDevice(deviceId) {
    if(!confirm('Summon / Sinkronisasi ulang perangkat ' + deviceId + '?')) return;
    try {
        const res = await fetch('/admin/acs/api/refresh/' + encodeURIComponent(deviceId), {
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ acsId: '<%= selectedAcsId %>' })
        });
        const d = await res.json();
        alert(d.message);
        if (d.success) location.reload();
    } catch (err) {
        alert('Gagal me-refresh perangkat: ' + err.message);
    }
}

// ── SINKRONISASI SEMUA ACS SERVER ──
async function syncAllACS() {
    const btn = document.getElementById('btnSyncAll');
    const txt = document.getElementById('syncBtnText');
    if (btn) btn.disabled = true;
    if (txt) txt.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Menyinkronkan...';

    try {
        const res = await fetch('/admin/acs/api/sync/all', { method: 'POST' });
        const d = await res.json();
        alert(d.message || 'Proses sinkronisasi semua ACS server selesai');
        if (d.success) location.reload();
    } catch (err) {
        alert('Gagal menyinkronkan: ' + err.message);
    } finally {
        if (btn) btn.disabled = false;
        if (txt) txt.textContent = 'Sinkronkan Semua ACS';
    }
}

// ── BULK SELECTION ACTIONS ──
function toggleSelectAll(master) {
    const checkboxes = document.querySelectorAll('.device-checkbox');
    checkboxes.forEach(cb => {
        // Only select currently visible rows
        const row = cb.closest('tr');
        if (!row || row.style.display !== 'none') {
            cb.checked = master.checked;
        }
    });
    updateBulkPanel();
}

function updateBulkPanel() {
    const checkboxes = document.querySelectorAll('.device-checkbox:checked');
    const panel = document.getElementById('bulkActionsPanel');
    const countSpan = document.getElementById('selectedCount');
    
    if (checkboxes.length > 0) {
        panel.style.display = 'flex';
        countSpan.textContent = checkboxes.length;
    } else {
        panel.style.display = 'none';
        const master = document.getElementById('selectAllDevices');
        if (master) master.checked = false;
    }
}

function getSelectedDevices() {
    const checkboxes = document.querySelectorAll('.device-checkbox:checked');
    const devices = [];
    checkboxes.forEach(cb => {
        devices.push({
            id: cb.dataset.id,
            acsId: cb.dataset.acs
        });
    });
    return devices;
}

async function bulkSummon() {
    const devices = getSelectedDevices();
    if (devices.length === 0) return;
    if (!confirm(`Summon / Sinkronisasi ulang ${devices.length} perangkat terpilih?`)) return;
    
    try {
        const res = await fetch('/admin/acs/api/bulk/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ devices })
        });
        const d = await res.json();
        alert(d.message);
        if (d.success) location.reload();
    } catch (err) {
        alert('Gagal memproses bulk summon: ' + err.message);
    }
}

async function bulkDelete() {
    const devices = getSelectedDevices();
    if (devices.length === 0) return;
    if (!confirm(`HAPUS ${devices.length} perangkat terpilih dari database ACS?\nTindakan ini tidak dapat dibatalkan.`)) return;
    
    try {
        const res = await fetch('/admin/acs/api/bulk/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ devices })
        });
        const d = await res.json();
        alert(d.message);
        if (d.success) location.reload();
    } catch (err) {
        alert('Gagal memproses bulk delete: ' + err.message);
    }
}

async function deleteDevice(deviceId, acsId) {
    if (!confirm('Hapus perangkat ' + deviceId + ' dari database ACS?')) return;
    try {
        const res = await fetch('/admin/acs/api/device/' + encodeURIComponent(deviceId), {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ acsId })
        });
        const d = await res.json();
        alert(d.message);
        if (d.success) location.reload();
    } catch (err) {
        alert('Gagal menghapus perangkat: ' + err.message);
    }
}

// ── ACS SERVER MANAGEMENT MODAL ──
function openAddServerModal() {
    document.getElementById('acsServerModalTitle').innerHTML = '<i class="bi bi-server text-primary"></i> Tambah ACS Server';
    document.getElementById('sId').value = '';
    document.getElementById('sName').value = '';
    document.getElementById('sUrl').value = '';
    document.getElementById('sUser').value = '';
    document.getElementById('sPass').value = '';
    document.getElementById('sLoc').value = '';
    document.getElementById('sClearUser').checked = false;
    document.getElementById('sClearPass').checked = false;
    document.getElementById('sName').disabled = false;
    document.getElementById('sLoc').disabled = false;
    openModal('serverModal');
}

function openEditServerModal(btn) {
    document.getElementById('acsServerModalTitle').innerHTML = '<i class="bi bi-server text-primary"></i> Edit ACS Server';
    document.getElementById('sId').value = btn.dataset.id || '';
    document.getElementById('sName').value = btn.dataset.name || '';
    document.getElementById('sUrl').value = btn.dataset.url || '';
    document.getElementById('sUser').value = btn.dataset.username || '';
    document.getElementById('sPass').value = '';
    document.getElementById('sLoc').value = btn.dataset.location || '';
    document.getElementById('sClearUser').checked = false;
    document.getElementById('sClearPass').checked = false;
    document.getElementById('sName').disabled = false;
    document.getElementById('sLoc').disabled = false;
    openModal('serverModal');
}

function openEditLegacyAcsModal() {
    document.getElementById('acsServerModalTitle').innerHTML = '<i class="bi bi-server text-primary"></i> Edit Default Core ACS';
    document.getElementById('sId').value = 'legacy';
    document.getElementById('sName').value = 'Default ACS';
    document.getElementById('sUrl').value = '<%= (typeof settings !== "undefined" && settings.genieacs_url) ? String(settings.genieacs_url) : "" %>';
    document.getElementById('sUser').value = '<%= (typeof settings !== "undefined" && settings.genieacs_username) ? String(settings.genieacs_username) : "" %>';
    document.getElementById('sPass').value = '';
    document.getElementById('sLoc').value = '';
    document.getElementById('sClearUser').checked = false;
    document.getElementById('sClearPass').checked = false;
    document.getElementById('sName').disabled = true;
    document.getElementById('sLoc').disabled = true;
    openModal('serverModal');
}

async function saveServer(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-save-acs-server');
    const txt = btn.querySelector('.btn-text');
    const ldr = btn.querySelector('.btn-loader');
    btn.disabled = true;
    txt.style.display = 'none';
    ldr.style.display = 'inline-block';

    const id = document.getElementById('sId').value.trim();
    const body = {
        name: document.getElementById('sName').value,
        url: document.getElementById('sUrl').value,
        username: document.getElementById('sUser').value,
        password: document.getElementById('sPass').value,
        location: document.getElementById('sLoc').value,
        clear_username: document.getElementById('sClearUser').checked,
        clear_password: document.getElementById('sClearPass').checked
    };
    try {
        const isLegacy = id === 'legacy';
        const endpoint = isLegacy ? '/admin/acs/api/servers/legacy' : (id ? ('/admin/acs/api/servers/' + encodeURIComponent(id)) : '/admin/acs/api/servers');
        const method = isLegacy ? 'PUT' : (id ? 'PUT' : 'POST');
        const res = await fetch(endpoint, {
            method,
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data && data.success) return location.reload();
        alert((data && data.message) ? data.message : 'Gagal menyimpan konfigurasi server');
    } catch (err) {
        alert('Error: ' + err.message);
    } finally {
        btn.disabled = false;
        txt.style.display = 'inline-block';
        ldr.style.display = 'none';
    }
}

async function deleteServer(id) {
    if(!confirm('Hapus server ini? Perangkat yang terdaftar di server ini tidak akan lagi ditampilkan.')) return;
    try {
        const res = await fetch('/admin/acs/api/servers/' + id, { method: 'DELETE' });
        const d = await res.json();
        if (d.success) location.reload();
        else alert(d.message || 'Gagal menghapus server');
    } catch (err) {
        alert('Error: ' + err.message);
    }
}

// ── UNIFIED ADD WAN ALL-IN-ONE PROVISIONING ──
function syncTagClass(checkbox, labelId) {
    const lbl = document.getElementById(labelId);
    if (!lbl) return;
    if (checkbox.checked) lbl.classList.add('active');
    else lbl.classList.remove('active');
}

function toggleWanModeFields() {
    const mode = document.getElementById('wanMode').value;
    const pppoeFields = document.getElementById('pppoeFields');
    const wanDhcp = document.getElementById('wanDhcp');
    if (mode === 'pppoe') {
        if (pppoeFields) pppoeFields.style.display = 'block';
        if (wanDhcp) wanDhcp.checked = true;
    } else {
        if (pppoeFields) pppoeFields.style.display = 'none';
        if (wanDhcp) wanDhcp.checked = false;
    }
}

function toggleMikrotikProfileField() {
    const autoChk = document.getElementById('wanAutoMikrotik');
    const container = document.getElementById('pppoeProfileContainer');
    if (container && autoChk) {
        container.style.visibility = autoChk.checked ? 'visible' : 'hidden';
    }
}

async function toggleWifiFields() {
    const configureWifi = document.getElementById('wanConfigureWifi').checked;
    const wifiFields = document.getElementById('wifiFields');
    
    if (configureWifi) {
        wifiFields.style.display = 'block';
        const deviceId = document.getElementById('wanDeviceId').value;
        const acsId = document.getElementById('wanAcsId').value;
        const wifiLoading = document.getElementById('wifiLoading');
        const band24Fields = document.getElementById('band24Fields');
        const band5Fields = document.getElementById('band5Fields');
        
        if (wifiLoading) wifiLoading.style.display = 'block';
        if (band24Fields) band24Fields.style.opacity = '0.5';
        if (band5Fields) band5Fields.style.opacity = '0.5';
        
        try {
            const res = await fetch(`/admin/acs/api/wifi-settings/${encodeURIComponent(deviceId)}?acsId=${encodeURIComponent(acsId)}`);
            const d = await res.json();
            
            if (d && d.success && Array.isArray(d.bands)) {
                document.getElementById('wifiSsid24').value = '';
                document.getElementById('wifiSsid5').value = '';
                if (band5Fields) band5Fields.style.display = 'none';
                
                d.bands.forEach(b => {
                    if (b.index === '1') {
                        document.getElementById('wifiSsid24').value = b.ssid;
                        document.getElementById('wifiSsid24').placeholder = 'Nama Wi-Fi 2.4G';
                    } else if (b.index === '5' || b.index === '2') {
                        if (band5Fields) band5Fields.style.display = 'block';
                        document.getElementById('wifiSsid5').value = b.ssid;
                        document.getElementById('wifiSsid5').placeholder = 'Nama Wi-Fi 5G';
                    }
                });
            }
        } catch (e) {
            console.error('Gagal mengambil SSID perangkat:', e);
        } finally {
            if (wifiLoading) wifiLoading.style.display = 'none';
            if (band24Fields) band24Fields.style.opacity = '1';
            if (band5Fields) band5Fields.style.opacity = '1';
        }
    } else {
        wifiFields.style.display = 'none';
    }
}

let addWanProgressTimer = null;
let addWanTrackingState = null;

function stopAddWanProgressPolling() {
    if (addWanProgressTimer) {
        clearTimeout(addWanProgressTimer);
        addWanProgressTimer = null;
    }
}

function resetAddWanProgress() {
    stopAddWanProgressPolling();
    addWanTrackingState = null;
    const box = document.getElementById('addWanProgressBox');
    const badge = document.getElementById('addWanProgressBadge');
    const summary = document.getElementById('addWanProgressSummary');
    const list = document.getElementById('addWanProgressList');
    if (box) box.style.display = 'none';
    if (badge) {
        badge.className = 'text-primary';
        badge.textContent = 'Menunggu';
    }
    if (summary) summary.textContent = 'Workflow belum dimulai.';
    if (list) list.innerHTML = '';
}

function renderAddWanProgress(data) {
    const box = document.getElementById('addWanProgressBox');
    const badge = document.getElementById('addWanProgressBadge');
    const summary = document.getElementById('addWanProgressSummary');
    const list = document.getElementById('addWanProgressList');
    if (!box || !badge || !summary || !list) return;

    box.style.display = 'block';
    summary.textContent = data.summary || 'Workflow sedang diproses ke modem...';

    if (data.hasFailure) {
        badge.className = 'text-danger';
        badge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Ada Kegagalan';
    } else if (data.done) {
        badge.className = 'text-success';
        badge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Selesai';
    } else {
        badge.className = 'text-warning';
        badge.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Berjalan';
    }

    const tasks = Array.isArray(data.tasks) ? data.tasks : [];
    list.innerHTML = tasks.map(task => {
        const status = String(task.status || 'pending');
        let statusClass = 'text-muted';
        let statusLabel = '<i class="bi bi-hourglass"></i> Pending';
        if (status === 'completed') {
            statusClass = 'text-success';
            statusLabel = '<i class="bi bi-check-circle"></i> Selesai';
        } else if (status === 'failed') {
            statusClass = 'text-danger';
            statusLabel = '<i class="bi bi-x-circle"></i> Gagal';
        } else if (status === 'in_progress') {
            statusClass = 'text-warning';
            statusLabel = '<i class="bi bi-arrow-repeat spin"></i> Diproses';
        }
        return `
            <div class="step-progress-item">
                <span style="font-size:12px; color:var(--text); font-weight:600;">${task.label || task.name || 'Task ACS'}</span>
                <span class="${statusClass}" style="font-size:12px; font-weight:700;">${statusLabel}</span>
            </div>
        `;
    }).join('');
}

async function pollAddWanProgress() {
    if (!addWanTrackingState || !addWanTrackingState.deviceId) return;

    const params = new URLSearchParams();
    if (addWanTrackingState.workflowId) params.set('workflowId', addWanTrackingState.workflowId);
    if (addWanTrackingState.rootTaskId) params.set('rootTaskId', String(addWanTrackingState.rootTaskId));

    try {
        const res = await fetch(`/admin/acs/api/add-wan-status/${encodeURIComponent(addWanTrackingState.deviceId)}?${params.toString()}`, {
            cache: 'no-store'
        });
        const data = await res.json();
        if (!data || !data.success) throw new Error(data && data.message ? data.message : 'Gagal membaca progress Add WAN');

        renderAddWanProgress(data);

        if (data.done) {
            stopAddWanProgressPolling();
            const btn = document.getElementById('btn-save-add-wan');
            const txt = btn ? btn.querySelector('.btn-text') : null;
            const ldr = btn ? btn.querySelector('.btn-loader') : null;
            if (btn) btn.disabled = false;
            if (txt) txt.style.display = 'inline-block';
            if (ldr) ldr.style.display = 'none';
            setTimeout(() => {
                closeModal('addWanModal');
                location.reload();
            }, data.hasFailure ? 2500 : 1800);
            return;
        }

        addWanProgressTimer = setTimeout(pollAddWanProgress, 4000);
    } catch (err) {
        stopAddWanProgressPolling();
        const summary = document.getElementById('addWanProgressSummary');
        if (summary) summary.textContent = 'Gagal membaca progress workflow Add WAN.';
        const btn = document.getElementById('btn-save-add-wan');
        const txt = btn ? btn.querySelector('.btn-text') : null;
        const ldr = btn ? btn.querySelector('.btn-loader') : null;
        if (btn) btn.disabled = false;
        if (txt) txt.style.display = 'inline-block';
        if (ldr) ldr.style.display = 'none';
    }
}

async function openAddWanModal(deviceId, acsId, sn, manufacturer, model) {
    resetAddWanProgress();
    document.getElementById('wanDeviceId').value = deviceId;
    document.getElementById('wanAcsId').value = acsId;
    document.getElementById('lblWanSn').innerText = sn || deviceId;
    document.getElementById('lblWanVendor').innerText = manufacturer || '-';
    document.getElementById('lblWanModel').innerText = model || '-';
    
    // Reset inputs
    document.getElementById('wanVlanId').value = '';
    document.getElementById('wanPppoeUser').value = '';
    document.getElementById('wanPppoePass').value = '';
    document.getElementById('wanConfigureWifi').checked = false;
    document.getElementById('wifiFields').style.display = 'none';
    
    // Default active bindings
    document.querySelectorAll('input[name="lanPorts"]').forEach(c => {
        c.checked = true;
        syncTagClass(c, 'lbl' + c.value.charAt(0) + c.value.slice(1).toLowerCase());
    });
    
    // Reset SSID labels
    for (let i = 1; i <= 4; i++) {
        const lbl = document.getElementById(`lblWlan${i}`);
        if (lbl) {
            lbl.innerHTML = `<input type="checkbox" name="wlanSsids" value="SSID${i}" ${i === 1 ? 'checked' : ''} style="display:none;" onchange="syncTagClass(this, 'lblWlan${i}')"> SSID ${i}`;
            if (i === 1) lbl.classList.add('active');
            else lbl.classList.remove('active');
        }
    }
    
    toggleWanModeFields();
    toggleMikrotikProfileField();
    openModal('addWanModal');
    
    // Async fetch WLAN actual SSID names
    try {
        const res = await fetch(`/admin/acs/api/wifi-settings/${encodeURIComponent(deviceId)}?acsId=${encodeURIComponent(acsId)}`);
        const d = await res.json();
        if (d && d.success && Array.isArray(d.bands)) {
            d.bands.forEach(b => {
                const lbl = document.getElementById(`lblWlan${b.index}`);
                if (lbl) {
                    const isChecked = b.index === '1';
                    lbl.innerHTML = `<input type="checkbox" name="wlanSsids" value="SSID${b.index}" ${isChecked ? 'checked' : ''} style="display:none;" onchange="syncTagClass(this, 'lblWlan${b.index}')"> SSID ${b.index}: ${b.ssid}`;
                }
            });
        }
    } catch (e) {
        console.error('Gagal mengambil nama SSID:', e);
    }
}

async function submitAddWanForm(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-save-add-wan');
    const txt = btn.querySelector('.btn-text');
    const ldr = btn.querySelector('.btn-loader');
    
    btn.disabled = true;
    txt.style.display = 'none';
    ldr.style.display = 'inline-block';
    
    const deviceId = document.getElementById('wanDeviceId').value;
    const acsId = document.getElementById('wanAcsId').value;
    
    const lanPorts = [];
    document.querySelectorAll('input[name="lanPorts"]:checked').forEach(c => lanPorts.push(c.value));
    
    const wlanSsids = [];
    document.querySelectorAll('input[name="wlanSsids"]:checked').forEach(c => wlanSsids.push(c.value));
    
    const body = {
        acsId,
        mode: document.getElementById('wanMode').value,
        vlanId: document.getElementById('wanVlanId').value,
        pppoeUser: document.getElementById('wanPppoeUser').value,
        pppoePass: document.getElementById('wanPppoePass').value,
        pppoeProfile: document.getElementById('wanPppoeProfile').value,
        autoCreateMikrotik: document.getElementById('wanAutoMikrotik').checked,
        lanPorts,
        wlanSsids,
        configureWifi: document.getElementById('wanConfigureWifi').checked,
        wifiSsid24: document.getElementById('wifiSsid24').value,
        wifiPass24: document.getElementById('wifiPass24').value,
        wifiSsid5: document.getElementById('wifiSsid5').value,
        wifiPass5: document.getElementById('wifiPass5').value,
        dhcp: document.getElementById('wanDhcp').checked
    };
    
    try {
        const res = await fetch(`/admin/acs/api/add-wan/${encodeURIComponent(deviceId)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        
        if (data && data.success) {
            if (data.trackingSupported) {
                addWanTrackingState = {
                    deviceId,
                    workflowId: data.workflowId || '',
                    rootTaskId: data.rootTaskId || ''
                };
                renderAddWanProgress({
                    summary: data.message || 'Workflow Add WAN dimulai...',
                    done: false,
                    hasFailure: false,
                    tasks: []
                });
                addWanProgressTimer = setTimeout(pollAddWanProgress, 1200);
            } else {
                alert(data.message);
                closeModal('addWanModal');
                location.reload();
            }
        } else {
            alert(data.message || 'Gagal menjalankan provisioning');
            btn.disabled = false;
            txt.style.display = 'inline-block';
            ldr.style.display = 'none';
        }
    } catch (err) {
        alert('Terjadi kesalahan: ' + err.message);
        btn.disabled = false;
        txt.style.display = 'inline-block';
        ldr.style.display = 'none';
    }
}
</script>
