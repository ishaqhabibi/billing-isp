let gLastConsoleResult = null;

function onConsoleDeviceChange() {
    const sel = document.getElementById('consoleDeviceSelect');
    const badgeText = document.getElementById('consoleBadgeText');
    const badgeDot = document.getElementById('consoleBadgeDot');
    const acsSel = document.getElementById('consoleAcsSelect');
    if (!sel || !sel.selectedIndex || sel.selectedIndex < 0) return;

    const opt = sel.options[sel.selectedIndex];
    if (!opt) return;

    const sn = opt.getAttribute('data-sn') || '-';
    const vendor = (opt.getAttribute('data-vendor') || '').toUpperCase();
    const model = opt.getAttribute('data-model') || '';
    const isOnline = opt.getAttribute('data-online') === 'true';
    const acsId = opt.getAttribute('data-acsid') || 'builtin';

    if (badgeText) badgeText.innerText = `${vendor} ${model} (${sn})`;
    if (badgeDot) badgeDot.style.background = isOnline ? '#10b981' : '#ef4444';
    if (acsSel && acsId) {
        acsSel.value = acsId;
    }
}

function onConsoleTemplateSelect(key) {
    if (!key || !CONSOLE_TEMPLATES[key]) return;
    const editor = document.getElementById('consoleEditor');
    if (editor) {
        editor.value = JSON.stringify(CONSOLE_TEMPLATES[key], null, 2);
    }
    appendConsoleLog('info', `Template dimuat: ${key}`);
}

function formatConsoleJson() {
    const editor = document.getElementById('consoleEditor');
    if (!editor) return;
    try {
        const parsed = JSON.parse(editor.value);
        editor.value = JSON.stringify(parsed, null, 2);
        appendConsoleLog('success', 'JSON berhasil diformat rapi.');
    } catch (e) {
        appendConsoleLog('error', `Gagal format JSON: ${e.message}`);
    }
}

function clearConsoleEditor() {
    const editor = document.getElementById('consoleEditor');
    if (editor) editor.value = '{\n  \n}';
}

function copyConsoleEditor() {
    const editor = document.getElementById('consoleEditor');
    if (!editor || !editor.value) return;
    navigator.clipboard.writeText(editor.value).then(() => {
        appendConsoleLog('info', 'Payload editor tersalin ke clipboard.');
    });
}

function clearConsoleTerminal() {
    const logScreen = document.getElementById('screenConsoleLog');
    if (logScreen) logScreen.innerHTML = '';
    const rawPre = document.getElementById('rawJsonResponse');
    if (rawPre) rawPre.textContent = '// Kosong';
    const treeCont = document.getElementById('paramTreeContainer');
    if (treeCont) treeCont.innerHTML = '<div style="padding:30px; text-align:center; color:var(--muted); font-size:12px;">Terminal dibersihkan.</div>';
}

function copyConsoleOutput() {
    let textToCopy = '';
    const rawPre = document.getElementById('rawJsonResponse');
    if (rawPre && rawPre.textContent) textToCopy = rawPre.textContent;
    if (!textToCopy) {
        const logScreen = document.getElementById('screenConsoleLog');
        if (logScreen) textToCopy = logScreen.innerText;
    }
    if (textToCopy) {
        navigator.clipboard.writeText(textToCopy).then(() => {
            appendConsoleLog('info', 'Output tersalin ke clipboard.');
        });
    }
}

function switchConsoleSubtab(subtab) {
    document.querySelectorAll('.console-subtab-btn').forEach(b => b.classList.remove('active'));
    const btn = document.getElementById(`btnSubtab${subtab.charAt(0).toUpperCase() + subtab.slice(1)}`);
    if (btn) btn.classList.add('active');

    document.getElementById('screenConsoleLog').style.display = (subtab === 'log') ? 'block' : 'none';
    document.getElementById('screenConsoleTree').style.display = (subtab === 'tree') ? 'block' : 'none';
    document.getElementById('screenConsoleRaw').style.display = (subtab === 'raw') ? 'block' : 'none';
}

function appendConsoleLog(type, text) {
    const logScreen = document.getElementById('screenConsoleLog');
    if (!logScreen) return;

    const row = document.createElement('div');
    row.className = 'terminal-log-line';

    const timeSpan = document.createElement('span');
    timeSpan.className = 'terminal-log-time';
    timeSpan.textContent = `[${new Date().toLocaleTimeString()}]`;

    const textSpan = document.createElement('span');
    let colorClass = 'terminal-log-text';
    if (type === 'success') colorClass = 'terminal-log-success';
    else if (type === 'error') colorClass = 'terminal-log-error';
    else if (type === 'warn') colorClass = 'terminal-log-warn';
    else if (type === 'info') colorClass = 'terminal-log-info';

    textSpan.className = colorClass;
    textSpan.textContent = text;

    row.appendChild(timeSpan);
    row.appendChild(textSpan);
    logScreen.appendChild(row);
    logScreen.scrollTop = logScreen.scrollHeight;
}

async function executeConsoleScript() {
    const devSelect = document.getElementById('consoleDeviceSelect');
    const acsSelect = document.getElementById('consoleAcsSelect');
    const editor = document.getElementById('consoleEditor');
    const chkCr = document.getElementById('chkConnectionRequest');
    const btn = document.getElementById('btnExecuteConsole');
    const latencyEl = document.getElementById('consoleLatencyText');
    const statusPill = document.getElementById('consoleStatusPill');
    const statusText = document.getElementById('consoleStatusText');
    const httpBadge = document.getElementById('consoleHttpStatusBadge');
    const taskIdBadge = document.getElementById('consoleTaskIdBadge');

    const opt = (devSelect && devSelect.selectedIndex >= 0) ? devSelect.options[devSelect.selectedIndex] : null;
    const deviceId = opt ? (opt.value || opt.getAttribute('data-sn') || '') : (devSelect ? devSelect.value : '');
    const acsId = acsSelect ? acsSelect.value : (opt ? opt.getAttribute('data-acsid') : 'builtin');
    const connectionRequest = chkCr ? chkCr.checked : true;

    if (!deviceId) {
        alert('Silakan pilih target perangkat terlebih dahulu.');
        return;
    }

    let payload = null;
    try {
        payload = JSON.parse(editor.value);
    } catch (err) {
        appendConsoleLog('error', `Syntax JSON tidak valid: ${err.message}`);
        switchConsoleSubtab('log');
        return;
    }

    // Safety confirmation for critical tasks
    const taskName = payload.name || '';
    if (taskName === 'reboot') {
        if (!confirm('PERINGATAN: Anda akan mengirim perintah REBOOT ke perangkat ini. Koneksi internet pelanggan akan terputus sesaat. Lanjutkan?')) {
            return;
        }
    } else if (taskName === 'factoryReset') {
        if (!confirm('BAHAYA: Anda akan melakukan FACTORY RESET pada modem pelanggan. Seluruh konfigurasi akan terhapus. Lanjutkan?')) {
            return;
        }
    }

    // Set UI to loading state
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Mengirim ke Modem...';
    }
    if (statusPill) statusPill.style.color = '#38bdf8';
    if (statusText) statusText.textContent = 'Executing...';
    if (latencyEl) latencyEl.textContent = '...';

    appendConsoleLog('info', `>>> Memulai eksekusi task '${taskName}' ke perangkat ${deviceId}...`);
    switchConsoleSubtab('log');

    try {
        const res = await fetch('/admin/acs/api/console/execute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                deviceId,
                acsId,
                taskPayload: payload,
                connectionRequest
            })
        });

        const data = await res.json().catch(() => ({}));
        gLastConsoleResult = data;

        if (latencyEl) latencyEl.textContent = `${data.durationMs || 0}ms`;
        if (httpBadge) {
            httpBadge.textContent = `HTTP ${data.httpStatus || res.status}`;
            httpBadge.style.color = res.ok ? '#34d399' : '#f87171';
            httpBadge.style.background = res.ok ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)';
        }
        if (taskIdBadge) {
            const tId = data.taskResult?._id || data.taskResult?.id || '-';
            taskIdBadge.textContent = `Task: ${tId}`;
        }

        if (Array.isArray(data.logs)) {
            data.logs.forEach(l => appendConsoleLog(res.ok ? 'success' : 'warn', l));
        }

        const rawPre = document.getElementById('rawJsonResponse');
        if (rawPre) rawPre.textContent = JSON.stringify(data, null, 2);

        // Render parameter tree if available
        renderParameterTree(data);

        if (res.ok && data.success) {
            if (statusPill) statusPill.style.color = '#10b981';
            if (statusText) statusText.textContent = 'Success (200 OK)';
            appendConsoleLog('success', `✓ Sukses dieksekusi dalam ${data.durationMs}ms`);

            // If we have extracted params, auto-switch to parameter tree view
            if (data.extractedParams && Object.keys(data.extractedParams).length > 0) {
                switchConsoleSubtab('tree');
            }
        } else {
            if (statusPill) statusPill.style.color = '#ef4444';
            if (statusText) statusText.textContent = 'Error';
            appendConsoleLog('error', `✖ Gagal: ${data.message || 'Error pada server ACS'}`);
        }
    } catch (netErr) {
        if (statusPill) statusPill.style.color = '#ef4444';
        if (statusText) statusText.textContent = 'Network Fail';
        appendConsoleLog('error', `Kesalahan jaringan: ${netErr.message}`);
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-play-fill fs-5"></i> <span>JALANKAN KE MODEM</span>';
        }
    }
}

function renderParameterTree(data) {
    const container = document.getElementById('paramTreeContainer');
    if (!container) return;

    let items = [];
    if (data.extractedParams && typeof data.extractedParams === 'object') {
        for (const [k, v] of Object.entries(data.extractedParams)) {
            items.push({ path: k, value: typeof v === 'object' ? JSON.stringify(v) : String(v) });
        }
    } else if (data.deviceSnapshot && typeof data.deviceSnapshot === 'object') {
        function flatten(obj, prefix = '') {
            for (const [k, v] of Object.entries(obj)) {
                if (k.startsWith('_') && k !== '_value') continue;
                const newKey = prefix ? `${prefix}.${k}` : k;
                if (v && typeof v === 'object' && v._value !== undefined) {
                    items.push({ path: newKey, value: String(v._value) });
                } else if (v && typeof v === 'object') {
                    flatten(v, newKey);
                } else {
                    items.push({ path: newKey, value: String(v) });
                }
            }
        }
        flatten(data.deviceSnapshot);
    }

    if (items.length === 0) {
        container.innerHTML = '<div style="padding:30px; text-align:center; color:var(--muted); font-size:12px;">Tidak ada parameter yang terekstrak. Coba jalankan `getParameterValues` dengan path spesifik.</div>';
        return;
    }

    let html = '';
    items.forEach(it => {
        html += `
            <div class="param-row-item">
                <span class="param-key">${escapeHtml(it.path)}</span>
                <span class="param-val">${escapeHtml(it.value)}</span>
            </div>
        `;
    });
    container.innerHTML = html;
}

function filterParameterTree() {
    const input = document.getElementById('filterTreeInput');
    const q = (input ? input.value : '').toLowerCase().trim();
    const rows = document.querySelectorAll('.param-row-item');
    rows.forEach(r => {
        const text = r.textContent.toLowerCase();
        r.style.display = text.includes(q) ? 'flex' : 'none';
    });
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]);
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', () => {
    onConsoleDeviceChange();
});
</script>
