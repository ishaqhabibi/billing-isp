        <div class="fg">
          <label class="fl">Nama Wi-Fi (SSID) Baru</label>
          <input type="text" class="fc" id="acs_wifi_new_ssid" placeholder="Contoh: KELUARGA-NET">
          <small class="text-muted" style="font-size:11px; margin-top:4px; display:block;">Kosongkan jika hanya ingin mengganti kata sandi.</small>
        </div>
        <div class="fg">
          <label class="fl">Kata Sandi Wi-Fi Baru</label>
          <div style="position:relative">
            <input type="password" class="fc" id="acs_wifi_new_password" placeholder="Minimal 8 karakter" minlength="8" style="padding-right:40px">
            <button type="button" onclick="togglePassVisibility('acs_wifi_new_password', this)" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);border:none;background:transparent;color:var(--muted);cursor:pointer;padding:4px">
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <small class="text-muted" style="font-size:11px; margin-top:4px; display:block;">Minimal 8 karakter. Kosongkan jika hanya ingin mengganti nama SSID.</small>
        </div>
        <div class="fg" style="margin-bottom:6px;">
          <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer">
            <input type="checkbox" id="acs_wifi_notify_wa" checked style="width:16px; height:16px;">
