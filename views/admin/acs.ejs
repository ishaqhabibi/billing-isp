function appendConsoleLog(type, text) {
    const logScreen = document.getElementById('screenConsoleLog');
    if (!logScreen) return;

    const row = document.createElement('div');
    row.className = 'terminal-log-line';

    const timeSpan = document.createElement('span');
    timeSpan.className = 'terminal-log-time';
    timeSpan.textContent = `[${new Date().toLocaleTimeString()}]`;

    const textSpan = document.createElement('span');
    let colorClass = 'terminal-log-text';
    if (type === 'success') colorClass = 'terminal-log-success';
    else if (type === 'error') colorClass = 'terminal-log-error';
    else if (type === 'warn') colorClass = 'terminal-log-warn';
    else if (type === 'info') colorClass = 'terminal-log-info';

    textSpan.className = colorClass;
    textSpan.textContent = text;

    row.appendChild(timeSpan);
    row.appendChild(textSpan);
    logScreen.appendChild(row);
    logScreen.scrollTop = logScreen.scrollHeight;
}

async function executeConsoleScript() {
    const devSelect = document.getElementById('consoleDeviceSelect');
    const acsSelect = document.getElementById('consoleAcsSelect');
    const editor = document.getElementById('consoleEditor');
    const chkCr = document.getElementById('chkConnectionRequest');
    const btn = document.getElementById('btnExecuteConsole');
    const latencyEl = document.getElementById('consoleLatencyText');
    const statusPill = document.getElementById('consoleStatusPill');
    const statusText = document.getElementById('consoleStatusText');
    const httpBadge = document.getElementById('consoleHttpStatusBadge');
    const taskIdBadge = document.getElementById('consoleTaskIdBadge');

    const opt = (devSelect && devSelect.selectedIndex >= 0) ? devSelect.options[devSelect.selectedIndex] : null;
    const deviceId = opt ? (opt.value || opt.getAttribute('data-sn') || '') : (devSelect ? devSelect.value : '');
    const acsId = acsSelect ? acsSelect.value : (opt ? opt.getAttribute('data-acsid') : 'builtin');
    const connectionRequest = chkCr ? chkCr.checked : true;

    if (!deviceId) {
        alert('Silakan pilih target perangkat terlebih dahulu.');
        return;
    }

    let payload = null;
    try {
        payload = JSON.parse(editor.value);
    } catch (err) {
        appendConsoleLog('error', `Syntax JSON tidak valid: ${err.message}`);
        switchConsoleSubtab('log');
        return;
    }

    // Safety confirmation for critical tasks
    const taskName = payload.name || '';
    if (taskName === 'reboot') {
        if (!confirm('PERINGATAN: Anda akan mengirim perintah REBOOT ke perangkat ini. Koneksi internet pelanggan akan terputus sesaat. Lanjutkan?')) {
            return;
        }
    } else if (taskName === 'factoryReset') {
        if (!confirm('BAHAYA: Anda akan melakukan FACTORY RESET pada modem pelanggan. Seluruh konfigurasi akan terhapus. Lanjutkan?')) {
            return;
        }
    }

    // Set UI to loading state
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Mengirim ke Modem...';
    }
    if (statusPill) statusPill.style.color = '#38bdf8';
    if (statusText) statusText.textContent = 'Executing...';
    if (latencyEl) latencyEl.textContent = '...';

    appendConsoleLog('info', `>>> Memulai eksekusi task '${taskName}' ke perangkat ${deviceId}...`);
    switchConsoleSubtab('log');

    try {
        const res = await fetch('/admin/acs/api/console/execute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                deviceId,
                acsId,
                taskPayload: payload,
                connectionRequest
            })
        });

        const data = await res.json().catch(() => ({}));
        gLastConsoleResult = data;

        if (latencyEl) latencyEl.textContent = `${data.durationMs || 0}ms`;
        if (httpBadge) {
            httpBadge.textContent = `HTTP ${data.httpStatus || res.status}`;
            httpBadge.style.color = res.ok ? '#34d399' : '#f87171';
            httpBadge.style.background = res.ok ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)';
        }
        if (taskIdBadge) {
            const tId = data.taskResult?._id || data.taskResult?.id || '-';
            taskIdBadge.textContent = `Task: ${tId}`;
        }

        if (Array.isArray(data.logs)) {
            data.logs.forEach(l => appendConsoleLog(res.ok ? 'success' : 'warn', l));
        }

        const rawPre = document.getElementById('rawJsonResponse');
        if (rawPre) rawPre.textContent = JSON.stringify(data, null, 2);

        // Render parameter tree if available
        renderParameterTree(data);

        if (res.ok && data.success) {
            if (statusPill) statusPill.style.color = '#10b981';
            if (statusText) statusText.textContent = 'Success (200 OK)';
            appendConsoleLog('success', `✓ Sukses dieksekusi dalam ${data.durationMs}ms`);

            // If we have extracted params, auto-switch to parameter tree view
            if (data.extractedParams && Object.keys(data.extractedParams).length > 0) {
                switchConsoleSubtab('tree');
            }
        } else {
            if (statusPill) statusPill.style.color = '#ef4444';
            if (statusText) statusText.textContent = 'Error';
            appendConsoleLog('error', `✖ Gagal: ${data.message || 'Error pada server ACS'}`);
        }
    } catch (netErr) {
        if (statusPill) statusPill.style.color = '#ef4444';
        if (statusText) statusText.textContent = 'Network Fail';
        appendConsoleLog('error', `Kesalahan jaringan: ${netErr.message}`);
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-play-fill fs-5"></i> <span>JALANKAN KE MODEM</span>';
        }
    }
}

function renderParameterTree(data) {
    const container = document.getElementById('paramTreeContainer');
    if (!container) return;

    let items = [];
    if (data.extractedParams && typeof data.extractedParams === 'object') {
        for (const [k, v] of Object.entries(data.extractedParams)) {
            items.push({ path: k, value: typeof v === 'object' ? JSON.stringify(v) : String(v) });
        }
    } else if (data.deviceSnapshot && typeof data.deviceSnapshot === 'object') {
        function flatten(obj, prefix = '') {
            for (const [k, v] of Object.entries(obj)) {
                if (k.startsWith('_') && k !== '_value') continue;
                const newKey = prefix ? `${prefix}.${k}` : k;
                if (v && typeof v === 'object' && v._value !== undefined) {
                    items.push({ path: newKey, value: String(v._value) });
                } else if (v && typeof v === 'object') {
                    flatten(v, newKey);
                } else {
                    items.push({ path: newKey, value: String(v) });
                }
            }
        }
        flatten(data.deviceSnapshot);
    }

    if (items.length === 0) {
        container.innerHTML = '<div style="padding:30px; text-align:center; color:var(--muted); font-size:12px;">Tidak ada parameter yang terekstrak. Coba jalankan `getParameterValues` dengan path spesifik.</div>';
        return;
    }

    let html = '';
    items.forEach(it => {
        html += `
            <div class="param-row-item">
                <span class="param-key">${escapeHtml(it.path)}</span>
                <span class="param-val">${escapeHtml(it.value)}</span>
            </div>
        `;
    });
    container.innerHTML = html;
}

function filterParameterTree() {
    const input = document.getElementById('filterTreeInput');
    const q = (input ? input.value : '').toLowerCase().trim();
    const rows = document.querySelectorAll('.param-row-item');
    rows.forEach(r => {
        const text = r.textContent.toLowerCase();
        r.style.display = text.includes(q) ? 'flex' : 'none';
    });
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]);
}

function escapeJs(str) {
    if (!str) return '';
    return String(str)
        .replace(/\\/g, '\\\\')
        .replace(/'/g, "\\'")
        .replace(/"/g, '\\"')
        .replace(/\n/g, '\\n')
        .replace(/\r/g, '');
}

// ── NOC TELEMETRY LOADING SCREEN CONTROLLER ──
function setNocLoadingStep(stepNum, tickerText) {
  const step1 = document.getElementById('noc-step-1');
  const step2 = document.getElementById('noc-step-2');
  const step3 = document.getElementById('noc-step-3');
  const ticker = document.getElementById('noc-status-ticker');
  if (ticker && tickerText) ticker.textContent = tickerText;

  if (stepNum === 1) {
    if (step1) { step1.className = 'noc-step-item active'; }
    if (step2) { step2.className = 'noc-step-item'; }
    if (step3) { step3.className = 'noc-step-item'; }
  } else if (stepNum === 2) {
    if (step1) { step1.className = 'noc-step-item done'; }
    if (step2) { step2.className = 'noc-step-item active'; }
    if (step3) { step3.className = 'noc-step-item'; }
  } else if (stepNum === 3) {
    if (step1) { step1.className = 'noc-step-item done'; }
    if (step2) { step2.className = 'noc-step-item done'; }
    if (step3) { step3.className = 'noc-step-item active'; }
  }
}

function hideNocLoadingScreen() {
  const el = document.getElementById('noc-loading-screen');
  if (!el || el.classList.contains('fade-out')) return;

  const step1 = document.getElementById('noc-step-1');
  const step2 = document.getElementById('noc-step-2');
  const step3 = document.getElementById('noc-step-3');
  const ticker = document.getElementById('noc-status-ticker');
  if (step1) step1.className = 'noc-step-item done';
  if (step2) step2.className = 'noc-step-item done';
  if (step3) step3.className = 'noc-step-item done';
  if (ticker) ticker.textContent = 'GenieACS Enterprise Console siap!';

  setTimeout(() => {
    el.classList.add('fade-out');
    setTimeout(() => {
      el.style.display = 'none';
    }, 450);
  }, 220);
}

function showNocLoadingOnSwitch(select) {
  const el = document.getElementById('noc-loading-screen');
  if (el) {
    el.style.display = 'flex';
    el.classList.remove('fade-out');
    const ticker = document.getElementById('noc-status-ticker');
    if (ticker) ticker.textContent = 'Memuat telemetri dari server ACS terpilih...';
    setNocLoadingStep(1, 'Menghubungkan TR-069 NBI Engine...');
  }
  select.form.submit();
}

// Safety timeout: automatically fade out after 10s so user never gets stuck
setTimeout(hideNocLoadingScreen, 10000);

function renderDevicesTableRows(devices, selectedAcsId) {
    const tbody = document.getElementById('devicesTableBody');
    if (!tbody) return;

    if (!devices || devices.length === 0) {
        tbody.innerHTML = `
            <tr id="noDevicesRow">
                <td colspan="7">
                    <div class="empty-state">
                        <div class="empty-icon"><i class="bi bi-hdd-network"></i></div>
                        <div class="empty-title">Tidak Ada Perangkat Ditemukan</div>
                        <div class="empty-desc">Belum ada data perangkat yang tersinkronisasi dari GenieACS server yang dipilih.</div>
                        <div>
                            <button class="btn btn-p btn-sm" onclick="syncAllACS()"><i class="bi bi-arrow-repeat"></i> Sinkronkan Sekarang</button>
                        </div>
                    </div>
                </td>
            </tr>
        `;
        return;
    }

    let rowsHtml = '';
    devices.forEach(d => {
        const mfg = (d.manufacturer || '').toLowerCase();
        let vendorClass = 'vendor-badge';
        if (mfg.includes('huawei')) vendorClass += ' vendor-huawei';
        else if (mfg.includes('zte')) vendorClass += ' vendor-zte';
        else if (mfg.includes('fiberhome')) vendorClass += ' vendor-fiberhome';

        const rxNum = parseFloat(d.rx_power);
        const hasRx = !isNaN(rxNum);
        let rxBadgeClass = 'rx-badge rx-muted';
        let rxLabel = hasRx ? `${d.rx_power} dBm` : '-';
        let rxIcon = 'bi-activity';
        let isCriticalRx = false;

        if (hasRx) {
            if (rxNum >= -22.0) {
                rxBadgeClass = 'rx-badge rx-good';
                rxIcon = 'bi-reception-4';
            } else if (rxNum >= -26.9) {
                rxBadgeClass = 'rx-badge rx-warning';
                rxIcon = 'bi-reception-3';
            } else {
                rxBadgeClass = 'rx-badge rx-danger';
                rxIcon = 'bi-exclamation-triangle-fill';
                isCriticalRx = true;
            }
        }

        const devId = d.id || d._id || d.sn;
        const devSn = d.sn || devId;
        const acsServerId = d.acs_server_id || selectedAcsId || '';

        rowsHtml += `
            <tr class="device-row" 
                data-online="${d.isOnline ? '1' : '0'}" 
                data-critical="${isCriticalRx ? '1' : '0'}"
                data-sn="${escapeHtml((devSn || '').toLowerCase())}"
                data-customer="${escapeHtml((d.customer_name || '').toLowerCase())}"
                data-pppoe="${escapeHtml((d.pppoe_user || '').toLowerCase())}"
                data-ip="${escapeHtml((d.ip || d.pppoe_ip || '').toLowerCase())}"
                data-ssid="${escapeHtml((d.ssid || '').toLowerCase())}">
                <td style="text-align:center;">
                    <input type="checkbox" class="device-checkbox" data-id="${escapeHtml(devId)}" data-acs="${escapeHtml(acsServerId)}" onchange="updateBulkPanel()" style="cursor:pointer; width:16px; height:16px;">
                </td>
                <td>
                    <div class="dev-identity">
                        <a href="/admin/acs/device/${encodeURIComponent(devId)}?acsId=${encodeURIComponent(acsServerId)}" class="dev-sn" title="Buka Detail Telemetri Perangkat">
                            <i class="bi bi-router text-muted"></i>
                            <span>${escapeHtml(devSn)}</span>
                        </a>
                        <div class="dev-meta">
                            <span class="${vendorClass}">${escapeHtml(d.manufacturer && d.manufacturer !== '-' ? d.manufacturer : 'ONU')}</span>
                            <span>${escapeHtml(d.model && d.model !== '-' ? d.model : '')}</span>
                            ${d.acs_server_name ? `<span style="opacity:0.6;">&bull; ${escapeHtml(d.acs_server_name)}</span>` : ''}
                        </div>
                    </div>
                </td>
                <td>
                    <div class="cust-cell">
                        <div class="cust-name">
                            ${d.customer_name && d.customer_name !== '-' ? `
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <i class="bi bi-person-circle text-primary" style="font-size:12px;"></i>
                                    <span style="font-weight:600;">${escapeHtml(d.customer_name)}</span>
                                    <button type="button" class="btn-act" onclick="unmapCustomer('${escapeJs(devSn)}', '${escapeJs(d.customer_name)}')" style="border:none; background:transparent; padding:0; font-size:11px; color:var(--muted); cursor:pointer; opacity:0.6;" title="Lepas tautan pelanggan">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                            ` : `
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <span class="badge" style="background:rgba(148,163,184,0.12); color:#94a3b8; font-weight:600; font-size:11px; padding:2px 7px; border-radius:4px; display:inline-flex; align-items:center; gap:4px;" title="Modem belum ditautkan ke data pelanggan billing">
                                        <i class="bi bi-person-dash"></i> Belum Dimapping
                                    </span>
                                    <button type="button" class="btn btn-g btn-xs" onclick="openMapCustomerModal('${escapeJs(devSn)}')" style="font-size:10px; padding:2px 7px; line-height:1.2; border-radius:4px;" title="Tautkan modem ini ke salah satu pelanggan billing">
                                        <i class="bi bi-link-45deg"></i> Tautkan
                                    </button>
                                </div>
                            `}
                        </div>
                        <div class="cust-sub">
                            ${d.pppoe_user && d.pppoe_user !== '-' ? `<span title="PPPoE Username" style="color:#60a5fa;"><i class="bi bi-key-fill"></i> ${escapeHtml(d.pppoe_user)}</span>` : ''}
                            ${d.ip && d.ip !== '-' ? `<span title="IP Address" style="opacity:0.8;">${escapeHtml(d.ip)}</span>` : ''}
                        </div>
                    </div>
                </td>
                <td>
                    <div>
                        <span class="badge ${d.client_count && d.client_count > 0 ? 'bs' : 'bm'}" style="font-size:11px; padding:4px 9px; font-weight:700; display:inline-flex; align-items:center; gap:6px;" title="Total Perangkat Terhubung ke Modem (Klien LAN & Wi-Fi)">
                            <i class="bi bi-laptop"></i> ${d.client_count !== null && d.client_count !== undefined ? d.client_count : 0} Perangkat
                        </span>
                    </div>
                </td>
                <td>
                    <span class="${rxBadgeClass}" title="Optical Received Power">
                        <i class="bi ${rxIcon}"></i> ${escapeHtml(rxLabel)}
                    </span>
                </td>
                <td>
                    <div style="display:flex; flex-direction:column; gap:3px;">
                        <div>
                            <span class="status-pill ${d.isOnline ? 'status-up' : 'status-down'}">
                                <span class="${d.isOnline ? 'live-dot' : ''}" style="width:6px; height:6px; background:${d.isOnline ? '#10b981' : '#ef4444'};"></span>
                                ${d.isOnline ? 'Online' : 'Offline'}
                            </span>
                        </div>
                        <div style="font-size:11px; color:var(--muted); font-family:monospace;" class="live-uptime-ticker" data-seconds="${d.uptime_seconds || 0}" data-online="${d.isOnline ? '1' : '0'}">
                            <i class="bi bi-clock-history"></i> <span class="uptime-clock-text">${escapeHtml(d.uptime || '-')}</span>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="action-group">
                        <button class="btn-act btn-wifi" onclick="openAcsWifiModal('${escapeJs(devId)}', '${escapeJs(devSn)}', '${escapeJs(d.ssid || '')}', '${escapeJs(d.customer_name || '')}', '${escapeJs(acsServerId)}')" title="Ganti Nama / Sandi Wi-Fi 2.4G & 5G (TR-069)">
                            <i class="bi bi-wifi"></i>
                        </button>
                        <button class="btn-act btn-refresh" onclick="refreshDevice('${escapeJs(devId)}')" title="Summon / Refresh Data Perangkat">
                            <i class="bi bi-arrow-repeat"></i>
                        </button>
                        <button class="btn-act btn-wan" onclick="openAddWanModal('${escapeJs(devId)}', '${escapeJs(acsServerId)}', '${escapeJs(devSn)}', '${escapeJs(d.manufacturer || '')}', '${escapeJs(d.model || '')}')" title="Provisioning WAN All-in-One (VLAN, PPPoE & Binding)">
                            <i class="bi bi-hdd-network"></i>
                        </button>
                        <button class="btn-act btn-del" onclick="deleteDevice('${escapeJs(devId)}', '${escapeJs(acsServerId)}')" title="Hapus Perangkat dari ACS">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    });

    tbody.innerHTML = rowsHtml;
}

function updateConsoleDeviceOptions(devices) {
    const sel = document.getElementById('consoleDeviceSelect');
    if (!sel || !devices) return;
    sel.innerHTML = devices.map((d, idx) => {
        const devId = d.id || d._id || d.sn;
        const devSn = d.sn || devId;
        const devMfg = d.manufacturer || '-';
        const devModel = d.model || '-';
        const devCust = d.customer_name || d.pppoe_user || 'No Customer';
        return `<option value="${escapeHtml(devId)}" data-sn="${escapeHtml(devSn)}" data-mfg="${escapeHtml(devMfg)}" data-model="${escapeHtml(devModel)}" data-customer="${escapeHtml(devCust)}">${escapeHtml(devSn)} - ${escapeHtml(devCust)} (${escapeHtml(devMfg)} ${escapeHtml(devModel)})</option>`;
    }).join('');
    if (typeof onConsoleDeviceChange === 'function') onConsoleDeviceChange();
}

async function loadAcsDevicesData() {
    setNocLoadingStep(1, 'Menghubungkan TR-069 NBI Engine & Socket...');
    
    // Smooth telemetry stage progression while waiting for data
    const stage2Timer = setTimeout(() => {
        setNocLoadingStep(2, 'Sinkronisasi profil PPPoE & database pelanggan...');
    }, 450);
    const stage3Timer = setTimeout(() => {
        setNocLoadingStep(3, 'Memproses telemetri parameter CPE & redaman optik...');
    }, 950);

    try {
        const res = await fetch('/admin/acs/api/devices-data' + window.location.search);
        const data = await res.json();

        clearTimeout(stage2Timer);
        clearTimeout(stage3Timer);
        setNocLoadingStep(3, 'Menyiapkan tabel inventaris modem & optik...');

        if (data.success && Array.isArray(data.devices)) {
            // Update KPI cards
            const totalEl = document.getElementById('kpiValAll');
            const onEl = document.getElementById('kpiValOnline');
            const offEl = document.getElementById('kpiValOffline');
            const critEl = document.getElementById('kpiValCritical');
            const onBadge = document.getElementById('kpiBadgeOnline');
            const offBadge = document.getElementById('kpiBadgeOffline');
            const devBadge = document.getElementById('badgeDevCount');

            if (totalEl) totalEl.textContent = data.totalDev;
            if (onEl) onEl.textContent = data.onlineDev;
            if (offEl) offEl.textContent = data.offlineDev;
            if (critEl) critEl.textContent = data.criticalDev;
            if (onBadge) onBadge.textContent = `${data.onlinePercent}% Rasio`;
            if (offBadge) offBadge.textContent = `${data.totalDev > 0 ? (100 - data.onlinePercent) : 0}%`;
            if (devBadge) devBadge.textContent = data.totalDev;

            // Update status pills
            const pillAll = document.getElementById('pillCountAll');
            const pillOn = document.getElementById('pillCountOnline');
            const pillOff = document.getElementById('pillCountOffline');
            const pillCrit = document.getElementById('pillCountCritical');
            if (pillAll) pillAll.textContent = data.totalDev;
            if (pillOn) pillOn.textContent = data.onlineDev;
            if (pillOff) pillOff.textContent = data.offlineDev;
            if (pillCrit) pillCrit.textContent = data.criticalDev;

            // Render table & console
            renderDevicesTableRows(data.devices, data.selectedAcsId);
            updateConsoleDeviceOptions(data.devices);
        }
    } catch (err) {
        console.error('Failed to load ACS devices telemetry:', err);
    } finally {
        setTimeout(hideNocLoadingScreen, 300);
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', () => {
    loadAcsDevicesData();
});
</script>
