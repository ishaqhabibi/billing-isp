async function openAcsWifiModal(id, sn, currentSsid, custName, acsId) {
    document.getElementById('acs_wifi_device_id').value = id;
    document.getElementById('acs_wifi_acs_id').value = acsId || 'builtin';
    const labelVal = (custName && custName !== '-' ? (custName + ' — ') : '') + (sn || id);
    const labelEl = document.getElementById('acs_wifi_device_label');
    if (labelEl) labelEl.value = labelVal;
    
    // Update modern device identity strip
    const custDisp = document.getElementById('acs_wifi_display_cust');
    const snDisp = document.getElementById('acs_wifi_display_sn');
    const ipDisp = document.getElementById('acs_wifi_display_ip');
    if (custDisp) custDisp.textContent = (custName && custName !== '-' && custName.trim() !== '') ? custName : 'Pelanggan Umum';
    if (snDisp) snDisp.textContent = sn || id;
    if (ipDisp) ipDisp.style.display = 'none';

    // Reset alert
    const alertBox = document.getElementById('acs_wifi_action_alert');
    if (alertBox) {
        alertBox.style.display = 'none';
        alertBox.innerHTML = '';
    }
    
    const initial24 = (currentSsid && currentSsid !== '-' ? currentSsid : '');
    document.getElementById('acs_wifi_new_ssid').value = initial24;
    document.getElementById('acs_wifi_new_password').value = '';
    
    // Sensible default for 5G
    let default5g = '';
    if (initial24) {
        if (/5g/i.test(initial24)) default5g = initial24;
        else if (/2\.?4g/i.test(initial24)) default5g = initial24.replace(/2\.?4g/i, '5G');
        else default5g = initial24 + ' 5G';
    }
    document.getElementById('acs_wifi_new_ssid_5g').value = default5g;
    document.getElementById('acs_wifi_new_password_5g').value = '';
    
    const syncChk = document.getElementById('acs_wifi_sync_pass');
    if (syncChk) syncChk.checked = false;
    
    const loading = document.getElementById('acs_wifi_loading');
    const container5g = document.getElementById('acs_wifi_5g_container');
    if (container5g) container5g.style.display = 'block';
    if (loading) loading.style.display = 'block';
    
    openModal('acsWifiModal');

    // Load diagnostics status & tasks
    loadWifiDiagnostics(id);

    // Async fetch WLAN actual SSID names from modem
    try {
        const res = await fetch(`/admin/acs/api/wifi-settings/${encodeURIComponent(id)}?acsId=${encodeURIComponent(acsId || 'builtin')}`);
        const d = await res.json();
        if (d && d.success && Array.isArray(d.bands) && d.bands.length > 0) {
            d.bands.forEach(b => {
                if (b.index === '1') {
                    if (b.ssid) document.getElementById('acs_wifi_new_ssid').value = b.ssid;
                } else if (b.index === '5' || b.index === '2' || b.index === 'landev2_1') {
                    if (b.ssid) document.getElementById('acs_wifi_new_ssid_5g').value = b.ssid;
                }
            });
        }
    } catch (e) {
        console.error('Gagal membaca detail Wi-Fi CPE:', e);
    } finally {
        if (loading) loading.style.display = 'none';
    }
}

let wlanDiscoveryTimer = null;

async function loadWifiDiagnostics(deviceId) {
    const statusEl = document.getElementById('acs_wifi_diag_status');
    const logsEl = document.getElementById('acs_wifi_task_logs');
    if (!statusEl) return;

    try {
        const res = await fetch(`/admin/acs/api/device-diagnostics/${encodeURIComponent(deviceId)}`);
        const data = await res.json();
        if (data && data.success) {
            let statusHtml = '';
            if (data.detected5gPath) {
                const shortPath = data.detected5gPath.split('.').slice(-2).join('.');
                statusHtml = `<span style="color:#10b981; font-weight:700;"><i class="bi bi-check-circle-fill me-1"></i> Jalur WLAN Terpetakan (2.4G & 5G)</span> &bull; <span style="color:var(--muted); font-size:11px;">Objek: <code>${shortPath}</code></span>`;
            } else {
                statusHtml = `<span style="color:#f59e0b; font-weight:700;"><i class="bi bi-exclamation-triangle-fill me-1"></i> Parameter 5 GHz Belum Terpetakan</span> &bull; <span style="font-size:11px; color:var(--muted);">Gunakan tombol sinkronisasi untuk kueri tree parameter CPE.</span>`;
            }

            if (data.ip_address) {
                statusHtml += ` <span class="badge" style="font-size:10.5px; background:rgba(255,255,255,0.06); color:var(--muted); border:1px solid var(--border); margin-left:6px;">IP: ${data.ip_address}</span>`;
                
                const ipDisp = document.getElementById('acs_wifi_display_ip');
                if (ipDisp) {
                    ipDisp.innerHTML = `<i class="bi bi-globe me-1"></i>${data.ip_address}`;
                    ipDisp.style.display = 'inline-flex';
                }
            }
            statusEl.innerHTML = statusHtml;

            // Render last tasks
            if (Array.isArray(data.recentTasks) && data.recentTasks.length > 0) {
                logsEl.style.display = 'block';
                logsEl.innerHTML = data.recentTasks.slice(0, 6).map(t => {
                    let badge = '';
                    if (t.status === 'completed') badge = '<span style="color:#10b981; font-weight:bold;">[SUKSES]</span>';
                    else if (t.status === 'failed') {
                        const fault = t.result?.faultCode ? `Fault ${t.result.faultCode}` : (t.result?.error || 'Gagal');
                        badge = `<span style="color:#ef4444; font-weight:bold;">[GAGAL: ${fault}]</span>`;
                    } else if (t.status === 'in_progress') badge = '<span style="color:#38bdf8; font-weight:bold;">[PROSES]</span>';
                    else badge = '<span style="color:#f59e0b; font-weight:bold;">[ANTRE]</span>';

                    let detail = t.name;
                    if (t.payload) {
                        if (t.payload.parameterValues && Array.isArray(t.payload.parameterValues)) {
                            detail += ' ' + t.payload.parameterValues.map(p => `${p[0]?.split('.').pop()}=${p[1]}`).join(', ');
                        } else if (t.payload.parameterNames && Array.isArray(t.payload.parameterNames)) {
                            detail += ' ' + t.payload.parameterNames.map(p => p?.split('.').pop()).join(', ');
                        } else if (t.payload.objectName) {
                            detail += ' ' + t.payload.objectName;
                        }
                    }
                    let time = '';
                    if (t.updated_at) {
                        try {
                            const rawIso = String(t.updated_at).replace(' ', 'T');
                            const dt = new Date(rawIso.includes('Z') ? rawIso : rawIso + 'Z');
                            if (!isNaN(dt.getTime())) {
                                const day = String(dt.getDate()).padStart(2, '0');
                                const month = String(dt.getMonth() + 1).padStart(2, '0');
                                const hours = String(dt.getHours()).padStart(2, '0');
                                const mins = String(dt.getMinutes()).padStart(2, '0');
                                const secs = String(dt.getSeconds()).padStart(2, '0');
                                time = `<span style="color:#94a3b8; font-weight:600;">${day}/${month} ${hours}:${mins}:${secs}</span>`;
                            } else {
                                time = rawIso.slice(5, 19).replace('T', ' ');
                            }
                        } catch (_) {
                            time = String(t.updated_at).slice(5, 19);
                        }
                    }
                    return `<div style="padding:3px 0; border-bottom:1px solid rgba(255,255,255,0.05);">${time} ${badge} ${detail}</div>`;
                }).join('');
            }
        }
    } catch (e) {
        console.warn('Gagal memuat telemetri Wi-Fi:', e.message);
    }
}

async function triggerWlanDiscovery() {
    const deviceId = document.getElementById('acs_wifi_device_id').value;
    const btn = document.getElementById('btn_detect_wlan');
    const statusEl = document.getElementById('acs_wifi_diag_status');
    if (!deviceId || !btn) return;

    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Menyinkronkan...';
    if (statusEl) statusEl.innerHTML = '<span style="color:#38bdf8;"><i class="bi bi-arrow-repeat spin me-1"></i> Mengirim task query parameter ke CPE via TR-069...</span>';

    try {
        const res = await fetch(`/admin/acs/api/discover-wlan/${encodeURIComponent(deviceId)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data && data.success) {
            // Poll diagnostics every 2s for 16s
            let attempts = 0;
            if (wlanDiscoveryTimer) clearInterval(wlanDiscoveryTimer);
            wlanDiscoveryTimer = setInterval(async () => {
                attempts++;
                await loadWifiDiagnostics(deviceId);
                try {
                    const r = await fetch(`/admin/acs/api/wifi-settings/${encodeURIComponent(deviceId)}?acsId=builtin`);
                    const d = await r.json();
                    if (d && d.success && Array.isArray(d.bands)) {
                        d.bands.forEach(b => {
                            if (b.index === '1' && b.ssid) document.getElementById('acs_wifi_new_ssid').value = b.ssid;
                            else if ((b.index === '5' || b.index === '2' || b.index === 'landev2_1') && b.ssid) {
                                document.getElementById('acs_wifi_new_ssid_5g').value = b.ssid;
                            }
                        });
                        if (d.detected5gPath) {
                            clearInterval(wlanDiscoveryTimer);
                            wlanDiscoveryTimer = null;
                            btn.disabled = false;
                            btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Sinkron';
                            setTimeout(() => { btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Sinkronkan Parameter'; }, 3000);
                        }
                    }
                } catch (_) {}

                if (attempts >= 8) {
                    clearInterval(wlanDiscoveryTimer);
                    wlanDiscoveryTimer = null;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Sinkronkan Parameter';
                }
            }, 2000);
        } else {
            alert('Gagal: ' + (data.message || 'Terjadi kesalahan sistem'));
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Sinkronkan Parameter';
        }
    } catch (e) {
        alert('Error: ' + e.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Sinkronkan Parameter';
    }
}

let wlanProgressPollingTimer = null;

async function submitAcsWifi(e) {
    e.preventDefault();
    const deviceId = document.getElementById('acs_wifi_device_id').value;
    const ssid24 = document.getElementById('acs_wifi_new_ssid').value.trim();
    const password24 = document.getElementById('acs_wifi_new_password').value.trim();
    const ssid5 = document.getElementById('acs_wifi_new_ssid_5g').value.trim();
    let password5 = document.getElementById('acs_wifi_new_password_5g').value.trim();
    const syncPass = document.getElementById('acs_wifi_sync_pass')?.checked;
    if (syncPass && password24) {
        password5 = password24;
    }
    const notifyWa = document.getElementById('acs_wifi_notify_wa').checked;
    const btn = document.getElementById('btn_save_acs_wifi');
    const alertBox = document.getElementById('acs_wifi_action_alert');

    if (!ssid24 && !password24 && !ssid5 && !password5) {
        return alert('Silakan masukkan nama SSID atau kata sandi baru.');
    }
    if (password24 && password24.length < 8) return alert('Kata sandi Wi-Fi 2.4 GHz minimal 8 karakter.');
    if (password5 && password5.length < 8) return alert('Kata sandi Wi-Fi 5 GHz minimal 8 karakter.');

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1 spin"></span> Menerapkan ke Modem...';

    if (alertBox) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'rgba(56,189,248,0.12)';
        alertBox.style.border = '1px solid rgba(56,189,248,0.3)';
        alertBox.style.color = '#38bdf8';
        alertBox.innerHTML = '<i class="bi bi-arrow-repeat spin me-1"></i> Mengirim task SetParameterValues ke antrean TR-069 CPE...';
    }

    try {
        const res = await fetch('/admin/api/device/' + encodeURIComponent(deviceId) + '/wifi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                ssid24, 
                password24, 
                ssid5, 
                password5, 
                notifyWa 
            })
        });
        const data = await res.json();
        if (data.success) {
            if (alertBox) {
                alertBox.style.display = 'block';
                alertBox.style.background = 'rgba(16,185,129,0.12)';
                alertBox.style.border = '1px solid rgba(16,185,129,0.3)';
                alertBox.style.color = '#10b981';
                alertBox.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> <strong>Konfigurasi Berhasil Terkirim.</strong> Task dalam antrean TR-069 dan sedang diterapkan ke modem.';
            }

            // Segera muat log diagnostik
            await loadWifiDiagnostics(deviceId);

            // Jalankan live polling setiap 2 detik selama 16 detik
            if (wlanProgressPollingTimer) clearInterval(wlanProgressPollingTimer);
            let pollCounter = 0;
            wlanProgressPollingTimer = setInterval(async () => {
                pollCounter++;
                await loadWifiDiagnostics(deviceId);
                if (pollCounter >= 8) {
                    clearInterval(wlanProgressPollingTimer);
                    wlanProgressPollingTimer = null;
                }
            }, 2000);
        } else {
            if (alertBox) {
                alertBox.style.display = 'block';
                alertBox.style.background = 'rgba(239,68,68,0.12)';
                alertBox.style.border = '1px solid rgba(239,68,68,0.3)';
                alertBox.style.color = '#ef4444';
                alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Gagal: ' + (data.error || data.message || 'Terjadi kesalahan sistem');
            }
        }
    } catch (err) {
        if (alertBox) {
            alertBox.style.display = 'block';
            alertBox.style.background = 'rgba(239,68,68,0.12)';
            alertBox.style.border = '1px solid rgba(239,68,68,0.3)';
            alertBox.style.color = '#ef4444';
            alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Error: ' + err.message;
        }
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill"></i> Terapkan ke Modem';
    }
}

