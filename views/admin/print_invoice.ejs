<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice #INV-<%= String(invoice.id).padStart(4, '0') %>-<%= getCurrentTimeInfo().year %> | <%= company %></title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    :root {
      --primary: #0052cc;
      --primary-dark: #003e99;
      --accent: #06b6d4;
      --success: #10b981;
      --success-bg: #ecfdf5;
      --danger: #ef4444;
      --danger-bg: #fef2f2;
      --text-dark: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --bg-light: #f8fafc;
    }

    @page {
      size: A4 portrait;
      margin: 12mm 15mm;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 12px;
      color: var(--text-dark);
      background-color: #f1f5f9;
      line-height: 1.4;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .invoice-wrapper {
      max-width: 800px;
      margin: 20px auto;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      overflow: hidden;
      position: relative;
    }

    /* Top Accent Line */
    .top-accent-bar {
      height: 6px;
      background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
    }

    /* Inner Container */
    .invoice-container {
      padding: 28px 36px;
      position: relative;
    }

    /* Header Section */
    .invoice-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 20px;
      border-bottom: 1.5px dashed var(--border-color);
      margin-bottom: 20px;
    }

    .brand-section {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .logo-container {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .company-logo {
      max-height: 48px;
      max-width: 160px;
      object-fit: contain;
      display: block;
    }

    .company-avatar-fallback {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      color: #ffffff;
      font-weight: 800;
      font-size: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
    }

    .company-title {
      font-size: 18px;
      font-weight: 800;
      color: var(--text-dark);
      letter-spacing: -0.3px;
    }

    .company-details {
      font-size: 11px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .invoice-title-block {
      text-align: right;
    }

    .doc-type {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 1px;
      color: var(--primary);
      text-transform: uppercase;
    }

    .invoice-num {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-dark);
      margin-top: 2px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 8px;
    }

    .status-badge.paid {
      background-color: var(--success-bg);
      color: #047857;
      border: 1px solid #a7f3d0;
    }

    .status-badge.unpaid {
      background-color: var(--danger-bg);
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: currentColor;
    }

    /* Grid Info Section */
    .billing-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }

    .info-card {
      background-color: var(--bg-light);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 14px 18px;
    }

    .card-heading {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .client-name {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 4px;
    }

    .meta-list {
      display: flex;
      flex-direction: column;
      gap: 3px;
      font-size: 11px;
      color: var(--text-muted);
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .summary-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .summary-item {
      display: flex;
      flex-direction: column;
    }

    .summary-item .label {
      font-size: 10px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .summary-item .value {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-dark);
    }

    /* Table Section */
    .items-table-container {
      margin-bottom: 20px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      overflow: hidden;
      position: relative;
    }

    .items-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .items-table th {
      background-color: var(--bg-light);
      padding: 10px 14px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
    }

    .items-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--border-color);
      font-size: 12px;
    }

    .items-table tr:last-child td {
      border-bottom: none;
    }

    .item-title {
      font-weight: 700;
      color: var(--text-dark);
    }

    .item-sub {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .text-right {
      text-align: right;
    }

    /* Watermark */
    .watermark-stamp {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-22deg);
      font-size: 50px;
      font-weight: 900;
      letter-spacing: 6px;
      text-transform: uppercase;
      padding: 10px 30px;
      border: 4px dashed;
      border-radius: 14px;
      pointer-events: none;
      user-select: none;
      z-index: 1;
      white-space: nowrap;
    }

    .watermark-stamp.paid {
      color: rgba(16, 185, 129, 0.13);
      border-color: rgba(16, 185, 129, 0.16);
    }

    .watermark-stamp.unpaid {
      color: rgba(220, 38, 38, 0.12);
      border-color: rgba(220, 38, 38, 0.15);
    }

    /* Totals & Notes Layout */
    .bottom-layout {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 20px;
    }

    .notes-card {
      background-color: var(--bg-light);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .notes-card strong {
      color: var(--text-dark);
    }

    .totals-card {
      border: 1px solid var(--border-color);
      border-radius: 10px;
      overflow: hidden;
    }

    .total-line {
      display: flex;
      justify-content: space-between;
      padding: 8px 14px;
      font-size: 12px;
      border-bottom: 1px solid var(--border-color);
    }

    .total-line:last-child {
      border-bottom: none;
    }

    .total-line.grand-total {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
      color: #ffffff;
      padding: 10px 14px;
    }

    .total-line.grand-total .lbl {
      font-weight: 700;
      color: rgba(255, 255, 255, 0.9);
    }

    .total-line.grand-total .val {
      font-size: 16px;
      font-weight: 800;
      color: #ffffff;
    }

    /* Signature & Footer Section */
    .invoice-footer {
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .footer-info {
      font-size: 10px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .signature-area {
      text-align: center;
      min-width: 150px;
    }

    .sig-company {
      font-size: 10px;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 6px;
    }

    .sig-stamp-badge {
      display: inline-block;
      font-size: 9px;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 4px;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .sig-stamp-badge.paid {
      background-color: #ecfdf5;
      color: #059669;
      border: 1px solid #a7f3d0;
    }

    .sig-stamp-badge.unpaid {
      background-color: #fef2f2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }

    .sig-line {
      border-top: 1.5px solid var(--border-color);
      margin-bottom: 4px;
    }

    .sig-name {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-dark);
    }

    .sig-role {
      font-size: 9px;
      color: var(--text-muted);
    }

    /* Print Controls Floating */
    .print-controls {
      position: fixed;
      bottom: 24px;
      right: 24px;
      display: flex;
      gap: 10px;
      z-index: 1000;
    }

    .btn-action {
      border: none;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    }

    .btn-print {
      background: linear-gradient(135deg, var(--primary), var(--accent));
      color: #ffffff;
    }

    .btn-print:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(79, 70, 229, 0.35);
    }

    .btn-close {
      background: #ffffff;
      color: var(--text-dark);
      border: 1px solid var(--border-color);
    }

    .btn-close:hover {
      background: var(--bg-light);
    }

    @media print {
      @page {
        size: A4 portrait;
        margin: 8mm 10mm;
      }
      body {
        background: #ffffff !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      .invoice-wrapper {
        margin: 0 !important;
        box-shadow: none !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        max-width: 100% !important;
        width: 100% !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      .invoice-container {
        padding: 16px 20px !important;
      }
      .print-controls {
        display: none !important;
      }
      button, .btn-action {
        display: none !important;
      }
    }
  </style>
</head>
<body>

<% 
  const mns = (lang || 'id') === 'en'
    ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
    : ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des'];
  const isPaid = invoice.status === 'paid';
  const companyInitial = (company || 'A').charAt(0).toUpperCase();
  const customerInitial = (customer.name || 'P').charAt(0).toUpperCase();
  const invNo = 'INV-' + String(invoice.id).padStart(4, '0') + '-' + getCurrentTimeInfo().year;
  const periodStr = mns[invoice.period_month - 1] + ' ' + invoice.period_year;

  // ── Tax Breakdown Calculation ──
  const totalAmount = Number(invoice.amount || 0);
  const pkgName = customer.package_name || (invoice && invoice.package_name) || 'Layanan Internet Broadband';
  const usePpn = (customer && customer.use_ppn === 1) || (invoice && invoice.use_ppn === 1);
  const ppnRate = Number((customer && customer.ppn_percentage) || (invoice && invoice.ppn_percentage) || 11.0);
  const useUso = (customer && customer.use_uso === 1) || (invoice && invoice.use_uso === 1);
  const usoRate = useUso ? Number((customer && customer.uso_percentage) || (invoice && invoice.uso_percentage) || 1.75) : 0;
  const combinedTaxPct = ppnRate + usoRate;

  let dpp = totalAmount;
  let ppnAmount = 0;
  let usoAmount = 0;
  const taxMode = usePpn ? 'excluded' : 'included';

  if (combinedTaxPct > 0) {
    dpp = Math.round(totalAmount / (1 + (combinedTaxPct / 100)));
    ppnAmount = Math.round(dpp * (ppnRate / 100));
    usoAmount = useUso ? Math.round(dpp * (usoRate / 100)) : 0;
    dpp = totalAmount - ppnAmount - usoAmount;
  }

  function terbilang(n) {
    n = Math.floor(Math.abs(Number(n) || 0));
    if (n === 0) return 'Nol Rupiah';
    const satuan = ['', 'Satu', 'Dua', 'Tiga', 'Empat', 'Lima', 'Enam', 'Tujuh', 'Delapan', 'Sembilan', 'Sepuluh', 'Sebelas'];
    function konversi(num) {
      if (num < 12) return satuan[num];
      if (num < 20) return konversi(num - 10) + ' Belas';
      if (num < 100) return konversi(Math.floor(num / 10)) + ' Puluh ' + (num % 10 ? konversi(num % 10) : '');
      if (num < 200) return 'Seratus ' + (num - 100 ? konversi(num - 100) : '');
      if (num < 1000) return konversi(Math.floor(num / 100)) + ' Ratus ' + (num % 100 ? konversi(num % 100) : '');
      if (num < 2000) return 'Seribu ' + (num - 1000 ? konversi(num - 1000) : '');
      if (num < 1000000) return konversi(Math.floor(num / 1000)) + ' Ribu ' + (num % 1000 ? konversi(num % 1000) : '');
      if (num < 1000000000) return konversi(Math.floor(num / 1000000)) + ' Juta ' + (num % 1000000 ? konversi(num % 1000000) : '');
      if (num < 1000000000000) return konversi(Math.floor(num / 1000000000)) + ' Miliar ' + (num % 1000000000 ? konversi(num % 1000000000) : '');
      return '';
    }
    return (konversi(n) + ' Rupiah').replace(/\s+/g, ' ').trim();
  }
%>

<div class="invoice-wrapper">
  <div class="top-accent-bar"></div>
  
  <div class="invoice-container">
    
    <!-- Header -->
    <div class="invoice-header">
      <div class="brand-section">
        <div class="logo-container">
          <img src="/img/logo.png?v=<%= Date.now() %>"
               alt="<%= company %> Logo"
               class="company-logo"
               onerror="this.style.display='none'; document.getElementById('companyAvatar').style.display='flex';">
          <div class="company-avatar-fallback" id="companyAvatar" style="display:none;"><%= companyInitial %></div>
          <div>
            <div class="company-title"><%= company %></div>
            <div class="company-details"><%= settings.company_address || 'Pusat Layanan Internet Terpercaya' %></div>
            <% if (settings.whatsapp_admin_numbers && settings.whatsapp_admin_numbers.length > 0) { %>
            <div class="company-details">Telp/WA: +<%= settings.whatsapp_admin_numbers[0] %></div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="invoice-title-block">
        <div class="doc-type">INVOICE</div>
        <div class="invoice-num"># <%= invNo %></div>
        <div>
          <% if (isPaid) { %>
          <span class="status-badge paid"><span class="badge-dot"></span>LUNAS</span>
          <% } else { %>
          <span class="status-badge unpaid"><span class="badge-dot"></span>BELUM BAYAR</span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Grid Billing Details -->
    <div class="billing-grid">
      <!-- Client Details -->
      <div class="info-card">
        <div class="card-heading">Ditagihkan Kepada</div>
        <div class="client-name"><%= customer.name %></div>
        <div class="meta-list">
          <% if (customer.customer_code || customer.pppoe_username) { %>
          <div class="meta-item"><span>🆔</span> ID Pelanggan: <%= customer.customer_code || customer.pppoe_username %></div>
          <% } %>
          <% if (customer.phone) { %>
          <div class="meta-item"><span>📱</span> No. HP/WA: <%= customer.phone %></div>
          <% } %>
          <% if (customer.address) { %>
          <div class="meta-item"><span>📍</span> Alamat: <%= customer.address %></div>
          <% } %>
        </div>
      </div>

      <!-- Transaction Info -->
      <div class="info-card">
        <div class="card-heading">Informasi Transaksi</div>
        <div class="summary-list">
          <div class="summary-item">
            <span class="label">Periode Tagihan</span>
            <span class="value" style="font-weight:700;"><%= periodStr %></span>
          </div>
          <div class="summary-item">
            <span class="label">Tanggal Terbit</span>
            <span class="value"><%= formatDateLocal(invoice.created_at || invoice.created_date || new Date()) %></span>
          </div>
          <div class="summary-item">
            <span class="label"><%= isPaid ? 'Tanggal Bayar' : 'Jatuh Tempo' %></span>
            <span class="value"><%= isPaid && invoice.paid_at ? formatDateLocal(invoice.paid_at) : (invoice.due_date ? formatDateLocal(invoice.due_date) : '-') %></span>
          </div>
          <div class="summary-item" style="margin-top:4px;">
            <span class="label">Metode Bayar</span>
            <span class="value" style="font-weight:700; color:<%= isPaid ? 'var(--success)' : 'var(--primary)' %>;">
              <%= invoice.payment_gateway ? invoice.payment_gateway.toUpperCase() : (invoice.paid_by_name && invoice.paid_by_name.toLowerCase().includes('cash') ? 'Tunai / Offline' : 'QRIS / Transfer Bank') %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Table Items -->
    <div class="items-table-container">
      <% if (isPaid) { %>
      <div class="watermark-stamp paid">LUNAS</div>
      <% } else { %>
      <div class="watermark-stamp unpaid">BELUM BAYAR</div>
      <% } %>

      <table class="items-table">
        <thead>
          <tr>
            <th style="width: 50px;">#</th>
            <th>Deskripsi Layanan</th>
            <th style="width: 120px;">Periode</th>
            <th class="text-right" style="width: 140px;">Jumlah</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>01</td>
            <td>
              <div class="item-title">Layanan Internet — <%= pkgName %></div>
              <div class="item-sub">Langganan Internet Bulanan Unlimited</div>
            </td>
            <td><%= periodStr %></td>
            <td class="text-right" style="font-weight:700;">Rp <%= Number(dpp || 0).toLocaleString('id-ID') %></td>
          </tr>
          <% if (useUso && usoAmount > 0) { %>
          <tr>
            <td>02</td>
            <td>
              <div class="item-title">Kontribusi BHP / USO <%= usoRate %>%</div>
              <div class="item-sub">Universal Service Obligation sesuai regulasi telekomunikasi</div>
            </td>
            <td><%= periodStr %></td>
            <td class="text-right" style="font-weight:700;">Rp <%= Number(usoAmount || 0).toLocaleString('id-ID') %></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Bottom Layout (Totals Only) -->
    <div class="bottom-layout" style="display: flex; justify-content: flex-end; margin-bottom: 24px;">
      <div class="totals-card" style="min-width: 280px;">
        <div class="total-line">
          <span class="lbl">Subtotal</span>
          <span class="val">Rp <%= Number(dpp || 0).toLocaleString('id-ID') %></span>
        </div>
        <div class="total-line">
          <span class="lbl">PPN <%= ppnRate %>% <%= taxMode === 'included' ? '(Sudah Termasuk)' : '' %></span>
          <span class="val">Rp <%= Number(ppnAmount || 0).toLocaleString('id-ID') %></span>
        </div>
        <% if (useUso && usoAmount > 0) { %>
        <div class="total-line">
          <span class="lbl">BHP / USO <%= usoRate %>%</span>
          <span class="val">Rp <%= Number(usoAmount || 0).toLocaleString('id-ID') %></span>
        </div>
        <% } %>
        <div class="total-line grand-total">
          <span class="lbl">Total Bayar</span>
          <span class="val">Rp <%= Number(totalAmount || 0).toLocaleString('id-ID') %></span>
        </div>
      </div>
    </div>

    <!-- Footer Clean & Minimal -->
    <div class="invoice-footer" style="display: block; padding-top: 16px; border-top: 1px solid var(--border-color);">
      <div class="footer-info">
        <div style="font-weight:700; color:var(--text-dark); font-size: 11px;"><%= company %></div>
        <div><%= settings.company_address || 'Pusat Layanan Internet' %><% if (settings.whatsapp_admin_numbers && settings.whatsapp_admin_numbers.length > 0) { %> • Telp/WA: +<%= settings.whatsapp_admin_numbers[0] %><% } %></div>
        <div style="margin-top:4px; color:var(--text-muted); font-size:9.5px;">Faktur ini dicetak otomatis oleh sistem dan sah tanpa tanda tangan basah • <%= getNowLocal() %></div>
      </div>
    </div>

  </div>
</div>

<!-- Floating Action Buttons -->
<div class="print-controls">
  <button class="btn-action btn-print" onclick="window.print();" title="Cetak Faktur A4">
    <span>🖨️</span> Cetak A4
  </button>
  <a href="/admin/billing/<%= invoice.id %>/print-thermal" target="_blank" class="btn-action btn-print" style="text-decoration:none; background: linear-gradient(135deg, #0284c7, #06b6d4);" title="Cetak Struk Bluetooth Thermal 58mm/80mm">
    <span>🧾</span> Struk Thermal
  </a>
  <a href="/admin/billing/<%= invoice.id %>/pdf" target="_blank" class="btn-action btn-print" style="text-decoration:none; background: linear-gradient(135deg, #059669, #10b981);">
    <span>📥</span> Unduh PDF
  </a>
  <% if (customer && customer.phone) { %>
  <button class="btn-action btn-print" id="btnSendWaPdf" onclick="sendInvoicePdfWa('<%= invoice.id %>')" style="background: linear-gradient(135deg, #25d366, #128c7e);">
    <span>📱</span> Kirim PDF WA
  </button>
  <% } %>
  <button class="btn-action btn-close" onclick="window.close();">
    <span>✕</span> Tutup
  </button>
</div>

<script>
  window.onload = function() {
    setTimeout(function() {
      if (!window.location.search.includes('noprint')) {
        window.print();
      }
    }, 500);
  };

  async function sendInvoicePdfWa(invoiceId) {
    const btn = document.getElementById('btnSendWaPdf');
    if (!btn) return;
    const oldText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>⏳</span> Mengirim...';
    try {
      const res = await fetch(`/admin/billing/${invoiceId}/send-pdf-wa`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        alert('✅ ' + data.message);
      } else {
        alert('❌ ' + data.message);
      }
    } catch (err) {
      alert('❌ Error: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = oldText;
    }
  }
</script>
</body>
</html>
