  <!-- ── ANDROID BOTTOM NAVIGATION BAR ── -->
  <%- include('partials/customer_bottom_nav', { activeNav: 'home', unpaidInvoices }) %>

  <!-- ══════════════════════════════════════════════════════════════════
       CLIENT-SIDE SCRIPTS
       ══════════════════════════════════════════════════════════════════ -->
  <script>
    let currentInvId = null;
    let pModal = null;

    let gCurrentWifiSsid24 = <%- JSON.stringify(currentWifiSsid24) %>;
    let gCurrentWifiSsid5 = <%- JSON.stringify(currentWifiSsid5) %>;
    let gCurrentWifiPass24 = <%- JSON.stringify(currentWifiPass24) %>;
    let gCurrentWifiPass5 = <%- JSON.stringify(currentWifiPass5) %>;
    let gWifiQr24 = <%- JSON.stringify(wifiQr24) %>;
    let gWifiQr5 = <%- JSON.stringify(wifiQr5) %>;

    let gIsPasswordRevealed24 = false;
    let gIsPasswordRevealed5 = false;
    let gActiveBand = '2.4';
    let gCachedConnectedDevices = <%- JSON.stringify(connectedUsers) %>;

    function showCustomerToast(message, type = 'success') {
      const toastEl = document.getElementById('customerLiveToast');
      const msgEl = document.getElementById('customerToastMessage');
      const iconEl = document.getElementById('customerToastIcon');
      if (!toastEl || !msgEl) return;

      msgEl.innerText = message;
      if (iconEl) {
        if (type === 'danger' || type === 'error') {
          iconEl.className = 'bi bi-x-circle-fill text-danger fs-5';
        } else if (type === 'warning') {
          iconEl.className = 'bi bi-exclamation-triangle-fill text-warning fs-5';
        } else {
          iconEl.className = 'bi bi-check-circle-fill text-success fs-5';
        }
      }

      const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
      toast.show();
    }

    // DUAL-BAND SWITCHER
    function switchWifiBand(band) {
      gActiveBand = band;
      const btn24 = document.getElementById('tabBand24');
      const btn5 = document.getElementById('tabBand5');
      const pane24 = document.getElementById('paneBand24');
      const pane5 = document.getElementById('paneBand5');

      if (band === '2.4') {
        if (btn24) btn24.classList.add('active');
        if (btn5) btn5.classList.remove('active');
        if (pane24) pane24.style.display = 'block';
        if (pane5) pane5.style.display = 'none';
      } else {
        if (btn5) btn5.classList.add('active');
        if (btn24) btn24.classList.remove('active');
        if (pane5) pane5.style.display = 'block';
        if (pane24) pane24.style.display = 'none';
      }
    }

    // PEEK PASSWORD
    function togglePeekPassBand(band) {
      if (band === '2.4') {
        gIsPasswordRevealed24 = !gIsPasswordRevealed24;
        const textEl = document.getElementById('displayPass24');
        const iconEl = document.getElementById('iconEye24');
        const labelEl = document.getElementById('labelEye24');
        if (gIsPasswordRevealed24) {
          if (textEl) textEl.innerText = gCurrentWifiPass24 || '(Belum Disetel)';
          if (iconEl) iconEl.className = 'bi bi-eye-slash';
          if (labelEl) labelEl.innerText = 'Tutup';
        } else {
          if (textEl) textEl.innerText = gCurrentWifiPass24 ? '••••••••' : '(Belum Disetel)';
          if (iconEl) iconEl.className = 'bi bi-eye';
          if (labelEl) labelEl.innerText = 'Lihat';
        }
      } else {
        gIsPasswordRevealed5 = !gIsPasswordRevealed5;
        const textEl = document.getElementById('displayPass5');
        const iconEl = document.getElementById('iconEye5');
        const labelEl = document.getElementById('labelEye5');
        if (gIsPasswordRevealed5) {
          if (textEl) textEl.innerText = gCurrentWifiPass5 || '(Belum Disetel)';
          if (iconEl) iconEl.className = 'bi bi-eye-slash';
          if (labelEl) labelEl.innerText = 'Tutup';
        } else {
          if (textEl) textEl.innerText = gCurrentWifiPass5 ? '••••••••' : '(Belum Disetel)';
          if (iconEl) iconEl.className = 'bi bi-eye';
          if (labelEl) labelEl.innerText = 'Lihat';
        }
      }
    }

    function toggleInputType(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const icon = btn ? btn.querySelector('i') : null;
      if (input.type === 'password') {
        input.type = 'text';
        if (icon) icon.className = 'bi bi-eye-slash';
      } else {
        input.type = 'password';
        if (icon) icon.className = 'bi bi-eye';
      }
    }

    // OPEN QR CODE MODAL
    function openWifiQrModal(band, ssid, pass) {
      const modalTitle = document.getElementById('qrModalTitle');
      const img = document.getElementById('qrWifiImage');
      const ssidEl = document.getElementById('qrModalSsidText');
      const passEl = document.getElementById('qrModalPassText');

      if (modalTitle) modalTitle.innerText = `Bagi Sandi Wi-Fi (${band} GHz)`;
      if (ssidEl) ssidEl.innerText = ssid;
      if (passEl) passEl.innerText = pass || '(Tanpa Sandi)';

      // Use pre-generated data URL or fallback to generator API
      const qrData = band === '5' ? gWifiQr5 : gWifiQr24;
      if (qrData) {
        if (img) img.src = qrData;
      } else {
        const qrString = `WIFI:S:${encodeURIComponent(ssid)};T:WPA;P:${encodeURIComponent(pass)};;`;
        if (img) img.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(qrString)}`;
      }

      const m = new bootstrap.Modal(document.getElementById('qrWifiModal'));
      m.show();
    }

    // ── UNIFIED WIFI MODAL CONTROLLER ──
    function openUnifiedWifiModal(defaultBand = '2.4') {
      const select = document.getElementById('selectWifiBand');
      const ssidInput = document.getElementById('inputWifiSsid');
      const p1 = document.getElementById('inputWifiNewPassword');
      const p2 = document.getElementById('inputWifiConfirmPassword');
      const confGroup = document.getElementById('confirmPasswordGroup');
      const alertBox = document.getElementById('wifiUnifiedAlertBox');

      if (alertBox) alertBox.className = 'alert d-none mb-3 py-2 small';
      if (select) select.value = defaultBand;

      if (ssidInput) {
        if (defaultBand === '5') ssidInput.value = gCurrentWifiSsid5;
        else ssidInput.value = gCurrentWifiSsid24;
      }

      if (p1) { p1.value = ''; p1.type = 'password'; }
      if (p2) { p2.value = ''; p2.type = 'password'; }
      if (confGroup) confGroup.style.display = 'none';

      onUnifiedBandChange();

      const m = bootstrap.Modal.getOrCreateInstance(document.getElementById('editWifiModal'));
      m.show();
    }

    function onUnifiedBandChange() {
      const select = document.getElementById('selectWifiBand');
      const ssidInput = document.getElementById('inputWifiSsid');
      const help = document.getElementById('helpSsidSuffix');
      if (!select || !ssidInput) return;

      if (select.value === '5') {
        ssidInput.value = gCurrentWifiSsid5 || (gCurrentWifiSsid24 ? `${gCurrentWifiSsid24}-5G` : '');
        if (help) help.style.display = 'none';
      } else if (select.value === '2.4') {
        ssidInput.value = gCurrentWifiSsid24;
        if (help) help.style.display = 'none';
      } else {
        ssidInput.value = gCurrentWifiSsid24;
        if (help) help.style.display = 'block';
      }
    }

    // Aliases for backward compatibility
    function openEditSsidModal(defaultBand = 'all') {
      openUnifiedWifiModal(defaultBand === 'all' ? '2.4' : defaultBand);
    }
    function openEditPasswordModal(defaultBand = 'all') {
      openUnifiedWifiModal(defaultBand === 'all' ? '2.4' : defaultBand);
      setTimeout(() => {
        const p1 = document.getElementById('inputWifiNewPassword');
        if (p1) p1.focus();
      }, 350);
    }

    async function handleUnifiedWifiSubmit(e) {
      e.preventDefault();
      const select = document.getElementById('selectWifiBand');
      const ssidInput = document.getElementById('inputWifiSsid');
      const p1 = document.getElementById('inputWifiNewPassword');
      const p2 = document.getElementById('inputWifiConfirmPassword');
      const btn = document.getElementById('btnSubmitUnifiedWifi');
      const alertBox = document.getElementById('wifiUnifiedAlertBox');

      const band = select ? select.value : 'all';
      const newSsid = (ssidInput ? ssidInput.value : '').trim();
      const pass = (p1 ? p1.value : '').trim();
      const conf = (p2 ? p2.value : '').trim();

      if (!newSsid) {
        if (alertBox) {
          alertBox.className = 'alert alert-danger mb-3 py-2 small';
          alertBox.innerHTML = '<i class="bi bi-x-circle me-1"></i> Nama Wi-Fi tidak boleh kosong.';
        }
        return;
      }

      if (pass.length > 0) {
        if (pass.length < 8) {
          if (alertBox) {
            alertBox.className = 'alert alert-danger mb-3 py-2 small';
            alertBox.innerHTML = '<i class="bi bi-x-circle me-1"></i> Kata sandi baru minimal 8 karakter.';
          }
          return;
        }
        if (pass !== conf) {
          if (alertBox) {
            alertBox.className = 'alert alert-danger mb-3 py-2 small';
            alertBox.innerHTML = '<i class="bi bi-x-circle me-1"></i> Konfirmasi kata sandi tidak cocok.';
          }
          return;
        }
      }

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menyimpan ke Modem...';
      }

      try {
        const payload = { band, ssid: newSsid };
        if (pass.length >= 8) payload.password = pass;

        const res = await fetch('/customer/change-wifi', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          // Update SSID di DOM
          if (band === '2.4' || band === 'all') {
            gCurrentWifiSsid24 = newSsid;
            const el = document.getElementById('displaySsid24');
            if (el) el.innerText = newSsid;
          }
          if (band === '5' || band === 'all') {
            const s5 = band === 'all' ? (newSsid.toLowerCase().endsWith('-5g') ? newSsid : `${newSsid}-5G`) : newSsid;
            gCurrentWifiSsid5 = s5;
            const el = document.getElementById('displaySsid5');
            if (el) el.innerText = s5;
          }

          // Update Password di DOM jika diisi
          if (pass.length >= 8) {
            if (band === '2.4' || band === 'all') {
              gCurrentWifiPass24 = pass;
              const el = document.getElementById('displayPass24');
              if (el) {
                el.setAttribute('data-real', pass);
                if (gIsPasswordRevealed24) el.innerText = pass;
                else el.innerText = '••••••••';
              }
            }
            if (band === '5' || band === 'all') {
              gCurrentWifiPass5 = pass;
              const el = document.getElementById('displayPass5');
              if (el) {
                el.setAttribute('data-real', pass);
                if (gIsPasswordRevealed5) el.innerText = pass;
                else el.innerText = '••••••••';
              }
            }
          }

          showCustomerToast(data.message || 'Pengaturan Wi-Fi berhasil disinkronkan ke modem!', 'success');
          const m = bootstrap.Modal.getInstance(document.getElementById('editWifiModal'));
          if (m) m.hide();
        } else {
          if (alertBox) {
            alertBox.className = 'alert alert-danger mb-3 py-2 small';
            alertBox.innerHTML = `<i class="bi bi-exclamation-circle me-1"></i> ${data.message || 'Gagal mengubah pengaturan Wi-Fi.'}`;
          }
        }
      } catch (err) {
        if (alertBox) {
          alertBox.className = 'alert alert-danger mb-3 py-2 small';
          alertBox.innerHTML = `<i class="bi bi-wifi-off me-1"></i> Kesalahan jaringan: ${err.message}`;
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Simpan & Terapkan ke Modem';
        }
      }
    }

    // COPY PASSWORD
    function copyPasswordToClipboard(text, btn) {
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        showCustomerToast('Kata sandi disalin ke clipboard!', 'success');
      }).catch(() => {
        fallbackClipboardCopy(text);
        showCustomerToast('Kata sandi disalin ke clipboard!', 'success');
      });
    }

    // CONNECTED DEVICES VIEWER
    function openConnectedDevicesModal() {
      const m = new bootstrap.Modal(document.getElementById('connectedDevicesModal'));
      m.show();
      if (Array.isArray(gCachedConnectedDevices) && gCachedConnectedDevices.length > 0) {
        renderDevicesList(gCachedConnectedDevices);
      }
      fetchConnectedDevices(false);
    }

    function renderDevicesList(devices) {
      const listEl = document.getElementById('connectedDevicesList');
      if (!listEl) return;

      if (!Array.isArray(devices) || devices.length === 0) {
        listEl.innerHTML = `
          <div class="text-center py-4 px-3 rounded-3" style="background:var(--isp-card-surface); border:1px dashed var(--isp-border);">
            <div class="d-inline-flex align-items-center justify-content-center mb-2" style="width:44px; height:44px; border-radius:12px; background:var(--isp-card-bg); color:var(--isp-text-muted); font-size:20px;">
              <i class="bi bi-wifi-off"></i>
            </div>
            <div class="fw-bold mb-1" style="font-size:13px; color:var(--isp-text-heading);">Tidak Ada Perangkat Terdeteksi</div>
            <div class="small text-muted" style="font-size:11px;">Belum ada perangkat terhubung ke router saat ini.</div>
          </div>
        `;
        return;
      }

      listEl.innerHTML = devices.map((d, idx) => {
        const h = String(d.hostname || '').toLowerCase();
        let icon = 'bi-phone';
        let bg = 'rgba(59, 130, 246, 0.15)';
        let color = '#3b82f6';
        let label = 'Smartphone';

        if (h.includes('laptop') || h.includes('pc') || h.includes('macbook') || h.includes('windows')) {
          icon = 'bi-laptop'; bg = 'rgba(168, 85, 247, 0.15)'; color = '#a855f7'; label = 'Komputer / Laptop';
        } else if (h.includes('tv') || h.includes('box')) {
          icon = 'bi-tv'; bg = 'rgba(234, 179, 8, 0.15)'; color = '#eab308'; label = 'Smart TV';
        } else if (String(d.iface || '').toLowerCase().includes('lan')) {
          icon = 'bi-hdd-network'; bg = 'rgba(16, 185, 129, 0.15)'; color = '#10b981'; label = 'Koneksi Kabel LAN';
        }

        const isOnline = String(d.status || '').toLowerCase() === 'online';
        const name = (d.hostname && d.hostname !== '-') ? d.hostname : `${label} #${idx + 1}`;
        const ip = d.ip || '-';
        const mac = d.mac || '-';

        const statusBadge = isOnline
          ? `<span class="badge" style="background:var(--isp-success-subtle); color:var(--isp-success); font-size:9px; font-weight:700;">Online</span>`
          : `<span class="badge" style="background:rgba(255,255,255,0.06); color:var(--isp-text-muted); font-size:9px; font-weight:700; border:1px solid var(--isp-border);">Offline</span>`;

        return `
          <div class="p-3 rounded-3 d-flex align-items-center justify-content-between gap-3" style="background:var(--isp-card-surface); border:1px solid var(--isp-border); opacity:${isOnline ? '1' : '0.65'};">
            <div class="d-flex align-items-center gap-3 min-w-0">
              <div style="width:38px; height:38px; border-radius:10px; background:${isOnline ? bg : 'rgba(100,116,139,0.1)'}; color:${isOnline ? color : 'var(--isp-text-muted)'}; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0;">
                <i class="bi ${icon}"></i>
              </div>
              <div class="min-w-0">
                <div class="fw-bold text-truncate" style="color:var(--isp-text-heading); font-size:13px;">${escapeHtmlClient(name)}</div>
                <div class="font-monospace text-muted" style="font-size:10px; margin-top:2px;">
                  ${escapeHtmlClient(ip)} • ${escapeHtmlClient(mac)}
                </div>
              </div>
            </div>
            ${statusBadge}
          </div>
        `;
      }).join('');
    }

    async function fetchConnectedDevices(isRescan = false) {
      const btn = document.getElementById('btnRefreshModalDevices');
      const icon = document.getElementById('iconRefreshDevices');
      if (btn) btn.disabled = true;
      if (icon) icon.className = 'bi bi-arrow-clockwise spinner-border-sm';

      try {
        const url = '/customer/api/connected-devices' + (isRescan ? '?rescan=1' : '');
        const res = await fetch(url);
        const data = await res.json().catch(() => ({}));

        if (data.ok) {
          const list = data.devices || [];
          gCachedConnectedDevices = list;
          const onlineCount = list.filter(d => String(d.status || '').toLowerCase() === 'online').length;
          const count = (data.onlineCount !== undefined) ? Number(data.onlineCount) : ((data.totalAssociations !== undefined) ? Number(data.totalAssociations) : onlineCount);
          
          const countEl = document.getElementById('modalConnectedCountText');
          if (countEl) countEl.innerText = count;

          const dashEl = document.getElementById('dashConnectedCount');
          if (dashEl) dashEl.innerText = count;

          renderDevicesList(list);
          if (isRescan) showCustomerToast(`Pindai selesai: ${count} perangkat aktif.`, 'success');
        }
      } catch (e) {
      } finally {
        if (btn) btn.disabled = false;
        if (icon) icon.className = 'bi bi-arrow-clockwise';
      }
    }

    function escapeHtmlClient(str) {
      return String(str || '').replace(/[&<>'"]/g, t => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[t] || t));
    }

    // THEME CONTROLLER
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('customer-theme', theme);
        localStorage.setItem('app-theme', theme);
      } catch (e) {}
      
      const meta = document.getElementById('metaThemeColor');
      if (meta) meta.setAttribute('content', theme === 'light' ? '#f1f5f9' : '#090d16');

      const icon = document.getElementById('themeToggleIcon');
      if (icon) {
        if (theme === 'light') {
          icon.className = 'bi bi-moon-stars-fill';
          icon.style.color = '#6366f1';
        } else {
          icon.className = 'bi bi-sun-fill';
          icon.style.color = '#f59e0b';
        }
      }
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    }

    // PAYMENT & INVOICE CONTROLLER
    function openPaymentModal(invId, amount, periodText) {
      currentInvId = invId;
      let num = 0;
      if (typeof amount === 'number') num = isNaN(amount) ? 0 : amount;
      else if (amount) num = parseFloat(String(amount).replace(/[^0-9.]/g, '')) || 0;

      const amtEl = document.getElementById('pay_amount_text');
      if (amtEl) amtEl.innerText = 'Rp ' + Math.round(num).toLocaleString('id-ID');
      
      const periodEl = document.getElementById('pay_modal_period');
      if (periodEl && periodText) periodEl.innerText = periodText;

      if (!pModal) pModal = new bootstrap.Modal(document.getElementById('paymentModal'));
      pModal.show();
    }

    function submitPayment(method) {
      if (!currentInvId) return;
      window.location.href = `/customer/payment/create/${currentInvId}?method=${method}`;
    }

    function filterInvoices(status, btnEl) {
      document.querySelectorAll('.isp-filter-btn').forEach(b => b.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');

      const cards = document.querySelectorAll('.invoice-card-item');
      cards.forEach(c => {
        const cardStatus = c.getAttribute('data-status');
        if (status === 'all' || cardStatus === status) {
          c.style.display = '';
        } else {
          c.style.display = 'none';
        }
      });
    }

    function copyCustomerId(text, btnEl) {
      if (!text) return;
      const originalHtml = btnEl ? btnEl.innerHTML : '';
      const performFeedback = () => {
        if (btnEl) {
          btnEl.innerHTML = '<i class="bi bi-check2 text-success"></i> <span class="text-success">Tersalin!</span>';
          setTimeout(() => { btnEl.innerHTML = originalHtml; }, 1800);
        }
      };

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(String(text)).then(performFeedback).catch(() => {
          fallbackClipboardCopy(String(text));
          performFeedback();
        });
      } else {
        fallbackClipboardCopy(String(text));
        performFeedback();
      }
    }

    function fallbackClipboardCopy(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      ta.style.top = '-9999px';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
    }

    function rebootDevice() {
      const m = new bootstrap.Modal(document.getElementById('rebootModal'));
      m.show();
    }

    function openNotifDrawer() {
      const modal = new bootstrap.Modal(document.getElementById('notifDrawerModal'));
      modal.show();
    }

    document.addEventListener('DOMContentLoaded', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      applyTheme(currentTheme);

      loadCustomerWebNotifs();

      const pInput = document.getElementById('inputWifiNewPassword');
      const confGroup = document.getElementById('confirmPasswordGroup');
      const confInput = document.getElementById('inputWifiConfirmPassword');
      if (pInput && confGroup) {
        pInput.addEventListener('input', () => {
          if (pInput.value.length > 0) {
            confGroup.style.display = 'block';
            if (confInput) confInput.required = true;
          } else {
            confGroup.style.display = 'none';
            if (confInput) {
              confInput.required = false;
              confInput.value = '';
            }
          }
        });
      }

      const btnRefresh = document.getElementById('btnDeviceRefresh');
      if (btnRefresh) {
        btnRefresh.addEventListener('click', async () => {
          btnRefresh.disabled = true;
          btnRefresh.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
          try {
            await fetch('/customer/poll-onu', { method: 'POST' });
            location.reload();
          } catch (e) {
            location.reload();
          }
        });
      }
    });

    function loadCustomerWebNotifs() {
      const container = document.getElementById('notifListContainer');
      if (!container) return;

      const notifs = [];
      <% if (paidInvoices && paidInvoices.length > 0) { %>
        <% paidInvoices.slice(0, 3).forEach(inv => { %>
          <% const pAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
          notifs.push({
            id: 'paid-<%= inv.id %>',
            type: 'payment',
            title: 'Pembayaran Diterima',
            message: 'Tagihan bulan <%= inv.period_month %>/<%= inv.period_year %> sebesar Rp <%= parseInt(pAmt || 0).toLocaleString("id-ID") %> telah LUNAS.',
            time: 'Terkonfirmasi Sistem'
          });
        <% }) %>
      <% } %>

      <% if (hasUnpaid) { %>
        <% const uAmt = latestUnpaid.amount != null ? latestUnpaid.amount : (latestUnpaid.package_price != null ? latestUnpaid.package_price : 0); %>
        notifs.push({
          id: 'unpaid-latest',
          type: 'warning',
          title: 'Pengingat Tagihan',
          message: 'Tagihan bulan <%= latestUnpaid.period_month %>/<%= latestUnpaid.period_year %> sebesar Rp <%= parseInt(uAmt || 0).toLocaleString("id-ID") %> menunggu pembayaran.',
          time: 'Harap dibayar tepat waktu'
        });
      <% } %>

      const badge = document.getElementById('notifCountBadge');
      if (badge && notifs.length > 0) {
        badge.innerText = notifs.length;
        badge.style.display = 'flex';
      }

      if (notifs.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-bell-slash fs-2 d-block mb-2"></i>Tidak ada notifikasi baru</div>';
      } else {
        container.innerHTML = notifs.map(n => `
          <div class="p-3 mb-2 rounded-3" style="background:var(--isp-card-surface); border:1px solid var(--isp-border);">
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="bi bi-${n.type === 'payment' ? 'check-circle-fill text-success' : 'exclamation-circle-fill text-warning'}"></i>
              <span class="fw-bold" style="font-size:12px; color:var(--isp-text-heading);">${n.title}</span>
            </div>
            <div class="small" style="font-size:11px; color:var(--isp-text-muted);">${n.message}</div>
            <div class="small mt-1" style="font-size:10px; color:var(--isp-text-dim);">${n.time}</div>
          </div>
        `).join('');
      }
    }
  </script>
</body>
</html>
